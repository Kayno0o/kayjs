---
import type { JSX, Snippet } from 'kay'
import type { NavItem } from './nav-item'
import type { TabEntry, TabLink } from './tab-nav'
import { effect, followed, recipe, withQuery } from 'kay'
import Icon from './icon.kay'
import { tabOf } from './outside'
import { currentTab, keptHref } from './tab-nav'
import { centerInBar } from './bar-scroll'
import { stepIndex } from './cycle'

// 'kui-tab-nav' stays as the component's name for an app's CSS.
const look = recipe({
  parts: {
    root: 'kui-tab-nav kui-scroll-fade group/tab-nav flex overflow-x-auto data-[orientation=vertical]:flex-col data-[orientation=vertical]:overflow-x-visible data-[orientation=vertical]:overflow-y-auto',
    link: 'shrink-0 text-muted transition-colors hover:text-foreground inline-flex items-center gap-1 aria-disabled:cursor-not-allowed aria-disabled:opacity-50 aria-disabled:hover:text-muted',
    icon: 'size-3.5 shrink-0',
    badge: 'rounded-full bg-surface-strong px-1.5 py-px text-xs tabular-nums text-muted',
  },
  variants: {
    // `underline` (the default) marks the current tab by a line beside it; `segmented` is a tray of keys with the current one filled, as Segmented draws it, but links: a page per tab, `aria-current` on the current one.
    variant: {
      underline: {
        root: 'gap-1 border-b border-border pb-px data-[orientation=vertical]:border-b-0 data-[orientation=vertical]:border-e data-[orientation=vertical]:pb-0',
        link: '-mb-px border-b-2 border-transparent px-4 py-2 text-sm aria-[current=page]:border-accent aria-[current=page]:text-accent group-data-[orientation=vertical]/tab-nav:-me-px group-data-[orientation=vertical]/tab-nav:mb-0 group-data-[orientation=vertical]/tab-nav:border-b-0 group-data-[orientation=vertical]/tab-nav:border-e-2',
      },
      segmented: {
        root: 'w-fit max-w-full border-solid bg-surface [border-color:var(--_control-line,var(--color-border))] [border-width:var(--border-width)]',
        link: 'px-3 py-1.5 text-xs aria-[current=page]:bg-accent aria-[current=page]:text-accent-foreground aria-[current=page]:hover:text-accent-foreground',
        badge: 'in-aria-[current=page]:bg-accent-foreground/20 in-aria-[current=page]:text-accent-foreground',
      },
    },
  },
  defaults: { variant: 'underline' },
})

const { links, current, keep = [], tabs, param, paramDefault, label, orientation = 'horizontal', variant = 'underline', tab, onKeyDown, ...rest } = props<Omit<JSX.IntrinsicElements['nav'], 'class' | 'children'> & {
  // Names the navigation for screen readers.
  label: string
  // `'vertical'` stacks the tabs in a column, and ArrowUp and ArrowDown move the focus between the links in place of ArrowLeft and ArrowRight; the arrows only move the focus, a link being opened by Enter.
  orientation?: 'horizontal' | 'vertical' | undefined
  // Draws the text of each tab in place of its `label`: `@tab(tab)`, given the link or tab as written. The icon and the badge it names are still drawn around it.
  tab?: Snippet<[tab: TabEntry]> | undefined
} & (
  {
    // Each tab is a page of its own, with an `icon` before its label and a `badge` after it. `disabled` draws a text that is no link, with `aria-disabled`. `prefix` keeps a link current on the pages under its path, `also` on the pages under the listed paths, such as a detail page of the tab; both need a URL `current`.
    links: readonly ({ href: string } & NavItem & Omit<TabLink, 'href'>)[]
    // The `href` of the page on screen, which the link to it marks as current; or its URL, `ctx.url`, matched by its path and the params a link sets.
    current: string | URL
    // The params of `current` each link carries on, such as a period or a filter the tabs share, unless the link sets its own.
    keep?: readonly string[] | undefined
    tabs?: undefined
    param?: undefined
    paramDefault?: undefined
  } | {
    // The tabs of one query param instead of `links`: each links to the current page with `param` set to its value and every other param kept, and the one the address names is current, with no `current` to hand over.
    tabs: readonly ({ value: string | number } & NavItem)[]
    param: string
    // The value the page shows while `param` is left out: its tab is current then, and its link leaves the param out. Without it the first tab is the one shown, and its link sets the param like any other.
    paramDefault?: string | number | undefined
    links?: undefined
    current?: undefined
    keep?: undefined
  }
)>()

let nav: HTMLElement | undefined

// A tab of `tabs` links to the page with its value set, and is current when that link is the address itself, else when it is the default one.
const items = (): { key: string, to: string, entry: TabEntry & Pick<TabLink, 'newTab'>, on: boolean, scrolls: boolean }[] => {
  if (tabs === undefined || param === undefined) {
    const marked = currentTab(links ?? [], current ?? '')

    return (links ?? []).map(link => ({ key: link.href, to: keptHref(link.href, current ?? '', keep), entry: link, on: link.href === marked && !link.disabled, scrolls: link.href.includes('#') }))
  }

  const here = withQuery({})
  const name = param
  const pick = (value: string | number) => withQuery({ [name]: paramDefault !== undefined && String(value) === String(paramDefault) ? null : value })
  const shown = tabs.find(tab => pick(tab.value) === here)?.value ?? paramDefault ?? tabs[0]?.value

  return tabs.map(entry => ({ key: String(entry.value), to: pick(entry.value), entry, on: String(entry.value) === String(shown) && !entry.disabled, scrolls: false }))
}

const MOVES = {
  horizontal: { ArrowRight: 1, ArrowLeft: -1 },
  vertical: { ArrowDown: 1, ArrowUp: -1 },
} as const

// The arrows along the bar move the focus from link to link, wrapping; the links all stay in the page's tab order, as links do.
function keyDown(event: KeyboardEvent) {
  onKeyDown?.(event as Parameters<NonNullable<typeof onKeyDown>>[0])

  const delta = (MOVES[orientation] as Partial<Record<string, number>>)[event.key]

  if (event.defaultPrevented || delta === undefined || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey || !nav)
    return

  const found = [...nav.querySelectorAll<HTMLElement>('a')]
  const at = found.indexOf(event.target as HTMLElement)

  if (found.length === 0 || at === -1)
    return

  event.preventDefault()
  found[stepIndex(at, delta, found.length)]!.focus()
}

// A tab bar wider than a phone scrolls, so the current tab is centred in it rather than left off screen, again when the links arrive after the first render. Only the bar scrolls: `scrollIntoView` would also move the page to it.
effect(() => {
  items()

  const link = nav?.querySelector('[aria-current="page"]')

  if (!nav || !link)
    return

  centerInBar(nav, link, orientation === 'vertical')
})
---
// The inside of a tab, the same on a link and on a disabled text.
snippet inside(item: { entry: TabEntry })
  if item.entry.icon
    Icon(icon={item.entry.icon} part="icon")
  if tab
    slot tab(item.entry)
  else
    | {item.entry.label}
  if item.entry.badge !== undefined
    span(part="badge") {item.entry.badge}
// Links rather than buttons: each tab is a page of its own, which a reload, a new tab or a shared url opens. The bar sits mid-page, so following a tab keeps the window where it was (`data-scroll="keep"` on the link), except a link to a `#section`, which scrolls to it.
// With no tabs there is no empty landmark.
if items().length > 0
  nav(part="root" {...rest} ref={element => nav = element} aria-label={label} data-orientation={orientation === 'vertical' ? 'vertical' : undefined} onKeyDown={keyDown})
    for item of items() key={item.key}
      if item.entry.disabled
        span(part="link" aria-disabled="true")
          | {followed(() => item, item => inside(item))}
      else
        a(part="link" data-scroll={item.scrolls ? undefined : 'keep'} href={item.to} {...tabOf(item.to, item.entry.newTab)} aria-current={item.on ? 'page' : undefined})
          | {followed(() => item, item => inside(item))}
