---
import { wording } from 'kay/words'
import type { Denials } from '../access'
import type { ScreenCollection, StoredEntry } from '../kay/contract'
import type { EntryPresence as Editors } from '../presence'
import type { EntryTranslations, PairedEntry } from '../translations'
import EntryFields from '../editor/entry-fields.kay'
import { createEntryForm } from '../form'
import EntryActions from './entry-actions.kay'
import EntryCompare from './entry-compare.kay'
import EntryHeader from './entry-header.kay'
import EntryIdentity from './entry-identity.kay'
import EntryLocales from './entry-locales.kay'
import EntryPresence from './entry-presence.kay'

// An entry's form on its own screen, or a new entry's when `entry` is left out; `presence`, from `entryPresence`, lists who else has the entry open.
// `translations`, from `entryTranslations`, adds the entry's locales and marks its text untranslated against the default locale's; `copy` starts a new entry as a copy of a translation.
// `denied`, from `denials`, disables the buttons for what the signed-in person's role may not do.
// An app's own screen builds the same from `createEntryForm` and the parts this one is made of.
const { prefix, collection, entry, locale, presence, translations, copy, source, denied } = props<{ denied?: Denials | undefined, prefix: string, collection: ScreenCollection, entry?: StoredEntry | undefined, locale?: string | undefined, presence?: Editors | undefined, translations?: EntryTranslations | undefined, copy?: PairedEntry | undefined, source?: PairedEntry | undefined }>()

const form = createEntryForm({ prefix, collection, entry, locale, copy, denied, source: translations?.source ?? source })
---
form.kcms-entry-editor(novalidate aria-busy={form.saving()} onSubmit={event => { event.preventDefault(); void form.save() }})
  EntryHeader(prefix={prefix} collection={collection} title={form.name} subtitle={form.subtitle})
    if !form.stranded()
      EntryActions(form={form} denied={denied})
  if presence
    EntryPresence(room={presence.room} member={presence.member})
  if translations && entry
    EntryLocales(prefix={prefix} entry={form.entry} translations={translations} compared={translations.compare?.locale})
  if form.stranded() as gone
    .kcms-entry-failure(role="alert")
      if gone.renamed
        p {wording('cms.entry.renamed', 'This entry is renamed.')}
        a(href={gone.to}) {wording('cms.entry.renamedLeave', 'Go to the renamed entry')}
      else
        p {wording('cms.entry.deleted', 'This entry is deleted.')}
        a(href={gone.to}) {wording('cms.entry.deletedLeave', 'Go to the collection')}
  else
    // Locked while a save is on its way, so what is typed meanwhile is not left out of it.
    fieldset.kcms-entry-fields(disabled={form.saving()})
      EntryIdentity(form={form})
      EntryFields(form={form})
  if translations?.compare as other
    EntryCompare(collection={collection} other={other})
