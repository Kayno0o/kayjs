--- server
const user = await ctx.locals.auth.user()
--- script
import Toaster from '@kaynooo/kayjs-ui/toaster.kay'
import TooltipHost from '@kaynooo/kayjs-ui/tooltip-host.kay'
import '../app.css'
---
a.skip-link(href="#main-content") Skip to main content
header.border-b.border-kui-surface2.px-6.py-3
  nav.mx-auto.flex.max-w-3xl.items-center.justify-between.gap-4(aria-label="Main navigation")
    a.text-lg.font-bold.no-underline(href="/") Noticeboard
    if user as signedIn
      a(href="/auth/account") {signedIn.username ?? signedIn.email}
    else
      ul.flex.gap-4
        li
          a(href="/auth/sign-in") Sign in
        li
          a(href="/auth/register") Join
main#main-content.mx-auto.w-full.max-w-3xl.grow.px-6.py-6
  slot
Toaster
TooltipHost
