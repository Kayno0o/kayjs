--- server
import { defer } from 'kay'

const score = defer(new Promise<number>(resolve => setTimeout(resolve, 10, 42)))
---
h1 Bill
// kay-allow uncaught-await
await score
  p.pending Scoring
then value
  p.score {value}
  template
    p.kept Kept
  // kay-allow uncaught-await
  await score then again
    p.again {again}
