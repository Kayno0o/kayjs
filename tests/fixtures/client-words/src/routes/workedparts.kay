--- server
import { t } from 'elysia'
import { action } from 'kay'

export const solve = action(t.Object({ name: t.String({ minLength: 3 }) }), () => undefined, { proofOfWork: 50 })

async function* words() {
  yield 'one'
  await Bun.sleep(80)
  yield 'two'
}

const rows = words()
---
p.shell Shell
await rows then text
  p {text}
  form(action={solve})
    input(field="name")
    button Solve
