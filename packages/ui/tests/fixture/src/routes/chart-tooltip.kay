---
// kay-island
import '../app.css'
import LineChart from '@kaynooo/kayjs-ui/line-chart.kay'

const seconds = Array.from({ length: 30 }, (_, index) => new Date(Date.UTC(2026, 9, 21, 16, 12, index * 10)).toISOString())
const hours = Array.from({ length: 12 }, (_, index) => new Date(Date.UTC(2026, 9, 21, index * 2, 0, 0)).toISOString())
const days = Array.from({ length: 7 }, (_, index) => new Date(Date.UTC(2026, 9, 15 + index)).toISOString().slice(0, 10))
const cores = Array.from({ length: 12 }, (_, core) => ({ name: `Core ${core}`, values: [100, 50 + core, 100] }))
const spread = [{ name: 'A reasonably long series name', values: seconds.map((_, index) => index) }, { name: 'Other', values: seconds.map((_, index) => index * 2) }]
---
main
  article#seconds
    LineChart(label="Seconds" labels={seconds} series={spread} xLabels)
  article#hours
    LineChart(label="Hours" labels={hours} series={[{ name: 'Load', values: hours.map((_, index) => index) }]} xLabels)
  article#days
    LineChart(label="Days" labels={days} series={[{ name: 'Load', values: days.map((_, index) => index) }]} xLabels)
  article#plain
    LineChart(label="Plain" labels={['Mon', 'Tue', 'Wed']} series={[{ name: 'Load', values: [1, 2, 3] }]})
  article#formatted
    LineChart(label="Formatted" labels={['a', 'b', 'c']} formatLabel={(label, { place }) => `${place === 'tick' ? 'Tick' : 'Point'} ${label}`} series={[{ name: 'Load', values: [1, 2, 3] }]} xLabels)
  article#stacked
    LineChart(label="Stacked" labels={['a', 'b', 'c']} stacked series={[{ name: 'A', values: [1, 2, 3] }, { name: 'B', values: [null, 1, 1] }, { name: 'C', values: [2, 2, null] }]} xLabels)
  article#cores
    LineChart(label="Cores" labels={['a', 'b', 'c']} stacked formatValue={value => `${value}%`} series={cores} xLabels)
  article#long-axis
    LineChart(label="Throughput" labels={['a', 'b', 'c']} formatValue={value => `${(value / 1048576).toFixed(1)} MiB/s`} series={[{ name: 'Read', values: [0, 8e8, 3e8] }]})
  article#long-axis-stacked
    LineChart(label="Stacked throughput" labels={['a', 'b', 'c']} stacked formatValue={value => `${(value / 1048576).toFixed(1)} MiB/s`} series={[{ name: 'Read', values: [0, 4e8, 3e8] }, { name: 'Write', values: [1e8, 4e8, 3e8] }]} xLabels)
  article#long-axis-own
    LineChart(label="Own offset" labels={['a', 'b', 'c']} formatValue={value => `${value} units per second`} options={{ axisY: { offset: 50 } }} series={[{ name: 'Read', values: [0, 8, 3] }]})
  article#long-axis-padding
    LineChart(label="Own padding" labels={['a', 'b', 'c']} formatValue={value => `${value} units per second`} options={{ chartPadding: { top: 2 } }} series={[{ name: 'Read', values: [0, 8, 3] }]})
