---
import type { JSX } from 'kay'
import type { IconProps } from 'kay/icons'
import type { IconSlot } from './defaults'
import settings from './settings'

// `icon` is a slot the app's settings map onto its set, or an icon imported from `~icons/<prefix>/<name>`.
const { icon, label, class: className, ...rest } = props<Omit<JSX.IntrinsicElements['svg'], 'class' | 'children'> & {
  icon: IconSlot | IconProps
  // Names the icon for screen readers; without it the icon is decorative.
  label?: string
  class?: string
}>()

const drawn = () => typeof icon === 'string' ? settings.icons[icon] : icon
---
svg.kui-icon({...drawn()} {...rest} class={className} role={label === undefined ? undefined : 'img'} aria-label={label} aria-hidden={label === undefined ? 'true' : undefined})
