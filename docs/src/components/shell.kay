---
import type { Navigation } from '../pages'
import Button from '@kaynooo/kayjs-ui/button.kay'
import Icon from '@kaynooo/kayjs-ui/icon.kay'
import TabNav from '@kaynooo/kayjs-ui/tab-nav.kay'
import Toaster from '@kaynooo/kayjs-ui/toaster.kay'
import BrandGithub from '~icons/tabler/brand-github'
import { FORGE, RELEASES, REPOSITORY } from '../forge'
import { partOf } from '../sections'
import CodeCopy from './code-copy.kay'
import FileTreeEntries from './file-tree-entries.kay'
import LinkFilter from './link-filter.kay'
import Search from './search.kay'
import ThemePicker from './theme-picker.kay'

const { nav, current } = props<{ nav: Navigation, current: string }>()
const part = partOf(current)
---
a.skip-link(href="#content") Skip to the content
.shell
  aside.side
    header.bar
      .brand-row
        a.brand(href="/")
          img(src="/favicon.svg" alt="" width="28" height="28")
          span kay
        a.version(href={RELEASES}) v{nav.version}
        a.repository(href={REPOSITORY} aria-label="kay's repository")
          Icon(icon={BrandGithub})
        ThemePicker(persist hydrate="idle")
      Search(persist hydrate="idle" groups={nav.groups} structure={nav.structure} components={nav.components})
      // Shown once the sidebar folds into a popover.
      Button(class="hidden max-[56rem]:inline-flex" label="Menu" icon="menu" popovertarget="sidebar")
    nav#sidebar.sidebar(popover aria-label="Documentation")
      TabNav(class="mb-4 [&>a]:flex-1 [&>a]:px-1 [&>a]:text-center" links={nav.parts} current={nav.parts.find(one => one.part === part)!.href} label="Parts of the documentation")
      if part === 'structure'
        p.group A kay project
        .sidebar-tree
          FileTreeEntries(entries={nav.tree})
      else if part === 'ui'
        p.group kayjs-ui components
        LinkFilter(links={nav.components} current={current} label="Filter the components")
      else if part === 'agents'
        p.group Full reference
        ul
          for link of nav.reference key={link.href}
            li
              a(href={link.href}) {link.title}
      else
        for group of nav.groups key={group.title}
          p.group {group.title}
          ul
            for link of group.links key={link.href}
              li
                a(href={link.href}) {link.title}
  main#content
    slot
    footer.site-foot
      p Built with #[a(href={REPOSITORY}) kay] {nav.version}, under the #[a(href={`${FORGE}/LICENSE`}) MIT license]. #[span(data-page-weight)]
      p See #[a(href={RELEASES}) what changed in each release], or ask a question or report a bug in #[a(href={`${REPOSITORY}/issues`}) the issues].
CodeCopy(persist)
Toaster(persist hydrate="idle")
