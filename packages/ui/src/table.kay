--- <Row, Key extends RowKey<Row>>
import type { JSX, Snippet } from 'kay'
import type { InfiniteList } from './infinite-list'
import type { Column, FilterField, RowFilter, RowKey, RowKeyValue, SortState } from './table'
import { effect, memo, onCleanup, onMount, persisted, recipe, signal, untrack } from 'kay'
import Button from './button.kay'
import Checkbox from './checkbox.kay'
import Icon from './icon.kay'
import LoadMore from './load-more.kay'
import Select from './select.kay'
import { cellText, drawnByBlock, exportHref, nextSort, resolvedColumn, restoredSort, rowKeyOf, rowLabel, rowsMatching, sameFields, sortedRows, toCsv } from './table'
import { virtualRows } from './virtual'
import { wording } from 'kay/words'

const DEBOUNCE_MS = 200

// 'kui-table-wrap' stays as the component's name for an app's CSS. The narrow form is a container named `table`, which its parts read with `@max-[30rem]/table:`; the name carries no `kui-` prefix so no old rule keeps its class alive.
const look = recipe({
  parts: {
    root: 'kui-table-wrap group/table w-full overflow-x-auto border-solid border-[length:var(--border-width)] border-border bg-surface data-[narrow=stack]:@container/table data-virtual:overflow-y-auto data-virtual:max-h-[var(--table-height,70vh)] data-virtual:[overflow-anchor:none] data-virtual:focus-visible:outline-2 data-virtual:focus-visible:-outline-offset-2 data-virtual:focus-visible:outline-accent',
    // Sticky, so the filter and the selection bar stay in view while a wide table scrolls under them.
    filter: 'sticky left-0 flex flex-wrap items-center gap-x-4 gap-y-2 border-solid border-b-[length:var(--border-width)] border-border px-3 py-2',
    field: 'flex items-center gap-2',
    filterInput: 'w-56 max-w-full',
    count: 'sr-only',
    selection: 'sticky left-0 flex flex-wrap items-center gap-3 border-solid border-b-[length:var(--border-width)] border-border px-3 py-2 text-sm [&_.kui-checkbox]:min-h-6 [&_.kui-checkbox]:min-w-6',
    selected: 'm-0',
    bulk: 'flex flex-wrap items-center gap-2',
    table: 'w-full border-collapse text-sm group-data-[narrow=stack]/table:[overflow-wrap:anywhere] @max-[30rem]/table:block',
    // Below 30rem of width the rows of a stacked table become cards and its headers one row of sort buttons, the only part of the head that stays. Each card draws its own top line instead of the row's bottom border, so an app dropping the row borders of the wide table still sees the cards apart.
    head: '@max-[30rem]/table:has-[[data-part=sortButton]]:block @max-[30rem]/table:group-data-virtual/table:sticky @max-[30rem]/table:group-data-virtual/table:top-0 @max-[30rem]/table:group-data-virtual/table:z-1 @max-[30rem]/table:group-data-virtual/table:bg-surface @max-[30rem]/table:not-has-[[data-part=sortButton]]:hidden',
    headRow: '@max-[30rem]/table:flex @max-[30rem]/table:flex-wrap @max-[30rem]/table:gap-2 @max-[30rem]/table:border-solid @max-[30rem]/table:border-b-[length:var(--border-width)] @max-[30rem]/table:border-border @max-[30rem]/table:px-3 @max-[30rem]/table:py-2',
    body: '@max-[30rem]/table:block',
    headCell: 'border-b border-border px-3 py-2 text-left text-xs [font-weight:var(--font-weight-normal)] tracking-label text-muted [font-family:var(--font-label,inherit)] [text-transform:var(--label-case)] data-[align=center]:text-center data-[align=end]:text-right aria-[sort=ascending]:text-accent aria-[sort=descending]:text-accent group-data-virtual/table:sticky group-data-virtual/table:top-0 group-data-virtual/table:bg-surface @max-[30rem]/table:border-0 @max-[30rem]/table:p-0 @max-[30rem]/table:not-has-[[data-part=sortButton]]:hidden',
    selectHead: 'border-b border-border px-3 py-2 text-left text-xs [font-weight:var(--font-weight-normal)] tracking-label text-muted [font-family:var(--font-label,inherit)] [text-transform:var(--label-case)] data-[align=center]:text-center data-[align=end]:text-right aria-[sort=ascending]:text-accent aria-[sort=descending]:text-accent group-data-virtual/table:sticky group-data-virtual/table:top-0 group-data-virtual/table:bg-surface @max-[30rem]/table:border-0 @max-[30rem]/table:p-0 @max-[30rem]/table:not-has-[[data-part=sortButton]]:hidden w-0 @max-[30rem]/table:w-auto',
    selectText: 'sr-only',
    sortButton: 'group/sort inline-flex cursor-pointer items-center gap-1 border-0 bg-transparent p-0 text-inherit [font-family:var(--font-label,inherit)] [text-transform:var(--label-case)] @max-[30rem]/table:min-h-8 @max-[30rem]/table:border-solid @max-[30rem]/table:border-[length:var(--border-width)] @max-[30rem]/table:border-border @max-[30rem]/table:px-2 @max-[30rem]/table:py-0.5',
    sortIcon: 'size-3.5 group-data-[direction=asc]/sort:rotate-180',
    row: 'border-b border-border @max-[30rem]/table:border-b-0 @max-[30rem]/table:[[data-part=row]+&]:border-t hover:bg-hover aria-selected:bg-hover @max-[30rem]/table:grid @max-[30rem]/table:grid-cols-[fit-content(40%)_minmax(0,1fr)] @max-[30rem]/table:gap-x-4 @max-[30rem]/table:px-3 @max-[30rem]/table:py-2',
    cell: 'px-3 py-1.5 text-foreground data-[numeric]:tabular-nums data-[align=center]:text-center data-[align=end]:text-right @max-[30rem]/table:col-span-full @max-[30rem]/table:grid @max-[30rem]/table:grid-cols-subgrid @max-[30rem]/table:items-baseline @max-[30rem]/table:px-0 @max-[30rem]/table:py-1 @max-[30rem]/table:data-[align]:text-left',
    // The box is 1rem, so its label grows to the 1.5rem a finger needs.
    selectCell: 'px-3 py-1.5 text-foreground data-[numeric]:tabular-nums data-[align=center]:text-center data-[align=end]:text-right @max-[30rem]/table:col-span-full @max-[30rem]/table:grid @max-[30rem]/table:grid-cols-subgrid @max-[30rem]/table:items-baseline @max-[30rem]/table:px-0 @max-[30rem]/table:py-1 @max-[30rem]/table:data-[align]:text-left w-0 @max-[30rem]/table:w-auto [&_.kui-checkbox]:min-h-6 [&_.kui-checkbox]:min-w-6 [&_.kui-checkbox]:justify-center',
    // Outside a narrow table a cell holds its content alone: the column header names it.
    cellLabel: 'hidden @max-[30rem]/table:block @max-[30rem]/table:text-left [font-size:var(--text-2xs)] [line-height:var(--text-2xs--line-height)] [font-weight:var(--font-weight-normal)] tracking-label text-muted [font-family:var(--font-label,inherit)] [text-transform:var(--label-case)]',
    cellBody: 'contents @max-[30rem]/table:block @max-[30rem]/table:min-w-0 @max-[30rem]/table:[overflow-wrap:anywhere] @max-[30rem]/table:first:col-span-full',
    // The rows standing for those a virtual table does not draw.
    spacer: '@max-[30rem]/table:block',
    emptyCell: 'px-3 py-8 text-center text-xs text-muted @max-[30rem]/table:block',
  },
})

const { columns: given, rows: passed, list, rowKey, sort, sortable = true, serverSort = false, onSort, cell, empty, filter, fields, filterLabel = wording('ui.table.filter', 'Filter'), filterPlaceholder, filterParam, sortParam, countLabel, noMatch, narrow = 'stack', selectable = false, selected, onSelect, bulk, selectAllLabel = wording('ui.table.selectAll', 'Select all'), selectedLabel, selectRowLabel, exportable = false, exportLabel = wording('ui.table.export', 'Export CSV'), exportName = 'table.csv', virtual = false, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'children' | 'onSelect'> & {
  columns: Column<Row>[]
  // The rows to draw. Left out when `list` holds them: one of the two is required.
  rows?: Row[] | undefined
  // Rows loaded page by page, from `infiniteList`: the table draws its rows with `LoadMore` after them, and a header click sorts on the server, the list starting over from offset 0 with the sort passed to its `load` (and to `onSort` too). The columns to sort by carry a `sortValue` (`numeric` ones have it), which only marks them sortable here. The table's own sort, from `sort` or the URL, is sent to the list too. A sort restarts the list, so a selected row outside the first page leaves the selection. The list loads again from offset 0 when the table's sort differs from the `sort` the list was made with, on mount included, so give `infiniteList` the same `sort` the table starts from to keep the first page. `exportable` as `true` exports the rows loaded so far; give it an endpoint to export them all.
  list?: InfiniteList<Row> | undefined
  rowKey: Key
  // The sort to start from; a table whose parent passes a new one follows it.
  sort?: SortState | undefined
  // `false` leaves every header unsortable, `numeric` columns included, for rows the page holds only a part of, which a header click would sort alone.
  sortable?: boolean | undefined
  // Rows already sorted by the data source: the table reflects the sort in its headers and never reorders them itself.
  serverSort?: boolean | undefined
  // Called with each sort a header click asks for, to fetch the rows sorted that way when `serverSort` is set.
  onSort?: ((sort: SortState) => unknown) | undefined
  // Draws the cells of the columns it covers, see `Column.cell`.
  cell?: Snippet<[row: Row, column: Column<Row>]> | undefined
  // Shown in place of the rows when there are none.
  empty?: Snippet
  // A search box above the rows, keeping those where a value it reads holds the typed text: the row's fields named, or what a function of the row returns. For a table over a `list` the rows are the server's to filter: the text goes to the list's `load` as `filter.text` (the list starting over from offset 0 after a pause in typing, as it does for a sort) and `filter` only has to be there to show the box.
  filter?: RowFilter<Row> | undefined
  // Extra fields beside the search box of a table over a `list`, each a text box or, with `options`, a select, whose value goes to the list's `load` as `filter.fields[key]` and to the page's URL under `key`, so a reload or a shared link filters the same. The list starts over from offset 0 when one changes. Decided once, when the table is made.
  fields?: readonly FilterField[] | undefined
  // Names the search box.
  filterLabel?: string | undefined
  filterPlaceholder?: string | undefined
  // The query parameter keeping the typed text in the page's URL, so a reload or a shared link filters the same; without it the text stays on the page.
  filterParam?: string | undefined
  // The query parameter keeping the sort a header click picks in the page's URL, the column's key under it and its direction under `direction` (`<name>Direction` for any name but `sort`), so a reload, a shared link or back and forward sort the same; a click replaces the history entry. The URL's sort wins over `sort` on load.
  sortParam?: string | undefined
  // How many rows the filter keeps, as screen readers hear it.
  countLabel?: ((count: number) => string) | undefined
  // Shown in place of the rows when the filter hides every one; `empty` otherwise.
  noMatch?: Snippet
  // Below 30rem of width, rows stack as cards labelled by their headers, or the table scrolls sideways.
  narrow?: 'stack' | 'scroll' | undefined
  // A checkbox on each row and, above the rows, a tri-state select-all beside the count of rows picked, in the stacked cards as in the wide table.
  selectable?: boolean | undefined
  // The keys of the rows picked to start from, as `rowKey` reads them; a table whose parent passes another list follows it. A key whose row is no longer in `rows` leaves the selection.
  selected?: RowKeyValue<Row, Key>[] | undefined
  // Called with the keys picked, as `selected` takes them, and the rows they stand for, both in the rows' order, each time the selection changes, a row leaving `rows` included.
  onSelect?: ((keys: RowKeyValue<Row, Key>[], rows: Row[]) => unknown) | undefined
  // Drawn beside the count while something is picked, with the keys and a function emptying the selection: the page's bulk actions.
  bulk?: Snippet<[keys: RowKeyValue<Row, Key>[], clear: () => void]> | undefined
  // Names the select-all box, and the column's header for screen readers.
  selectAllLabel?: string | undefined
  // The count of rows picked, read out as it changes: `N selected`.
  selectedLabel?: ((count: number) => string) | undefined
  // Names a row's box: `Select <first column's text>`.
  selectRowLabel?: ((row: Row) => string) | undefined
  // A button above the rows downloading them as CSV, the headers on top and the cells as the rows hold them, with the filter and the sort on screen applied. A string is the address of an endpoint to download from instead, for rows the page holds only a part of: it gets the sort as `sort` and `direction` and the typed filter text under `filterParam` (`q` without one), and answers with `toCsv(rows, columns)`.
  exportable?: boolean | string | undefined
  // Names the export button.
  exportLabel?: string | undefined
  // The file name the download is saved as.
  exportName?: string | undefined
  // Draws only the rows in view, between room standing for the others, so a table of ten thousand rows and more stays as light as a short one. The table scrolls in a box of its own (`--table-height`, 70vh by default) with its headers kept on top. Decided once, when the table is made. The server draws the first screenful, so the rest shows once the page loads its script. Find-in-page sees the drawn rows alone, and a focused row that scrolls out of the window loses its focus. Name the scroll box with an `aria-label`.
  virtual?: boolean | undefined
} & ({ rows: Row[], list?: undefined } | { rows?: undefined, list: InfiniteList<Row> })>()

const rows = () => list ? list.rows() : passed ?? []
const columns = memo(() => given.map(column => resolvedColumn(column, sortable)))
const keptKey = sortParam === undefined ? undefined : persisted(sortParam, '', { storage: 'query' })
const keptDirection = sortParam === undefined ? undefined : persisted(sortParam === 'sort' ? 'direction' : `${sortParam}Direction`, '', { storage: 'query' })
const restored = restoredSort(columns(), keptKey?.(), keptDirection?.())
const current = signal(restored ?? sort)
let following = restored === undefined
const typed = filterParam === undefined ? signal('') : persisted(filterParam, '', { storage: 'query' })
const extra = fields ?? []
const fieldValues = extra.map(field => persisted(field.key, '', { storage: 'query' }))
const fieldsNow = () => Object.fromEntries(extra.flatMap((field, index) => fieldValues[index]!() === '' ? [] : [[field.key, fieldValues[index]!()]]))
const asked = () => ({ text: typed(), fields: fieldsNow() })
// A table over a list searches on the server, so a `filterParam` alone shows the box.
const searching = () => filter !== undefined || (list !== undefined && filterParam !== undefined)
const filtering = () => typed() !== '' || extra.some((_, index) => fieldValues[index]!() !== '')

effect(() => {
  const next = sort

  // The URL's sort stands over the one the table starts from, until the parent passes a new one.
  if (following)
    current = next

  following = true
})

// A list follows the table's sort and filter whatever set them: a header click, the URL's, the parent's `sort`, a typed text or a field. The first run loads at once, a text waits for a pause in typing, and one load serves a sort and a filter changed together.
let started = false

effect(() => {
  if (!list)
    return

  const wanted = current()
  const filtered = asked()
  const now = !started

  started = true

  const [sortChanged, filterChanged] = untrack(() => {
    const held = list.sort()
    const filter = list.filter()

    return [wanted?.key !== held?.key || wanted?.direction !== held?.direction, filtered.text !== filter.text || !sameFields(filtered.fields, filter.fields)]
  })

  if (!sortChanged && !filterChanged)
    return

  const run = () => void list.restart({ ...sortChanged && { sort: wanted }, ...filterChanged && { filter: filtered } })

  if (now || !filterChanged) {
    run()

    return
  }

  const timer = setTimeout(run, DEBOUNCE_MS)

  onCleanup(() => clearTimeout(timer))
})

// The rows the filter keeps, all of them without one.
const kept = memo(() => filter === undefined || list ? rows() : rowsMatching(rows(), filter, typed()))
const counted = countLabel ?? ((count: number) => wording('ui.table.rowCount', count === 1 ? '1 row' : '{count} rows', { count }))
const none: RowKeyValue<Row, Key>[] = []
const picked = signal(selected ?? none)

effect(() => picked = selected ?? none)

const keyed = memo(() => rows().map(row => rowKeyOf(row, rowKey)))
const chosen = memo(() => {
  const set = new Set(picked())

  return keyed().filter(key => set.has(key))
}, { equals: (a, b) => a.length === b.length && a.every((key, index) => key === b[index]) })
const chosenSet = memo(() => new Set(chosen()))
const visible = memo(() => kept().map(row => rowKeyOf(row, rowKey)))
const allChosen = memo(() => visible().length > 0 && visible().every(key => chosenSet().has(key)))
const someChosen = memo(() => visible().some(key => chosenSet().has(key)))
const countChosen = selectedLabel ?? ((count: number) => wording('ui.table.selected', '{count} selected', { count }))

// A row that left `rows` leaves the selection for good, so it is not picked again if it comes back.
effect(() => {
  const next = chosen()

  if (selectable && next.length !== picked().length)
    commit(next)
})

function commit(keys: RowKeyValue<Row, Key>[]) {
  picked = keys

  if (!onSelect)
    return

  const wanted = new Set(keys)

  onSelect(keys, rows().filter(row => wanted.has(rowKeyOf(row, rowKey))))
}

function pick(key: RowKeyValue<Row, Key>, on: boolean) {
  commit(on ? keyed().filter(other => other === key || chosenSet().has(other)) : chosen().filter(other => other !== key))
}

// Only the rows the filter shows are picked or dropped, so a row it hides keeps its state.
function pickAll(on: boolean) {
  const shownKeys = new Set(visible())

  commit(on ? keyed().filter(key => chosenSet().has(key) || shownKeys.has(key)) : chosen().filter(key => !shownKeys.has(key)))
}

const shown = memo(() => serverSort || list ? kept() : sortedRows(kept(), columns(), current()))
const sorting = (column: Column<Row>) => column.sortValue !== undefined && current()?.key === column.key

const endpoint = memo(() => {
  const value = exportable

  return typeof value === 'string' ? value : undefined
})

// Without `virtual` every row is drawn; with it the others stand for room above and below.
const windowed = virtual ? virtualRows({ items: () => shown(), keyOf: row => rowKeyOf(row, rowKey), estimate: 48, overscan: 8 }) : undefined
const drawn = memo(() => windowed ? windowed.rows() : shown())
let box: HTMLElement | undefined
let body: HTMLElement | undefined

onMount(() => {
  if (windowed)
    onCleanup(windowed.attach(box!, body!))
})

function download() {
  const url = URL.createObjectURL(new Blob([toCsv(shown(), columns())], { type: 'text/csv;charset=utf-8' }))
  const link = document.createElement('a')

  link.href = url
  link.download = exportName
  link.click()
  setTimeout(() => URL.revokeObjectURL(url), 10_000)
}

function toggle(column: Column<Row>) {
  const next = nextSort(current(), column)

  current = next
  keptKey?.set(next.key)
  keptDirection?.set(next.direction)
  onSort?.(next)
}

function ariaSort(column: Column<Row>): 'ascending' | 'descending' | undefined {
  if (!sorting(column))
    return undefined

  return current()?.direction === 'asc' ? 'ascending' : 'descending'
}
---
div({...rest} ref={element => box = element} data-narrow={narrow} data-virtual={virtual ? '' : undefined} tabindex={virtual ? '0' : undefined})
  if searching() || extra.length > 0
    div(part="filter")
      if searching()
        label(part="field")
          span.kui-label-text(part="filterLabel") {filterLabel}
          input.kui-field-input(part="filterInput" type="search" value={typed()} placeholder={filterPlaceholder} autocomplete="off" onInput={event => typed.set(event.currentTarget.value)})
      for field, index of extra key={field.key}
        label(part="field")
          span.kui-label-text(part="filterLabel") {field.label}
          if field.options
            Select(value={fieldValues[index]!()} options={field.options} emptyOption onChange={fieldValues[index]!.set})
          else
            input.kui-field-input(part="filterInput" type="search" value={fieldValues[index]!()} autocomplete="off" onInput={event => fieldValues[index]!.set(event.currentTarget.value)})
    p(part="count" role="status") {list ? (filtering() && !list.pending() ? counted(rows().length) : '') : (typed() ? counted(kept().length) : '')}
  if selectable || exportable
    div(part="selection")
      if selectable
        Checkbox(label={selectAllLabel} checked={allChosen()} indeterminate={someChosen() && !allChosen()} disabled={visible().length === 0} onChange={pickAll})
        p(part="selected" role="status") {chosen().length > 0 ? countChosen(chosen().length) : ''}
        if chosen().length > 0 && bulk
          div(part="bulk")
            | {bulk(chosen(), () => commit([]))}
      if exportable
        if endpoint() as address
          Button(href={exportHref(address, current(), filterParam ?? 'q', typed(), fieldsNow())} download={exportName} label={exportLabel} variant="ghost" size="sm")
        else
          Button(label={exportLabel} variant="ghost" size="sm" onClick={download})
  table(part="table" aria-rowcount={virtual ? shown().length + 1 : undefined})
    thead(part="head")
      tr(part="headRow" aria-rowindex={virtual ? 1 : undefined})
        if selectable
          th(part="selectHead" scope="col")
            span(part="selectText") {selectAllLabel}
        for column of columns() key={column.key}
          th(part="headCell" scope="col" data-align={column.align ?? 'start'} aria-sort={ariaSort(column)})
            if column.sortValue
              button(part="sortButton" type="button" data-direction={sorting(column) ? current()?.direction : undefined} onClick={() => toggle(column)})
                | {column.header}
                if sorting(column)
                  Icon(icon="chevron" part="sortIcon")
            else
              | {column.header}
    tbody(part="body" ref={element => body = element})
      if windowed && windowed.before() > 0
        tr(part="spacer" aria-hidden="true" style={`height: ${windowed.before()}px`})
          td(colspan={given.length + (selectable ? 1 : 0)} style="padding: 0; border: 0")
      for row, position of drawn() key={rowKeyOf(row, rowKey)}
        tr(part="row" data-virtual-index={windowed ? windowed.start() + position : undefined} aria-rowindex={windowed ? windowed.start() + position + 2 : undefined} aria-selected={selectable ? (chosenSet().has(rowKeyOf(row, rowKey)) ? 'true' : 'false') : undefined})
          if selectable
            td(part="selectCell")
              div(part="cellBody")
                Checkbox(checked={chosenSet().has(rowKeyOf(row, rowKey))} aria-label={(selectRowLabel ?? (item => wording('ui.table.selectRow', 'Select {row}', { row: rowLabel(item, columns(), rowKey) })))(row)} onChange={on => pick(rowKeyOf(row, rowKey), on)})
          for column of columns() key={column.key}
            td(part="cell" data-align={column.align ?? 'start'} data-numeric={column.numeric ? '' : undefined})
              if narrow === 'stack' && column.header
                span(part="cellLabel") {column.header}
              div(part="cellBody")
                if cell && drawnByBlock(column, given)
                  | {cell(row, column)}
                else
                  | {cellText(row, column)}
      else
        if (list ? filtering() : rows().length > 0) && noMatch
          tr
            td(part="emptyCell" colspan={given.length + (selectable ? 1 : 0)})
              | {noMatch}
        else if empty
          tr
            td(part="emptyCell" colspan={given.length + (selectable ? 1 : 0)})
              | {empty}
      if windowed && windowed.after() > 0
        tr(part="spacer" aria-hidden="true" style={`height: ${windowed.after()}px`})
          td(colspan={given.length + (selectable ? 1 : 0)} style="padding: 0; border: 0")
  if list
    LoadMore(list={list})
