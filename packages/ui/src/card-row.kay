---
import { recipe } from 'kay'
import type { JSX, Snippet } from 'kay'

// The actions are dimmed until the row is hovered or holds focus, which the row's `group/row` tells them.
const look = recipe({
  parts: {
    root: 'kui-card-row group/row flex items-center gap-3 rounded-kui-card border-(length:--kui-border-width) border-solid border-kui-surface2 bg-kui-surface0 p-4 [box-shadow:var(--shadow-raised)]',
    body: 'min-w-0 flex-1',
    actions: 'flex shrink-0 items-center gap-2 opacity-60 transition-opacity group-hover/row:opacity-100 group-focus-within/row:opacity-100',
  },
})

const { left, right, actions, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class'> & {
  // The leading element: a toggle, an icon, a colour dot.
  left?: Snippet
  // A trailing readout, always shown.
  right?: Snippet
  // Controls at the end of the row, dimmed until the row is hovered or focused.
  actions?: Snippet
}>()
---
// One line of a list drawn as cards: the children are its body, between what leads and what trails.
div({...rest})
  | {left}
  div(part="body")
    slot
  | {right}
  if actions
    div(part="actions")
      | {actions}
