---
import { signal } from 'kay'
import ChipGroup from '@kaynooo/kayjs-ui/chip-group.kay'
import FormField from '@kaynooo/kayjs-ui/form-field.kay'

// A required that the page turns off, and a ChipGroup holding the form back until one chip is picked.
const needed = signal(true)
const held = [{ value: 'x', label: 'X', disabled: true }, { value: 'y', label: 'Y' }]
const tags = [{ value: 'a', label: 'A' }, { value: 'b', label: 'B' }]
---
form#form
  FormField(label="Title" required={needed()})
    input#title(name="title")
  FormField(label="Access" group required={needed()})
    input#read(name="access" type="checkbox")
    input#write(name="access" type="checkbox")
  FormField(label="Own" required)
    input#own(name="own" required)
  ChipGroup#chips(options={tags} label="Tags" required={needed()})
  ChipGroup#held(options={held} label="Held" required)
  FormField(label="Framed" group required)
    ChipGroup#framed(options={tags} label="Framed tags")
  button#off(type="button" onClick={() => needed = false}) Off
