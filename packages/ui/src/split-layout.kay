---
import type { JSX, Snippet } from 'kay'
import { effect, onCleanup, onMount, recipe, signal, untrack } from 'kay'
import IconButton from './icon-button.kay'
import { wording } from 'kay/words'

// Where the layout stops being side by side, `md` in Tailwind.
const NARROW = '(width < 48rem)'
const FOCUSABLE = 'button:not([disabled]), a[href], input:not([disabled]):not([type="hidden"]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
const WIDTH = { default: 260, min: 180, max: 560, step: 20 }

const look = recipe({ parts: { root: 'kui-split-layout', sidebar: 'kui-split-layout-sidebar', sidebarHead: 'kui-split-layout-sidebar-head', sidebarTitle: 'kui-split-layout-sidebar-title', sidebarBody: 'kui-split-layout-sidebar-body', list: 'kui-split-layout-list', listHead: 'kui-split-layout-list-head', resizer: 'kui-split-layout-resizer', detail: 'kui-split-layout-detail', detailHead: 'kui-split-layout-detail-head' } })

const { list, detail, listHead, detailHead, sidebar, sidebarTitle = '', detailOpen = false, sidebarOpen = false, onSidebarOpenChange, resizableList = false, listWidthKey, resizeLabel = wording('ui.splitLayout.resize', 'Resize list'), backLabel = wording('ui.splitLayout.back', 'Back'), style, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'style' | 'children'> & {
  list: Snippet
  detail: Snippet
  listHead?: Snippet
  detailHead?: Snippet
  // A navigation column left of the list, from `md` up; below it, an overlay `sidebarOpen` shows.
  sidebar?: Snippet
  sidebarTitle?: string | undefined
  // Below `md`, whether the detail pane takes the list's place.
  detailOpen?: boolean | undefined
  // Below `md`, whether the sidebar covers the layout; its back button calls `onSidebarOpenChange(false)` for the parent to set it back to false.
  sidebarOpen?: boolean | undefined
  // Called with `false` when the back button closes the sidebar.
  onSidebarOpenChange?: ((open: boolean) => unknown) | undefined
  // A handle on the list's right edge, from `md` up, dragged or moved with the arrow keys.
  resizableList?: boolean | undefined
  // The `localStorage` key the list's width is kept under, from one visit to the next.
  listWidthKey?: string | undefined
  resizeLabel?: string | undefined
  backLabel?: string | undefined
  style?: string | undefined
}>()

const listWidth = signal(WIDTH.default)
const narrow = signal(false)
let sidebarPane: HTMLElement | undefined
let detailPane: HTMLElement | undefined
let listPane: HTMLElement | undefined

effect(() => {
  const query = matchMedia(NARROW)
  const change = (event: MediaQueryListEvent) => narrow = event.matches

  narrow = query.matches
  query.addEventListener('change', change)
  onCleanup(() => query.removeEventListener('change', change))
})

// Below `md` a pane that opens takes focus on its first control, and the control that opened it gets focus back when it closes; the first render and a wide layout leave focus alone.
function followFocus(open: () => boolean, pane: () => HTMLElement | undefined) {
  let was = untrack(open)
  let opener: Element | null = null

  effect(() => {
    const now = open()
    const small = narrow()

    if (now === was)
      return

    was = now

    if (!small) {
      opener = null

      return
    }

    if (now) {
      opener = document.activeElement
      queueMicrotask(() => {
        const element = pane()
        const first = element?.querySelector<HTMLElement>(FOCUSABLE)

        if (first)
          first.focus()
        else
          element?.focus()
      })
    }
    else {
      const back = opener

      opener = null
      // A pane open from the first render has no opener, and a re-rendered opener is gone: the list's first control takes focus instead of the body.
      queueMicrotask(() => {
        const target = back instanceof HTMLElement && back.isConnected ? back : listPane?.querySelector<HTMLElement>(FOCUSABLE)

        target?.focus()
      })
    }
  })
}

followFocus(() => sidebarOpen, () => sidebarPane)
followFocus(() => detailOpen, () => detailPane)

function closeSidebar() {
  onSidebarOpenChange?.(false)
}

function clampWidth(px: number): number {
  return Math.min(WIDTH.max, Math.max(WIDTH.min, px))
}

// Read once mounted, since the server has no storage: the page renders at the default width, then takes the kept one.
onMount(() => {
  if (!listWidthKey)
    return

  try {
    const stored = Number(localStorage.getItem(listWidthKey))

    if (stored)
      listWidth = clampWidth(stored)
  }
  catch {
    // Storage can be blocked; the default width stands.
  }
})

function remember() {
  if (!listWidthKey)
    return

  try {
    localStorage.setItem(listWidthKey, String(listWidth()))
  }
  catch {
    // Storage can be blocked; the width just lasts the visit.
  }
}

function startResize(event: PointerEvent) {
  const handle = event.currentTarget as HTMLElement
  const startX = event.clientX
  const startWidth = listWidth()
  const move = (next: PointerEvent) => listWidth = clampWidth(startWidth + next.clientX - startX)

  event.preventDefault()
  handle.setPointerCapture(event.pointerId)
  handle.addEventListener('pointermove', move)

  // A cancelled drag, as when the browser takes a touch over, ends it too, keeping the width it reached.
  const end = () => {
    handle.removeEventListener('pointermove', move)
    handle.removeEventListener('pointerup', end)
    handle.removeEventListener('pointercancel', end)
    remember()
  }

  handle.addEventListener('pointerup', end)
  handle.addEventListener('pointercancel', end)
}

function resizeByKey(event: KeyboardEvent) {
  const delta = { ArrowLeft: -WIDTH.step, ArrowRight: WIDTH.step }[event.key]

  if (delta === undefined)
    return

  event.preventDefault()
  listWidth = clampWidth(listWidth() + delta)
  remember()
}
---
// The sidebar is rendered once: from `md` up a column, below it the overlay `data-sidebar-open` shows.
div(part="root" {...rest} style={`--_split-list-width: ${listWidth()}px;${style ? ` ${style}` : ''}`} data-sidebar={sidebar ? '' : undefined} data-sidebar-open={sidebarOpen ? '' : undefined} data-detail-open={detailOpen ? '' : undefined})
  if sidebar
    aside(part="sidebar" ref={element => sidebarPane = element})
      div(part="sidebarHead")
        IconButton(icon="back" label={backLabel} variant="ghost" size="lg" onClick={closeSidebar})
        span(part="sidebarTitle") {sidebarTitle}
      div(part="sidebarBody")
        | {sidebar}
  section(part="list" inert={narrow() && sidebarOpen} ref={element => listPane = element})
    if listHead
      div(part="listHead")
        | {listHead}
    | {list}
    if resizableList
      // A focusable separator is a widget, moved with the arrow keys as well as dragged.
      div(part="resizer" role="separator" tabindex="0" aria-label={resizeLabel} aria-orientation="vertical" aria-valuenow={listWidth()} aria-valuemin={WIDTH.min} aria-valuemax={WIDTH.max} onPointerDown={startResize} onKeyDown={resizeByKey})
  section(part="detail" tabindex={narrow() ? '-1' : undefined} inert={narrow() && sidebarOpen} ref={element => detailPane = element})
    if detailHead
      div(part="detailHead")
        | {detailHead}
    | {detail}
