--- server
import { localPath } from 'kay'
import { localize } from 'kay/i18n'
import { wording } from 'kay/words'
import Captcha from '../components/captcha.kay'
import Message from '../components/message.kay'
import Panel from '../components/panel.kay'
import { captchaFor, captchaOf, failure, guarded, issue, refusal, refusedFor, schemas } from '../forms'
import Button from '@kaynooo/kayjs-ui/button.kay'
import FormField from '@kaynooo/kayjs-ui/form-field.kay'

// Visitors reach this page before signing in, so none of the app's guards run here, whatever they check: one asking for a session would keep everyone out.
// The link's token sits in the address, which no Referer header may carry to another site; `same-origin` still lets a form post carry its Origin.
export const page = { guards: false, security: { headers: { 'referrer-policy': 'same-origin' } } }

export const request = action(schemas.requestReset, async (input, ctx) => {
  const result = await ctx.locals.auth.requestPasswordReset(input.email, { redirect: input.redirect, captcha: captchaOf(input) })

  return result.ok ? 'sent' : ctx.fail(400, { error: refusedFor(result.error, input) })
}, guarded)

export const reset = action(schemas.reset, async ({ token, password }, ctx) => {
  const result = await ctx.locals.auth.resetPassword(token, password)

  if (!result.ok)
    return ctx.fail(400, 'errors' in result ? { password: result.errors.password } : { error: result.error === 'invalid' ? 'link' : result.error })

  return ctx.redirect(localize(result.redirect))
})

const auth = ctx.locals.auth
const features = auth.features()
const redirect = localPath(ctx.url.searchParams.get('redirect'), localize(features.pages?.home ?? '/'))
const token = ctx.url.searchParams.get('token') ?? reset.failed()?.values.token
// Only the request form asks for a captcha, so a visit with a token never reads the client's attempts.
const captcha = token ? { shown: false, challenge: null } : await captchaFor(auth, features.captcha, 'reset')
const requestError = refusal(request.failed(), features.captcha)
const refused = reset.failed()?.data
const sent = request.succeeded() !== undefined
---
head
  title {wording('auth.reset.title', 'Reset your password')}
if token
  Panel(title={wording('auth.reset.choose', 'Choose a new password')})
    form.flex.flex-col.gap-3(action={reset})
      input(type="hidden" name="token" value={token})
      FormField(label={wording('auth.newPassword', 'New password')} hint={wording('auth.passwordHint', 'At least {min} characters', { min: features.rules.password.min })} issue={refused && 'password' in refused ? issue('password', refused.password, features.rules) : undefined} required)
        input(name="password" type="password" autocomplete="new-password" minlength={features.rules.password.min} required)
      if refused && 'error' in refused
        Message(text={failure(refused.error)})
      Button(type="submit" tone="accent" label={wording('auth.reset.save', 'Save the password')})
else
  Panel(title={wording('auth.reset.title', 'Reset your password')})
    if sent
      Message(tone="success" text={wording('auth.reset.sent', 'If an account has this address, a link to reset its password is on its way.')})
    else if !features.email
      Message(text={failure('unavailable')})
    else
      form.flex.flex-col.gap-3(action={request})
        input(type="hidden" name="redirect" value={redirect})
        p {wording('auth.reset.intro', 'We will mail you a link to choose a new password.')}
        FormField(label={wording('auth.email', 'Email')} required)
          input(name="email" type="email" autocomplete="email" required)
        if features.captcha && captcha.shown
          Captcha(widget={features.captcha} challenge={captcha.challenge} action="reset")
        if requestError
          Message(text={requestError})
        Button(type="submit" tone="accent" label={wording('auth.reset.submit', 'Mail me a link')})
