--- server
import { shareCard } from 'kay/image'
import { docs, reference } from '../../../content.config'
import { FORGE } from '../../../forge'
import { docPages, neighbours } from '../../../pages'
import { LLMS_GUIDES } from '../../../reference'
import { sectionOf } from '../../../sections'

export const page = {
  prerender: async () => {
    return (await docPages()).map((entry) => {
      const [section, page] = entry.slug.split('/')

      return { section: section!, page: page! }
    })
  },
}

const slug = `${ctx.params.section}/${ctx.params.page}`
// A page served from llms/ has no frontmatter of its own: its title is the doc's, its description is kept in reference.ts.
const guide = LLMS_GUIDES.find(one => one.slug === slug)
const entry = guide ? await reference.get(guide.topic) ?? ctx.notFound() : await docs.get(slug) ?? ctx.notFound()
const { Content } = entry
const { title } = entry.data
const description = guide?.description ?? ('description' in entry.data ? entry.data.description : '')
const path = 'path' in entry.data ? entry.data.path : undefined
const source = guide ? `${FORGE}/llms/${guide.topic}.md` : `${FORGE}/docs/src/content/docs/${slug}.md`
const sections = entry.headings.filter(heading => heading.depth === 2 || heading.depth === 3)
// The pager stays in the page's part: the Structure pages lead to each other, the other sections to theirs.
const structure = (slug: string) => sectionOf(slug)?.slug === 'structure'
const { previous, next } = neighbours((await docPages()).filter(one => structure(one.slug) === structure(slug)), slug, href => `/${href}`)
--- script
import Pager from '../../../components/pager.kay'
import Toc from '../../../components/toc.kay'
---
head
  title {title} · kay
  meta(name="description" content={description})
  meta(property="og:image" content={shareCard({ title })})
  meta(property="og:image:alt" content={title})
.page
  header.page-head
    if path as file
      p.eyebrow: code {file}
    else
      p.eyebrow {sectionOf(slug)?.title}
    h1 {title}
    p.lede {description}
  if sections.length > 0
    Toc(sections={sections})
  article.prose
    Content
  Pager(previous={previous} next={next} source={source})
