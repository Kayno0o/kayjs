--- <Item>
import type { JSX, Snippet } from 'kay'
import { effect, elementSize, memo, onCleanup, onMount, recipe, signal, untrack } from 'kay'
import { laneCount, masonryLayout } from './masonry'

type Key = string | number

const look = recipe({
  parts: {
    root: 'kui-masonry grid grid-cols-[repeat(auto-fill,minmax(min(var(--_masonry-min),100%),1fr))] items-start gap-(--_masonry-gap) data-laid-out:relative data-laid-out:block',
    // A tile's place is its lane and offset once measured, and it stays invisible until its height is known.
    tile: 'kui-masonry-item min-w-0 data-pending:invisible data-placed:absolute data-placed:top-(--_masonry-top) data-placed:left-[calc(var(--_masonry-lane)*(100%_+_var(--_masonry-gap))/var(--_masonry-lanes))] data-placed:w-[calc((100%_-_(var(--_masonry-lanes)_-_1)_*_var(--_masonry-gap))/var(--_masonry-lanes))]',
  },
})

const { items, key, minWidth = 256, gap = 12, tile, style, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'style' | 'children'> & {
  items: readonly Item[]
  // Names an item across updates, so its tile keeps its place and its measured height.
  key: (item: Item) => Key
  // The narrowest a lane may get, in pixels: as many lanes as fit at that width share the row.
  minWidth?: number | undefined
  // Between two lanes and between two tiles of a lane, in pixels.
  gap?: number | undefined
  // Draws each tile: `@tile(item)`.
  tile: Snippet<[item: Item]>
  style?: string | undefined
}>()

const rootSize = elementSize()
// A height stays known while the item is in the list, and goes with it when the item leaves.
const heights = signal<ReadonlyMap<Key, number>>(new Map())
const keys = new WeakMap<Element, Key>()
let root: HTMLElement | undefined
let observer: ResizeObserver | undefined

const lanes = memo(() => laneCount(rootSize.width(), minWidth, gap))
// Until the width is known, as on the server, the tiles stay in a plain grid of the same lanes.
const layout = memo(() => rootSize.width() > 0 ? masonryLayout(items.map(item => heights().get(key(item))), lanes(), gap) : null)

// The height of a tile whose item left goes with it, whether or not another tile resizes.
effect(() => {
  const present = new Set(items.map(key))
  const known = untrack(heights)

  if ([...known.keys()].some(name => !present.has(name)))
    heights.set(new Map([...known].filter(([name]) => present.has(name))))
})

const place = (index: number) => layout()?.places[index]

// One observer for every tile's height.
onMount(() => {
  observer = new ResizeObserver((entries) => {
    const present = new Set(items.map(key))
    const next = new Map([...heights()].filter(([name]) => present.has(name)))

    for (const entry of entries) {
      const name = keys.get(entry.target)!

      if (present.has(name)) next.set(name, entry.borderBoxSize?.[0]?.blockSize ?? (entry.target as HTMLElement).offsetHeight)
    }

    heights.set(next)
  })

  for (const [index, node] of [...root!.children].entries()) {
    keys.set(node, key(items[index]!))
    observer.observe(node)
  }

  onCleanup(() => observer?.disconnect())
})

// A tile rendered after mounting is measured from then on, until it leaves.
function measure(node: HTMLElement, id: Key) {
  keys.set(node, id)
  observer?.observe(node)
  onCleanup(() => observer?.unobserve(node))
}
---
// Tiles placed absolutely inside the layout's own box, so padding goes on a wrapper, never on the Masonry.
div(part="root" {...rest} ref={element => { root = element; rootSize.ref(element) }} style={`--_masonry-min: ${minWidth}px; --_masonry-gap: ${gap}px; --_masonry-lanes: ${lanes()};${layout() ? ` height: ${layout()!.height}px;` : ''}${style ? ` ${style}` : ''}`} data-laid-out={layout() ? '' : undefined})
  for item, index of items key={key(item)}
    div(part="tile" ref={element => measure(element, key(item))} style={place(index) ? `--_masonry-lane: ${place(index)!.lane}; --_masonry-top: ${place(index)!.top}px;` : undefined} data-placed={place(index) ? '' : undefined} data-pending={place(index) && !heights().has(key(item)) ? '' : undefined})
      | {tile(item)}
