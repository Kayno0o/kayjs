---
import { signal } from 'kay'
import FormField from '@kaynooo/kayjs-ui/form-field.kay'
import Select from '@kaynooo/kayjs-ui/select.kay'
import TextInput from '@kaynooo/kayjs-ui/text-input.kay'
import Textarea from '@kaynooo/kayjs-ui/textarea.kay'

const { onPlanet, onCommit, onFilter, onLeave, onPicked } = props<{ onPlanet: (value: string) => void, onCommit: (value: string) => void, onFilter?: (query: string) => void, onLeave?: (id: string) => void, onPicked?: (picked: unknown) => void }>()

const name = signal('Ada')
const amount = signal<number | null>(2)
const LEVELS = [{ value: 1, label: 'One' }, { value: 2, label: 'Two' }]
const KINDS: { value: 'post' | 'page', label: string }[] = [{ value: 'post', label: 'Post' }, { value: 'page', label: 'Page' }]
const kind = signal<'post' | 'page' | ''>('')

function level(next: number) {
  onPicked?.(next)
}

function pickKind(next: 'post' | 'page' | '') {
  kind.set(next)
  onPicked?.(next)
}
// Kept as the names it reads, one per line, as a roster would.
const roster = signal('Ada\nGrace')
// A message being written, which a send clears while the box is focused.
const draft = signal('')
---
TextInput#name(value={name()} onInput={value => name.set(value)} onChange={onCommit} onBlur={event => onLeave?.(event.currentTarget.id)})
p#echo {name()}
TextInput#amount(type="number" value={amount()} onInput={amount.set} onChange={next => onPicked?.(next)})
p#figure {amount() === null ? 'none' : `${typeof amount()} ${amount()}`}
button#reset(onClick={() => amount.set(null)}) Reset
button#clear(onClick={() => name.set('')}) Clear
Select#planet(value="mars" busy options={[{ value: 'mars', label: 'Mars' }, { value: 'earth', label: 'Earth' }]} onChange={onPlanet})
Select#level(value={1} options={LEVELS} onChange={level})
Select#kind(value={kind()} options={KINDS} emptyOption="Any" onChange={pickKind})
TextInput#plain(name="email" aria-label="Email")
Textarea#roster(aria-label="Roster" onBlur={event => onLeave?.(event.currentTarget.id)} value={roster()} onInput={value => roster.set(value.split('\n').map(line => line.trim()).filter(Boolean).join('\n'))})
p#names {roster()}
Textarea#draft(aria-label="Draft" value={draft()} onInput={draft.set})
button#send(onClick={() => draft.set('')}) Send
button#restore(onClick={() => draft.set('Back')}) Restore
Textarea#live(aria-label="Live" writeFocused value={draft()} onInput={draft.set})
form#filters(method="get" onSubmit={event => { event.preventDefault(); onFilter?.(String(new FormData(event.currentTarget).get('period'))) }})
  FormField(label="Period" compact)
    Select(name="period" value="" emptyOption="Any" submit options={[{ value: '7d', label: '7 days' }]})
