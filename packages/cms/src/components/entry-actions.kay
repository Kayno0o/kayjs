---
import type { EntryForm } from '../form'
import Badge from '@kaynooo/kayjs-ui/badge.kay'
import Button from '@kaynooo/kayjs-ui/button.kay'
import ConfirmDelete from '@kaynooo/kayjs-ui/confirm-delete.kay'
import { wording } from 'kay/words'
import type { Denials } from '../access'
import { collectionPath, deleteMessage, historyPath, onPagePath } from '../listing'
import Refused from './refused.kay'
import EntrySaveState from './entry-save-state.kay'
import ResetButton from './reset-button.kay'

// The Draft badge, or the Scheduled one for a published entry whose date is ahead, and the buttons of an entry's screen: Edit on page, Publish or Unpublish (Publish now and Clear schedule beside the Scheduled badge, Clear end date beside the Ends or Ended badge) and Delete for a saved entry, Reset once edited, Save or Create, which waits for something to save, and where the entry stands. Meant for the header's slot.
// `denied`, from `denials`, lists the actions the signed-in person's role may not do, whose buttons are then disabled with the reason.
const { form, denied = {} } = props<{ form: EntryForm, denied?: Denials }>()

const entry = form.stored
---
if form.isDraft()
  Badge(tone="warning" label={wording('cms.entry.draft', 'Draft')})
else if form.scheduled() as at
  Badge(tone="info" label={wording('cms.table.scheduled', 'Scheduled for {at}', { at })})
if form.ended()
  Badge(tone="warning" label={wording('cms.entry.ended', 'Ended')})
else if form.ends() as at
  Badge(tone="info" label={wording('cms.entry.endsAt', 'Ends {at}', { at })})
.kcms-entry-actions
  EntrySaveState(changed={form.dirty()} saving={form.saving()} saved={form.savedAt()} url={entry?.url})
  if entry
    if form.scheduled() && form.collection.publishField !== undefined
      if denied.publish !== undefined
        Refused(label={wording('cms.entry.publishNow', 'Publish now')} reason={denied.publish})
        Refused(label={wording('cms.entry.unschedule', 'Clear schedule')} reason={denied.publish})
      else
        Button(label={wording('cms.entry.publishNow', 'Publish now')} disabled={form.saving()} onClick={form.publishNow})
        Button(label={wording('cms.entry.unschedule', 'Clear schedule')} disabled={form.saving()} onClick={form.unschedule})
    if (form.ends() || form.ended()) && form.collection.unpublishField !== undefined
      if denied.publish !== undefined
        Refused(label={wording('cms.entry.clearEnd', 'Clear end date')} reason={denied.publish})
      else
        Button(label={wording('cms.entry.clearEnd', 'Clear end date')} disabled={form.saving()} onClick={form.clearEnd})
    if entry.url as url
      Button(href={onPagePath(form.prefix, url)} label={wording('cms.entry.editOnPage', 'Edit on page')})
    if form.collection.history
      Button(href={historyPath(form.prefix, { collection: form.collection.name, slug: entry.slug, locale: entry.locale })} label={wording('cms.history.open', 'History')})
    if form.isDraft()
      if denied.publish !== undefined
        Refused(label={wording('cms.entry.publish', 'Publish')} reason={denied.publish})
      else
        Button(label={wording('cms.entry.publish', 'Publish')} disabled={form.saving()} onClick={form.publish})
    else if form.collection.draftField !== undefined && denied.publish !== undefined
      Refused(label={wording('cms.entry.unpublish', 'Unpublish')} reason={denied.publish})
    else if form.collection.draftField !== undefined && form.dirty()
      // The dialog would only lead to a refusal over unsaved edits.
      Button(label={wording('cms.entry.unpublish', 'Unpublish')} disabled={form.saving()} onClick={form.unpublish})
    else if form.collection.draftField !== undefined
      ConfirmDelete(tone="neutral" trigger="button" label={wording('cms.entry.unpublish', 'Unpublish')} message={wording('cms.entry.unpublishMessage', 'Unpublish {title}? Visitors stop seeing it until you publish it again.', { title: form.name })} failure={wording('cms.entry.unpublishFailure', 'Could not unpublish')} onConfirm={form.unpublish})
    if !form.collection.single && denied.delete !== undefined
      Refused(label={wording('cms.bulk.delete', 'Delete')} reason={denied.delete} tone="danger")
    else if !form.collection.single
      ConfirmDelete(message={deleteMessage(form.name, entry.url, 'entry', form.referrers())} onOpen={form.askReferrers} failure={wording('cms.save.deleteFailure', 'Could not delete')} trigger="button" onConfirm={form.remove})
  if form.dirty()
    ResetButton(disabled={form.saving()} onReset={form.reset})
  if !entry && !form.collection.single
    Button(href={collectionPath(form.prefix, form.collection.name)} label={wording('cms.entry.cancel', 'Cancel')} variant="ghost")
    Button(label={wording('cms.entry.createAndAdd', 'Create and add another')} disabled={!form.canSave()} onClick={form.saveAndAdd})
  Button(type="submit" label={form.saving() ? wording('cms.entry.saving', 'Saving…') : entry ? wording('cms.entry.save', 'Save') : wording('cms.entry.create', 'Create')} tone="accent" busy={form.saving()} disabled={!form.canSave()})
