---
import type { Snippet } from 'kay'
import type { IconProps } from 'kay/icons'
import type { AiToolCall, ChatIconValue } from './types'
import { recipe } from 'kay'
import Icon from '@kayjs/ui/icon.kay'

const look = recipe({ parts: { root: 'kai-chat-calls', summary: 'kai-chat-calls-summary', list: 'kai-chat-calls-list', call: 'kai-chat-call', name: 'kai-chat-call-name', toolIcon: 'kai-chat-call-icon', status: 'kai-chat-call-status', title: 'kai-chat-call-title', code: 'kai-chat-call-code' } })

const { calls, block, pending = false, labels, icons, details, runningLabel, doneLabel, failedLabel, argumentsLabel, resultLabel, approvalLabel } = props<{
  calls: AiToolCall[]
  // The app's own drawing of one call, which replaces the folded list.
  block?: Snippet<[call: AiToolCall]> | undefined
  // Set in the turn being written, which is hidden from assistive technology: nothing in it takes focus.
  pending?: boolean
  // The phrase for a tool by its name, in the folded line.
  labels: Record<string, string>
  // The icon for a tool by its name, drawn before its label in the folded line and before its name in an opened call: an icon of the app's set or one imported from `~icons/<prefix>/<name>`. A tool without one keeps the plain row.
  icons?: Record<string, ChatIconValue> | undefined
  // Whether a call opens to its arguments and result.
  details: boolean
  runningLabel: string
  doneLabel: string
  failedLabel: string
  argumentsLabel: string
  resultLabel: string
  // Said of a call held for the visitor's yes, in place of failed.
  approvalLabel: string
}>()

const statusLabels = () => ({ running: runningLabel, done: doneLabel, failed: failedLabel })

function status(call: AiToolCall) {
  return call.approval === undefined ? statusLabels()[call.status] : approvalLabel
}

const iconOf = (name: string) => icons?.[name] as IconProps | undefined

// Each tool once with its count: `Searched the docs ×2`, `read_page`.
function tools() {
  const counts = new Map<string, number>()
  const labelled = new Map<string, string>()

  for (const call of calls) {
    counts.set(call.name, (counts.get(call.name) ?? 0) + 1)

    if (call.label !== undefined)
      labelled.set(call.name, call.label)
  }

  return [...counts].map(([name, count]) => ({ name, text: `${labels[name] ?? labelled.get(name) ?? name}${count > 1 ? ` ×${count}` : ''}` }))
}

// What ends the line: the status of what is not done.
function ending() {
  const failed = calls.some(call => call.status === 'failed' && call.approval === undefined)
  const held = calls.some(call => call.approval !== undefined)

  if (calls.some(call => call.status === 'running'))
    return ` (${statusLabels().running})`

  if (failed)
    return ` (${statusLabels().failed})`

  return held ? ` (${approvalLabel})` : ''
}

// The calls in one line: `Searched the docs ×2, read_page (Failed)`.
const summary = () => tools().map(tool => tool.text).join(', ') + ending()

// Whether the line is drawn tool by tool, as it holds an icon.
const iconed = () => icons !== undefined && tools().some(tool => iconOf(tool.name) !== undefined)
---
if block
  div(part="root")
    ul(part="list")
      for call of calls key={call.id}
        li(part="call" data-status={call.status} data-held={call.approval === undefined ? undefined : ''})
          slot block(call)
else
  details(part="root")
    summary(part="summary" tabindex={pending ? -1 : undefined})
      if iconed()
        for tool, index of tools() key={tool.name}
          | {index === 0 ? '' : ', '}
          if iconOf(tool.name) !== undefined
            Icon(part="toolIcon" icon={iconOf(tool.name)!})
          | {tool.text}
        | {ending()}
      else
        | {summary()}
    ul(part="list")
      for call of calls key={call.id}
        li(part="call" data-status={call.status} data-held={call.approval === undefined ? undefined : ''})
          if details
            details
              summary(tabindex={pending ? -1 : undefined})
                if iconOf(call.name) !== undefined
                  Icon(part="toolIcon" icon={iconOf(call.name)!})
                span(part="name") {call.name}
                |
                span(part="status") {status(call)}
              p(part="title") {argumentsLabel}
              pre(part="code") {JSON.stringify(call.input, null, 2)}
              if call.result !== undefined
                p(part="title") {resultLabel}
                pre(part="code") {call.result}
          else
            if iconOf(call.name) !== undefined
              Icon(part="toolIcon" icon={iconOf(call.name)!})
            span(part="name") {call.name}
            |
            span(part="status") {status(call)}
