{
  "name": "@kaynooo/kayjs-mail",
  "type": "module",
  "version": "1.54.1",
  "description": "Mail for kay apps: SMTP configured from typed env variables, mails written as .kay components, a development outbox page, a test outbox and queued sending",
  "author": "Kaynooo <https://github.com/Kayno0o>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kayno0o/kayjs",
    "directory": "packages/mail"
  },
  "bugs": {
    "url": "https://github.com/Kayno0o/kayjs/issues"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/"
  },
  "kay": {
    "settings": "./src/settings.ts"
  },
  "exports": {
    "./*.kay": "./src/*.kay",
    "./add": "./src/add.ts",
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "llms",
    "llms.txt",
    "src",
    "types"
  ],
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "prepare": "$npm_execpath ../../scripts/link-fixture.ts",
    "check": "$npm_execpath check",
    "build:types": "rm -rf types && bun ../../src/tsgo.ts -p tsconfig.build.json",
    "prepack": "bun run build:types",
    "postpack": "rm -rf types",
    "prelint": "bun run --cwd ../.. build:eslint",
    "lint": "keslint --cache",
    "prelint:fix": "bun run --cwd ../.. build:eslint",
    "lint:fix": "keslint --fix --cache",
    "test": "bun test --timeout 20000"
  },
  "peerDependencies": {
    "elysia": "^1.4.30",
    "kay": "~1.54.0"
  },
  "dependencies": {
    "nodemailer": "^10.0.16"
  },
  "devDependencies": {
    "@kaynooo/eslint": "^7.0.4",
    "@types/bun": "^1.4.3",
    "elysia": "^1.4.30",
    "typescript": "^6.0.3"
  }
}
