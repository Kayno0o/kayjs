---
import type { JSX, Snippet } from 'kay'
import { onMount, recipe, signal } from 'kay'
import IconButton from './icon-button.kay'
import { wording } from 'kay/words'

const WIDTH = { default: 260, min: 180, max: 560, step: 20 }

const look = recipe({ parts: { root: 'kui-split-layout', sidebar: 'kui-split-layout-sidebar', sidebarHead: 'kui-split-layout-sidebar-head', sidebarTitle: 'kui-split-layout-sidebar-title', sidebarBody: 'kui-split-layout-sidebar-body', list: 'kui-split-layout-list', listHead: 'kui-split-layout-list-head', resizer: 'kui-split-layout-resizer', detail: 'kui-split-layout-detail', detailHead: 'kui-split-layout-detail-head' } })

const { list, detail, listHead, detailHead, sidebar, sidebarTitle = '', detailOpen = false, sidebarOpen = false, onSidebarClose, resizableList = false, listWidthKey, resizeLabel = wording('ui.splitLayout.resizeLabel', 'Resize list'), backLabel = wording('ui.splitLayout.backLabel', 'Back'), style, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'style' | 'children'> & {
  list: Snippet
  detail: Snippet
  listHead?: Snippet
  detailHead?: Snippet
  // A navigation column left of the list, from `md` up; below it, an overlay `sidebarOpen` shows.
  sidebar?: Snippet
  sidebarTitle?: string | undefined
  // Below `md`, whether the detail pane takes the list's place.
  detailOpen?: boolean | undefined
  // Below `md`, whether the sidebar covers the layout; its back button calls `onSidebarClose` for the parent to set it back to false.
  sidebarOpen?: boolean | undefined
  onSidebarClose?: (() => void) | undefined
  // A handle on the list's right edge, from `md` up, dragged or moved with the arrow keys.
  resizableList?: boolean | undefined
  // The `localStorage` key the list's width is kept under, from one visit to the next.
  listWidthKey?: string | undefined
  resizeLabel?: string | undefined
  backLabel?: string | undefined
  style?: string | undefined
}>()

const listWidth = signal(WIDTH.default)

function clampWidth(px: number): number {
  return Math.min(WIDTH.max, Math.max(WIDTH.min, px))
}

// Read once mounted, since the server has no storage: the page renders at the default width, then takes the kept one.
onMount(() => {
  if (!listWidthKey)
    return

  try {
    const stored = Number(localStorage.getItem(listWidthKey))

    if (stored)
      listWidth.set(clampWidth(stored))
  }
  catch {
    // Storage can be blocked; the default width stands.
  }
})

function remember() {
  if (!listWidthKey)
    return

  try {
    localStorage.setItem(listWidthKey, String(listWidth()))
  }
  catch {
    // Storage can be blocked; the width just lasts the visit.
  }
}

function startResize(event: PointerEvent) {
  const handle = event.currentTarget as HTMLElement
  const startX = event.clientX
  const startWidth = listWidth()
  const move = (next: PointerEvent) => listWidth.set(clampWidth(startWidth + next.clientX - startX))

  event.preventDefault()
  handle.setPointerCapture(event.pointerId)
  handle.addEventListener('pointermove', move)

  // A cancelled drag, as when the browser takes a touch over, ends it too, keeping the width it reached.
  const end = () => {
    handle.removeEventListener('pointermove', move)
    handle.removeEventListener('pointerup', end)
    handle.removeEventListener('pointercancel', end)
    remember()
  }

  handle.addEventListener('pointerup', end)
  handle.addEventListener('pointercancel', end)
}

function resizeByKey(event: KeyboardEvent) {
  const delta = { ArrowLeft: -WIDTH.step, ArrowRight: WIDTH.step }[event.key]

  if (delta === undefined)
    return

  event.preventDefault()
  listWidth.set(clampWidth(listWidth() + delta))
  remember()
}
---
// The sidebar is rendered once: from `md` up a column, below it the overlay `data-sidebar-open` shows.
div(part="root" {...rest} style={`--kui-split-list-width: ${listWidth()}px;${style ? ` ${style}` : ''}`} data-sidebar={sidebar ? '' : undefined} data-sidebar-open={sidebarOpen ? '' : undefined} data-detail-open={detailOpen ? '' : undefined})
  if sidebar
    aside(part="sidebar")
      div(part="sidebarHead")
        IconButton(icon="back" label={backLabel} variant="ghost" size="lg" onClick={() => onSidebarClose?.()})
        span(part="sidebarTitle") {sidebarTitle}
      div(part="sidebarBody")
        | {sidebar}
  section(part="list")
    if listHead
      div(part="listHead")
        | {listHead}
    | {list}
    if resizableList
      // A focusable separator is a widget, moved with the arrow keys as well as dragged.
      div(part="resizer" role="separator" tabindex="0" aria-label={resizeLabel} aria-orientation="vertical" aria-valuenow={listWidth()} aria-valuemin={WIDTH.min} aria-valuemax={WIDTH.max} onPointerDown={startResize} onKeyDown={resizeByKey})
  section(part="detail")
    if detailHead
      div(part="detailHead")
        | {detailHead}
    | {detail}
