--- <Value extends string | number, Empty extends string | boolean | undefined = undefined>
import type { FieldSize } from './field-look'
import type { JSX } from 'kay'
import type { ComboboxQuery } from './combobox'
import { effect, postedValue, recipe, signal, untrack } from 'kay'
import { controlledValue } from './controlled-value'
import { FIELD_LOOK, FIELD_SELECT_BOX, fieldInvalid, fieldSize, keepInvalid } from './field-look'
import { changeAccepted } from './change'
import { paramChange } from './param-change'
import { startRef } from './form-reset'
import { wording } from 'kay/words'

// The padding is the rule's, in theme.css: a skin's chevron gives the right side more room, which a utility here would take back.
const look = recipe({
  parts: { root: `${FIELD_LOOK} ${FIELD_SELECT_BOX} min-h-(--_field-height)` },
})

const { size = 'md', invalid, value, options, onChange, param, paramDefault, name, submit = false, emptyOption, busy = false, loadingLabel = wording('ui.select.loading', 'Loading…'), failureLabel = wording('ui.select.failure', 'Could not load the options'), onLoad, onError, onBlur, onKeyDown, onPointerDown, ...rest } = props<Omit<JSX.IntrinsicElements['select'], 'size' | 'value' | 'options' | 'class' | 'children' | 'onChange' | 'onLoad' | 'onError'> & {
  // The box's size: `md` by default, `sm` and `lg` change its padding and type.
  size?: FieldSize | undefined
  // Marks the control as refused, in the danger colour with `aria-invalid`. A FormField marks its control on its own while it shows a message.
  invalid?: boolean | undefined
  // One of the options' values, or the empty string once there is an `emptyOption`.
  value: Value | (Empty extends string | true ? '' : never)
  // `disabled` keeps that option from being picked. A native option draws no icon, so it has none.
  // A list, or a function answering it, such as an action or a wrapped API call: asked once, with an empty `q`, when the select is drawn in the browser, the select busy under `loadingLabel` until the answer lands, or under `failureLabel` once it rejected.
  options: readonly SelectOption<Value>[] | ((input: ComboboxQuery) => PromiseLike<readonly SelectOption<Value>[]>)
  // Handed the option's own value, a number for a number option, or the empty string for the `emptyOption`.
  onChange?: ((value: Value | (Empty extends string | true ? '' : never)) => unknown) | undefined
  // Holds a query param of the page instead of, or besides, `onChange`: a pick goes to the current page with `param` set to the option, or left out for the empty option, and every other param kept. Give `value` the param as the page read it. The select takes it as its name, so a GET form around it sends it without JavaScript.
  param?: string | undefined
  // The value the page shows while `param` is left out: picking it leaves the param out.
  paramDefault?: string | number | undefined
  // Submits the form holding it once an option is picked, after `onChange`: a GET filter form then needs no ref to itself. A pick by keyboard, which some browsers report on each arrow key, waits for Enter or for the select to lose focus.
  submit?: boolean | undefined
  // A first option worth the empty string: a string is its label, `true` leaves it blank.
  emptyOption?: Empty
  // Shows a disabled row saying the options are on their way, and marks the select busy.
  busy?: boolean | undefined
  loadingLabel?: string | undefined
  failureLabel?: string | undefined
  // Called with the answer of a function `options`, and with what it rejected with.
  onLoad?: ((options: readonly SelectOption<Value>[]) => unknown) | undefined
  onError?: ((error: unknown) => unknown) | undefined
}>()

// A select with no callback is plain: a refused post of its form, which the server renders it for, gives its choice back in place of its own.
// kay-allow once-read-prop
const sent = onChange || param !== undefined ? undefined : postedValue(name, value)
const wanted = () => String(sent ?? value)

interface SelectOption<Choice> { value: Choice, label: string, disabled?: boolean | undefined }

const answer = signal<readonly SelectOption<Value>[]>([])
const asking = signal(typeof options === 'function')
const failed = signal(false)
const list = (): readonly SelectOption<Value>[] => typeof options === 'function' ? answer() : options
let box: HTMLSelectElement | undefined

// Only the browser asks, so the page without JavaScript shows the select as busy; one asked twice keeps the later answer.
let request = 0

effect(() => {
  const ask = untrack(() => typeof options === 'function' ? options : undefined)

  if (!ask)
    return

  const mine = ++request

  void (async () => {
    try {
      const found = await ask({ q: '' })

      if (mine !== request)
        return

      answer = found
      failed = false
      asking = false
      onLoad?.(found)
    }
    catch (error) {
      if (mine === request) {
        console.error('kayjs-ui: a Select could not load its options', error)
        failed = true
        asking = false
        onError?.(error)
      }
    }
  })()
})

// The options carry the value to the select, so only what the app last handed is kept; a reset that changes the select has the app's `onChange` told, without submitting.
const { heard } = controlledValue({ box: () => box, value: () => String(value), write: false, report: select => report(select) })

function report(select: HTMLSelectElement) {
  heard(select.value)

  const choice = list().find(option => String(option.value) === select.value)

  // No option matches only the empty one, which the type allows exactly when there is one.
  onChange?.(choice === undefined ? '' as never : choice.value)
}

// Holding a query param: a pick goes through the move, the select busy meanwhile and put back where the page is when the move is refused, as Segmented is.
const moving = signal(false)

async function move(select: HTMLSelectElement) {
  const choice = list().find(option => String(option.value) === select.value)

  heard(select.value)

  if (await changeAccepted('Select', () => paramChange(param, paramDefault, onChange)?.(choice === undefined ? '' as never : choice.value), moving.set))
    return

  // What the app renders now, which it may have changed while the move was under way.
  const kept = String(value)

  select.value = kept
  heard(kept)
}

// The keys that open the list: what is picked in it then arrives as one change, so it submits at once.
const OPENERS = new Set([' ', 'F4'])

// Whether the last key went to the select since the last pointer press, and a keyboard pick still waiting for Enter or blur.
let keyed = false
let waiting = false

// Called through the prototype, as a control named `requestSubmit` takes the method's place on the form.
function submitNow(select: HTMLSelectElement) {
  waiting = false

  if (select.form)
    HTMLFormElement.prototype.requestSubmit.call(select.form)
}

function picked(select: HTMLSelectElement) {
  // With `submit` the form's own submit carries the param.
  if (param === undefined || submit)
    report(select)
  else
    void move(select)

  if (!submit)
    return

  if (keyed)
    waiting = true
  else
    submitNow(select)
}

function pressed(event: KeyboardEvent & { currentTarget: HTMLSelectElement }) {
  onKeyDown?.(event as never)

  if (event.key === 'Enter' && waiting && !event.defaultPrevented)
    submitNow(event.currentTarget)
  else if (event.key !== 'Enter')
    keyed = !OPENERS.has(event.key) && !(event.altKey && event.key.startsWith('Arrow'))
}

function grabbed(event: PointerEvent & { currentTarget: HTMLSelectElement }) {
  onPointerDown?.(event as never)
  keyed = false
}

function left(event: FocusEvent & { currentTarget: HTMLSelectElement }) {
  onBlur?.(event as never)

  if (waiting)
    submitNow(event.currentTarget)
}

const ref = startRef<HTMLSelectElement>((element) => {
  box = element
  keepInvalid(element, () => invalid)
}, rest.ref)
---
// Each option says whether it is selected, so the right one stays chosen when the options arrive after the value.
select(aria-busy={busy || asking() || moving() ? 'true' : undefined} {...rest} data-size={fieldSize(size)} aria-invalid={fieldInvalid(() => invalid) ?? rest['aria-invalid']} name={name ?? param} ref={ref} onChange={event => picked(event.currentTarget)} onKeyDown={submit ? pressed : onKeyDown} onPointerDown={submit ? grabbed : onPointerDown} onBlur={submit ? left : onBlur})
  if emptyOption !== undefined && emptyOption !== false
    option(value="") {typeof emptyOption === 'string' ? emptyOption : ''}
  if busy || asking()
    option(value="" disabled) {loadingLabel}
  if failed()
    option(value="" disabled) {failureLabel}
  for choice of list() key={choice.value}
    option(ref={element => element.toggleAttribute('selected', untrack(() => String(choice.value) === wanted()))} value={choice.value} disabled={choice.disabled} selected={String(choice.value) === wanted()}) {choice.label}
