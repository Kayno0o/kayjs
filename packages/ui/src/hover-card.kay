---
import type { JSX, Snippet } from 'kay'
import type { HoverCardTriggerProps } from './hover-card'
import type { Placement } from './popover'
import { effect, onCleanup, recipe, signal, uid, untrack } from 'kay'

// 'kui-hover-card' stays as the component's name for an app's CSS and the always-hidden guard.
// The pointer can move onto it without it closing (WCAG 1.4.13), so its text can be read at length and selected.
const look = recipe({
  parts: {
    root: 'kui-hover-card inset-auto m-1 [position-try-fallbacks:flip-block,flip-inline] rounded-lg border-solid border-[length:var(--border-width)] border-border-strong bg-popover p-0 text-foreground data-[placement=top]:[position-area:block-start] data-[placement=bottom]:[position-area:block-end] data-[placement=left]:[position-area:inline-start] data-[placement=right]:[position-area:inline-end] data-[placement=bottom-start]:[position-area:block-end_span-inline-end] data-[placement=bottom-end]:[position-area:block-end_span-inline-start] data-[placement=top-start]:[position-area:block-start_span-inline-end] data-[placement=top-end]:[position-area:block-start_span-inline-start] data-[placement=right-start]:[position-area:inline-end_span-block-end] data-[placement=right-end]:[position-area:inline-end_span-block-start] data-[placement=left-start]:[position-area:inline-start_span-block-end] data-[placement=left-end]:[position-area:inline-start_span-block-start]',
    // Stands in for an SVG shape the card is anchored to, which the browser cannot anchor to itself: a box laid over the shape that paints nothing and is never hit; it is not `visibility: hidden`, as a hidden anchor hides the card anchored to it.
    stand: 'pointer-events-none fixed inset-auto m-0 size-0 overflow-visible border-0 p-0',
  },
})

const { id, anchor, open, openDelay = 200, closeDelay = 150, trigger, placement = 'top', onOpenChange, style, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'id' | 'popover' | 'class' | 'children' | 'role' | 'style'> & {
  // Written after the component's own declarations, so it wins.
  style?: string | undefined
  // The panel's id, unique on the page; one is drawn when none is given.
  id?: string | undefined
  // The element the card sits beside, set from the page whenever the pointer or focus lands on another one, and `undefined` or `null` for none: the card shows while there is one. An element of an SVG works too. A `trigger` block does this for one element, with no state on the page.
  anchor?: Element | null | undefined
  // Renders the element the card is for, which spreads the attributes it is handed: `@trigger(attributes)`, then `button({...attributes})`. Hovering or focusing it shows the card, after `openDelay` for the pointer.
  trigger?: Snippet<[attributes: HoverCardTriggerProps]> | undefined
  // Shows the card on its `trigger` when the page sets it, and hides it when it is set back to `false`; the pointer, focus and Escape work on their own as well, each reported to `onOpenChange`.
  open?: boolean | undefined
  // How long the pointer rests on the `trigger` before the card shows, as a number of milliseconds; focus shows it at once.
  openDelay?: number | undefined
  // How long the card stays after the pointer or focus left its `trigger` (or the `anchor` was cleared), so the pointer can cross onto the card.
  closeDelay?: number | undefined
  // Which side of the anchor it sits on, flipped by the browser when there is no room there.
  placement?: Placement | undefined
  // Called with `true` as the card shows and `false` as it hides, also when it hides on its own (Escape, or an anchor that left the page) while the page still holds the anchor: clear it there, and the same element can show the card again.
  onOpenChange?: ((event: { open: boolean }) => unknown) | undefined
}>()

const panelId = id ?? uid()
const name = `--_hover-card-${panelId}`
let panel: HTMLDivElement | undefined
let stand: HTMLSpanElement | undefined
let frame = 0
// The anchor the card describes while it is open.
let described: Element | undefined
// Whether the pointer is on the card, and the wait that lets it cross the gap from the anchor to the card before the card is let go.
let hovered = false
let leaving: ReturnType<typeof setTimeout> | undefined
// The element a `trigger` was entered or focused on, and the wait before the pointer shows the card.
const hot = signal<Element | null>(null)
let waking: ReturnType<typeof setTimeout> | undefined
// Where the stand-in was last put, so a frame with nothing moved writes nothing.
let placed = ''

function wake(target: Element, delay: number) {
  clearTimeout(waking)

  if (hot() === target)
    return

  if (delay === 0 || panel?.matches(':popover-open'))
    hot = target
  else
    waking = setTimeout(() => hot = target, delay)
}

function sleep() {
  clearTimeout(waking)
  hot = null
}

// What `trigger` spreads: the pointer waits `openDelay`, focus does not.
const triggerProps: HoverCardTriggerProps = {
  'onPointerEnter': event => wake(event.currentTarget as Element, openDelay),
  'onPointerLeave': sleep,
  'onFocus': event => wake(event.currentTarget as Element, 0),
  'onBlur': sleep,
  'data-hover-card': panelId,
}

// Whether the page was told the card is open, so each change is reported once.
let reported = false

function report(open: boolean) {
  if (reported === open)
    return

  reported = open
  untrack(() => onOpenChange?.({ open }))
}

// The card's id is listed in the anchor's `aria-describedby` while it is open, beside whatever ids the app put there.
function describe(target: Element) {
  if (described === target)
    return

  undescribe()

  const ids = (target.getAttribute('aria-describedby') ?? '').split(/\s+/).filter(Boolean)

  if (!ids.includes(panelId)) {
    target.setAttribute('aria-describedby', [...ids, panelId].join(' '))
    described = target
  }
}

function undescribe() {
  if (!described)
    return

  const ids = (described.getAttribute('aria-describedby') ?? '').split(/\s+/).filter(id => id !== '' && id !== panelId)

  if (ids.length > 0)
    described.setAttribute('aria-describedby', ids.join(' '))
  else
    described.removeAttribute('aria-describedby')

  described = undefined
}

function onPanel(element: HTMLDivElement) {
  panel = element
  element.addEventListener('pointerenter', () => {
    hovered = true
    clearTimeout(leaving)
  })
  element.addEventListener('pointerleave', () => {
    hovered = false

    if (!anchor)
      closeSoon()
  })
}

// Escape dismisses the card without a pointer or focus move, and leaves the key to whatever else listens for it.
function dismiss(event: KeyboardEvent) {
  if (event.key === 'Escape')
    close()
}

function unmark() {
  cancelAnimationFrame(frame)
  document.removeEventListener('keydown', dismiss)
  undescribe()
  placed = ''
  stand?.style.removeProperty('anchor-name')
}

// An anchor cleared while the card shows: the card stays a moment, and while the pointer is on it, so a visitor can move onto it.
function closeSoon() {
  clearTimeout(leaving)

  if (hovered)
    return

  leaving = setTimeout(close, closeDelay)
}

function close() {
  clearTimeout(leaving)
  clearTimeout(waking)
  hovered = false
  hot = null
  unmark()

  if (panel?.isConnected && panel.matches(':popover-open'))
    panel.hidePopover()

  if (stand?.isConnected && stand.matches(':popover-open'))
    stand.hidePopover()

  report(false)
}

// Every anchor is followed by a frame loop while the card is open: the stand-in trails a native scroll by a frame, and an anchor that is `display: none` has no box to follow.
// The browser anchors to a CSS box, which an SVG shape is not, and an element's own anchor-name may be the app's: a fixed, invisible box laid over the target stands in for every element, kept on it frame by frame as a pan, a zoom or a scroll moves it. It sits in the top layer like the card, so a transformed, filtered or contained ancestor cannot offset it.
function follow(target: Element) {
  if (!target.isConnected) {
    close()

    return
  }

  const box = target.getBoundingClientRect()
  const at = `${box.left},${box.top},${box.width},${box.height}`

  if (stand && at !== placed) {
    placed = at
    stand.style.cssText = `anchor-name: ${name}; left: ${box.left}px; top: ${box.top}px; width: ${box.width}px; height: ${box.height}px`
  }

  frame = requestAnimationFrame(() => follow(target))
}

// `open` going to `false` hides a card its trigger showed.
effect(() => {
  if (open === false)
    untrack(sleep)
})

effect(() => {
  const target = anchor ?? hot() ?? (open ? (panel?.getRootNode() as ParentNode | undefined)?.querySelector(`[data-hover-card="${panelId}"]`) ?? undefined : undefined)

  clearTimeout(leaving)

  // A card that moved to another anchor from under the pointer never gets its pointerleave.
  if (target)
    hovered = false

  if (!target && panel?.isConnected && panel.matches(':popover-open')) {
    closeSoon()

    return
  }

  unmark()

  if (!panel?.isConnected || !stand?.isConnected)
    return

  if (!target) {
    close()

    return
  }

  // The stand-in opens first and stays open as long as the card does, as an anchor must come before the card in the top layer.
  if (!stand.matches(':popover-open'))
    stand.showPopover()

  if (!target.isConnected) {
    close()

    return
  }

  follow(target)
  describe(target)
  document.addEventListener('keydown', dismiss)

  if (!panel.matches(':popover-open'))
    panel.showPopover()

  report(true)
})

onCleanup(() => {
  clearTimeout(leaving)
  clearTimeout(waking)
  unmark()
})
---
if trigger
  | {trigger(triggerProps)}
div(part="root" {...rest} ref={onPanel} id={panelId} popover="manual" data-placement={placement} style={[`position-anchor: ${name}`, style].filter(Boolean).join('; ')})
  slot
span(part="stand" ref={element => stand = element} popover="manual" aria-hidden="true")
