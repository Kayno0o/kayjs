---
import { signal } from 'kay'
import { reply } from '../routes/chat.kay'
import ChatLauncher from '@kayjs/ai/chat-launcher.kay'

const changes = signal<boolean[]>([])
---
a.link(href="#chat") Ask
button.event(type="button" onClick={() => document.dispatchEvent(new CustomEvent('kai:chat-open', { detail: {} }))}) Event
button.send(type="button" onClick={() => document.dispatchEvent(new CustomEvent('kai:chat-send', { detail: { text: 'Sent from outside' } }))}) Send
button.draft(type="button" onClick={() => document.dispatchEvent(new CustomEvent('kai:chat-draft', { detail: { text: 'Drafted from outside' } }))}) Draft
p.changes {changes().join(';')}
ChatLauncher(action={reply} label="Assistant" onOpenChange={value => { changes = [...changes(), value] }})
