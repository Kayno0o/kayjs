---
import type { CollectionInfo } from '../kay/contract'
import { wording } from 'kay/words'
import { collectionPath, collectionTitle } from '../listing'
import { screenPath } from '../paths'

// The head of an entry's screen: the path to it from the content list, the entry's name as the page's title and its slug beneath, the actions at the end.
const { prefix, collection, title, subtitle } = props<{ prefix: string, collection: CollectionInfo, title: string, subtitle?: string | undefined }>()
---
header.kcms-entry-header
  .kcms-entry-heading
    // A single collection has no list of its own, so its crumbs stop at the content list.
    nav(aria-label={wording('cms.admin.crumbs', 'Breadcrumb')})
      ol.kcms-entry-crumbs
        li
          a.kcms-entry-crumb(href={screenPath(prefix)}) {wording('cms.admin.content', 'Content')}
        if !collection.single
          li
            a.kcms-entry-crumb(href={collectionPath(prefix, collection.name)}) {collectionTitle(collection)}
    h1.kcms-entry-name {title}
    if subtitle
      p.kcms-entry-subtitle {subtitle}
    if collection.description
      p.kcms-entry-subtitle {collection.description}
  slot
