---
import { signal } from 'kay'
import Button from '@kayjs/ui/button.kay'
import Popover from '@kayjs/ui/popover.kay'

const open = signal(false)
---
.flex.items-center.gap-3
  Button(label="Toggle from outside" onClick={() => open = !open()})
  Popover(label="More actions" open={open()} onOpenChange={open.set} placement="bottom-start")
    @trigger(attributes)
      Button({...attributes} label="Details")
    p.p-3 Opened by either button, closed by a click outside or Escape.
