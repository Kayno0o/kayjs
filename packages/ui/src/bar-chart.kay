---
import type { JSX, Snippet } from 'kay'
import type { LabelFormat } from './chart-axis'
import type { BarSeries } from './plot'
import type { ChartEvent, ChartMark } from './chart-marks'
import { memo, recipe, signal } from 'kay'
import { tabOf } from './outside'
import type { NewTab } from './outside'
import { activeMarks, chartTooltip, EVENT_LOOK, markKind, placeEvents, TOOLTIP_LOOK } from './chart-marks'
import { headings, labelTimes, tickIndices, tickTexts } from './chart-axis'
import { barRatios, PALETTE, steppedPoint, valueTicks } from './plot'
import { wording } from 'kay/words'

const look = recipe({
  parts: {
    // The plot leaves its left margin for the value labels, which hang outside it as they do in a ScatterChart.
    root: 'kui-bar-chart m-0 flex flex-col gap-2 pt-2 pr-3',
    plot: 'relative ml-10 h-[var(--chart-height,12rem)] border-solid border-[length:var(--border-width)] border-border border-t-transparent border-r-transparent border-l-transparent',
    grid: 'absolute inset-x-0 h-px bg-border',
    tick: 'absolute right-full mr-2 -translate-y-1/2 text-2xs whitespace-nowrap text-[var(--color-muted)] tabular-nums',
    // The gap is `--bar-gap` (0.25rem), shrunk so that all the gaps take 40% of the width at most: a year of columns still fits its plot, and an app sets `--bar-gap` on the figure.
    columns: 'absolute inset-0 flex gap-[min(var(--bar-gap,0.25rem),calc(40%/var(--bar-gaps)))]',
    column: 'flex min-w-0 flex-1 items-end gap-px outline-none hover:bg-surface data-lit:bg-surface data-[kind=link]:no-underline data-[kind=button]:cursor-pointer data-[kind=link]:cursor-pointer focus-visible:outline-2 focus-visible:outline-foreground data-stacked:flex-col-reverse data-stacked:items-stretch data-stacked:justify-start data-stacked:gap-0',
    // A stub is the mark a column keeps where its series gives it a colour or a note but no height; a stacked bar is squared and sized by its height alone.
    // The events sit over the columns in cells of the same widths, each rule in the middle of its column.
    events: 'pointer-events-none absolute inset-0 flex gap-[min(var(--bar-gap,0.25rem),calc(40%/var(--bar-gaps)))]',
    eventCell: 'relative min-w-0 flex-1',
    event: `${EVENT_LOOK.event} inset-y-0 left-1/2`,
    eventRule: EVENT_LOOK.eventRule,
    bar: 'min-h-px min-w-px flex-1 rounded-t-sm data-stub:h-1 data-stacked:flex-none data-stacked:rounded-none',
    axis: 'ml-10 flex gap-[min(var(--bar-gap,0.25rem),calc(40%/var(--bar-gaps)))]',
    // The first and the last label line up with the plot's edges, so a label wider than its slot spills inward and not out of the figure.
    axisLabel: 'flex min-w-0 flex-1 justify-center data-[edge=start]:justify-start data-[edge=end]:justify-end text-2xs whitespace-nowrap text-[var(--color-muted)]',
    tooltip: TOOLTIP_LOOK,
    legend: 'm-0 flex list-none flex-wrap gap-4 p-0 pl-1',
    legendItem: 'flex items-center gap-1.5 text-xs text-muted',
    key: 'size-2 shrink-0',
  },
})

const { labels, series, formatValue = (value: number) => value.toLocaleString(), formatLabel, xLabels = false, stacked = false, totalLabel = wording('ui.barChart.total', 'Total'), legend, marks: events, emptyLabel, empty, onSelect, href, newTab, onActive, active, tooltip, label, ...rest } = props<Omit<JSX.IntrinsicElements['figure'], 'class' | 'children' | 'onSelect'> & {
  labels: string[]
  series: BarSeries[]
  // Formats the y-axis labels, the tooltips and the readings screen readers hear.
  formatValue?: ((value: number) => string) | undefined
  // Formats a label for the tooltips, the x-axis and what screen readers hear, as LineChart's: a label that is a date reads in the page's locale by default.
  formatLabel?: LabelFormat | undefined
  // Draws up to five x-axis labels.
  xLabels?: boolean | undefined
  // Piles the series of a label on one bar instead of setting them side by side, and adds a total to its tooltip.
  stacked?: boolean | undefined
  // Names the total a stacked chart adds to its tooltips and announcements.
  totalLabel?: string | undefined
  // Names each series under the chart; shown by default once there is more than one.
  legend?: boolean | undefined
  // Events marked on the x axis, such as a change applied between two readings: a dashed rule over the column at `at` (a label, or an index into `labels`), its `title` in that column's tooltip and in what screen readers read, and a link to `href` when given, a tab stop of its own beside the columns. An `at` that is no label is left out, and several on one label stand side by side.
  marks?: ChartEvent[] | undefined
  // Makes every column a button handing back its label, index and each series' value there; with `href` too, a column that has an address stays a link.
  onSelect?: ((mark: ChartMark) => unknown) | undefined
  // The address a column links to, or `undefined` for none: a middle click, a new tab or a crawler finds it, and a plain click goes through `onSelect` when the app gave one.
  href?: ((mark: ChartMark) => string | undefined) | undefined
  // Opens the links of `href` in a new tab (`true`), the same one (`false`), or a new one when the address leaves the site (`'auto'`, the default).
  newTab?: NewTab | undefined
  // Hears the index of the column the pointer or the focus is on, `null` when it leaves.
  onActive?: ((index: number | null) => unknown) | undefined
  // The column to draw as active, `null` for none; the app controls it when it gives it, and the pointer and focus then only report through `onActive`.
  active?: number | null | undefined
  // Replaces the tooltip under the pointer or focus with the app's own content for that column, drawn by the chart where the column is.
  tooltip?: Snippet<[mark: ChartMark]> | undefined
  // What the chart reads with no labels.
  emptyLabel?: string | undefined
  // Replaces `emptyLabel` with the app's own markup, such as a link to add the first one: an `@empty` block.
  empty?: Snippet | undefined
  // Names the chart for screen readers.
  label: string
}>()

const ratios = memo(() => barRatios(series.map(item => item.values), stacked, labels.length))
const ticks = memo(() => valueTicks(ratios().top))
const times = memo(() => labelTimes(labels))
const shown = memo(() => new Set(xLabels ? tickIndices(labels.length) : []))
const axisTexts = memo(() => tickTexts(labels, times(), formatLabel))
const headingTexts = memo(() => headings(labels, times(), formatLabel))
const gaps = () => `--bar-gaps: ${Math.max(labels.length - 1, 1)}`
const edge = (at: number) => labels.length < 2 ? undefined : at === 0 ? 'start' : at === labels.length - 1 ? 'end' : undefined
const colors = (item: BarSeries, index: number, at: number) => item.colors?.[at] ?? item.color ?? PALETTE[index % PALETTE.length]!

// The bar the keyboard stands at, the latest one until it moves.
const stop = signal<number | null>(null)
const current = () => Math.min(stop() ?? labels.length - 1, Math.max(0, labels.length - 1))

const reading = (item: BarSeries, at: number) => {
  const value = item.values[at]

  return typeof value === 'number' ? formatValue(value) : '-'
}

// What a bar column reads on hover and focus, and to screen readers: the label, each series' reading and the notes the series carry for it.
const placed = memo(() => placeEvents(events, labels))

// Side by side with the events on the same column, each a pointer's width further along.
const eventStyle = (event: ChartEvent, slot: number) => `margin-left: ${slot * 0.5}rem${event.color ? `; --event-color: ${event.color}` : ''}`

const summaries = memo(() => labels.map((_, at) => {
  const total = stacked ? [`${totalLabel} ${formatValue(series.reduce((sum, item) => sum + (item.values[at] ?? 0), 0))}`] : []
  const notes = [...series.map(item => item.notes?.[at]), ...placed().filter(item => item.index === at).map(item => item.event.title)].filter(Boolean)

  return `${headingTexts()[at]}: ${[...series.map(item => `${item.name} ${reading(item, at)}`), ...total].join(', ')}${notes.length > 0 ? `; ${notes.join('; ')}` : ''}`
}))

// A column with no height still shows a stub where its series gives it a note, or a colour with a reading, so a failed run recorded as 0 stands out as much as a long one.
const marked = (item: BarSeries, at: number) => Boolean(item.notes?.[at] || (item.colors?.[at] && typeof item.values[at] === 'number'))

// The arrows walk the columns, one tab stop in all, and Home and End reach either end.
function keyDown(event: KeyboardEvent) {
  if (event.altKey || event.ctrlKey || event.metaKey)
    return

  const next = steppedPoint(event.key, current(), labels.length)

  if (next === undefined || labels.length === 0)
    return

  event.preventDefault()
  stop = next

  const target = (event.currentTarget as HTMLElement).parentElement?.children[next]

  if (target instanceof HTMLElement)
    target.focus()
}

const mark = (at: number): ChartMark => ({ index: at, label: labels[at]!, values: series.map(item => item.values[at] ?? null) })
const marks = activeMarks({ active: () => active, onActive: () => onActive })
const tip = chartTooltip()

function link(at: number) {
  const to = href?.(mark(at))

  return to === undefined || to === '' ? undefined : { href: to, ...tabOf(to, newTab) }
}

// A plain click on a link goes to `onSelect` when the app gave one; a modified or middle click is left to the browser.
function pressed(event: MouseEvent, at: number) {
  if (!onSelect || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
    return

  event.preventDefault()
  void onSelect(mark(at))
}

function focused(event: FocusEvent, at: number) {
  stop = at
  marks.enter(at, event.currentTarget as Element)
}

const nothing = () => emptyLabel ?? wording('ui.barChart.empty', 'No data yet.')
---
snippet bars(at: number)
  for item, index of series key={item.name}
    if ratios().heights[index]![at]
      span(part="bar" data-stacked={stacked ? '' : undefined} style={`height: ${ratios().heights[index]![at]! * 100}%; background-color: ${colors(item, index, at)}`})
    else if marked(item, at)
      span(part="bar" data-stub data-stacked={stacked ? '' : undefined} style={`background-color: ${colors(item, index, at)}`})
if labels.length === 0
  // The app's id and class stay on whichever element shows.
  if empty
    div.kui-bar-chart-empty(part="root" id={rest.id})
      | {empty}
  else
    p.kui-bar-chart-empty.text-xs.text-muted(part="root" id={rest.id}) {nothing()}
else
  figure(part="root" {...rest} aria-label={label})
    div(part="plot")
      for tick of ticks() key={tick.ratio}
        span(part="grid" aria-hidden="true" style={`bottom: ${tick.ratio * 100}%`})
          span(part="tick") {formatValue(tick.ratio * ratios().top)}
      div(part="columns" style={gaps()})
        for _, at of labels key={at}
          if markKind(link(at)?.href, onSelect !== undefined) === 'link'
            a(part="column" {...link(at)} data-kind="link" tabindex={at === current() ? '0' : '-1'} aria-label={summaries()[at]} data-tooltip={tooltip ? undefined : summaries()[at]} data-lit={marks.current() === at ? '' : undefined} data-stacked={stacked ? '' : undefined} onClick={event => pressed(event, at)} onKeyDown={keyDown} onFocus={event => focused(event, at)} onBlur={() => marks.leave(at)} onPointerEnter={event => marks.enter(at, event.currentTarget)} onPointerLeave={() => marks.leave(at)})
              {bars(at)}
          else if onSelect
            button(part="column" type="button" data-kind="button" tabindex={at === current() ? '0' : '-1'} aria-label={summaries()[at]} data-tooltip={tooltip ? undefined : summaries()[at]} data-lit={marks.current() === at ? '' : undefined} data-stacked={stacked ? '' : undefined} onClick={() => void onSelect?.(mark(at))} onKeyDown={keyDown} onFocus={event => focused(event, at)} onBlur={() => marks.leave(at)} onPointerEnter={event => marks.enter(at, event.currentTarget)} onPointerLeave={() => marks.leave(at)})
              {bars(at)}
          else
            span(part="column" role="img" tabindex={at === current() ? '0' : '-1'} aria-label={summaries()[at]} data-tooltip={tooltip ? undefined : summaries()[at]} data-lit={marks.current() === at ? '' : undefined} data-stacked={stacked ? '' : undefined} onKeyDown={keyDown} onFocus={event => focused(event, at)} onBlur={() => marks.leave(at)} onPointerEnter={event => marks.enter(at, event.currentTarget)} onPointerLeave={() => marks.leave(at)})
              {bars(at)}
      if placed().length > 0
        div(part="events" style={gaps()} aria-hidden={placed().some(item => item.event.href) ? undefined : 'true'})
          for _, at of labels key={at}
            span(part="eventCell")
              for item of placed().filter(entry => entry.index === at) key={item.slot}
                if item.event.href
                  a(part="event" {...tabOf(item.event.href, newTab)} href={item.event.href} data-kind="link" aria-label={item.event.title} data-tooltip={item.event.title} style={eventStyle(item.event, item.slot)})
                    span(part="eventRule")
                else
                  span(part="event" aria-hidden="true" style={eventStyle(item.event, item.slot)})
                    span(part="eventRule")
    if tooltip && marks.current() !== null && marks.anchor()
      div(part="tooltip" ref={tip.watch} style={tip.place(marks.anchor()!)} aria-hidden="true")
        {tooltip(mark(marks.current()!))}
    if xLabels
      div(part="axis" aria-hidden="true" style={gaps()})
        for _, at of labels key={at}
          span(part="axisLabel" data-edge={edge(at)}) {shown().has(at) ? axisTexts()[at] : ''}
    if legend ?? series.length > 1
      ul(part="legend")
        for item, index of series key={item.name}
          li(part="legendItem")
            span(part="key" style={`background-color: ${colors(item, index, -1)}`})
            | {item.name}
