---
import type { EntryRef } from '../kay/contract'
import { memo, presence } from 'kay'
import { wording } from 'kay/words'
import { editorsOf, entryRoom, openRoom, watchRoom } from '../room'

// Tells a list that an entry is being edited, by name when the editors have one. The list watches through rooms of its own, so it is no editor to anyone.
// The screens' editors are in the room that names them and the on-page editors in the one that holds no name.
const { collection, entry } = props<{ collection: string, entry: EntryRef }>()
const { room, member } = entryRoom(collection, entry, { name: '', watching: true })
const here = presence(watchRoom(room), member)
const onPage = presence(watchRoom(openRoom(room)), member)
const editors = memo(() => editorsOf(here.others(), here.count(), member))
const text = memo(() => {
  if (editors().names.length > 0)
    return wording('cms.table.editing', 'Being edited by {names}', { names: editors().names.join(', ') })

  return editors().unnamed > 0 || onPage.others().length > 0 ? wording('cms.table.editingUnnamed', 'Being edited') : ''
})
---
if text() !== ''
  span.kcms-entry-watch(role="status") {text()}
