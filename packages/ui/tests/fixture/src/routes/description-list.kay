---
import Badge from '@kayjs/ui/badge.kay'
import DescriptionList from '@kayjs/ui/description-list.kay'
import '../app.css'

const items = [
  { label: 'Host', value: 'relay.example.com' },
  { label: 'Requests', value: 0 },
  { key: 'state', label: 'State' },
]
---
main
  DescriptionList#plain(items={items})
  DescriptionList#rich(items={items})
    @value(item)
      Badge(label={item.label === 'State' ? 'Healthy' : ''} tone="success")
  .w-48
    DescriptionList#narrow(items={items})
