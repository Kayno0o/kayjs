---
import type { CaptchaWidget } from '../../captcha'
import { t } from 'kay/i18n'

const { widget, challenge = null } = props<{ widget: CaptchaWidget | 'proof-of-work', challenge?: string | null }>()
---
// Kay's script solves the challenge while the form is filled in and posts the solution in this field's place; without JavaScript it posts empty.
if widget === 'proof-of-work'
  if challenge
    input(type="hidden" name="kayjs-captcha" data-kay-work={challenge})
    noscript
      p.text-sm {t('auth.errors.captchaScript')}
else
  // The provider's script fills the element and adds the field its token posts as.
  div(class={widget.class} data-sitekey={widget.siteKey})
  script(src={widget.script} async defer)
