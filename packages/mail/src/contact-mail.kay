---
import type { ContactMailProps } from './contact'
import { wording } from 'kay/words'
import Button from './button.kay'
import Fields from './fields.kay'
import Heading from './heading.kay'
import Layout from './layout.kay'
import Quote from './quote.kay'

// The default view of `contactForm`'s mail: the visitor's answers listed, then their message quoted.
const { subject, name, email, fields, message, site } = props<ContactMailProps>()
---
Layout(preheader={message.slice(0, 120)})
  @footer
    | {wording('mail.contact.footer', 'Sent from the contact form of {origin}. Replying to this mail writes to {name}.', { name, origin: site })}
  Heading {subject}
  Fields(fields={fields} empty={wording('mail.contact.empty', 'not given')})
  Quote(text={message})
  Button(href={`mailto:${email}?subject=${encodeURIComponent(`Re: ${subject}`)}`}) {wording('mail.contact.reply', 'Reply to {name}', { name })}
