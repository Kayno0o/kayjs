---
import Menu from '@kaynooo/kayjs-ui/menu.kay'
import type { MenuEntry } from '@kaynooo/kayjs-ui'
import Pencil from '~icons/tabler/pencil'

const picked = signal('nothing yet')
const items: MenuEntry[] = [
  { label: 'Rename', icon: Pencil, onSelect: () => picked = 'Rename' },
  { label: 'Duplicate', onSelect: () => picked = 'Duplicate' },
  'separator',
  {
    label: 'Delete',
    icon: 'delete',
    danger: true,
    onSelect: () => picked = 'Delete',
  },
]
---
.flex.items-center.gap-3
  Menu(label="Actions" icon="plus" items={items})
  p.text-muted Picked: {picked()}.
