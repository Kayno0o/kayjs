---
import type { JSX } from 'kay'

const { value, label, fillClass, class: className, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'children' | 'role'> & {
  // The percentage filled, held between 0 and 100.
  value: number
  // Names the meter for screen readers.
  label?: string
  // Classes for the fill alone, such as a colour picked by threshold; the track always looks like `kui-meter`.
  fillClass?: string
  class?: string
}>()

const percent = () => Math.min(100, Math.max(0, value))
---
.kui-meter({...rest} role="meter" aria-valuenow={percent()} aria-valuemin={0} aria-valuemax={100} aria-label={label} class={className})
  .kui-meter-fill(class={fillClass} style={`width: ${percent()}%`})
