---
import type { Action } from 'kay'
import { infiniteList } from '@kaynooo/kayjs-ui'
import Accordion from '@kaynooo/kayjs-ui/accordion.kay'
import AppHeader from '@kaynooo/kayjs-ui/app-header.kay'
import Avatar from '@kaynooo/kayjs-ui/avatar.kay'
import Badge from '@kaynooo/kayjs-ui/badge.kay'
import BarChart from '@kaynooo/kayjs-ui/bar-chart.kay'
import BarList from '@kaynooo/kayjs-ui/bar-list.kay'
import Breadcrumb from '@kaynooo/kayjs-ui/breadcrumb.kay'
import Button from '@kaynooo/kayjs-ui/button.kay'
import Card from '@kaynooo/kayjs-ui/card.kay'
import CardRow from '@kaynooo/kayjs-ui/card-row.kay'
import Carousel from '@kaynooo/kayjs-ui/carousel.kay'
import Checkbox from '@kaynooo/kayjs-ui/checkbox.kay'
import ChipGroup from '@kaynooo/kayjs-ui/chip-group.kay'
import CollapsibleSection from '@kaynooo/kayjs-ui/collapsible-section.kay'
import Combobox from '@kaynooo/kayjs-ui/combobox.kay'
import CommandPalette from '@kaynooo/kayjs-ui/command-palette.kay'
import ConfirmDelete from '@kaynooo/kayjs-ui/confirm-delete.kay'
import ContactForm from '@kaynooo/kayjs-ui/contact-form.kay'
import ContributionGraph from '@kaynooo/kayjs-ui/contribution-graph.kay'
import CopyButton from '@kaynooo/kayjs-ui/copy-button.kay'
import DateInput from '@kaynooo/kayjs-ui/date-input.kay'
import DateRangeInput from '@kaynooo/kayjs-ui/date-range-input.kay'
import Dialog from '@kaynooo/kayjs-ui/dialog.kay'
import EmptyState from '@kaynooo/kayjs-ui/empty-state.kay'
import FileDrop from '@kaynooo/kayjs-ui/file-drop.kay'
import FormDialog from '@kaynooo/kayjs-ui/form-dialog.kay'
import FormField from '@kaynooo/kayjs-ui/form-field.kay'
import IconButton from '@kaynooo/kayjs-ui/icon-button.kay'
import IconPicker from '@kaynooo/kayjs-ui/icon-picker.kay'
import ImageCropper from '@kaynooo/kayjs-ui/image-cropper.kay'
import LineChart from '@kaynooo/kayjs-ui/line-chart.kay'
import LoadMore from '@kaynooo/kayjs-ui/load-more.kay'
import MarkdownEditor from '@kaynooo/kayjs-ui/markdown-editor.kay'
import Masonry from '@kaynooo/kayjs-ui/masonry.kay'
import MediaGallery from '@kaynooo/kayjs-ui/media-gallery.kay'
import Menu from '@kaynooo/kayjs-ui/menu.kay'
import Meter from '@kaynooo/kayjs-ui/meter.kay'
import MultiSelect from '@kaynooo/kayjs-ui/multi-select.kay'
import Notice from '@kaynooo/kayjs-ui/notice.kay'
import PageHeader from '@kaynooo/kayjs-ui/page-header.kay'
import PageSection from '@kaynooo/kayjs-ui/page-section.kay'
import Pagination from '@kaynooo/kayjs-ui/pagination.kay'
import Popover from '@kaynooo/kayjs-ui/popover.kay'
import Progress from '@kaynooo/kayjs-ui/progress.kay'
import QrCode from '@kaynooo/kayjs-ui/qr-code.kay'
import RadioGroup from '@kaynooo/kayjs-ui/radio-group.kay'
import RangeInput from '@kaynooo/kayjs-ui/range-input.kay'
import Rating from '@kaynooo/kayjs-ui/rating.kay'
import SaveForm from '@kaynooo/kayjs-ui/save-form.kay'
import ScatterChart from '@kaynooo/kayjs-ui/scatter-chart.kay'
import Segmented from '@kaynooo/kayjs-ui/segmented.kay'
import Select from '@kaynooo/kayjs-ui/select.kay'
import SidePanel from '@kaynooo/kayjs-ui/side-panel.kay'
import SiteFavicon from '@kaynooo/kayjs-ui/site-favicon.kay'
import SiteNav from '@kaynooo/kayjs-ui/site-nav.kay'
import Skeleton from '@kaynooo/kayjs-ui/skeleton.kay'
import Slider from '@kaynooo/kayjs-ui/slider.kay'
import SplitLayout from '@kaynooo/kayjs-ui/split-layout.kay'
import Steps from '@kaynooo/kayjs-ui/steps.kay'
import Stat from '@kaynooo/kayjs-ui/stat.kay'
import Table from '@kaynooo/kayjs-ui/table.kay'
import TabNav from '@kaynooo/kayjs-ui/tab-nav.kay'
import Tabs from '@kaynooo/kayjs-ui/tabs.kay'
import Textarea from '@kaynooo/kayjs-ui/textarea.kay'
import TextInput from '@kaynooo/kayjs-ui/text-input.kay'
import TimeInput from '@kaynooo/kayjs-ui/time-input.kay'
import Toaster from '@kaynooo/kayjs-ui/toaster.kay'
import Toggle from '@kaynooo/kayjs-ui/toggle.kay'
import TooltipHost from '@kaynooo/kayjs-ui/tooltip-host.kay'
import TreeView from '@kaynooo/kayjs-ui/tree-view.kay'
import VirtualList from '@kaynooo/kayjs-ui/virtual-list.kay'
import WhenVisible from '@kaynooo/kayjs-ui/when-visible.kay'
import Widget from '@kaynooo/kayjs-ui/widget.kay'
import ZoomPane from '@kaynooo/kayjs-ui/zoom-pane.kay'

const planets = [{ id: 1, name: 'Mars' }]

// An action as the server renders it: a call with its `url`, every reading of it empty.
const fakeAction = new Proxy(Object.assign(async () => undefined, { url: '/_kay/action/form/fake' }), { get: (target, key) => key in target ? Reflect.get(target, key) : () => undefined }) as unknown as Action<never, unknown>

const feed = infiniteList([{ id: 1 }], { pageSize: 1, key: row => row.id, load: async () => undefined })
---
//- Renders components `src/ui.ts` restyles, for the library's restyle test.
Card#card(title="Hi" class={{ body: 'p-9' }}) Body
Button#plain(label="Plain" tone="danger")
Button#busy(label="Busy" variant="inline" icon="info" onClick={() => undefined})
Button#link(label="Link" href="/" variant="inline")
Button#spinning(label="Saving" busy)
Button#spinning-click(label="Saving" busy onClick={() => undefined})
Button#spinning-link(label="Saving" busy href="/")
Button#single(label="Single" onClick={() => undefined} class="rounded-none")
Badge#badge(label="New" tone="success")
Notice#notice(label="Saved" tone="danger")
TextInput#text(name="a")
Textarea#area(name="b")
Dialog#dialog(open={true} title="Rename" onOpenChange={() => undefined})
  @footer
    p footer
  p body
Table#table(columns={[{ key: 'name', header: 'Name', sortValue: true as const }]} rows={planets} rowKey="id" sort={{ key: 'name', direction: 'asc' }} filter={['name'] as const} selectable)
Avatar#avatar(name="Mars")
Stat#stat(value={3} label="moons")
PageHeader#header(title="Planets")
PageSection#section(title="Inner")
EmptyState#empty(title="Nothing" description="Add one.")
CardRow#row(left="L") Middle
DateInput#date(aria-label="Day" name="day")
DateRangeInput#dates(label="Stay")
TimeInput#time(aria-label="Start" name="start")
FormField#field(label="Name" hint="Required" required)
  TextInput(name="n")
FormField#field-group(label="Pick" group)
  TextInput(name="m")
Checkbox#checkbox(label="Agree" hint="1")
Toggle#toggle(label="On")
Select#select(value="a" options={[{ value: 'a', label: 'A' }]})
MultiSelect#multi(label="Tags" options={[{ value: 'a', label: 'A' }]} value={['a']})
RangeInput#range(label="Price" unit="€")
Segmented#segmented(label="Mode" value="a" options={[{ value: 'a', label: 'A', icon: 'info' }, { value: 'b', label: 'B' }]})
Rating#rating(value={3})
FileDrop#drop(onFiles={() => undefined})
  @content(_zone)
    p drop
IconButton#icon-button(icon="info" label="Info")
CopyButton#copy(text="x" label="Copy" tone="accent")
Menu#menu(label="More" icon="info" items={[{ label: 'Go', onSelect: () => undefined }, 'separator']} class="menu-trigger")
Slider#slider(label="Delay" value={5})
BarList#bars(rows={[{ key: 'a', label: 'A', value: 3 }]})
BarList#bars-select(rows={[{ key: 'b', label: 'B', value: 2 }]} onSelect={() => undefined})
BarList#bars-empty(rows={[]})
ChipGroup#chips(label="Tags" value={['a']} options={[{ value: 'a', label: 'A', icon: 'info' }, { value: 'b', label: 'B' }]})
CollapsibleSection#section-fold(title="More")
  p body
Widget#widget(title="Orders" icon="info")
  p body
Meter#meter(label="Disk" value={40} fillClass="bg-red-500")
Popover#popover(open={false})
  @trigger(attributes)
    button({...attributes}) Open
  p panel
SidePanel#side(open={true} title="Filters" onOpenChange={() => undefined})
  p body
ConfirmDelete#confirm-link(message="Sure?" trigger="link" onConfirm={() => undefined})
ConfirmDelete#confirm-inline(message="Sure?" ask="inline" trigger="button" onConfirm={() => undefined})
SaveForm#save(dirty={false} onSave={() => undefined})
  p field
CommandPalette#palette(entries={[]})
Tabs#tabs(label="Sections" value="a" tabs={[{ value: 'a', label: 'A', icon: 'info' }, { value: 'b', label: 'B' }]})
  @panel(shown)
    p {shown}
TabNav#tabnav(label="Pages" current="/a" links={[{ href: '/a', label: 'A' }, { href: '/b', label: 'B' }]})
SiteNav#sitenav(label="Main" current="/" links={[{ href: '/', label: 'Home', icon: 'info' }]})
AppHeader#appheader(label="App" current="/" links={[{ href: '/', label: 'Home' }]})
  @brand
    span brand
  @end
    span end
Pagination#pager(page={10} pages={20} url="/list")
SplitLayout#split(sidebarTitle="Filters" resizableList)
  @sidebar
    p side
  @listHead
    p lhead
  @list
    p list
  @detailHead
    p dhead
  @detail
    p detail
TreeView#tree(label="Files" selected="b" expanded={['a']} nodes={[{ id: 'a', label: 'A', icon: 'info', children: [{ id: 'b', label: 'B' }] }, { id: 'c', label: 'C' }]})
VirtualList#virtual(label="Rows" items={[1, 2]})
  @item(row)
    p {row}
LineChart#line(labels={['a', 'b']} series={[{ name: 'S', values: [1, 2] }]} legend)
ScatterChart#scatter(label="Points" points={[{ key: 1, label: 'P', x: 1, y: 2 }]})
ContributionGraph#contrib(days={[{ day: '2026-09-15', intensity: 0.5 }]} color="green" today="2026-09-15" months)
Carousel#carousel(slides={[{ src: '/a.png', alt: 'A' }, { src: '/b.png', alt: 'B' }]})
Masonry#masonry(items={[1, 2]} key={item => item})
  @tile(item)
    p {item}
MediaGallery#gallery(items={[{ key: 1, kind: 'image', thumb: '/t.png', preview: '/p.png' }, { key: 2, kind: 'image', thumb: '/u.png', preview: '/q.png' }]})
MediaGallery#gallery-empty(items={[]})
ImageCropper#cropper(src="/a.png")
ZoomPane#zoom(label="Map")
  p content
QrCode#qr(value="https://kay.dev")
SiteFavicon#favicon(name="Kay" src="/favicon.png")
IconPicker#icon-picker(search={async () => []})
MarkdownEditor#markdown
BarChart#bars(label="Runs" labels={['a', 'b']} xLabels legend series={[{ name: 'S', values: [1, 2] }, { name: 'T', values: [2, 1] }]})
Accordion#accordion(items={[{ value: 'a', title: 'A' }]})
  @panel(value)
    p {value}
Skeleton#skeleton(lines={2})
Progress#progress(value={30} label="Upload")
Breadcrumb#breadcrumb(label="Trail" items={[{ label: 'Home', href: '/' }, { label: 'Docs', href: '/docs' }, { label: 'Page' }]})
RadioGroup#radios(label="Plan" value="a" options={[{ value: 'a', label: 'A', description: 'First' }, { value: 'b', label: 'B' }]})
Toaster#toaster
TooltipHost#tooltips
FormDialog#form-dialog(open={true} title="Rename" action={fakeAction} submitLabel="Rename" failure="Could not rename" onOpenChange={() => undefined})
  TextInput(name="name")
ContactForm#contact(action={fakeAction})
LoadMore#more(list={feed})
Combobox#combobox(label="Planet" options={[{ value: 'earth', label: 'Earth' }]})
Steps#steps(label="Signup" steps={[{ key: 'a', label: 'A' }, { key: 'b', label: 'B' }]} current="b" url="/signup" done={['a']})
WhenVisible#visible(onVisible={() => undefined})
