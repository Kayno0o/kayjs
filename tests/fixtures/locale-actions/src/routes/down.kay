--- server
import { s, action } from 'kay'

// The wording is async and reads the error and the page's locale, as one loading an address kept in a collection would.
export const loud = action({ input: s.Object({}), messages: { serverError: async (error, ctx) => `${ctx.locale}: ${(error as Error).message}` } }, () => {
  throw new Error('mail down')
})

export const mute = action({ input: s.Object({}), messages: { serverError: () => {
  throw new Error('words down')
} } }, () => {
  throw new Error('mail down')
})

export const blank = action({ input: s.Object({}), messages: { serverError: () => '  ' } }, () => {
  throw new Error('mail down')
})
---
form(action={loud})
  button Send
form(action={mute})
  button Mute
form(action={blank})
  button Blank
if loud.form.error()
  p.error {loud.form.error()}
if mute.form.error()
  p.error {mute.form.error()}
if blank.form.error()
  p.error {blank.form.error()}
