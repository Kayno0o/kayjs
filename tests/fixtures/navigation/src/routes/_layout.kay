---
import Player from '../components/player.kay'
import { Tone } from '../tone'

Tone.provide('layout')
--- server
const page = ctx.url.pathname
// A page whose layout sets nothing on `<html>`, and serves another theme colour.
const bare = page === '/later'
// A page that puts the persistent island in a wrapper of its own.
const wrapped = page === '/wrapped'
---
head
  meta(name="theme-color" content={bare ? '#000000' : '#ffffff'})
  meta(property="og:image" content={bare ? '/b.png' : '/a.png'})
  meta(property="og:image" content={bare ? '/c.png' : '/b.png'})
  html(class={bare ? undefined : 'served'} data-theme={bare ? undefined : 'light'} data-label={bare ? undefined : 'say "hi" & <b>\r\nbye'})
nav
  a.home(href="/") Home
  a.second(href="/second") Second
  a.later(href="/later") Later
  a.reload(href="/plain" data-reload) Plain
  a.whole(href="/whole") Whole
  a.isolated(href="/isolated") Isolated
  a.nofollow(href="/state" rel="nofollow") State
ul#side(style="height: 40px; overflow-y: auto; margin: 0")
  li(style="height: 400px") Side
div#drawer(popover) Drawer
if wrapped
  section.wrapper
    Player(persist page={page})
else
  Player(persist page={page})
slot
