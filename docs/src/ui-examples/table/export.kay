---
import Table from '@kaynooo/kayjs-ui/table.kay'

interface Moon {
  id: number
  name: string
  radius: number
}

const moons: Moon[] = [
  { id: 1, name: 'Io', radius: 1822 },
  { id: 2, name: 'Europa', radius: 1561 },
  { id: 3, name: 'Amalthea', radius: 84 },
]

// Plain literals rather than `Column<Moon>[]`, which a static file cannot hand an island yet (kaynooo/kayjs#1772).
const columns = [
  { key: 'name', header: 'Name', sortValue: true as const },
  { key: 'radius', header: 'Radius (km)', numeric: true as const },
]
---
Table(columns={columns} rows={moons} rowKey="id" filter={['name']} exportable exportName="moons.csv")
