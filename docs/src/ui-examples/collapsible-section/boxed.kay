---
import Badge from '@kaynooo/kayjs-ui/badge.kay'
import CollapsibleSection from '@kaynooo/kayjs-ui/collapsible-section.kay'
---
.flex.flex-col.gap-3
  CollapsibleSection(title="Active" open boxed)
    p Io, Europa and Ganymede.
  CollapsibleSection(title="Archived" boxed)
    @meta
      Badge(label={2})
    p Callisto and Amalthea.
