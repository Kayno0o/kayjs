---
import type { Action, FormFailure } from 'kay'
import { signal } from 'kay'
import ContactForm from '@kayjs/ui/contact-form.kay'
import SubscribeForm from '@kayjs/ui/subscribe-form.kay'

// A stand-in for an action: the page's outcome of the last post is what `settle` and `refuse` set.
const { onSend, onError, onSubscribed, onSubscribeError } = props<{ onSend: (data: unknown) => void, onError: (failure: FormFailure<never, unknown>) => void, onSubscribed?: (data: unknown) => void, onSubscribeError?: (failure: FormFailure<never, unknown>) => void }>()

const done = signal<{ data: unknown } | undefined>(undefined)
const failed = signal<FormFailure<never, unknown> | undefined>(undefined)

const action = Object.assign(async () => undefined, {
  [Symbol.for('kay.action')]: true,
  url: '/_kay/action/mail/form',
  pending: () => false,
  succeeded: () => done(),
  failed: () => failed(),
  error: (field = '') => (failed()?.errors as Record<string, string> | undefined)?.[field],
}) as unknown as Action<never, unknown>
---
button#sent(onClick={() => { failed = undefined; done = { data: 'ok' } }}) Sent
button#refused(onClick={() => { done = undefined; failed = { status: 422, message: 'Invalid', values: {}, errors: { email: 'Invalid' } } }}) Refused
ContactForm(action={action} onSend={onSend} onError={onError})
  @sent
    p#custom-sent Custom
SubscribeForm(action={action} onSend={onSubscribed} onError={onSubscribeError})
  @sent
    p#subscribed Subscribed
  input#extra(name="extra")
