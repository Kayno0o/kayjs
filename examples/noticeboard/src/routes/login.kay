--- server
import { s } from 'kay'
import { FAILURE_WORDS } from '../words'

export const signIn = action(s.Object({
  identifier: s.String({ maxLength: 254 }),
  password: s.String({ maxLength: 128 }),
  redirect: s.Optional(s.String({ maxLength: 2000 })),
  captcha: s.Optional(s.String({ maxLength: 512 })),
}), async (input, ctx) => {
  const result = await ctx.locals.auth.signInWithPassword(input)

  if (!result.ok)
    return ctx.fail(400, { error: result.error })

  return ctx.redirect(result.redirect)
})

// Answers alike whether or not an account has the address, so the form tells no one which addresses are members.
export const mailLink = action(s.Object({
  email: s.String({ maxLength: 254 }),
  redirect: s.Optional(s.String({ maxLength: 2000 })),
  captcha: s.Optional(s.String({ maxLength: 512 })),
}), async ({ email, redirect, captcha }, ctx) => {
  const result = await ctx.locals.auth.requestMagicLink(email, redirect, { captcha })

  if (!result.ok)
    return ctx.fail(result.error === 'limited' ? 429 : result.error === 'captcha' ? 400 : 503, { error: result.error })

  return { sent: true }
})

const redirect = ctx.url.searchParams.get('redirect') ?? '/'
const signInFailure = ctx.failed(signIn)?.data?.error
const linkFailure = ctx.failed(mailLink)?.data?.error
// kayjs-auth asks a proof of work of every magic link, and of a password sign-in once this client failed three times.
const [signInChallenge, linkChallenge] = await Promise.all([ctx.locals.auth.captchaChallenge('sign-in'), ctx.locals.auth.captchaChallenge('magic-link')])
--- script
import Button from '@kaynooo/kayjs-ui/button.kay'
import FormField from '@kaynooo/kayjs-ui/form-field.kay'
---
head
  title Sign in
h1.text-2xl.font-bold Sign in
form.page-form(action={signIn})
  input(type="hidden" name="redirect" value={redirect})
  FormField(label="Name or email" required)
    input(name="identifier" autocomplete="username" required)
  FormField(label="Password" required)
    input(name="password" type="password" autocomplete="current-password" required)
  if signInChallenge
    input(type="hidden" name="captcha" data-kay-work={signInChallenge})
  if signInFailure
    p.text-kui-error {FAILURE_WORDS[signInFailure]}
  Button(label="Sign in" variant="accent" type="submit")
h2.mt-8.text-lg.font-bold Or get a link by mail
form.page-form(action={mailLink})
  input(type="hidden" name="redirect" value={redirect})
  FormField(label="Email" required)
    input(name="email" type="email" autocomplete="email" required)
  if linkChallenge
    input(type="hidden" name="captcha" data-kay-work={linkChallenge})
  if mailLink.succeeded()
    p.text-kui-success If a member has this address, a link to sign in is on its way.
  if linkFailure
    p.text-kui-error {FAILURE_WORDS[linkFailure]}
  Button(label="Mail me a link" type="submit")
p.mt-4
  a(href="/reset") Forgot your password?
