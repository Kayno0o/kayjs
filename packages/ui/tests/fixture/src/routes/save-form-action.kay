--- server
import { t } from 'elysia'
import { action } from 'kay'

export const draft = action(t.Object({ name: t.String({ minLength: 2, error: 'Two letters at least' }) }), ({ name }) => name)
--- script
import SaveForm from '@kaynooo/kayjs-ui/save-form.kay'
import Toaster from '@kaynooo/kayjs-ui/toaster.kay'
---
Toaster
SaveForm(action={draft} failure="Could not save" saved="Saved.")
  input#name(name="name" value="Ada")
