---
import type { ScreenCollection, StoredEntry } from '@kayjs/cms'
import EntryActions from '@kayjs/cms/entry-actions.kay'
import EntryField from '@kayjs/cms/entry-field.kay'
import EntryHeader from '@kayjs/cms/entry-header.kay'
import EntryIdentity from '@kayjs/cms/entry-identity.kay'
import EntryNotices from '@kayjs/cms/entry-notices.kay'
import { cmsEntryForm } from '@kayjs/cms/form'

// The app's own entry screen for the shop: the photo above the name, the price and the stock side by side, no sku.
const { prefix, collection, entry } = props<{ prefix: string, collection: ScreenCollection, entry?: StoredEntry | undefined }>()

const form = cmsEntryForm({ prefix, collection, entry })
---
form.shop-entry(novalidate onSubmit={event => { event.preventDefault(); void form.save() }})
  EntryHeader(prefix={prefix} collection={collection} title={form.name} subtitle={form.subtitle})
    EntryActions(form={form})
  EntryIdentity(form={form})
  EntryNotices(form={form})
  EntryField(form={form} name="photo")
  EntryField(form={form} name="name")
  .kcms-row
    EntryField(form={form} name="price")
    EntryField(form={form} name="stock")
