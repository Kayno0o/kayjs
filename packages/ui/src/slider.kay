---
import type { JSX } from 'kay'
import { recipe } from 'kay'
import { controlledInput } from './controlled-input'

// The track and the thumb of both engines are drawn from the field and accent tokens.
const look = recipe({
  parts: {
    root: 'kui-slider grid grid-cols-[1fr_auto] items-center gap-x-3 gap-y-1',
    label: 'text-xs font-kui-label tracking-kui-label text-kui-subtext0 [font-family:var(--font-label,var(--font-kui-body,inherit))] [text-transform:var(--label-case)]',
    input: 'col-span-2 h-4 w-full cursor-pointer appearance-none bg-transparent [&::-webkit-slider-runnable-track]:h-1 [&::-webkit-slider-runnable-track]:bg-kui-field-border [&::-moz-range-track]:h-1 [&::-moz-range-track]:bg-kui-field-border [&::-webkit-slider-thumb]:size-4 [&::-webkit-slider-thumb]:-mt-1.5 [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:rounded-kui-card [&::-webkit-slider-thumb]:border-0 [&::-webkit-slider-thumb]:bg-kui-accent [&::-moz-range-thumb]:size-4 [&::-moz-range-thumb]:rounded-kui-card [&::-moz-range-thumb]:border-0 [&::-moz-range-thumb]:bg-kui-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-kui-accent disabled:cursor-default disabled:opacity-50',
    value: 'text-xs text-kui-text tabular-nums',
  },
})

const { value, min = 0, max = 100, step, label, showValue = true, formatValue, onInput, onChange, ...rest } = props<Omit<JSX.IntrinsicElements['input'], 'class' | 'children' | 'type' | 'value' | 'min' | 'max' | 'step' | 'onInput' | 'onChange'> & {
  // The value to start with; a slider whose parent passes another follows it.
  value: number
  // The bounds, 0 and 100 by default.
  min?: number | undefined
  max?: number | undefined
  step?: number | undefined
  // Shown beside the slider and naming it for screen readers.
  label: string
  // Whether the value is written beside the label.
  showValue?: boolean | undefined
  // Words the value for the display and for screen readers, such as `value => `${value} ms``.
  formatValue?: ((value: number) => string) | undefined
  // Runs on every move of the thumb, with the number, and after a form reset with the value it went back to.
  onInput?: ((value: number) => unknown) | undefined
  // Runs once with the value let go of: when the pointer is released, on each key press (arrows, Home, End, PageUp, PageDown), and after a form reset that moved the thumb.
  // A promise holds the slider busy until it settles, and puts the thumb back where it was when it rejects (logged) or resolves to false: a refused change never shows as made.
  onChange?: ((value: number) => unknown) | undefined
}>()

const { shown, busy, ref: sliderRef, move, change: released } = controlledInput<number>({
  control: 'Slider',
  value: () => value,
  onChange: () => onChange,
  read: input => Number(input.value),
  write: (input, next) => {
    input.value = String(next)
  },
  defaultOf: input => Number(input.defaultValue),
  setDefault: (input, next) => {
    input.defaultValue = String(next)
  },
  // The app that follows `onInput` is told the value put back, as after a reset.
  restored: next => onInput?.(next),
  appRef: rest.ref,
})

const words = (number: number) => formatValue ? formatValue(number) : String(number)

function moved(event: Event) {
  const input = event.currentTarget as HTMLInputElement

  if (move(input))
    onInput?.(Number(input.value))
}

const STEPS = new Set(['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'Home', 'End', 'PageUp', 'PageDown'])

// A busy slider takes no new gesture, as a Toggle takes no click; the keys that do not step it, Tab first, go through.
function held(event: Event) {
  if (busy() && (!(event instanceof KeyboardEvent) || STEPS.has(event.key)))
    event.preventDefault()
}
---
div(part="root")
  span(part="label") {label}
  input({...rest} part="input" ref={sliderRef} type="range" aria-label={rest['aria-label'] || label} aria-valuetext={formatValue ? words(shown()) : undefined} min={min} max={max} step={step} value={shown()} aria-busy={busy() ? 'true' : undefined} onInput={moved} onChange={event => released(event.currentTarget)} onMouseDown={held} onTouchStart={held} onKeyDown={held})
  if showValue
    // Not an `output`, which a form reset empties; the input itself speaks the value.
    span(part="value" aria-hidden="true") {words(shown())}
