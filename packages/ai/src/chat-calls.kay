---
import type { ToolCall } from './types'

const { calls, details, runningLabel, doneLabel, failedLabel, argumentsLabel, resultLabel } = props<{
  calls: ToolCall[]
  // Whether a call opens to its arguments and result.
  details: boolean
  runningLabel: string
  doneLabel: string
  failedLabel: string
  argumentsLabel: string
  resultLabel: string
}>()

const LABELS = { running: runningLabel, done: doneLabel, failed: failedLabel }

function status(call: ToolCall) {
  return LABELS[call.status]
}
---
ul.kai-chat-calls
  for call of calls key={call.id}
    li.kai-chat-call(data-status={call.status})
      if details
        details
          summary
            span.kai-chat-call-name {call.name}
            |
            span.kai-chat-call-status {status(call)}
          p.kai-chat-call-title {argumentsLabel}
          pre.kai-chat-call-code {JSON.stringify(call.input, null, 2)}
          if call.result !== undefined
            p.kai-chat-call-title {resultLabel}
            pre.kai-chat-call-code {call.result}
      else
        span.kai-chat-call-name {call.name}
        |
        span.kai-chat-call-status {status(call)}
