--- <Id extends TreeId>
import type { JSX, Snippet } from 'kay'
import type { MenuEntry } from './menu'
import { tabOf } from './outside'
import type { TreeId, TreeNode, TreeRow } from './tree'
import { effect, memo, recipe, signal, untrack, withQuery } from 'kay'
import Icon from './icon.kay'
import Menu from './menu.kay'
import { ORIGIN } from './tab-nav'
import { treeHasMenu, treeHere, treeKey, treePath, treeRows } from './tree'
import { wording } from 'kay/words'

const look = recipe({ parts: { root: 'kui-tree-view', item: 'kui-tree-view-item', toggle: 'kui-tree-view-toggle', spinner: 'kui-tree-view-spinner animate-spin motion-reduce:animate-none', icon: 'kui-tree-view-icon', label: 'kui-tree-view-label', link: 'kui-tree-view-link', failed: 'kui-tree-view-failed', retry: 'kui-tree-view-retry', trailing: 'kui-tree-view-trailing' } })

const { nodes, label, selected, expanded = [], onSelectedChange, onSelect, onOpenChange, onToggle, trailing, emptyLabel, empty, failureLabel = wording('ui.treeView.failure', 'Could not load.'), retryLabel = wording('ui.treeView.retry', 'Try again'), ...rest } = props<Omit<JSX.IntrinsicElements['ul'], 'class' | 'children' | 'role' | 'onKeyDown' | 'onSelect' | 'onToggle'> & {
  nodes: readonly TreeNode<Id>[]
  // Names the tree for screen readers.
  label: string
  // The node picked; a tree whose parent passes another follows it, opening the branches holding it. Left out, the node whose `href` is the page's address is the selected one, on the server's HTML too.
  selected?: Id | undefined
  // The branches open; a tree whose parent passes another list follows it, and the reader opens and closes branches from then on.
  expanded?: readonly Id[] | undefined
  // Called with the branch's id, whether it is now open and the node, whenever the reader opens or closes a branch, by a click or a key.
  onOpenChange?: ((id: Id, open: boolean, node: TreeNode<Id>) => unknown) | undefined
  // Before 1.90 `onOpenChange` was called `onToggle`; both work until 1.93 (`deprecated-open-change`).
  onToggle?: ((id: Id, open: boolean, node: TreeNode<Id>) => unknown) | undefined
  // What a branch whose children failed to load says, beside a button that tries again.
  failureLabel?: string | undefined
  retryLabel?: string | undefined
  // Runs on a click on a row, or Enter or Space on the focused one, with the id `selected` takes and the node picked.
  onSelectedChange?: ((id: Id, node: TreeNode<Id>) => unknown) | undefined
  // The name before 1.87, called until 1.90 only when `onSelectedChange` is not given; `kay check` reports it as `deprecated-ui-callbacks`.
  onSelect?: ((id: Id, node: TreeNode<Id>) => unknown) | undefined
  // Controls at the end of a row, such as a star or a count, dimmed away until the row is hovered or holds focus: `@trailing(node)`.
  trailing?: Snippet<[TreeNode<Id>]> | undefined
  // What the component reads with nothing to show; `empty` replaces it with the app's own markup, such as a link to add the first one: an `@empty` block.
  emptyLabel?: string | undefined
  empty?: Snippet | undefined
}>()

// The empty text is a div, not the list's own element, so it takes the attributes as a div does.
const loose = rest as unknown as JSX.IntrinsicElements['div']

// The empty text is a div, not the list's own element, so it takes the attributes as a div does.
const loose = rest as unknown as JSX.IntrinsicElements['div']

// The page's address, which a page rendered once at build time does not have.
function address() {
  try {
    return withQuery({})
  }
  catch {
    return undefined
  }
}

// The node picked by the parent, else the one whose `href` is the page's address.
function target() {
  if (selected !== undefined)
    return selected

  const here = address()

  return here === undefined ? undefined : treeHere(nodes, new URL(here, ORIGIN))
}

const path = (id: TreeId | undefined) => id === undefined ? undefined : treePath(nodes, id)
// Held as the wider type: a signal cannot take a type parameter.
// Opened to the selected node from the start, so the server's HTML shows it too.
const open = signal<ReadonlySet<TreeId>>(new Set<TreeId>([...expanded, ...path(target()) ?? []]))
const current = signal<TreeId | undefined>(target())
// The row in the page's tab order, as a tree is one stop the arrows move inside.
const focused = signal<TreeId | undefined>(target())
// The children of the branches whose `children` is a function, once loaded, the branches loading and those that failed.
const loaded = signal<ReadonlyMap<TreeId, readonly TreeNode<TreeId>[]>>(new Map())
const loading = signal<ReadonlySet<TreeId>>(new Set())
const failed = signal<ReadonlySet<TreeId>>(new Set())
const kids = (node: TreeNode<Id>) => typeof node.children === 'function' ? loaded().get(node.id) as readonly TreeNode<Id>[] | undefined : node.children
const rows = memo(() => treeRows(nodes, open(), 1, undefined, kids))
// The selected node whose branches were last opened, so new nodes never reopen a branch closed since.
let reached = path(target()) ? target() : undefined
let list: HTMLUListElement | undefined

effect(() => current = target())

// The parent passing another `expanded` replaces the branches open, the selected node's still among them.
effect(() => {
  const wanted = [...expanded]

  untrack(() => open = new Set<TreeId>([...wanted, ...path(target()) ?? []]))
})

function without<Item>(set: ReadonlySet<Item>, item: Item) {
  return new Set([...set].filter(one => one !== item))
}

// Calls a branch's `children` once, the first time it is open and shown.
async function load(node: TreeNode<Id>) {
  const id = node.id

  if (typeof node.children !== 'function' || loaded().has(id) || loading().has(id) || failed().has(id))
    return

  loading.set(shown => new Set([...shown, id]))

  try {
    const below = await node.children()

    loaded.set(shown => new Map([...shown, [id, below]]))
  }
  catch {
    failed.set(shown => new Set([...shown, id]))
  }
  finally {
    loading.set(shown => without(shown, id))
  }
}

function retry(node: TreeNode<Id>) {
  failed.set(shown => without(shown, node.id))
  void load(node)
}

// Every open branch shown whose children are still to come, from the start or once its parent's came.
effect(() => {
  for (const row of rows()) {
    if (typeof row.node.children === 'function' && open().has(row.node.id))
      void untrack(() => load(row.node))
  }
})

// Waits for the nodes holding the selected one when they come later.
effect(() => {
  const picked = target()
  const holding = path(picked)

  if (!holding || picked === reached)
    return

  reached = picked
  focused = picked

  // Untracked, so closing a branch never brings the prop back over a pick made since.
  if (holding.some(id => !untrack(open).has(id)))
    open.set(shown => new Set([...shown, ...holding]))
})

// The focused row when shown, which starts as the selected one, else the selected one, else the first.
const stop = memo(() => {
  const shown = new Set<TreeId>(rows().map(row => row.node.id))

  return [focused(), current()].find(id => id !== undefined && shown.has(id)) ?? rows()[0]?.node.id
})

// Opening a branch whose children failed tries them again.
function toggle(id: TreeId) {
  const opening = !open().has(id)
  const node = rows().find(row => row.node.id === id)?.node

  open.set(shown => opening ? new Set([...shown, id]) : without(shown, id))

  if (opening)
    failed.set(shown => without(shown, id))

  if (node)
    onOpenChange ? onOpenChange(id as Id, opening, node) : onToggle?.(id as Id, opening, node)
}

function pick(row: TreeRow<Id>) {
  current = row.node.id
  focused = row.node.id
  onSelectedChange ? onSelectedChange(row.node.id, row.node) : onSelect?.(row.node.id, row.node)
}

// A branch's chevron opens or closes it, the rest of the row selects it, the row's own controls excepted; the keyboard does both through the row itself.
function click(event: MouseEvent, row: TreeRow<Id>) {
  const element = event.target as Element

  if (element.closest('.kui-tree-view-trailing'))
    return

  if (element.closest('.kui-tree-view-retry')) {
    retry(row.node)

    return
  }

  // A new-tab click on a link row leaves the page where it is, so the row stays unselected.
  if (row.node.href !== undefined && (event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) && !element.closest('.kui-tree-view-toggle'))
    return

  if (row.node.children && element.closest('.kui-tree-view-toggle'))
    toggle(row.node.id)
  else
    pick(row)
}

// The context menu of the node, drawn once for the tree and moved to the row asking for it.
const menu = signal<{ name: string, items: MenuEntry[], at: { x: number, y: number } } | undefined>(undefined)
const hasMenu = memo(() => treeHasMenu(nodes))

function rowElement(id: TreeId) {
  return list?.querySelectorAll<HTMLElement>('.kui-tree-view-item')[rows().findIndex(row => row.node.id === id)]
}

function showMenu(node: TreeNode<Id>, x: number, y: number) {
  if (!node.menu?.length)
    return false

  menu = { name: node.label, items: [...node.menu], at: { x, y } }

  return true
}

function contextMenu(event: MouseEvent, row: TreeRow<Id>) {
  if ((event.target as Element).closest('.kui-tree-view-trailing'))
    return

  // Focus goes back to the row when the menu closes.
  if (showMenu(row.node, event.clientX, event.clientY)) {
    event.preventDefault()
    focusRow(row.node.id)
  }
}

function focusRow(id: TreeId) {
  focused = id
  const index = rows().findIndex(row => row.node.id === id)

  list?.querySelectorAll<HTMLElement>('.kui-tree-view-item')[index]?.focus()
}

function keyDown(event: KeyboardEvent) {
  // The row's own controls keep their keys.
  if ((event.target as Element).closest('.kui-tree-view-trailing, .kui-tree-view-retry'))
    return

  // Shift+F10 and the Menu key open the focused row's context menu below it, as a right click would at the pointer.
  if (event.key === 'ContextMenu' || (event.key === 'F10' && event.shiftKey && !event.altKey && !event.ctrlKey && !event.metaKey)) {
    const box = stop() === undefined ? undefined : rowElement(stop()!)?.getBoundingClientRect()
    const row = rows().find(one => one.node.id === stop())

    if (box && row && showMenu(row.node, box.left, box.bottom))
      event.preventDefault()

    return
  }

  // A chord, such as Alt+Left going back a page, stays the browser's; Shift only types a capital.
  if (event.altKey || event.ctrlKey || event.metaKey || (event.shiftKey && (event.key.length > 1 || event.key === ' ')))
    return

  const at = stop()
  const row = rows().find(one => one.node.id === at)

  if (at === undefined || !row)
    return

  if (event.key === 'Enter' || event.key === ' ') {
    event.preventDefault()

    // The link's own click selects the row too, as it bubbles to it.
    if (row.node.href === undefined)
      pick(row)
    else
      rowElement(at)?.querySelector('a')?.click()

    return
  }

  const move = treeKey(rows(), at, event.key, open())

  if (!move)
    return

  event.preventDefault()

  if ('focus' in move)
    focusRow(move.focus)
  else
    toggle('open' in move ? move.open : move.close)
}
---
if nodes.length === 0
  // The app's attributes stay on whichever element shows.
  if empty
    div.kui-tree-view-empty(part="root" {...loose} role="status")
      | {empty}
  else if emptyLabel !== ''
    div.kui-tree-view-empty(part="root" {...loose} role="status") {emptyLabel ?? wording('ui.treeView.empty', 'Nothing here yet.')}
else
  // The rows of every open branch in one list, each saying its depth and place for screen readers, so the arrows walk them in reading order.
  ul(part="root" {...rest} ref={element => list = element} role="tree" aria-label={label} onKeyDown={keyDown})
    for row of rows() key={row.node.id}
      li(part="item" role="treeitem" aria-level={row.level} aria-posinset={row.position} aria-setsize={row.size} aria-expanded={row.node.children ? String(open().has(row.node.id)) : undefined} aria-busy={loading().has(row.node.id) ? 'true' : undefined} aria-selected={row.node.id === current() ? 'true' : 'false'} tabindex={row.node.id === stop() ? 0 : -1} style={`--_tree-level: ${row.level - 1}`} onFocus={() => focused = row.node.id} onClick={event => click(event, row)} onContextMenu={event => contextMenu(event, row)})
        if row.node.children
          span(part="toggle" aria-hidden="true")
            if loading().has(row.node.id)
              Icon(icon="spinner" part="spinner")
            else
              Icon(icon="chevron")
        else
          span(part="toggle")
        if row.node.icon
          Icon(icon={row.node.icon} part="icon")
        if row.node.href !== undefined
          a(part="link" href={row.node.href} {...tabOf(row.node.href, row.node.newTab)} tabindex="-1" aria-current={row.node.id === current() ? 'page' : undefined}) {row.node.label}
        else
          span(part="label") {row.node.label}
        if failed().has(row.node.id)
          span(part="failed" role="alert") {failureLabel}
          button(part="retry" type="button") {retryLabel}
        if trailing
          span(part="trailing")
            | {trailing(row.node)}
  if hasMenu()
    Menu(items={menu()?.items ?? []} label={menu()?.name ?? label} at={menu()?.at ?? { x: 0, y: 0 }} open={menu() !== undefined} onOpenChange={shown => { if (!shown) menu = undefined }})
