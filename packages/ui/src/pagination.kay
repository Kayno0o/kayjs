---
import { recipe, withQuery } from 'kay'
import type { JSX, Snippet } from 'kay'
import type { PagedList } from './pagination'
import { currentPage, openSteps, openTargets, pageCount, pageHref, pageItems, pageRange, sizeHref } from './pagination'
import { labelText } from './label-text'
import PageClicks from './internal/page-clicks.kay'
import { wording } from 'kay/words'

// 'kui-pagination' stays as the component's name for an app's CSS. A step reads its line from --_control-line, which a skin sets, and one at an end of the list is a span, drawn as text rather than a link.
const look = recipe({
  parts: {
    root: 'kui-pagination flex flex-wrap items-center gap-1 text-sm',
    step: 'min-w-9 border-solid border-[length:var(--border-width)] px-3 py-1.5 text-center text-muted transition-colors hover:text-foreground [border-color:var(--_control-line,var(--color-border))] [&:is(span)]:opacity-50 [&:is(span)]:hover:text-muted',
    gap: 'px-2 text-[var(--color-muted)]',
    page: 'min-w-9 border-solid border-[length:var(--border-width)] px-3 py-1.5 text-center text-muted transition-colors hover:text-foreground aria-[current=page]:border-accent aria-[current=page]:text-accent border-border',
    range: 'mr-2 text-muted',
    sizes: 'ml-auto flex flex-wrap items-center gap-1 text-muted',
    size: 'min-w-9 border-solid border-[length:var(--border-width)] px-2 py-1.5 text-center text-muted transition-colors hover:text-foreground aria-[current=true]:border-accent aria-[current=true]:text-accent border-border',
  },
})

const { of, page, pages, total, pageSize, offset, limit, more, url, param, siblings = 1, step, onPage, sizes, limitParam = 'limit', onSize, sizeLabel = wording('ui.pagination.size', 'Rows per page'), rangeLabel, label = wording('ui.pagination.label', 'Pagination'), previousLabel = wording('ui.pagination.previous', 'Previous'), nextLabel = wording('ui.pagination.next', 'Next'), ...rest } = props<Omit<JSX.IntrinsicElements['nav'], 'class' | 'children'> & ({
  // A page kay's `paginate()` gave, which links each page at its own path: `Pagination(of={list})`.
  of: PagedList
  page?: never
  pages?: never
  total?: never
  pageSize?: never
  offset?: never
  limit?: never
  more?: never
  url?: never
} | {
  of?: never
  // The page on screen, from 1; one past the ends, or no whole number, such as `?page=abc` read as `NaN`, shows as the nearest that exists.
  page: number
  // How many pages there are; with one or none, nothing is drawn.
  pages: number
  total?: never
  pageSize?: never
  offset?: never
  limit?: never
  more?: never
  // The URL of the page on screen, `ctx.url`: each link keeps its path and query, `param` set to the page. Left out, the links keep the address the page has.
  url?: URL | string | undefined
} | {
  // A list of `total` rows, `pageSize` to a page: the pages follow from them, and a summary such as `21–40 of 134` shows beside the links.
  of?: never
  page: number
  pages?: never
  total: number
  pageSize: number
  offset?: never
  limit?: never
  more?: never
  url?: URL | string | undefined
} | {
  // A list whose length is unknown, by page number: only Previous and Next, Next while `more` says there is a page after this one.
  of?: never
  page: number
  pages?: never
  total?: never
  pageSize?: never
  offset?: never
  limit?: never
  more: boolean
  url?: URL | string | undefined
} | {
  // The same by offset, `?offset=40`, a page holding `limit` rows.
  of?: never
  page?: never
  pages?: never
  total?: never
  pageSize?: never
  offset: number
  limit: number
  more: boolean
  url?: URL | string | undefined
}) & {
  // The query parameter holding the page, `page` by default, or the offset, `offset` by default.
  param?: string | undefined
  // How many pages show on each side of the current one, 1 by default.
  siblings?: number | undefined
  // Names the navigation for screen readers.
  label?: string | undefined
  previousLabel?: string | undefined
  nextLabel?: string | undefined

  // Draws the content of Previous and Next in place of their words, such as an icon: `@step(direction)`, `direction` being `'previous'` or `'next'`. The labels still name the links.
  step?: Snippet<[direction: 'previous' | 'next']> | undefined
  // For a list the app pages in the browser, with no address to change: called with the page a plain click on a link picks, or with the offset it starts at for a list paged by offset, and the click event. Each link keeps its real address, so a middle click or a new tab still opens it, and a handler returning `false` lets the browser follow the link too. The page on screen is kept by the component and follows `page` when the app changes it, or is the app's alone by setting `page` in the handler. Passed from an island, as any handler is.
  onPage?: ((page: number, event: MouseEvent) => unknown) | undefined
  // The page sizes to offer beside a `total`, a link each that sets `limitParam` and drops the page: `sizes={[10, 25, 50]}`. The size on screen is `pageSize`, which the page reads from the same parameter.
  sizes?: readonly number[] | undefined
  // The query parameter holding the page size, `limit` by default.
  limitParam?: string | undefined
  // Called with the size a plain click on a size link picks and the event, as `onPage` is for a page.
  onSize?: ((size: number, event: MouseEvent) => unknown) | undefined
  // Names the sizes for screen readers, `Rows per page` by default.
  sizeLabel?: string | undefined
  // The summary beside a `total`: a string filling `{from}`, `{to}` and `{total}`, or a function of `{ from, to, total }`.
  rangeLabel?: string | ((range: { from: number, to: number, total: number }) => string) | undefined
}>()

const count = () => of?.pages ?? pages ?? (total === undefined ? 0 : pageCount(total, pageSize!))
// The page as one that exists, whatever the query held.
const shown = () => currentPage(of?.page ?? page ?? 1, count())
// The page on screen, for a pagination given no `url`: a page rendered once at build time does not have one.
function address() {
  try {
    return withQuery({})
  }
  catch {
    return ''
  }
}

const base = () => url ?? address()
const href = (target: number) => of ? of.href(target) : pageHref(base(), target, param)
const position = () => limit === undefined ? { page: page ?? 1 } : { offset: offset ?? 0, limit }
const steps = () => more === undefined ? undefined : openSteps(position(), more, base(), param)
const targets = () => more === undefined ? undefined : openTargets(position(), more)
// What a handler is given for a link, written on every link so the wrapper of a Pagination with a handler finds it.
const given = (target: number | undefined) => target
const summary = () => {
  if (total === undefined)
    return undefined

  const range = pageRange(shown(), total, pageSize!)

  return rangeLabel === undefined ? wording('ui.pagination.range', '{from}–{to} of {total}', range) : labelText(rangeLabel, range, range)
}
// Sizes are offered while the list outgrows the smallest, so one picked past the rows still shows the others.
const sized = () => total !== undefined && sizes !== undefined && sizes.length > 0 && total > Math.min(...sizes)
// One page of rows still draws its summary, `1–5 of 5`.
const drawn = () => count() > 1 || sized() || (total !== undefined && total > 0)

---
// Plain links, through the query or at the paths `paginate()` gives, so a page renders on the server, its pages crawlable, and needs no island. With a handler they sit in a wrapper that hears the clicks, the one island.
snippet words(direction: 'previous' | 'next')
  if step
    | {step(direction)}
  else if direction === 'previous'
    | {previousLabel}
  else
    | {nextLabel}
snippet body
  if steps() then open
    if open.previous || open.next
      nav(part="root" {...rest} aria-label={label})
        if open.previous
          a(part="step" href={open.previous} data-page={given(targets()?.previous)} rel="prev" aria-label={step ? previousLabel : undefined}) {words('previous')}
        else
          span(part="step" aria-label={step ? previousLabel : undefined}) {words('previous')}
        if open.next
          a(part="step" href={open.next} data-page={given(targets()?.next)} rel="next" aria-label={step ? nextLabel : undefined}) {words('next')}
        else
          span(part="step" aria-label={step ? nextLabel : undefined}) {words('next')}

  else if drawn()
    nav(part="root" {...rest} aria-label={label})
      if summary() then text
        span(part="range" role="status") {text}
      if count() > 1
        if shown() > 1
          a(part="step" href={href(shown() - 1)} data-page={given(shown() - 1)} rel="prev" aria-label={step ? previousLabel : undefined}) {words('previous')}
        else
          span(part="step" aria-label={step ? previousLabel : undefined}) {words('previous')}
        for item, index of pageItems(shown(), count(), siblings) key={index}
          if item === 'gap'
            span(part="gap" aria-hidden="true") …
          else
            a(part="page" href={href(item)} data-page={given(item)} aria-current={item === shown() ? 'page' : undefined}) {item}
        if shown() < count()
          a(part="step" href={href(shown() + 1)} data-page={given(shown() + 1)} rel="next" aria-label={step ? nextLabel : undefined}) {words('next')}
        else
          span(part="step" aria-label={step ? nextLabel : undefined}) {words('next')}
      if sized()
        div(part="sizes" role="group" aria-label={sizeLabel})
          for size of sizes! key={size}
            a(part="size" href={sizeHref(base(), size, limitParam, param)} data-size={size} aria-current={size === pageSize ? 'true' : undefined}) {size}
if onPage || onSize
  // The island keeps the page on screen and hears the clicks, drawing this Pagination again inside itself without the handlers. Its props are not typed as this one's, and the casts keep `kay check` from reading this static component as handing an island a function: only an island renders it with a handler.
  PageClicks(whenPage={onPage as never} whenSize={onSize as never} of={of as never} page={page as never} offset={offset as never} pages={pages as never} total={total as never} pageSize={pageSize as never} limit={limit as never} more={more as never} url={url as never} param={param} siblings={siblings} step={step as never} sizes={sizes as never} limitParam={limitParam} sizeLabel={sizeLabel} rangeLabel={rangeLabel as never} label={label} previousLabel={previousLabel} nextLabel={nextLabel} rest={rest as never})
else
  {body()}
