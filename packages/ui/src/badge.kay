---
import type { JSX } from 'kay'
import type { IconProps } from 'kay/icons'
import { recipe } from 'kay'
import type { IconSlot } from './defaults'
import Icon from './icon.kay'

const look = recipe({
  parts: {
    root: 'kui-badge inline-flex items-center gap-1 border-solid bg-kui-surface0 px-kui-badge-x py-kui-badge-y text-kui-badge tracking-kui-badge whitespace-nowrap [border-color:var(--kui-badge-color,var(--color-border))] [border-width:var(--kui-border-badge)] [color:var(--kui-badge-color,var(--color-muted))] [font-family:var(--kui-badge-font,inherit)] [text-transform:var(--kui-badge-case)] data-stamp:bg-kui-stamp-fill data-stamp:px-2.5 data-stamp:py-1 data-stamp:font-mono data-stamp:text-[0.625rem]/[1.4] data-stamp:font-normal data-stamp:tracking-[0.14em] data-stamp:uppercase data-stamp:transition-colors data-stamp:duration-150 data-stamp:[border-color:var(--kui-badge-color,var(--color-kui-stamp))] data-stamp:[border-width:var(--kui-border-stamp)] data-stamp:[color:var(--kui-badge-color,var(--color-kui-stamp))] group-hover:data-stamp:bg-kui-stamp-fill-hover data-solid:[background-color:var(--kui-badge-color,var(--color-muted))] data-solid:[border-color:var(--kui-badge-color,var(--color-muted))] data-solid:[color:var(--kui-badge-solid-text,var(--color-accent-foreground))]',
    icon: 'size-3',
  },
  // A tone sets one variable that the base colours read, so no tone class has to beat a neutral colour of the base.
  variants: {
    tone: {
      neutral: '',
      accent: '[--kui-badge-color:var(--color-accent)]',
      success: '[--kui-badge-color:var(--color-success)]',
      warning: '[--kui-badge-color:var(--color-warning)]',
      danger: '[--kui-badge-color:var(--color-danger)]',
      info: '[--kui-badge-color:var(--color-info)]',
    },
  },
  defaults: { tone: 'neutral' },
})

const { tone = 'neutral', variant, icon, label, stamp = false, solid = false, ...rest } = props<Omit<JSX.IntrinsicElements['span'], 'class'> & {
  icon?: IconSlot | IconProps | undefined
  label?: string | number | undefined
  // `outline` is a hairline in the tone. `solid` is filled with the tone, its text in `--kui-badge-solid-text`. `stamp` is a rubber stamp: a hairline in its text colour, small spaced capitals, filled again while a `.group` holding it is hovered.
  variant?: 'outline' | 'solid' | 'stamp' | undefined
  // Deprecated since 1.72, `variant="stamp"` is it.
  stamp?: boolean | undefined
  // Deprecated since 1.72, `variant="solid"` is it.
  solid?: boolean | undefined
}>()

const stamped = () => variant === 'stamp' || (variant === undefined && stamp)
const filled = () => variant === 'solid' || (variant === undefined && solid)
---
// A label that does nothing: a count, a status, a tag.
span({...rest} data-tone={tone} data-stamp={stamped() ? '' : undefined} data-solid={filled() && !stamped() ? '' : undefined})
  if icon
    Icon(icon={icon} part="icon")
  | {label}
  slot
