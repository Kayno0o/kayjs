---
import type { JSX, Snippet } from 'kay'
import { effect, listen, onCleanup, persisted, recipe, signal, untrack } from 'kay'
import BareIconButton from './bare-icon-button.kay'
import Icon from './icon.kay'
import Dialog from './dialog.kay'
import type { IconProps } from 'kay/icons'
import type { Discard } from './confirm'
import type { IconSlot } from './defaults'
import type { OverlaySize } from './overlay'
import type { Size } from './size'
import type { Tone } from './tone'
import { followsHref } from './overlay'
import { wording } from 'kay/words'

// The panel is a Dialog with a side placement, which draws its root, head, title, body and footer; 'kui-side-panel' stays as the root's name for an app's CSS, and theme.css keeps the docked panel's shadow.
const look = recipe({
  parts: {
    root: '',
    grip: 'group/grip absolute z-[2] touch-none focus-visible:outline-2 focus-visible:outline-accent data-[dock=right]:inset-y-0 data-[dock=right]:-left-3 data-[dock=right]:w-6 data-[dock=right]:cursor-ew-resize data-[dock=bottom]:inset-x-0 data-[dock=bottom]:-top-3 data-[dock=bottom]:h-6 data-[dock=bottom]:cursor-ns-resize',
    line: 'pointer-events-none absolute bg-accent opacity-0 shadow-[0_0_0_1px_var(--color-popover)] group-[&:hover]/grip:opacity-100 group-focus-visible/grip:opacity-100 data-[dock=right]:inset-y-0 data-[dock=right]:left-[calc(50%-1px)] data-[dock=right]:w-0.5 data-[dock=bottom]:inset-x-0 data-[dock=bottom]:top-[calc(50%-1px)] data-[dock=bottom]:h-0.5',

    // The button a closed docked panel leaves in the corner, off the dev tool's docked drawer.
    launcher: 'fixed z-30 right-[calc(1rem+var(--kay-dev-inset-right,0px))] bottom-[calc(1rem+var(--kay-dev-inset-bottom,0px)+env(safe-area-inset-bottom,0px))] rounded-xl border border-solid border-border bg-popover text-foreground shadow-[0_0.5rem_2rem_rgb(0_0_0/0.25)]',
  },
})

const { open, trigger, title, label, heading, level = 2, actions, header, close, dirty = false, autosave = false, discard, footer, modal = true, closeHref, launcher, launcherHref, launcherLayer, launcherButton, launcherIcon, launcherOpenIcon, keep = false, onOpenChange, closeLabel = wording('ui.sidePanel.close', 'Close'), dock, size, sizeKey, onSizeChange, scrollKey, resizeLabel = wording('ui.sidePanel.resize', 'Resize'), style, ...rest } = props<Omit<JSX.IntrinsicElements['dialog'], 'open' | 'class' | 'title' | 'onClose' | 'onInput' | 'closedby' | 'closedBy' | 'style'> & {
  // Shows the panel along the edge, as a modal unless `modal` is false; the parent sets it back to false in `onOpenChange`. Left out, the panel keeps its own state, opened by `trigger` or its `launcher`.
  open?: boolean | undefined
  // Renders what opens the panel when `open` is left to the component: `@trigger(attributes)`, then `button({...attributes})`.
  trigger?: Snippet<[attributes: { 'onClick': () => void, 'aria-haspopup': 'dialog' }]> | undefined
  // The heading, and the panel's name for screen readers. A `@title` block draws markup in its place, such as an icon, a status badge or an emphasised name: the panel is then named by that heading's text, or by `label`.
  title: string | Snippet
  // The panel's name for screen readers when it differs from the visible title, such as a short name beside a `@title` full of markup.
  label?: string | undefined
  // @deprecated Use a `@title` block, with `label` for the string that named the panel; `deprecated-ui-props` rewrites it. Removed in 2.0.0.
  heading?: Snippet
  // The title's heading level.
  level?: 2 | 3 | 4 | 5 | 6 | undefined
  // Controls in the head line, before its close button, such as previous and next.
  actions?: Snippet
  // The whole head line in place of the title, `actions` and the close button.
  header?: Snippet
  // The close button in place of the library's own: it closes by `onOpenChange({ open: false })`, or by going to `closeHref`.
  close?: Snippet
  // Work the panel must not drop, such as a request in flight: a click outside, Escape and the close button leave it open. Typing is not that: it asks first, see `discard`.
  dirty?: boolean | undefined
  // What a modal panel asks (`confirm()`, `danger`) when Escape, a click outside or the close button would drop typed text: `{ title, message, confirmLabel, cancelLabel }` to word it, `false` to lock the close instead, as before 1.100. Not asked with `autosave`, or while `dirty`.
  discard?: Discard | undefined
  // Fields inside save as they are typed, so typing does not lock the close: a click outside and Escape close the panel as before anything was typed. `dirty` still locks it.
  autosave?: boolean | undefined
  footer?: Snippet
  closeLabel?: string | undefined
  // `false` shows the panel beside the page instead of over it: the page under it stays interactive, a click outside leaves it open and only Escape or the close control closes it. It renders open on the server, so a page driven by the URL shows it with no JavaScript.
  modal?: boolean | undefined
  // With `modal={false}`, a closed panel leaves a button of this label in the window's bottom right corner that opens it through `onOpenChange({ open: true })`, off the dev tool's drawer, and publishes the room it takes as `--kay-panel-right` for the dev tool's bar. Without it a closed panel leaves nothing.
  launcher?: string | undefined
  // The launcher's look, each part optional: its `icon` (`menu`) and `size`, `variant` (`ghost`) and `tone` as IconButton takes them, and `tooltip` for where the tooltip opens (`data-tooltip-placement`). Given an `openIcon` (or a `@launcherOpenIcon` block), the button stays on screen while the panel is open, draws that icon and closes the panel when pressed, named by `openLabel` then (the launcher's label by default) and carrying `aria-expanded`; the focus returns to it when the panel closes.
  launcherButton?: { icon?: IconSlot | IconProps | undefined, openIcon?: IconSlot | IconProps | undefined, openLabel?: string | undefined, size?: Size | undefined, variant?: 'solid' | 'ghost' | 'inline' | undefined, tone?: Tone | undefined, tooltip?: string | undefined } | undefined
  // Draws the launcher's icon, and its icon while the panel is open, in place of the names of `launcherButton`: `@launcherIcon` and `@launcherOpenIcon`.
  launcherIcon?: Snippet | undefined
  launcherOpenIcon?: Snippet | undefined
  // Keeps the head and the body rendered while the panel is closed, hidden with it, so what lives in them (a chat, a form half filled, a player) is not torn down and built again on each opening.
  keep?: boolean | undefined
  // Written after the component's own declarations, so it wins: a docked panel's `z-index` is set here. The launcher takes none of it, only `launcherLayer`.
  style?: string | undefined
  // The launcher's `z-index`, the one thing about it a parent sets; the launcher names the panel it opens through `aria-controls`, so a panel with an `id` is told apart from another one's.
  launcherLayer?: number | undefined
  // With `modal={false}`, docks the panel to this edge as a tool beside the page: fixed along the edge next to the dev tool's docked drawer, padding the page's `body` by its size, publishing it as `--kay-panel-right` or `-bottom` (for the dev tool's bar) and `--kui-dock-right` or `-bottom`, resized by a grip on its inner edge. Only its close control closes it, Escape does not. A fixed header across the top is cleared with `--kui-dock-top` on `html`.
  dock?: 'right' | 'bottom' | undefined
  // The width by name, as a Dialog's (`sm`, `md`, `lg`, `full`), or, with `dock`, the docked panel's width (right) or height (bottom) in px, kept within what the page and the panel need; 24rem or half the window when not given.
  size?: OverlaySize | number | undefined
  // Keeps the size the grip settled on in a cookie of this name, from one visit to the next, and draws it on the server, so the saved width shows from the first paint with no jump. A `size` given wins over it.
  sizeKey?: string | undefined
  // Called with the size the grip reached: `settled` is false while a drag is under way and true once it ends or a key moved it, so a parent keeps it then.
  onSizeChange?: ((event: { size: number, settled: boolean }) => unknown) | undefined
  resizeLabel?: string | undefined
  // When this value changes the body scrolls back to the top, for a panel kept in place (a `persist` island) while its content changes under it, as the next item of a list.
  scrollKey?: string | number | undefined
} & (
  // Makes the close control a link to this URL, for a panel open on the server whose close needs no JavaScript; the link navigates and `onOpenChange({ open: false })` is called as well, so its handler need not navigate. Without an `onOpenChange`, Escape follows it too, so a server page renders the panel with no island of its own. Such a panel's `launcher` is a link to `launcherHref`, which the types ask for, as nothing else could open it.
  | { closeHref: string, onOpenChange?: undefined, launcher?: undefined, launcherHref?: undefined }
  | { closeHref: string, onOpenChange?: undefined, launcher: string, launcherHref: string }
  // Called with `false` however the panel closes, a click outside and Escape included. Closed by either of those or its close button, its content is still there to read; closed by the parent, it is already gone. `launcherHref` makes the launcher a link too: the link navigates and `onOpenChange({ open: true })` is called as well.
  | { closeHref?: string | undefined, onOpenChange?: ((event: { open: boolean }) => unknown) | undefined, launcherHref?: string | undefined }
)>()

// A docked panel keeps the page this much of the window beside it, and itself at least its minimum.
const DOCKS = { right: { min: 280, page: 352, step: 24, fallback: 384 }, bottom: { min: 160, page: 160, step: 24, fallback: 0 } }

// The launcher's distance from the window's right edge, which what keeps off it counts too.
const LAUNCHER_GAP = 16

// The state of a panel the app leaves to the component: `open` wins when given. Every close, the guarded ones too, ends in the Dialog's `onOpenChange`, which comes here.
const inner = signal(false)
const isOpen = () => open ?? inner()

// A panel the app does not drive, whose close is a link: its Dialog keeps the state, so a navigation that keeps this instance resets it.
const ownState = () => open === undefined && followsHref(closeHref, onOpenChange)

function change(next: boolean) {
  if (open === undefined) {
    if (inner() === next)
      return

    inner = next
  }

  onOpenChange?.({ open: next })
}

// A launcher that stays while the panel is open is a toggle.
const staying = () => launcherOpenIcon !== undefined || launcherButton?.openIcon !== undefined

const opener = { 'onClick': () => change(true), 'aria-haspopup': 'dialog' } as const

function changed({ open: shown }: { open: boolean }) {
  change(shown)

  if (!shown && staying())
    queueMicrotask(() => launching()?.focus())
}

const docked = () => !modal && dock !== undefined
const room = signal({ width: 0, height: 0, right: 0, bottom: 0 })
const reached = signal<number>()
const launching = signal<HTMLElement>()
// 0 stands for no size kept yet.
const kept = sizeKey === undefined ? undefined : persisted.cookie<number>(sizeKey, 0)
const dragging = signal(false)
let panel: HTMLDialogElement | undefined
let frame = 0

// What another tool already holds along the edges, as the dev tool's docked drawer publishes it.
function measure() {
  const held = getComputedStyle(document.documentElement)
  const next = { width: window.innerWidth, height: window.innerHeight, right: Number.parseFloat(held.getPropertyValue('--kay-dev-inset-right')) || 0, bottom: Number.parseFloat(held.getPropertyValue('--kay-dev-inset-bottom')) || 0 }
  const now = room()

  if (next.width !== now.width || next.height !== now.height || next.right !== now.right || next.bottom !== now.bottom)
    room = next
}

function measureSoon() {
  if (frame !== 0 || !docked())
    return

  frame = requestAnimationFrame(() => {
    frame = 0
    measure()
  })
}

function limits(edge: 'right' | 'bottom') {
  const { min, page } = DOCKS[edge]
  const whole = edge === 'right' ? room().width - room().right : room().height - room().bottom

  // Before the window is measured, which the server cannot do, nothing bounds it.
  return { min, max: room().width === 0 ? Number.POSITIVE_INFINITY : Math.max(min, whole - page) }
}

function clamp(edge: 'right' | 'bottom', value: number) {
  const { min, max } = limits(edge)

  return Math.round(Math.max(min, Math.min(value, max)))
}

// The size on show: the parent's, else the one the grip reached, else the edge's own default.
function shownSize() {
  return dock === undefined ? 0 : clamp(dock, (dragging() ? reached() : undefined) ?? (typeof size === 'number' ? size : undefined) ?? (kept?.() || undefined) ?? reached() ?? (dock === 'right' ? DOCKS.right.fallback : room().height / 2))
}

function resizeTo(next: number, settled: boolean) {
  if (dock === undefined)
    return

  const clamped = clamp(dock, next)

  reached = clamped

  if (settled && kept)
    kept = clamped

  onSizeChange?.({ size: clamped, settled })
}

// Dragging the inner edge toward the page grows the panel.
function startResize(event: PointerEvent) {
  if (dock === undefined || !panel)
    return

  const handle = event.currentTarget as HTMLElement
  const box = panel.getBoundingClientRect()
  const from = dock === 'right' ? { point: event.clientX, size: box.width } : { point: event.clientY, size: box.height }
  const move = (next: PointerEvent) => {
    moved = true
    dragging = true
    resizeTo(from.size + from.point - (dock === 'right' ? next.clientX : next.clientY), false)
  }
  let ended = false
  let moved = false

  // A cancelled drag, as when the browser takes a touch over, ends it too, keeping the size it reached.
  const end = () => {
    if (ended)
      return

    ended = true
    handle.removeEventListener('lostpointercapture', end)
    handle.removeEventListener('pointermove', move)
    handle.removeEventListener('pointerup', end)
    handle.removeEventListener('pointercancel', end)
    const reachedSize = shownSize()

    dragging = false

    // A bare click on the grip settles nothing.
    if (moved)
      resizeTo(reachedSize, true)
  }

  event.preventDefault()
  handle.setPointerCapture?.(event.pointerId)
  handle.addEventListener('pointermove', move)
  handle.addEventListener('lostpointercapture', end)
  handle.addEventListener('pointerup', end)
  handle.addEventListener('pointercancel', end)
}

function resizeByKey(event: KeyboardEvent) {
  if (dock === undefined)
    return

  const step = DOCKS[dock].step * (event.shiftKey ? 4 : 1)
  const grow = dock === 'right' ? 'ArrowLeft' : 'ArrowUp'
  const shrink = dock === 'right' ? 'ArrowRight' : 'ArrowDown'
  const delta = event.key === grow ? step : event.key === shrink ? -step : 0

  if (delta === 0)
    return

  event.preventDefault()
  resizeTo(shownSize() + delta, true)
}

// A docked panel's geometry first, then the parent's own style.
function panelStyle() {
  if (!docked() || dock === undefined)
    return style

  const inset = 'right: var(--kay-dev-inset-right, 0px); bottom: var(--kay-dev-inset-bottom, 0px); max-width: none; max-height: none'
  const edge = dock === 'right'
    ? `top: var(--kui-dock-top, 0px); ${inset}; left: auto; width: ${shownSize()}px; height: auto`
    : `top: auto; ${inset}; left: 0; width: auto; height: ${shownSize()}px; border-left-width: 0; border-top-width: var(--border-width)`

  return [edge, style].filter(Boolean).join('; ')
}

// A shown docked panel makes room on the page and publishes what it holds, for the dev tool's bar and floating drawer to keep out of.
effect(() => {
  if (!docked() || dock === undefined || !isOpen())
    return

  const root = document.documentElement
  const edge = dock
  const px = `${shownSize()}px`

  root.dataset.kuiDock = edge
  root.style.setProperty(`--kay-panel-${edge}`, px)
  root.style.setProperty(`--kui-dock-${edge}`, px)
  onCleanup(() => {
    delete root.dataset.kuiDock
    // Another tool's own value on the shared variable stays.
    if (root.style.getPropertyValue(`--kay-panel-${edge}`) === px)
      root.style.removeProperty(`--kay-panel-${edge}`)

    root.style.removeProperty(`--kui-dock-${edge}`)
  })
})

// A docked dev tool pads the page, which the root's content shows at the side and its border box at the bottom.
effect(() => {
  if (!docked())
    return

  measure()

  const content = new ResizeObserver(measureSoon)
  const border = new ResizeObserver(measureSoon)

  content.observe(document.documentElement)
  border.observe(document.documentElement, { box: 'border-box' })
  onCleanup(() => {
    content.disconnect()
    border.disconnect()
    cancelAnimationFrame(frame)
    frame = 0
  })
})

// The launcher is a panel too, so the dev tool's bar and a floating drawer at the bottom right keep off it.
effect(() => {
  const button = launching()

  if (!button || isOpen())
    return

  const root = document.documentElement
  const width = button.offsetWidth

  if (width <= 0)
    return

  const px = `${width + LAUNCHER_GAP}px`

  root.style.setProperty('--kay-panel-right', px)
  // The panel shown again has set its own by then.
  onCleanup(() => root.style.getPropertyValue('--kay-panel-right') === px && root.style.removeProperty('--kay-panel-right'))
})

// The first value is the one the panel opens on.
let seenKey = untrack(() => scrollKey)

effect(() => {
  const next = scrollKey

  if (next === seenKey)
    return

  seenKey = next
  panel?.querySelector('[data-part=body]')?.scrollTo(0, 0)
})

listen(() => window, 'resize', measureSoon)

// A browser with `closedby` closes a non-modal panel on Escape, stacked with the layers above it. Without it the panel listens itself, and leaves an Escape that belongs to a modal dialog or an open popover.
listen(() => document, 'keydown', event => {
  if (event.key !== 'Escape' || modal || !isOpen() || event.defaultPrevented || event.isComposing || docked() || 'closedBy' in HTMLDialogElement.prototype)
    return

  if (!document.querySelector(':modal, :popover-open'))
    panel?.close()
})

---
if trigger && !ownState()
  | {trigger(opener)}
// Every way of closing it ends in the Dialog's `onOpenChange`, the close button included, so `changed` is the one place the parent learns of it.
Dialog({...rest} part="root head title body footer" placement="right" open={ownState() ? undefined : isOpen()} trigger={ownState() ? trigger : undefined} title={title} label={label} heading={heading} level={level} actions={actions} header={header} close={close} footer={footer} closeLabel={closeLabel} closeHref={closeHref} dirty={dirty} autosave={autosave} discard={discard} modal={modal} keep={keep} docked={docked()} data-dock={docked() ? dock : undefined} ref={element => { panel = element; rest.ref?.(element) }} size={typeof size === 'string' && !docked() ? size : undefined} style={panelStyle()} onOpenChange={followsHref(closeHref, onOpenChange) ? undefined : changed})
  @handle
    if isOpen() && docked() && dock then edge
      div(part="grip" role="separator" tabindex="0" aria-label={resizeLabel} aria-orientation={edge === 'right' ? 'vertical' : 'horizontal'} aria-valuenow={shownSize()} aria-valuemin={limits(edge).min} aria-valuemax={Number.isFinite(limits(edge).max) ? limits(edge).max : undefined} data-dock={edge} onPointerDown={startResize} onKeyDown={resizeByKey})
        span(part="line" data-dock={edge})
  slot
if !modal && launcher && (!isOpen() || staying())
  BareIconButton(part="launcher" label={isOpen() ? launcherButton?.openLabel ?? launcher : launcher} size={launcherButton?.size} variant={launcherButton?.variant ?? 'ghost'} tone={launcherButton?.tone} data-tooltip-placement={launcherButton?.tooltip} aria-controls={rest.id} aria-expanded={staying() ? isOpen() : undefined} style={launcherLayer === undefined ? undefined : `z-index: ${launcherLayer}`} ref={element => launching = element} href={launcherHref} onClick={() => change(!isOpen())})
    if isOpen() && launcherOpenIcon
      | {launcherOpenIcon}
    else if !isOpen() && launcherIcon
      | {launcherIcon}
    else
      Icon(icon={(isOpen() ? launcherButton?.openIcon : launcherButton?.icon) ?? 'menu'})
