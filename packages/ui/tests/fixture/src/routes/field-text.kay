---
import Combobox from '@kayjs/ui/combobox.kay'
import DateInput from '@kayjs/ui/date-input.kay'
import FormField from '@kayjs/ui/form-field.kay'
import Select from '@kayjs/ui/select.kay'
import Textarea from '@kayjs/ui/textarea.kay'
import TextInput from '@kayjs/ui/text-input.kay'
import '../app.css'

const options = [{ value: 'a', label: 'Alpha' }, { value: 'b', label: 'Beta' }]
---
main
  form#fields
    TextInput(aria-label="Name" name="name")
    TextInput(aria-label="Small" name="small" size="sm")
    Textarea(aria-label="Notes" name="notes")
    Select(aria-label="Letter" options={options} value="a")
    Combobox(label="Combo" options={options} value="a")
    DateInput(aria-label="Day" name="day" value="2026-10-21")
    FormField(label="Own")
      input(name="own")
