---
import { signal } from 'kay'
import Button from '@kayjs/ui/button.kay'
import SidePanel from '@kayjs/ui/side-panel.kay'

const open = signal(false)
---
Button(label="Show details" onClick={() => open = true})
SidePanel(open={open()} modal={false} title="Io" onOpenChange={() => open = false})
  p The page stays usable while this panel is open.
