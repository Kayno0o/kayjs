--- server
import { action } from 'kay'
import { contactForm } from '@kayjs/mail'

export const contact = action(...contactForm({ enqueue: async () => undefined as never }, { honeypot: 'nectar', consent: true }))
---
---
import ContactForm from '@kayjs/ui/contact-form.kay'
---
main
  ContactForm(action={contact} class={{ issues: 'mine-issues', issue: 'mine-issue', consentBox: 'mine-box' }})
