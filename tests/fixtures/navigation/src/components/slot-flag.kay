---
import type { Snippet } from 'kay'

const { side, note } = props<{ side?: Snippet, note?: Snippet }>()
---
div.slot-flag(data-side={side ? '' : undefined})
  span.slot-flag-label {side ? 'with' : 'without'}
  span.slot-flag-ternary {note ? note : 'no note'}
  if side as shown
    section.slot-flag-shown
      | {shown}
