---
import type { JSX } from 'kay'
import type { IconSlot } from './defaults'
import type { IconProps } from 'kay/icons'
import Icon from './icon.kay'

const { title, icon, actions, isEmpty = false, empty, class: className, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'title'> & {
  title?: string | undefined
  icon?: IconSlot | IconProps | undefined
  // The end of the head line: a link, a button, a row of actions.
  actions?: JSX.Element | undefined
  // Whether the data behind the widget is empty. With an `@empty` block, the frame and its head stay while the body shows the block; without one, an empty widget renders nothing at all.
  isEmpty?: boolean | undefined
  empty?: JSX.Element | undefined
  class?: string | undefined
}>()
---
// A dashboard tile: a framed body under a head line of icon, title and actions.
if empty !== undefined || !isEmpty
  .kui-widget({...rest} class={className})
    if title || icon || actions
      .kui-widget-head
        if icon
          Icon(icon={icon})
        if title
          h2.kui-heading-section.kui-widget-title {title}
        | {actions}
    if isEmpty
      | {empty}
    else
      slot
