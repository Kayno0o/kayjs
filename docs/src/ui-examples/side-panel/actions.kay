---
import { signal } from 'kay'
import Button from '@kayjs/ui/button.kay'
import IconButton from '@kayjs/ui/icon-button.kay'
import SidePanel from '@kayjs/ui/side-panel.kay'

const open = signal(false)
---
Button(label="Open panel" onClick={() => open = true})
SidePanel(open={open()} title="Moons" onOpenChange={() => open = false})
  @actions
    IconButton(icon="back" label="Previous" variant="ghost")
  p Io, Europa, Ganymede and Callisto.
