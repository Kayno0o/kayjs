---
import Stat from '@kayjs/ui/stat.kay'

// A tile under the `variant` of 1.96, beside the same tile under `layout`.
---
// kay-allow-file deprecated-ui-props
Stat#old-tile(value={12} label="moons" variant="tile")
Stat#new-tile(value={12} label="moons" layout="tile")
Stat#both(value={12} label="moons" layout="inline" variant="tile")
