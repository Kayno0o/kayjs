---
import Avatar from '@kaynooo/kayjs-ui/avatar.kay'
import Badge from '@kaynooo/kayjs-ui/badge.kay'
import Card from '@kaynooo/kayjs-ui/card.kay'
import Carousel from '@kaynooo/kayjs-ui/carousel.kay'
import EmptyState from '@kaynooo/kayjs-ui/empty-state.kay'
import Notice from '@kaynooo/kayjs-ui/notice.kay'
import Select from '@kaynooo/kayjs-ui/select.kay'
---
main
  Card#card(title="Moons")
    @head
      Badge(tone="success" icon="success" label={3})
    p Phobos and Deimos
  Card#bare(bare)
    p Edge to edge
  Card#outlined(title="Orbits" level={2})
    p Elliptic
  Badge#badge Draft
  Badge#solid(tone="success" solid label="<b>Done</b>")
  a.group#solid-stamp(href="/data")
    Badge(stamp solid label="Winner")
  a.group#stamped(href="/data")
    Badge(stamp label="Winner")
  EmptyState#empty(title="No moons" description="Add one to start")
  EmptyState#empty-action(title="No rockets")
    @actions
      a.go(href="/paging") Build one
  article#notice
    Notice(label="Saved")
  article#notice-error
    Notice(tone="danger" compact)
      | Could not save. #[a(href="/data") Retry]
  article#avatar
    Avatar(src="/ada.png" name="Ada" size="sm")
  article#avatar-initial
    Avatar(name=" grace" label="Grace")
  form#form
    Select(name="planet" value="earth" emptyOption="Any" options={[{ value: 'mars', label: 'Mars' }, { value: 'earth', label: 'Earth' }]})
  article#carousel
    Carousel(slides={[{ src: '/a.png', alt: 'Le jardin' }, { src: '/b.png', alt: 'La maison' }]} index={1} ratio="4 / 3" label="Galerie photos" slideLabel="{n} sur {count}" dotLabel="Aller à l'image {n}")
  article#lone-slide
    Carousel(slides={[{ src: '/a.png', alt: 'Le jardin' }]})
