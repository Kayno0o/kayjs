---
import type { EntryForm } from '../form'
import Badge from '@kaynooo/kayjs-ui/badge.kay'
import Button from '@kaynooo/kayjs-ui/button.kay'
import ConfirmDelete from '@kaynooo/kayjs-ui/confirm-delete.kay'
import { wording } from 'kay/words'
import { onPagePath } from '../listing'

// The Draft badge, or the Scheduled one for a published entry whose date is ahead, and the buttons of an entry's screen: Edit on page, Publish and Delete for a saved entry, Reset once edited, Save or Create. Meant for the header's slot.
const { form } = props<{ form: EntryForm }>()

const entry = form.stored
---
if form.isDraft()
  Badge(tone="warning" label={wording('cms.entry.draft', 'Draft')})
else if form.scheduled() as at
  Badge(tone="info" label={wording('cms.table.scheduled', 'Scheduled for {at}', { at })})
.kcms-entry-actions
  if entry
    if entry.url as url
      Button(href={onPagePath(form.prefix, url)} label={wording('cms.entry.editOnPage', 'Edit on page')})
    if form.isDraft()
      Button(label={wording('cms.entry.publish', 'Publish')} disabled={form.saving()} onClick={form.publish})
    ConfirmDelete(message={wording('cms.entry.deleteMessage', 'Delete this entry? This cannot be undone.')} failure={wording('cms.save.deleteFailure', 'Could not delete')} trigger="button" onConfirm={form.remove})
  if form.drafts.changed(form.entry)
    Button(label={wording('cms.entry.reset', 'Reset')} disabled={form.saving()} onClick={form.reset})
  Button(type="submit" label={form.saving() ? wording('cms.entry.saving', 'Saving…') : entry ? wording('cms.entry.save', 'Save') : wording('cms.entry.create', 'Create')} tone="accent" busy={form.saving()})
