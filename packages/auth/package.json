{
  "name": "@kaynooo/kay-auth",
  "type": "module",
  "version": "0.0.0",
  "description": "Auth for kay apps on kay sessions: OAuth, passwords, two-factor, magic links and bearer tokens",
  "author": "Kaynooo <https://git.kaynooo.fr/kaynooo>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://git.kaynooo.fr/kaynooo/kay-auth"
  },
  "bugs": {
    "url": "https://git.kaynooo.fr/kaynooo/kay-auth/issues"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/",
    "access": "restricted"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "llms.txt",
    "src",
    "types"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "check": "tsgo --noEmit",
    "build:types": "rm -rf types && tsgo -p tsconfig.build.json",
    "prepack": "bun run build:types",
    "postpack": "rm -rf types",
    "lint": "keslint --cache",
    "lint:fix": "keslint --fix --cache",
    "test": "bun test"
  },
  "peerDependencies": {
    "elysia": "^1.4.30",
    "kay": "*"
  },
  "dependencies": {
    "@kaynooo/utils": "^2.27.0"
  },
  "devDependencies": {
    "@kaynooo/eslint": "^6.0.1",
    "@types/bun": "^1.4.2",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "elysia": "^1.4.30",
    "kay": "link:@kaynooo/kay",
    "typescript": "^6.0.3"
  }
}
