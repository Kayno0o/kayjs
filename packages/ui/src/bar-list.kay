--- <Row extends BarListRow>
import type { JSX } from 'kay'
import type { BarListRow } from './plot'
import { memo } from 'kay'
import { wording } from 'kay/words'

const { rows, onSelect, emptyLabel, empty, class: className, ...rest } = props<Omit<JSX.IntrinsicElements['ul'], 'class' | 'children' | 'onSelect'> & {
  rows: Row[]
  // Makes every row a button handing back the row it was pressed on.
  onSelect?: ((row: Row) => void) | undefined
  // What the list reads with no rows.
  emptyLabel?: string | undefined
  // Deprecated: use `emptyLabel`, which wins when both are given.
  empty?: string | undefined
  class?: string | undefined
}>()

// The catalogs' `ui.barList.empty` key of the old prop is still read, after the new `ui.barList.emptyLabel`.
const nothing = () => emptyLabel ?? empty ?? wording('ui.barList.emptyLabel', wording('ui.barList.empty', 'No data yet.'))

const largest = memo(() => Math.max(0, ...rows.map(row => row.value)))

// Each bar's length against the largest value, so the largest row fills its track.
const percent = (row: Row) => largest() > 0 ? Math.max(0, row.value) / largest() * 100 : 0
---
if rows.length === 0
  // The app's id and class stay on whichever element shows.
  p.kui-bar-list-empty(id={rest.id} class={className}) {nothing()}
else
  ul.kui-bar-list({...rest} class={className})
    for row of rows key={row.key}
      li
        if onSelect
          button.kui-bar-list-row(type="button" data-interactive onClick={() => onSelect?.(row)})
            span.kui-bar-list-label {row.label}
            span.kui-bar-list-value {row.display ?? row.value}
            span.kui-bar-list-track
              span.kui-bar-list-fill(style={`width: ${percent(row)}%`})
        else
          .kui-bar-list-row
            span.kui-bar-list-label {row.label}
            span.kui-bar-list-value {row.display ?? row.value}
            span.kui-bar-list-track
              span.kui-bar-list-fill(style={`width: ${percent(row)}%`})
