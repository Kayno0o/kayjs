--- server
import { t } from 'elysia'
import { action } from 'kay'

// Each post costs the browser a challenge; `gated` lets a form posted without JavaScript through on its stamp, `faked` answers a wrong solution as sent.
export const solve = action({ input: t.Object({ message: t.String({ maxLength: 200 }) }), protect: { proofOfWork: 500 } }, ({ message }) => message.length)
export const gated = action({ input: t.Object({ message: t.String({ maxLength: 200 }) }), protect: { proofOfWork: 500, minTime: '1s' } }, ({ message }) => message.length)
export const faked = action({ input: t.Object({ message: t.String({ maxLength: 200 }) }), protect: { proofOfWork: { difficulty: 500, ttl: '1h', pretend: true } }, messages: { proofOfWork: reason => `${reason}!` } }, ({ message }) => message.length)

const failure = solve.form.failed() ?? gated.form.failed() ?? faked.form.failed()
const solved = solve.status() === 'ready'
const passed = gated.status() === 'ready'
const sent = faked.status() === 'ready'
---
form(action={solve})
  input(name="message" aria-label="Message")
  button Send
form(action={gated})
  input(name="message" aria-label="Message")
  button Send
form(action={faked})
  input(name="message" aria-label="Message")
  button Send
if failure
  p.error {failure.status} {Object.values(failure.errors).join(' ')}
if solved
  p.solved Solved {solve.data()}
if passed
  p.passed Passed {gated.data()}
if sent
  p.sent Sent {faked.data()}
