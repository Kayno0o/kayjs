---
import Player from '../components/player.kay'
import { Tone } from '../tone'

Tone.provide('layout')
--- server
const page = ctx.url.pathname
// A page whose layout sets nothing on `<html>`.
const bare = page === '/later'
---
head
  html(class={bare ? undefined : 'served'} data-theme={bare ? undefined : 'light'})
nav
  a.home(href="/") Home
  a.second(href="/second") Second
  a.later(href="/later") Later
  a.reload(href="/plain" data-reload) Plain
  a.whole(href="/whole") Whole
  a.isolated(href="/isolated") Isolated
ul#side(style="height: 40px; overflow-y: auto; margin: 0")
  li(style="height: 400px") Side
div#drawer(popover) Drawer
Player(persist page={page})
slot
