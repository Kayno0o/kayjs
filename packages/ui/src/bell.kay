---
import type { PopoverPlacement } from './popover'
import BellInbox from './bell-inbox.kay'

const { label, placement } = props<{
  // Names the button and the list it opens; the `ui.bell.label` message by default.
  label?: string | undefined
  placement?: PopoverPlacement | undefined
}>()
---
// `inbox` is typed only where `ui()` is installed, so it is read through a cast (kaynooo/kayjs#2037), which also makes a page reaching the Bell load every ctx key rather than only `inbox`.
// A signed-in visitor's notifications, with the unread count: nothing at all for anyone else, and no JavaScript for them.
if (ctx as { inbox?: boolean }).inbox
  BellInbox(label={label} placement={placement})
