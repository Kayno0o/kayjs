---
import { recipe } from 'kay'
import type { JSX, Snippet } from 'kay'

const look = recipe({
  parts: {
    root: 'kui-page-header flex flex-col gap-2',
    head: 'flex flex-wrap items-center gap-4',
    title: 'm-0 text-xl [font-weight:var(--font-weight-kui-heading,var(--font-weight-semibold))] tracking-label text-foreground [font-family:var(--font-label,var(--font-kui-body,inherit))] [text-transform:var(--label-case)]',
    meta: 'flex flex-wrap items-center gap-2 text-sm text-muted',
    actions: 'flex flex-wrap items-center gap-2 border-l border-border pl-4',
    description: 'm-0 text-sm text-muted',
  },
})

const { title, meta, description, actions, ...rest } = props<Omit<JSX.IntrinsicElements['header'], 'class' | 'title'> & {
  // The page's one `h1`.
  title: string
  // Beside the title: a badge, a count, a link back.
  meta?: Snippet
  // Under the title's line: a sentence saying what the page holds.
  description?: string | undefined
  // After the title, past a divider: a `+` Button, a link, a row of controls.
  actions?: Snippet
}>()
---
// The head of a page: its title, the actions on the whole page, and under them its description and what the children add.
header({...rest})
  div(part="head")
    h1(part="title") {title}
    if meta
      div(part="meta")
        | {meta}
    if actions
      div(part="actions")
        | {actions}
  if description
    p(part="description") {description}
  slot
