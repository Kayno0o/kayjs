---
import type { MenuEntry, RangeValue } from '@kaynooo/kayjs-ui'
import FileDrop from '@kaynooo/kayjs-ui/file-drop.kay'
import Menu from '@kaynooo/kayjs-ui/menu.kay'
import MultiSelect from '@kaynooo/kayjs-ui/multi-select.kay'
import RangeInput from '@kaynooo/kayjs-ui/range-input.kay'

// What the test reads back: each change, set of files and action, as it happened.
const { onRange, onPlanets, onFiles, onAction, paste = false } = props<{ onRange: (value: RangeValue) => void, onPlanets: (value: string[]) => void, onFiles: (names: string[]) => void, onAction: (name: string) => void, paste?: boolean }>()

const PLANETS = ['mercury', 'venus', 'earth', 'mars', 'jupiter', 'saturn', 'uranus', 'neptune', 'pluto'] as const
const planets = PLANETS.map(planet => ({ value: planet, label: planet[0]!.toUpperCase() + planet.slice(1) }))

// Typed by the options, so the control hands back their values' own type.
function pickPlanets(picked: (typeof PLANETS)[number][]) {
  onPlanets(picked)
}

const items: MenuEntry[] = [
  { label: 'Rename', onSelect: () => onAction('rename') },
  { label: 'Archive', disabled: true, onSelect: () => onAction('archive') },
  'separator',
  { label: 'Delete', icon: 'delete', danger: true, onSelect: () => onAction('delete') },
]
---
RangeInput#range(label="Hours" min={0} max={24} onChange={onRange})
MultiSelect(id="planets" label="Planets" name="planet" options={planets} onChange={pickPlanets})
FileDrop#drop(accept="image/*, .svg" paste={paste} onFiles={files => onFiles(files.map(file => file.name))})
  @content(zone)
    button#pick(type="button" onClick={zone.open}) {zone.dragging() ? 'Drop it' : 'Pick'}
Menu(items={items} label="Actions" icon="plus" class="row-actions")
input#field(aria-label="Field")
