--- server
import { t } from 'elysia'
import { action } from 'kay'

export const send = action(t.Object({ message: t.String({ maxLength: 200 }) }), ({ message }) => message.length, { rateLimit: { max: 2, window: '1m' }, honeypot: 'website' })
// Refused in the site's own language.
export const write = action(t.Object({ message: t.String({ maxLength: 2000 }) }), ({ message }) => message.length, { rateLimit: { max: 1, window: '1m' }, honeypot: 'website', maxSize: '1kb', messages: { honeypot: 'Laissez ce champ vide', rateLimit: wait => `Réessayez dans ${wait} s`, maxSize: bytes => `${bytes} octets au plus` } })

const failure = send.failed()
const sent = send.succeeded()
---
form(action={send})
  input(name="message" aria-label="Message")
  button Send
if failure
  p.error {failure.status} {Object.values(failure.errors).join(' ')}
if sent
  p.sent Sent {sent.data}
