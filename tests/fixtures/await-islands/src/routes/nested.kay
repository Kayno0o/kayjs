--- server
async function* parts() {
  for (const text of ['one', 'two', 'three']) {
    await Bun.sleep(250)
    yield text
  }
}

const reply = parts()
--- script
import Outer from '../components/outer.kay'
---
h1 Parts
// kay-allow uncaught-await
await reply
  p.pending Waiting
  Outer(text="pending")
then text
  Outer(text={text})
