--- module
// The launcher is on every page and the address of none: its panel keeps its state across page swaps, and the chat inside loads when the browser is idle. A conversation kept on the server is named by the browser.
export const island = { persist: true, hydrate: 'idle' } as const
--- island
import type { Component, Snippet } from 'kay'
import type { ChatLauncherIcons } from './types'
import Chat from './chat.kay'
import Panel from './chat-panel.kay'

import Icon from '@kaynooo/kayjs-ui/icon.kay'

type IconValue = typeof Icon extends Component<infer Props> ? Props extends { icon: infer Value } ? Value : never : never
type ChatProps = typeof Chat extends Component<infer Props> ? Props : never

const { icons, turn, actions, call, source, empty, footer, note, openLabel, closeLabel, open, onOpenChange, hash, onSend, onReply, onStop, onError, onToolCall, onRegenerate, onEdit, onSuggestion, suggestions, newLabel, expandLabel, collapseLabel, remember, class: className, ...chat } = props<Omit<ChatProps, 'class' | 'links' | 'remember' | 'conversationIn' | 'newButton' | 'onSend' | 'onReply' | 'onStop' | 'onError' | 'onToolCall' | 'onRegenerate' | 'onEdit' | 'onSuggestion' | 'suggestions' | 'turn' | 'actions' | 'call' | 'source' | 'empty' | 'footer'> & {
  // The text of the button while the panel is closed and while it is open; `Open the chat` and `Close the chat` by default. The chat's `label` heads the panel.
  openLabel?: string | undefined
  closeLabel?: string | undefined
  // Opens and closes the panel when the app sets it, such as an "Ask the assistant" button elsewhere on the page, or to close it after a navigation; left out, the button and Escape work on their own. `onOpenChange(open)` is called when the visitor opens or closes it, so the app's state follows.
  open?: boolean | undefined
  onOpenChange?: ((open: boolean) => unknown) | undefined
  // The address fragment that opens the panel, on load and when it changes to it, so a plain `<a href="#chat">` opens it; `#chat` by default, `false` for none. A `kai:chat-open` event on the document opens it too.
  hash?: string | false | undefined
  // The tab's session storage key the conversation is kept under, so a reload finds it; none by default, as the next visitor to use the tab would read it. A site with sign-in gives one per visitor.
  remember?: string | undefined
  // What the round buttons draw, by name, in place of the library's own, as `Chat` takes them, with the panel's `open`, `close`, `expand` and `collapse` besides.
  icons?: ChatLauncherIcons | undefined
  // What the chat hears and the questions it offers, as `Chat` takes them: the callbacks, and `suggestions` as a list or a function.
  onSend?: ChatProps['onSend']
  onReply?: ChatProps['onReply']
  onStop?: ChatProps['onStop']
  onError?: ChatProps['onError']
  onToolCall?: ChatProps['onToolCall']
  onRegenerate?: ChatProps['onRegenerate']
  onEdit?: ChatProps['onEdit']
  onSuggestion?: ChatProps['onSuggestion']
  suggestions?: ChatProps['suggestions']
  // The chat's blocks, as `Chat` takes them: its turns, the buttons under a turn, a tool call, a cited source, the empty chat and a footer under the form.
  turn?: ChatProps['turn']
  actions?: ChatProps['actions']
  call?: ChatProps['call']
  source?: ChatProps['source']
  empty?: ChatProps['empty']
  footer?: ChatProps['footer']

  // Names and tooltips of those buttons: `New conversation`, `Enlarge the chat` and `Shrink the chat`.
  newLabel?: string | undefined
  expandLabel?: string | undefined
  collapseLabel?: string | undefined
  // A line under the chat, such as a warning that its answers can be wrong.
  note?: Snippet
  // On the button and panel's wrapper.
  class?: string | undefined
}>()

const iconOf = (name: keyof ChatLauncherIcons, fallback: string) => (icons?.[name] ?? fallback) as IconValue

// The blocks the app gave, passed on to the chat. A function the app gives reaches the chat only from an island of the app's own (`--- island`): from a static page `kay check` reports it as `island-prop`, and the render fails naming the prop.
function forwarded() {
  const given: Pick<ChatProps, 'turn' | 'actions' | 'call' | 'source' | 'empty' | 'footer' | 'onSend' | 'onReply' | 'onStop' | 'onError' | 'onToolCall' | 'onRegenerate' | 'onEdit' | 'onSuggestion' | 'suggestions'> = {}

  if (onSend) given.onSend = onSend
  if (onReply) given.onReply = onReply
  if (onStop) given.onStop = onStop
  if (onError) given.onError = onError
  if (onToolCall) given.onToolCall = onToolCall
  if (onRegenerate) given.onRegenerate = onRegenerate
  if (onEdit) given.onEdit = onEdit
  if (onSuggestion) given.onSuggestion = onSuggestion
  if (suggestions) given.suggestions = suggestions

  if (turn) given.turn = turn
  if (actions) given.actions = actions
  if (call) given.call = call
  if (source) given.source = source
  if (empty) given.empty = empty
  if (footer) given.footer = footer

  return given
}

// What the app set of the panel's opening, as getters so a change of `open` reaches the panel; a function passed to the panel by name would be sent whether the app gave one or not.
function opening() {
  return {
    get open() { return open },
    get onOpenChange() { return onOpenChange },
    get hash() { return hash },
  }
}
---
Panel({...opening()} label={chat.label} openLabel={openLabel} closeLabel={closeLabel} newLabel={newLabel} expandLabel={expandLabel} collapseLabel={collapseLabel} class={className})
  @icon
    Icon(icon={iconOf('open', 'chat')})
  @closeIcon
    Icon(icon={iconOf('close', 'close')})
  @newIcon
    Icon(icon={iconOf('new', 'plus')})
  @expandIcon
    Icon(icon={iconOf('expand', 'expand')})
  @collapseIcon
    Icon(icon={iconOf('collapse', 'collapse')})
  Chat({...chat} {...forwarded()} icons={icons} remember={remember} links="here" conversationIn="browser")
  if note
    .kai-launcher-note
      | {note}
