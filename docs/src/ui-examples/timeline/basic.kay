---
import { signal } from 'kay'
import type { TimelineEntry } from '@kayjs/ui'
import Timeline from '@kayjs/ui/timeline.kay'

const picked = signal<string | undefined>('lunch')
const entries: TimelineEntry[] = [
  { key: 'home', time: '08:00 - 09:10', label: 'At home', icon: 'info' },
  { key: 'gap', time: '09:10 - 09:40', label: 'Nothing reported', tone: 'neutral', pickable: false },
  { key: 'lunch', time: '12:15 - 13:30', label: 'Lunch', icon: 'info', tone: 'success' },
]
---
.flex.flex-col.gap-2.max-w-md
  Timeline(entries={entries} label="Today" selected={picked()} onSelectedChange={picked.set})
  p Picked: {picked() ?? 'nothing'}.
