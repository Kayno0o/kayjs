--- island
import Accordion from '@kaynooo/kayjs-ui/accordion.kay'

const items = [
  { key: 'lens', label: 'Lens', open: true },
  { key: 'mount', label: 'Mount', open: true },
]
---
Accordion(items={items} multiple)
  @panel(value)
    p {value === 'lens' ? '70 mm, f/10.' : 'Alt-azimuth, with a tripod.'}
