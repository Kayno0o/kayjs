---
import { signal } from 'kay'

const { run } = props<{ run: (input: { name: string }) => Promise<{ ok: true, data: string } | { ok: false }> }>()
const answer = signal('')
---
button.show(type="button" onClick={async () => {
  const result = await run({ name: 'Zoe' })

  if (result.ok)
    answer = result.data
}}) Show
p.untyped {answer()}
