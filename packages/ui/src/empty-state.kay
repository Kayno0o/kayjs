---
import type { JSX, Snippet } from 'kay'

const { title, level, description, actions, class: className, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'title' | 'children'> & {
  title: string
  // Makes the title a heading of that level, `1` for an empty state standing for the whole page, such as a 404; without it, a paragraph under the page's own heading.
  level?: 1 | 2 | 3 | 4 | 5 | 6 | undefined
  description?: string | undefined
  // Below the description: a button or a link leading out of the empty list, such as the one that adds the first item.
  actions?: Snippet
  class?: string | undefined
}>()
---
.kui-empty-state({...rest} class={className})
  if level === 1
    h1.kui-empty-state-title {title}
  else if level === 2
    h2.kui-empty-state-title {title}
  else if level === 3
    h3.kui-empty-state-title {title}
  else if level === 4
    h4.kui-empty-state-title {title}
  else if level === 5
    h5.kui-empty-state-title {title}
  else if level === 6
    h6.kui-empty-state-title {title}
  else
    p.kui-empty-state-title {title}
  if description
    p.kui-empty-state-description {description}
  if actions
    .kui-empty-state-actions
      | {actions}
