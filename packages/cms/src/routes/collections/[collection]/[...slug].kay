--- server
import EmptyState from '@kaynooo/kayjs-ui/empty-state.kay'
import { s } from 'kay'
import { wording } from 'kay/words'
import EntryEditor from '../../../components/entry-editor.kay'
import EntryHeader from '../../../components/entry-header.kay'
import { adminTitle, collectionTitle, entryTitle } from '../../../listing'
import { entryPresence } from '../../../presence'
import { entryScreen, entryTranslations } from '../../../screens'

export const page = { query: s.Object({ locale: s.Optional(s.String()), compare: s.Optional(s.String()) }) }

const screen = await entryScreen({ collection: ctx.params.collection, slug: ctx.params.slug, locale: ctx.query.locale }) ?? ctx.notFound()
const { prefix, collection } = screen
const entry = collection.problem === undefined ? screen.entry ?? ctx.notFound() : undefined
const presence = entry ? await entryPresence(ctx, collection.name, entry) : undefined
const translations = entry ? await entryTranslations(collection, entry, ctx.query.compare) : undefined
const title = collectionTitle(collection)
const name = ctx.query.locale === undefined ? ctx.params.slug : `${ctx.params.slug} (${ctx.query.locale})`
---
head
  title {adminTitle(collection.single ? title : `${entry ? entryTitle(collection, entry) : name} - ${title}`)}
if entry
  EntryEditor(prefix={prefix} collection={collection} entry={entry} presence={presence} translations={translations})
else
  EntryHeader(prefix={prefix} collection={collection} title={name})
  EmptyState(title={wording('cms.admin.collectionUnreadable', 'This collection cannot be read')} description={collection.problem})
