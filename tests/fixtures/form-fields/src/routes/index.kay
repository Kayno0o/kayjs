--- server
import { t } from 'elysia'
import { action } from 'kay'

export const edit = action(t.Object({
  title: t.String({ minLength: 3, maxLength: 40, error: 'Too short' }),
  done: t.Optional(t.Boolean()),
  size: t.String({ maxLength: 10 }),
  note: t.Optional(t.String({ maxLength: 200 })),
}), (_input, ctx) => ctx.deny(409, { message: 'Taken' }))

const todo = { title: 'Buy milk', done: true, size: 'm', note: 'hello' }
--- script
import FormField from '../components/form-field.kay'
---
form(action={edit} values={todo})
  label(field="title") Name
  FormField(label="Title" field="title")
    input
  FormField(label="Done" field="done")
    input(type="checkbox")
  FormField(label="Size" field="size")
    select
      option(value="s") Small
      option(value="m") Medium
  label(field="note") Note
  textarea(field="note")
  FormField(label="Own" field="title")
    input(name="other")
  button Save
