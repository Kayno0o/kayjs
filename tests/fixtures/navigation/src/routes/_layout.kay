---
import Player from '../components/player.kay'
import { Tone } from '../tone'

Tone.provide('layout')
---
--- server
const page = ctx.url.pathname
---
nav
  a.home(href="/") Home
  a.second(href="/second") Second
  a.later(href="/later") Later
  a.reload(href="/plain" data-reload) Plain
Player(persist page={page})
slot
