--- server
import { t } from 'elysia'
import { action } from 'kay'

export const check = action(t.Object({
  name: t.String({ minLength: 3 }),
}), () => undefined)
--- script
import { signal } from 'kay'

const count = signal(0)
---
form(action={check})
  input(field="name")
  button Check
button.bump(type="button" onClick={() => count.set(count() + 1)}) {count()}
