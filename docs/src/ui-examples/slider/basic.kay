---
import Slider from '@kaynooo/kayjs-ui/slider.kay'

const delay = signal(200)
const saved = signal(200)
---
.flex.max-w-sm.flex-col.gap-2
  Slider(
    label="Delay"
    min={0}
    max={500}
    step={10}
    name="delay"
    value={delay()}
    formatValue={value => `${value} ms`}
    onInput={delay.set}
    onChange={saved.set}
  )
  p.text-sm Let go at {saved()} ms
