---
import type { JSX, Snippet } from 'kay'
import { listen, recipe, signal } from 'kay'
import { acceptsFile } from './accept'

// 'kui-file-drop' stays as the component's name for an app's CSS and the skins; the border colour reads --kui-control-line, which a skin sets.
const look = recipe({
  parts: {
    root: 'kui-file-drop flex flex-col items-center justify-center gap-3 border-dashed border-(length:--kui-border-width) p-6 text-center transition-colors [border-color:var(--kui-control-line,var(--color-kui-surface2))] data-compact:flex-row data-compact:justify-start data-compact:p-3 data-compact:text-left data-disabled:opacity-50 data-dragging:border-kui-accent data-dragging:bg-kui-accent/10',
    input: 'hidden',
  },
})

const { accept, multiple = false, paste = false, disabled = false, size = 'md', compact = false, onFiles, onReject, content, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'children' | 'role'> & {
  // The files the zone takes, as an `accept` attribute: the picker filters on it, and dropped or pasted files that miss it are ignored.
  accept?: string | undefined
  multiple?: boolean | undefined
  // Also takes files pasted anywhere on the page, unless the paste lands in a text field.
  paste?: boolean | undefined
  disabled?: boolean | undefined
  // `sm` is a slim row, its content from the left, to sit inline beside other fields rather than as a large target of its own.
  size?: 'sm' | 'md' | undefined
  // Deprecated since 1.72, `size="sm"` is it.
  compact?: boolean | undefined
  // The files picked, dropped or pasted: one unless `multiple`, and never an empty list.
  onFiles: (files: File[]) => unknown
  // The files dropped or picked that were left out, those missing `accept` and, without `multiple`, the matching ones beyond the first, so the page can say why; never called for pasted files, which may be anything on the clipboard.
  onReject?: ((files: File[]) => unknown) | undefined
  // What the zone shows: `@content(zone)`, where `zone.open()` opens the picker and `zone.dragging()` reads whether files hover the zone.
  content: Snippet<[zone: { open: () => void, dragging: () => boolean }]>
}>()

const dragging = signal(false)
let input: HTMLInputElement | undefined

function open() {
  input?.click()
}

// Built in the script, where `dragging` is still the signal: the template would hand the slot its value.
const zone = { open, dragging }

function take(files: Iterable<File>, reporting = true): boolean {
  const all = [...files]
  const matching = all.filter(file => acceptsFile(accept, file))
  const taken = multiple ? matching : matching.slice(0, 1)

  if (disabled)
    return false

  if (reporting && taken.length < all.length)
    onReject?.(all.filter(file => !taken.includes(file)))

  if (taken.length === 0)
    return false

  onFiles(taken)

  return true
}

function carriesFiles(event: DragEvent): boolean {
  return event.dataTransfer?.types.includes('Files') ?? false
}

function dragOver(event: DragEvent) {
  if (disabled || !carriesFiles(event))
    return

  event.preventDefault()
  dragging.set(true)
}

// Leaving for a child of the zone is no leaving at all, which is what made the highlight flicker over a zone with content.
function dragLeave(event: DragEvent) {
  if (!(event.currentTarget as HTMLElement).contains(event.relatedTarget as Node | null))
    dragging.set(false)
}

function drop(event: DragEvent) {
  const files = event.dataTransfer?.files

  dragging.set(false)

  if (!files?.length)
    return

  event.preventDefault()
  take(files)
}

function picked(event: Event) {
  const picker = event.currentTarget as HTMLInputElement

  take(picker.files ?? [])
  // Cleared, so picking the same file again still reports it.
  picker.value = ''
}

function pasted(event: ClipboardEvent) {
  const target = event.target instanceof Element ? event.target : null

  if (target?.closest('input, textarea, [contenteditable]'))
    return

  if (take(event.clipboardData?.files ?? [], false))
    event.preventDefault()
}

listen(() => paste ? window : undefined, 'paste', pasted)
---
div(part="root" {...rest} role="group" data-compact={size === 'sm' || compact || undefined} data-dragging={dragging() || undefined} data-disabled={disabled || undefined} onDragOver={dragOver} onDragLeave={dragLeave} onDrop={drop})
  input(part="input" ref={element => input = element} type="file" tabindex="-1" aria-hidden="true" accept={accept} multiple={multiple} disabled={disabled} onChange={picked})
  | {content(zone)}
