---
import type { JSX } from 'kay'
import { recipe } from 'kay'

// 'kui-tooltip-target' stays as the component's name for an app's CSS.
const look = recipe({ parts: { root: 'kui-tooltip-target' } })

const { text, placement, ...rest } = props<Omit<JSX.IntrinsicElements['span'], 'class' | 'tabindex'> & {
  // What the tooltip says, shown by TooltipHost as the pointer or the keyboard lands on the element. Without one the span is plain text, no tab stop.
  text?: string | undefined
  // Where it sits, as a CSS `position-area`: `top` by default, or `bottom`, `left`, `right`.
  placement?: string | undefined
}>()
---
// Text carrying a tooltip, which the keyboard reaches as the pointer does: a `span` with `data-tooltip` alone is not a tab stop.
span(part="root" {...rest} tabindex={text ? '0' : undefined} data-tooltip={text || undefined} data-tooltip-placement={placement})
  slot
