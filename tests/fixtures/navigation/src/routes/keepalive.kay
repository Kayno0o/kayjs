--- server
import { t } from 'elysia'
import { action } from 'kay'

// What the page saved as it went away, which the browser test reads back from the server's own process.
export const noteDown = action(t.Object({ text: t.String({ maxLength: 100000 }) }), ({ text }) => {
  const seen = ((globalThis as { keptByPagehide?: string[] }).keptByPagehide ??= [])

  seen.push(text.length > 100 ? `long:${text.length}` : text)

  return text
})
--- script
import Saver from '../components/saver.kay'
---
head
  title Keepalive
h1 Keepalive
Saver
