--- server
import { s, action } from 'kay'

// The wording is async and reads the error and the page's locale, as one loading an address kept in a collection would.
export const loud = action(s.Object({}), () => {
  throw new Error('mail down')
}, { messages: { serverError: async (error, ctx) => `${ctx.locale}: ${(error as Error).message}` } })

export const mute = action(s.Object({}), () => {
  throw new Error('mail down')
}, { messages: { serverError: () => {
  throw new Error('words down')
} } })

export const blank = action(s.Object({}), () => {
  throw new Error('mail down')
}, { messages: { serverError: () => '  ' } })
---
form(action={loud})
  button Send
form(action={mute})
  button Mute
form(action={blank})
  button Blank
if loud.form.error()
  p.error {loud.form.error()}
if mute.form.error()
  p.error {mute.form.error()}
if blank.form.error()
  p.error {blank.form.error()}
