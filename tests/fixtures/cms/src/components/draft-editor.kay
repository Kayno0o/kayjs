---
import type { DraftEntry, EditorProps } from 'kay/edit'
import { signal } from 'kay'
import { showDraft } from 'kay/edit'
import './draft-editor.css'

// The editor the test extension gives, which every page renders in edit mode.
const { entries, unclickable } = props<EditorProps>()

const clicks = signal(0)
const issues = signal('')
const show = async (entries: DraftEntry[]) => issues.set(JSON.stringify((await showDraft(entries)).issues ?? []))
const draft = async (data: unknown, body?: string) => show([{ collection: 'news', slug: 'launch', data, body }])
---
button.count(onClick={() => clicks.set(n => n + 1)}) Clicked {clicks()}
button.draft(onClick={async () => draft({ title: 'Draft title', published: true, tags: ['draft'] }, '## Drafted')}) Draft
button.refused(onClick={async () => draft({ title: 3, published: true, tags: [] })}) Refused
button.mixed(onClick={async () => show([{ collection: 'news', slug: 'roadmap', data: { title: 3, published: true, tags: [] } }, { collection: 'news', slug: 'launch', data: { title: 'Mixed title', published: true, tags: [] } }])}) Mixed
button.slow(onClick={async () => draft({ title: 'Slow draft', published: true, tags: [] })}) Slow
p.issues {issues()}
input.title(aria-label="Title" onInput={async kayEvent => draft({ title: kayEvent.currentTarget.value, published: true, tags: [] })})
ul.unclickable
  for field of unclickable
    li {field.collection}:{field.slug}:{field.path}{field.frozen ? ' (frozen)' : ''}
ul.edited
  for entry of entries
    li {entry.collection}:{entry.slug}{entry.locale === undefined ? '' : `@${entry.locale}`}
