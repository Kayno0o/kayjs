---
import type { JSX } from 'kay'
import type { IconChoice } from './icon-picker'
import { batch, effect, flush, onCleanup, signal } from 'kay'
import Icon from './icon.kay'
import IconButton from './icon-button.kay'
import { nameOf } from './icon-picker'

const PAGE_SIZE = 50
const DEBOUNCE_MS = 200

const { search, value = '', name, onChange, class: className, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'children' | 'onChange'> & {
  // The icons matching `query`, at most `limit` of them: typically an action, since a whole icon set is too large to ship. A rejection goes unhandled and leaves the last grid on screen.
  search: (query: string, limit: number) => Promise<IconChoice[]>
  // The chosen icon's name, or an empty string for none; a picker whose parent passes another follows it.
  value?: string | undefined
  // Submits the chosen icon's name under this name, for a picker inside a form.
  name?: string | undefined
  // Hands over a pick, or an empty string for a cleared one.
  onChange?: ((name: string) => void) | undefined
  class?: string | undefined
}>()

const picked = signal(value)
const typed = signal('')
const query = signal('')
const limit = signal(PAGE_SIZE)
const icons = signal<IconChoice[]>([])
const pending = signal(true)
// The last pick, whose icon the selection keeps drawing once a new search no longer finds it.
const last = signal<IconChoice>()
let hidden: HTMLInputElement | undefined
let request = 0

effect(() => picked.set(value))

effect(() => {
  const next = typed()
  // A new search starts back on its first page; the same one, such as on the first run, keeps the pages shown.
  const timer = setTimeout(() => next !== query() && batch(() => {
    query.set(next)
    limit.set(PAGE_SIZE)
  }), DEBOUNCE_MS)

  onCleanup(() => clearTimeout(timer))
})

effect(() => void load(query(), limit()))

// The last grid stays on screen while the next search is in flight, and only the latest search lands.
async function load(needle: string, count: number) {
  const mine = ++request

  pending.set(true)

  try {
    const found = await search(needle, count)

    if (mine === request)
      icons.set(found)
  }
  finally {
    if (mine === request)
      pending.set(false)
  }
}

const chosen = () => icons().find(choice => choice.name === picked())?.icon ?? (last()?.name === picked() ? last()?.icon : undefined)

function pick(next: string) {
  picked.set(next)
  onChange?.(next)

  if (!hidden)
    return

  // A pick types nothing, so once the hidden input holds it, an `input` event tells the form, as typing would.
  flush()
  hidden.dispatchEvent(new Event('input', { bubbles: true }))
}

function choose(choice: IconChoice) {
  last.set(choice)
  pick(picked() === choice.name ? '' : choice.name)
}

// Enter in the search box has nothing to confirm, since the grid follows the typing; left alone, it would submit the whole form.
function keepEnter(event: KeyboardEvent) {
  if (event.key === 'Enter')
    event.preventDefault()
}
---
.kui-icon-picker({...rest} class={className})
  if name
    input(type="hidden" name={name} value={picked()} ref={element => hidden = element})
  input.kui-field-input(type="search" placeholder="Search icons…" aria-label="Search icons" value={typed()} onInput={event => typed.set(event.currentTarget.value)} onKeyDown={keepEnter})
  ul.kui-icon-grid(aria-label="Icons" aria-busy={pending() ? 'true' : undefined})
    for choice of icons() key={choice.name}
      li
        button.kui-icon-grid-option(type="button" aria-label={nameOf(choice.name)} data-tooltip={nameOf(choice.name)} aria-pressed={picked() === choice.name ? 'true' : 'false'} onClick={() => choose(choice)})
          Icon(icon={choice.icon})
    if icons().length === 0
      li.kui-icon-grid-empty {pending() ? 'Searching…' : 'No icons found.'}
  .kui-icon-grid-bar
    if picked()
      span.kui-icon-grid-selection(aria-live="polite")
        if chosen() as icon
          Icon(icon={icon})
        | {nameOf(picked())}
        IconButton(icon="close" label="Clear icon selection" size="xs" variant="inline" class="kui-icon-grid-clear" onClick={() => pick('')})
    if icons().length >= limit()
      button.kui-icon-grid-more(type="button" onClick={() => limit.set(limit() + PAGE_SIZE)}) Show more
