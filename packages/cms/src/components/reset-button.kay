---
import Button from '@kaynooo/kayjs-ui/button.kay'
import ConfirmDelete from '@kaynooo/kayjs-ui/confirm-delete.kay'
import { wording } from 'kay/words'

// Drops the edits typed so far once confirmed, as nothing brings them back; disabled while there is nothing to drop or a save is on its way.
const { disabled = false, onReset } = props<{ disabled?: boolean, onReset: () => void }>()
---
if disabled
  Button(label={wording('cms.entry.reset', 'Reset')} disabled)
else
  ConfirmDelete(tone="neutral" trigger="button" label={wording('cms.entry.reset', 'Reset')} message={wording('cms.entry.resetMessage', 'Drop your unsaved changes? They cannot be brought back.')} failure={wording('cms.entry.resetFailure', 'Could not reset')} onConfirm={onReset})
