---
import type { Component, Snippet } from 'kay'
const { opts = {}, fmt = v => String(v), size = 'md', list = [], Icon, Wrap, items } = props<{
  opts?: { a?: number }
  fmt?: (v: number) => string
  size?: 'sm' | 'md'
  list?: string[]
  Icon: Component<{ n?: string }>
  Wrap: Component<{ children?: Snippet }>
  items: Component<{ n?: string }>[]
}>()
const n: number = opts.a ?? 0
const s: 'sm' | 'md' = size
const l: string[] = list
type Row = typeof l[number]
const first: Row | undefined = l[0]
---
p {opts.a} {fmt(1)} {size} {n} {s} {l.length} {first}
Icon(n={size})
Wrap
  p {size}
for Item of items key={Item}
  Item(n={size})
for word of list key={word}
  p {(word.length as typeof word.length).toFixed()} {[size] satisfies (typeof size)[]}
if opts.a as a
  p {[a] satisfies Array<typeof a>}
