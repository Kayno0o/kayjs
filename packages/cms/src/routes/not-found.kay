--- server
import Button from '@kaynooo/kayjs-ui/button.kay'
import EmptyState from '@kaynooo/kayjs-ui/empty-state.kay'
import Notice from '@kaynooo/kayjs-ui/notice.kay'
import PageSection from '@kaynooo/kayjs-ui/page-section.kay'
import { underKayDev } from 'kay/library'
import { wording } from 'kay/words'
import AddedRedirects from '../components/added-redirects.kay'
import ConfigRedirects from '../components/config-redirects.kay'
import MissingPaths from '../components/missing-paths.kay'
import { forbidden, may } from '../access'
import { adminTitle } from '../listing'
import { readMissing } from '../missing'
import { screenPath } from '../paths'
import { settings } from '../settings'

// The missing pages are where redirects are made.
if (!await may(ctx, 'redirects'))
  forbidden(ctx, 'redirects')

const { prefix } = settings()
const screen = readMissing()
const records = 'production server records the pages visitors asked for and found nothing at.'
const hint = underKayDev() ? wording('cms.missing.devHint', `kay dev counts nothing: the ${records}`) : wording('cms.missing.emptyHint', `The ${records}`)
---
head
  title {adminTitle(wording('cms.missing.title', 'Missing pages'))}
PageSection(title={wording('cms.missing.title', 'Missing pages')} level={1})
  @actions
    Button(href={screenPath(prefix)} label={wording('cms.admin.content', 'Content')})
  if 'failure' in screen
    EmptyState(title={wording('cms.missing.unreadable', 'Missing pages cannot be listed')} description={screen.failure})
  else
    Notice(tone="info" label={wording('cms.missing.notice', 'The pages visitors asked for and found nothing at, most visited first, as the production server counted them. Paths a redirect answers are left out. Add a suggested redirect here and it answers at once, say a path is gone (410), or dismiss it from the list; or copy it into the redirects of kay.config.ts, or run kay not-found --redirect with the path.')})
    if screen.total > screen.rows.length
      Notice(tone="warning" label={wording('cms.missing.truncated', 'Showing the {shown} most visited of {total} paths.', { shown: screen.rows.length, total: screen.total })})
    MissingPaths(rows={screen.rows} hint={hint})
    if screen.added.length > 0
      PageSection(title={wording('cms.redirects.title', 'Redirects added here')} level={2})
        AddedRedirects(redirects={screen.added})
    if screen.configured.length > 0
      PageSection(title={wording('cms.redirects.configTitle', 'Redirects in kay.config.ts')} level={2})
        ConfigRedirects(redirects={screen.configured})
