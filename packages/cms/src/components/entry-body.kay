---
import type { FormScope } from '../form'
import { guardLeave } from 'kay'
import FormField from '@kaynooo/kayjs-ui/form-field.kay'
import MarkdownEditor from '@kaynooo/kayjs-ui/markdown-editor.kay'
import { wording } from 'kay/words'
import { uploadFile, uploading } from '../editor/upload'
import { BODY } from '../markers'
import { fieldId } from '../paths'

// The Markdown body of an entry whose collection has one.
const { form } = props<{ form: FormScope }>()

// An image dropped or pasted into the body is an upload too.
guardLeave(uploading)

// Read from the form as it changes: a screen holds it from the server, the on-page editor once its own question is answered.
const uploadRefused = () => form.denied?.upload
const layout = form.collection.layout?.form

effect(() => {
  onCleanup(form.shown.add('#body'))
})
---
if form.collection.body
  .kcms-field(data-kcms-body id={fieldId(form.entry, 'b')})
    FormField(label={layout?.body?.label ?? wording('cms.entry.body', 'Body')} hint={layout?.body?.hint} issue={form.drafts.issues(form.entry, BODY)[0]?.message})
      MarkdownEditor(toolbar={layout?.toolbar} value={String(form.drafts.value(form.entry, BODY) ?? '')} onInput={text => form.drafts.set(form.entry, BODY, text)} onImage={uploadRefused() === undefined ? async file => (await uploadFile(form.entry.collection, file)).path : undefined})
