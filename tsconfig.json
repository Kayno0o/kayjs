{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "kay",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "kay": ["./packages/kay/src/index.ts"],
      "kay/*": ["./packages/kay/src/*"],
      "@kayjs/icons": ["./packages/plugin-icons/src/index.ts"],
      "@kayjs/images": ["./packages/plugin-images/src/index.ts"],
      "@kayjs/seo": ["./packages/plugin-seo/src/index.ts"],
      "@kayjs/mail": ["./packages/plugin-mail/src/index.ts"],
      "@kayjs/ui": ["./packages/ui/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "packages/*/tests", "bench-app"]
}
