--- server
import { direction, formatList, formatNumber, formatRelativeTime, T, t } from 'kay/i18n'
import Counter from '../components/counter.kay'

export const prerender = true

const greeting = t('greeting', { name: 'Ada' })
const none = t('items', { count: 0 })
const one = t('items', { count: 1 })
const many = t('items', { count: 1234 })
const price = formatNumber(1234.5, { style: 'currency', currency: 'EUR' })
const saved = t('saved', { date: new Date(Date.UTC(2026, 9, 4, 12)) })
const now = Date.UTC(2026, 9, 4, 12)
const ago = [formatRelativeTime(now - 3 * 86_400_000, { now }), formatRelativeTime(now - 86_400_000, { now }), formatRelativeTime(now + 90 * 60_000, { now }), formatRelativeTime(2, 'week')].join(' / ')
const listed = formatList(['Ada', 'Grace', 'Linus'])
const written = `${direction()} ${direction('ar')}`
const { locale } = ctx
---
h1 {greeting}
p.items {none} / {one} / {many}
p.price {price}
p.saved {saved}
p.locale {locale}
p.ago {ago}
p.listed {listed}
p.direction {written}
p.intro
  T(key="intro" name="<Ada>")
    @about(text)
      strong {text}
    @docs(text)
      em {text}
Counter
