--- server
import { t } from 'elysia'
import { action } from 'kay'

export const add = action({ input: t.Object({ title: t.String({ minLength: 1 }) }), tool: true }, ({ title }) => title)
--- script
import Counter from '../components/counter.kay'
---
h1 Home
form(action={add})
  input(name="title")
  button Add
Counter
