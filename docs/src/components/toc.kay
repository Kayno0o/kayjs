---
import { onCleanup, onMount, signal } from 'kay'

const { sections } = props<{ sections: { id: string, text: string, depth: number }[] }>()
const current = signal(sections[0]?.id ?? '')

// The section being read is the last whose heading has scrolled past the top fifth of the window.
function spy() {
  const line = window.innerHeight / 5
  let reading = sections[0]?.id ?? ''

  for (const section of sections) {
    const heading = document.getElementById(section.id)

    if (heading && heading.getBoundingClientRect().top <= line)
      reading = section.id
  }

  current.set(reading)
}

onMount(() => {
  spy()
  window.addEventListener('scroll', spy, { passive: true })
})

onCleanup(() => window.removeEventListener('scroll', spy))
---
nav.toc(aria-label="On this page")
  p.toc-title On this page
  ul
    for section of sections key={section.id}
      li(class={{ sub: section.depth > 2 }})
        a(href={`#${section.id}`} aria-current={section.id === current() ? 'location' : undefined}) {section.text}
