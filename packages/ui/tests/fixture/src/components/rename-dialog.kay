---
import type { Action } from 'kay'
import { signal } from 'kay'
import FormDialog from '@kayjs/ui/form-dialog.kay'

const { action } = props<{ action: Action<{ name: string }, string> }>()
const open = signal(true)
---
FormDialog#dialog(open={open()} title="Rename" action={action} submitLabel="Rename" failureLabel="Could not rename" onOpenChange={() => open = false})
  input(name="name" value="Ada")
