--- island
import TreeView from '@kayjs/ui/tree-view.kay'

// A tree under the node keys before 1.100, which still draws; a cast keeps the `deprecated-ui-item-keys` lint from rewriting them.
function old<T>(items: unknown): T {
  return items as T
}
const nodes = old<{ id: string, label: string, children?: { id: string, label: string }[] }[]>([{ id: 'root', label: 'Root', children: [{ id: 'leaf', label: 'Leaf' }] }])
---
TreeView#tree(label="Files" nodes={nodes} expanded={['root']} selected="leaf")
