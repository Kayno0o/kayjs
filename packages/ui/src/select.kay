--- <Value extends string | number, Empty extends string | boolean | undefined = undefined>
import type { JSX } from 'kay'
import { untrack } from 'kay'
import { controlledValue } from './controlled-value'
import { startRef } from './form-reset'
import { word } from './words'

const { value, options, onChange, submit = false, emptyOption, loading = false, loadingLabel = word('select.loadingLabel', 'Loading…'), class: className, ...rest } = props<Omit<JSX.IntrinsicElements['select'], 'value' | 'options' | 'class' | 'children' | 'onChange'> & {
  // One of the options' values, or the empty string once there is an `emptyOption`.
  value: Value | (Empty extends string | true ? '' : never)
  options: readonly { value: Value, label: string }[]
  // Handed the option's own value, a number for a number option, or the empty string for the `emptyOption`.
  onChange?: ((value: Value | (Empty extends string | true ? '' : never)) => void) | undefined
  // Submits the form holding it once an option is picked, after `onChange`: a GET filter form then needs no ref to itself.
  submit?: boolean | undefined
  // A first option worth the empty string: a string is its label, `true` leaves it blank.
  emptyOption?: Empty
  // Shows a disabled row saying the options are on their way.
  loading?: boolean | undefined
  loadingLabel?: string | undefined
  class?: string | undefined
}>()

let box: HTMLSelectElement | undefined

// The options carry the value to the select, so only what the app last handed is kept; a reset that changes the select has the app's `onChange` told, without submitting.
const { heard } = controlledValue({ box: () => box, value: () => String(value), write: false, report: select => report(select) })

function report(select: HTMLSelectElement) {
  heard(select.value)

  const choice = options.find(option => String(option.value) === select.value)

  // No option matches only the empty one, which the type allows exactly when there is one.
  onChange?.(choice === undefined ? '' as never : choice.value)
}

function picked(select: HTMLSelectElement) {
  report(select)

  if (submit)
    select.form?.requestSubmit()
}

const ref = startRef<HTMLSelectElement>(element => box = element, rest.ref)
---
// Each option says whether it is selected, so the right one stays chosen when the options arrive after the value.
select.kui-field-input({...rest} ref={ref} class={className} onChange={event => picked(event.currentTarget)})
  if emptyOption !== undefined && emptyOption !== false
    option(value="") {typeof emptyOption === 'string' ? emptyOption : ''}
  if loading
    option(value="" disabled) {loadingLabel}
  for choice of options key={choice.value}
    option(ref={element => element.toggleAttribute('selected', untrack(() => String(choice.value) === String(value)))} value={choice.value} selected={String(choice.value) === String(value)}) {choice.label}
