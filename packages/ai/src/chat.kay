---
import type { Action, ActionStream, Failure, SanitizeOptions, Snippet } from 'kay'
import type { ChatMessage, CodeBlock, Message, Progress, Source, ToolCall } from './types'
import { ActionError, effect, onCleanup, onMount, recipe, sanitizeHtml, signal, trustHtml, untrack } from 'kay'
import BareIconButton from '@kaynooo/kayjs-ui/bare-icon-button.kay'
import FileDrop from '@kaynooo/kayjs-ui/file-drop.kay'
import Icon from '@kaynooo/kayjs-ui/icon.kay'
import Notice from '@kaynooo/kayjs-ui/notice.kay'
import Textarea from '@kaynooo/kayjs-ui/textarea.kay'
import { isHeldMarkdown, markdownHtml } from 'kay/markdown'
import { wording } from 'kay/words'
import { approvalMessage, ticketsIn, withoutApproval } from './approval-marker'
import { MARK, MARKED, withoutMarker } from './marker'
import { REPLACES_HEADER, REPLY_HEADER } from './resume'
import { attribute, linkSources, opensApart, REL_APART, sameSources, usableSources } from './chat-sources'
import { filesOf, keepPending, newReplyId, pendingReply, posted, POSTED_CHARACTERS, restored, shrunk, stored } from './chat-history'
import Calls from './chat-calls.kay'
import Sources from './chat-sources.kay'
import './chat.css'

// The chat's own classes are its parts, so an app restyles them from src/ui.ts or a `class` object. The table of a reply is built as a string and keeps its class.
const look = recipe({
  parts: { root: 'kai-chat', empty: 'kai-chat-empty', greeting: 'kai-chat-greeting', suggestions: 'kai-chat-suggestions', suggestion: 'kai-chat-suggestion', log: 'kai-chat-log', turn: 'kai-chat-turn', text: 'kai-chat-text kui-prose', thinking: 'kai-chat-text kai-chat-thinking', reasoning: 'kai-chat-reasoning', reasoningText: 'kai-chat-reasoning-text', note: 'kai-chat-note', status: 'kai-chat-status', disclosure: 'kai-chat-disclosure', form: 'kai-chat-form', field: 'min-h-10 max-h-40 rounded-[1.25rem] px-3.5 leading-normal focus-visible:[outline:2px_solid_var(--kai-chat-accent,var(--color-accent))] focus-visible:outline-offset-2', editField: 'min-h-10 max-h-40 rounded-[1.25rem] px-3.5 leading-normal focus-visible:[outline:2px_solid_var(--kai-chat-accent,var(--color-accent))] focus-visible:outline-offset-2', actions: 'kai-chat-actions', regenerate: 'kai-chat-action', edit: 'kai-chat-action', save: 'kai-chat-save kui-btn', cancel: 'kai-chat-cancel kui-btn', send: 'kai-chat-send', new: 'kai-chat-new', retry: 'kui-btn', approval: 'kai-chat-approval', approvalText: 'kai-chat-approval-text', allow: 'kui-btn', deny: 'kui-btn', attach: 'kai-chat-attach', files: 'kai-chat-files', file: 'kai-chat-file', remove: 'kai-chat-file-remove' },
  variants: {
    // The form: `bubble` frames the visitor's messages, `plain` draws them as bare text.
    variant: { bubble: '', plain: '' },
    // `accent` colours the send button and the visitor's bubble, `neutral` draws them in the text colour.
    tone: { accent: '', neutral: '' },
    // The type scale of the turns and the suggestions.
    size: { sm: '', md: '', lg: '' },
  },
  defaults: { variant: 'bubble', tone: 'accent', size: 'md' },
})

// What a reply keeps of markdown: no image, which a model reading a hostile page could point at a URL carrying the conversation, and no task checkbox. Tables stay.
const REPLY: SanitizeOptions = { tags: ['table', 'thead', 'tbody', 'tr', 'th', 'td'] }
// How close to the end of the log the visitor must be for new text to keep it scrolled down.
const PINNED_PX = 48
// How long a page that announced it was leaving is waited on before it is taken to have stayed.
const LEAVING_MS = 2000
// The opening tag `sanitizeHtml` writes for a link, which `linksOpenApart` rewrites: the two change together. The href is captured to tell a link of this site from another.
const SANITIZED_LINK = /<a href="([^"]*)" rel="nofollow ugc">/g

// The images and documents a model reads.
const ATTACHABLE = 'image/png,image/jpeg,image/gif,image/webp,application/pdf'

interface Turn extends Message {
  id: number
  // A reply the visitor stopped, or one whose stream broke off, cut where it was.
  stopped?: boolean | undefined
  // The tools the reply called, when the action streams `reply.progress()`.
  calls?: ToolCall[] | undefined
  // The reply's code blocks the server highlighted.
  code?: CodeBlock[] | undefined
  // What the model thought before answering, when the action streams `reply.progress()` and the provider sends it.
  reasoning?: string | undefined
}

const { action, initial = [], label = wording('ai.chat.label', 'Chat'), placeholder = wording('ai.chat.placeholder', 'Write a message…'), sendLabel = wording('ai.chat.send', 'Send'), stopLabel = wording('ai.chat.stop', 'Stop'), retryLabel = wording('ai.chat.retry', 'Try again'), thinkingLabel = wording('ai.chat.thinking', 'Thinking…'), sourcesLabel = wording('ai.chat.sources', 'Sources'), reasoning = true, reasoningLabel = wording('ai.chat.reasoning', 'Reasoning'), stoppedLabel = wording('ai.chat.stopped', 'Stopped'), errorMessage = wording('ai.chat.error', 'The reply failed.'), keep = 20, maxChars = POSTED_CHARACTERS, tableLabel = wording('ai.chat.table', 'Table'), toolDetails = true, greeting = wording('ai.chat.greeting', 'How can I help?'), disclosure = wording('ai.chat.disclosure', 'You are talking to an AI. Your messages are sent to its provider to answer.'), suggestions = [], toolLabels = {}, sendIcon, stopIcon, newButton = false, newLabel = wording('ai.chat.new', 'New conversation'), newIcon, remember, links = 'apart', runningLabel = wording('ai.chat.running', 'Running'), doneLabel = wording('ai.chat.done', 'Done'), failedLabel = wording('ai.chat.failed', 'Failed'), argumentsLabel = wording('ai.chat.arguments', 'Arguments'), resultLabel = wording('ai.chat.result', 'Result'), approvalLabel = wording('ai.chat.approval', 'Needs your approval'), allowLabel = wording('ai.chat.allow', 'Allow'), denyLabel = wording('ai.chat.deny', 'Deny'), allowedLabel = wording('ai.chat.allowed', 'Allowed:'), deniedLabel = wording('ai.chat.denied', 'Denied:'), attach = false, accept = ATTACHABLE, maxFiles = 4, maxFileSize = 5 * 1024 * 1024, attachLabel = wording('ai.chat.attach', 'Attach a file'), removeLabel = wording('ai.chat.remove', 'Remove'), attachRefusedLabel = wording('ai.chat.attachRefused', 'Only images and PDFs can be attached.'), attachTooBigLabel = wording('ai.chat.attachTooBig', 'That file is too big to attach.'), attachFullLabel = wording('ai.chat.attachFull', 'No more files can be attached.'), attachIcon, regenerate = false, editable = false, regenerateLabel = wording('ai.chat.regenerate', 'Regenerate the reply'), editLabel = wording('ai.chat.edit', 'Edit the message'), saveLabel = wording('ai.chat.save', 'Save and send'), cancelLabel = wording('ai.chat.cancel', 'Cancel'), editEmptyLabel = wording('ai.chat.editEmpty', 'Write a message to send.'), regenerateIcon, editIcon, fill = false, variant = 'bubble', tone = 'accent', size = 'md' } = props<{
  // The page's streaming action, `action(schema, ({ messages }) => ask(messages))`, which may also `ctx.fail`; the chat posts the latest messages to it and reads the reply as it streams.
  // Returning `ask(messages, { tools }).progress()` instead streams the tool calls as well, which the chat shows before the text of their turn.
  action: Action<{ messages: ChatMessage[] }, AsyncIterable<string | Progress> | Failure<unknown>>
  // The messages shown to start with.
  initial?: Pick<Message, 'content' | 'role' | 'sources'>[] | undefined
  // Names the message list and the field for screen readers.
  label?: string | undefined
  placeholder?: string | undefined
  sendLabel?: string | undefined
  stopLabel?: string | undefined
  retryLabel?: string | undefined
  // Said, and read out, while the first words of a reply are awaited.
  thinkingLabel?: string | undefined
  // The title of the list of cited sources under a reply.
  sourcesLabel?: string | undefined
  // Marks a reply cut short by Stop.
  stoppedLabel?: string | undefined
  // How many of the latest messages each send posts, so the history never outgrows the action's `maxItems`; the history posted opens on a user message, so an assistant one at its start is left out.
  keep?: number | undefined
  // The most characters each send posts, the oldest messages leaving first; the chat lowers it by itself when the action answers 413, so it is only set to avoid that first refusal.
  maxChars?: number | undefined
  // Names a table of a reply, which scrolls sideways inside its bubble when it is wider; a reply with several numbers them, `Table 1`, `Table 2`.
  tableLabel?: string | undefined
  // Whether the model's thinking is shown, folded under `reasoningLabel`, above the reply it came before; false hides it. A reply whose provider sends none shows nothing either way.
  reasoning?: boolean | undefined
  reasoningLabel?: string | undefined
  // Whether each tool call opens to its arguments and result, shown as plain text; false shows its name and status only.
  toolDetails?: boolean | undefined
  // Said in the empty chat above the suggestions.
  greeting?: string | undefined
  // The line under the log telling the visitor they talk to an AI and that their messages are sent to a provider; word it for your provider or in your language, and `''` hides it when the page says so itself.
  disclosure?: string | undefined
  // Questions offered in the empty chat; a click sends one.
  suggestions?: string[] | undefined
  // What the tools of a reply are called in the one line they fold into, by tool name such as `{ search_docs: 'Searched the docs' }`; a tool without one shows its own name, and a tool called more than once adds `x2`.
  toolLabels?: Record<string, string> | undefined
  // What the send and stop buttons draw, in place of an arrow and a square.
  sendIcon?: Snippet
  stopIcon?: Snippet
  // The status of a tool call, and the names of its two parts.
  runningLabel?: string | undefined
  doneLabel?: string | undefined
  failedLabel?: string | undefined
  argumentsLabel?: string | undefined
  resultLabel?: string | undefined
  // A tool that changes something waits for the visitor: the line naming it (`Needs your approval`), its two buttons, and the start of the message each posts (`Allowed:` then the tool and its arguments, `Denied:` then the tool).
  approvalLabel?: string | undefined
  allowLabel?: string | undefined
  denyLabel?: string | undefined
  allowedLabel?: string | undefined
  deniedLabel?: string | undefined
  // Shown when the call is refused or the stream breaks off.
  errorMessage?: string | undefined
  // Shows a button beside the field, once the log holds a turn, which starts the conversation over as `ChatPanel`'s header button does: a reply under way stops, and the log, the field and the kept history are cleared. `newLabel` names it and `@newIcon` replaces its plus.
  newButton?: boolean | undefined
  newLabel?: string | undefined
  newIcon?: Snippet
  // A name under which the conversation is kept in the tab's session storage, so a reload of the tab finds it again; the tool calls of the replies are not kept. Without it, a reload starts afresh.
  remember?: string | undefined
  // Where a link of a reply opens: `apart` in a new tab, so following it does not swap the page and drop a conversation that lives in it; `here` for a link of this site opens in place, for a chat that survives a swap (kept by `persist`, or by `remember`), while a link to another site still opens apart.
  links?: 'apart' | 'here' | undefined
  // Lets the visitor attach images and PDFs to a message, by a button beside the field, by dropping on it or by pasting, and posts them with the history as `attachments` of each message, which the action's schema must take: `attachments: s.Optional(s.Array(s.File({ type: 'image/png' })))` per type, and a `maxSize` on the action. Off by default.
  attach?: boolean | undefined
  // The types the picker takes, as an `accept` attribute: images and PDFs a model reads by default.
  accept?: string | undefined
  // The most files one message holds (4) and the most bytes of each (5 MB).
  maxFiles?: number | undefined
  maxFileSize?: number | undefined
  // The attach button's name and tooltip, the name of each file's remove button, and what a refused file says: a type that is not accepted, a file past `maxFileSize` and a message already holding `maxFiles`.
  attachLabel?: string | undefined
  removeLabel?: string | undefined
  attachRefusedLabel?: string | undefined
  attachTooBigLabel?: string | undefined
  attachFullLabel?: string | undefined
  // What the attach button draws, in place of a plus.
  attachIcon?: Snippet
  // Shows a button under the last reply, once nothing is under way, which drops it and asks again from the message before it; the action reads `replaces()` to drop the reply it stored. Not offered for an answer to a held tool call, whose approval is spent.
  regenerate?: boolean | undefined
  // Shows a button on each message of the visitor, which turns it into a field to change and send again: that message and every turn after it leave the log and the history, and the action reads `replaces()` to drop them from what it stored. Its files stay.
  editable?: boolean | undefined
  // The buttons' names and tooltips, and the two buttons of the field an edit opens. Each message's edit button adds the start of the message to `editLabel`, `Edit the message: Hello`, so no two share a name. `editEmptyLabel` is said when Save finds no text and no file.
  regenerateLabel?: string | undefined
  editLabel?: string | undefined
  saveLabel?: string | undefined
  cancelLabel?: string | undefined
  editEmptyLabel?: string | undefined
  // What the regenerate and edit buttons draw, in place of a circular arrow and a pencil.
  regenerateIcon?: Snippet
  editIcon?: Snippet
  // Fills the height of its container, which the app gives a height (a flex column, a grid row or a fixed one): the log takes the space and scrolls, the greeting sits above the form, and the form stays at the bottom, as the launcher's panel does. Without it the log grows to 32rem and scrolls past it.
  fill?: boolean | undefined
}>()

let nextId = 0
const history = signal<Turn[]>(untrack(() => initial).map(({ sources, ...message }) => ({ ...message, ...sources && { sources: usableSources(sources) }, id: nextId++ })))
const draft = signal('')
// The files chosen for the next message, and why one was left out.
const attached = signal<File[]>([])
const attachProblem = signal<string | undefined>(undefined)
// The call is out and no word of the reply is there yet.
const waiting = signal(false)
const streaming = signal<ActionStream<string | Progress> | undefined>(undefined)
// The reply so far, which becomes a turn of the history once the stream ends.
const partial = signal('')
// What the model has thought so far in the reply being written.
const thought = signal('')
// The tool calls of the reply being written, as last seen.
const calls = signal<ToolCall[]>([])
// The code blocks of the reply being written that the server highlighted so far.
const code = signal<CodeBlock[]>([])
// The documents the reply being written cites, as last seen.
const found = signal<Source[]>([])
// What the status line said of the calls, one line each and added to it, since a line replaced before the screen reader reads it is lost.
const spoken = signal<{ id: number, text: string }[]>([])
const failure = signal<string | undefined>(undefined)
// The last call was refused and its message taken back, so no message waits for an answer that Try again could ask for.
const takenBack = signal(false)
// The message being edited, and what the field holds.
const editing = signal<number | undefined>(undefined)
const editDraft = signal('')
// Why Save sent nothing, shown in the field's turn until the visitor types.
const editProblem = signal<string | undefined>(undefined)
// The message whose edit just closed, whose edit button takes the focus back once it is drawn.
let refocus: number | undefined
const busy = () => waiting() || streaming() !== undefined
// What the post under way replaces (`regenerate:2`), kept for Try again, which posts the same request; a fresh send, a message taken back or a reset forgets it.
let replacing: string | undefined
// The history as it stood before a regenerate or an edit cut it, put back when that post is stopped or refused before any word, since nothing replaced the turns it dropped.
let undone: Turn[] | undefined
let run: AbortController | undefined
// The id the reply under way was sent under, for a Chat that remembers: what a reload resumes and a Stop ends.
let replying: string | undefined
// The reply under way said it outlives its request, so its Stop is told to the server.
let outlives = false
// The reply under way is one asked for again after a reload, so an empty one means the server kept nothing.
let resumed = false
let field: HTMLTextAreaElement | undefined
let log: HTMLElement | undefined
let pinned = true
let lastTop = 0
const told = new Map<string, string>()
const statuses = { running: runningLabel, done: doneLabel, failed: failedLabel }

// Says the calls whose status changed since the last snapshot, each as `name: status`.
function announce(next: ToolCall[]) {
  const said: { id: number, text: string }[] = []

  for (const call of next) {
    if (told.get(call.id) === call.status)
      continue

    told.set(call.id, call.status)
    said.push({ id: nextId++, text: `${call.name}: ${call.approval === undefined ? statuses[call.status] : approvalLabel}` })
  }

  if (said.length > 0)
    spoken = [...spoken(), ...said]
}

function show(value: string | Progress) {
  if (typeof value === 'string') {
    partial = value

    return
  }

  if (value.outlives === true)
    outlives = true

  partial = value.text
  thought = value.reasoning ?? ''
  calls = value.calls
  announce(value.calls)

  if (value.sources) {
    const next = usableSources(value.sources)

    // Every snapshot of a stream repeats the list, which would redraw the reply for nothing.
    if (!sameSources(next, found()))
      found = next
  }

  if (value.code)
    code = [...code(), ...value.code]
}

// A link of a reply opens in a new tab, as the conversation lives in this page and a page swap would drop it, unless `links` is `here` and the link leads to this site.
function linksOpenApart(html: string): string {
  return html.replaceAll(SANITIZED_LINK, (tag, href: string) => opensApart(href, links === 'here') ? tag.replace('rel="nofollow ugc"', `target="_blank" rel="${REL_APART}" data-new-tab`) : tag)
}

// A table is wrapped, once sanitized, in a box that scrolls sideways and takes the keyboard's focus, except in the turn being written, which is hidden from screen readers. Several tables of one reply are numbered, so no two groups share a name.
// A code block the server highlighted (already sanitized there) takes the place of the plain one, which a marker holds through the sanitizing.
// The reply is parsed once, for its HTML and for the sources it cites outside code, in the order it first does.
function render(text: string, blocks: CodeBlock[] | undefined, sources: readonly Source[] = [], scrollable = true) {
  const parsed = markdownHtml(withoutMarker(text))
  const linked = linkSources(parsed, sources)

  // Markdown whose renderer is still loading, in an island hydrating, is left as the server drew it: written over, it would flash as plain text. The sources it cites come from that text, as the server's list does but for a citation in code.
  if (isHeldMarkdown(parsed))
    return { html: parsed, cited: linked.cited }

  let source = linked.html

  // Each block takes the first plain one of its markup left, in the order they were written, so two blocks of one code in two languages each get theirs.
  for (const [index, block] of (blocks ?? []).entries())
    source = source.replace(withoutMarker(block.markup), `${MARK}${index}${MARK}`)

  let html = linksOpenApart(sanitizeHtml(source, REPLY))

  if (blocks)
    html = html.replace(MARKED, (whole, index: string) => blocks[Number(index)]?.html ?? whole)

  const tables = html.split('<table>').length - 1

  if (tables === 0)
    return { html: trustHtml(html), cited: linked.cited }

  let count = 0

  return { html: trustHtml(html.replaceAll('<table>', () => {
    count++

    return `<div class="kai-chat-table"${scrollable ? ` tabindex="0" role="group" aria-label="${attribute(tables === 1 ? tableLabel : `${tableLabel} ${count}`)}"` : ''}><table>`
  }).replaceAll('</table>', '</table></div>')), cited: linked.cited }
}

const sameFile = (a: File, b: File) => a.name === b.name && a.size === b.size && a.lastModified === b.lastModified
const fileKey = (file: File) => `${file.name}\n${file.size}\n${file.lastModified}`

// Files the picker, a drop or a paste gave, that fit the message: a file past `maxFileSize` or beyond `maxFiles` is left out and says so, and one already attached is not added twice.
function attachFiles(chosen: File[]) {
  const sized = chosen.filter(file => file.size <= maxFileSize && !attached().some(known => sameFile(known, file)))
  const taken = sized.slice(0, Math.max(0, maxFiles - attached().length))

  attached = [...attached(), ...taken]

  if (sized.length < chosen.length && chosen.some(file => file.size > maxFileSize))
    attachProblem = attachTooBigLabel
  else if (taken.length < sized.length)
    attachProblem = attachFullLabel
}

const acceptable = (file: File) => accept.split(',').some(type => type.trim() === file.type)

// Files pasted into the field (a screenshot) or dropped on the form: only the kinds `accept` names are taken, the rest of the clipboard stays text.
function pasted(event: ClipboardEvent) {
  const given = [...event.clipboardData?.files ?? []].filter(acceptable)

  if (!attach || busy() || given.length === 0)
    return

  event.preventDefault()
  attachFiles(given)
}

// A drop on the attach button is the FileDrop's, which handled it and cancelled the event, so the form leaves it.
function dropped(event: DragEvent) {
  if (!attach || event.defaultPrevented || busy() || !event.dataTransfer?.types.includes('Files'))
    return

  event.preventDefault()

  const given = [...event.dataTransfer.files]

  attachFiles(given.filter(acceptable))

  if (given.some(file => !acceptable(file)))
    attachProblem = attachRefusedLabel
}

function unattach(file: File) {
  attached = attached().filter(known => known !== file)
  attachProblem = undefined
}

// A message the schema refuses would fail every later send, and one stopped before any word came has no answer, so a next send would post two user turns: it leaves the history and goes back to the field, ahead of what the visitor typed since.
function takeBack() {
  const last = history().at(-1)

  if (last?.role !== 'user')
    return

  const edited = replacing?.startsWith('edit')
  const restore = undone

  undone = undefined
  replacing = undefined
  takenBack = true

  // A regenerate or an edit puts the history back as it was; an edit's text returns to the field, its files staying with the turn they came from, and a regenerate has no message to return.
  if (restore !== undefined) {
    history = restore

    if (edited)
      draft = draft() === '' ? last.content : `${last.content}\n${draft()}`

    return
  }

  history = history().slice(0, -1)
  draft = draft() === '' ? last.content : `${last.content}\n${draft()}`
  attached = [...filesOf(last), ...attached()]
}

// The reply ended on its own, was stopped or broke off: what arrived joins the history.
function finish(state: string) {
  if (leaving)
    return

  const text = partial()
  const thinking = thought()
  const made = calls()
  const highlighted = code()
  const cites = found()

  streaming = undefined
  partial = ''
  thought = ''
  calls = []
  code = []
  found = []

  // A page swap closes the stream too, leaving the reply to be asked for again when the chat returns.
  if (state !== 'closed' && remember !== undefined) {
    keepPending(remember, undefined)
    replying = undefined
  }

  if (state === 'done' && resumed && text === '' && made.length === 0)
    takeBack()

  if (text !== '' || made.length > 0) {
    undone = undefined
    history = [...history(), { id: nextId++, role: 'assistant', content: text, calls: made, code: highlighted, reasoning: thinking, ...cites.length > 0 && { sources: cites }, stopped: state === 'closed' }]
  }

  if (state === 'failed')
    failure = errorMessage
  else if (state === 'closed' && text === '' && made.length === 0)
    takeBack()
}

let recalled = false
// The page is being left, which breaks the stream off without the reply having failed or been stopped: what it holds stays as it was, for the next visit to ask for.
let leaving = false

// The conversation of the tab's last visit, put back once hydrated since the server renders the initial one.

onMount(() => {
  let timer: ReturnType<typeof setTimeout> | undefined

  // A stream that ended while the page was going is settled now, if the page stayed after all, such as a download or a refused leave.
  const back = () => {
    leaving = false

    const stream = streaming()
    const state = stream?.status()

    if (state !== undefined && state !== 'open')
      finish(state)
  }
  const leave = () => {
    leaving = true
    clearTimeout(timer)
    timer = setTimeout(back, LEAVING_MS)
  }

  window.addEventListener('beforeunload', leave)
  window.addEventListener('pagehide', leave)
  window.addEventListener('pageshow', back)
  onCleanup(() => {
    clearTimeout(timer)
    window.removeEventListener('beforeunload', leave)
    window.removeEventListener('pagehide', leave)
    window.removeEventListener('pageshow', back)
  })

  if (remember === undefined)
    return

  const turns = restored(remember)

  recalled = true

  if (turns.length > 0)
    history = turns.map(turn => ({ ...turn, id: nextId++ }))

  const id = pendingReply(remember)

  // A reply that was under way when the tab went is asked for again: the server finished it or goes on with it.
  if (id !== undefined && turns.at(-1)?.role === 'user')
    void send(true, undefined, id)
  else if (id !== undefined)
    keepPending(remember, undefined)
})

effect(() => {
  const turns = history()

  // Before the last visit's turns are back, the history would overwrite them with the initial one.
  if (remember !== undefined && recalled)
    stored(remember, turns)
})

effect(() => {
  const stream = streaming()

  if (stream === undefined)
    return

  const state = stream.status()

  if (state !== 'open')
    untrack(() => finish(state))
})

// Keeps the newest text in view unless the visitor scrolled up to read.
effect(() => {
  history()
  partial()
  calls()
  waiting()

  if (pinned)
    queueMicrotask(follow)
})

// What the action took as too long, learned from its 413s, so the app states `maxInputChars` once: the oldest turns go first, the last stays.
let learned = Infinity
const MAX_RETRIES = 5

// Posts the history; a 413 halves what is posted, at most 5 times a send since each counts against the action's rate limit, until the action takes it or only the last message is left.
async function call(abort: AbortSignal, headers?: Record<string, string>): Promise<ActionStream<string | Progress>> {
  for (let retries = 0; ; retries++) {
    const sent = posted(history(), keep, Math.min(maxChars, learned))

    try {
      return await action({ messages: sent }, { signal: abort, refresh: false, ...headers && { headers } })
    }
    catch (error) {
      if (!(error instanceof ActionError) || error.status !== 413 || sent.length < 2 || retries === MAX_RETRIES || abort.aborted)
        throw error

      learned = shrunk(sent)
    }
  }
}

async function send(again = false, question?: string, resuming?: string) {
  const text = question ?? draft().trim()
  const sent = question === undefined ? attached() : []

  if (busy() || (!again && text === '' && sent.length === 0))
    return

  if (!again) {
    replacing = undefined
    undone = undefined
    history = [...history(), { id: nextId++, role: 'user', content: text, ...sent.length > 0 && { attachments: sent } }]

    // A suggestion leaves what the visitor was typing.
    if (question === undefined) {
      draft = ''
      attached = []
      attachProblem = undefined
    }
  }

  const mine = new AbortController()
  // A reply is named, so a Stop ends it on the server and, for a Chat that remembers, a reload finds it.
  const id = resuming ?? newReplyId()

  if (remember !== undefined && id !== undefined)
    keepPending(remember, id)

  run = mine
  replying = id
  outlives = false
  resumed = resuming !== undefined
  pinned = true
  failure = undefined
  takenBack = false
  partial = ''
  thought = ''
  calls = []
  code = []
  found = []
  told.clear()
  spoken = []
  waiting = true

  try {
    // A turn that only called tools has no text to post, which a provider refuses.
    // A resume after a reload comes once the server has dropped the turns.
    const stream = await call(mine.signal, { [REPLY_HEADER]: `${resuming === undefined ? 'start' : 'resume'}:${id}`, ...resuming === undefined && replacing !== undefined && { [REPLACES_HEADER]: replacing } })

    if (mine.signal.aborted) {
      stream.close()
      takeBack()

      return
    }

    stream.on(show)
    streaming = stream
  }
  catch (error) {
    // A call stopped before its first word is not a failure, and its message returns to the field.
    if (mine.signal.aborted) {
      takeBack()
    }
    else {
      console.error(error)

      if (remember !== undefined)
        keepPending(remember, undefined)

      replying = undefined

      if (error instanceof ActionError && error.status === 422)
        takeBack()

      failure = error instanceof ActionError && error.status < 500 && error.errors[''] ? error.errors[''] : errorMessage
    }
  }
  finally {
    waiting = false
    field?.focus()
  }
}

// Text from outside the field, such as a voice transcript, is sent as a suggestion is: the draft stays, and a reply under way or blank text ignores it.
function sendFrom(event: Event) {
  const text = (event as CustomEvent<unknown>).detail

  if (typeof text === 'string' && text.trim() !== '')
    void send(false, text.trim())
}

// The button beside the field resets, then puts the cursor back in the field.
function startOver() {
  reset()
  queueMicrotask(() => field?.focus())
}

// Starts the conversation over: what is under way stops, and the log, the field and the kept history are cleared.
function reset() {
  stop()
  history = []
  replacing = undefined
  undone = undefined
  editing = undefined
  draft = ''
  attached = []
  attachProblem = undefined
  failure = undefined
  takenBack = false
  partial = ''
  thought = ''
  calls = []
  code = []
  found = []
  spoken = []
  told.clear()
}

// The visitor's answer to a held tool call is their next message: the allowance carries the ticket the server issued for that very call.
function decide(call: ToolCall, allowed: boolean) {
  if (!allowed)
    void send(false, `${deniedLabel} ${call.name}`)
  else if (call.approval !== undefined)
    void send(false, approvalMessage(`${allowedLabel} ${call.name} ${JSON.stringify(call.input)}`, call.approval))
}

// An answer to a held tool call carries a ticket that is spent, so it is neither edited nor posted again.
const approval = (turn: Turn | undefined) => turn !== undefined && ticketsIn(turn.content).length > 0

// The last reply, when a turn of the visitor leads to it and nothing waits for the visitor's allowance.
function canRegenerate(turn: Turn): boolean {
  const turns = history()

  return regenerate && !busy() && turns.at(-1)?.id === turn.id && turns.at(-2)?.role === 'user' && !approval(turns.at(-2)) && waitingFor(turn).length === 0
}

const canEdit = (turn: Turn) => editable && !busy() && !approval(turn)

// Asks again for the last reply: it leaves the log and the history, and the post ends on the message before it, which replaces both turns on a server that keeps the conversation.
function regenerateReply() {
  if (busy())
    return

  replacing = 'regenerate:2'
  undone = history()
  history = history().slice(0, -1)
  void send(true)
}

function startEdit(turn: Turn) {
  editing = turn.id
  editDraft = withoutApproval(turn.content)
  editProblem = undefined
}

// Closes the edit and puts the focus back on the message's edit button, which is drawn again by then.
function cancelEdit(id: number) {
  refocus = id
  editing = undefined
  editProblem = undefined
}

const START_CHARS = 40

// The edit button names its message by its first words, so a screen reader and the tooltip tell the buttons apart.
function editName(turn: Turn): string {
  const words = withoutApproval(turn.content).replaceAll(/\s+/g, ' ').trim()

  if (words === '')
    return editLabel

  return `${editLabel}: ${words.length > START_CHARS ? `${words.slice(0, START_CHARS).trimEnd()}…` : words}`
}

// Takes the focus when this message's edit just closed.
function takeFocus(element: HTMLElement, turn: Turn) {
  if (refocus !== turn.id)
    return

  refocus = undefined
  queueMicrotask(() => element.focus())
}

// The edited message and every turn after it leave the history, and the post ends on the new message: its files stay, and it replaces all those turns on a server that keeps the conversation.
function saveEdit() {
  const turns = history()
  const index = turns.findIndex(turn => turn.id === editing())
  const edited = turns[index]
  const text = editDraft().trim()

  if (busy())
    return

  if (edited === undefined) {
    editing = undefined

    return
  }

  const files = filesOf(edited)

  if (text === '' && files.length === 0) {
    editProblem = editEmptyLabel

    return
  }

  editing = undefined
  editProblem = undefined
  // The edit field is gone, and the edit button too while the reply is under way.
  field?.focus()
  replacing = `edit:${turns.length - index}`
  undone = turns
  history = [...turns.slice(0, index), { id: nextId++, role: 'user', content: text, ...files.length > 0 && { attachments: files } }]
  void send(true)
}

function editKey(event: KeyboardEvent, id: number) {
  if (event.isComposing)
    return

  if (event.key === 'Enter' && !event.shiftKey) {
    event.preventDefault()
    saveEdit()
  }
  else if (event.key === 'Escape') {
    cancelEdit(id)
    leaveEscape(event)
  }
}

// An Escape that closed an edit does only that: not the reply being stopped, nor a panel around the chat closing.
function leaveEscape(event: KeyboardEvent) {
  event.preventDefault()
  event.stopPropagation()
}

// Escape on the Save or Cancel button cancels the edit as it does in the field.
function actionsKey(event: KeyboardEvent, id: number) {
  if (event.key === 'Escape' && !event.isComposing) {
    cancelEdit(id)
    leaveEscape(event)
  }
}

const callKey = (call: ToolCall) => `${call.name}\n${JSON.stringify(call.input)}`

// Only the calls of the last turn can still be allowed: a later message has moved on.
function waitingFor(turn: Turn): ToolCall[] {
  if (busy() || history().at(-1)?.id !== turn.id)
    return []

  const seen = new Set<string>()

  // A model asking again for the same held call is one question.
  return (turn.calls ?? []).filter(call => call.approval !== undefined && !seen.has(callKey(call)) && seen.add(callKey(call)))
}

function ask(question: string) {
  void send(false, question)
}

// Tells the server to end a reply that outlives its request, which closing the stream does not.
async function endOnServer(id: string, messages: ChatMessage[]) {
  try {
    const answer = await action({ messages }, { refresh: false, headers: { [REPLY_HEADER]: `stop:${id}` } })

    if (typeof answer === 'object' && answer !== null && 'close' in answer)
      (answer as ActionStream<unknown>).close()
  }
  catch (error) {
    console.warn('the reply could not be ended on the server', error)
  }
}

function stop() {
  const stream = streaming()
  const id = replying

  // A reply that showed nothing yet is ended too, as it may outlive: only one that streamed without saying so is left alone.
  if (id !== undefined && busy() && (outlives || (partial() === '' && calls().length === 0))) {
    if (remember !== undefined)
      keepPending(remember, undefined)

    replying = undefined
    // Only the last message goes, without its files, which any size the action takes holds.
    void endOnServer(id, posted(history(), keep, maxChars).slice(-1).map(({ role, content }) => ({ role, content })))
  }

  // Aborting a call whose answer arrived would break the body read; closing the stream is enough then.
  if (stream === undefined)
    run?.abort()
  else
    stream.close()

  field?.focus()
}

// Heard on the whole chat, so the Stop button and the log stop a reply too.
function escape(event: KeyboardEvent) {
  if (event.key === 'Escape' && busy() && !event.isComposing) {
    // Stops the reply and nothing else, such as the panel around the chat closing.
    event.preventDefault()
    stop()
  }
}

function keyDown(event: KeyboardEvent) {
  if (event.key === 'Enter' && !event.shiftKey && !event.isComposing) {
    event.preventDefault()
    void send()
  }
}

// A log shown again, such as in a panel reopened, is scrolled to the end when the visitor was at it, as it has no scroll position while hidden.
function watch(element: HTMLElement) {
  log = element

  if (typeof ResizeObserver === 'undefined')
    return

  const observer = new ResizeObserver(() => {
    // A hidden log is scrolled anew once shown, so a scroll then is not read against where it stood before.
    if (element.clientHeight === 0)
      lastTop = 0
    else if (pinned)
      follow()
  })

  observer.observe(element)
  onCleanup(() => observer.disconnect())
}

function follow() {
  if (log === undefined)
    return

  log.scrollTo({ top: log.scrollHeight })
  // Remembered here as scroll events coalesce, so a visitor scrolling up before the event is still seen as going up.
  lastTop = log.scrollTop
}

// Only the visitor scrolling up leaves the end: the scroll event of our own scrollTo reaches the handler after the reply grew again, which would read as far from the end.
function scrolled() {
  if (log === undefined || log.clientHeight === 0)
    return

  const top = log.scrollTop
  const atEnd = log.scrollHeight - top - log.clientHeight < PINNED_PX

  if (top < lastTop || atEnd)
    pinned = atEnd

  lastTop = top
}
---
section(part="root" onKeyDown={escape} data-empty={history().length === 0 && !busy()} data-fill={fill ? '' : undefined} data-variant={variant} data-tone={tone} data-size={size} ref={element => { element.addEventListener('kai-chat-new', reset); element.addEventListener('kai-chat-send', sendFrom) }})
  if history().length === 0 && !busy()
    div(part="empty")
      p(part="greeting") {greeting}
      if suggestions.length > 0
        ul(part="suggestions")
          for question of suggestions key={question}
            li
              button(part="suggestion" type="button" onClick={() => ask(question)}) {question}
  // The log is the turns so far; the reply streaming in is hidden from screen readers until it is whole, so the finished turn is announced once, not word by word. The status line says the thinking label, then each tool call as it starts and ends.
  div(part="log" role="log" aria-label={label} tabindex="0" ref={watch} onScroll={scrolled})
    for turn of history() key={turn.id}
      article(part="turn" data-role={turn.role} data-editing={editing() === turn.id ? '' : undefined})
        if turn.role === 'user'
          if editing() === turn.id
            Textarea(part="editField" writeFocused ref={element => { queueMicrotask(() => element.focus()) }} value={editDraft()} onInput={value => { editDraft = value; editProblem = undefined }} rows="1" aria-label={editLabel} onKeyDown={event => editKey(event, turn.id)})
          else if turn.content !== ''
            p(part="text") {withoutApproval(turn.content)}
          if filesOf(turn).length > 0
            ul(part="files")
              for file of filesOf(turn) key={fileKey(file)}
                li(part="file") {file.name}
          if editing() === turn.id
            if editProblem()
              Notice(tone="danger") {editProblem()}
            div(part="actions" onKeyDown={event => actionsKey(event, turn.id)})
              button(part="save" type="button" data-variant="solid" data-size="sm" disabled={busy()} onClick={saveEdit}) {saveLabel}
              button(part="cancel" type="button" data-variant="ghost" data-size="sm" onClick={() => cancelEdit(turn.id)}) {cancelLabel}
          else if canEdit(turn)
            div(part="actions")
              BareIconButton(part="edit" variant="inline" size="xs" label={editName(turn)} ref={element => takeFocus(element, turn)} onClick={() => startEdit(turn)})
                slot editIcon
                  Icon(icon="edit")
        else
          if reasoning && turn.reasoning
            details(part="reasoning")
              summary {reasoningLabel}
              p(part="reasoningText") {turn.reasoning}
          if turn.calls && turn.calls.length > 0
            Calls(calls={turn.calls} labels={toolLabels} details={toolDetails} runningLabel={runningLabel} doneLabel={doneLabel} failedLabel={failedLabel} argumentsLabel={argumentsLabel} resultLabel={resultLabel} approvalLabel={approvalLabel})
          for call of waitingFor(turn) key={call.id}
            div(part="approval" role="group" aria-label={`${call.name}: ${approvalLabel}`})
              span(part="approvalText") {call.name} {JSON.stringify(call.input)} - {approvalLabel}
              button(part="allow" type="button" data-variant="solid" data-size="sm" onClick={() => decide(call, true)}) {allowLabel}
              button(part="deny" type="button" data-variant="ghost" data-size="sm" onClick={() => decide(call, false)}) {denyLabel}
          if turn.content !== ''
            const view = render(turn.content, turn.code, turn.sources)
            div(part="text" innerHTML={view.html})
            if view.cited.length > 0
              Sources(sources={view.cited} label={sourcesLabel} here={links === 'here'})
          if turn.stopped
            small(part="note") {stoppedLabel}
          if canRegenerate(turn)
            div(part="actions")
              BareIconButton(part="regenerate" variant="inline" size="xs" label={regenerateLabel} onClick={regenerateReply})
                slot regenerateIcon
                  Icon(icon="refresh")
    if busy()
      article(part="turn" data-role="assistant" data-pending="" aria-hidden="true")
        if reasoning && thought() !== ''
          details(part="reasoning")
            summary(tabindex="-1") {reasoningLabel}
            p(part="reasoningText") {thought()}
        if calls().length > 0
          Calls(calls={calls()} labels={toolLabels} details={toolDetails} runningLabel={runningLabel} doneLabel={doneLabel} failedLabel={failedLabel} argumentsLabel={argumentsLabel} resultLabel={resultLabel} approvalLabel={approvalLabel})
        if partial() !== ''
          const view = render(partial(), code(), found(), false)
          div(part="text" innerHTML={view.html})
          if view.cited.length > 0
            Sources(sources={view.cited} label={sourcesLabel} here={links === 'here'})
        else if calls().length === 0
          p(part="thinking") {thinkingLabel}
  div(part="status" role="status" aria-atomic="false")
    for line of spoken() key={line.id}
      p {line.text}
    if busy() && partial() === '' && calls().length === 0
      p {thinkingLabel}
  if failure()
    Notice(tone="danger")
      | {failure()}
      |
      if !busy() && !takenBack() && history().at(-1)?.role === 'user'
        button(part="retry" type="button" data-variant="solid" data-size="md" onClick={() => { void send(true) }}) {retryLabel}
  if disclosure !== ''
    p(part="disclosure") {disclosure}
  if attachProblem()
    Notice(tone="danger") {attachProblem()}
  if attached().length > 0
    ul(part="files")
      for file of attached() key={fileKey(file)}
        li(part="file")
          | {file.name}
          BareIconButton(part="remove" variant="inline" size="xs" label={`${removeLabel} ${file.name}`} onClick={() => unattach(file)})
            Icon(icon="close")
  form(part="form" onSubmit={event => { event.preventDefault(); void send() }} onDragOver={event => { if (attach) event.preventDefault() }} onDrop={dropped})
    if newButton && history().length > 0
      BareIconButton(part="new" variant="inline" label={newLabel} onClick={startOver})
        slot newIcon
          Icon(icon="plus")
    if attach
      FileDrop(class={{ root: 'contents' }} accept={accept} multiple disabled={busy()} onFiles={attachFiles} onReject={() => { attachProblem = attachRefusedLabel }})
        @content(zone)
          BareIconButton(part="attach" variant="inline" label={attachLabel} onClick={zone.open})
            slot attachIcon
              Icon(icon="plus")
    Textarea(part="field" writeFocused ref={element => { field = element }} value={draft()} onInput={draft.set} rows="1" onPaste={pasted} aria-label={label} placeholder={placeholder} onKeyDown={keyDown})
    if busy()
      BareIconButton(part="send" variant="inline" label={stopLabel} onClick={stop})
        slot stopIcon
          Icon(icon="stop")
    else
      BareIconButton(part="send" variant="inline" type="submit" label={sendLabel})
        slot sendIcon
          Icon(icon="send")
