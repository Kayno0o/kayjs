    "body": "<!doctype html><html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48"><link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="apple-touch-icon" href="/apple-touch-icon.png"><link rel="manifest" href="/manifest.webmanifest"><link rel="canonical" href="https://x.example/search"><link rel="alternate" hreflang="fr" href="https://x.example/search"><link rel="alternate" hreflang="en" href="https://x.example/en/search"><link rel="alternate" hreflang="x-default" href="https://x.example/search"><meta property="og:type" content="website"><meta property="og:url" content="https://x.example/search"><script type="speculationrules">{"prefetch":[{"source":"document","where":{"and":[{"href_matches":"/*"},{"not":{"href_matches":"/_kay/*"}},{"not":{"href_matches":"/api/*"}},{"not":{"href_matches":"/api"}},{"not":{"selector_matches":"[data-no-prefetch], [download], [rel~=nofollow]"}}]},"eagerness":"moderate"}]}</script><script data-kay-history>{const u=location.pathname+location.search;addEventListener("popstate",e=>{e.state?.kay&&location.pathname+location.search!==u&&location.reload()})}</script></head><body><nav><a class="home" href="/">Home</a><a class="about" href="/about">About</a></nav><main><h1>Page 2</h1></main></body></html>",
