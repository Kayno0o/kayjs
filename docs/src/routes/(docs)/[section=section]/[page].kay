--- server
import { shareCard } from 'kay/image'
import { docs } from '../../../content.config'
import { FORGE } from '../../../forge'
import { neighbours } from '../../../pages'
import { sectionOf } from '../../../sections'

export const page = {
  prerender: async () => {
    return (await docs.all()).map((entry) => {
      const [section, page] = entry.slug.split('/')

      return { section: section!, page: page! }
    })
  },
}

const entry = await docs.get(`${ctx.params.section}/${ctx.params.page}`) ?? ctx.notFound()
const { Content } = entry
const { title, description, path } = entry.data
const sections = entry.headings.filter(heading => heading.depth === 2 || heading.depth === 3)
// The pager stays in the page's part: the Structure pages lead to each other, the other sections to theirs.
const structure = (slug: string) => sectionOf(slug)?.slug === 'structure'
const { previous, next } = neighbours((await docs.all()).filter(one => structure(one.slug) === structure(entry.slug)), entry.slug, slug => `/${slug}`)
--- script
import Pager from '../../../components/pager.kay'
import Toc from '../../../components/toc.kay'
---
head
  title {title} · kay
  meta(name="description" content={description})
  meta(property="og:image" content={shareCard({ title })})
  meta(property="og:image:alt" content={title})
.page
  header.page-head
    if path as file
      p.eyebrow: code {file}
    else
      p.eyebrow {sectionOf(entry.slug)?.title}
    h1 {title}
    p.lede {description}
  if sections.length > 0
    Toc(sections={sections})
  article.prose
    Content
  Pager(previous={previous} next={next} source={`${FORGE}/docs/src/content/docs/${entry.slug}.md`})
