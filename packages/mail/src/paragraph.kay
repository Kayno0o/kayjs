---
import settings from './settings'

const { muted = false } = props<{ muted?: boolean | undefined }>()
---
p(class={muted ? 'km-muted' : 'km-text'} style={muted ? `font-size:13px;line-height:1.5;margin:0 0 12px;color:${settings.muted}` : `font-size:16px;line-height:1.6;margin:0 0 16px;color:${settings.text}`})
  slot
