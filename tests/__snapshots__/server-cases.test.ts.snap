exports[`the page answers of a site with basedSlash answers every path as pinned 1`] = `
{
  "GET /": {
    "body": "<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><link rel="icon" href="/shop/favicon.ico" sizes="16x16 32x32 48x48"><link rel="icon" href="/shop/favicon.svg" type="image/svg+xml"><link rel="apple-touch-icon" href="/shop/apple-touch-icon.png"><link rel="manifest" href="/shop/manifest.webmanifest"><meta property="og:type" content="website"><meta name="kay-base" content="/shop"><script type="speculationrules">{"prefetch":[{"source":"document","where":{"and":[{"href_matches":"/shop/*"},{"not":{"href_matches":"/shop/_kay/*"}},{"not":{"href_matches":"/shop/api/*"}},{"not":{"href_matches":"/shop/api"}},{"not":{"selector_matches":"[data-no-prefetch], [download], [rel~=nofollow]"}}]},"eagerness":"moderate"}]}</script><script data-kay-history>{const u=location.pathname+location.search;addEventListener("popstate",e=>{e.state?.kay&&location.pathname+location.search!==u&&location.reload()})}</script></head><body><nav><a class="home" href="/shop/">Home</a><a class="about" href="/shop/about">About</a></nav><main><h1>Nothing here</h1></main></body></html>",
    "headers": [
      [
        "content-security-policy",
        "default-src 'self'; script-src 'self' 'sha256-D5r0df3BO8X/Sqpj5sN6xdcXoSG6DQnH1fxnD3Hg/PU=' 'sha256-VhYhFd/1zGrhC7SBMBYnvdZZ1l5TAl4StEbMZ+84PHw=' 'sha256-V7cCDNnYcYCb4FmmmB01lL6u9MhuGPl7mV3CwzHVGYM=' 'sha256-Xaq4BN7FESorQc2/t8dtNBYnpRUbrGviTUahMvWULPE=' 'sha256-LVAlJaKeR4XSHLYjjcmMniX/ZPE8ZbB8lYawhcbiAug='; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'",
      ],
      [
        "content-type",
        "text/html; charset=utf-8",
      ],
      [
        "cross-origin-opener-policy",
        "same-origin",
      ],
      [
        "cross-origin-resource-policy",
        "same-site",
      ],
