---
import type { Member } from '../room'
import { effect, memo, presence } from 'kay'
import { wording } from 'kay/words'
import { editorsOf, watchRoom } from '../room'

// Who else has an entry open: their names when `cms({ author })` gives them, else how many they are. `room` and `member` come from `entryPresence`, or from `entryRoom` for the on-page editor, which asks no author.
// `named` is false until the guard has said the visitor is signed in, and for an edit link's holder, who is shown how many are there and no names.
const { room, member, named = true } = props<{ room: string, member: Member, named?: boolean }>()
const here = presence(room, member)
// Also listed in the room a list watches the entry through, which nothing here shows: a room is joined by reading it.
const watchedBy = presence(watchRoom(room), member)

effect(() => void watchedBy.count())
const editors = memo(() => editorsOf(here.others(), here.count(), member))
const text = memo(() => {
  if (editors().names.length > 0 && named)
    return wording('cms.entry.alsoOpen', 'Also open: {names}', { names: editors().names.join(', ') })

  const others = named ? editors().unnamed : here.count()

  return others > 0 ? wording('cms.entry.otherEditors', others === 1 ? '1 other editor' : '{count} other editors', { count: others }) : ''
})
---
.kcms-entry-presence(role="status")
  if text() !== ''
    p {text()}
