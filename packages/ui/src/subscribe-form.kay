---
import { recipe } from 'kay'
import type { Action, FormFailure, JSX, Snippet } from 'kay'
import { wording } from 'kay/words'
import Button from './button.kay'
import { FIELD_MESSAGE } from './field-look'
import FormField from './form-field.kay'
import FormOutcome from './internal/form-outcome.kay'
import Notice from './notice.kay'

const look = recipe({ parts: { root: 'kui-subscribe-form', notice: FIELD_MESSAGE.hint } })

const { action, noticeText, label = wording('ui.subscribeForm.email', wording('ui.subscribeForm.label', wording('mail.list.form.email', 'Email'))), submitLabel = wording('ui.subscribeForm.submit', wording('mail.list.form.submit', 'Subscribe')), sentLabel = wording('ui.subscribeForm.sent', wording('mail.list.form.sent', 'Almost done: open the mail we just sent you and confirm your address.')), privacyLabel = wording('ui.subscribeForm.privacy', wording('mail.list.form.privacy', 'Privacy policy')), privacy, wordingId, onSend, onError, sent, ...rest } = props<Omit<JSX.IntrinsicElements['form'], 'class' | 'action' | 'novalidate' | 'children' | 'onError'> & {
  // The action `mail.list().form()` from kayjs-mail gives, or any with an `email` field.
  action: Action<never, unknown>
  // The labels read the `ui.subscribeForm.*` messages, then kayjs-mail's `mail.list.form` ones in the page's language, English and French, which these replace.
  label?: string | undefined
  submitLabel?: string | undefined
  // Shown once the post went through, whether or not the address was already listed.
  sentLabel?: string | undefined
  // Replaces the success notice, whatever `sentLabel` says.
  sent?: Snippet
  // Called once the post went through, with what the action returned: for an analytics conversion, closing a dialog around the form or a redirect.
  onSend?: ((data: unknown) => unknown) | undefined

  // Called when the post was refused or failed, with the messages by field, the status and the failure's data; the notice and the field messages still show.
  onError?: ((failure: FormFailure<never, unknown>) => unknown) | undefined
  // The line saying what the address is used for, shown by default; replace it with the sender, the content and the frequency of your list.
  noticeText?: string | undefined
  privacyLabel?: string | undefined
  // Where the privacy page is, such as `/privacy`: linked after the notice; the list's `privacy` option unless given here.
  privacy?: string | undefined
  // Names the wording of `noticeText`, kept with the subscription as the proof of what was agreed to; left out, the stock notice is recorded as `stock` and a replaced one as `custom`.
  wordingId?: string | undefined
}>()

const notice = () => noticeText ?? wording('ui.subscribeForm.notice', wording('mail.list.form.notice', 'We use your address to send you the mails of this site, until you unsubscribe with the link in each one.'))
// The list's own `privacy`, which its form action carries; the prop replaces it.
const policy = () => privacy ?? (action as { schema?: { 'x-privacy'?: string } }).schema?.['x-privacy']
const shownWording = () => wordingId ?? (noticeText === undefined ? 'stock' : 'custom')
---
// Posts without JavaScript; the honeypot, the time stamp and the refused email's message come from the action.
form(part="root" {...rest} action={action} novalidate)
  FormField(label={label} required name="email")
    input(field="email" type="email" autocomplete="email")
  // Fields beyond the email, between it and the notice.
  slot
  p(part="notice")
    | {notice()}{' '}
    if policy() as link
      a(part="link" href={link} target="_blank" rel="noopener noreferrer") {privacyLabel}
  input(type="hidden" name="wording" value={shownWording()})
  Button(type="submit" tone="accent" label={submitLabel})
  // Only an island renders the form with a callback, which this passes on; the cast keeps `kay check` from reading the form as a static component handing an island a function.
  if onSend || onError
    FormOutcome(action={action} whenSent={onSend as never} whenRefused={onError as never})
  if action.succeeded()
    if sent
      | {sent}
    else
      Notice(tone="success" size="sm") {sentLabel}
  else if action.error() as message
    Notice(tone="danger" size="sm") {message}
