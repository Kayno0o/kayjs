---
import type { Duration, JSX } from 'kay'
import { copy } from '@kaynooo/utils/browser/clipboard'
import { durationMs, onCleanup, recipe, signal } from 'kay'
import { attempt } from './toast'
import { wording } from 'kay/words'

// 'kui-copy-btn' stays as the component's name for an app's CSS; its padding is a utility, which beats the Button's per-size rules.
const look = recipe({
  parts: {
    root: 'kui-copy-btn px-1.5 py-0.5',
    text: 'inline-flex flex-col items-center after:invisible after:h-0 after:overflow-hidden after:content-[attr(data-other)]',
    live: 'sr-only',
  },
  variants: { tone: { neutral: '', accent: 'kui-btn-accent', success: 'kui-btn-success', danger: 'kui-btn-danger' } },
})

const { text, label, html, variant = 'solid', size = 'md', copiedFor = '2s', copiedLabel = wording('ui.copyButton.copied', 'Copied!'), failure = wording('ui.copyButton.failure', 'Could not copy to the clipboard'), ...rest } = props<Omit<JSX.IntrinsicElements['button'], 'class' | 'children' | 'onClick' | 'type'> & {
  text: string
  label: string
  // A rendered version copied alongside `text`, which rich editors paste instead.
  html?: string | undefined
  // As a Button's: `solid`, `ghost` or `inline`.
  variant?: 'solid' | 'ghost' | 'inline' | undefined
  size?: 'xs' | 'sm' | 'md' | 'lg' | undefined
  // How long the button says `copiedLabel` once the copy went through.
  copiedFor?: Duration | undefined
  // What the button says once the copy went through.
  copiedLabel?: string | undefined
  // Toasted when the browser refuses the copy.
  failure?: string | undefined
}>()

const copied = signal(false)
let timer: ReturnType<typeof setTimeout> | undefined

onCleanup(() => clearTimeout(timer))

async function press() {
  if (!text)
    return

  const done = await attempt(async () => copy(text, html === undefined ? {} : { html }), failure)

  if (!done)
    return

  copied = true
  clearTimeout(timer)
  timer = setTimeout(() => copied = false, durationMs(copiedFor))
}
---
button.kui-btn(part="root" {...rest} type="button" data-variant={variant} data-size={size} onClick={press})
  // The label not showing is drawn invisibly by CSS from `data-other`, so the button keeps the wider label's width while its text and accessible name stay the one showing.
  span(part="text" data-other={copied() ? label : copiedLabel}) {copied() ? copiedLabel : label}
// A button's new text is not read out, so the copy is said here too.
span(part="live" role="status") {copied() ? copiedLabel : ''}
