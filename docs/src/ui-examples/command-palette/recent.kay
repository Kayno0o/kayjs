---
import { signal } from 'kay'
import Button from '@kayjs/ui/button.kay'
import CommandPalette from '@kayjs/ui/command-palette.kay'
import type { PaletteEntry } from '@kayjs/ui'

const open = signal(false)
const recent = signal<string[]>([])
const entries: PaletteEntry[] = [
  { label: 'Bun', group: 'Links', href: 'https://bun.sh', external: true },
  {
    label: 'MDN',
    group: 'Links',
    href: 'https://developer.mozilla.org',
    external: true,
  },
  {
    label: 'Tailwind CSS',
    group: 'Links',
    href: 'https://tailwindcss.com',
    external: true,
  },
]
---
Button(label="Open the palette" onClick={() => open = true})
CommandPalette(
  open={open()}
  onOpenChange={open.set}
  entries={entries}
  recent={recent()}
  onRecentChange={recent.set}
)
