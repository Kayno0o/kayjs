---
import type { Duration, JSX } from 'kay'
import { durationMs, effect, listen, onCleanup, onMount, recipe, signal } from 'kay'
import IconButton from './icon-button.kay'
import { startRef } from './form-reset'
import { stepIndex } from './cycle'
import { wording } from 'kay/words'

const look = recipe({ parts: { root: 'kui-carousel', viewport: 'kui-carousel-viewport', slide: 'kui-carousel-slide', image: 'kui-carousel-image', controls: 'kui-carousel-controls', step: 'kui-carousel-step', dot: 'kui-carousel-dot', pause: 'kui-carousel-pause' } })

const { slides, index = 0, onIndexChange, autoplay, ratio = '16 / 9', label = wording('ui.carousel.label', 'Carousel'), previousLabel = wording('ui.carousel.previousLabel', 'Previous slide'), nextLabel = wording('ui.carousel.nextLabel', 'Next slide'), pauseLabel = wording('ui.carousel.pauseLabel', 'Pause'), playLabel = wording('ui.carousel.playLabel', 'Play'), slideLabel = wording('ui.carousel.slideLabel', 'Slide {n} of {count}'), dotLabel = wording('ui.carousel.dotLabel', 'Go to slide {n}'), ...rest } = props<Omit<JSX.IntrinsicElements['section'], 'class' | 'children'> & {
  slides: readonly { src: string, alt: string }[]
  // The slide shown first; a carousel whose parent passes another follows it.
  index?: number | undefined
  onIndexChange?: ((index: number) => unknown) | undefined
  // Moves to the next slide this often, `'5s'`, held while the pointer or the focus is on the carousel, stopped by its pause button, and never for a visitor asking for reduced motion.
  autoplay?: Duration | undefined
  // The slides' aspect ratio, as CSS writes it.
  ratio?: string | undefined
  // Names the carousel for screen readers.
  label?: string | undefined
  previousLabel?: string | undefined
  nextLabel?: string | undefined
  // The autoplay's button, while it runs and once paused.
  pauseLabel?: string | undefined
  playLabel?: string | undefined
  // `{n}` stands for the slide's number and `{count}` for how many there are.
  slideLabel?: string | undefined
  dotLabel?: string | undefined
}>()

const shown = signal(index)
// Whether the pointer or the focus is on the carousel, or the tab is hidden or the carousel scrolled out of view, which holds the autoplay.
const pointed = signal(false)
const focused = signal(false)
const hidden = signal(false)
const offscreen = signal(false)
const root = signal<HTMLElement>()
// The visitor's own pause, which nothing but the button lifts.
const paused = signal(false)

onMount(() => hidden.set(document.hidden))
listen(document, 'visibilitychange', () => hidden.set(document.hidden))

const ref = startRef<HTMLElement>(element => root.set(element), rest.ref)

effect(() => shown.set(index))

effect(() => {
  const element = root()

  if (!autoplay || !element || typeof IntersectionObserver === 'undefined')
    return

  const observer = new IntersectionObserver(entries => offscreen.set(!entries.at(-1)!.isIntersecting))

  observer.observe(element)
  onCleanup(() => observer.disconnect())
})

// Checked at once, so a bare number throws even where the effect would return early, as on the server or under reduced motion.
if (autoplay !== undefined)
  durationMs(autoplay)

effect(() => {
  if (!autoplay || paused() || pointed() || focused() || hidden() || offscreen() || matchMedia('(prefers-reduced-motion: reduce)').matches)
    return

  const timer = setInterval(step, durationMs(autoplay), 1)

  onCleanup(() => clearInterval(timer))
})

const active = () => stepIndex(shown(), 0, slides.length)

function go(next: number) {
  shown.set(next)
  onIndexChange?.(next)
}

function step(delta: number) {
  go(stepIndex(active(), delta, slides.length))
}

function numbered(text: string, position: number) {
  return text.replaceAll('{n}', String(position + 1)).replaceAll('{count}', String(slides.length))
}
---
section(part="root" {...rest} ref={ref} aria-roledescription="carousel" aria-label={label} onPointerEnter={() => pointed.set(true)} onPointerLeave={() => pointed.set(false)} onFocusIn={() => focused.set(true)} onFocusOut={() => focused.set(false)})
  div(part="viewport" style={`aspect-ratio: ${ratio}`} aria-live={autoplay ? 'off' : 'polite'})
    for slide, position of slides key={slide.src}
      div(part="slide" role="group" aria-roledescription="slide" aria-label={numbered(slideLabel, position)} aria-hidden={position === active() ? undefined : 'true'} inert={position !== active()} style={`transform: translateX(${(position - active()) * 100}%)`})
        // kay-allow unsized-image
        img(part="image" src={slide.src} alt={slide.alt} loading={position === 0 ? 'eager' : 'lazy'})
  if slides.length > 1
    div(part="controls")
      IconButton(icon="chevron" label={previousLabel} variant="ghost" part="step" data-side="previous" onClick={() => step(-1)})
      for slide, position of slides key={slide.src}
        button(part="dot" type="button" aria-label={numbered(dotLabel, position)} aria-current={position === active() ? 'true' : undefined} onClick={() => go(position)})
      IconButton(icon="chevron" label={nextLabel} variant="ghost" part="step" data-side="next" onClick={() => step(1)})
      if autoplay
        IconButton(icon={paused() ? 'play' : 'pause'} label={paused() ? playLabel : pauseLabel} variant="ghost" part="pause" onClick={() => paused.set(!paused())})
