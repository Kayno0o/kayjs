---
import type { JSX } from 'kay'
import type { IconProps } from 'kay/icons'
import { recipe } from 'kay'
import type { IconSlot } from './defaults'
import Icon from './icon.kay'

const look = recipe({
  parts: {
    root: 'kui-badge inline-flex items-center gap-1 border-solid bg-surface px-1.5 py-px text-xs tracking-normal whitespace-nowrap [border-color:var(--_badge-color,var(--color-border))] [border-width:var(--border-width)] [color:var(--_badge-color,var(--color-muted))] [font-family:inherit] [text-transform:none] data-stamp:bg-[var(--color-background)] data-stamp:px-2.5 data-stamp:py-1 data-stamp:font-mono data-stamp:text-[0.625rem]/[1.4] data-stamp:font-normal data-stamp:tracking-[0.14em] data-stamp:uppercase data-stamp:transition-colors data-stamp:duration-150 data-stamp:[border-color:var(--_badge-color,var(--color-foreground))] data-stamp:[border-width:var(--border-width)] data-stamp:[color:var(--_badge-color,var(--color-foreground))] group-hover:data-stamp:bg-[var(--color-surface-strong)] data-solid:[background-color:var(--_badge-color,var(--color-muted))] data-solid:[border-color:var(--_badge-color,var(--color-muted))] data-solid:[color:var(--color-accent-foreground)]',
    icon: 'size-3',
  },
  // A tone sets one variable that the base colours read, so no tone class has to beat a neutral colour of the base.
  variants: {
    tone: {
      neutral: '',
      accent: '[--_badge-color:var(--color-accent)]',
      success: '[--_badge-color:var(--color-success)]',
      warning: '[--_badge-color:var(--color-warning)]',
      danger: '[--_badge-color:var(--color-danger)]',
      info: '[--_badge-color:var(--color-info)]',
    },
  },
  defaults: { tone: 'neutral' },
})

const { tone = 'neutral', variant, icon, label, ...rest } = props<Omit<JSX.IntrinsicElements['span'], 'class'> & {
  icon?: IconSlot | IconProps | undefined
  label?: string | number | undefined
  // `outline` is a hairline in the tone. `solid` is filled with the tone, its text in `--color-accent-foreground`. `stamp` is a rubber stamp: a hairline in its text colour, small spaced capitals, filled again while a `.group` holding it is hovered.
  variant?: 'outline' | 'solid' | 'stamp' | undefined
}>()

const stamped = () => variant === 'stamp'
const filled = () => variant === 'solid'
---
// A label that does nothing: a count, a status, a tag.
span({...rest} data-tone={tone} data-stamp={stamped() ? '' : undefined} data-solid={filled() && !stamped() ? '' : undefined})
  if icon
    Icon(icon={icon} part="icon")
  | {label}
  slot
