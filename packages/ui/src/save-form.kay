--- <Output>
import type { Action, Answer, FailureData, JSX, Success } from 'kay'
import { carrySchema, effect, guardLeave, onCleanup, onMount, recipe, shortcut, signal } from 'kay'
import Button from './button.kay'
import type { FormValidation } from './forms'

import { callAction, checkSchema, checkSent, formIssues, leftField, showIssues } from './forms'
import { holdDefaults, onFormReset } from './form-reset'
import { toast } from './toast'
import { wording } from 'kay/words'

const look = recipe({ parts: { root: 'kui-save-form', grid: 'kui-form-grid', bar: 'kui-save-bar', status: 'kui-save-bar-status', actions: 'kui-save-bar-actions', confirm: '' } })

const { action, refused, saved, onSave, onError, onDiscard, dirty, save, status, failureLabel, validate = false, onFocusOut, dirtyLabel = wording('ui.saveForm.dirty', 'Unsaved changes.'), cleanLabel = wording('ui.saveForm.clean', 'No unsaved change.'), savingLabel = wording('ui.saveForm.saving', 'Saving…'), saveLabel = wording('ui.saveForm.save', 'Save'), discardLabel = wording('ui.saveForm.discard', 'Discard'), cancelLabel = wording('ui.saveForm.cancel', 'Cancel'), cancelHref, confirm, confirmLabel, saveDisabled, shortcut: saveKeys = 'mod+s', ...rest } = props<Omit<JSX.IntrinsicElements['form'], 'class' | 'action' | 'children' | 'onSubmit' | 'onInput' | 'onChange' | 'onError'> & {
  // The page's action the form calls with its fields, as FormDialog does. An editor whose state is signals gives `dirty` and `save` instead.
  action?: Action<never, Output> | undefined
  // Toasted when the call fails other than on a field, or when `save` rejects.
  failureLabel?: string | undefined

  // Checks the fields against `action`'s schema in the browser, as the server would, with the same messages shown on their FormField: `'submit'` when Save is pressed, with nothing called while a field is refused, `'blur'` also each field as it loses focus; `false` (the default) leaves it to the server. Not read with `save`.
  validate?: FormValidation
  // Whether the editor holds unsaved changes, when its state is the app's own signals rather than named fields: the bar, the leave guard and Save follow it instead of the fields, so `dirty={isNew || changed()}` lets a new item save with no change.
  dirty?: boolean | undefined
  // Called by Save, the shortcut included, instead of `action`: answer the call's promise. A rejection is handled as an action's refusal is (`refused`, the messages on their FormField, `failureLabel`); `false` is a refusal the app shows itself, and either leaves the bar unsaved. `onSave` is for `action` only. The app clears `dirty` once it has saved.
  save?: (() => Promise<unknown>) | undefined
  // Replaces the status line, whatever the form's state.
  status?: string | undefined
  // What a refusal of the action's handler says, as FormDialog's `refused`.
  refused?: ((data: FailureData<Output>) => Record<string, string> | string | undefined) | undefined
  // Toasted as a success once the action has run.
  saved?: string | undefined
  // What the action returned, for the page to patch into what it shows. The form is clean again once it has run.
  onSave?: ((result: Answer<Success<Output>>) => unknown) | undefined
  // Called with `{ error }` before the toast: the `ActionError` of a refusal (its `errors` by field, its `data`), or whatever the call threw. For logging, or to scroll to the first bad field.
  onError?: ((failure: { error: unknown }) => unknown) | undefined
  // Called after Discard has put the controls back to their initial values, for state the page keeps beyond them: the library's controls and their `onChange` need nothing from it.
  onDiscard?: (() => unknown) | undefined
  // The bar's texts: unsaved changes, nothing to save, the save under way, and the two buttons.
  dirtyLabel?: string | undefined
  cleanLabel?: string | undefined
  savingLabel?: string | undefined
  saveLabel?: string | undefined
  discardLabel?: string | undefined
  // The bar's Cancel link, before Discard, for a new item whose editor has nothing to go back to but the page it came from. Leaving with unsaved changes asks, as for any link.
  cancelHref?: string | undefined
  cancelLabel?: string | undefined
  // A question asked in a dialog before saving, Ctrl+S included, for a save with a consequence: Save runs only once it is confirmed, the dialog's button saying `confirmLabel` (`saveLabel` by default).
  confirm?: string | undefined
  confirmLabel?: string | undefined
  // Keeps Save off while the app says the draft cannot be saved, such as an invalid one; the string is the reason, shown as Save's tooltip, which the keyboard reaches too. The shortcut is off with it.
  saveDisabled?: string | boolean | undefined
  // The keys that save, `mod+s` (Ctrl or Cmd with S) by default; `false` binds none. Written as kay's `shortcut` takes them.
  shortcut?: string | false | undefined
}>()

const issues = signal<Record<string, string>>({})
const changed = signal(false)
const saving = signal(false)
const asking = signal(false)
const checking = signal(false)
// The dialog of `confirm`, a chunk of its own fetched once there is a question to ask, held in a list of at most one component.
const failureText = () => failureLabel ?? wording('ui.saveForm.failure', 'Could not save.')
const confirmView = signal<(typeof import('./internal/save-confirm.kay'))['default'][]>([])
// The fetch of that chunk, under way or done; unset again when it failed.
let confirmLoad: Promise<void> | undefined
// Set by the dialog's confirm, so the submit it asks for goes through without asking again.
let confirmed = false
let form: HTMLFormElement | undefined
// What the controls held when they were last clean, as text.
let baseline = ''

formIssues.provide(issues)

if (validate !== false && action && !save)
  carrySchema(action)

// Follows `confirm`, which a parent may set after mount.
effect(() => {
  if (confirm !== undefined)
    confirmLoad ??= loadConfirm()
})

async function loadConfirm() {
  try {
    confirmView = [(await import('./internal/save-confirm.kay')).default]
  }
  catch (error) {
    console.error('kayjs-ui: a SaveForm\'s confirmation could not be loaded', error)
    confirmLoad = undefined

    // A preload fails quietly: only a Save waiting on the question says it cannot be asked.
    if (asking()) {
      asking = false
      toast.error(failureText())
    }
  }
}

function snapshot() {
  return JSON.stringify([...new FormData(form)].map(([name, value]) => [name, typeof value === 'string' ? value : [value.name, value.size, value.lastModified]]))
}

// What each control holds now, which becomes its default once saved, the library's signal-driven ones included: a Discard then goes back to the saved values, not to the ones first rendered. The controls are read through the prototype, as a control named `elements` takes their list's place on the form.
function values(): () => void {
  const held = [...Reflect.get(HTMLFormElement.prototype, 'elements', form!)].map((control): (() => void) => {
    // The search box of an IconPicker or a MultiSelect is no saved value: a reset empties it.
    if (control.hasAttribute('data-kui-search'))
      return () => undefined

    if (control instanceof HTMLInputElement || control instanceof HTMLTextAreaElement) {
      const { value } = control
      const checked = control instanceof HTMLInputElement && control.checked

      return () => {
        control.defaultValue = value

        if (control instanceof HTMLInputElement)
          control.defaultChecked = checked
      }
    }

    if (control instanceof HTMLSelectElement) {
      const picked = [...control.options].map(option => option.selected)

      return () => {
        for (const [index, option] of [...control.options].entries())
          option.toggleAttribute('selected', picked[index] ?? false)
      }
    }

    return () => undefined
  })

  const adoptSignals = holdDefaults(form!)

  return () => {
    for (const keep of held)
      keep()

    adoptSignals()
  }
}

const isDirty = () => dirty ?? changed()
const busy = () => saving() || checking() || action?.pending() === true

function check() {
  if (dirty === undefined)
    changed = snapshot() !== baseline
}

let queued = false

// What an input, a change and a mutation of the same keystroke each ask for, read once after them: the snapshot serializes every control of the form.
function checkSoon() {
  if (queued)
    return

  queued = true
  queueMicrotask(() => {
    queued = false
    check()
  })
}

// A reset the bar did not start, from a reset button among the fields, leaves the form clean too, once the controls driven by signals have followed.
onFormReset(() => form, check, true)

// Leaving asks while there are unsaved changes, but not while a save is under way: it may be what takes the page elsewhere.
guardLeave(() => isDirty() && !busy())

// A control added or removed changes what the form holds without an input event.
onMount(() => {
  baseline = snapshot()
  // The controls inside mount after the form does, and one that settles its fields as it runs (a DateTimeInput writing the visitor's clock) has done so by the next microtask: that is what a clean form holds, unless it changed since.
  queueMicrotask(() => {
    if (dirty === undefined) {
      baseline = snapshot()
      check()
    }
  })

  const observer = new MutationObserver(checkSoon)

  observer.observe(form!, { childList: true, subtree: true, attributes: true, attributeFilter: ['value', 'checked', 'selected', 'disabled'] })
  onCleanup(() => observer.disconnect())
})

async function submit(event: SubmitEvent) {
  event.preventDefault()

  // Read at once, so a submit that returns early below leaves no confirmation for the next one.
  const sure = confirmed

  confirmed = false

  if (busy() || !form || !(dirty ?? snapshot() !== baseline))
    return

  if ((!action && !save) || saveDisabled)
    return

  // Before any question is asked: a form the schema refuses is not worth one.
  if (action && !save && validate !== false && !(await checkSent(form, action, issues, failureText(), checking)))
    return

  if (confirm !== undefined && !sure) {
    // The dialog opens once its chunk is there, fetched again by this press when it failed, as a save that needs the question must not go through unasked. Awaiting it keeps the form and its Save busy meanwhile.
    asking = true
    await (confirmLoad ??= loadConfirm())

    return
  }

  // Edits made while the save is under way stay unsaved.
  const sent = dirty === undefined ? snapshot() : ''
  const adopt = values()
  let done: Awaited<ReturnType<typeof callAction>>

  const run = save

  if (run) {
    saving = true

    try {
      done = await callAction(form, (() => run()) as unknown as Action<never, Output>, issues, failureText(), refused, onError)
    }
    finally {
      saving = false
    }

    // A refusal the app shows itself.
    if (done?.result === false)
      return
  }
  else {
    done = await callAction(form, action!, issues, failureText(), refused, onError)
  }

  if (!done)
    return

  issues = {}
  await showIssues(form, {})
  baseline = sent
  adopt()
  check()

  if (saved)
    toast.success(saved)

  if (!run)
    onSave?.(done.result as Answer<Success<Output>>)
}

// The form's methods are called through its prototype, as a control named `requestSubmit` or `reset` takes their place on the form.
function requestSubmit() {
  if (form)
    HTMLFormElement.prototype.requestSubmit.call(form)
}

function confirmSave() {
  asking = false
  confirmed = true
  requestSubmit()
  // A form that is invalid fires no submit to take it.
  confirmed = false
}

async function discard() {
  if (busy())
    return

  if (form)
    HTMLFormElement.prototype.reset.call(form)

  issues = {}
  // A question still being fetched is not asked of the changes discarded.
  asking = false
  onDiscard?.()
  check()

  if (form)
    await showIssues(form, {})
}

async function leave(event: FocusEvent) {
  onFocusOut?.(event as never)

  const field = leftField(event)

  if (validate === 'blur' && action && form && field !== undefined)
    await checkSchema(form, action, issues, '', field)
}

// Ctrl or Cmd with S saves unless `shortcut` says otherwise, the browser's own save dialog kept away even when there is nothing to save.
shortcut(() => saveKeys || null, requestSubmit, { on: () => form })
---
form(part="root" {...rest} ref={element => form = element} onSubmit={submit} onInput={checkSoon} onChange={checkSoon} onFocusOut={validate === 'blur' || onFocusOut ? leave : undefined})
  div(part="grid")
    slot
  div(part="bar")
    // Announced as it changes, so a screen reader hears the changes pile up, the save start and the form come back clean.
    p(part="status" role="status" data-dirty={isDirty() || undefined}) {status ?? (busy() ? savingLabel : isDirty() ? dirtyLabel : cleanLabel)}
    div(part="actions")
      // `aria-disabled` rather than `disabled`, so the button pressed keeps the focus as the form turns clean.
      if cancelHref !== undefined
        Button(label={cancelLabel} href={cancelHref})
      Button(label={discardLabel} aria-disabled={!isDirty() || busy() || undefined} onClick={discard})
      Button(label={saveLabel} type="submit" tone="accent" busy={busy()} aria-disabled={!isDirty() || busy() || Boolean(saveDisabled) || undefined} data-tooltip={(typeof saveDisabled === 'string' && saveDisabled) || undefined})
  if confirm !== undefined
    for View of confirmView() key={View}
      View(open={asking()} title={confirmLabel ?? saveLabel} cancelLabel={cancelLabel} confirmLabel={confirmLabel ?? saveLabel} onCancel={() => asking = false} onConfirm={confirmSave})
        p(part="confirm") {confirm}
