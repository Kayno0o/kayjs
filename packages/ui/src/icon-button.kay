---
import type { JSX } from 'kay'
import type { IconProps } from 'kay/icons'
import type { IconSlot } from './defaults'
import Icon from './icon.kay'

const { icon, label, size = 'md', variant = 'solid', tone, type = 'button', class: className, ...rest } = props<Omit<JSX.IntrinsicElements['button'], 'type' | 'class' | 'children'> & {
  icon: IconSlot | IconProps
  // Names the action for screen readers and, as its tooltip, for everyone else, since the button shows nothing but the icon.
  label: string
  size?: 'xs' | 'sm' | 'md' | 'lg' | undefined
  // The form: `solid` is the framed button, `ghost` has no frame until hovered and `inline` is the icon alone. `danger` is deprecated: use `tone="danger"`.
  variant?: 'solid' | 'ghost' | 'inline' | 'danger' | undefined
  // What the button means: `accent` for the main action, `danger` for a destructive one.
  tone?: 'neutral' | 'accent' | 'danger' | undefined
  type?: 'button' | 'submit' | 'reset' | undefined
  class?: string | undefined
}>()

// The deprecated `danger` variant was a framed, solid button in the danger tone.
const form = () => variant === 'danger' ? 'solid' : variant
const meant = () => tone ?? (variant === 'danger' ? 'danger' : 'neutral')
// Only the solid form is framed by the shell's hairline.
const framed = () => form() === 'solid'
---
button.kui-icon-btn({...rest} type={type} aria-label={label} data-tooltip={label} data-size={size} data-variant={form()} data-tone={meant()} class={[{ 'kui-shell': framed(), 'kui-shell-danger': framed() && meant() === 'danger' }, className]})
  Icon(icon={icon})
