---
import MapView from '@kaynooo/kayjs-ui/map-view.kay'

const legs = {
  Louvre: [[48.8606, 2.3376], [48.8530, 2.3499]],
  Cite: [[48.8530, 2.3499], [48.8462, 2.3372]],
}
const route = [[48.8584, 2.2945], [48.8606, 2.3376], [48.8530, 2.3499], [48.8462, 2.3372]]
const picked = signal<keyof typeof legs | null>(null)
---
.flex.flex-col.gap-2.max-w-xl
  .flex.gap-2
    for name of Object.keys(legs) key={name}
      button.rounded.border.border-muted.px-3.py-1(type="button" onClick={() => picked.set(name as keyof typeof legs)}) {name}
    button.rounded.border.border-muted.px-3.py-1(type="button" onClick={() => picked.set(null)}) All
  MapView(label="A walk through Paris" lines={[route]} highlight={picked() ? legs[picked()!] as [number, number][] : undefined})
