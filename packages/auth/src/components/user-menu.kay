---
import type { JSX } from 'kay'
import { ctx } from 'kay'
import { localize } from 'kay/i18n'
import { wording } from 'kay/words'
import { currentViewer } from '../viewer'
import SignInLink from './sign-in-link.kay'
import SignOutButton from './sign-out-button.kay'

// `account={false}` leaves out the link to the account page, as the account page itself does, and `signIn={false}` the sign-in link a visitor sees. `redirect` is where a sign-out goes; children follow the account link; attributes go on the wrapper.
const { account = true, signIn = true, redirect, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class'> & { account?: boolean, signIn?: boolean, redirect?: string | undefined }>()
const features = currentViewer().auth.features()
const accountPage = features.pages ? localize(`${features.pages.prefix}/account`) : null
---
if ctx.user then found
  .kayjs-auth.flex.flex-wrap.items-center.gap-3(part="root" {...rest})
    span.text-muted {found.username ?? found.email}
    if account && accountPage
      a(href={accountPage}) {wording('auth.account.title', 'Your account')}
    slot
    SignOutButton(redirect={redirect})
else if signIn
  .kayjs-auth.flex.flex-wrap.items-center.gap-3(part="root" {...rest})
    SignInLink
