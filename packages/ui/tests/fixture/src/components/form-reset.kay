---
import { signal, trustHtml } from 'kay'
import Checkbox from '@kayjs/ui/checkbox.kay'
import ChipGroup from '@kayjs/ui/chip-group.kay'
import IconPicker from '@kayjs/ui/icon-picker.kay'
import MarkdownEditor from '@kayjs/ui/markdown-editor.kay'
import MultiSelect from '@kayjs/ui/multi-select.kay'
import DateRangeInput from '@kayjs/ui/date-range-input.kay'
import RangeInput from '@kayjs/ui/range-input.kay'
import Segmented from '@kayjs/ui/segmented.kay'
import Select from '@kayjs/ui/select.kay'
import Textarea from '@kayjs/ui/textarea.kay'
import TextInput from '@kayjs/ui/text-input.kay'
import Toggle from '@kayjs/ui/toggle.kay'
import type { DateRange, IconChoice, RangeValue } from '@kayjs/ui'

// Every signal-driven control of the library, each one's value kept in a signal of the page and printed in `#state`, so a reset shows whether the page heard of it.
// A page renders it without a `search`, and the icons are then the two it knows.
const { search = async () => ['star', 'moon'].map(name => ({ name, icon: { 'viewBox': '0 0 24 24', 'width': '1em', 'height': '1em', 'aria-hidden': 'true', 'innerHTML': trustHtml(`<path data-icon="${name}"/>`) } })) } = props<{ search?: (query: string, limit: number) => Promise<IconChoice[]> }>()

const agree = signal(true)
const power = signal(false)
const decks = signal(['films'])
const size = signal<'s' | 'm' | 'l' | null>('m')
const sort = signal<'s' | 'm' | 'l' | null>(null)
const level = signal<'a' | 'b' | 'c'>('b')
const tags = signal<('x' | 'y' | 'z')[]>(['x', 'y'])
const title = signal('Ada')
const bio = signal('Hello')
const notes = signal('# Notes')
const range = signal<RangeValue>([2, 8])
const stay = signal<DateRange>(['2026-10-01', '2026-10-05'])
const icon = signal('star')
const free = signal(false)
const bare = signal('star')
const heard = signal('b')
const refd = signal(false)
const formName = signal('x')
const options = [{ value: 'films', label: 'Films' }, { value: 'games', label: 'Games' }, { value: 'books', label: 'Books' }] as const
const sizes = [{ value: 's', label: 'S' }, { value: 'm', label: 'M' }, { value: 'l', label: 'L' }] as const
const levels = [{ value: 'a', label: 'A' }, { value: 'b', label: 'B' }, { value: 'c', label: 'C' }] as const
const choices = [{ value: 'x', label: 'X' }, { value: 'y', label: 'Y' }, { value: 'z', label: 'Z' }] as const
---
form#form
  Checkbox(name="agree" label="Agree" checked={agree()} onChange={({ checked }) => agree = checked})
  Toggle(name="power" label="Power" checked={power()} onChange={({ checked }) => power = checked})
  Checkbox(inputProps={{ id: "free" }} label="Free" onChange={({ checked }) => free = checked})
  ChipGroup(label="Decks" name="decks" options={options} value={decks()} onChange={({ value }) => decks = value})
  Segmented(label="Size" name="size" options={sizes} value={size()} onChange={({ value }) => size = value})
  Segmented(label="Sort" name="sort" options={sizes} value={sort()} onChange={({ value }) => sort = value})
  TextInput#formname(name="form" value={formName()} onInput={({ value }) => formName = value})
  Select#level(name="level" options={levels} value={level()} onChange={({ value }) => level = value})
  MultiSelect(label="Tags" name="tags" options={choices} value={tags()} onChange={({ value }) => tags = value})
  TextInput#title(name="title" value={title()} onInput={({ value }) => title = value})
  Textarea#bio(name="bio" value={bio()} onInput={({ value }) => bio = value})
  MarkdownEditor#notes(value={notes()} onInput={({ value }) => notes = value})
  RangeInput(label="Range" value={range()} onChange={({ value }) => range = value})
  DateRangeInput#stay(label="Stay" value={stay()} onChange={({ value }) => stay = value})
  IconPicker#named(name="icon" value={icon()} items={({ q, limit }) => search(q, limit)} onChange={({ value }) => icon = value})
  IconPicker#bare(value={bare()} items={({ q, limit }) => search(q, limit)} onChange={({ value }) => bare = value})
  Select#fixed(options={levels} value="b" onChange={({ value }) => heard = value} ref={() => refd = true})
  button#reset(type="reset") Reset
p#state {JSON.stringify({ agree: agree(), power: power(), free: free(), decks: decks(), size: size(), sort: sort(), level: level(), tags: tags(), title: title(), bio: bio(), notes: notes(), range: range(), stay: stay(), icon: icon(), bare: bare(), heard: heard(), refd: refd(), form: formName() })}
