---
import { infiniteList } from '@kayjs/ui'
import LoadMore from '@kayjs/ui/load-more.kay'
import Table from '@kayjs/ui/table.kay'

const { onLoad, onSelect } = props<{
  onLoad: (offset: number) => Promise<{ id: number, name: string }[] | undefined>
  onSelect: (keys: unknown[]) => void
}>()

const feed = infiniteList([{ id: 1, name: 'Io' }, { id: 2, name: 'Europa' }], { limit: 2, key: row => row.id, load: ({ offset }) => onLoad(offset) })
---
button.more(type="button" onClick={feed.more}) More
Table(columns={[{ key: 'name', header: 'Name' }]} rows={feed.rows()} rowKey="id" selectable onSelectedChange={onSelect})
LoadMore(list={feed})
