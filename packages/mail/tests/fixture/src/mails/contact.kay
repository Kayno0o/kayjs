---
import type { MailField } from '@kayjs/mail'
import Fields from '@kayjs/mail/fields.kay'
import Heading from '@kayjs/mail/heading.kay'
import Layout from '@kayjs/mail/layout.kay'
import Quote from '@kayjs/mail/quote.kay'

const { fields, message } = props<{ fields: MailField[], message: string }>()
---
Layout
  Heading A message from the site
  Fields(fields={fields} empty="not given")
  Quote(text={message})
