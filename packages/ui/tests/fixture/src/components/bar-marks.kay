---
island({ render: 'client' })
import BarChart from '@kayjs/ui/bar-chart.kay'
import LineChart from '@kayjs/ui/line-chart.kay'
import Sparkline from '@kayjs/ui/sparkline.kay'
import ContributionGraph from '@kayjs/ui/contribution-graph.kay'
import ScatterChart from '@kayjs/ui/scatter-chart.kay'

const { heard, steered = null } = props<{ heard: unknown[], steered?: number | null }>()
---
div
  BarChart#pressable(labels={['a', 'b', 'c']} series={[{ name: 'Runs', values: [1, 2, 3] }]} label="Pressable" onSelect={({ item: mark }) => heard.push(mark)} onActiveChange={({ index }) => heard.push(index)})
  BarChart#steered(labels={['a', 'b']} series={[{ name: 'Runs', values: [1, 2] }]} label="Steered" active={steered})
  BarChart#links(labels={['a', 'b']} series={[{ name: 'Runs', values: [1, 2] }]} label="Links" href={mark => mark.index === 0 ? '#first' : undefined} onSelect={({ item: mark }) => heard.push(mark.label)})
  BarChart#tipped(labels={['a', 'b']} series={[{ name: 'Runs', values: [1, 2] }]} label="Tipped")
    @tooltip(mark)
      p.own {mark.label}!
  Sparkline#spark(values={[1, 3, 2]} label="Spark" hints={['one', 'three', 'two']} onSelect={({ item: mark }) => heard.push(mark)} href={mark => mark.index === 2 ? '#two' : undefined} onActiveChange={({ index }) => heard.push(`spark:${index}`)})
  Sparkline#trend(variant="area" values={[1, null, 2, 3]} label="Trend" hints={['one', 'none', 'two', 'three']} onSelect={({ item: mark }) => heard.push(mark)} onActiveChange={({ index }) => heard.push(`trend:${index}`)})
  ContributionGraph#grid(days={[{ day: '2026-01-05', intensity: 0.5 }, { day: '2026-01-06', intensity: 1 }]} color="#2a9d8f" today="2026-01-06" onSelect={({ item: day }) => heard.push(day.day)} href={day => day.intensity === 1 ? '#full' : undefined})
  ScatterChart#dots(points={[{ key: 'p', label: 'P', x: 1, y: 1 }, { key: 'q', label: 'Q', x: 2, y: 2 }]} label="Dots" href={point => point.key === 'q' ? '#q' : undefined} onSelect={({ item: point }) => heard.push(point.key)} onActiveChange={({ index }) => heard.push(`dot:${index}`)})
    @tooltip(point)
      p.dot {point.label}?
  LineChart#lined(labels={['a', 'b', 'c']} series={[{ name: 'Runs', values: [1, 3, 2] }]} label="Lined" onSelect={({ item: mark }) => heard.push(mark)} onActiveChange={({ index }) => heard.push(`line:${index}`)} active={steered})
  LineChart#linked(labels={['a', 'b', 'c']} series={[{ name: 'Runs', values: [1, 3, 2] }]} label="Linked" href={mark => mark.index === 0 ? 'https://example.com/a' : undefined} newTab)
  Sparkline#spark-steered(values={[1, 3, 2]} label="Spark steered" active={steered})
  ContributionGraph#grid-steered(days={[{ day: '2026-01-05', intensity: 0.5 }, { day: '2026-01-06', intensity: 1 }]} color="#2a9d8f" today="2026-01-06" active={steered})
  ScatterChart#dots-steered(points={[{ key: 'p', label: 'P', x: 1, y: 1 }, { key: 'q', label: 'Q', x: 2, y: 2 }]} label="Dots steered" active={steered})
