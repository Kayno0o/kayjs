---
import type { JSX, Snippet } from 'kay'
import { effect, listen, recipe } from 'kay'
import IconButton from './icon-button.kay'
import { wording } from 'kay/words'

// 'kui-side-panel' stays as the component's name for an app's CSS and the always-hidden guard; theme.css still has its old rule until 1.74, and keeps the docked panel's shadow for good.
// A dialog shown with show(), beside the page, is positioned absolute and sits in the page, so it is fixed to the edge and above the page.
const look = recipe({
  parts: {
    root: 'kui-side-panel inset-y-0 right-0 left-auto m-0 flex h-dvh max-h-dvh w-full max-w-[min(42rem,100vw)] flex-col overflow-hidden border-0 border-solid border-l-[length:var(--kui-border-width,var(--border-width))] border-border-strong bg-surface p-0 text-foreground [transition:translate_0.2s_ease-out,overlay_0.2s_allow-discrete,display_0.2s_allow-discrete] open:starting:[translate:100%_0] [&:not([open])]:[translate:100%_0] backdrop:bg-black/50 data-[modal=false]:fixed data-[modal=false]:z-30',
    head: 'flex shrink-0 items-center gap-2 border-b border-border px-5 py-3',
    title: 'min-w-0 flex-1 truncate text-lg [font-weight:var(--font-weight-kui-heading,var(--font-weight-semibold))] tracking-label text-foreground [font-family:var(--font-label,var(--font-kui-body,inherit))] [text-transform:var(--label-case)]',
    body: 'min-h-0 flex-1 overflow-y-auto px-5 py-4',
    footer: 'flex shrink-0 flex-wrap justify-end gap-2 border-t border-border px-5 py-4',
  },
})

const { open, title, actions, footer, modal = true, closeHref, onOpenChange, closeLabel = wording('ui.sidePanel.close', 'Close'), ...rest } = props<Omit<JSX.IntrinsicElements['dialog'], 'open' | 'class' | 'title' | 'onClose' | 'closedby' | 'closedBy'> & {
  // Shows the panel along the edge, as a modal unless `modal` is false; the parent sets it back to false in `onOpenChange`.
  open: boolean
  title: string
  // Controls in the head line, before its close button, such as previous and next.
  actions?: Snippet
  footer?: Snippet
  closeLabel?: string | undefined
  // `false` shows the panel beside the page instead of over it: the page under it stays interactive, a click outside leaves it open and only Escape or the close control closes it. It renders open on the server, so a page driven by the URL shows it with no JavaScript.
  modal?: boolean | undefined
  // Makes the close control a link to this URL, for a panel open on the server whose close needs no JavaScript; the link navigates and `onOpenChange(false)` is called as well, so its handler need not navigate.
  closeHref?: string | undefined
  // Called with `false` however the panel closes, a click outside and Escape included. Closed by either of those or its close button, its content is still there to read; closed by the parent, it is already gone.
  onOpenChange: (open: boolean) => unknown
}>()

let panel: HTMLDialogElement | undefined

effect(() => {
  const shown = open

  if (!panel)
    return

  if (shown && !panel.open) {
    if (modal)
      panel.showModal()
    else
      panel.show()
  }
  else if (!shown && panel.open) {
    panel.close()
  }
})

// What the server renders, so a page driven by the URL shows the panel open before any script runs; the client opens and closes it with `show()` and `close()`.
const renderedOpen = !modal && open

// A browser with `closedby` closes a non-modal panel on Escape, stacked with the layers above it. Without it the panel listens itself, and leaves an Escape that belongs to a modal dialog or an open popover.
listen(document, 'keydown', event => {
  if (event.key !== 'Escape' || modal || !open || event.defaultPrevented || event.isComposing || 'closedBy' in HTMLDialogElement.prototype)
    return

  if (!document.querySelector(':modal, :popover-open'))
    panel?.close()
})
---
// Named by its title for screen readers. Every way of closing it ends in the dialog's `close` event, the close button included, so `onOpenChange` is the one place the parent learns of it.
dialog(part="root" aria-label={title} {...rest} open={renderedOpen} data-modal={modal ? undefined : 'false'} ref={element => panel = element} closedby={modal ? 'any' : 'closerequest'} onClose={() => onOpenChange(false)})
  if open
    header(part="head")
      h2(part="title") {title}
      | {actions}
      IconButton(icon="close" label={closeLabel} variant="ghost" href={closeHref} onClick={() => panel?.close()})
    div(part="body")
      slot
    if footer
      div(part="footer")
        | {footer}
