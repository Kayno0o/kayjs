---
import type { JSX } from 'kay'
import type { LabelFormat } from './chart-axis'
import type { BarSeries } from './plot'
import { memo, recipe, signal } from 'kay'
import { headings, labelTimes, tickIndices, tickTexts } from './chart-axis'
import { barRatios, PALETTE, steppedPoint, valueTicks } from './plot'
import { wording } from 'kay/words'

const look = recipe({
  parts: {
    // The plot leaves its left margin for the value labels, which hang outside it as they do in a ScatterChart.
    root: 'kui-bar-chart m-0 flex flex-col gap-2 pt-2 pr-3',
    plot: 'relative ml-10 h-[var(--chart-height,var(--kui-bar-chart-height,12rem))] border-solid border-[length:var(--kui-border-width,var(--border-width))] border-border border-t-transparent border-r-transparent border-l-transparent',
    grid: 'absolute inset-x-0 h-px bg-border',
    tick: 'absolute right-full mr-2 -translate-y-1/2 text-2xs whitespace-nowrap text-[var(--color-kui-overlay1,var(--color-muted))] tabular-nums',
    columns: 'absolute inset-0 flex gap-1',
    column: 'flex min-w-0 flex-1 items-end gap-px outline-none hover:bg-surface focus-visible:outline-2 focus-visible:outline-foreground data-stacked:flex-col-reverse data-stacked:items-stretch data-stacked:justify-start data-stacked:gap-0',
    // A stub is the mark a column keeps where its series gives it a colour or a note but no height; a stacked bar is squared and sized by its height alone.
    bar: 'min-h-px min-w-px flex-1 rounded-t-sm data-stub:h-1 data-stacked:flex-none data-stacked:rounded-none',
    axis: 'ml-10 flex gap-1',
    axisLabel: 'flex min-w-0 flex-1 justify-center text-2xs whitespace-nowrap text-[var(--color-kui-overlay1,var(--color-muted))]',
    legend: 'm-0 flex list-none flex-wrap gap-4 p-0 pl-1',
    legendItem: 'flex items-center gap-1.5 text-xs text-muted',
    key: 'size-2 shrink-0',
  },
})

const { labels, series, formatValue = (value: number) => value.toLocaleString(), formatLabel, xLabels = false, stacked = false, totalLabel = wording('ui.barChart.total', 'Total'), legend, emptyLabel, label, ...rest } = props<Omit<JSX.IntrinsicElements['figure'], 'class' | 'children'> & {
  labels: string[]
  series: BarSeries[]
  // Formats the y-axis labels, the tooltips and the readings screen readers hear.
  formatValue?: ((value: number) => string) | undefined
  // Formats a label for the tooltips, the x-axis and what screen readers hear, as LineChart's: a label that is a date reads in the page's locale by default.
  formatLabel?: LabelFormat | undefined
  // Draws up to five x-axis labels.
  xLabels?: boolean | undefined
  // Piles the series of a label on one bar instead of setting them side by side, and adds a total to its tooltip.
  stacked?: boolean | undefined
  // Names the total a stacked chart adds to its tooltips and announcements.
  totalLabel?: string | undefined
  // Names each series under the chart; shown by default once there is more than one.
  legend?: boolean | undefined
  // What the chart reads with no labels.
  emptyLabel?: string | undefined
  // Names the chart for screen readers.
  label: string
}>()

const ratios = memo(() => barRatios(series.map(item => item.values), stacked, labels.length))
const ticks = memo(() => valueTicks(ratios().top))
const times = memo(() => labelTimes(labels))
const shown = memo(() => new Set(xLabels ? tickIndices(labels.length) : []))
const axisTexts = memo(() => tickTexts(labels, times(), formatLabel))
const headingTexts = memo(() => headings(labels, times(), formatLabel))
const colors = (item: BarSeries, index: number, at: number) => item.colors?.[at] ?? item.color ?? PALETTE[index % PALETTE.length]!

// The bar the keyboard stands at, the latest one until it moves.
const stop = signal<number | null>(null)
const current = () => Math.min(stop() ?? labels.length - 1, Math.max(0, labels.length - 1))

const reading = (item: BarSeries, at: number) => {
  const value = item.values[at]

  return typeof value === 'number' ? formatValue(value) : '-'
}

// What a bar column reads on hover and focus, and to screen readers: the label, each series' reading and the notes the series carry for it.
const summaries = memo(() => labels.map((_, at) => {
  const total = stacked ? [`${totalLabel} ${formatValue(series.reduce((sum, item) => sum + (item.values[at] ?? 0), 0))}`] : []
  const notes = series.map(item => item.notes?.[at]).filter(Boolean)

  return `${headingTexts()[at]}: ${[...series.map(item => `${item.name} ${reading(item, at)}`), ...total].join(', ')}${notes.length > 0 ? `; ${notes.join('; ')}` : ''}`
}))

// A column with no height still shows a stub where its series gives it a note, or a colour with a reading, so a failed run recorded as 0 stands out as much as a long one.
const marked = (item: BarSeries, at: number) => Boolean(item.notes?.[at] || (item.colors?.[at] && typeof item.values[at] === 'number'))

// The arrows walk the columns, one tab stop in all, and Home and End reach either end.
function keyDown(event: KeyboardEvent) {
  if (event.altKey || event.ctrlKey || event.metaKey)
    return

  const next = steppedPoint(event.key, current(), labels.length)

  if (next === undefined || labels.length === 0)
    return

  event.preventDefault()
  stop.set(next)

  const target = (event.currentTarget as HTMLElement).parentElement?.children[next]

  if (target instanceof HTMLElement)
    target.focus()
}

const nothing = () => emptyLabel ?? wording('ui.barChart.empty', 'No data yet.')
---
if labels.length === 0
  // The app's id and class stay on whichever element shows.
  p.kui-bar-chart-empty.text-xs.text-muted(part="root" id={rest.id}) {nothing()}
else
  figure(part="root" {...rest} aria-label={label})
    div(part="plot")
      for tick of ticks() key={tick.ratio}
        span(part="grid" aria-hidden="true" style={`bottom: ${tick.ratio * 100}%`})
          span(part="tick") {formatValue(tick.ratio * ratios().top)}
      div(part="columns")
        for _, at of labels key={at}
          span(part="column" role="img" tabindex={at === current() ? '0' : '-1'} aria-label={summaries()[at]} data-tooltip={summaries()[at]} data-stacked={stacked ? '' : undefined} onKeyDown={keyDown} onFocus={() => stop.set(at)})
            for item, index of series key={item.name}
              if ratios().heights[index]![at]
                span(part="bar" data-stacked={stacked ? '' : undefined} style={`height: ${ratios().heights[index]![at]! * 100}%; background-color: ${colors(item, index, at)}`})
              else if marked(item, at)
                span(part="bar" data-stub data-stacked={stacked ? '' : undefined} style={`background-color: ${colors(item, index, at)}`})
    if xLabels
      div(part="axis" aria-hidden="true")
        for _, at of labels key={at}
          span(part="axisLabel") {shown().has(at) ? axisTexts()[at] : ''}
    if legend ?? series.length > 1
      ul(part="legend")
        for item, index of series key={item.name}
          li(part="legendItem")
            span(part="key" style={`background-color: ${colors(item, index, -1)}`})
            | {item.name}
