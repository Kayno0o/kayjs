---
import Card from '@kayjs/ui/card.kay'
import Frame from './frame.kay'

const { title, landmark = true } = props<{ title: string, landmark?: boolean }>()
---
// A sign-in page's frame: one card, its title the page's heading.
Frame(size="max-w-md" gap="gap-4" landmark={landmark})
  h1.kui-heading-section {title}
  Card
    .flex.flex-col.gap-4
      slot
