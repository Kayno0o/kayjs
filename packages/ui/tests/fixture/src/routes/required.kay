---
import FormField from '@kaynooo/kayjs-ui/form-field.kay'
import RadioGroup from '@kaynooo/kayjs-ui/radio-group.kay'
import ChipGroup from '@kaynooo/kayjs-ui/chip-group.kay'
import Checkbox from '@kaynooo/kayjs-ui/checkbox.kay'
import Toggle from '@kaynooo/kayjs-ui/toggle.kay'
import Segmented from '@kaynooo/kayjs-ui/segmented.kay'
import Rating from '@kaynooo/kayjs-ui/rating.kay'

const plans = [{ value: 'free', label: 'Free' }, { value: 'pro', label: 'Pro' }]
---
main
  form#form(method="post")
    section#framed
      FormField(label="Plan" required)
        input(name="framed" type="radio" value="free")
        input(name="framed" type="radio" value="pro")
      FormField(label="Access" group required)
        input#read(name="access" type="checkbox")
        input#write(name="access" type="checkbox")
      FormField(label="Volume" required)
        input#volume(name="volume" type="range")
    section#own
      RadioGroup#radios(name="plan" options={plans} label="Plan" required)
      Segmented#segmented(name="size" options={plans} label="Size" required)
      Rating#rating(name="stars" label="Stars" required)
      ChipGroup#chips(name="tags" options={plans} label="Tags" required)
      Checkbox#box(name="terms" label="Terms" required)
      Toggle#toggle(name="news" label="News" required)
      RadioGroup#optional(name="other" options={plans} label="Other")
