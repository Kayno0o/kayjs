---
import { elementSize, signal } from 'kay'

const box = elementSize()
const wide = signal(false)
const shown = signal(true)
---
head
  title Size
button.widen(type="button" onClick={() => wide.set(!wide())}) widen
button.swap(type="button" onClick={() => shown.set(!shown())}) swap
p.read {box.width()} x {box.height()}
if shown()
  .box(ref={box.ref} style={`width: ${wide() ? 300 : 120}px; height: 40px; padding: 10px; box-sizing: content-box`}) box
else
  .box.other(ref={box.ref} style="width: 77px; height: 55px") other
