---
import SiteNav from '@kaynooo/kayjs-ui/site-nav.kay'

const links = [{ href: '/ui-demo/site-nav', label: 'Home' }, { href: '/ui-demo/rooms', label: 'Rooms' }, { href: '/ui-demo/about', label: 'About' }]
---
header.flex.items-center.gap-4
  strong Club
  SiteNav(links={links} current="/ui-demo/site-nav" label="Main")
