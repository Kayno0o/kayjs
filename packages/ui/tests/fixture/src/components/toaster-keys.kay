---
import Toaster from '@kaynooo/kayjs-ui/toaster.kay'
import { toast } from '@kaynooo/kayjs-ui'

// A Toaster told its key by `shortcut` or by neither.
const { shortcut } = props<{ shortcut?: string | false | null }>()
---
button#saved(onClick={() => toast.success('Saved')}) Save
Toaster(shortcut={shortcut})
