--- server
import { t } from 'elysia'
import { action } from 'kay'
import { t as translate } from 'kay/i18n'
import { seen } from '../seen'

export const count = action(t.Object({ to: t.Number({ minimum: 0, maximum: 5, error: 'Too many' }) }), async function* ({ to }) {
  for (let at = 1; at <= to; at++)
    yield at
}, { tool: true })

export const dated = action(async function* () {
  yield { at: new Date(0), tags: new Map([['a', 1]]) }
})

// A model's reply, which is awaited as a text and read as parts: awaiting it in the runner would drain it to the last.
export const thenable = action(() => ({
  then: (resolve: (text: string) => void) => void resolve('drained'),
  async* [Symbol.asyncIterator]() {
    yield 'one'
    yield 'one two'
  },
}))

export const empty = action(async function* () {})

export const breaksEarly = action(async function* () {
  throw new Error('early')
})

export const breaksLate = action(async function* () {
  yield 1
  throw new Error('late')
})

export const endless = action(async function* () {
  seen.started++

  try {
    for (let at = 0; ; at++) {
      yield at
      await Bun.sleep(5)
    }
  }
  finally {
    seen.stopped++
  }
})

export const limited = action(async function* () {
  yield 'ok'
}, { rateLimit: { max: 1, window: '1m' } })

export const baked = action(async function* (ctx) {
  ctx.cookies.set('baked', 'yes', { path: '/' })
  yield 'baked'
})

export const language = action(async function* (ctx) {
  yield ctx.locale
})

export const greets = action(async function* (ctx) {
  yield ctx.locale
  await Bun.sleep(5)
  yield translate('nav.home')
})

// Says nothing after its first value until the client goes away.
export const quiet = action(async function* (ctx) {
  try {
    yield 0
    await new Promise(resolve => ctx.request.signal.addEventListener('abort', resolve))
  }
  finally {
    seen.quietStopped++
  }
})

export const slow = action(async function* () {
  try {
    await Bun.sleep(50)
    yield 'late'
  }
  finally {
    seen.slowStopped++
  }
})

export const counted = action(t.Object({ fail: t.Boolean() }), async function* ({ fail }) {
  if (fail)
    throw new Error('before the first value')

  yield 'ok'
}, { rateLimit: { max: 1, window: '1m', count: 'succeeded' } })

export const trapped = action(t.Object({ name: t.String() }), async function* ({ name }) {
  yield name
}, { honeypot: 'website' })

export const pretending = action(t.Object({ name: t.String() }), async function* ({ name }) {
  yield name
}, { honeypot: { field: 'website', pretend: true } })

export const sendsAway = action(async function* (ctx) {
  ctx.redirect('/done')
  yield 'never'
})

// What a library's limit throws as its stream is first read: an error carrying `Symbol.for('kay.refused')`.
function libraryLimit() {
  return Object.assign(new Error('over the limit'), { [Symbol.for('kay.refused')]: { status: 429, retryAfter: 42, message: 'Slow down' } })
}

// An error whose refusal is malformed: a library's mistake or hostile data must not become a header or a success status.
export const libraryBroken = action(t.Object({ refusal: t.Any() }), ({ refusal }) => (async function* () {
  throw Object.assign(new Error('odd'), { [Symbol.for('kay.refused')]: refusal })
})())

export const libraryForbidden = action(() => (async function* () {
  throw Object.assign(new Error('no'), { [Symbol.for('kay.refused')]: { status: 403, retryAfter: 7, message: 'Not you' } })
})(), { messages: { rateLimit: 'Slow down' } })

export const libraryLimited = action(() => (async function* () {
  throw libraryLimit()
})())

export const libraryWorded = action(() => (async function* () {
  throw libraryLimit()
})(), { messages: { rateLimit: wait => `Back in ${wait} s` } })

export const refuses = action(t.Object({ full: t.Boolean() }), async ({ full }, ctx) => {
  if (full)
    return ctx.fail(409, 'Full')

  return (async function* () {
    yield 'room'
  })()
})

const done = count.succeeded()
--- script
import Counter from '../components/counter.kay'
---
h1 Streams
if done
  p.done Last: {done.data}
form(action={count})
  input(field="to")
  button Count
Counter
a.away(href="/other") Away
