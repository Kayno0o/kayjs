--- <Value extends string>
import type { JSX } from 'kay'
import { effect, signal, uid, untrack } from 'kay'
import { changeAccepted } from './change'
import { onFormReset } from './form-reset'

const { options, value, label, name, onChange, class: className, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'children' | 'role' | 'onChange' | 'ref'> & {
  options: readonly { value: Value, label: string }[]
  // The option picked to start with, or `null` for none, such as while what shows matches no option; a group whose parent passes another follows it.
  value: Value | null
  // Names the group for screen readers.
  label: string
  // The radios' name, which the group submits under inside a form; one unique on the page is drawn when none is given.
  name?: string | undefined
  // A promise holds the group busy until it settles, and puts the previous option back when it resolves to false, rejects or throws (logged): a refused change never shows as made.
  // Typed `unknown`, so a callback answering something else, such as `list.push`, still fits.
  onChange?: ((value: Value) => unknown) | undefined
  class?: string | undefined
}>()

// Held as a string: a signal cannot take a type parameter that might be a function.
const group = name ?? uid()
const picked = signal<string | null>(value)
const busy = signal(false)
let root: HTMLElement | undefined
// How often the parent's `value` reached the group, so a change under way knows whether the parent answered it.
let synced = 0

effect(() => {
  picked.set(value)
  synced++
})

const radios = () => [...root?.querySelectorAll<HTMLInputElement>('.kui-segmented-input') ?? []]

// Checks the radio of `wanted` again, in this group only: the binding may never have seen the radio that took the check.
function check(wanted: string | null) {
  for (const radio of radios())
    radio.checked = radio.value === wanted
}

async function pick(next: Value) {
  // A pick while a change is under way takes nothing: the radio checked by the click, a key or a label, is put back.
  if (busy()) {
    check(picked())

    return
  }

  const before = picked()
  const syncedBefore = synced

  picked.set(next)

  // Put back unless the parent set `value` meanwhile, which has the last word.
  if (!(await changeAccepted('Segmented', () => onChange?.(next), busy.set)) && synced === syncedBefore) {
    picked.set(before)
    check(before)
  }
}

// A reset puts the radios back on their defaults, which the app's `onChange` then hears of; a group that started with none picked just shows none.
onFormReset(() => root, () => {
  const next = radios().find(radio => radio.checked)?.value ?? null

  if (next === picked())
    return

  if (next === null)
    picked.set(null)
  else
    void pick(next as Value)
})
---
// Real radios, so the arrow keys move between options and the group submits like any other field.
.kui-segmented({...rest} ref={element => root = element} role="radiogroup" aria-label={label} aria-busy={busy() ? 'true' : undefined} class={className})
  for option of options key={option.value}
    label.kui-segmented-option
      input.kui-segmented-input(ref={element => element.defaultChecked = untrack(() => option.value === value)} type="radio" name={group} value={option.value} checked={picked() === option.value} onChange={() => pick(option.value)})
      span.kui-segmented-label {option.label}
