---
import { signal } from 'kay'
import TextInput from '@kayjs/ui/text-input.kay'

const email = signal('')
const quantity = signal<number | null>(1)
---
.flex.max-w-sm.flex-col.gap-2
  TextInput(
    type="email"
    value={email()}
    onInput={({ value }) => email = value}
    placeholder="you@example.com"
    aria-label="Email"
  )
  TextInput(
    type="number"
    value={quantity()}
    onInput={({ value }) => quantity = value}
    min="1"
    aria-label="Quantity"
  )
