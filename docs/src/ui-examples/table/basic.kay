---
import Table from '@kaynooo/kayjs-ui/table.kay'
import type { Column, SortState } from '@kaynooo/kayjs-ui'

interface Moon {
  id: number
  name: string
  radius: number
}

const moons: Moon[] = [
  { id: 1, name: 'Io', radius: 1822 },
  { id: 2, name: 'Europa', radius: 1561 },
  { id: 3, name: 'Amalthea', radius: 84 },
]

const columns: Column<Moon>[] = [
  { key: 'name', header: 'Name', sortValue: true, cell: true },
  { key: 'radius', header: 'Radius (km)', sortValue: true, align: 'end' },
]

const sort = signal<SortState>()
---
Table(columns={columns} rows={moons} rowKey="id" onSort={sort.set})
  @cell(moon)
    strong {moon.name}
if sort as current
  p.mt-2.text-kui-subtext0 Sorted by {current.key}, {current.direction}.
