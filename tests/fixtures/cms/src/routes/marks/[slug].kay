--- server
import { news } from '../../content.config'

const entry = await news.get(ctx.params.slug) ?? ctx.notFound()
const { Content } = entry

// Holds a draft back, so a test leaves the page while it renders.
if (entry.data.title === 'Slow draft')
  await Bun.sleep(500)
--- script
import Headline from '../../components/headline.kay'
import IslandTitle from '../../components/island-title.kay'
---
h1 {entry.data.title}
Headline(title={entry.data.title})
p Posted as {entry.data.title}
// kay-allow unsized-image
img(src="/cover.png" alt={entry.data.title})
ul
  for tag of entry.data.tags
    li {tag}
textarea Draft: {entry.data.title}
article
  Content
a.away(href="/marks/roadmap") Away
IslandTitle(title={entry.data.title})
  em.slotted {entry.data.title}
