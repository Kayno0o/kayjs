---
import MediaGallery from '@kaynooo/kayjs-ui/media-gallery.kay'
import type { MediaItem } from '@kaynooo/kayjs-ui'

const picture = (hue: number, width: number) => 'data:image/svg+xml,' + encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" width="${width}" height="${width * 9 / 16}"><rect width="100%" height="100%" fill="hsl(${hue} 70% 60%)"/></svg>`)

const items: MediaItem[] = [0, 90, 180, 270].map((hue, index) => ({
  key: index,
  kind: 'image',
  thumb: picture(hue, 120),
  preview: picture(hue, 640),
  full: picture(hue, 1280),
  title: `Picture ${index + 1}`,
}))
---
.max-w-xl
  MediaGallery(items={items})
