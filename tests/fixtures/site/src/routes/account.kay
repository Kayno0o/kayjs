--- server
import { t } from 'elysia'
import { action } from 'kay'

export const remember = action(t.Object({ theme: t.String() }), ({ theme }, ctx) => {
  ctx.cookies.set('theme', theme, { httpOnly: true })

  return ctx.locals.user ?? null
})

const user = ctx.locals.user ?? 'nobody'
const theme = ctx.cookies.get('theme') ?? 'light'
---
p.user {user}
p.theme {theme}
