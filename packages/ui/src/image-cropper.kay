---
import type { CropHandle, CropRect } from '@kaynooo/utils/browser/canvas'
import type { JSX, Snippet } from 'kay'
import { createCenteredCrop, moveCrop, pointerToNatural, resizeCrop } from '@kaynooo/utils/browser/canvas'
import { effect, elementSize, onMount, recipe, signal, untrack } from 'kay'
import { wording } from 'kay/words'

interface ImageSize { width: number, height: number }

const HANDLES: CropHandle[] = ['nw', 'ne', 'sw', 'se']
// How far one arrow press moves or grows the crop, as a share of the image's width.
const KEY_STEP = 0.01
const KEY_STEP_LARGE = 0.1
const DIRECTIONS: Partial<Record<string, [number, number]>> = { ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1] }

const look = recipe({
  parts: {
    root: 'kui-image-cropper flex flex-col gap-2',
    error: 'm-0 p-4 text-sm text-danger',
    stage: 'relative cursor-crosshair touch-none overflow-hidden border-solid border-[length:var(--border-width)] border-border select-none',
    image: 'block h-auto w-full',
    crop: 'absolute cursor-move border-2 border-dashed border-white bg-no-repeat shadow-[0_0_0_9999px_rgba(0,0,0,0.55)] outline-none focus-visible:border-solid focus-visible:border-accent focus-visible:outline-2 focus-visible:outline-solid focus-visible:outline-offset-2 focus-visible:outline-accent',
    gridCols: 'pointer-events-none absolute inset-y-0 right-1/3 left-1/3 border-x border-white/70',
    gridRows: 'pointer-events-none absolute inset-x-0 top-1/3 bottom-1/3 border-y border-white/70',
    // A 16px dot inside a 40px hit area, so a finger can grab a corner.
    handle: 'absolute size-10 before:absolute before:inset-3 before:rounded-full before:border-2 before:border-white before:bg-accent before:content-[""] data-[handle=ne]:-top-5 data-[handle=ne]:-right-5 data-[handle=ne]:cursor-ne-resize data-[handle=nw]:-top-5 data-[handle=nw]:-left-5 data-[handle=nw]:cursor-nw-resize data-[handle=se]:-right-5 data-[handle=se]:-bottom-5 data-[handle=se]:cursor-se-resize data-[handle=sw]:-bottom-5 data-[handle=sw]:-left-5 data-[handle=sw]:cursor-sw-resize',
  },
})

const { src, ratio = 1, minSize = 32, grid = false, alt = '', cropLabel = wording('ui.imageCropper.crop', 'Crop area: arrows move it, Shift and the arrows resize it'), cropText = wording('ui.imageCropper.cropText', '{w} by {h} pixels at {x}, {y}'), errorLabel = wording('ui.imageCropper.error', 'The image could not be loaded.'), crop: given, onCrop, onCropEnd, onLoad, onError, fallback, footer, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'children' | 'onLoad' | 'onError'> & {
  src: string
  // Width over height the crop is locked to; a change centres the crop again.
  ratio?: number | undefined
  // The smallest side of the crop, in natural pixels.
  minSize?: number | undefined
  // A rule-of-thirds overlay inside the crop.
  grid?: boolean | undefined
  alt?: string | undefined
  // Names the crop area for screen readers, with the keys that move it.
  cropLabel?: string | undefined
  // Reads the crop out as it changes, `{w}`, `{h}`, `{x}` and `{y}` standing for its size and place in natural pixels.
  cropText?: string | undefined
  // The crop in the image's natural pixels, to start from and to follow: it is clamped to the image and to `ratio` once the image has decoded (`onCrop` then hears the clamped crop when it differs), and a changed value moves the crop. Left out, the crop is centred; give back what `onCrop` or `onCropEnd` reported to control it.
  crop?: CropRect | undefined
  // The crop in the image's natural pixels, ready for a canvas draw, after every change, a drag's every move included.
  onCrop?: ((crop: CropRect) => unknown) | undefined
  // The crop once a drag that moved it is released, after each arrow press, and after the footer's `reset()`: the moment to save it.
  onCropEnd?: ((crop: CropRect) => unknown) | undefined
  // The image's natural size, once it has decoded.
  onLoad?: ((size: ImageSize) => unknown) | undefined
  // Called when the image does not load; the stage then shows `fallback` or `errorLabel`, until `src` changes.
  onError?: (() => unknown) | undefined
  errorLabel?: string | undefined
  // Replaces `errorLabel` where the image failed.
  fallback?: Snippet | undefined
  // Shown under the image: `@footer(reset)`, where `reset()` centres the crop again.
  footer?: Snippet<[reset: () => void]> | undefined
}>()

const size = signal<ImageSize | undefined>(undefined)
// The stage's width scales the crop onto the screen.
const stageSize = elementSize()
const crop = signal<CropRect>({ x: 0, y: 0, w: 0, h: 0 })
let stage: HTMLDivElement | undefined
let image: HTMLImageElement | undefined
const broken = signal(false)
let drag: { mode: 'move' | CropHandle, pointer: { x: number, y: number }, from: CropRect, moved: boolean } | null = null

const described = () => cropText.replace(/\{([whxy])\}/g, (_, key: 'w' | 'h' | 'x' | 'y') => String(Math.round(crop()[key])))

const scale = () => stageSize.width() / (size()?.width || 1)

function set(next: CropRect) {
  crop = next
  onCrop?.(next)
}

function reset() {
  const known = size()

  if (known)
    set(createCenteredCrop(known.width, known.height, ratio))
}

// The crop asked for, kept inside the image at the ratio's shape: its width held within the image and `minSize`, its height following the ratio, both shrunk together when the height does not fit.
function fitted(wanted: CropRect, known: ImageSize): CropRect {
  let w = Math.min(Math.max(wanted.w, minSize), known.width)
  let h = w / ratio

  if (h > known.height) {
    h = known.height
    w = h * ratio
  }

  return { x: Math.min(Math.max(wanted.x, 0), known.width - w), y: Math.min(Math.max(wanted.y, 0), known.height - h), w, h }
}

const close = (a: CropRect, b: CropRect) => Math.abs(a.x - b.x) <= 1 && Math.abs(a.y - b.y) <= 1 && Math.abs(a.w - b.w) <= 1 && Math.abs(a.h - b.h) <= 1

// A new image or ratio starts from a centred crop again, or from the one given; a changed `crop` moves it.
effect(() => {
  const known = size()
  const wanted = given

  void ratio

  untrack(() => {
    if (!wanted || !known)
      return reset()

    const next = fitted(wanted, known)

    // A parent that stores the crop rounded gives back a value within a pixel of the clamped one: that one is kept as it is, so the echo settles.
    if (close(next, wanted)) {
      if (!close(next, crop()))
        crop = wanted

      return
    }

    crop = next
    onCrop?.(next)
  })
})

// A new source gets another chance.
effect(() => {
  void src
  broken = false
})

function loaded() {
  if (!image?.naturalWidth)
    return

  const next = { width: image.naturalWidth, height: image.naturalHeight }

  broken = false
  size = next
  onLoad?.(next)
}

function failed() {
  if (broken())
    return

  broken = true
  onError?.()
}

// An image already decoded, from the cache, fires no load event of its own.
onMount(() => {
  if (image?.complete) {
    if (image.naturalWidth)
      loaded()
    else if (image.currentSrc)
      void probe(image)
  }
})

// An image that failed before the island hydrated fires no error event of its own: decoding it tells, and rejects for a broken one.
async function probe(img: HTMLImageElement) {
  if (typeof img.decode !== 'function')
    return

  try {
    await img.decode()
  }
  catch {
    if (image === img && !img.naturalWidth)
      failed()
  }
}

function start(event: PointerEvent, mode: 'move' | CropHandle) {
  const rect = stage?.getBoundingClientRect()
  const known = size()

  if (!known || !rect || event.button !== 0)
    return

  event.preventDefault()
  event.stopPropagation()
  drag = { mode, pointer: pointerToNatural(event.clientX, event.clientY, rect, known.width), from: crop(), moved: false }
  stage?.setPointerCapture(event.pointerId)
}

function move(event: PointerEvent) {
  const rect = stage?.getBoundingClientRect()
  const known = size()

  if (!drag || !known || !rect)
    return

  const pointer = pointerToNatural(event.clientX, event.clientY, rect, known.width)
  const dx = pointer.x - drag.pointer.x

  drag.moved = true
  set(drag.mode === 'move'
    ? moveCrop(drag.from, dx, pointer.y - drag.pointer.y, known.width, known.height)
    : resizeCrop(drag.from, dx, ratio, drag.mode, known.width, known.height, minSize))
}

function end(event: PointerEvent) {
  if (!drag)
    return

  const { moved } = drag

  drag = null
  stage?.releasePointerCapture(event.pointerId)

  if (moved)
    onCropEnd?.(crop())
}

// Arrows move the crop, Shift with the arrows resizes it from its bottom-right corner, and Alt takes bigger steps.
function keyDown(event: KeyboardEvent) {
  const direction = DIRECTIONS[event.key]
  const known = size()

  if (!direction || !known)
    return

  event.preventDefault()

  const [x, y] = direction
  const step = Math.max(1, Math.round(known.width * (event.altKey ? KEY_STEP_LARGE : KEY_STEP)))

  set(event.shiftKey
    ? resizeCrop(crop(), (x + y) * step, ratio, 'se', known.width, known.height, minSize)
    : moveCrop(crop(), x * step, y * step, known.width, known.height))
  onCropEnd?.(crop())
}

// What the footer's reset does: the crop centred again, as a commit.
function resetCrop() {
  reset()
  onCropEnd?.(crop())
}

const area = () => {
  const { x, y, w, h } = crop()
  const factor = scale()
  const known = size()

  return `left: ${x * factor}px; top: ${y * factor}px; width: ${w * factor}px; height: ${h * factor}px; background-image: url(${JSON.stringify(src)}); background-size: ${(known?.width ?? 0) * factor}px ${(known?.height ?? 0) * factor}px; background-position: ${-x * factor}px ${-y * factor}px`
}
---
div(part="root" {...rest})
  div(part="stage" ref={element => { stage = element; stageSize.ref(element) }} role="presentation" onPointerMove={move} onPointerUp={end} onPointerCancel={end})
    // kay-allow unsized-image
    img(part="image" ref={element => image = element} src={src} alt={alt} draggable="false" hidden={broken()} onLoad={loaded} onError={failed})
    if broken()
      if fallback
        | {fallback}
      else
        p(part="error" role="alert") {errorLabel}
    if crop().w > 0 && !broken()
      div(part="crop" role="slider" tabindex="0" aria-label={cropLabel} aria-valuetext={described()} aria-valuemin={minSize} aria-valuemax={size()?.width ?? minSize} aria-valuenow={Math.round(crop().w)} style={area()} onPointerDown={event => start(event, 'move')} onKeyDown={keyDown})
        if grid
          span(part="gridCols")
          span(part="gridRows")
        // Pointer only: the keyboard resizes through the crop area itself.
        for handle of HANDLES key={handle}
          span(part="handle" data-handle={handle} onPointerDown={event => start(event, handle)})
  if footer
    | {footer(resetCrop)}
