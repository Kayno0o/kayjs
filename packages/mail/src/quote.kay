---
import type { JSX } from 'kay'
import type { Align } from './tone'
import { withBreaks } from './breaks'
import settings from './settings'
import { alignStyle, withStyle } from './tone'

// `align` sets the text inside the full-width block, `style` goes after the cell's own, and the other attributes land on the cell.
const { text, align, style, ...rest } = props<Omit<JSX.IntrinsicElements['td'], 'class' | 'children' | 'align' | 'style'> & { text: string, align?: Align | undefined, style?: string | undefined }>()
---
// A cell rather than a padded div or a pre, whose padding, border and font Outlook for Windows drops or replaces.
table(role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:20px 0")
  tbody
    tr
      td(class="km-bg km-text km-quote" bgcolor={settings.background} {...rest} style={withStyle(`padding:16px 18px;background:${settings.background};border-left:3px solid ${settings.accent};font-size:15px;line-height:1.6;color:${settings.text};word-break:break-word;overflow-wrap:anywhere${alignStyle(align)}`, style)})
        {withBreaks(text)}
