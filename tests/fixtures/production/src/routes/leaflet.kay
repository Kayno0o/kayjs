--- server
import { t } from 'elysia'
import { action } from 'kay'

export const page = { prerender: true }

// Rendered once at build, its form still gets a fresh challenge on each visit.
export const subscribe = action({ input: t.Object({ email: t.String({ maxLength: 200 }) }), protect: { proofOfWork: 500 } }, ({ email }) => email.length)
---
form(action={subscribe})
  input(name="email" aria-label="Email")
  button Subscribe
