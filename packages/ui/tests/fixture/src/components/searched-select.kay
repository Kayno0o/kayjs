--- island
import type { OptionsSource } from '@kayjs/ui'
import Select from '@kayjs/ui/select.kay'
import { signal } from 'kay'

const { source, calls } = props<{ source: OptionsSource<{ value: string, label: string }>, calls: string[] }>()
const text = signal('')
---
input#search(aria-label="Search" value={text()} onInput={event => text = event.currentTarget.value})
Select#planet(options={source} query={text()} aria-label="Planet" onLoad={(options, query) => calls.push(`load ${query}:${options.length}`)} onError={failure => calls.push(`error ${failure.query}`)})
