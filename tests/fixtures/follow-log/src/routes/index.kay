---
import { followLog, signal } from 'kay'

const lines = signal(Array.from({ length: 40 }, (_, index) => index + 1))
let list: HTMLElement | undefined

followLog(() => list)
---
head
  title Log
button.append(type="button" onClick={() => lines.set([...lines(), lines()[lines().length - 1]! + 1])}) append
button.prepend(type="button" onClick={() => lines.set([lines()[0]! - 1, ...lines()])}) prepend
ol.list(ref={element => list = element} style="height: 200px; overflow-y: auto; margin: 0; padding: 0; list-style: none")
  for line of lines()
    li(style="min-height: 20px") {line}
