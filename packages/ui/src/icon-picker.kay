---
import type { JSX } from 'kay'
import type { IconChoice } from './icon-picker'
import { batch, effect, flush, onCleanup, recipe, signal } from 'kay'
import Icon from './icon.kay'
import IconButton from './icon-button.kay'
import { onFormDefaults, onFormReset } from './form-reset'
import { nameOf } from './icon-picker'
import { wording } from 'kay/words'

const PAGE_SIZE = 50
const DEBOUNCE_MS = 200

const look = recipe({ parts: { root: 'kui-icon-picker', search: '', grid: 'kui-icon-grid', option: 'kui-icon-grid-option', empty: 'kui-icon-grid-empty', bar: 'kui-icon-grid-bar', selection: 'kui-icon-grid-selection', clear: 'kui-icon-grid-clear', error: 'kui-icon-grid-error', more: 'kui-icon-grid-more' } })

const { search, value = '', name, onChange, searchLabel = wording('ui.iconPicker.searchLabel', 'Search icons'), placeholder = wording('ui.iconPicker.placeholder', 'Search icons…'), gridLabel = wording('ui.iconPicker.gridLabel', 'Icons'), searchingLabel = wording('ui.iconPicker.searchingLabel', 'Searching…'), emptyLabel = wording('ui.iconPicker.emptyLabel', 'No icons found.'), errorLabel = wording('ui.iconPicker.errorLabel', 'The icons could not be loaded.'), clearLabel = wording('ui.iconPicker.clearLabel', 'Clear icon selection'), moreLabel = wording('ui.iconPicker.moreLabel', 'Show more'), ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'children' | 'onChange'> & {
  // The icons matching `query` from the `offset`th on, at most `limit` of them: typically an action, since a whole icon set is too large to ship. A page of fewer than `limit` is the last. A rejection is logged and leaves the last grid on screen under `errorLabel`.
  search: (query: string, limit: number, offset: number) => Promise<IconChoice[]>
  // The chosen icon's name, or an empty string for none; a picker whose parent passes another follows it.
  value?: string | undefined
  // Submits the chosen icon's name under this name, for a picker inside a form.
  name?: string | undefined
  // Hands over a pick, or an empty string for a cleared one.
  onChange?: ((name: string) => void) | undefined
  // What the picker says: the search box's name and placeholder, the grid's name, its states, and its two buttons.
  searchLabel?: string | undefined
  placeholder?: string | undefined
  gridLabel?: string | undefined
  searchingLabel?: string | undefined
  emptyLabel?: string | undefined
  errorLabel?: string | undefined
  clearLabel?: string | undefined
  moreLabel?: string | undefined
}>()

const picked = signal(value)
const typed = signal('')
const query = signal('')
const icons = signal<IconChoice[]>([])
// Whether the last page came back full, so another may follow.
const more = signal(false)
const pending = signal(true)
// Whether the last search was rejected.
const failed = signal(false)
// The last pick, whose icon the selection keeps drawing once a new search no longer finds it.
const last = signal<IconChoice>()
let hidden: HTMLInputElement | undefined
let searchBox: HTMLInputElement | undefined
// What a reset goes back to: the icon it started with, or the one last saved by a SaveForm.
let initial = value
let request = 0
// The search the grid shows, and where its next page starts: a Show more asks for these, whatever has been typed since.
let shownQuery = ''
let nextOffset = 0

effect(() => picked.set(value))

effect(() => {
  const next = typed()
  // A new search starts back on its first page; the same one, such as on the first run, keeps the pages shown.
  const timer = setTimeout(() => next !== query() && query.set(next), DEBOUNCE_MS)

  onCleanup(() => clearTimeout(timer))
})

effect(() => void load(query(), 0))

// The last grid stays on screen while the next search is in flight, and only the latest search lands. A page after the first is added to the grid, the icons it shares with it left out.
async function load(needle: string, offset: number) {
  const mine = ++request

  pending.set(true)

  try {
    const found = await search(needle, PAGE_SIZE, offset)

    if (mine !== request)
      return

    const shown = offset === 0 ? new Set<string>() : new Set(icons().map(choice => choice.name))
    const fresh = found.filter(choice => !shown.has(choice.name))

    shownQuery = needle
    nextOffset = offset + found.length

    batch(() => {
      icons.set(offset === 0 ? found : [...icons(), ...fresh])
      // An app that ignores the offset gives the same page again: nothing new ends the paging.
      more.set(found.length >= PAGE_SIZE && fresh.length > 0)
      failed.set(false)
    })
  }
  catch (error) {
    if (mine === request) {
      console.error('kayjs-ui: an IconPicker\'s search failed', error)
      failed.set(true)
    }
  }
  finally {
    if (mine === request)
      pending.set(false)
  }
}

// A click while a page is on its way asks for nothing more.
function showMore() {
  if (!pending())
    void load(shownQuery, nextOffset)
}

const chosen = () => icons().find(choice => choice.name === picked())?.icon ?? (last()?.name === picked() ? last()?.icon : undefined)

function pick(next: string) {
  picked.set(next)
  onChange?.(next)

  if (!hidden)
    return

  // A pick types nothing, so once the hidden input holds it, an `input` event tells the form, as typing would.
  flush()
  hidden.dispatchEvent(new Event('input', { bubbles: true }))
}

// Read once: a ref an app writes inline is a new function on every read of the prop, which kay would run again on the root each time its attributes change.
const ref = rest.ref

// The hidden input is no default of its own to reset to, so a reset sends the picker back to `initial`, and empties the search the browser emptied.
onFormReset(() => searchBox, () => {
  typed.set('')

  if (picked() !== initial)
    pick(initial)
})

onFormDefaults(() => searchBox, () => {
  const held = picked()

  return () => {
    initial = held
  }
})

function choose(choice: IconChoice) {
  last.set(choice)
  pick(picked() === choice.name ? '' : choice.name)
}

// Enter in the search box has nothing to confirm, since the grid follows the typing; left alone, it would submit the whole form.
function keepEnter(event: KeyboardEvent) {
  if (event.key === 'Enter')
    event.preventDefault()
}
---
div(part="root" {...rest} ref={ref})
  if name
    input(type="hidden" name={name} value={picked()} ref={element => hidden = element})
  input.kui-field-input(part="search" ref={element => searchBox = element} type="search" data-kui-search placeholder={placeholder} aria-label={searchLabel} value={typed()} onInput={event => typed.set(event.currentTarget.value)} onKeyDown={keepEnter})
  ul(part="grid" aria-label={gridLabel} aria-busy={pending() ? 'true' : undefined})
    for choice of icons() key={choice.name}
      li
        button(part="option" type="button" aria-label={nameOf(choice.name)} data-tooltip={nameOf(choice.name)} aria-pressed={picked() === choice.name ? 'true' : 'false'} onClick={() => choose(choice)})
          Icon(icon={choice.icon})
    if icons().length === 0
      li(part="empty") {pending() ? searchingLabel : failed() ? errorLabel : emptyLabel}
  div(part="bar")
    if picked()
      span(part="selection" aria-live="polite")
        if chosen() as icon
          Icon(icon={icon})
        | {nameOf(picked())}
        IconButton(icon="close" label={clearLabel} size="xs" variant="inline" part="clear" onClick={() => pick('')})
    if failed() && icons().length > 0
      span(part="error" role="alert") {errorLabel}
    if more()
      button(part="more" type="button" onClick={showMore}) {moreLabel}
