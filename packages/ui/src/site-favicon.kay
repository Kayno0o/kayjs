---
import type { JSX } from 'kay'
import { stringToHexColor } from '@kaynooo/utils/colors'
import { effect, recipe, signal } from 'kay'
import Icon from './icon.kay'

const look = recipe({ parts: { root: 'kui-site-favicon', img: 'kui-site-favicon-img', icon: 'kui-site-favicon-icon' } })

const { src, name, ...rest } = props<Omit<JSX.IntrinsicElements['span'], 'class' | 'children'> & {
  src?: string | null | undefined
  // Names the site: it colours the fallback icon, and goes unused once the image loads.
  name: string
}>()

const failed = signal(false)

// A new src is a new load: a failure recorded for the one before it no longer applies.
effect(() => {
  void src
  failed.set(false)
})
---
// A site's icon, or the globe slot in a colour of the site's own when it has none or it fails to load.
span(part="root" {...rest})
  if src && !failed()
    // kay-allow unsized-image
    img(part="img" src={src} alt="" onError={() => failed.set(true)})
  else
    Icon(icon="globe" part="icon" style={`color: ${stringToHexColor(name)}`})
