--- server
import { s } from 'kay'

export const nested = action(s.Object({ name: s.String({ minLength: 2, maxLength: 100 }) }), async () => undefined, { protect: { honeypot: 'website', minTime: '3s' } })
--- script
import { signal } from 'kay'

// A signal makes the page an island, whose form is nested in a template rather than its root.
const clicks = signal(0)
---
main
  section
    p Nested
    form(action={nested} novalidate)
      input(field="name" aria-label="Name")
      button#count(type="button" onClick={() => clicks = clicks() + 1}) Count {clicks()}
      button(type="submit") Send
