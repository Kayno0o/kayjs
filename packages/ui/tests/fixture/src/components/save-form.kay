---
import type { Action, Failure } from 'kay'
import { ActionError, signal } from 'kay'
import FormField from '@kayjs/ui/form-field.kay'
import SaveForm from '@kayjs/ui/save-form.kay'
import Toaster from '@kayjs/ui/toaster.kay'

// `save` stands in for the server: it answers the saved name, the messages a schema refusal carries, or throws for a call that failed outright.
const { save, onSave, onError, onDiscard, shortcut, confirm } = props<{ onError?: ((failure: { error: unknown }) => unknown) | undefined, confirm?: string | undefined, save: (input: { name: string }) => Promise<string | { errors: Record<string, string> }>, onSave: (name: string) => void, onDiscard: () => void, shortcut?: string | false | undefined }>()

const pending = signal(false)
// Like a real action, it keeps its last refusal until a call goes through.
const last = signal<ActionError | undefined>(undefined)
const extra = signal(false)

const rename = Object.assign(async (form: FormData) => {
  pending = true

  try {
    const answer = await save({ name: String(form.get('name')) })

    if (typeof answer !== 'string')
      throw new ActionError(422, '', answer.errors)

    last = undefined

    return answer
  }
  catch (error) {
    last = error instanceof ActionError ? error : undefined

    throw error
  }
  finally {
    pending = false
  }
}, { [Symbol.for('kay.action')]: true, pending, url: '/_kay/action/form/rename', failed: () => last() ? { status: last()!.status, errors: last()!.errors } : undefined, error: (field = '') => last()?.errors[field] }) as unknown as Action<{ name: string }, string | Failure<never>>
---
button#more(onClick={() => extra = true}) More
SaveForm(action={rename} failureLabel="Could not save" saved="Saved." onSave={onSave} onError={onError} onDiscard={onDiscard} shortcut={shortcut} confirm={confirm})
  FormField(label="Name" name="name")
    input#name(name="name" value="Ada")
  textarea#notes(name="notes")
  input#nameless
  if extra()
    input#extra(name="extra")
Toaster
