---
import type { JSX } from 'kay'
import { recipe } from 'kay'
import { controlledCheckbox } from './controlled-checkbox'

// The track reads the input before it, named so a toggle inside another peer is left alone.
const look = recipe({
  parts: {
    root: 'kui-toggle relative inline-flex cursor-pointer items-center gap-2 has-[input:disabled]:opacity-50 has-[input[aria-busy=true]]:cursor-progress has-[input:disabled:not([aria-busy=true])]:cursor-not-allowed',
    input: 'peer/toggle absolute size-0 opacity-0',
    track: 'relative inline-flex h-5 w-9 shrink-0 items-center rounded-md border-solid border-[length:var(--border-width)] border-input bg-surface transition-colors before:block before:size-3.5 before:translate-x-0.5 before:rounded-sm before:bg-muted before:transition-transform before:content-[""] peer-checked/toggle:border-accent peer-checked/toggle:bg-accent peer-checked/toggle:before:translate-x-4 peer-checked/toggle:before:bg-accent-foreground peer-focus-visible/toggle:outline-2 peer-focus-visible/toggle:outline-offset-2 peer-focus-visible/toggle:outline-accent',
    label: 'text-sm text-foreground',
  },
})

const { checked = false, label, onChange, ...rest } = props<Omit<JSX.IntrinsicElements['input'], 'type' | 'role' | 'checked' | 'class' | 'children' | 'onChange'> & {
  // Whether it starts on; a switch whose parent passes another value follows it.
  checked?: boolean | undefined
  // Shown next to the switch; omit it and pass `aria-label` instead to keep the switch label-only for screen readers.
  label?: string | undefined
  // A promise holds the switch busy until it settles, and puts it back where it was when it rejects (logged) or resolves to false: a refused change never shows as made.
  // Typed `unknown`, so a callback answering something else, such as `list.push`, still fits.
  onChange?: ((checked: boolean) => unknown) | undefined
}>()

const { on, busy, ref, change } = controlledCheckbox({ control: 'Toggle', checked: () => checked, onChange: () => onChange, appRef: rest.ref })
---
// A real checkbox, so it submits inside a form like any other. A click while a change is under way flips nothing.
label(part="root")
  input({...rest} part="input" ref={ref} type="checkbox" role="switch" checked={on()} aria-busy={busy() ? 'true' : undefined} onClick={event => { if (busy()) event.preventDefault() }} onChange={event => change(event.currentTarget)})
  span(part="track")
  if label
    span(part="label") {label}
