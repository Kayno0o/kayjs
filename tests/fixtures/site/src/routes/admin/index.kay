--- server
import { t } from 'elysia'
import { action } from 'kay'

export const promote = action(t.Object({ name: t.String({ maxLength: 200, minLength: 1 }) }), ({ name }) => `${name} is an admin`)

// Returns nothing once it succeeded.
export const demote = action(t.Object({ name: t.String({ maxLength: 200, minLength: 1 }) }), ({ name }, ctx) => {
  if (name === 'ada')
    return ctx.deny(422, { data: { error: 'ada stays an admin' } })
})

export const refuseText = action(t.Object({ name: t.String({ maxLength: 200 }) }), (_input, ctx) => ctx.deny(502, { data: 'whisper answered 500' }))
---
h1 Admin
