--- server
import { t } from 'elysia'
import { action } from 'kay'

export const add = action(t.Object({ title: t.String({ minLength: 1 }) }), ({ title }) => title)
--- script
import hero from '../hero.png'
---
h1 Answers
img(src={hero} alt="Hero")
form(action={add})
  input(name="title")
  button Add
