--- server
import { t } from 'elysia'
import { action, refuse } from 'kay'

// Every attempt counts up to 4, the messages that went through up to 1; "fail" fails as a mail server down would, "throw" throws, "refuse" is refused as a `before` hook would, "away" goes on to another page.
export const enquire = action(t.Object({ message: t.String({ maxLength: 200 }) }), ({ message }, ctx) => {
  if (message === 'throw')
    throw new Error('the mail server is down')

  if (message === 'refuse-plain')
    refuse(403, { message: 'Nope' })

  if (message === 'refuse')
    refuse(422, { message: 'Needs a summary', errors: { message: 'required' }, data: 7 })

  if (message === 'taken')
    return ctx.deny(409, { errors: { message: 'Already sent' } })

  if (message === 'hostile')
    return ctx.deny(422, { errors: JSON.parse('{"__proto__":{"polluted":"yes"},"message":"Own"}') as Record<string, string> })

  if (message === 'stray')
    return ctx.deny(422, { errors: { nothere: 'Stray', message: 'Own' } as Record<string, string> })

  if (message === 'away')
    ctx.redirect('/contact')

  return message === 'fail' ? ctx.deny(502, { data: 'Not sent; try again later' }) : message.length
}, { protect: { rateLimit: [{ max: 4, window: '1m' }, { max: 1, window: '1m', count: 'succeeded' }], honeypot: { field: 'nectar', pretend: true } } })

const sent = enquire.status() === 'ready'
---
form(action={enquire})
  input(name="message" aria-label="Message")
  error message
  button Send
if enquire.error() then message
  p.error {message}
if sent
  p.sent Sent
