---
import type { PaletteEntry } from '@kayjs/ui'
import CommandPalette from '@kayjs/ui/command-palette.kay'

// What the test reads back: each change of the palette's state, and each action run.
const { onOpenChange, onRecentChange, onAction, recent = [], shortcut, siteSearch = false, hostile = false, loose = false, search } = props<{ onOpenChange: (open: boolean) => void, onRecentChange: (recent: string[]) => void, onAction: (name: string) => void, recent?: string[], shortcut?: string | false | null, siteSearch?: boolean, hostile?: boolean, loose?: boolean, search?: (query: string) => Promise<PaletteEntry[]> }>()

const entries: PaletteEntry[] = [
  { label: 'Table', group: 'Pages', href: '/table' },
  { label: 'Content', group: 'Pages', href: '/content', keywords: 'cards badges' },
  { label: 'Docs', group: 'Links', href: 'https://kaynooo.fr', external: true },
  ...hostile ? [{ label: 'Hostile', group: 'Pages', href: 'javascript:alert(1)' }] : [],
  ...loose ? [{ label: 'Tab left', group: 'Pages', href: '/tab-left' }] : [],
  { label: 'New moon', group: 'Actions', icon: 'plus', shortcut: 'Ctrl+N', onSelect: () => onAction('new-moon') },
]
---
CommandPalette(entries={entries} groups={['Actions', 'Pages']} recent={recent} shortcut={shortcut} onOpenChange={onOpenChange} onRecentChange={onRecentChange} siteSearch={siteSearch} search={search})
input#outside(aria-label="Outside")
