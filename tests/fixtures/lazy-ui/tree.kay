---
// A component drawing itself in a branch, as a nested field of an editor does: its own module is loaded already, so it stays eager.
// 
import { signal } from "kay"
import Tree from "./tree.kay"

const { depth } = props<{ depth: number }>()
const open = signal(false)
---
section.tree
  button(onClick={() => open = !open()}) Level {depth}
  if open() && depth < 3
    Tree(depth={depth + 1})
