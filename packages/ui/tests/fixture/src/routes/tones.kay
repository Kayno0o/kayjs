---
import Avatar from '@kayjs/ui/avatar.kay'
import Badge from '@kayjs/ui/badge.kay'
import Card from '@kayjs/ui/card.kay'
import CardRow from '@kayjs/ui/card-row.kay'
import Meter from '@kayjs/ui/meter.kay'
import Notice from '@kayjs/ui/notice.kay'
import Progress from '@kayjs/ui/progress.kay'
import Skeleton from '@kayjs/ui/skeleton.kay'
import Stat from '@kayjs/ui/stat.kay'
import TonesIsland from '../components/tones-island.kay'
---
main
  Card#card(class="border-danger" title="Moons")
    Badge#badge(tone="success" label="New")
  Notice#notice(tone="danger" label="Failed")
  Avatar#avatar(name="Mars" size="lg" class="size-16")
  Stat#stat(value={3} label="moons" layout="tile" tone="danger" class="px-9")
  Meter#meter(value={40} label="Disk" fillClass="bg-danger")
  Meter#meter-part(value={40} label="Disk" class={{ fill: 'bg-danger' }})
  Meter#meter-rounded(value={40} label="Disk" fillClass="rounded-full")
  Progress#progress(value={30} label="Upload" class="h-3")
  Skeleton#skeleton(shape="avatar")
  CardRow#row(class="p-9") Middle
  TonesIsland
