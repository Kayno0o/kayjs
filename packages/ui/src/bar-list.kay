--- <Row extends BarListRow>
import type { JSX } from 'kay'
import type { BarListRow } from './plot'
import { memo, recipe } from 'kay'
import { wording } from 'kay/words'

const look = recipe({ parts: { root: 'kui-bar-list', row: 'kui-bar-list-row', label: 'kui-bar-list-label', value: 'kui-bar-list-value', track: 'kui-bar-list-track', fill: 'kui-bar-list-fill' } })

const { rows, onSelect, emptyLabel, ...rest } = props<Omit<JSX.IntrinsicElements['ul'], 'class' | 'children' | 'onSelect'> & {
  rows: Row[]
  // Makes every row a button handing back the row it was pressed on.
  onSelect?: ((row: Row) => unknown) | undefined
  // What the list reads with no rows.
  emptyLabel?: string | undefined
}>()

const nothing = () => emptyLabel ?? wording('ui.barList.emptyLabel', 'No data yet.')

const largest = memo(() => Math.max(0, ...rows.map(row => row.value)))

// Each bar's length against the largest value, so the largest row fills its track.
const percent = (row: Row) => largest() > 0 ? Math.max(0, row.value) / largest() * 100 : 0
---
if rows.length === 0
  // The app's id and class stay on whichever element shows.
  p.kui-bar-list-empty(part="root" id={rest.id}) {nothing()}
else
  ul(part="root" {...rest})
    for row of rows key={row.key}
      li
        if onSelect
          button(part="row" type="button" data-interactive onClick={() => onSelect?.(row)})
            span(part="label") {row.label}
            span(part="value") {row.display ?? row.value}
            span(part="track")
              span(part="fill" style={`width: ${percent(row)}%`})
        else
          div(part="row")
            span(part="label") {row.label}
            span(part="value") {row.display ?? row.value}
            span(part="track")
              span(part="fill" style={`width: ${percent(row)}%`})
