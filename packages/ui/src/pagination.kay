---
import { recipe } from 'kay'
import type { JSX } from 'kay'
import type { PagedList } from './pagination'
import { currentPage, openSteps, pageHref, pageItems } from './pagination'
import { wording } from 'kay/words'

const look = recipe({ parts: { root: 'kui-pagination', step: 'kui-pagination-step', gap: 'kui-pagination-gap', page: 'kui-pagination-page' } })

const { of, page, pages, offset, limit, more, url, param, siblings = 1, label = wording('ui.pagination.label', 'Pagination'), previousLabel = wording('ui.pagination.previousLabel', 'Previous'), nextLabel = wording('ui.pagination.nextLabel', 'Next'), ...rest } = props<Omit<JSX.IntrinsicElements['nav'], 'class' | 'children'> & ({
  // A page kay's `paginate()` gave, which links each page at its own path: `Pagination(of={list})`.
  of: PagedList
  page?: never
  pages?: never
  offset?: never
  limit?: never
  more?: never
  url?: never
} | {
  of?: never
  // The page on screen, from 1; one past the ends, or no whole number, such as `?page=abc` read as `NaN`, shows as the nearest that exists.
  page: number
  // How many pages there are; with one or none, nothing is drawn.
  pages: number
  offset?: never
  limit?: never
  more?: never
  // The URL of the page on screen, `ctx.url`: each link keeps its path and query, `param` set to the page.
  url: URL | string
} | {
  // A list whose length is unknown, by page number: only Previous and Next, Next while `more` says there is a page after this one.
  of?: never
  page: number
  pages?: never
  offset?: never
  limit?: never
  more: boolean
  url: URL | string
} | {
  // The same by offset, `?offset=40`, a page holding `limit` rows.
  of?: never
  page?: never
  pages?: never
  offset: number
  limit: number
  more: boolean
  url: URL | string
}) & {
  // The query parameter holding the page, `page` by default, or the offset, `offset` by default.
  param?: string | undefined
  // How many pages show on each side of the current one, 1 by default.
  siblings?: number | undefined
  // Names the navigation for screen readers.
  label?: string | undefined
  previousLabel?: string | undefined
  nextLabel?: string | undefined
}>()

const total = of?.pages ?? pages ?? 0
// The page as one that exists, whatever the query held.
const shown = () => currentPage(of?.page ?? page ?? 1, total)
const href = (target: number) => of ? of.href(target) : pageHref(url ?? '', target, param)
const steps = () => more === undefined ? undefined : openSteps(limit === undefined ? { page: page ?? 1 } : { offset: offset ?? 0, limit }, more, url ?? '', param)
---
// Plain links, through the query or at the paths `paginate()` gives, so a page renders on the server, its pages crawlable, and needs no island.
if steps() as open
  if open.previous || open.next
    nav({...rest} part="root" aria-label={label})
      if open.previous
        a(part="step" href={open.previous} rel="prev") {previousLabel}
      else
        span(part="step") {previousLabel}
      if open.next
        a(part="step" href={open.next} rel="next") {nextLabel}
      else
        span(part="step") {nextLabel}
else if total > 1
  nav({...rest} part="root" aria-label={label})
    if shown() > 1
      a(part="step" href={href(shown() - 1)} rel="prev") {previousLabel}
    else
      span(part="step") {previousLabel}
    for item, index of pageItems(shown(), total, siblings) key={index}
      if item === 'gap'
        span(part="gap" aria-hidden="true") …
      else
        a(part="page" href={href(item)} aria-current={item === shown() ? 'page' : undefined}) {item}
    if shown() < total
      a(part="step" href={href(shown() + 1)} rel="next") {nextLabel}
    else
      span(part="step") {nextLabel}
