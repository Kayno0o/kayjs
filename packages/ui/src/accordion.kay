---
import type { JSX, Snippet } from 'kay'
import { effect, recipe, signal, uid, untrack } from 'kay'
import { stepIndex } from './cycle'
import CollapsibleSection from './collapsible-section.kay'

const MOVES: Partial<Record<string, (index: number, count: number) => number>> = {
  ArrowDown: (index, count) => stepIndex(index, 1, count),
  ArrowUp: (index, count) => stepIndex(index, -1, count),
  Home: () => 0,
  End: (_, count) => count - 1,
}

const look = recipe({ parts: { root: 'kui-accordion' } })

const { items, level, multiple = false, boxed = false, value, onChange, panel, title, meta, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'children' | 'title' | 'onChange'> & {
  // `open` starts a section unfolded; with one open at a time, the first one flagged wins. `disabled` keeps a section as it is, and `meta` draws a count or a state in its band, as CollapsibleSection's does.
  items: readonly { value: string, title: string, open?: boolean | undefined, disabled?: boolean | undefined, meta?: string | undefined }[]
  // The values open, which the accordion follows when the app passes a new one: a string, or an array with `multiple`. Left out, the reader alone decides after the first draw.
  value?: string | readonly string[] | undefined
  // Called with the values open (at most one without `multiple`) whenever the reader opens or closes a section.
  onChange?: ((value: string[]) => unknown) | undefined
  // Lets several sections stay open; by default opening one closes the others.
  multiple?: boolean | undefined
  // Makes each section's title a heading of that level, as CollapsibleSection's `level` does.
  level?: 1 | 2 | 3 | 4 | 5 | 6 | undefined
  // Draws each section as a card, as CollapsibleSection does.
  boxed?: boolean | undefined
  // Draws each section's body: `@panel(value)`, given the item's value.
  panel: Snippet<[value: string]>
  // Draws a section's heading in place of its `title`: `@title(value)`.
  title?: Snippet<[value: string]> | undefined
  // Draws a section's band content before the chevron, in place of its `meta`: `@meta(value)`.
  meta?: Snippet<[value: string]> | undefined
}>()

const group = uid()
const firstOpen = () => items.findIndex(item => item.open)
const asked = () => value === undefined ? undefined : new Set(typeof value === 'string' ? [value] : value)
let root: HTMLElement | undefined

// The sections open: the app's `value` when given, else the flagged items, and the reader's clicks from then on.
const flagged = () => new Set(items.filter((item, index) => multiple ? item.open === true : index === firstOpen()).map(item => item.value))
const opened = signal<ReadonlySet<string>>(asked() ?? flagged())
// Whether the reader has toggled a section, after which the flags no longer decide.
let touched = false

effect(() => {
  const wanted = asked()

  if (wanted) {
    opened = multiple ? wanted : new Set([...wanted].slice(0, 1))

    return
  }

  // Items that arrive or change after mount open by their flags until the reader decides.
  const flags = flagged()

  if (!untrack(() => touched))
    opened = flags
})

// Without `multiple`, a section closing as another opens reports only the opening, so the value is never briefly empty.
function toggled(item: string, now: boolean) {
  const shown = untrack(opened)

  if (shown.has(item) === now || (!now && !multiple && root?.querySelector(':scope > details[open]')))
    return

  const next = new Set(multiple ? shown : [])

  if (now)
    next.add(item)
  else
    next.delete(item)

  touched = true
  opened = next
  onChange?.([...next])
}

// A click, or Enter and Space which the browser turns into one, on a disabled header folds nothing.
function refuseDisabled(event: MouseEvent) {
  if (event.target instanceof Element && event.target.closest('summary[aria-disabled=true]'))
    event.preventDefault()
}

// Arrow, Home and End keys move between the headers, which are the summaries of the sections.
function keyDown(event: KeyboardEvent) {
  const move = MOVES[event.key]

  if (!move || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey || !(event.target instanceof Element) || !event.target.matches('summary'))
    return

  const summaries = [...root?.querySelectorAll<HTMLElement>(':scope > details > summary:not([aria-disabled=true])') ?? []]
  const index = summaries.indexOf(event.target as HTMLElement)

  if (index === -1)
    return

  event.preventDefault()
  summaries[move(index, summaries.length)]?.focus()
}
---
// Native details sharing a `name` close one another without script; the keys need an island.
div(part="root" {...rest} ref={element => root = element} onKeyDown={keyDown} onClick={refuseDisabled})
  for item of items key={item.value}
    CollapsibleSection(title={untrack(() => title?.(item.value)) ?? item.title} meta={untrack(() => meta?.(item.value)) ?? item.meta} level={level} name={multiple ? undefined : group} open={opened().has(item.value)} boxed={boxed} disabled={item.disabled} onOpenChange={now => toggled(item.value, now)})
      | {untrack(() => panel(item.value))}
