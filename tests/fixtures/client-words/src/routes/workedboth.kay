--- server
import { t } from 'elysia'
import { action } from 'kay'

export const solve = action({ input: t.Object({ name: t.String({ minLength: 3 }) }), protect: { proofOfWork: 50 } }, () => undefined)
export const other = action({ input: t.Object({ title: t.String({ minLength: 2 }) }), protect: { proofOfWork: 60 } }, () => undefined)

const rows = Promise.resolve([1])
---
form(action={solve})
  input(field="name")
  button Solve
await rows then list
  form(action={solve})
    input(field="name")
    button Again
  form(action={other})
    input(field="title")
    button Other
