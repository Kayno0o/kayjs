---
import type { DurationText } from 'kay'
import { durationMs, effect, onCleanup, signal } from 'kay'
import { claim } from './claim'

// An element carries its tooltip as `data-tooltip`, and where it sits as `data-tooltip-placement`, a CSS `position-area`, `top` by default.
const CARRIER = '[data-tooltip]'
// The anchor name theme.css's `.kui-tooltip` positions against.
const ANCHOR = '--kui-tooltip-anchor'
const WHITESPACE = /\s+/
// The id of the tooltip panel, which the element it shows for points at with `aria-describedby`.
const PANEL_ID = 'kui-tooltip'

const { showDelay = '80ms', hideDelay = '150ms' } = props<{
  // How long the pointer or focus rests on an element before its tooltip shows.
  showDelay?: DurationText | undefined
  // How long a tooltip lingers once the pointer leaves, long enough by default for it to cross the gap onto the tooltip, which stays while hovered.
  hideDelay?: DurationText | undefined
}>()

const aimed = signal<{ element: HTMLElement, text: string } | null>(null)
let at: HTMLElement | null = null
let timer: ReturnType<typeof setTimeout> | undefined
const panel = signal<HTMLElement>()
const owns = claim('tooltips')

// The element carrying a tooltip that an event's target is, or sits inside.
function found(event: Event): HTMLElement | null {
  return event.target instanceof Element ? event.target.closest<HTMLElement>(CARRIER) : null
}

function hide() {
  clearTimeout(timer)
  at = null
  aimed.set(null)
}

function onto(next: HTMLElement | null) {
  // Crossing the same element again is the pointer moving within it, not onto a new one.
  if (next === at)
    return

  at = next
  clearTimeout(timer)

  const text = next?.dataset.tooltip

  if (!next || !text) {
    timer = setTimeout(() => aimed.set(null), durationMs(hideDelay))

    return
  }

  timer = setTimeout(() => aimed.set({ element: next, text }), durationMs(showDelay))
}

function focused(event: FocusEvent) {
  const next = found(event)

  // A press has just closed the tooltip on purpose, so only a focus the browser rings, a tab, opens one.
  if (!next || next.matches(':focus-visible'))
    onto(next)
}

function blurred(event: FocusEvent) {
  if (found(event) === at)
    hide()
}

function over(event: PointerEvent) {
  const shown = panel()

  // On the tooltip itself, it stays, as it does while the pointer crosses over to it.
  if (shown && aimed() && event.target instanceof Node && shown.contains(event.target)) {
    clearTimeout(timer)
    at = shown

    return
  }

  onto(found(event))
}

// Escape closes the tooltip and leaves the key to whatever else it does; it stays closed until the pointer or the focus moves to another element.
function keyDown(event: KeyboardEvent) {
  if (event.key !== 'Escape' || !aimed())
    return

  clearTimeout(timer)
  aimed.set(null)
}

// One set of listeners for every element carrying a tooltip, rather than a set each.
effect(() => {
  if (!owns())
    return

  document.addEventListener('pointerover', over)
  document.addEventListener('focusin', focused)
  document.addEventListener('focusout', blurred)
  document.addEventListener('pointerdown', hide)
  document.addEventListener('keydown', keyDown)
  window.addEventListener('blur', hide)

  onCleanup(() => {
    clearTimeout(timer)
    document.removeEventListener('pointerover', over)
    document.removeEventListener('focusin', focused)
    document.removeEventListener('focusout', blurred)
    document.removeEventListener('pointerdown', hide)
    document.removeEventListener('keydown', keyDown)
    window.removeEventListener('blur', hide)
  })
})

effect(() => {
  const target = aimed()

  const element = panel()

  // The element is gone while another TooltipHost owns the job, and a detached one cannot show as a popover.
  if (!element?.isConnected)
    return

  if (!target) {
    if (element.matches(':popover-open'))
      element.hidePopover()

    return
  }

  // The element may already anchor something of its own, such as the popover it opens, so the tooltip adds its name to that list rather than taking the slot and then clearing it.
  const own = target.element.style.getPropertyValue('anchor-name')

  target.element.style.setProperty('anchor-name', own ? `${own}, ${ANCHOR}` : ANCHOR)
  // The element may describe itself already, so the tooltip adds its id to that list too, and takes only its own back out.
  const described = target.element.getAttribute('aria-describedby')

  const added = !described?.split(WHITESPACE).includes(PANEL_ID)

  if (added)
    target.element.setAttribute('aria-describedby', described ? `${described} ${PANEL_ID}` : PANEL_ID)

  element.style.setProperty('position-area', target.element.dataset.tooltipPlacement ?? 'top')

  if (!element.matches(':popover-open'))
    element.showPopover()

  onCleanup(() => {
    if (own)
      target.element.style.setProperty('anchor-name', own)
    else
      target.element.style.removeProperty('anchor-name')

    if (!added)
      return

    if (described)
      target.element.setAttribute('aria-describedby', described)
    else
      target.element.removeAttribute('aria-describedby')
  })
})
---
// Rendered in the root layout, it shows the tooltip of whichever element the pointer or a tab lands on. A second one, such as an extension's, renders nothing while the first is mounted.
if owns()
  .kui-tooltip(id={PANEL_ID} ref={element => panel.set(element)} popover="manual" role="tooltip") {aimed()?.text}
