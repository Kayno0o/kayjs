---
import { signal } from 'kay'
import Button from '@kayjs/ui/button.kay'
import Dialog from '@kayjs/ui/dialog.kay'

const open = signal(false)
---
Button(label="New note" onClick={() => open = true})
Dialog(open={open()} title="New note" onOpenChange={() => open = false})
  @footer
    Button(label="Discard" onClick={() => open = false})
    Button(label="Save" tone="accent" onClick={() => open = false})
  p.mb-2 Escape and a click outside close it, until you type something: then they ask before dropping it.
  textarea.kui-field-input(name="note" rows="3" aria-label="Note")
