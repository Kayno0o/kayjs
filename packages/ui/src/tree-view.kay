--- <Id extends TreeId>
import type { JSX } from 'kay'
import type { TreeId, TreeNode, TreeRow } from './tree'
import { effect, memo, recipe, signal, untrack } from 'kay'
import Icon from './icon.kay'
import { treeKey, treePath, treeRows } from './tree'

const look = recipe({ parts: { root: 'kui-tree-view', item: 'kui-tree-view-item', toggle: 'kui-tree-view-toggle', icon: 'kui-tree-view-icon', label: 'kui-tree-view-label' } })

const { nodes, label, selected, expanded = [], onSelect, ...rest } = props<Omit<JSX.IntrinsicElements['ul'], 'class' | 'children' | 'role' | 'onKeyDown' | 'onSelect'> & {
  nodes: readonly TreeNode<Id>[]
  // Names the tree for screen readers.
  label: string
  // The node picked; a tree whose parent passes another follows it, opening the branches holding it.
  selected?: Id | undefined
  // The branches open to start with.
  expanded?: readonly Id[] | undefined
  // Runs on a click on a row, or Enter or Space on the focused one.
  onSelect?: ((id: Id) => unknown) | undefined
}>()

const path = (id: TreeId | undefined) => id === undefined ? undefined : treePath(nodes, id)
// Held as the wider type: a signal cannot take a type parameter.
// Opened to the selected node from the start, so the server's HTML shows it too.
const open = signal<ReadonlySet<TreeId>>(new Set<TreeId>([...expanded, ...path(selected) ?? []]))
const current = signal<TreeId | undefined>(selected)
// The row in the page's tab order, as a tree is one stop the arrows move inside.
const focused = signal<TreeId | undefined>(selected)
const rows = memo(() => treeRows(nodes, open()))
// The selected node whose branches were last opened, so new nodes never reopen a branch closed since.
let reached = path(selected) ? selected : undefined
let list: HTMLUListElement | undefined

effect(() => current.set(selected))

// Waits for the nodes holding the selected one when they come later.
effect(() => {
  const holding = path(selected)

  if (!holding || selected === reached)
    return

  reached = selected
  focused.set(selected)

  // Untracked, so closing a branch never brings the prop back over a pick made since.
  if (holding.some(id => !untrack(open).has(id)))
    open.set(shown => new Set([...shown, ...holding]))
})

// The focused row when shown, which starts as the selected one, else the selected one, else the first.
const stop = memo(() => {
  const shown = new Set<TreeId>(rows().map(row => row.node.id))

  return [focused(), current()].find(id => id !== undefined && shown.has(id)) ?? rows()[0]?.node.id
})

function toggle(id: TreeId) {
  open.set(shown => shown.has(id) ? new Set([...shown].filter(one => one !== id)) : new Set([...shown, id]))
}

function pick(row: TreeRow<Id>) {
  current.set(row.node.id)
  focused.set(row.node.id)
  onSelect?.(row.node.id)
}

// A branch's chevron opens or closes it, the rest of the row selects it; the keyboard does both through the row itself.
function click(event: MouseEvent, row: TreeRow<Id>) {
  if (row.node.children && (event.target as Element).closest('.kui-tree-view-toggle'))
    toggle(row.node.id)
  else
    pick(row)
}

function focusRow(id: TreeId) {
  focused.set(id)
  const index = rows().findIndex(row => row.node.id === id)

  list?.querySelectorAll<HTMLElement>('.kui-tree-view-item')[index]?.focus()
}

function keyDown(event: KeyboardEvent) {
  // A chord, such as Alt+Left going back a page, stays the browser's; Shift only types a capital.
  if (event.altKey || event.ctrlKey || event.metaKey || (event.shiftKey && (event.key.length > 1 || event.key === ' ')))
    return

  const at = stop()
  const row = rows().find(one => one.node.id === at)

  if (at === undefined || !row)
    return

  if (event.key === 'Enter' || event.key === ' ') {
    event.preventDefault()
    pick(row)

    return
  }

  const move = treeKey(rows(), at, event.key, open())

  if (!move)
    return

  event.preventDefault()

  if ('focus' in move)
    focusRow(move.focus)
  else
    toggle('open' in move ? move.open : move.close)
}
---
// The rows of every open branch in one list, each saying its depth and place for screen readers, so the arrows walk them in reading order.
ul(part="root" {...rest} ref={element => list = element} role="tree" aria-label={label} onKeyDown={keyDown})
  for row of rows() key={row.node.id}
    li(part="item" role="treeitem" aria-level={row.level} aria-posinset={row.position} aria-setsize={row.size} aria-expanded={row.node.children ? String(open().has(row.node.id)) : undefined} aria-selected={row.node.id === current() ? 'true' : 'false'} tabindex={row.node.id === stop() ? 0 : -1} style={`--kui-tree-level: ${row.level - 1}`} onFocus={() => focused.set(row.node.id)} onClick={event => click(event, row)})
      if row.node.children
        span(part="toggle" aria-hidden="true")
          Icon(icon="chevron")
      else
        span(part="toggle")
      if row.node.icon
        Icon(icon={row.node.icon} part="icon")
      span(part="label") {row.node.label}
