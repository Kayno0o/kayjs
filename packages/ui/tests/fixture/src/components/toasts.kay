---
import Toaster from '@kaynooo/kayjs-ui/toaster.kay'
import { toast } from '@kaynooo/kayjs-ui'
---
button#saved(onClick={() => toast.success('Saved')}) Save
button#refused(onClick={() => toast.error('Refused')}) Refuse
button#copied(onClick={() => toast.info('Copied')}) Copy
button#sticky(onClick={() => toast.info('Stuck', { duration: Infinity })}) Stick
Toaster
