---
import type { AxisFactory, ChartPlugin, DomRenderOutput, Layer, LineChartPresetOptions, LinePresetState, Renderer } from 'chartist'
import type { JSX } from 'kay'
import type { ChartSeries } from './plot'
import { effect, memo, onCleanup, onMount, recipe, signal, uid } from 'kay'
import type { LabelContext } from './chart-axis'
import { chartData, headings, indexAt, labelTimes, positionOf, stackValues, totalAt, xAxisOptions } from './chart-axis'
import { dashSample, PALETTE, SERIES_DASHES, steppedPoint } from './plot'
import { wording } from 'kay/words'

// Which attribute of each drawn part takes its series' colour.
const PAINT: Record<string, string> = { line: 'stroke', point: 'stroke', area: 'fill' }

const look = recipe({
  parts: {
    root: 'kui-line-chart flex flex-col gap-2',
    frame: 'relative',
    // chartist draws the plot, and the rules it needs from its own stylesheet stay on this class in theme.css.
    plot: 'kui-line-chart-plot h-[var(--chart-height,9rem)]',
    cursor: 'pointer-events-none absolute w-px bg-border-strong',
    dot: 'pointer-events-none absolute size-2 -translate-1/2 border border-background',
    band: 'pointer-events-none absolute border-x border-accent bg-accent/10',
    overlay: 'absolute inset-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent data-range:cursor-crosshair data-range:touch-pan-y data-range:select-none',
    tooltip: 'pointer-events-none fixed top-0 left-0 z-50 flex w-max max-w-full flex-col gap-0.5 border-solid border-[length:var(--border-width)] border-border-strong bg-surface-strong px-3 py-2 text-xs',
    tooltipLabel: 'mb-1 text-foreground',
    // The total sits under the series with no swatch, its name lined up with theirs.
    tooltipRow: 'flex items-center gap-1.5 text-muted data-total:mt-0.5 data-total:border-t data-total:border-solid data-total:border-border-strong data-total:pt-1 data-total:pl-3.5 data-total:text-foreground',
    tooltipName: 'truncate',
    tooltipValue: 'ml-auto pl-3 font-mono text-foreground tabular-nums',
    swatch: 'size-2 shrink-0',
    // What screen readers read in place of the drawing: every value, and how to pick a span from the keyboard.
    data: 'sr-only',
    hint: 'sr-only',
    legend: 'flex flex-wrap gap-4 pl-1',
    legendItem: 'flex items-center gap-1.5 text-xs text-muted',
    // A sample of the line of the series, dashed as it draws.
    key: 'h-0.5 w-4 shrink-0',
  },
})

const { labels, series, formatValue = (value: number) => value.toLocaleString(), formatLabel, xLabels = false, stacked = false, totalLabel = wording('ui.lineChart.total', 'Total'), legend, pointKey, animate = false, options, onRange, rangeHint = wording('ui.lineChart.rangeHint', 'Shift with the arrow keys picks a span, Enter applies it, Escape drops it'), label, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'children' | 'role'> & {
  labels: string[]
  series: ChartSeries[]
  // Formats the y-axis labels, the tooltip's values and the readings screen readers hear.
  formatValue?: ((value: number) => string) | undefined
  // Formats a label for the tooltip's heading, the x-axis ticks and what screen readers hear; the context says which point it is, whether it heads the tooltip or sits on the axis, how many milliseconds the labels span and whether points are seconds apart. A label that is a date reads in the page's locale by default.
  formatLabel?: ((label: string, context: LabelContext) => string) | undefined
  // Draws the x-axis labels: up to five, spaced by time when every label is a date.
  xLabels?: boolean | undefined
  // Draws each series on top of the ones before it, the band between two lines filled, so the top line reads the total: the tooltip, the announcements and the table still read each series' own value, and add a total.
  stacked?: boolean | undefined
  // Names the total a stacked chart adds to its tooltip, its announcements and its table.
  totalLabel?: string | undefined
  // Names each series under the chart; shown by default once there is more than one.
  legend?: boolean | undefined
  // What identifies a point across updates, so a series that gains points on the right and loses them on the left moves its points instead of redrawing them: `'label'` follows each point by its label, `'index'` by its position, and a function by what it returns. Labels that are all different identify by label by default, others by position.
  pointKey?: 'index' | 'label' | ((point: { series: number, index: number, label: string }) => string | number) | undefined
  // Moves the points and lines from the old data to the new on each update, unless the visitor's system asks for reduced motion.
  animate?: boolean | undefined
  // Merged over the defaults, for what the props do not cover.
  options?: LineChartPresetOptions | undefined
  // Lets a drag across the plot, or Shift with the arrow keys then Enter, pick a span, handed over as the indices of its first and last points, such as to zoom in on it.
  onRange?: ((from: number, to: number) => unknown) | undefined
  // Tells screen readers how to pick a span from the keyboard, once the chart takes `onRange`.
  rangeHint?: string | undefined
  // Names the chart for screen readers, which read its values from a table they alone see.
  label: string
}>()

const id = uid()
const distinct = memo(() => new Set(labels).size === labels.length)
const times = memo(() => labelTimes(labels))
const headingTexts = memo(() => headings(labels, times(), formatLabel))
// The heights the series are drawn at: their own values, or each laid on the ones before it when stacked.
const heights = memo(() => stacked ? stackValues(series.map(item => item.values)) : series.map(item => item.values))
const colors = memo(() => series.map((item, index) => item.color ?? PALETTE[index % PALETTE.length]!))
// A stacked chart draws every line solid: its filled bands tell the series apart, and the dash cycle would repeat every six.
const dashes = memo(() => series.map((_, index) => stacked ? '' : SERIES_DASHES[index % SERIES_DASHES.length]!))

// The room the y labels measured for themselves: the widest one, which chartist would wrap at its default 30 px, and their height, which the top tick's label rises above the plot by.
const fit = signal({ width: 0, height: 0 })

// Where chartist drew the plot, in px from the top left of the drawing, and where it puts a value up the y-axis.
interface Plot {
  x1: number
  y1: number
  y2: number
  width: number
  height: number
  project: (value: number) => number
}

// Where chartist last drew the plot, which the hover cursor and dots are placed against.
const plot = signal<Plot | null>(null)

// The path of each stacked series' area as drawn, so the next series' area can cut it out.
const areas: (string | undefined)[] = []

// A layer that draws nothing: it reads where the plot is and the y-axis from each render, and gives every drawn part its series' colour and dash, so any number of series takes any colour with no stylesheet per chart.
// A stacked area is the band between its line and the one below: its own area and the one below it, filled with the even-odd rule, leave only the band.
const probe: Layer = {
  type: 'kui-line-chart',
  coordinates: ['cartesian'],
  series: [],
  compose: ({ area, axes }) => {
    const axis = axes.y

    areas.length = 0
    plot = axis ? { x1: area.x1, y1: area.y1, y2: area.y2, width: area.width, height: area.height, project: value => axis.project(value) } : null

    return []
  },
  refine: (part) => {
    const paint = part.role === undefined ? undefined : PAINT[part.role]
    const index = part.ctx?.seriesIndex

    if (!paint || index === undefined)
      return undefined

    let painted = part

    if (part.role === 'area' && stacked) {
      const own = part.attrs.d
      const below = areas.slice(0, index).findLast(Boolean)

      areas[index] = own
      painted = part.attr({ 'd': below ? `${own} ${below}` : own, 'fill-rule': 'evenodd' })
    }

    const dash = part.role === 'line' ? dashes()[index] : ''

    return painted.attr({ style: `${paint}: ${colors()[index]}${dash ? `; stroke-dasharray: ${dash}` : ''}` })
  },
}

const settings = (fixedScale: AxisFactory): LineChartPresetOptions => {
  const padding = typeof options?.chartPadding === 'object' ? options.chartPadding : {}

  return {
    fullWidth: true,
    showArea: true,
    showPoint: false,
    ...stacked ? { low: heights().flat().reduce<number>((lowest, height) => Math.min(lowest, height ?? 0), 0) } : {},
    ...options,
    layers: { ...options?.layers, above: [probe, ...options?.layers?.above ?? []] },
    chartPadding: { top: Math.max(8, fit().height), right: xLabels ? 24 : 8, bottom: 0, left: 0, ...padding },
    axisX: { ...xAxisOptions(labels, times(), xLabels, fixedScale, formatLabel), ...options?.axisX },
    axisY: { showLabel: true, showGrid: true, offset: Math.max(40, fit().width + 10), labelInterpolationFnc: (value: string | number) => formatValue(Number(value)), ...options?.axisY },
  }
}

const hovered = signal<{ index: number, clientX: number, clientY: number } | null>(null)
// The points a drag or a keyboard pick under way started and stands at.
const dragged = signal<{ from: number, to: number } | null>(null)
// The tooltip's own size, watched so it is placed from its natural width and never narrowed against an edge.
const tipSize = signal({ width: 0, height: 0, wide: 0, high: 0 })
let canvas: HTMLDivElement | undefined
let tipObserver: ResizeObserver | undefined

// The distance kept between the tooltip and the viewport's edges, and between it and the pointer.
const EDGE = 4
const GAP = 12

// Where the tooltip's corner goes: centred over the pointer and above it, flipped below when the top would be cut off, and shifted to stay inside the viewport on every side.
const tipPlace = () => {
  const at = hovered()!
  const { width, height, wide, high } = tipSize()
  const hidden = width === 0 ? '; visibility: hidden' : ''
  const above = at.clientY - height - GAP
  const top = above >= EDGE ? above : at.clientY + GAP

  return `translate: ${Math.max(EDGE, Math.min(at.clientX - width / 2, wide - width - EDGE))}px ${Math.max(EDGE, Math.min(top, high - height - EDGE))}px${hidden}`
}

const watchTip = (element: HTMLElement) => {
  tipObserver?.observe(element)
}

const cursor = () => {
  const drawn = plot()
  const at = hovered()

  return drawn && at ? drawn.x1 + positionOf(at.index, labels.length, times()) * drawn.width : null
}

// The dot of a series at the hovered point, placed on its line, or nothing where it has no reading.
const dot = (index: number) => {
  const drawn = plot()
  const at = hovered()
  const own = at ? series[index]!.values[at.index] : undefined
  const height = at ? heights()[index]![at.index] : undefined

  return drawn && typeof own === 'number' && typeof height === 'number' ? `left: ${cursor()}px; top: ${drawn.y1 - drawn.project(height)}px; background-color: ${colors()[index]}` : undefined
}

const valueText = (item: ChartSeries, index: number) => {
  const value = item.values[index]

  return typeof value === 'number' ? formatValue(value) : '-'
}

const reading = (index: number) => {
  const at = hovered()

  return at ? valueText(series[index]!, at.index) : '-'
}

const totalText = (index: number) => formatValue(totalAt(series, index))

const heading = (index: number) => headingTexts()[index] ?? ''

// The point the keyboard stands at, the latest one before it moved.
const current = () => hovered()?.index ?? Math.max(0, labels.length - 1)

// What screen readers announce as the keyboard moves: the point's label, each series' reading, then the span being picked.
const announced = () => {
  const index = current()
  const span = dragged()
  const readings = [...series.map(item => `${item.name} ${valueText(item, index)}`), ...stacked ? [`${totalLabel} ${totalText(index)}`] : []].join(', ')
  const picked = span && span.from !== span.to ? `; ${heading(Math.min(span.from, span.to))} - ${heading(Math.max(span.from, span.to))}` : ''

  return `${heading(index)}: ${readings}${picked}`
}

// Reads the y labels as drawn, which stay on one line, and gives them the room they took: a redraw settles at once, as a label's own size does not depend on the room it is given.
const fitLabels = () => {
  const range = document.createRange()
  let width = 0
  let height = 0

  for (const label of canvas?.querySelectorAll('.ct-label.ct-vertical') ?? []) {
    range.selectNodeContents(label)

    const box = range.getBoundingClientRect()

    width = Math.max(width, box.width)
    height = Math.max(height, box.height)
  }

  const next = { width: Math.ceil(width), height: Math.ceil(height) }
  const now = fit()

  if (next.width !== now.width || next.height !== now.height)
    fit = next
}

// Drawn in the browser alone: chartist measures the box it draws into. It is read once the chart is on the page, so the page's own code loads and runs first.
onMount(() => {
  tipObserver = new ResizeObserver((entries) => {
    const box = entries.at(-1)?.target

    if (!box?.isConnected)
      return

    const { width, height } = box.getBoundingClientRect()

    tipSize = { width, height, wide: document.documentElement.clientWidth, high: document.documentElement.clientHeight }
  })

  const drawing = signal<{ state: LinePresetState, fixedScale: AxisFactory } | null>(null)
  let gone = false
  let handle: { destroy: () => void } | undefined
  let state: LinePresetState | undefined
  // The renderer that patches the drawing in place, loaded by the first update of the data: a chart that never changes never loads it. It is `undefined` until then, and the chart draws with the plain one.
  let live: Renderer<DomRenderOutput> | undefined
  let liveState: 'unused' | 'loading' | 'failed' | 'ready' = options?.renderer ? 'failed' : 'unused'

  void (async () => {
    let loaded: typeof import('chartist')

    try {
      loaded = await import('chartist')
    }
    catch (error) {
      console.error('kayjs-ui: LineChart draws with chartist, which could not be loaded; install chartist 2 with `bun add chartist@^2`', error)

      return
    }

    if (gone)
      return

    // What the chart does around each render: it keeps the preset's state, whose update takes the data and the options in one render, and gives the y labels the room they measure once they are on the page.
    const plugin: ChartPlugin = {
      name: 'kui-line-chart',
      install: (chart) => {
        chart.on('resolve', ({ config }) => {
          if (config.preset?.kind === 'line')
            state = config.preset
        })
        chart.on('mount', () => {
          fitLabels()
        })
      },
    }

    // `plugins`, `on` and `renderer` are read once, when the chart is created, so the app's own go in here. The renderer hands over to the live one once it is loaded, which patches what the plain one drew.
    const plain = loaded.domRenderer()
    const renderer: Renderer<DomRenderOutput> = { ...plain, render: (scene, target, update) => (live ?? plain).render(scene, target, update) }

    handle = loaded.lineChart(canvas!, { series: [] }, { plugins: [plugin, ...options?.plugins ?? []], ...options?.on ? { on: options.on } : {}, renderer: options?.renderer ?? renderer })

    if (state)
      drawing = { state, fixedScale: loaded.fixedScaleAxis() }
  })()

  const identify = (point: { seriesIndex: number, valueIndex: number, label: unknown }) => {
    const rule = pointKey ?? (distinct() ? 'label' : 'index')

    if (typeof rule === 'function')
      return rule({ series: point.seriesIndex, index: point.valueIndex, label: String(point.label) })

    return rule === 'label' ? String(point.label) : point.valueIndex
  }

  const redraw = (ready: { state: LinePresetState, fixedScale: AxisFactory }) => ready.state.update(chartData(labels, heights(), times()), settings(ready.fixedScale), true)

  // Loads the live renderer for the first update of the data, then draws it, so what the chart shows is patched from then on.
  async function goLive(ready: { state: LinePresetState, fixedScale: AxisFactory }) {
    liveState = 'loading'

    try {
      const module = await import('chartist/live')
      const animations = module.smilAnimations()

      live = module.liveDomRenderer({ key: identify, animations: { animate: context => animate ? animations.animate(context) : undefined } })
      liveState = 'ready'
    }
    catch (error) {
      console.error('kayjs-ui: LineChart could not load chartist/live, so an update redraws the chart; install chartist 2.2 or later with `bun add chartist@^2.2`', error)
      liveState = 'failed'
    }

    if (!gone)
      redraw(ready)
  }

  // The data an update drew last, to tell new points from a label measuring itself.
  let drawn: { labels: string[], heights: (number | null)[][] } | undefined

  effect(() => {
    const ready = drawing()

    if (!ready)
      return

    const now = { labels, heights: heights() }
    const moved = drawn !== undefined && (drawn.labels !== now.labels || drawn.heights !== now.heights)

    drawn = now

    if (liveState === 'loading' || (liveState === 'unused' && moved)) {
      if (liveState === 'unused')
        void goLive(ready)

      return
    }

    redraw(ready)
  })

  // New points, such as a span the app zoomed in on, leave nothing picked on the old ones, whose indices may not exist any more.
  let shown = labels

  effect(() => {
    if (labels === shown)
      return

    shown = labels
    hovered = null
    dragged = null
  })

  onCleanup(() => {
    gone = true
    tipObserver?.disconnect()
    handle?.destroy()
  })
})

// The point under the pointer, or none before the plot is drawn.
function pointAt(event: PointerEvent): number | null {
  const drawn = plot()

  if (!drawn || labels.length === 0)
    return null

  const width = drawn.width
  const x = event.clientX - (event.currentTarget as HTMLElement).getBoundingClientRect().left - drawn.x1

  return indexAt(width > 0 ? x / width : 0, labels.length, times())
}

// Where the dragged span is drawn across the plot, once it covers more than one point.
const band = () => {
  const drawn = plot()
  const span = dragged()

  if (!drawn || !span || span.from === span.to)
    return null

  const [left, right] = [span.from, span.to].map(index => drawn.x1 + positionOf(index, labels.length, times()) * drawn.width).sort((a, b) => a - b)

  return `left: ${left}px; width: ${right! - left!}px; top: ${drawn.y2}px; height: ${drawn.height}px`
}

function pointerMove(event: PointerEvent) {
  const index = pointAt(event)

  if (index === null)
    return

  hovered = { index, clientX: event.clientX, clientY: event.clientY }

  if (dragged())
    dragged = { from: dragged()!.from, to: index }
}

function pointerDown(event: PointerEvent) {
  const index = pointAt(event)

  if (!onRange || event.button !== 0 || index === null)
    return

  const overlay = event.currentTarget as HTMLElement

  // Captured, so a drag released past the plot still ends the span.
  overlay.setPointerCapture?.(event.pointerId)
  dragged = { from: index, to: index }
}

function finishSpan() {
  const span = dragged()

  dragged = null

  if (span && span.from !== span.to)
    void onRange?.(Math.min(span.from, span.to), Math.max(span.from, span.to))
}

// Shows the cursor, dots and tooltip at a point the keyboard reached, the tooltip over the plot's top at that point.
function show(index: number, overlay: HTMLElement) {
  const drawn = plot()
  const box = overlay.getBoundingClientRect()
  const x = drawn ? drawn.x1 + positionOf(index, labels.length, times()) * drawn.width : 0

  hovered = { index, clientX: box.left + x, clientY: box.top + (drawn?.y2 ?? 0) }
}

function keyDown(event: KeyboardEvent) {
  // Chords stay the browser's and the system's, Alt with an arrow going back or forward; Shift alone picks a span.
  if (event.altKey || event.ctrlKey || event.metaKey)
    return

  if (event.key === 'Escape' && dragged()) {
    event.preventDefault()
    dragged = null

    return
  }

  if (event.key === 'Enter' && dragged()) {
    event.preventDefault()
    finishSpan()

    return
  }

  const index = steppedPoint(event.key, current(), labels.length)

  if (index === undefined || labels.length === 0)
    return

  event.preventDefault()
  dragged = event.shiftKey && onRange ? { from: dragged()?.from ?? current(), to: index } : null
  show(index, event.currentTarget as HTMLElement)
}

// Only focus from the keyboard shows a point: a press focuses the plot too, and its pointer places the tooltip itself.
function focused(event: FocusEvent) {
  const overlay = event.currentTarget as HTMLElement

  if (!hovered() && labels.length > 0 && overlay.matches(':focus-visible'))
    show(current(), overlay)
}

function blurred() {
  hovered = null
  dragged = null
}

// The pointer leaving takes its point along, unless the keyboard is on the plot and still reading one.
function pointerLeave(event: PointerEvent) {
  if (!(event.currentTarget as HTMLElement).matches(':focus-visible'))
    hovered = null
}
---
div(part="root" {...rest} role="figure" aria-label={label})
  div(part="frame")
    div(part="plot" ref={element => canvas = element} aria-hidden="true")
    if cursor() !== null
      div(part="cursor" style={`left: ${cursor()}px; top: ${plot()!.y2}px; height: ${plot()!.height}px`})
      for item, index of series key={item.name}
        if dot(index)
          div(part="dot" style={dot(index)})
    if band() !== null
      div(part="band" style={band()})
    div(part="overlay" role="slider" tabindex={labels.length > 0 ? '0' : '-1'} aria-label={label} aria-valuemin="0" aria-valuemax={Math.max(0, labels.length - 1)} aria-valuenow={current()} aria-valuetext={announced()} aria-describedby={onRange ? `${id}-hint` : undefined} data-range={onRange ? '' : undefined} onKeyDown={keyDown} onFocus={focused} onBlur={blurred} onPointerDown={pointerDown} onPointerMove={pointerMove} onPointerUp={finishSpan} onPointerCancel={() => dragged = null} onPointerLeave={pointerLeave})
  if hovered()
    div(part="tooltip" ref={watchTip} style={tipPlace()} aria-hidden="true")
      div(part="tooltipLabel") {heading(hovered()!.index)}
      for item, index of series key={item.name}
        div(part="tooltipRow")
          span(part="swatch" style={`background-color: ${colors()[index]}`})
          span(part="tooltipName") {item.name}
          span(part="tooltipValue") {reading(index)}
      if stacked
        div(part="tooltipRow" data-total)
          span(part="tooltipName") {totalLabel}
          span(part="tooltipValue") {totalText(hovered()!.index)}
  // A table box ignores the 1px size and clip of sr-only and would scroll the page by its full height, so the table sits in a block that carries them.
  div(part="data")
    table
      caption {label}
      thead
        tr
          td
          for item of series key={item.name}
            th(scope="col") {item.name}
          if stacked
            th(scope="col") {totalLabel}
      tbody
        for name, index of labels key={index}
          tr
            th(scope="row") {name}
            for item of series key={item.name}
              td {valueText(item, index)}
            if stacked
              td {totalText(index)}
  if onRange
    span(part="hint" id={`${id}-hint`}) {rangeHint}
  if legend ?? series.length > 1
    ul(part="legend")
      for item, index of series key={item.name}
        li(part="legendItem")
          span(part="key" style={dashSample(colors()[index]!, dashes()[index]!)})
          | {item.name}
