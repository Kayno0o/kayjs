---
import type { Column } from '@kaynooo/kayjs-ui'
import type { MissingRow, RedirectStatus } from '../missing'
import Button from '@kaynooo/kayjs-ui/button.kay'
import ConfirmDelete from '@kaynooo/kayjs-ui/confirm-delete.kay'
import CopyButton from '@kaynooo/kayjs-ui/copy-button.kay'
import EmptyState from '@kaynooo/kayjs-ui/empty-state.kay'
import Table from '@kaynooo/kayjs-ui/table.kay'
import { refresh } from 'kay'
import { wording } from 'kay/words'
import { addMissingRedirect, dismissMissingPaths } from '../editor/save'
import { shipWords } from '../editor/words'
import AddRedirect from './add-redirect.kay'

// `hint` says why the list may be empty, which depends on the server's mode.
const { rows, hint } = props<{ rows: MissingRow[], hint: string }>()

// Looks up what an addition says once the page has loaded, so the page sends it.
shipWords()

async function add(from: string, to: string, status: RedirectStatus): Promise<void> {
  if (await addMissingRedirect(from, to, status))
    await refresh()
}

// Without paths, the whole list. The confirmed one throws its failure to the confirm, which words it and stays open.
async function dismiss(paths?: string[], throws = false): Promise<boolean> {
  const done = await dismissMissingPaths(paths, throws)

  if (done)
    await refresh()

  return done
}

const columns: Column<MissingRow>[] = [
  { key: 'path', header: wording('cms.missing.path', 'Path'), sortValue: true, cell: true },
  { key: 'hits', header: wording('cms.missing.hits', 'Visits'), sortValue: true, defaultDirection: 'desc', align: 'end' },
  { key: 'lastSeen', header: wording('cms.missing.lastSeen', 'Last visit (UTC)'), sortValue: true },
  { key: 'from', header: wording('cms.missing.from', 'From'), cell: true },
  { key: 'target', header: wording('cms.missing.suggestion', 'Suggested target'), cell: true },
  { key: 'actions', header: wording('cms.table.actions', 'Actions'), align: 'end', cell: true },
]
---
if rows.length > 0
  .kcms-missing-clear
    ConfirmDelete(message={wording('cms.missing.clearMessage', 'Forget all the paths listed? They are listed again as visitors ask for them.')} label={wording('cms.missing.clear', 'Clear the list')} trigger="button" failure={wording('cms.missing.dismissFailure', 'Could not dismiss the paths')} size="sm" variant="ghost" onConfirm={async () => { await dismiss(undefined, true) }})
Table.kcms-missing(columns={columns} rows={rows} rowKey={row => row.path} sort={{ key: 'hits', direction: 'desc' }} selectable)
  @bulk(keys, clear)
    Button(label={wording('cms.missing.dismissSelected', 'Dismiss {count} selected', { count: keys.length })} size="sm" variant="ghost" onClick={async () => { if (await dismiss(keys.map(String))) clear() }})
  @cell(row, column)
    if column.key === 'path'
      code.kcms-missing-path {row.path}
    else if column.key === 'from'
      .kcms-missing-from
        for page of row.pages key={page}
          code {page}
        if row.from !== ''
          small {row.from}
    else if column.key === 'actions'
      AddRedirect(path={row.path} suggested={row.target} onAdd={add})
      Button(label={wording('cms.missing.dismiss', 'Dismiss')} aria-label={wording('cms.missing.dismissLabel', 'Dismiss {path}', { path: row.path })} size="sm" variant="ghost" onClick={async () => { await dismiss([row.path]) }})
    else if row.target as target
      .kcms-missing-target
        code.kcms-missing-path {target}
        small {row.reason}
        if row.line as line
          CopyButton(text={line} label={wording('cms.missing.copy', 'Copy redirect')} aria-label={wording('cms.missing.copyLabel', 'Copy the redirect from {path}', { path: row.path })} size="sm" variant="ghost")
  @empty
    EmptyState(title={wording('cms.missing.empty', 'No missing page recorded')} description={hint})
