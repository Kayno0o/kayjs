--- <Data>
import { signal } from 'kay'
import Button from './button.kay'
import Dialog from './dialog.kay'
import IconButton from './icon-button.kay'
import { attempt } from './toast'

const { message, onConfirm, failure, refused, trigger = 'icon', ask = 'dialog', label = 'Delete', title = 'Confirm Deletion', confirmLabel = 'Delete', pendingLabel = 'Deleting…', cancelLabel = 'Cancel', size, variant, class: className } = props<{
  // The dialog's question; asked inline, the armed pair's name for screen readers and the confirm button's tooltip.
  message: string
  // Deletes. The dialog stays open, its buttons disabled, until a returned promise settles, and closes once it resolves.
  onConfirm: () => void | Promise<void>
  // Toasted when `onConfirm` throws, which leaves the dialog open, unless the call carries a message of its own: see `attempt`.
  failure: string
  // What a refusal of the action's handler says, from the data it passed to `ctx.fail`: toasted in place of `failure`, which stays for an answer of undefined or another error.
  refused?: ((data: Data) => string | undefined) | undefined
  // An icon by default; `button` is a labelled danger button, for a dialog footer, and `link` a plain underlined text button, for a confirm inside running text.
  trigger?: 'icon' | 'button' | 'link' | undefined
  // `inline` asks in place of the trigger instead of in a dialog: a click arms it into a danger button that deletes and one that cancels, for a row of a list.
  ask?: 'dialog' | 'inline' | undefined
  // What the trigger says, for a delete the reader knows by another name: "Empty trash", "Revoke link".
  label?: string | undefined
  // The dialog's title, for a confirm that is not a deletion: "Rotate link".
  title?: string | undefined
  // The confirm button's text, and the one it shows while `onConfirm` is pending.
  confirmLabel?: string | undefined
  pendingLabel?: string | undefined
  cancelLabel?: string | undefined
  // The icon trigger's size and look, `size` sizing the cancel button too when asking inline; the button trigger is always a danger button.
  size?: 'xs' | 'sm' | 'md' | 'lg' | undefined
  variant?: 'solid' | 'ghost' | 'inline' | 'danger' | undefined
  // Goes on the trigger.
  class?: string | undefined
}>()

const open = signal(false)
const pending = signal(false)
// The trigger asking inline, hidden while armed, which takes the focus back once the pair goes; and the pair, which takes it back after a failed delete.
let opener: HTMLElement | undefined
let armed: HTMLElement | undefined

function start(event: MouseEvent) {
  opener = event.currentTarget as HTMLElement
  open.set(true)
}

function close() {
  open.set(false)

  if (ask === 'inline')
    queueMicrotask(() => opener?.focus())
}

async function confirm() {
  pending.set(true)

  const deleted = await attempt(async () => onConfirm(), failure, refused)

  pending.set(false)

  if (deleted)
    close()
  else if (ask === 'inline')
    queueMicrotask(() => armed?.querySelector('button')?.focus())
}

function keyDown(event: KeyboardEvent) {
  if (event.key === 'Escape' && !pending()) {
    event.preventDefault()
    close()
  }
}
---
if trigger === 'button'
  Button(label={label} variant="danger" hidden={ask === 'inline' && open()} class={className} onClick={start})
else if trigger === 'link'
  button.kui-confirm-delete-link(type="button" hidden={ask === 'inline' && open()} class={className} onClick={start}) {label}
else
  IconButton(icon="delete" label={label} size={size} variant={variant} hidden={ask === 'inline' && open()} class={className} onClick={start})
if ask === 'inline'
  if open()
    // Armed by a click, so the focus moves onto the button that deletes.
    span.kui-confirm-delete-armed(ref={element => { armed = element; queueMicrotask(() => element.querySelector('button')?.focus()) }} role="group" aria-label={message} onKeyDown={keyDown})
      Button(label={pending() ? pendingLabel : confirmLabel} variant="danger" busy={pending()} disabled={pending()} data-tooltip={message} onClick={confirm})
      IconButton(icon="close" label={cancelLabel} size={size} variant="ghost" disabled={pending()} onClick={close})
else
  Dialog(open={open()} title={title} dirty={pending()} onClose={() => open.set(false)})
    @footer
      Button(label={cancelLabel} disabled={pending()} onClick={() => open.set(false)})
      Button(label={pending() ? pendingLabel : confirmLabel} variant="danger" busy={pending()} disabled={pending()} onClick={confirm})
    p.kui-confirm-delete-message {message}
