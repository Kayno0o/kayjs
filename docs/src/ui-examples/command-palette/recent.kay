---
import Button from '@kaynooo/kayjs-ui/button.kay'
import CommandPalette from '@kaynooo/kayjs-ui/command-palette.kay'
import type { PaletteEntry } from '@kaynooo/kayjs-ui'

const open = signal(false)
const recent = signal<string[]>([])
const entries: PaletteEntry[] = [
  { label: 'Bun', group: 'Links', href: 'https://bun.sh', external: true },
  { label: 'MDN', group: 'Links', href: 'https://developer.mozilla.org', external: true },
  { label: 'Tailwind CSS', group: 'Links', href: 'https://tailwindcss.com', external: true },
]
---
Button(label="Open the palette" onClick={() => open.set(true)})
CommandPalette(open={open} onOpenChange={open.set} entries={entries} recent={recent()} onRecentChange={recent.set})
