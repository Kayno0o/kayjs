---
import type { AuthMail } from '@kayjs/mail'
import AuthNotice from '@kayjs/mail/auth-notice.kay'
import Paragraph from '@kayjs/mail/paragraph.kay'

const { mail } = props<{ mail: AuthMail }>()
---
AuthNotice(mail={mail} review="Your sessions:" ending="Write to us if it was not you.")
  Paragraph(muted) {mail.detail ?? 'An unknown device'}
