--- server
import { t } from 'elysia'
import { action } from 'kay'
import { stamp } from '../renders'

export const send = action(t.Object({ stamp: t.String({ pattern: '^stamp-' }) }), async () => 'sent')

const current = stamp()
const failure = send.failed()
--- script
import Contact from '../components/contact.kay'
import Hero from '../components/hero.kay'
import Stamped from '../components/stamped.kay'
---
h1 Home
Hero
Stamped(server stamp={current} to={send})
if failure
  p.failed Not sent
Contact(stamp={current})
p.after After
