--- server
import { s } from 'kay'

export const page = { query: s.Object({ token: s.Optional(s.String()) }) }

export const confirm = action(s.Object({ token: s.String() }), async ({ token }, ctx) => {
  const result = await ctx.locals.auth.confirmEmailChange(token)

  if (!result.ok)
    return ctx.fail(400, { error: result.error })

  return ctx.redirect('/account')
})

const token = ctx.query.token ?? ''
--- script
import Button from '@kaynooo/kayjs-ui/button.kay'
---
head
  title Confirm your new address
h1.text-2xl.font-bold Confirm your new address
form.page-form(action={confirm})
  input(type="hidden" name="token" value={token})
  Button(label="Move my account to it" variant="accent" type="submit")
if confirm.failed()
  p.text-kui-error This link has expired or was already used.
