--- server
import { t } from 'kay'
import { EMAIL_WORDS, FAILURE_WORDS, PASSWORD_WORDS, USERNAME_WORDS } from '../words'

export const join = action(t.Object({
  username: t.String({ pattern: '\\S', maxLength: 32, error: 'Write a name' }),
  email: t.String({ maxLength: 254 }),
  password: t.String({ maxLength: 128 }),
}), async (input, ctx) => {
  const result = await ctx.locals.auth.register(input)

  if (!result.ok)
    return ctx.fail(400, 'errors' in result ? { errors: result.errors } : { error: result.error })

  return ctx.redirect('/')
})

const refused = ctx.failed(join)?.data
const errors = refused?.errors ?? {}
const failure = refused?.error && FAILURE_WORDS[refused.error]
---
---
import Button from '@kaynooo/kayjs-ui/button.kay'
import FormField from '@kaynooo/kayjs-ui/form-field.kay'
---
head
  title Join
h1.text-2xl.font-bold Join the board
p.text-kui-muted We mail you a link to confirm your address; members with a confirmed address hear of each new notice.
form.page-form(action={join})
  FormField(label="Name" issue={join.error('username') ?? (errors.username && USERNAME_WORDS[errors.username])} required)
    input(name="username" autocomplete="username" required)
  FormField(label="Email" issue={errors.email && EMAIL_WORDS[errors.email]} required)
    input(name="email" type="email" autocomplete="email" required)
  FormField(label="Password" hint="10 characters or more" issue={errors.password && PASSWORD_WORDS[errors.password]} required)
    input(name="password" type="password" autocomplete="new-password" required)
  if failure
    p.text-kui-error {failure}
  Button(label="Join" variant="accent" type="submit")
p.mt-4
  | Already a member?
  a(href="/login") Sign in
