--- server
import type { ToolResult } from 'kay/library'
import { action, s } from 'kay'
import { actionTool, currentRequest } from 'kay/library'
import { wipe } from './admin/_actions.kay'
import { rename } from './items/[id].kay'
import { addNote, breaks, described, language, named, refuses, sendsAway, limited, signup, solve, upload, vetoed } from './targets/_actions.kay'

const offered = { addNote, breaks, described, language, limited, named, refuses, rename, sendsAway, signup, solve, upload, vetoed, wipe }

type Offered = keyof typeof offered

// What a library would call: the action offered to a model, run as the visitor.
export const run = action(s.Object({ name: s.String(), args: s.Record(s.String(), s.Unknown()) }), async ({ name, args }): Promise<ToolResult> => actionTool(offered[name as Offered])!.call(args))

export const shape = action(s.Object({ name: s.String() }), ({ name }) => {
  const tool = actionTool(offered[name as Offered])

  return tool && { name: tool.name, description: tool.description, inputSchema: tool.inputSchema }
})

export const current = action(() => currentRequest()?.url ?? null)

let afterAnswer: string | null | undefined

// What `currentRequest()` gives once the answer is made, read by `recorded`.
export const later = action(() => {
  setTimeout(() => {
    afterAnswer = currentRequest()?.url ?? null
  }, 10)
})

export const recorded = action(() => afterAnswer)

export const unregistered = action(() => {
  const loose = action(() => 'loose')

  try {
    actionTool(loose)

    return 'a tool'
  }
  catch (error) {
    return (error as Error).message
  }
})

// Two actions sharing one name, told apart by the set the library keeps.
export const names = action(() => {
  const taken = new Set<string>()

  return [actionTool(addNote, taken)!.name, actionTool(addNote, taken)!.name, actionTool(addNote)!.name]
})
---
p#current {currentRequest()?.url}
