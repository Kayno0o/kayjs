---
import type { SearchSection } from '../../search-index'
import { effect, memo, navigate, onCleanup, onMount, signal } from 'kay'
import ArrowDown from '~icons/tabler/arrow-down'
import ArrowUp from '~icons/tabler/arrow-up'
import ChevronRight from '~icons/tabler/chevron-right'
import CornerDownLeft from '~icons/tabler/corner-down-left'
import SearchIcon from '~icons/tabler/search'

interface Match {
  section: SearchSection
  score: number
  snippet: { text: string, hit: boolean }[]
}

const SPECIAL = /[.*+?^${}()|[\]\\]/g
const WORDS = /\s+/

const sections = signal<SearchSection[]>()
const failed = signal(false)
const query = signal('')
const active = signal(0)
const shortcut = signal('Ctrl K')
let dialog: HTMLDialogElement | undefined
let input: HTMLInputElement | undefined

const words = memo(() => query().trim().toLowerCase().split(WORDS).filter(word => word !== ''))

// Every word has to appear in the section: a heading match outranks the page title, which outranks the text.
const matches = memo((): Match[] => {
  const all = sections() ?? []
  const terms = words()

  if (terms.length === 0)
    return all.filter(section => section.heading === undefined).map(section => ({ section, score: 0, snippet: [] }))

  const found: Match[] = []

  for (const section of all) {
    const heading = section.heading?.toLowerCase() ?? ''
    const page = section.page.toLowerCase()
    const text = section.text.toLowerCase()
    let score = section.heading === undefined ? 1 : 0

    for (const term of terms) {
      if (heading.includes(term))
        score += heading.startsWith(term) ? 14 : 10
      else if (page.includes(term))
        score += 6
      else if (text.includes(term))
        score += 2
      else {
        score = -1
        break
      }
    }

    if (score >= 0)
      found.push({ section, score, snippet: snippet(section.text, terms) })
  }

  return found.sort((a, b) => b.score - a.score).slice(0, 40)
})

// About a line of text around the first word found, each word in it marked.
function snippet(text: string, terms: string[]): Match['snippet'] {
  const lower = text.toLowerCase()
  const first = Math.min(...terms.map(term => lower.indexOf(term)).filter(index => index >= 0))
  const start = Number.isFinite(first) ? Math.max(0, first - 50) : 0
  const excerpt = (start > 0 ? '…' : '') + text.slice(start, start + 160) + (start + 160 < text.length ? '…' : '')
  const marked = new RegExp(`(${terms.map(term => term.replace(SPECIAL, '\\$&')).join('|')})`, 'gi')

  return excerpt.split(marked).filter(part => part !== '').map((part, index) => ({ text: part, hit: index % 2 === 1 || terms.includes(part.toLowerCase()) }))
}

async function load() {
  if (sections() !== undefined)
    return

  try {
    const response = await fetch('/search.json')
    sections.set(await response.json() as SearchSection[])
  }
  catch {
    failed.set(true)
  }
}

function open() {
  dialog?.showModal()
  input?.select()
  void load()
}

function close() {
  dialog?.close()
}

function go(match: Match | undefined) {
  if (match === undefined)
    return

  close()
  void navigate(match.section.href)
}

function move(by: number) {
  const count = matches().length

  if (count === 0)
    return

  active.set((active() + by + count) % count)
  document.getElementById(`search-${active()}`)?.scrollIntoView({ block: 'nearest' })
}

function onKeyDown(event: KeyboardEvent) {
  if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
    event.preventDefault()
    move(event.key === 'ArrowDown' ? 1 : -1)
  }
  else if (event.key === 'Enter') {
    event.preventDefault()
    go(matches()[active()])
  }
}

const loading = () => sections() === undefined
const activeId = () => matches().length > 0 ? `search-${active()}` : undefined

const typing = (target: EventTarget | null) => target instanceof HTMLElement && (target.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName))

function onShortcut(event: KeyboardEvent) {
  if ((event.key === 'k' && (event.ctrlKey || event.metaKey)) || (event.key === '/' && !typing(event.target))) {
    event.preventDefault()
    open()
  }
}

// A new query starts again from its best match.
effect(() => {
  query()
  active.set(0)
})

onMount(() => {
  if (navigator.platform.startsWith('Mac'))
    shortcut.set('Cmd K')
  window.addEventListener('keydown', onShortcut)
})

onCleanup(() => window.removeEventListener('keydown', onShortcut))
---
button.search-trigger(type="button" aria-haspopup="dialog" onClick={open})
  SearchIcon
  span Search
  kbd {shortcut}
dialog.palette(aria-label="Search the documentation" closedby="any" ref={el => dialog = el})
  .palette-box
    .palette-field
      SearchIcon
      input.palette-input(type="search" placeholder="Search the docs" aria-controls="search-results" aria-activedescendant={activeId()} ref={el => input = el} bind:value={query} onKeyDown={onKeyDown})
    if failed
      p.palette-empty The search index could not load.
    else if loading()
      p.palette-empty Loading…
    else
      ul#search-results.palette-results(role="listbox")
        for match, i of matches key={i}
          li(id={`search-${i}`} role="option" aria-selected={i === active ? 'true' : 'false'} onMouseMove={() => active.set(i)} onClick={() => go(match)})
            span.palette-where
              span {match.section.page}
              if match.section.heading as heading
                ChevronRight
                span.palette-heading {heading}
            if match.snippet.length > 0
              span.palette-snippet
                for part, j of match.snippet key={j}
                  if part.hit
                    mark {part.text}
                  else
                    | {part.text}
        else
          li.palette-empty Nothing matches “{query}”
    p.palette-help
      kbd: ArrowUp
      kbd: ArrowDown
      | to move,
      kbd: CornerDownLeft
      | to open,
      kbd esc
      | to close
