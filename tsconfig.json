{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "kay",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "kay": ["./packages/kay/src/index.ts"],
      "kay/*": ["./packages/kay/src/*"],
      "@kayjs/icons": ["./packages/plugin-icons/src/index.ts"],
      "@kayjs/images": ["./packages/plugin-images/src/index.ts"],
      "@kayjs/seo": ["./packages/plugin-seo/src/index.ts"],
      "@kayjs/mail": ["./packages/plugin-mail/src/index.ts"],
      "@kayjs/auth": ["./packages/plugin-auth/src/index.ts"],
      "@kayjs/auth/sqlite": ["./packages/plugin-auth/src/sqlite.ts"],
      "@kayjs/auth/oauth": ["./packages/plugin-auth/src/oauth.ts"],
      "@kayjs/live": ["./packages/plugin-live/src/index.ts"],
      "@kayjs/live/client": ["./packages/plugin-live/src/client.ts"],
      "@kayjs/content": ["./packages/plugin-content/src/index.ts"],
      "@kayjs/ui": ["./packages/ui/src/index.ts"],
      "@kayjs/ui/plugin": ["./packages/ui/src/plugin.ts"]
    }
  },
  "include": ["packages/*/src", "packages/*/tests", "bench-app", "examples/*/src", "examples/*/kay.config.ts"]
}
