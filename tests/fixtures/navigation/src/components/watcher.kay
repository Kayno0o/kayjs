---
import type { Action } from 'kay'
import { effect, navigate, navigation, onBeforeNavigate, onNavigate, refresh, signal } from 'kay'

const { away } = props<{ away?: Action<Record<string, never>, unknown> }>()
const blocking = signal(false)
const log = (globalThis as { kayLog?: string[] }).kayLog ??= []

effect(() => {
  log.push(`state ${navigation.status()} ${navigation.pending()} ${navigation.to()?.pathname ?? '-'}`)
})
effect(() => {
  const error = navigation.error()

  if (error)
    log.push(`error ${error.status} ${error.message}`)
})
onBeforeNavigate(({ url, from }) => {
  log.push(`before ${from.pathname} ${url.pathname}`)
  // Kept across a full load, which the log is not.
  sessionStorage.setItem('kayBefore', `${sessionStorage.getItem('kayBefore') ?? ''}${url.pathname};`)

  return !blocking()
})
onNavigate(({ url }) => log.push(`navigate ${url.pathname}`))

async function go(to: string) {
  log.push(`resolved ${await navigate(to)}`)
}
---
p.state {navigation.status()}
button.block(onClick={() => blocking.set(true)}) Block
button.go(onClick={() => go('/watched-two')}) Go
button.hash(onClick={() => go('#section')}) Hash
button.same(onClick={() => go(location.pathname)}) Same
button.out(onClick={() => go('/_kay/none')}) Out
button.refresh(onClick={() => refresh()}) Refresh
button.away(onClick={() => away?.({})}) Away
