---
import Checkbox from '@kayjs/ui/checkbox.kay'
import ColorInput from '@kayjs/ui/color-input.kay'
import Combobox from '@kayjs/ui/combobox.kay'
import DateInput from '@kayjs/ui/date-input.kay'
import Slider from '@kayjs/ui/slider.kay'
import Toggle from '@kayjs/ui/toggle.kay'

// kay-allow-file deprecated-ui-input -- the wrapper's own id, title and data-* are what this fixture covers
// Each control that draws an input in a wrapper, given an `id`, a `data-*` and an `title` of its own, an `inputProps` and an attribute the input owns.
---
Toggle(label="Toggle" name="toggle" title="wrapper" data-kind="toggle" inputProps={{ 'id': 'toggle-input', 'data-input': 'toggle' }} disabled)
Checkbox(label="Checkbox" name="checkbox" title="wrapper" data-kind="checkbox" inputProps={{ 'id': 'checkbox-input', 'data-input': 'checkbox' }} required)
Slider(label="Slider" name="slider" title="wrapper" data-kind="slider" inputProps={{ 'id': 'slider-input', 'data-input': 'slider' }} value={5})
ColorInput(label="Colour" name="colour" title="wrapper" data-kind="colour" inputProps={{ 'id': 'colour-input', 'data-input': 'colour' }})
Combobox(label="Combobox" name="combobox" options={[{ value: 'a', label: 'A' }]} title="wrapper" data-kind="combobox" inputProps={{ 'id': 'combobox-input', 'data-input': 'combobox' }})
DateInput(aria-label="Date" name="date" title="wrapper" data-kind="date" inputProps={{ 'id': 'date-input', 'data-input': 'date' }})
