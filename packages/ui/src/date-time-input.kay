---
import type { FieldSize } from './field-look'
import type { JSX } from 'kay'
import { effect, onMount, postedValue, recipe, signal, untrack } from 'kay'
import { localDateTime, sameInstant, zonedInstant } from './date'
import { fieldRef } from './form-reset'
import TextInput from './text-input.kay'

const look = recipe({ parts: { root: 'kui-date-time-input inline-flex min-w-0 items-center', input: 'min-w-0 flex-1 tabular-nums' } })

const { value, min, max, name, form, disabled, onChange, ...rest } = props<Omit<JSX.IntrinsicElements['input'], 'value' | 'type' | 'name' | 'form' | 'disabled' | 'class' | 'children' | 'min' | 'max' | 'onInput' | 'onChange'> & {
  // The box's size: `md` by default, `sm` and `lg` change its padding and type.
  size?: FieldSize | undefined
  // Marks the control as refused, in the danger colour with `aria-invalid`. A FormField marks its control on its own while it shows a message.
  invalid?: boolean | undefined
  // The instant as ISO text, with its offset or `Z` (`2026-10-21T07:30:00Z`), or `''` for none. Without it, the box starts empty and keeps what is typed, for a form posting it by its `name`.
  value?: string | undefined
  // The earliest and latest instant allowed, as ISO text or a `Date`; the box takes and shows them on the visitor's clock.
  min?: string | Date | undefined
  max?: string | Date | undefined
  // Posted as the instant with the visitor's offset (`2026-10-21T09:30:00+02:00`), which `s.Date()` reads right, or `''` for none.
  name?: string | undefined
  form?: string | undefined
  disabled?: boolean | undefined
  // Called with the new instant in that form, or `''` once emptied, however it was set: typed or reset by a form.
  onChange?: ((value: string) => unknown) | undefined
}>()

// The visitor's zone is only known once the island runs, so the server renders the empty box carrying the name, and the hidden field posting the instant takes the name over.
const zoned = signal(false)
// A box with no callback is plain: a refused post of its form, which the server renders it for, gives its text back in place of its own.
const sent = onChange ? undefined : postedValue(name, value)
const start = untrack(() => value ?? (sent ? zonedInstant(sent) : ''))
const current = signal(start)
let box: HTMLInputElement | undefined

onMount(() => zoned = true)

effect(() => {
  if (value !== undefined)
    current = value
})

// The value a reset goes back to, on the visitor's clock.
effect(() => {
  if (zoned() && box)
    box.defaultValue = localDateTime(start)
})

const ref = fieldRef<HTMLInputElement>(element => box = element, rest.ref)

function heard(text: string) {
  const next = zonedInstant(text)

  if (sameInstant(next, current()))
    return

  current = next
  onChange?.(next)
}

// A controlled box shows what its parent holds once the zone is known.
const shown = () => zoned() && value !== undefined ? localDateTime(current()) : sent
const bound = (limit: string | Date | undefined) => zoned() ? localDateTime(limit) || undefined : undefined
---
div(part="root")
  TextInput({...rest} part="input" type="datetime-local" ref={ref} name={zoned() ? undefined : name} form={form} disabled={disabled} min={bound(min)} max={bound(max)} value={shown()} onInput={heard} onChange={heard})
  if zoned() && name
    input(type="hidden" name={name} form={form} disabled={disabled} value={zonedInstant(current())})
