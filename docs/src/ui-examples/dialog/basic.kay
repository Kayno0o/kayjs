---
import Button from '@kaynooo/kayjs-ui/button.kay'
import Dialog from '@kaynooo/kayjs-ui/dialog.kay'

const editing = signal(false)
---
Button(label="Rename" onClick={() => editing.set(true)})
Dialog(open={editing()} title="Rename" onOpenChange={() => editing.set(false)})
  @footer
    Button(label="Cancel" onClick={() => editing.set(false)})
    Button(label="Rename" tone="accent" onClick={() => editing.set(false)})
  input.kui-field-input(name="name" aria-label="Name")
