---
import Toaster from '@kaynooo/kayjs-ui/toaster.kay'
import { toast } from '@kaynooo/kayjs-ui'
---
h1 Toast block
button#saved(type="button" onClick={() => toast.success('Saved')}) Save
Toaster
  @toast(item, dismiss)
    b#custom {item.message}
    button#custom-close(type="button" onClick={dismiss}) Close
