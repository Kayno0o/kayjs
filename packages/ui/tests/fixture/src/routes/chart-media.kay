---
// kay-island
import '../app.css'
import ImageCropper from '@kaynooo/kayjs-ui/image-cropper.kay'
import LineChart from '@kaynooo/kayjs-ui/line-chart.kay'
import Masonry from '@kaynooo/kayjs-ui/masonry.kay'
import MediaGallery from '@kaynooo/kayjs-ui/media-gallery.kay'
import ScatterChart from '@kaynooo/kayjs-ui/scatter-chart.kay'
import ZoomPane from '@kaynooo/kayjs-ui/zoom-pane.kay'

const picture = (colour: string) => `data:image/svg+xml,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" width="800" height="500"><rect width="800" height="500" fill="${colour}"/></svg>`)}`
const items = [{ key: 1, kind: 'image' as const, thumb: picture('#6c8ef5'), preview: picture('#6c8ef5'), title: 'Blue' }, { key: 2, kind: 'image' as const, thumb: picture('#f58fb0'), preview: picture('#f58fb0'), title: 'Pink' }]
const tiles = [{ id: 1, height: 80 }, { id: 2, height: 120 }, { id: 3, height: 60 }, { id: 4, height: 100 }]
---
//- The browser-drawn chart and media parts, for the browser test to read their computed styles.
main
  #line
    LineChart(label="Visits" labels={['a', 'b', 'c', 'd', 'e']} onRange={() => undefined} series={[{ name: 'Visits', values: [3, 5, 2, 6, 4] }, { name: 'Sales', values: [1, 2, 1, 3, 2], color: 'red' }]})
  #scatter
    ScatterChart(label="Games" onSelect={() => undefined} points={[{ key: 1, label: 'Hades', x: 10, y: 90, weight: 4 }, { key: 2, label: 'Celeste', x: 30, y: 70 }]} x={{ label: 'Hours', domain: [0, 40] }} y={{ label: 'Score' }})
  #gallery(style="width: 480px")
    MediaGallery(items={items})
  #cropper(style="width: 400px")
    ImageCropper(src={picture('#6c8ef5')} ratio={1} grid alt="Blue")
  #zoom
    ZoomPane(label="Map" style="width: 300px; height: 200px")
      div(style="width: 100%; height: 100%; background: #6c8ef5")
  #masonry(style="width: 600px")
    Masonry(items={tiles} key={tile => tile.id} minWidth={180} gap={12})
      @tile(tile)
        div(style={`height: ${tile.height}px`})
