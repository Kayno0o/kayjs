---
import type { JSX } from 'kay'
import { postedChecked, recipe, uid } from 'kay'
import { controlledCheckbox } from './controlled-checkbox'
import { CHECKBOX, FIELD_MESSAGE, fieldInvalid, keepInvalid } from './field-look'
import { fieldIssueList, fieldNamed } from './forms'
import { without } from './props-without'

// The track reads the input before it, named so a toggle inside another peer is left alone.
const look = recipe({
  parts: {
    root: 'kui-toggle relative inline-flex cursor-pointer items-center gap-2 has-[input:disabled]:opacity-50 has-[input[aria-busy=true]]:cursor-progress has-[input:disabled:not([aria-busy=true])]:cursor-not-allowed',
    input: 'peer/toggle absolute size-0 opacity-0',
    track: 'relative inline-flex h-5 w-9 shrink-0 items-center rounded-md border-solid border-[length:var(--border-width)] border-input bg-surface transition-colors before:block before:size-3.5 before:translate-x-0.5 before:rounded-sm before:bg-muted before:transition-transform before:content-[""] peer-checked/toggle:border-accent peer-checked/toggle:bg-accent peer-checked/toggle:before:translate-x-4 peer-checked/toggle:before:bg-accent-foreground peer-focus-visible/toggle:outline-2 peer-focus-visible/toggle:outline-offset-2 peer-focus-visible/toggle:outline-accent peer-aria-invalid/toggle:border-danger peer-aria-invalid/toggle:peer-checked/toggle:border-danger peer-aria-invalid/toggle:peer-checked/toggle:bg-danger',
    label: 'text-sm text-foreground',
    hint: CHECKBOX.hint,
    field: 'inline-flex flex-col items-start gap-1',
    issues: FIELD_MESSAGE.issues,
    issue: FIELD_MESSAGE.issue,
  },
})

const given = props<Omit<JSX.IntrinsicElements['input'], 'type' | 'role' | 'checked' | 'class' | 'children' | 'onChange'> & {
  // Whether it starts on; a switch whose parent passes another value follows it. Inside a form posting to an action, a switch with no `onChange` takes the refused post's choice in its place.
  checked?: boolean | undefined
  // Shown next to the switch; omit it and pass `aria-label` instead to keep the switch label-only for screen readers.
  label?: string | undefined
  // A note after the label, quieter: a count, a shortcut, a code name.
  hint?: string | number | undefined
  // The field the switch posts as: inside a FormDialog, the message its call was refused with for that field shows under the switch, as a FormField shows it.
  name?: string | undefined
  // A message of the page's own, such as `add.error('terms')` after a plain form post, shown under the switch.
  issue?: string | undefined
  // Marks the switch as refused, in the danger colour with `aria-invalid`. A message shown for the switch marks it on its own.
  invalid?: boolean | undefined
  // Requires the switch be on to submit: the native `required`, which the browser's validation and a post with no JavaScript know.
  required?: boolean | undefined
  // A promise holds the switch busy until it settles, and puts it back where it was when it rejects (logged) or resolves to false: a refused change never shows as made.
  // Typed `unknown`, so a callback answering something else, such as `list.push`, still fits.
  onChange?: ((checked: boolean) => unknown) | undefined
}>()

// Read through `given`, never destructured, so each prop stays live; `name` is read once, as the field a control posts as.
const name = given.name
const rest = without(given, 'checked', 'label', 'hint', 'name', 'issue', 'invalid', 'onChange', 'class', ...look.variants)

const sent = given.onChange ? undefined : postedChecked(name, rest.value as string | number | undefined, given.checked ?? false)
// Whether the page passed `issue` or `invalid`, even as undefined for now, as `issue={add.error('terms')}` does.
const shown = name !== undefined || 'issue' in given
const checking = shown || 'invalid' in given
// A FormField naming the same field shows its messages itself.
const framed = checking ? fieldNamed.use() : undefined
const found = checking ? fieldIssueList(() => framed?.() === name ? undefined : name, () => given.issue) : () => []
const messages = () => found().map(item => item.message)
const marked = () => given.invalid === true || messages().length > 0
const issuesId = shown ? uid() : ''

const { on, busy, ref, change } = controlledCheckbox({ control: 'Toggle', checked: () => sent ?? given.checked ?? false, onChange: () => given.onChange, start: (element) => {
  if (checking)
    keepInvalid(element, marked)
}, appRef: rest.ref })
---
// A real checkbox, so it submits inside a form like any other. A click while a change is under way flips nothing.
snippet control()
  label(part="root")
    input({...rest} name={name} part="input" ref={ref} type="checkbox" role="switch" checked={on()} aria-invalid={fieldInvalid(marked) ?? rest['aria-invalid']} aria-describedby={[rest['aria-describedby'], messages().length > 0 ? issuesId : undefined].filter(id => id).join(' ') || undefined} aria-busy={busy() ? 'true' : undefined} onClick={event => { if (busy()) event.preventDefault() }} onChange={event => change(event.currentTarget)})
    span(part="track")
    if given.label
      span(part="label") {given.label}
    if given.hint !== undefined
      span(part="hint") {given.hint}
if shown
  div(part="field" data-kui-control="checkbox")
    {control()}
    span(part="issues" id={messages().length > 0 ? issuesId : undefined} aria-live="polite" data-field={name})
      for item, index of found() key={index}
        span(part="issue" data-form-issue={item.form ? '' : undefined}) {item.message}
else
  {control()}
