---
import { recipe } from 'kay'
import type { JSX } from 'kay'

// Indeterminate, a bar slides across the track, held still and part-filled under reduced motion.
const look = recipe({
  parts: {
    root: 'kui-progress h-2 w-full overflow-hidden bg-surface',
    fill: 'h-full bg-accent transition-[width] motion-reduce:transition-none data-indeterminate:w-2/5 data-indeterminate:animate-[kui-progress-slide_1.4s_ease-in-out_infinite] data-indeterminate:motion-reduce:animate-none',
  },
})

const { value, max = 100, label, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'children' | 'role'> & {
  // How far along the task is, from 0 to `max`; without it the bar is indeterminate.
  value?: number | undefined
  // The value of a finished task, 100 as Meter's percentage; pass `max={1}` for an upload's `progress()`.
  max?: number | undefined
  // Names the bar for screen readers.
  label: string
}>()

// A value that is not a number leaves the bar indeterminate.
const fraction = () => value === undefined || Number.isNaN(value) || !(max > 0) ? undefined : Math.min(1, Math.max(0, value / max))
---
div(part="root" {...rest} role="progressbar" aria-label={label} aria-valuemin={0} aria-valuemax={100} aria-valuenow={fraction() === undefined ? undefined : Math.round(fraction()! * 100)} data-indeterminate={fraction() === undefined ? '' : undefined})
  div(part="fill" style={fraction() === undefined ? undefined : `width: ${fraction()! * 100}%`} data-indeterminate={fraction() === undefined ? '' : undefined})
