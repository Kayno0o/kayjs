--- server
import { action, s } from 'kay'

export const contact = action({
  name: s.string({ min: 2, max: 100, error: 'Tell us your name' }),
  email: s.string({ format: 'email', max: 254, error: 'Not an email address' }),
  topic: s.enum(['quote', 'other']),
  message: s.string({ min: 5, max: 2000, error: 'A few words at least' }),
}, async ({ message }, ctx) => message === 'Please fail' ? ctx.deny(502, { data: 'Could not send it' }) : undefined, { protect: { honeypot: 'website', minTime: '3s' } })
---
---
import ContactForm from '@kayjs/ui/contact-form.kay'
import FormField from '@kayjs/ui/form-field.kay'
---
main
  ContactForm(action={contact} submitLabel="Send it")
    FormField(label="Topic" name="topic")
      select(name="topic")
        option(value="quote") Quote
        option(value="other") Other
