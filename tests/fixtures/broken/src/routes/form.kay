--- server
import { t } from 'elysia'
import { action } from 'kay'

export const rename = action(t.Object({ title: t.String({ maxLength: 200 }) }), async ({ title }) => title)

const failure = rename.failed()
---
form(action={rename})
  input(name="titel" aria-label="Title")
  p {failure?.errors.titel}
