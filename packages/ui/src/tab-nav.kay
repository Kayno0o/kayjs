---
import type { JSX } from 'kay'
import { onMount } from 'kay'

const { links, current, label, class: className, ...rest } = props<Omit<JSX.IntrinsicElements['nav'], 'class' | 'children'> & {
  links: readonly { href: string, label: string }[]
  // The `href` of the page on screen, which the link to it marks as current.
  current: string
  // Names the navigation for screen readers.
  label: string
  class?: string
}>()

let nav: HTMLElement | undefined

// A tab bar wider than a phone scrolls, so the current tab is centred in it rather than left off screen. Only the bar scrolls: `scrollIntoView` would also move the page to it.
onMount(() => {
  const link = nav?.querySelector('[aria-current="page"]')

  if (!nav || !link)
    return

  const bar = nav.getBoundingClientRect()
  const tab = link.getBoundingClientRect()

  nav.scrollLeft += tab.left - bar.left - (bar.width - tab.width) / 2
})
---
// Links rather than buttons: each tab is a page of its own, which a reload, a new tab or a shared url opens.
nav.kui-tab-nav({...rest} ref={element => nav = element} aria-label={label} class={className})
  for link of links key={link.href}
    a.kui-tab-nav-link(href={link.href} aria-current={link.href === current ? 'page' : undefined}) {link.label}
