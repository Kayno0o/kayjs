---
import type { JSX, Snippet, Source } from 'kay'
import type { IconProps } from 'kay/icons'
import type { IconSlot } from './defaults'
import { recipe } from 'kay'
import { wording } from 'kay/words'
import Button from './button.kay'
import Icon from './icon.kay'
import NoticeDismiss from './internal/notice-dismiss.kay'

const look = recipe({
  parts: {
    root: 'kui-notice [overflow-wrap:anywhere] rounded-lg border-solid px-4 py-3 text-sm [font-weight:var(--font-weight-normal)] [background-color:var(--_notice-ground,var(--color-surface-strong))] [border-color:var(--_notice-tone,var(--color-border-strong))] [border-width:var(--border-width)] [color:var(--_notice-tone,var(--color-foreground))] data-compact:border-0 data-compact:bg-transparent data-compact:p-0 not-[[hidden]]:data-framed:flex data-framed:items-start data-framed:gap-3',
    icon: 'mt-0.5 size-4 shrink-0',
    body: 'min-w-0 flex-1',
    actions: 'flex shrink-0 flex-wrap items-center gap-2',
    dismiss: '',
  },
  variants: {
    // A danger is an alert, read out at once; the other tones are a status, read once the reader is idle.
    tone: { neutral: '', accent: '[--_notice-tone:var(--color-accent)]', info: '[--_notice-tone:var(--color-info)]', success: '[--_notice-tone:var(--color-success)]', warning: '[--_notice-tone:var(--color-warning)]', danger: '[--_notice-ground:var(--color-background)] [--_notice-tone:var(--color-danger)]' },
  },
  defaults: { tone: 'neutral' },
})

// What `icon` set to `true` draws for each tone.
const TONE_ICON = { neutral: 'info', accent: 'info', info: 'info', success: 'success', warning: 'alert', danger: 'alert' } as const

const { source, tone = source === undefined ? 'neutral' : 'danger', label, size = 'md', icon, actions, dismissible = false, open, onDismiss, dismissLabel = wording('ui.notice.dismiss', 'Dismiss'), retryLabel = wording('ui.notice.retry', 'Try again'), ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'role'> & {
  // Any source an island reads (a `resource`, a `stream`, a `track()` handle, an `infiniteList`, a `local`): the notice shows while its `error()` is set, says the error's message unless `label` does, and offers a retry button that calls its `retry` and waits while it is `pending`. Its tone is `danger` unless `tone` says.
  source?: Pick<Source, 'error' | 'pending' | 'retry'> | undefined
  // Names the retry button of a `source`.
  retryLabel?: string | undefined
  label?: string | undefined
  // `sm` is a line of text without the box, such as under a form's fields.
  size?: 'sm' | 'md' | undefined
  // Drawn before the text: the icon of the tone for `true`, or an icon of your own. Without it a notice draws none.
  icon?: IconSlot | IconProps | boolean | undefined
  // At the end of the notice, such as a retry button or a link: a `@actions` block.
  actions?: Snippet
  // Adds a close button that hides the notice. Only a notice with this, or an `open`, ships script.
  dismissible?: boolean | undefined
  // Whether the notice is shown, when the page decides: set it back to `false` in `onDismiss` to keep it hidden. Giving it adds the close button as `dismissible` does.
  open?: boolean | undefined
  // Called when the close button is pressed, after the notice is hidden. Passing one makes the whole notice hydrate, as any function a static component passes an island.
  onDismiss?: (() => unknown) | undefined
  // Names the close button.
  dismissLabel?: string | undefined
}>()

const drawn = (): IconSlot | IconProps | undefined => icon === true ? TONE_ICON[tone] ?? TONE_ICON.neutral : icon || undefined
const closable = () => dismissible || open !== undefined
const framed = () => drawn() !== undefined || actions !== undefined || closable() || source !== undefined
const said = () => label ?? source?.error()?.message
const hiding = () => open === false || (source !== undefined && source.error() === undefined)
---
// A form's outcome or a refusal, in place: what a toast says in passing, said where the page stays.
div({...rest} role={tone === 'danger' ? 'alert' : 'status'} data-tone={tone} data-compact={size === 'sm' ? '' : undefined} data-framed={framed() ? '' : undefined} hidden={hiding() ? '' : rest.hidden})
  if drawn()
    Icon(icon={drawn()!} part="icon")
  if framed()
    div(part="body")
      | {said()}
      slot
  else
    | {said()}
    slot
  if actions || source
    div(part="actions")
      if source
        Button(label={retryLabel} size="sm" busy={source.pending()} disabled={source.pending()} onClick={() => source.retry()})
      | {actions}
  if closable()
    NoticeDismiss(part="dismiss" label={dismissLabel} open={open} onDismiss={onDismiss})
