---
import type { JSX, Snippet } from 'kay'
import type { PopoverPlacement, PopoverTriggerProps } from './popover'
import { effect, recipe, signal, uid } from 'kay'

// 'kui-popover' stays as the component's name for an app's CSS and the always-hidden guard.
const look = recipe({ parts: { anchor: '', root: 'kui-popover inset-auto mx-0 my-1 [position-try-fallbacks:flip-block,flip-inline] rounded-lg border-solid border-[length:var(--border-width)] border-border-strong bg-popover p-0 text-foreground data-[placement=bottom-start]:[position-area:block-end_span-inline-end] data-[placement=bottom-end]:[position-area:block-end_span-inline-start] data-[placement=top-start]:[position-area:block-start_span-inline-end] data-[placement=top-end]:[position-area:block-start_span-inline-start]' } })

const { id, open = false, placement = 'bottom-start', trigger, at, onOpenChange, style, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'id' | 'popover' | 'class' | 'children' | 'onToggle' | 'style'> & {
  // Written after the component's own declarations, so it wins.
  style?: string | undefined
  // The panel's id, unique on the page; one is drawn when none is given.
  id?: string | undefined
  // Shows the panel when the page sets it; the trigger, a click outside and Escape open and close it on their own.
  open?: boolean | undefined
  // Where the panel sits against its trigger, flipped by the browser when there is no room there.
  placement?: PopoverPlacement | undefined
  // Renders the button that toggles the panel, which spreads the attributes it is handed: `@trigger(attributes)`, then `button({...attributes})`.
  trigger?: Snippet<[attributes: PopoverTriggerProps]> | undefined
  // Opens the panel at this point of the window (`clientX` and `clientY`) instead of against a trigger, which then need not be given: a zero-size fixed anchor stands there, so `placement` and the browser's flip keep the panel inside the window. The page shows it with `open`.
  at?: { x: number, y: number } | undefined
  // Called with the new state whenever the panel shows or hides, however it did.
  onOpenChange?: ((open: boolean) => unknown) | undefined
}>()

const panelId = id ?? uid()
const anchor = `--_popover-${panelId}`
const shown = signal(open)
let panel: HTMLDivElement | undefined

// The browser's popover owns showing, light dismiss, Escape and giving focus back; this only follows `open` when the page sets it.
effect(() => {
  const wanted = open

  if (!panel)
    return

  const now = panel.matches(':popover-open')

  if (wanted && !now)
    panel.showPopover()
  else if (!wanted && now)
    panel.hidePopover()
})

// A getter, so the snippet's spread reads `shown` itself and updates `aria-expanded` in place instead of drawing the trigger again.
const triggerProps: PopoverTriggerProps = {
  'popovertarget': panelId,
  get 'aria-expanded'() {
    return shown() ? 'true' : 'false'
  },
  'style': `anchor-name: ${anchor}`,
}

function toggled(event: ToggleEvent) {
  const opened = event.newState === 'open'
  shown = opened
  onOpenChange?.(opened)
}
---
if at
  span(part="anchor" aria-hidden="true" style={`position: fixed; left: ${at.x}px; top: ${at.y}px; width: 0; height: 0; pointer-events: none; anchor-name: ${anchor}`})
else if trigger
  | {trigger(triggerProps)}
div(part="root" {...rest} ref={element => panel = element} id={panelId} popover="auto" data-placement={placement} style={[`position-anchor: ${anchor}`, style].filter(Boolean).join('; ')} onToggle={toggled})
  slot
