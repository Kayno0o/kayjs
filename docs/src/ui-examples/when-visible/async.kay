---
import WhenVisible from '@kaynooo/kayjs-ui/when-visible.kay'

const PAGE = 10
const rows = signal(Array.from({ length: PAGE }, (_, index) => index + 1))

async function more() {
  await new Promise(resolve => setTimeout(resolve, 600))
  rows.set(current => [...current, ...Array.from({ length: PAGE }, (_, index) => current.length + index + 1)])
}
---
.h-48.overflow-y-auto.rounded-lg.border.border-kui-overlay1.bg-kui-surface0
  for row of rows() key={row}
    p.px-3.py-1 Row {row}
  if rows().length < 50
    p.px-3.py-2.text-kui-subtext0 Loading more...
    WhenVisible(onVisible={more})
