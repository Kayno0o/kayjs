--- server
import { s, action } from 'kay'
import { invalidatePage } from 'kay/cache'
import { news } from '../news'

export const page = {
  prerender: true,
  cache: '1m',
}

export const publish = action({ edition: s.int({ min: 1, max: 1000 }) }, ({ edition }) => {
  news.edition = edition
  invalidatePage('/news')
})

if (news.failing)
  throw new Error('the news feed is down')

if (news.delay > 0)
  await Bun.sleep(news.delay)

const edition = news.edition
---
h1 Edition {edition}
