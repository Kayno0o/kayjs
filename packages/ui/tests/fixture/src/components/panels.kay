---
import { signal } from 'kay'
import SidePanel from '@kaynooo/kayjs-ui/side-panel.kay'
import SplitLayout from '@kaynooo/kayjs-ui/split-layout.kay'

// What the test reads back: how often the panel closed.
const { onClose, listWidthKey, onSettled } = props<{ onClose: () => void, listWidthKey?: string, onSettled?: (size: number) => void }>()

const open = signal(false)
const beside = signal(false)
const sidebarOpen = signal(true)
const detailOpen = signal(true)
const dockOpen = signal(true)
const dockEdge = signal<'right' | 'bottom'>('right')
const dockSize = signal<number | undefined>(undefined)
const lateEdge = signal<'right' | 'bottom' | undefined>(undefined)
---
button#open(onClick={() => open.set(true)}) Open
button#open-beside(onClick={() => beside.set(true)}) Open beside
button#open-sidebar(onClick={() => sidebarOpen.set(true)}) Sidebar
button#toggle-detail(onClick={() => detailOpen.set(!detailOpen())}) Detail
button#shut(onClick={() => open.set(false)}) Shut
SidePanel#panel(open={open()} title="Mars" onOpenChange={() => { open.set(false); onClose() }})
  @actions
    button#next Next
  @footer
    button#save Save
  p#body Fourth planet
SidePanel#beside(open={beside()} modal={false} closeHref="/list" title="Venus" onOpenChange={() => { beside.set(false); onClose() }})
  p#beside-body Second planet
SplitLayout#split(sidebarOpen={sidebarOpen()} onSidebarOpenChange={() => sidebarOpen.set(false)} sidebarTitle="Planets" resizableList listWidthKey={listWidthKey} detailOpen={detailOpen()})
  @sidebar
    nav Inner, outer
  @list
    ul#list
      li
        button#mars Mars
  @detail
    p#detail Mars
    button#edit Edit
SidePanel#docked(open={dockOpen()} modal={false} dock={dockEdge()} size={dockSize()} onSizeChange={(size, settled) => { dockSize.set(size); if (settled) onSettled?.(size) }} title="Jupiter" launcher="Open Jupiter" onOpenChange={shown => dockOpen.set(shown)})
  p#docked-body Fifth planet
button#open-docked(onClick={() => dockOpen.set(true)}) Open docked
button#dock-bottom(onClick={() => dockEdge.set('bottom')}) Dock bottom
SidePanel#late(open={true} modal={false} dock={lateEdge()} title="Saturn" onOpenChange={() => undefined})
  p Sixth planet
button#late-dock(onClick={() => lateEdge.set('bottom')}) Dock late
