---
import { onCleanup, onMount } from 'kay'

const SCROLLING = new Set(['auto', 'scroll', 'overlay'])

const { onVisible, margin = 600 } = props<{
  // Loads the next rows: called once the sentinel comes into view, and again whenever the list around it grows and leaves it there, so a list too short to scroll keeps filling. A call returning a promise is not repeated before it settles, and a rejection goes unhandled, so wrap the call in `attempt`.
  onVisible: () => unknown
  // How far outside the scroll box counts as in view already, in pixels, so the next rows land before the list runs out.
  margin?: number | undefined
}>()

let sentinel: HTMLElement | undefined

// The nearest ancestor set to scroll, which is what the sentinel has to come into view in, or the viewport.
function scrollBoxOf(el: HTMLElement): HTMLElement | null {
  for (let node = el.parentElement; node; node = node.parentElement) {
    if (SCROLLING.has(getComputedStyle(node).overflowY))
      return node
  }

  return null
}

onMount(() => {
  const el = sentinel!
  let visible = false
  let running = false
  // Set when the sentinel was reported in view while a call ran, so the call settling asks again rather than leaving a list that grew under it stalled.
  let missed = false

  async function run(): Promise<void> {
    if (!visible)
      return

    if (running) {
      missed = true

      return
    }

    running = true

    try {
      await onVisible()
    }
    finally {
      running = false

      if (missed) {
        missed = false
        void run()
      }
    }
  }

  const intersection = new IntersectionObserver((entries) => {
    visible = entries.at(-1)?.isIntersecting ?? false
    void run()
  }, { root: scrollBoxOf(el), rootMargin: `${margin}px` })

  // A list that grew under a sentinel still in view fires no new intersection, so observing it afresh reports where it stands now.
  function recheck() {
    intersection.unobserve(el)
    intersection.observe(el)
  }

  // Rows added inside a scroll box of fixed height leave its size alone, so new children count as growth as much as a parent growing does.
  const growth = new ResizeObserver(recheck)
  const added = new MutationObserver(recheck)

  intersection.observe(el)

  if (el.parentElement) {
    growth.observe(el.parentElement)
    added.observe(el.parentElement, { childList: true, subtree: true })
  }

  onCleanup(() => {
    intersection.disconnect()
    growth.disconnect()
    added.disconnect()
  })
})
---
// The infinite-scroll sentinel, rendered after a list only while there is more to load, so a list that stops growing is simply left alone.
.kui-when-visible(ref={element => sentinel = element} aria-hidden="true")
