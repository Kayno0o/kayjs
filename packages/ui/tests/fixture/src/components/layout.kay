---
import EmptyState from '@kaynooo/kayjs-ui/empty-state.kay'
import FileDrop from '@kaynooo/kayjs-ui/file-drop.kay'
import PageHeader from '@kaynooo/kayjs-ui/page-header.kay'
---
EmptyState#missing(title="Not found" level={1})
EmptyState#empty(title="No posts yet")
PageHeader#moons(title="Moons" description="Every moon of Jupiter, by distance.")
  @meta
    span 95
  @actions
    a(href="/") Home
  p Under the description.
PageHeader#bare(title="Planets")
FileDrop#slim(compact onFiles={() => undefined})
  @content(zone)
    button(type="button" onClick={zone.open}) Pick
FileDrop#zone(onFiles={() => undefined})
  @content(zone)
    button(type="button" onClick={zone.open}) Pick
