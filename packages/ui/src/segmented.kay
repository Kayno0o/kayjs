--- <Value extends string>
import type { JSX } from 'kay'
import { effect, signal, uid } from 'kay'

const { options, value, label, name, onChange, class: className, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'children' | 'role' | 'onChange'> & {
  options: readonly { value: Value, label: string }[]
  // The option picked to start with; a group whose parent passes another follows it.
  value: Value
  // Names the group for screen readers.
  label: string
  // The radios' name, which the group submits under inside a form; one unique on the page is drawn when none is given.
  name?: string
  onChange?: (value: Value) => void
  class?: string
}>()

// Held as a string: a signal cannot take a type parameter that might be a function.
const group = name ?? uid()
const picked = signal<string>(value)

effect(() => picked.set(value))

function pick(next: Value) {
  picked.set(next)
  onChange?.(next)
}
---
// Real radios, so the arrow keys move between options and the group submits like any other field.
.kui-segmented({...rest} role="radiogroup" aria-label={label} class={className})
  for option of options key={option.value}
    label.kui-segmented-option
      input.kui-segmented-input(type="radio" name={group} value={option.value} checked={picked() === option.value} onChange={() => pick(option.value)})
      span.kui-segmented-label {option.label}
