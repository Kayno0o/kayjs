---
import { recipe } from 'kay'
import type { JSX } from 'kay'

const look = recipe({ parts: { root: 'kui-meter h-2 w-full overflow-hidden bg-kui-surface0', fill: 'h-full transition-[width] motion-reduce:transition-none' } })

const { value, max = 100, label, fillClass, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'children' | 'role'> & {
  // How much is filled, held between 0 and `max`.
  value: number
  // The value of a full meter, 100 by default so `value` reads as a percentage.
  max?: number | undefined
  // Names the meter for screen readers.
  label: string
  // Classes for the fill alone, such as a colour picked by threshold; the track always looks like `kui-meter`.
  fillClass?: string | undefined
}>()

const percent = () => max > 0 ? Math.min(100, Math.max(0, value / max * 100)) : 0
---
div(part="root" {...rest} role="meter" aria-valuenow={percent()} aria-valuemin={0} aria-valuemax={100} aria-label={label})
  // The accent is the fill's own class beside `fillClass`, not the recipe's, so `fillClass` replaces it instead of meeting it after the base.
  div(part="fill" class={['bg-kui-accent', fillClass]} style={`width: ${percent()}%`})
