--- client
import FieldInput from '@kaynooo/kayjs-cms/field-input.kay'

// The editor's list field on drafts a test opens, mounted with `mountComponent`.
type Input = Parameters<typeof FieldInput>[0]

const { drafts, field } = props<Pick<Input, 'drafts' | 'field'>>()
---
FieldInput(drafts={drafts} entry={{ collection: 'posts', slug: 'hello' }} field={field} path="tags")
