---
import type { JSX, Snippet } from 'kay'
import { recipe } from 'kay'

// 'kui-card' stays as the component's name for an app's CSS and tests; theme.css still has its old rule until 1.74.
const look = recipe({
  parts: {
    root: 'kui-card flex flex-col rounded-kui-card border-(length:--kui-border-width) border-solid border-kui-surface2 bg-kui-surface0 [box-shadow:var(--kui-shadow-raised)]',
    head: 'flex items-center gap-3 border-b-(length:--kui-border-width) border-solid border-kui-surface2 px-3 py-2',
    // mr-auto rather than ml-auto on what follows: a head that is all control and no title reads from the left, like the body under it.
    title: 'mr-auto text-kui-2xs font-kui-label tracking-kui-section text-kui-subtext0 [font-family:var(--kui-label-font,var(--font-kui-body,inherit))] [text-transform:var(--kui-label-case)]',
    body: 'p-kui-card',
  },
})

const { title, level = 3, head, bare = false, ...rest } = props<Omit<JSX.IntrinsicElements['section'], 'class' | 'title'> & {
  // Engraved along the top, on a rule of its own.
  title?: string | undefined
  // The title's heading level, under the page's outline; `1` for a card that is the whole page, such as a sign-in panel.
  level?: 1 | 2 | 3 | 4 | 5 | 6 | undefined
  // The rest of the title's line, held at its far end: a count, a control, a link out.
  head?: Snippet
  // No inset body, for content that runs to the card's edge: a chart, a table, a console.
  bare?: boolean | undefined
}>()
---
// The frame a page's content is written on; every part of it is optional, so a card with no title is the frame alone.
section({...rest})
  if title !== undefined || head
    div(part="head")
      if title !== undefined
        if level === 1
          h1(part="title") {title}
        else if level === 2
          h2(part="title") {title}
        else if level === 3
          h3(part="title") {title}
        else if level === 4
          h4(part="title") {title}
        else if level === 5
          h5(part="title") {title}
        else
          h6(part="title") {title}
      | {head}
  if bare
    slot
  else
    div(part="body")
      slot
