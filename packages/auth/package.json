{
  "name": "@kaynooo/kayjs-auth",
  "type": "module",
  "version": "1.57.0",
  "description": "Auth for kay apps on kay sessions: OAuth, passwords, two-factor, magic links and bearer tokens",
  "author": "Kaynooo <https://github.com/Kayno0o>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kayno0o/kayjs",
    "directory": "packages/auth"
  },
  "bugs": {
    "url": "https://github.com/Kayno0o/kayjs/issues"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./browser": {
      "types": "./types/browser.d.ts",
      "default": "./src/browser.ts"
    },
    "./rules": {
      "types": "./types/rules.d.ts",
      "default": "./src/rules.ts"
    },
    "./pages/*.kay": "./src/pages/routes/*.kay",
    "./pg": {
      "types": "./types/pg.d.ts",
      "default": "./src/pg.ts"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "llms",
    "llms.txt",
    "src",
    "types"
  ],
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "check": "$npm_execpath check",
    "build:types": "rm -rf types && bun ../../src/tsgo.ts -p tsconfig.build.json",
    "prepack": "bun run build:types",
    "postpack": "rm -rf types",
    "prelint": "bun run --cwd ../.. build:eslint",
    "lint": "keslint --cache",
    "prelint:fix": "bun run --cwd ../.. build:eslint",
    "lint:fix": "keslint --fix --cache",
    "test": "bun test --timeout 20000"
  },
  "peerDependencies": {
    "@kaynooo/kayjs-ui": "workspace:~",
    "@kaynooo/pg-orm": "^7.0.0",
    "elysia": "^1.4.30",
    "kay": "~1.57.0"
  },
  "peerDependenciesMeta": {
    "@kaynooo/pg-orm": {
      "optional": true
    }
  },
  "dependencies": {
    "@kaynooo/utils": "^2.27.0",
    "@simplewebauthn/server": "^14.0.3",
    "jose": "^6.2.12",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@kaynooo/eslint": "^7.0.4",
    "@kaynooo/kayjs-mail": "workspace:~",
    "@kaynooo/kayjs-ui": "workspace:~",
    "@kaynooo/pg-orm": "^7.0.4",
    "@types/bun": "^1.4.3",
    "elysia": "^1.4.30",
    "typescript": "^6.0.3"
  }
}
