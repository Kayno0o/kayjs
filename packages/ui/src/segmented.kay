--- <Value extends string | number, Held extends Value | null = Value>
import type { JSX } from 'kay'
import type { IconProps } from 'kay/icons'
import type { IconSlot } from './defaults'
import { recipe, untrack } from 'kay'
import { controlledRadios } from './controlled-radios'
import Icon from './icon.kay'

// 'kui-segmented' stays as the component's name for an app's CSS and the skins; the border colour reads --_control-line, which a skin sets.
const look = recipe({
  parts: {
    root: 'kui-segmented group/segmented inline-flex border-solid border-[length:var(--kui-border-width,var(--border-width))] bg-surface [border-color:var(--_control-line,var(--color-border))] data-[orientation=vertical]:flex-col',
    option: 'relative cursor-pointer has-[input:disabled]:opacity-50 group-aria-busy/segmented:cursor-progress group-not-aria-busy/segmented:has-[input:disabled]:cursor-not-allowed',
    input: 'peer/option absolute size-0 opacity-0',
    label: 'flex items-center gap-1 px-3 py-1.5 text-xs text-muted transition-colors hover:text-foreground peer-checked/option:bg-accent peer-checked/option:text-accent-foreground peer-checked/option:hover:text-accent-foreground peer-focus-visible/option:outline-2 peer-focus-visible/option:-outline-offset-2 peer-focus-visible/option:outline-accent',
    icon: 'size-3.5 shrink-0',
  },
})

const { options, value, label, name, disabled = false, orientation = 'horizontal', onChange, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'children' | 'role' | 'onChange'> & {
  // `icon` sits before the label; `disabled` keeps that option from being picked.
  options: readonly { value: Value, label: string, icon?: IconSlot | IconProps | undefined, disabled?: boolean | undefined }[]
  // The option picked to start with, or `null` for none, such as while what shows matches no option; a group whose parent passes another follows it.
  value: Held
  // Names the group for screen readers.
  label: string
  // Disables every option; an option's own `disabled` still applies when this is false.
  disabled?: boolean | undefined
  // The radios' name, which the group submits under inside a form; one unique on the page is drawn when none is given.
  name?: string | undefined
  // `vertical` stacks the options in a column; the arrow keys keep moving between the radios, up and down as well as left and right.
  orientation?: 'horizontal' | 'vertical' | undefined
  // A promise holds the group busy until it settles, and puts the previous option back when it resolves to false, rejects or throws (logged): a refused change never shows as made.
  // Typed `unknown`, so a callback answering something else, such as `list.push`, still fits.
  // Hears `null` as well, for a reset to none, only when `value` is typed nullable.
  onChange?: ((value: null extends Held ? Value | null : Value) => unknown) | undefined
}>()

const { group, picked, busy, ref, pick } = controlledRadios({
  control: 'Segmented',
  input: '[data-part=input]',
  options: () => options,
  value: () => value,
  name: () => name,
  onChange: () => onChange as ((value: string | number | null) => unknown) | undefined,
  appRef: rest.ref,
})
---
// Real radios, so the arrow keys move between options and the group submits like any other field.
div(part="root" {...rest} ref={ref} role="radiogroup" aria-label={label} aria-orientation={orientation === 'vertical' ? 'vertical' : undefined} data-orientation={orientation === 'vertical' ? 'vertical' : undefined} aria-busy={busy() ? 'true' : undefined})
  for option of options key={option.value}
    label(part="option")
      input(part="input" ref={element => element.defaultChecked = untrack(() => option.value === value)} type="radio" name={group} value={option.value} checked={picked() === option.value} disabled={disabled || option.disabled} onChange={() => pick(option.value)})
      span(part="label")
        if option.icon
          Icon(icon={option.icon} part="icon")
        | {option.label}
