---
import type { JSX } from 'kay'
import { effect, signal, untrack } from 'kay'
import { changeAccepted } from './change'
import { onFormReset, resetWhenIdle, startRef } from './form-reset'

const { checked = false, label, onChange, class: className, ...rest } = props<Omit<JSX.IntrinsicElements['input'], 'type' | 'role' | 'checked' | 'class' | 'children' | 'onChange'> & {
  // Whether it starts on; a switch whose parent passes another value follows it.
  checked?: boolean | undefined
  // Shown next to the switch; omit it and pass `aria-label` instead to keep the switch label-only for screen readers.
  label?: string | undefined
  // A promise holds the switch busy until it settles, and puts it back where it was when it rejects (logged) or resolves to false: a refused change never shows as made.
  // Typed `unknown`, so a callback answering something else, such as `list.push`, still fits.
  onChange?: ((checked: boolean) => unknown) | undefined
  class?: string | undefined
}>()

const on = signal(checked)
const busy = signal(false)
let box: HTMLInputElement | undefined
// How often the parent's `checked` reached the switch, so a change under way knows whether the parent answered it.
let synced = 0

effect(() => {
  on.set(checked)
  synced++
})

// The switch starts once: its default is what it was first drawn with, not what the parent holds now.
const ref = startRef<HTMLInputElement>(rest.ref, (element) => {
  box = element
  element.defaultChecked = untrack(() => checked)
})

// A reset puts the switch back on its default, which the app's `onChange` then hears of; one meeting a change under way waits for it.
const resetting = resetWhenIdle(busy, () => {
  if (!box)
    return

  box.checked = box.defaultChecked

  if (box.checked !== on())
    void change(box)
})

onFormReset(() => box, resetting.reset)

async function change(input: HTMLInputElement) {
  const next = input.checked
  const before = on()
  const syncedBefore = synced

  on.set(next)

  // Put back unless the parent set `checked` meanwhile, which has the last word.
  // The box itself too, since a change refused at once never renders `on` as flipped for the binding to undo.
  if (!(await changeAccepted('Toggle', () => onChange?.(next), busy.set)) && synced === syncedBefore) {
    on.set(before)
    input.checked = before
  }

  resetting.idle()
}
---
// A real checkbox, so it submits inside a form like any other. A click while a change is under way flips nothing.
label.kui-toggle(class={className})
  input.kui-toggle-input({...rest} ref={ref} type="checkbox" role="switch" checked={on()} aria-busy={busy() ? 'true' : undefined} onClick={event => { if (busy()) event.preventDefault() }} onChange={event => change(event.currentTarget)})
  span.kui-toggle-track
  if label
    span.kui-toggle-label {label}
