---
import ChipGroup from '@kaynooo/kayjs-ui/chip-group.kay'

const days = signal([1, 3])
const options = [{ value: 0, label: 'Sun' }, { value: 1, label: 'Mon' }, { value: 2, label: 'Tue' }, { value: 3, label: 'Wed' }, { value: 4, label: 'Thu' }, { value: 5, label: 'Fri' }, { value: 6, label: 'Sat' }] as const
---
.flex.flex-col.items-start.gap-2
  ChipGroup(label="Days" options={options} value={days()} onChange={days.set})
  p Days picked: {days().join(', ') || 'none'}.
