---
import Button from '@kaynooo/kayjs-ui/button.kay'
import FileDrop from '@kaynooo/kayjs-ui/file-drop.kay'

const name = signal('')
---
FileDrop(
  accept="image/*"
  size="sm"
  onFiles={files => name.set(files[0]!.name)}
)
  @content(zone)
    Button(label="Choose a favicon" onClick={zone.open})
    span.text-muted {name() || 'or drop it here'}
