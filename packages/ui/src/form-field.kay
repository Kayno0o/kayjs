---
import type { Snippet } from 'kay'
import { recipe } from 'kay'
import { FIELD_MESSAGE } from './field-look'
import { fieldLinks, formIssues } from './forms'

// One wrapping row, the label taking no box of its own: the head and the action share the first line, the action wrapping under the head rather than over the control, and the rest take a line each.
// A floated legend is no longer the fieldset's rendered legend, so it sits in the row like the label's head, its padding zeroed so an app's own `legend` styles do not indent it.
// ':where(&)>*' keeps the full-line basis at no weight, so the head and the action's own basis win. 'kui-label-text' is the label type Table shares.
const look = recipe({
  parts: {
    root: 'kui-form-field flex w-full flex-wrap items-center gap-1 [:where(&)>*]:basis-full',
    label: 'contents [:where(&)>*]:basis-full',
    head: 'float-left order-first flex flex-1 basis-auto flex-wrap items-center gap-2 p-0',
    text: 'kui-label-text text-xs [font-weight:var(--font-weight-normal)] tracking-label text-muted [font-family:var(--font-label,inherit)] [text-transform:var(--label-case)]',
    required: 'ml-0.5 text-danger',
    action: 'order-first ml-auto flex basis-auto flex-wrap items-center justify-end gap-1.5',
    hint: FIELD_MESSAGE.hint,
    issues: FIELD_MESSAGE.issues,
    issue: FIELD_MESSAGE.issue,
  },
  variants: {
    // `sm` is sized by its control rather than the row, for a filter bar of fields side by side; it holds no message unless given a `name` or an `issue`.
    size: { sm: 'w-auto', md: '' },
  },
})

const { label, name, issue, hint, required = false, group = false, size = 'md', action } = props<{
  label: string
  // The field the control posts as: inside a FormDialog, the message its call was refused with for that field shows here.
  name?: string | undefined
  // A message of the page's own, such as `add.failed()?.errors.title` after a plain form post.
  issue?: string | undefined
  // What the control takes or what it does, under it and above any message.
  hint?: string | undefined
  required?: boolean | undefined
  // A control made of several inputs, such as a picker, is a labelled group rather than one label.
  group?: boolean | undefined
  // Sits on the label's line, pushed right: a preset button, a unit, a count.
  action?: Snippet
}>()

const small = () => size === 'sm'
const refused = formIssues.use()
const reports = () => !small() || name !== undefined || issue !== undefined
const messages = () => [name === undefined ? undefined : refused?.()[name], issue].filter(message => message !== undefined)
const links = fieldLinks(group, hint !== undefined && hint !== '', messages, required)
---
// The control, as children, takes the `kui-field-input` look with no class of its own.
// The hint and the messages sit outside the label, so the control is named by its label alone; the action too, since a button inside a label would take the label from the control.
if group
  fieldset.kui-form-field-group(part="root" data-kui-field={links.frame} aria-describedby={links.described().join(' ') || undefined} data-compact={small() ? '' : undefined})
    legend(part="head")
      span(part="text")
        | {label}
        if required
          span(part="required" aria-hidden="true") *
    slot
    if action
      span(part="action")
        | {action}
    if hint
      span(part="hint" id={links.hint}) {hint}
    if reports()
      span(part="issues" id={messages().length > 0 ? links.issues : undefined} aria-live="polite" data-field={name})
        for message, index of messages() key={index}
          span(part="issue") {message}
else
  div(part="root" data-kui-field={links.frame} data-compact={small() ? '' : undefined})
    label(part="label")
      span(part="head")
        span(part="text")
          | {label}
          if required
            span(part="required" aria-hidden="true") *
      slot
    if action
      span(part="action")
        | {action}
    if hint
      span(part="hint" id={links.hint}) {hint}
    if reports()
      span(part="issues" id={messages().length > 0 ? links.issues : undefined} aria-live="polite" data-field={name})
        for message, index of messages() key={index}
          span(part="issue") {message}
