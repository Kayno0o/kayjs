---
import type { ScreenCollection, StoredEntry } from '../kay/contract'
import type { HistoryRow } from '../screens'
import Badge from '@kaynooo/kayjs-ui/badge.kay'
import ConfirmDelete from '@kaynooo/kayjs-ui/confirm-delete.kay'
import EmptyState from '@kaynooo/kayjs-ui/empty-state.kay'
import { navigate, onMount, signal } from 'kay'
import { wording } from 'kay/words'
import { editedMoment, useEditorZone } from '../datetime'
import { restoreVersion } from '../editor/save'
import { shipWords } from '../editor/words'
import { entryPath } from '../listing'
import EntryEdited from './entry-edited.kay'

// The saved versions of an entry, newest first: who saved each and how, what it changed, and a button that saves it again. The entry's version is named by the restore, so a restore over a save made since is refused.
const { prefix, collection, entry, rows } = props<{ prefix: string, collection: ScreenCollection, entry: StoredEntry, rows: HistoryRow[] }>()

// Looks up what a restore says once the page has loaded, so the page sends it.
shipWords()

// kay-allow once-read-prop: the editor is made for one form, entry or collection
const ref = { collection: collection.name, slug: entry.slug, locale: entry.locale }

const verbs: Record<string, string> = {
  add: wording('cms.history.add', 'Created'),
  update: wording('cms.history.update', 'Saved'),
  publish: wording('cms.history.publish', 'Published'),
  unpublish: wording('cms.history.unpublish', 'Unpublished'),
  duplicate: wording('cms.history.duplicate', 'Duplicated'),
  restore: wording('cms.history.restore', 'Restored from an older version'),
  original: wording('cms.history.original', 'Before the first saved change'),
}

const zone = useEditorZone()
const lang = signal<string>()

onMount(() => lang = document.documentElement.lang)

// Names the version by its date, as the time beside it reads, so the buttons of the list are told apart.
function restoreName(row: HistoryRow): string {
  return row.savedAt === undefined ? wording('cms.history.restoreAria', 'Restore this version') : wording('cms.history.restoreDatedAria', 'Restore the version of {date}', { date: editedMoment(row.savedAt.getTime(), zone(), lang()) })
}

async function restore(row: HistoryRow): Promise<void> {
  if (await restoreVersion(ref, row.revision, entry.version))
    await navigate(entryPath(prefix, ref))
}
---
if rows.length === 0
  EmptyState(title={wording('cms.history.empty', 'No saved version yet')} description={wording('cms.history.emptyHint', 'Each save from now on is kept here, so an older version can be brought back.')})
else
  ol.kcms-history
    for row of rows key={row.revision}
      li.kcms-revision
        .kcms-revision-head
          if row.savedAt as savedAt
            EntryEdited(editedAt={savedAt} moment author={row.author})
          Badge(label={verbs[row.verb] ?? row.verb})
          if row.current
            Badge(tone="info" label={wording('cms.history.current', 'Current')})
          else
            ConfirmDelete(tone="neutral" triggerLook="button" label={wording('cms.history.restoreButton', 'Restore')} aria-label={restoreName(row)} message={wording('cms.history.restoreMessage', 'Restore this version? It is saved as a new version, and the current one stays in the history.')} failureLabel={wording('cms.history.restoreFailure', 'Could not restore')} onConfirm={async () => { await restore(row) }})
        if row.changes.length > 0
          dl.kcms-changes
            for change of row.changes key={change.key}
              dt {change.label}
              dd
                del {change.before}
                ins {change.after}
