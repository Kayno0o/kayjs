---
import type { Snippet } from 'kay'
import { recipe } from 'kay'
import { fieldLinks, formIssues } from './forms'

const look = recipe({ parts: { root: 'kui-form-field', head: 'kui-form-field-head', label: 'kui-form-field-label', text: 'kui-label-text', required: 'kui-form-field-required', action: 'kui-form-field-action', hint: 'kui-form-field-hint', issues: 'kui-form-field-issues', issue: 'kui-form-field-issue' } })

const { label, name, issue, hint, required = false, group = false, compact = false, action } = props<{
  label: string
  // The field the control posts as: inside a FormDialog, the message its call was refused with for that field shows here.
  name?: string | undefined
  // A message of the page's own, such as `add.failed()?.errors.title` after a plain form post.
  issue?: string | undefined
  // What the control takes or what it does, under it and above any message.
  hint?: string | undefined
  required?: boolean | undefined
  // A control made of several inputs, such as a picker, is a labelled group rather than one label.
  group?: boolean | undefined
  // Sized by its control rather than the row, for a filter bar of fields side by side; it holds no message unless given a `name` or an `issue`.
  compact?: boolean | undefined
  // Sits on the label's line, pushed right: a preset button, a unit, a count.
  action?: Snippet
}>()

const refused = formIssues.use()
const reports = () => !compact || name !== undefined || issue !== undefined
const messages = () => [name === undefined ? undefined : refused?.()[name], issue].filter(message => message !== undefined)
const links = fieldLinks(group, hint !== undefined && hint !== '', messages, required)
---
// The control, as children, takes the `kui-field-input` look with no class of its own.
// The hint and the messages sit outside the label, so the control is named by its label alone; the action too, since a button inside a label would take the label from the control.
if group
  fieldset.kui-form-field-group(part="root" data-kui-field={links.frame} aria-describedby={links.described().join(' ') || undefined} data-compact={compact ? '' : undefined})
    legend(part="head")
      span(part="text")
        | {label}
        if required
          span(part="required" aria-hidden="true") *
    slot
    if action
      span(part="action")
        | {action}
    if hint
      span(part="hint" id={links.hint}) {hint}
    if reports()
      span(part="issues" id={messages().length > 0 ? links.issues : undefined} aria-live="polite" data-field={name})
        for message, index of messages() key={index}
          span(part="issue") {message}
else
  div(part="root" data-kui-field={links.frame} data-compact={compact ? '' : undefined})
    label(part="label")
      span(part="head")
        span(part="text")
          | {label}
          if required
            span(part="required" aria-hidden="true") *
      slot
    if action
      span(part="action")
        | {action}
    if hint
      span(part="hint" id={links.hint}) {hint}
    if reports()
      span(part="issues" id={messages().length > 0 ? links.issues : undefined} aria-live="polite" data-field={name})
        for message, index of messages() key={index}
          span(part="issue") {message}
