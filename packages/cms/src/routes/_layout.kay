--- server
import Toaster from '@kaynooo/kayjs-ui/toaster.kay'
import TooltipHost from '@kaynooo/kayjs-ui/tooltip-host.kay'
import Button from '@kaynooo/kayjs-ui/button.kay'
import { localize } from 'kay/i18n'
import { wording } from 'kay/words'
import { denials, memberOf } from '../access'
import { screenPath } from '../paths'
import { signOut } from './_actions.kay'
import look from '../look'
import { adminLogo, settings } from '../settings'
import './admin.css'

const SCREENS_OF_CONTENT = /\/(?:collections|new)\//

// The screens are the CMS's own: none of the app's layouts above wraps them, so the editor sees no header, nav or footer of the site, and none of its pages is indexed.
export const page = { layouts: false, noindex: true }

const { prefix } = settings()
const logo = adminLogo(look.logo)
// kay marks a link current on its own page alone, so Content stays marked on the collection, entry and new-entry screens below it.
// Who is signed in, when the guard let the request in: the sign-in screen, which no guard covers, shows no one.
const member = await memberOf(ctx)
const denied = await denials(ctx)
const inContent = SCREENS_OF_CONTENT.test(ctx.url.pathname)
// The app's own pages and its toasts and tooltips are outside this chain, so the admin renders them itself.
---
.kcms-admin
  a.kcms-skip(href="#kcms-main") {wording('cms.admin.skip', 'Skip to the content')}
  header.kcms-admin-head
    a.kcms-admin-home(href={screenPath(prefix)})
      if logo
        // A logo giving no size takes the height CSS gives its box.
        // kay-allow unsized-image
        img.kcms-admin-logo(src={logo.src} alt={logo.alt} width={logo.width} height={logo.height})
      | {wording('cms.admin.brand', 'Content admin')}
    nav.kcms-admin-nav(aria-label={wording('cms.admin.navigation', 'Content admin')})
      a(href={screenPath(prefix)} aria-current={inContent ? 'true' : undefined}) {wording('cms.admin.content', 'Content')}
      if denied.redirects as reason
        // A disabled link, with the reason a keyboard reaches too.
        span.kcms-admin-refused(data-tooltip={reason} tabindex="0" aria-disabled="true") {wording('cms.missing.title', 'Missing pages')}
      else
        a(href={screenPath(prefix, '/not-found')}) {wording('cms.missing.title', 'Missing pages')}
      a(href={screenPath(prefix, '/media')}) {wording('cms.admin.media', 'Media')}
      a(href={screenPath(prefix, '/uploads')}) {wording('cms.admin.uploads', 'Unused uploads')}
    a.kcms-admin-site(href={localize('/')}) {wording('cms.admin.viewSite', 'View the site')}
    if member
      .kcms-admin-who
        span {wording('cms.admin.signedInAs', 'Signed in as {name}', { name: member.name })}
        form(action={signOut})
          Button(type="submit" variant="ghost" size="sm" label={wording('cms.admin.signOut', 'Sign out')})
  main.kcms-admin-main#kcms-main(tabindex="-1")
    slot
Toaster
TooltipHost
