---
import type { JSX } from 'kay'
import { recipe } from 'kay'

const look = recipe({ parts: { root: 'kui-icon-btn' } })

// IconButton without the icon lookup: what is nested inside draws the icon, so an island drawing its own svg ships none of the default icons Icon brings.
const { label, href, size = 'md', variant = 'solid', tone = 'neutral', type = 'button', ...rest } = props<Omit<JSX.IntrinsicElements['button'], 'type' | 'class' | 'children'> & {
  // Names the action for screen readers and, as its tooltip, for everyone else, since the button shows nothing but the icon.
  label: string
  size?: 'xs' | 'sm' | 'md' | 'lg' | undefined
  variant?: 'solid' | 'ghost' | 'inline' | undefined
  tone?: 'neutral' | 'accent' | 'danger' | undefined
  type?: 'button' | 'submit' | 'reset' | undefined
  // Renders a link with the same look, parts and tooltip instead of a button, for an action that is a navigation; `type` then has no meaning.
  href?: string | undefined
}>()

// What the link is given besides its own props, typed for a button: its `ref` would not fit an anchor to the type check.
const handedOn = rest as Record<string, never>

// Only the solid form is framed by the shell's hairline.
const framed = () => variant === 'solid'
---
if href !== undefined
  a(part="root" {...handedOn} href={href} aria-label={label} data-tooltip={label} data-size={size} data-variant={variant} data-tone={tone} class={{ 'kui-shell': framed(), 'kui-shell-danger': framed() && tone === 'danger' }})
    slot
else
  button(part="root" {...rest} type={type} aria-label={label} data-tooltip={label} data-size={size} data-variant={variant} data-tone={tone} class={{ 'kui-shell': framed(), 'kui-shell-danger': framed() && tone === 'danger' }})
    slot
