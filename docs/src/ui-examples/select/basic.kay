---
import { signal } from 'kay'
import Select from '@kayjs/ui/select.kay'

const KINDS = [
  { value: 'post', label: 'Post' },
  { value: 'page', label: 'Page' },
  { value: 'note', label: 'Note' },
]
const kind = signal('')
---
.flex.max-w-sm.flex-col.gap-2
  Select(
    value={kind()}
    options={KINDS}
    onChange={({ value }) => kind = value}
    emptyOption="Any kind"
    aria-label="Kind"
  )
  p.text-muted Kind: {kind() || 'any'}.
