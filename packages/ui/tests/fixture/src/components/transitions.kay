---
// kay-island
import Avatar from '@kaynooo/kayjs-ui/avatar.kay'
import CopyButton from '@kaynooo/kayjs-ui/copy-button.kay'
import SiteFavicon from '@kaynooo/kayjs-ui/site-favicon.kay'

const { calls, source = 'plain' } = props<{ calls: string[], source?: 'plain' | 'built' | 'fetched' | 'broken' | 'empty' }>()

const sources = {
  plain: 'plain',
  built: () => 'built',
  fetched: async () => 'fetched',
  broken: async () => { throw new Error('no link') },
  empty: async () => '',
}
---
Avatar#avatar(src="/ada.png" name="Ada" onLoad={() => calls.push('avatar load')} onError={({ event }) => calls.push(`avatar error ${event.type}`)})
Avatar#drawn(src="/ada.png" name="Ada")
  @fallback
    b.fallback ?
SiteFavicon#favicon(src="/favicon.png" name="Site" onLoad={() => calls.push('favicon load')} onError={({ event }) => calls.push(`favicon error ${event.type}`)})
SiteFavicon#globe(src="/favicon.png" name="Site")
  @fallback
    b.fallback ?
CopyButton#copy(text={sources[source]} label="Copy" onCopy={copied => calls.push(`copied ${copied}`)} onError={({ error }) => calls.push(`failed ${error instanceof Error}`)})
