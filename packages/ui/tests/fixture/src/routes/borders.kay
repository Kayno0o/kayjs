---
import type { Column } from '@kaynooo/kayjs-ui'
import Avatar from '@kaynooo/kayjs-ui/avatar.kay'
import Card from '@kaynooo/kayjs-ui/card.kay'
import CardRow from '@kaynooo/kayjs-ui/card-row.kay'
import ChipGroup from '@kaynooo/kayjs-ui/chip-group.kay'
import FileDrop from '@kaynooo/kayjs-ui/file-drop.kay'
import ImageCropper from '@kaynooo/kayjs-ui/image-cropper.kay'
import Notice from '@kaynooo/kayjs-ui/notice.kay'
import Pagination from '@kaynooo/kayjs-ui/pagination.kay'
import ScatterChart from '@kaynooo/kayjs-ui/scatter-chart.kay'
import Segmented from '@kaynooo/kayjs-ui/segmented.kay'
import SiteNav from '@kaynooo/kayjs-ui/site-nav.kay'
import Table from '@kaynooo/kayjs-ui/table.kay'
import Toggle from '@kaynooo/kayjs-ui/toggle.kay'
import Widget from '@kaynooo/kayjs-ui/widget.kay'
import '../app.css'

const columns: Column<{ id: number, name: string }>[] = [{ key: 'name', header: 'Name' }]
const sortable: Column<{ id: number, name: string }>[] = [{ key: 'name', header: 'Name', sortValue: true }]
const choices = [{ value: 'a', label: 'A' }, { value: 'b', label: 'B' }]
---
//- One of each box the keyline token sizes, the components drawn by their own recipe and the rest written with their class whole so its rules ship.
main
  Card#card(title="Card")
  CardRow#row
  Widget#widget(title="Widget")
  Notice#notice(label="Notice")
  Avatar#avatar(name="Ada")
  button#button.kui-btn(type="button") button
  div#table-wrap.kui-table-wrap table
  div#section.kui-collapsible-section(data-boxed) section
  div#save-bar.kui-save-bar bar
  Segmented#segmented(label="Choices" options={choices} value="a")
  FileDrop#file-drop(onFiles={() => undefined})
    @content(zone)
      | drop {zone.dragging()}
  ChipGroup#chips(label="Chips" options={choices} value={['a']})
  ul#icon-grid.kui-icon-grid
  Table#table(columns={columns} rows={[{ id: 1, name: 'Io' }]} rowKey="id" selectable filter={['name']})
  div#narrow-table(style="width: 15rem")
    Table(columns={sortable} rows={[{ id: 1, name: 'Io' }]} rowKey="id" narrow="stack")
  Toggle#toggle(label="Toggle")
  ScatterChart#scatter(label="Games" points={[{ key: 1, label: 'Hades', x: 10, y: 90 }]})
  ImageCropper#cropper(src="/photo.png")
  Pagination#pager(page={2} pages={3} url="/borders")
  SiteNav(id="recipe-list" links={[{ href: '/', label: 'Home' }]} current="/" label="Recipe")
