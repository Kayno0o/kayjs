---
import type { ToolCall } from './types'
import { recipe } from 'kay'

const look = recipe({ parts: { root: 'kai-chat-calls', summary: 'kai-chat-calls-summary', list: 'kai-chat-calls-list', call: 'kai-chat-call', name: 'kai-chat-call-name', status: 'kai-chat-call-status', title: 'kai-chat-call-title', code: 'kai-chat-call-code' } })

const { calls, pending = false, labels, details, runningLabel, doneLabel, failedLabel, argumentsLabel, resultLabel, approvalLabel } = props<{
  calls: ToolCall[]
  // Set in the turn being written, which is hidden from assistive technology: nothing in it takes focus.
  pending?: boolean
  // The phrase for a tool by its name, in the folded line.
  labels: Record<string, string>
  // Whether a call opens to its arguments and result.
  details: boolean
  runningLabel: string
  doneLabel: string
  failedLabel: string
  argumentsLabel: string
  resultLabel: string
  // Said of a call held for the visitor's yes, in place of failed.
  approvalLabel: string
}>()

const LABELS = { running: runningLabel, done: doneLabel, failed: failedLabel }

function status(call: ToolCall) {
  return call.approval === undefined ? LABELS[call.status] : approvalLabel
}

// The calls in one line, each tool once with its count: `Searched the docs x2, read_page`, ended by the status of what is not done.
function summary() {
  const counts = new Map<string, number>()
  const labelled = new Map<string, string>()

  for (const call of calls) {
    counts.set(call.name, (counts.get(call.name) ?? 0) + 1)

    if (call.label !== undefined)
      labelled.set(call.name, call.label)
  }

  const line = [...counts].map(([name, count]) => `${labels[name] ?? labelled.get(name) ?? name}${count > 1 ? ` x${count}` : ''}`).join(', ')
  const failed = calls.some(call => call.status === 'failed' && call.approval === undefined)
  const held = calls.some(call => call.approval !== undefined)

  if (calls.some(call => call.status === 'running'))
    return `${line} (${LABELS.running})`

  if (failed)
    return `${line} (${LABELS.failed})`

  return held ? `${line} (${approvalLabel})` : line
}
---
details(part="root")
  summary(part="summary" tabindex={pending ? -1 : undefined}) {summary()}
  ul(part="list")
    for call of calls key={call.id}
      li(part="call" data-status={call.status} data-held={call.approval === undefined ? undefined : ''})
        if details
          details
            summary(tabindex={pending ? -1 : undefined})
              span(part="name") {call.name}
              |
              span(part="status") {status(call)}
            p(part="title") {argumentsLabel}
            pre(part="code") {JSON.stringify(call.input, null, 2)}
            if call.result !== undefined
              p(part="title") {resultLabel}
              pre(part="code") {call.result}
        else
          span(part="name") {call.name}
          |
          span(part="status") {status(call)}
