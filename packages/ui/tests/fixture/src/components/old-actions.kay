---
import AppHeader from '@kaynooo/kayjs-ui/app-header.kay'
import Card from '@kaynooo/kayjs-ui/card.kay'
import ConfirmDelete from '@kaynooo/kayjs-ui/confirm-delete.kay'
import FormField from '@kaynooo/kayjs-ui/form-field.kay'
import MarkdownEditor from '@kaynooo/kayjs-ui/markdown-editor.kay'
import TreeView from '@kaynooo/kayjs-ui/tree-view.kay'

// The block and prop names before 1.90, which work until 1.93.
// kay-allow-file deprecated-ui-actions
---
Card#card(title="Moons")
  @head
    span.old Old head
AppHeader#header(links={[]} current="/" label="Main")
  @end
    span.old Old end
FormField#field(label="Name")
  @action
    span.old Old action
  input
TreeView#tree(nodes={[{ id: 'a', label: 'A' }]} label="Tree")
  @trailing(node)
    span.old Old {node.id}
MarkdownEditor#editor()
  @toolbarExtra(tools)
    span.old Old tool {tools.selection().text}
ConfirmDelete#confirm(message="Sure?" trigger="button" label="Remove" onConfirm={() => undefined})
