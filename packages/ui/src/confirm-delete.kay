--- <Data>
import type { JSX, Snippet } from 'kay'
import { effect, recipe, signal } from 'kay'
import Button from './button.kay'
import Dialog from './dialog.kay'
import IconButton from './icon-button.kay'
import { confirmWords } from './confirm'
import { attempt } from './toast'
import { wording } from 'kay/words'
import type { Size } from './size'
import type { Tone } from './tone'

// 'kui-confirm-delete-link' stays on the link trigger as its name for an app's CSS and the always-hidden guard.
const frame = recipe({
  parts: {
    root: '',
    armed: 'inline-flex items-center gap-1',
    message: 'text-muted',
    details: 'mt-2 text-sm',
  },
  variants: {
    // An icon by default; `button` is a labelled danger button, for a dialog footer, `link` a plain underlined text button, for a confirm inside running text, and `none` draws no trigger, for an app that opens it from elsewhere with `open`.
    triggerLook: { icon: '', button: '', link: 'cursor-pointer text-xs text-muted underline transition-colors hover:text-foreground disabled:cursor-default disabled:opacity-40', none: '' },
  },
})

const { message, details, onConfirm, open, onOpenChange, failureLabel, success, refused, tone = 'danger', triggerLook, ask = 'dialog', disabled = false, label, title, confirmLabel, pendingLabel, cancelLabel = wording('ui.confirmDelete.cancel', 'Cancel'), size, variant, ...rest } = props<Omit<JSX.IntrinsicElements['button'], 'type' | 'class' | 'children' | 'title' | 'onClick' | 'disabled' | 'hidden'> & {
  // The dialog's question; asked inline, the armed pair's name for screen readers and the confirm button's tooltip.
  message: string
  // Markup under the message in the dialog, such as a count, the names of what goes or a consequence; the message stays the name asked inline, where there is no room for it.
  details?: Snippet
  // Deletes, or does what a neutral confirm asks. The dialog stays open, its buttons disabled, until a returned promise settles, and closes once it resolves.
  onConfirm: () => unknown
  // Shows the dialog or the armed pair when the app sets it, such as from a Menu entry, a context menu or a shortcut; left out, the component keeps it itself. Given, `onOpenChange` is how the app learns of a cancel, a confirmed delete or Escape, to set it back to `false`.
  open?: boolean | undefined
  // Called with `true` when the trigger is pressed, for a message that is read then rather than at render, and with `false` once the dialog or the armed pair goes, as the `onOpenChange` of Dialog.
  onOpenChange?: ((open: boolean) => unknown) | undefined
  // Toasted when `onConfirm` throws, which leaves the dialog open, unless the call carries a message of its own: see `attempt`.
  failureLabel?: string | undefined

  // Toasted once `onConfirm` went through.
  success?: string | undefined
  // What a refusal of the action's handler says, from the data it passed to `ctx.fail`: toasted in place of `failureLabel`, which stays for an answer of undefined or another error.
  refused?: ((data: Data) => string | undefined) | undefined
  // `neutral` for a confirm that is not a deletion, such as a save with a consequence: accent buttons, a check icon, and every word taken from `label` unless given.
  tone?: Tone | undefined
  // Disables the trigger and the confirm button while the caller is busy; an open dialog stays open, its confirm button disabled until this is false again.
  disabled?: boolean | undefined
  // `inline` asks in place of the trigger instead of in a dialog: a click arms it into a danger button that deletes and one that cancels, for a row of a list.
  ask?: 'dialog' | 'inline' | undefined
  // What the trigger says, for a delete the reader knows by another name: "Empty trash", "Revoke link". `Delete` by default, `Confirm` when neutral.
  label?: string | undefined
  // The dialog's title, as a Dialog's, a string or a `@title` block: `Confirm Deletion` by default, the label when neutral.
  title?: string | Snippet | undefined
  // The confirm button's text, and the one it shows while `onConfirm` is pending: `Delete` and `Deleting…` by default, the label when neutral.
  confirmLabel?: string | undefined
  pendingLabel?: string | undefined
  cancelLabel?: string | undefined
  // The icon trigger's size and look, `size` sizing the cancel button too when asking inline; the button trigger takes the tone's look.
  size?: Size | undefined
  // The icon trigger's form, as an IconButton's, which then takes the tone as its own: danger-coloured by default, neutral for `tone="neutral"`. Without it the icon stays neutral.
  variant?: 'solid' | 'ghost' | 'inline' | undefined
}>()

const kind = () => triggerLook ?? 'icon'

const danger = () => tone === 'danger'
// The danger preset of `confirm()`: the words and the colours come from the same place.
const words = () => confirmWords(tone, { label, title, confirmLabel, pendingLabel })
const triggerLabel = () => words().trigger
const dialogTitle = () => words().title
const confirmText = () => words().confirm
const pendingText = () => words().pending
const look = () => words().look

const inner = signal(false)
const isOpen = () => open ?? inner()
const pending = signal(false)
// The trigger asking inline, hidden while armed, which takes the focus back once the pair goes; and the pair, which takes it back after a failed delete.
let opener: HTMLElement | undefined
let armed: HTMLElement | undefined

// Opened from elsewhere than the trigger, the focus goes back to what held it before.
effect(() => {
  if (isOpen() && typeof document !== 'undefined')
    opener ??= ask === 'inline' && document.activeElement instanceof HTMLElement ? document.activeElement : undefined
  else if (!isOpen())
    opener = undefined
})

function setOpen(next: boolean) {
  if (isOpen() === next)
    return

  if (open === undefined)
    inner = next

  onOpenChange?.(next)
}

function start(event: MouseEvent) {
  opener = event.currentTarget as HTMLElement
  setOpen(true)
}

function close() {
  setOpen(false)

  if (ask === 'inline') {
    const back = opener

    queueMicrotask(() => back?.focus())
  }

  opener = undefined
}

async function confirm() {
  pending = true

  const done = await attempt(async () => onConfirm(), { failure: failureLabel ?? wording('ui.confirmDelete.failure', 'Could not delete.'), success, refused })

  pending = false

  if (done)
    close()
  else if (ask === 'inline')
    queueMicrotask(() => armed?.querySelector('button')?.focus())
}

function keyDown(event: KeyboardEvent) {
  if (event.key === 'Escape' && !pending()) {
    event.preventDefault()
    close()
  }
}
---
if kind() === 'button'
  Button({...rest} label={triggerLabel()} tone={look()} disabled={disabled} hidden={ask === 'inline' && isOpen()} part="root" onClick={start})
else if kind() === 'link'
  button.kui-confirm-delete-link({...rest} part="root" type="button" disabled={disabled} hidden={ask === 'inline' && isOpen()} onClick={start}) {triggerLabel()}
else if kind() !== 'none'
  IconButton({...rest} icon={danger() ? 'delete' : 'success'} label={triggerLabel()} size={size} variant={variant} tone={variant === undefined ? undefined : tone} disabled={disabled} hidden={ask === 'inline' && isOpen()} part="root" onClick={start})
if ask === 'inline'
  if isOpen()
    // Armed by a click, so the focus moves onto the button that deletes.
    span(part="armed" ref={element => { armed = element; queueMicrotask(() => element.querySelector('button')?.focus()) }} role="group" aria-label={message} onKeyDown={keyDown})
      Button(label={pending() ? pendingText() : confirmText()} tone={look()} busy={pending()} disabled={pending() || disabled} data-tooltip={message} onClick={confirm})
      IconButton(icon="close" label={cancelLabel} size={size} variant="ghost" disabled={pending()} onClick={close})
else
  Dialog(open={isOpen()} title={dialogTitle()} dirty={pending()} onOpenChange={() => close()})
    @footer
      Button(label={cancelLabel} disabled={pending()} onClick={close})
      Button(label={pending() ? pendingText() : confirmText()} tone={look()} busy={pending()} disabled={pending() || disabled} onClick={confirm})
    p(part="message") {message}
    if details
      div(part="details")
        | {details}
