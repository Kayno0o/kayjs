---
import type { Row } from '../../../shared/data'
import { selection, signal } from 'kay'
import { rowBuilder } from '../../../shared/data'

const build = rowBuilder()
const rows = signal<Row[]>([])
const selected = selection<number>()

function swap() {
  rows.set((list) => {
    if (list.length < 999)
      return list

    const swapped = list.slice()

    swapped[1] = list[998]!
    swapped[998] = list[1]!

    return swapped
  })
}
---
div.jumbotron
  button#run(onClick={() => rows.set(build(1000))}) Create 1,000 rows
  button#runlots(onClick={() => rows.set(build(10000))}) Create 10,000 rows
  button#add(onClick={() => rows.set(list => [...list, ...build(1000)])}) Append 1,000 rows
  button#update(onClick={() => rows.set(list => list.map((row, i) => i % 10 === 0 ? { ...row, label: `${row.label} !!!` } : row))}) Update every 10th row
  button#clear(onClick={() => rows.set([])}) Clear
  button#swaprows(onClick={swap}) Swap rows
table.table
  tbody
    for row of rows() key={row.id}
      tr(class={selected.is(row.id) ? 'danger' : undefined})
        td.id {row.id}
        // The benchmark driver clicks an `a` in each row, as the other frameworks render it.
        // kay-allow link-as-button
        td.label: a(onClick={() => selected.set(row.id)}) {row.label}
        // kay-allow link-as-button
        td.remove: a(onClick={() => rows.set(list => list.filter(item => item.id !== row.id))}) x
