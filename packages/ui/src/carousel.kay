--- <Slide extends { src: string, alt: string, href?: string | undefined }>
import type { Duration, JSX, Snippet } from 'kay'
import { durationMs, effect, every, onCleanup, recipe, reducedMotion, signal, untrack } from 'kay'
import IconButton from './icon-button.kay'
import { startRef } from './form-reset'
import type { InfiniteList } from './infinite-list'
import LoadMore from './load-more.kay'
import { stepIndex } from './cycle'
import { wording } from 'kay/words'

const look = recipe({
  parts: {
    root: 'kui-carousel flex flex-col gap-3',
    viewport: 'relative w-full overflow-hidden bg-surface',
    // Every slide sits over the viewport, moved a width aside per place it stands from the one shown.
    slide: 'absolute inset-0 transition-transform duration-700 ease-in-out motion-reduce:transition-none',
    link: 'block size-full',
    image: 'size-full object-cover',
    controls: 'flex items-center justify-center gap-4',
    step: 'data-[side=next]:-rotate-90 data-[side=previous]:rotate-90',
    // Apart from the controls of the slides, as it stops the carousel rather than moving it.
    pause: 'ms-2',
    // The dot is drawn small, and pressed through a margin around it wide enough for a finger.
    dot: 'relative h-2 w-2 bg-input transition-all after:absolute after:-inset-2 after:content-[""] hover:bg-muted aria-[current=true]:w-6 aria-[current=true]:bg-accent',
  },
})

const { slides: given, slide, list, index = 0, onIndexChange, autoplay, ratio = '16 / 9', label = wording('ui.carousel.label', 'Carousel'), previousLabel = wording('ui.carousel.previous', 'Previous slide'), nextLabel = wording('ui.carousel.next', 'Next slide'), pauseLabel = wording('ui.carousel.pause', 'Pause'), playLabel = wording('ui.carousel.play', 'Play'), slideLabel = wording('ui.carousel.slide', 'Slide {n} of {count}'), dotLabel = wording('ui.carousel.dot', 'Go to slide {n}'), ...rest } = props<Omit<JSX.IntrinsicElements['section'], 'class' | 'children'> & {
  // The slides to draw. Left out when `list` holds them: one of the two is required.
  // A slide with an `href` makes the picture a link to that address, as a promo banner needs: middle-click and a new tab work, and an address off the site opens in one.
  slides?: readonly Slide[] | undefined
  // Draws each slide's content in place of its picture and link: `@slide(slide, index)`, given the slide as written and its place. `src` and `alt` stay the default, and the slide keeps its group, its label and the sliding.
  slide?: Snippet<[slide: Slide, index: number]> | undefined
  // Slides loaded page by page, from `infiniteList`: the next page loads when the reader reaches the last slides, and a failed page shows LoadMore's alert with its retry under the controls.
  list?: InfiniteList<Slide> | undefined
  // The slide shown first; a carousel whose parent passes another follows it.
  index?: number | undefined
  onIndexChange?: ((index: number) => unknown) | undefined
  // Moves to the next slide this often, `'5s'`, held while the pointer or the focus is on the carousel, stopped by its pause button, and never for a visitor asking for reduced motion.
  autoplay?: Duration | undefined
  // The slides' aspect ratio, as CSS writes it.
  ratio?: string | undefined
  // Names the carousel for screen readers.
  label?: string | undefined
  previousLabel?: string | undefined
  nextLabel?: string | undefined
  // The autoplay's button, while it runs and once paused.
  pauseLabel?: string | undefined
  playLabel?: string | undefined
  // `{n}` stands for the slide's number and `{count}` for how many there are.
  slideLabel?: string | undefined
  dotLabel?: string | undefined
} & ({ slides: readonly Slide[], list?: undefined } | { slides?: undefined, list: InfiniteList<Slide> })>()

const all = () => list ? list.rows() : given ?? []

const shown = signal(index)
// Whether the pointer or the focus is on the carousel, or the carousel scrolled out of view, which holds the autoplay, as `every` does for a hidden tab.
const pointed = signal(false)
const focused = signal(false)
const offscreen = signal(false)
const root = signal<HTMLElement>()
// The visitor's own pause, which nothing but the button lifts.
const paused = signal(false)

const ref = startRef<HTMLElement>(element => root = element, rest.ref)

effect(() => shown = index)

// The next page loads once the reader is on the last slides.
effect(() => {
  if (list && active() >= all().length - 2)
    void untrack(() => list.more())
})

effect(() => {
  const element = root()

  if (!autoplay || !element || typeof IntersectionObserver === 'undefined')
    return

  const observer = new IntersectionObserver(entries => offscreen = !entries.at(-1)!.isIntersecting)

  observer.observe(element)
  onCleanup(() => observer.disconnect())
})

// Checked at once, so a bare number throws even where the effect would return early, as on the server or under reduced motion.
if (autoplay !== undefined)
  durationMs(autoplay)

if (autoplay) {
  const still = reducedMotion()

  every(autoplay, () => step(1), { while: () => !paused() && !pointed() && !focused() && !offscreen() && !still() })
}

const active = () => stepIndex(shown(), 0, all().length)

function go(next: number) {
  shown = next
  onIndexChange?.(next)
}

function step(delta: number) {
  go(stepIndex(active(), delta, all().length))
}

function numbered(text: string, position: number) {
  return text.replaceAll('{n}', String(position + 1)).replaceAll('{count}', String(all().length))
}
---
section(part="root" {...rest} ref={ref} aria-roledescription="carousel" aria-label={label} onPointerEnter={() => pointed = true} onPointerLeave={() => pointed = false} onFocusIn={() => focused = true} onFocusOut={() => focused = false})
  div(part="viewport" style={`aspect-ratio: ${ratio}`} aria-live={autoplay ? 'off' : 'polite'})
    for entry, position of all() key={entry.src}
      div(part="slide" role="group" aria-roledescription="slide" aria-label={numbered(slideLabel, position)} aria-hidden={position === active() ? undefined : 'true'} inert={position !== active()} style={`transform: translateX(${(position - active()) * 100}%)`})
        if slide
          slot slide(entry, position)
        else if entry.href !== undefined
          a(part="link" href={entry.href})
            // kay-allow unsized-image
            img(part="image" src={entry.src} alt={entry.alt} loading={position === 0 ? 'eager' : 'lazy'})
        else
          // kay-allow unsized-image
          img(part="image" src={entry.src} alt={entry.alt} loading={position === 0 ? 'eager' : 'lazy'})
  if all().length > 1
    div(part="controls")
      IconButton(icon="chevron" label={previousLabel} variant="ghost" part="step" data-side="previous" onClick={() => step(-1)})
      for entry, position of all() key={entry.src}
        button(part="dot" type="button" aria-label={numbered(dotLabel, position)} aria-current={position === active() ? 'true' : undefined} onClick={() => go(position)})
      IconButton(icon="chevron" label={nextLabel} variant="ghost" part="step" data-side="next" onClick={() => step(1)})
      if autoplay
        IconButton(icon={paused() ? 'play' : 'pause'} label={paused() ? playLabel : pauseLabel} variant="ghost" part="pause" onClick={() => paused = !paused()})
  if list && list.failed()
    LoadMore(list={list})
