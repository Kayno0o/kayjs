---
import type { JSX } from 'kay'
import { formatDate, relativeTime } from 'kay/i18n'
import { recipe } from 'kay'

// 'kui-relative-time' stays as the component's name for an app's CSS.
const look = recipe({ parts: { root: 'kui-relative-time' } })

const { date, options, dateOptions = { dateStyle: 'long', timeStyle: 'short' }, focusable = true, ...rest } = props<Omit<JSX.IntrinsicElements['time'], 'class' | 'datetime' | 'tabindex' | 'children'> & {
  // The moment, as a `Date`, a timestamp in milliseconds or a string `new Date` reads.
  date: Date | number | string
  // How the relative text is worded, as `Intl.RelativeTimeFormat` takes them: `{ style: 'short' }` for `3 hr. ago`.
  options?: Intl.RelativeTimeFormatOptions | undefined
  // How the full date in the tooltip is written, as `Intl.DateTimeFormat` takes them; the time zone is the site's `timeZone`, else that of the machine formatting it, the server's, unless `timeZone` is set here.
  dateOptions?: Intl.DateTimeFormatOptions | undefined
  // `false` leaves the tab stop out, for a `RelativeTime` inside a link or a focusable row, whose own focus then shows the tooltip.
  focusable?: boolean | undefined
}>()

const moment = () => new Date(date)
const valid = () => !Number.isNaN(moment().getTime())
// `relativeTime` reads its options at each tick, so these stand for whatever `options` holds then, and a parent giving other ones is followed.
const current = new Proxy({}, {
  get: (_, key) => options?.[key as keyof Intl.RelativeTimeFormatOptions],
  ownKeys: () => Reflect.ownKeys(options ?? {}),
  getOwnPropertyDescriptor: (_, key) => options && key in options ? { value: options[key as keyof Intl.RelativeTimeFormatOptions], enumerable: true, configurable: true } : undefined,
})
const ago = relativeTime(moment, current)
---
// The text counts on from the page's render time on the server, so hydrating changes nothing, and keeps ticking in the browser.
if valid()
  time(part="root" {...rest} datetime={moment().toISOString()} tabindex={focusable ? '0' : undefined} data-tooltip={formatDate(moment(), dateOptions)}) {ago()}
