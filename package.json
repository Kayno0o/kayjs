{
  "name": "kay-v2-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "bun check && bun run check:size",
    "check:size": "bun scripts/size-check.ts",
    "test": "bun test packages/kay/tests",
    "bench": "bun bench-app/bench.ts",
    "bench:server": "bun bench-app/server-bench.ts",
    "bench:weight": "bun scripts/bundle-weight.ts",
    "verify": "bun check --no-script && bun run check:size && bun test packages/kay/tests && bun bench-app/build.ts"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@kayjs/kay": "link:./packages/kay",
    "@kaynooo/cli-kit": "^0.52.0",
    "@types/bun": "^1.4.4",
    "happy-dom": "^21.0.4",
    "mitata": "1.0.34",
    "playwright-core": "1.64.1",
    "typescript": "^6.0.3"
  }
}
