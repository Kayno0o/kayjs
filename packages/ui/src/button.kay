---
import type { JSX } from 'kay'
import { recipe } from 'kay'
import type { IconProps } from 'kay/icons'
import type { IconSlot } from './defaults'
import type { TagAttributes } from './button-props'
import BusyButton from './internal/busy-button.kay'
import { buttonOf, linkOf } from './button-props'
import Icon from './icon.kay'

// The layout and the label type are utilities; padding and size stay in theme.css, as a utility would beat its per-size rules; the shell (fill, hairline, hover, focus, press, disabled and the colours of a tone) stays in theme.css, which a skin restyles as one. 'kui-btn' and the tone classes are names for an app's CSS and for the skins.
const look = recipe({
  parts: {
    root: 'kui-btn inline-flex enabled:not-aria-busy:cursor-pointer items-center justify-center gap-[var(--spacing-kui-inline,calc(var(--spacing)*1.25*var(--density)))] rounded-md border-0 [font-weight:var(--font-weight-kui-label,var(--font-weight-normal))] [letter-spacing:var(--tracking-kui-action,var(--tracking-label))] whitespace-nowrap [font-family:var(--font-label,var(--font-kui-body,inherit))] [text-transform:var(--label-case)]',
    spinner: 'animate-spin motion-reduce:animate-none',
  },
  variants: {
    // The form: `solid` is the framed button, `ghost` has no frame until hovered and `inline` reads as a link.
    variant: { solid: '', ghost: '', inline: 'p-0 underline underline-offset-4' },
    // What the button means: `accent` for the main action, `success` for a confirming one, `danger` for a destructive one.
    tone: { neutral: '', accent: 'kui-btn-accent', success: 'kui-btn-success', danger: 'kui-btn-danger' },
    size: { xs: '', sm: '', md: '', lg: '' },
  },
  defaults: { variant: 'solid', tone: 'neutral', size: 'md' },
})

// The props the docs list besides the recipe's variants, which button-props.ts repeats for BusyButton.
interface Look {
  // Drawn before the label.
  icon?: IconSlot | IconProps | undefined
  // Spins in place of the icon while what the press started is under way.
  // Left out, a button with an `onClick` is busy and disabled by itself while the promise it returned is pending, and a submit button is busy while its form's `onSubmit` returns one; given, `busy` has the last word.
  busy?: boolean | undefined
  // Whether `busy` shows the spinner; `false` keeps the icon and label while the button still holds itself busy and, with an `onClick`, disabled.
  spinner?: boolean | undefined
  label?: string | undefined
}

type AsButton = Omit<JSX.IntrinsicElements['button'], 'type' | 'class'> & Look & {
  href?: undefined
  type?: 'button' | 'submit' | 'reset' | undefined
  // Whether the disclosure the button opens is showing, for a popover or a panel it toggles.
  expanded?: boolean | undefined
  // For a toggle button: whether it is on. Written as `aria-pressed`, and the button draws an accent keyline while it is.
  pressed?: boolean | undefined
}

// With an `href`, the button is a link looking like one, for an action that goes to another page.
type AsLink = Omit<JSX.IntrinsicElements['a'], 'class'> & Look & {
  href: string
}

// A button with an `onClick` goes through BusyButton, which holds itself busy on the promise it returns: the others stay static markup on a page.
const { variant = 'solid', tone, size = 'md', icon, busy, spinner = true, label, ...rest } = props<AsButton | AsLink>()

const attributes = rest as TagAttributes
// What the button was given besides its own props, handed on whole: an `onClick` named here would make this component an island itself.
const handedOn = rest as Record<string, never>
---
if rest.onClick
  BusyButton(part="root spinner" {...handedOn} variant={variant} tone={tone} size={size} icon={icon} busy={busy} spinner={spinner} label={label})
else if linkOf(attributes) as link
  a(part="root" {...link} data-variant={variant} data-size={size} data-spinner={spinner ? undefined : 'off'} aria-busy={busy ? 'true' : undefined})
    if busy && spinner
      Icon(icon="spinner" part="spinner")
    else if icon
      Icon(icon={icon})
    | {label}
    slot
else if buttonOf(attributes) as button
  button(part="root" {...button} data-variant={variant} data-size={size} data-spinner={spinner ? undefined : 'off'} aria-busy={busy ? 'true' : undefined})
    if busy && spinner
      Icon(icon="spinner" part="spinner")
    else if icon
      Icon(icon={icon})
    | {label}
    slot
