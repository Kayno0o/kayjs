{
  "name": "@kaynooo/kayjs",
  "type": "module",
  "version": "0.13.0",
  "description": "Pug-like, fully typed web framework on Bun, Elysia and pg-orm, with its own island runtime",
  "author": "Kaynooo <https://git.kaynooo.fr/kaynooo>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://git.kaynooo.fr/kaynooo/kayjs"
  },
  "bugs": {
    "url": "https://git.kaynooo.fr/kaynooo/kayjs/issues"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/",
    "access": "restricted"
  },
  "exports": {
    ".": {
      "types": "./types/runtime/index.d.ts",
      "default": "./src/runtime/index.ts"
    },
    "./island": {
      "types": "./types/runtime/island.server.d.ts",
      "browser": "./src/runtime/island.client.ts",
      "default": "./src/runtime/island.server.ts"
    },
    "./await": {
      "types": "./types/runtime/await.d.ts",
      "browser": "./src/runtime/await.ts",
      "default": "./src/runtime/await.server.ts"
    },
    "./html": {
      "types": "./types/runtime/html.d.ts",
      "default": "./src/runtime/html.ts"
    },
    "./icons": {
      "types": "./types/runtime/icons.d.ts",
      "default": "./src/runtime/icons.ts"
    },
    "./seo": {
      "types": "./types/runtime/seo.d.ts",
      "default": "./src/runtime/seo.ts"
    },
    "./content": {
      "types": "./types/content/index.d.ts",
      "default": "./src/content/index.ts"
    },
    "./i18n": {
      "types": "./types/runtime/i18n.server.d.ts",
      "browser": "./src/runtime/i18n.client.ts",
      "default": "./src/runtime/i18n.server.ts"
    },
    "./params": {
      "types": "./types/runtime/params.d.ts",
      "default": "./src/runtime/params.ts"
    },
    "./cache": {
      "types": "./types/runtime/cache.server.d.ts",
      "browser": "./src/runtime/cache.ts",
      "default": "./src/runtime/cache.server.ts"
    },
    "./image": {
      "types": "./types/runtime/image.public.d.ts",
      "default": "./src/runtime/image.public.ts"
    },
    "./jsx-runtime": {
      "types": "./types/runtime/jsx-runtime.d.ts",
      "default": "./src/runtime/jsx-runtime.ts"
    },
    "./dom": {
      "types": "./types/runtime/dom.d.ts",
      "default": "./src/runtime/dom.ts"
    },
    "./client": {
      "types": "./types/runtime/client.d.ts",
      "default": "./src/runtime/client.ts"
    },
    "./compiler": {
      "types": "./types/compiler/public.d.ts",
      "default": "./src/compiler/public.ts"
    },
    "./eslint": {
      "types": "./types/eslint/index.d.ts",
      "bun": "./src/eslint/index.ts",
      "default": "./dist/eslint.js"
    },
    "./server": {
      "types": "./types/server/index.d.ts",
      "default": "./src/server/index.ts"
    },
    "./internal": {
      "types": "./types/runtime/internal.d.ts",
      "default": "./src/runtime/internal.ts"
    },
    "./internal/server": {
      "types": "./types/server/internal.d.ts",
      "default": "./src/server/internal.ts"
    },
    "./test": {
      "types": "./types/test/index.d.ts",
      "default": "./src/test/index.ts"
    },
    "./test/preload": {
      "types": "./types/test/preload.d.ts",
      "default": "./src/test/preload.ts"
    }
  },
  "bin": {
    "kay": "./src/cli.ts"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "llms.txt",
    "src",
    "types"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "check": "tsgo --noEmit",
    "build:types": "rm -rf types && tsgo -p tsconfig.build.json",
    "build:eslint": "bun build src/eslint/index.ts --target node --packages external --outfile dist/eslint.js",
    "prepack": "bun run build:types && bun run build:eslint",
    "postpack": "rm -rf types dist",
    "lint": "keslint --cache",
    "lint:fix": "keslint --fix --cache",
    "test": "bun test",
    "bench": "bun bench/run.ts",
    "bench:origins": "bun bench/origins.ts",
    "bench:sites": "bun bench/sites/run.ts",
    "bench:test": "bun test ./bench",
    "bench:check": "bun src/cli.ts check bench/apps/kay && tsgo --noEmit -p bench/apps/solid && tsgo --noEmit -p bench/apps/svelte"
  },
  "peerDependencies": {
    "@types/bun": "^1.4.2"
  },
  "dependencies": {
    "@babel/parser": "^7.29.7",
    "@babel/traverse": "^7.29.7",
    "@babel/types": "^7.29.7",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "devalue": "^6.0.2",
    "elysia": "^1.4.30"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@iconify-json/tabler": "^1.2.41",
    "@kaynooo/eslint": "^6.0.1",
    "@types/babel__traverse": "^7.28.0",
    "@types/bun": "^1.4.2",
    "bun-plugin-tailwind": "^0.1.2",
    "kay": "link:.",
    "mitata": "1.0.34",
    "playwright-core": "1.62.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
