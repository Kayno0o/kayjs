# Signs form stamps and keys the chat's counts in data/ai.sqlite, so the file alone cannot be checked against a guessed address: at least 32 random characters, as `openssl rand -base64 32` prints.
KAY_SECRET=

# The chat on /ask, Mistral Small 4 pinned to a dated model. Without these the site serves and the chat says it is not available.
OPENAI_API_KEY=
AI_BASE_URL=https://api.mistral.ai/v1
AI_MODEL=mistral-small-2603
