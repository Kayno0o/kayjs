---
import { ActionError, signal } from 'kay'
import FormField from '@kaynooo/kayjs-ui/form-field.kay'
import SaveForm from '@kaynooo/kayjs-ui/save-form.kay'
import TextInput from '@kaynooo/kayjs-ui/text-input.kay'
import Toaster from '@kaynooo/kayjs-ui/toaster.kay'

// An editor whose state is signals and whose save takes an object: `save` stands in for the server and answers false for a refusal the editor shows itself, or the messages a schema refusal carries.
const { save, isNew = false, status, onDiscard } = props<{ save: (input: { name: string }) => Promise<boolean | { errors: Record<string, string> } | undefined>, isNew?: boolean, status?: string | undefined, onDiscard: () => void }>()

const name = signal('Ada')
const saved = signal('Ada')
const changed = () => isNew || name() !== saved()

async function onSave() {
  const accepted = await save({ name: name() })

  if (typeof accepted === 'object')
    throw new ActionError(422, '', accepted.errors)

  if (accepted !== false)
    saved.set(name())

  return accepted
}
---
SaveForm(dirty={changed()} onSave={onSave} saved="Saved." status={status} onDiscard={() => { name.set(saved()); onDiscard() }})
  button#edit(type="button" onClick={() => name.set('Grace')}) Edit
  FormField(label="Title" name="title")
    TextInput#title(name="title" value={name()} onInput={name.set})
  p#name {name()}
Toaster
