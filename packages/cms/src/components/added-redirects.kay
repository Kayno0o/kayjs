---
import type { Column } from '@kaynooo/kayjs-ui'
import type { AddedRedirect, RedirectStatus } from '../missing'
import Button from '@kaynooo/kayjs-ui/button.kay'
import ConfirmDelete from '@kaynooo/kayjs-ui/confirm-delete.kay'
import Table from '@kaynooo/kayjs-ui/table.kay'
import { refresh } from 'kay'
import { wording } from 'kay/words'
import { addMissingRedirect, removeAddedRedirects } from '../editor/save'
import { shipWords } from '../editor/words'
import AddRedirect from './add-redirect.kay'

// The redirects added from the missing pages screen: each can be edited, to another target, a 308 or a 410, and removed, which makes its path answer 404 again; several at once through the selection.
const { redirects } = props<{ redirects: AddedRedirect[] }>()

// Looks up what an edit or a removal says once the page has loaded, so the page sends it.
shipWords()

// A bulk removal is confirmed, so its failure is thrown to the confirm, which words it and stays open.
async function remove(froms: string[], throws = false): Promise<boolean> {
  const done = await removeAddedRedirects(froms, throws)

  if (done)
    await refresh()

  return done
}

async function save(from: string, to: string, status: RedirectStatus): Promise<void> {
  if (await addMissingRedirect(from, to, status))
    await refresh()
}

const columns: Column<AddedRedirect>[] = [
  { key: 'from', header: wording('cms.redirects.from', 'Path'), cell: true },
  { key: 'to', header: wording('cms.redirects.to', 'Redirects to'), cell: true },
  { key: 'status', header: wording('cms.redirects.status', 'Status') },
  { key: 'at', header: wording('cms.redirects.at', 'Added (UTC)') },
  { key: 'actions', header: wording('cms.table.actions', 'Actions'), align: 'end', cell: true },
]
---
Table.kcms-missing.kcms-redirects(columns={columns} rows={redirects} rowKey={row => row.from} selectable)
  @bulk(keys, clear)
    ConfirmDelete(message={wording('cms.redirects.removeMany', keys.length === 1 ? 'Remove 1 redirect? Its path answers 404 again.' : 'Remove {count} redirects? Their paths answer 404 again.', { count: keys.length })} label={wording('cms.redirects.removeSelected', 'Remove {count} selected', { count: keys.length })} failure={wording('cms.redirects.removeFailure', 'Could not remove the redirect')} size="sm" variant="ghost" onConfirm={async () => { if (await remove(keys.map(String), true)) clear() }})
  @cell(row, column)
    if column.key === 'actions'
      AddRedirect(path={row.from} editing to={row.to} status={row.status} onAdd={save})
      Button(label={wording('cms.redirects.remove', 'Remove')} aria-label={wording('cms.redirects.removeLabel', 'Remove the redirect from {path}', { path: row.from })} size="sm" variant="ghost" onClick={async () => { await remove([row.from]) }})
    else if column.key === 'to' && row.status === 410
      small {wording('cms.redirects.gone', 'Gone, no target')}
    else
      code.kcms-missing-path {column.key === 'from' ? row.from : row.to}
