--- server
import { formatDate, t } from 'kay/i18n'
import { schemas } from '../../forms'
import Button from '@kaynooo/kayjs-ui/button.kay'
import CardRow from '@kaynooo/kayjs-ui/card-row.kay'
import EmptyState from '@kaynooo/kayjs-ui/empty-state.kay'
import PageSection from '@kaynooo/kayjs-ui/page-section.kay'

export const revoke = action(schemas.oauthClient, async ({ id }, ctx) => {
  return await ctx.locals.auth.revokeOAuthClient(id) ? 'revoked' : ctx.fail(404, { error: 'not-found' })
})

const clients = await ctx.locals.auth.oauthClients()
const date = (value: Date) => formatDate(value, { dateStyle: 'medium' })
---
PageSection(title={t('auth.account.clients.title')})
  .flex.flex-col.gap-2
    p {t('auth.account.clients.intro')}
    for client of clients key={client.id}
      CardRow(data-client={client.id})
        @right
          form(action={revoke})
            input(type="hidden" name="id" value={client.id})
            Button(type="submit" variant="danger" label={t('auth.account.clients.revoke')} aria-label={`${t('auth.account.clients.revoke')}: ${client.name}`})
        .flex.flex-col
          strong {client.name}
          span.text-kui-muted {(client.scopes ?? [t('auth.account.clients.allScopes')]).join(', ')}
          span.text-kui-muted
            | {t('auth.account.clients.approved', { date: date(client.createdAt) })} · {client.lastUsedAt ? t('auth.account.clients.lastUsed', { date: date(client.lastUsedAt) }) : t('auth.account.clients.neverUsed')}
    else
      EmptyState(title={t('auth.account.clients.none')})
