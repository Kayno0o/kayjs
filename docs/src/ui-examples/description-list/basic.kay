---
import Badge from '@kayjs/ui/badge.kay'
import DescriptionList from '@kayjs/ui/description-list.kay'

const items = [
  { label: 'Host', value: 'relay.example.com' },
  { label: 'Requests', value: 1284 },
  { label: 'State' },
  { label: 'Backups' },
]
---
.max-w-md
  DescriptionList(items={items})
    @value(item)
      if item.label === 'State'
        Badge(label="Healthy" tone="success")
      else
        Badge(label="Paused" tone="warning")
