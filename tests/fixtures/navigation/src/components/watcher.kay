---
import { effect, navigate, navigation, onBeforeNavigate, onNavigate, signal } from 'kay'

const blocking = signal(false)
const log = (globalThis as { kayLog?: string[] }).kayLog ??= []

effect(() => {
  log.push(`state ${navigation.status()} ${navigation.pending()} ${navigation.to()?.pathname ?? '-'}`)
})
effect(() => {
  const error = navigation.error()

  if (error)
    log.push(`error ${error.status} ${error.message}`)
})
onBeforeNavigate(({ url, from }) => {
  log.push(`before ${from.pathname} ${url.pathname}`)

  return !blocking()
})
onNavigate(({ url }) => log.push(`navigate ${url.pathname}`))
---
p.state {navigation.status()}
button.block(onClick={() => blocking.set(true)}) Block
button.go(onClick={() => navigate('/watched-two')}) Go
