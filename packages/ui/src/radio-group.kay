--- <Value extends string | number | null, Held extends Value | null = Value>
import type { JSX, Snippet } from 'kay'
import { postedValue, recipe, uid, untrack } from 'kay'
import type { NullOption } from './null-option'
import { controlledRadios } from './controlled-radios'
import { LABEL_TEXT, RADIO_INVALID } from './field-look'
import { loadOptions } from './options-source'
import type { OptionsSource } from './options-source'
import { wording } from 'kay/words'
import { sentOption } from './refill'

// 'kui-radio-group' stays as the component's name for an app's CSS; the group is named so a choice reads its busy state.
const look = recipe({
  parts: {
    root: 'kui-radio-group group/radios flex flex-col gap-2',
    field: 'inline-flex flex-col items-start gap-1',
    heading: LABEL_TEXT,
    radio: 'flex flex-col',
    choice: 'inline-flex cursor-pointer items-center gap-2 self-start has-[input:disabled]:opacity-50 group-aria-busy/radios:cursor-progress group-not-aria-busy/radios:has-[input:disabled]:cursor-not-allowed',
    input: `m-0 size-4 shrink-0 cursor-[inherit] accent-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent ${RADIO_INVALID}`,
    label: 'text-sm text-foreground',
    description: 'pl-6 text-xs text-muted',
    status: 'm-0 text-xs text-muted',
    retry: 'cursor-pointer self-start text-xs text-accent underline',
  },
})

const { options, value, label, showLabel = false, name, invalid, required, disabled = false, loadingLabel = wording('ui.radioGroup.loading', 'Loading…'), retryLabel = wording('ui.radioGroup.retry', 'Try again'), failureLabel = wording('ui.radioGroup.failure', 'Could not load the options'), onLoad, onError, onChange, option: drawRow, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'children' | 'role' | 'onChange' | 'onLoad' | 'onError'> & {
  // `description` is a quieter line under the label, which screen readers hear after it; `disabled` keeps that option from being picked.
  // A list, a promise of one, or a function answering it, such as an action: asked in the browser, the group busy under `loadingLabel` until the answer lands, or under `failureLabel` once it rejected.
  options: OptionsSource<{ value: Value, label: string, description?: string | undefined, disabled?: boolean | undefined }> & NullOption<Value, Held>
  loadingLabel?: string | undefined
  retryLabel?: string | undefined
  failureLabel?: string | undefined
  // Called with each answer of a function or promise `options`, and with what it rejected with.
  onLoad?: ((options: readonly { value: Value, label: string, description?: string | undefined, disabled?: boolean | undefined }[], query: string) => unknown) | undefined
  onError?: ((failure: { error: unknown, query: string }) => unknown) | undefined
  // The option picked to start with, or `null` for none; a group whose parent passes another follows it. Left out, the first option that is not disabled when the group is drawn starts picked, which a form reset goes back to.
  value?: Held | undefined
  // Names the group for screen readers; omit it and pass `aria-label` or `aria-labelledby` instead, such as inside a FormField that names it.
  label?: string | undefined
  // Writes `label` above the options, in a Slider's label type, and names it by that text (`aria-labelledby`) in place of `aria-label`. Off by default.
  showLabel?: boolean | undefined
  // Disables every option; an option's own `disabled` still applies when this is false.
  disabled?: boolean | undefined
  // Marks the group as refused, its radios in the danger colour, with `aria-invalid` on the group. A FormField showing a message marks the radios on its own.
  invalid?: boolean | undefined
  // Requires one of the options be picked: `required` on the radios, which the browser's validation and a post with no JavaScript know, and `aria-required` on the group. A FormField with `required` around it does the same for its first radio.
  required?: boolean | undefined
  // The radios' name, which the group submits under inside a form, and which a FormField reads the field's message by; one unique on the page is drawn when none is given.
  name?: string | undefined
  // A promise holds the group busy until it settles, and puts the previous option back when it resolves to false, rejects or throws (logged): a refused change never shows as made.
  // Typed `unknown`, so a callback answering something else, such as `list.push`, still fits.
  // Hears `null` as well, for a reset to none, only when `value` is typed nullable.
  // Gets the option picked as a second argument, `undefined` for a reset to none with no null option.
  onChange?: ((value: Value | (null extends Held ? null : never), option: { value: Value, label: string, description?: string | undefined, disabled?: boolean | undefined } | undefined) => unknown) | undefined
  // Draws each option in place of its label (and icon): `@option(option)`. The input stays named by the option's `label`, and keeps its checked and disabled state. The description stays under it as the quiet line.
  option?: Snippet<[option: { value: Value, label: string, description?: string | undefined, disabled?: boolean | undefined }]> | undefined
}>()

// A group with no callback is plain: a refused post of its form, which the server renders it for, gives its choice back in place of its own.
const source = loadOptions<{ value: Value, label: string, description?: string | undefined, disabled?: boolean | undefined }>(() => options, { onLoad, onError, label: 'RadioGroup' })
const list = source.options
// The option a group without a `value` starts on: the first that is not disabled, once the options are there.
const first = () => list().find(option => !option.disabled)?.value ?? null
const sent = onChange ? undefined : postedValue(name, value === undefined ? first() : value)

const { group, picked, busy, ref, pick } = controlledRadios({
  control: 'RadioGroup',
  input: '[data-part=input]',
  options: list,
  value: () => sentOption(sent, list(), value === undefined ? first() : value),
  name: () => name,
  onChange: () => onChange as ((value: string | number | null, option: unknown) => unknown) | undefined,
  appRef: rest.ref,
})

const prefix = uid()
// The heading's id while `showLabel` writes it, which then names the control in place of `aria-label`.
const heading = showLabel && label ? uid() : undefined
---
// Real radios, so the arrow keys move between options and the group submits like any other field. The description sits beside the label, not inside it, so the option is named by its label alone.
snippet radios()
  div(part="root" {...rest} ref={ref} role="radiogroup" data-kui-choice="" aria-label={heading ? undefined : label} aria-labelledby={heading ?? rest['aria-labelledby']} aria-invalid={invalid ? 'true' : rest['aria-invalid']} aria-required={required ? 'true' : rest['aria-required']} aria-busy={busy() || source.loading() ? 'true' : undefined})
    for option, index of list() key={option.value}
      div(part="radio")
        label(part="choice")
          input(part="input" ref={element => element.defaultChecked = untrack(() => option.value === sentOption(sent, list(), value === undefined ? first() : value))} type="radio" name={group} required={required} value={option.value ?? ''} checked={picked() === option.value} disabled={disabled || option.disabled} aria-label={drawRow ? option.label : undefined} aria-describedby={option.description ? `${prefix}-${index}` : undefined} onChange={() => pick(option.value)})
          span(part="label")
            if drawRow
              | {drawRow(option)}
            else
              | {option.label}
        if option.description
          span(part="description" id={`${prefix}-${index}`}) {option.description}
    if source.loading()
      p(part="status" role="status") {loadingLabel}
    if source.failed()
      p(part="status" role="alert") {failureLabel}
      if source.retryable()
        button(part="retry" type="button" onClick={source.retry}) {retryLabel}
if heading
  div(part="field")
    span(part="heading" id={heading}) {label}
    {radios()}
else
  {radios()}
