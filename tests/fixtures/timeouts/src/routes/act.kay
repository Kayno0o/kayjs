--- server
import { action } from 'kay'
import { seen } from '../seen'

export const slow = action(async (ctx) => {
  seen.action = ctx.signal
  await Bun.sleep(600)

  return 'late'
})

export const patient = action({ timeout: false }, async () => {
  await Bun.sleep(250)

  return 'done'
})

export const strict = action({ timeout: '30ms' }, async () => {
  await Bun.sleep(400)

  return 'late'
})
---
p actions
