--- <Output>
import type { Action, Answer, FailureData, Success } from 'kay'
import { guardLeave, onCleanup, onMount, shortcut, signal } from 'kay'
import Button from './button.kay'
import { callAction, formIssues } from './forms'
import { holdDefaults, onFormReset } from './form-reset'
import { toast } from './toast'
import { wording } from 'kay/words'

const { action, refused, saved, onSaved, onDiscard, dirty, onSave, status, failure = wording('ui.saveForm.failure', 'Could not save.'), dirtyLabel = wording('ui.saveForm.dirtyLabel', 'Unsaved changes.'), cleanLabel = wording('ui.saveForm.cleanLabel', 'No unsaved change.'), savingLabel = wording('ui.saveForm.savingLabel', 'Saving…'), saveLabel = wording('ui.saveForm.saveLabel', 'Save'), discardLabel = wording('ui.saveForm.discardLabel', 'Discard'), shortcut: saveKeys = 'mod+s', class: className } = props<{
  // The page's action the form calls with its fields, as FormDialog does. An editor whose state is signals gives `dirty` and `onSave` instead.
  action?: Action<never, Output> | undefined
  // Toasted when the call fails other than on a field, or when `onSave` rejects.
  failure?: string | undefined
  // Whether the editor holds unsaved changes, when its state is the app's own signals rather than named fields: the bar, the leave guard and Save follow it instead of the fields, so `dirty={isNew || changed()}` lets a new item save with no change.
  dirty?: boolean | undefined
  // Called by Save, the shortcut included, instead of `action`: answer the call's promise. A rejection is handled as an action's refusal is (`refused`, the messages on their FormField, `failure`); `false` is a refusal the app shows itself, and either leaves the bar unsaved. `onSaved` is for `action` only. The app clears `dirty` once it has saved.
  onSave?: (() => Promise<unknown>) | undefined
  // Replaces the status line, whatever the form's state.
  status?: string | undefined
  // What a refusal of the action's handler says, as FormDialog's `refused`.
  refused?: ((data: FailureData<Output>) => Record<string, string> | string | undefined) | undefined
  // Toasted as a success once the action has run.
  saved?: string | undefined
  // What the action returned, for the page to patch into what it shows. The form is clean again once it has run.
  onSaved?: ((result: Answer<Success<Output>>) => void) | undefined
  // Called after Discard has put the controls back to their initial values, for state the page keeps beyond them: the library's controls and their `onChange` need nothing from it.
  onDiscard?: (() => void) | undefined
  // The bar's texts: unsaved changes, nothing to save, the save under way, and the two buttons.
  dirtyLabel?: string | undefined
  cleanLabel?: string | undefined
  savingLabel?: string | undefined
  saveLabel?: string | undefined
  discardLabel?: string | undefined
  // The keys that save, `mod+s` (Ctrl or Cmd with S) by default; `false` binds none. Written as kay's `shortcut` takes them.
  shortcut?: string | false | undefined
  class?: string | undefined
}>()

const issues = signal<Record<string, string>>({})
const changed = signal(false)
const saving = signal(false)
let form: HTMLFormElement | undefined
// What the controls held when they were last clean, as text.
let baseline = ''

formIssues.provide(issues)

function snapshot() {
  return JSON.stringify([...new FormData(form)].map(([name, value]) => [name, typeof value === 'string' ? value : [value.name, value.size, value.lastModified]]))
}

// What each control holds now, which becomes its default once saved, the library's signal-driven ones included: a Discard then goes back to the saved values, not to the ones first rendered.
function values(): () => void {
  const held = [...form!.elements].map((control): (() => void) => {
    // The search box of an IconPicker or a MultiSelect is no saved value: a reset empties it.
    if (control.hasAttribute('data-kui-search'))
      return () => undefined

    if (control instanceof HTMLInputElement || control instanceof HTMLTextAreaElement) {
      const { value } = control
      const checked = control instanceof HTMLInputElement && control.checked

      return () => {
        control.defaultValue = value

        if (control instanceof HTMLInputElement)
          control.defaultChecked = checked
      }
    }

    if (control instanceof HTMLSelectElement) {
      const picked = [...control.options].map(option => option.selected)

      return () => {
        for (const [index, option] of [...control.options].entries())
          option.toggleAttribute('selected', picked[index] ?? false)
      }
    }

    return () => undefined
  })

  const adoptSignals = holdDefaults(form!)

  return () => {
    for (const keep of held)
      keep()

    adoptSignals()
  }
}

const isDirty = () => dirty ?? changed()
const busy = () => saving() || action?.pending() === true

function check() {
  if (dirty === undefined)
    changed.set(snapshot() !== baseline)
}

let queued = false

// What an input, a change and a mutation of the same keystroke each ask for, read once after them: the snapshot serializes every control of the form.
function checkSoon() {
  if (queued)
    return

  queued = true
  queueMicrotask(() => {
    queued = false
    check()
  })
}

// A reset the bar did not start, from a reset button among the fields, leaves the form clean too, once the controls driven by signals have followed.
onFormReset(() => form, check, true)

// Leaving asks while there are unsaved changes, but not while a save is under way: it may be what takes the page elsewhere.
guardLeave(() => isDirty() && !busy())

// A control added or removed changes what the form holds without an input event.
onMount(() => {
  baseline = snapshot()

  const observer = new MutationObserver(checkSoon)

  observer.observe(form!, { childList: true, subtree: true, attributes: true, attributeFilter: ['value', 'checked', 'selected', 'disabled'] })
  onCleanup(() => observer.disconnect())
})

async function submit(event: SubmitEvent) {
  event.preventDefault()

  if (busy() || !form || !(dirty ?? snapshot() !== baseline))
    return

  if (!action && !onSave)
    return

  // Edits made while the save is under way stay unsaved.
  const sent = dirty === undefined ? snapshot() : ''
  const adopt = values()
  let done: Awaited<ReturnType<typeof callAction>>

  if (onSave) {
    saving.set(true)

    try {
      done = await callAction(form, onSave as unknown as Action<never, Output>, issues, failure, refused)
    }
    finally {
      saving.set(false)
    }

    // A refusal the app shows itself.
    if (done?.result === false)
      return
  }
  else {
    done = await callAction(form, action!, issues, failure, refused)
  }

  if (!done)
    return

  issues.set({})
  baseline = sent
  adopt()
  check()

  if (saved)
    toast.success(saved)

  if (!onSave)
    onSaved?.(done.result as Answer<Success<Output>>)
}

function discard() {
  if (busy())
    return

  form?.reset()
  issues.set({})
  onDiscard?.()
  check()
}

// Ctrl or Cmd with S saves unless `shortcut` says otherwise, the browser's own save dialog kept away even when there is nothing to save.
shortcut(() => saveKeys || null, () => form?.requestSubmit(), { on: () => form })
---
form.kui-save-form(class={className} ref={element => form = element} onSubmit={submit} onInput={checkSoon} onChange={checkSoon})
  .kui-form-grid
    slot
  .kui-save-bar
    // Announced as it changes, so a screen reader hears the changes pile up, the save start and the form come back clean.
    p.kui-save-bar-status(role="status" data-dirty={isDirty() || undefined}) {status ?? (busy() ? savingLabel : isDirty() ? dirtyLabel : cleanLabel)}
    .kui-save-bar-actions
      // `aria-disabled` rather than `disabled`, so the button pressed keeps the focus as the form turns clean.
      Button(label={discardLabel} aria-disabled={!isDirty() || busy() || undefined} onClick={discard})
      Button(label={saveLabel} type="submit" tone="accent" busy={busy()} aria-disabled={!isDirty() || busy() || undefined})
