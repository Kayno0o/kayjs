---
import type { Denials } from '../access'
import type { ScreenCollection } from '../kay/contract'
import type { EntryRow } from '../listing'
import Button from '@kayjs/ui/button.kay'
import ConfirmDelete from '@kayjs/ui/confirm-delete.kay'
import { toast } from '@kayjs/ui'
import { refresh, signal } from 'kay'
import { wording } from 'kay/words'
import Refused from './refused.kay'
import { bulk } from '../editor/bulk'
import { readReferrers } from '../editor/referrers'
import { bulkDeleteMessage } from '../bulk-message'
import type { BulkAction } from '../editor/bulk'

// The actions on the rows ticked in the list, each saved one after another and told in one toast.
// `denied`, from `denials`, disables the buttons for what the signed-in person's role may not do.
const { collection, rows, actions, clear, denied = {} } = props<{ denied?: Denials, collection: ScreenCollection, rows: EntryRow[], actions: ReadonlySet<string>, clear: () => void }>()

// A selection holding an entry that is another's cannot be published, unpublished or deleted by a role limited to its own entries: the server would refuse those rows one by one.
const blocked = (): Denials => rows.some(row => row.locked) ? { ...denied, publish: wording('cms.guard.notYours', 'Your role may only change the entries you wrote'), delete: wording('cms.guard.notYours', 'Your role may only change the entries you wrote') } : denied

// Only the rows an action fits: a draft is published and a published entry unpublished, as the row buttons offer, and a broken entry is neither.
const fitting = (action: BulkAction) => rows.filter(row => action === 'delete' || (row.problem === undefined && row.draft === (action === 'publish')))
const targets = (action: BulkAction) => fitting(action).map(row => ({ ref: { collection: collection.name, slug: row.slug, locale: row.locale }, version: row.version }))
const drafts = () => collection.draftField !== undefined

// What names the ticked rows, read when the delete confirmation opens.
const referrers = signal<string[]>([])

let asked = 0

async function askReferrers(): Promise<void> {
  const mine = ++asked

  referrers = []

  const found = await readReferrers(collection.name, rows.map(row => row.slug))

  // A later open took over while this one was on its way.
  if (mine === asked)
    referrers = [...new Set(Object.values(found).flat())]
}

async function run(action: BulkAction): Promise<void> {
  const { done, failed, reason } = await bulk(action, targets(action))

  if (done > 0) {
    if (action === 'publish')
      toast.success(wording('cms.bulk.published', done === 1 ? '1 entry published' : '{count} entries published', { count: done }))
    else if (action === 'unpublish')
      toast.success(wording('cms.bulk.unpublished', done === 1 ? '1 entry unpublished' : '{count} entries unpublished', { count: done }))
    else
      toast.success(wording('cms.bulk.deleted', done === 1 ? '1 entry deleted' : '{count} entries deleted', { count: done }))
  }

  if (failed > 0 && reason !== undefined)
    toast.error(wording('cms.bulk.failedWhy', failed === 1 ? '1 entry could not be changed: {reason}' : '{count} entries could not be changed, the first: {reason}', { count: failed, reason }))
  else if (failed > 0)
    toast.error(wording('cms.bulk.failed', failed === 1 ? '1 entry could not be changed' : '{count} entries could not be changed', { count: failed }))

  clear()
  await refresh()
}
---
if actions.has('publish') && drafts() && fitting('publish').length > 0
  if blocked().publish !== undefined
    Refused(label={wording('cms.entry.publish', 'Publish')} ariaLabel={wording('cms.bulk.publishAria', fitting('publish').length === 1 ? 'Publish 1 selected entry' : 'Publish {count} selected entries', { count: fitting('publish').length })} reason={blocked().publish})
  else
    Button(label={wording('cms.entry.publish', 'Publish')} aria-label={wording('cms.bulk.publishAria', fitting('publish').length === 1 ? 'Publish 1 selected entry' : 'Publish {count} selected entries', { count: fitting('publish').length })} onClick={() => run('publish')})
if actions.has('unpublish') && drafts() && fitting('unpublish').length > 0 && blocked().publish !== undefined
  Refused(label={wording('cms.entry.unpublish', 'Unpublish')} ariaLabel={wording('cms.bulk.unpublishAria', fitting('unpublish').length === 1 ? 'Unpublish 1 selected entry' : 'Unpublish {count} selected entries', { count: fitting('unpublish').length })} reason={blocked().publish})
else if actions.has('unpublish') && drafts() && fitting('unpublish').length > 0
  ConfirmDelete(tone="neutral" triggerLook="button" label={wording('cms.entry.unpublish', 'Unpublish')} aria-label={wording('cms.bulk.unpublishAria', fitting('unpublish').length === 1 ? 'Unpublish 1 selected entry' : 'Unpublish {count} selected entries', { count: fitting('unpublish').length })} message={wording('cms.bulk.unpublishMessage', fitting('unpublish').length === 1 ? 'Unpublish 1 entry? Visitors stop seeing it until you publish it again.' : 'Unpublish {count} entries? Visitors stop seeing them until you publish them again.', { count: fitting('unpublish').length })} failureLabel={wording('cms.entry.unpublishFailure', 'Could not unpublish')} onConfirm={() => run('unpublish')})
if actions.has('delete') && blocked().delete !== undefined
  Refused(label={wording('cms.bulk.delete', 'Delete')} ariaLabel={wording('cms.bulk.deleteAria', rows.length === 1 ? 'Delete 1 selected entry' : 'Delete {count} selected entries', { count: rows.length })} reason={blocked().delete} tone="danger")
else if actions.has('delete')
  ConfirmDelete(triggerLook="button" label={wording('cms.bulk.delete', 'Delete')} aria-label={wording('cms.bulk.deleteAria', rows.length === 1 ? 'Delete 1 selected entry' : 'Delete {count} selected entries', { count: rows.length })} message={bulkDeleteMessage(rows.length, referrers())} onOpenChange={open => open && askReferrers()} failureLabel={wording('cms.save.deleteFailure', 'Could not delete')} onConfirm={() => run('delete')})
