---
import { recipe } from 'kay'
import type { InfiniteList } from './infinite-list'
import Button from './button.kay'
import WhenVisible from './when-visible.kay'
import { wording } from 'kay/words'

const look = recipe({ parts: { root: 'kui-load-more', failed: 'kui-load-more-failed', loading: 'kui-load-more-loading' } })

const { list, margin, loadingLabel = wording('ui.loadMore.loadingLabel', 'Loading more…'), failureLabel = wording('ui.loadMore.failureLabel', 'Could not load more.'), retryLabel = wording('ui.loadMore.retryLabel', 'Try again') } = props<{
  // The list this draws the end of, from `infiniteList`.
  list: InfiniteList<unknown>
  // How far outside the scroll box counts as in view already, in pixels: see WhenVisible.
  margin?: number | undefined
  loadingLabel?: string | undefined
  failureLabel?: string | undefined
  retryLabel?: string | undefined
}>()
---
// The end of an infinite list: the sentinel while there are more rows, a status while a page loads, and an alert with a retry once a page failed, which loads no other until it is pressed.
div(part="root")
  if !list.ended()
    if list.failed()
      div(part="failed" role="alert")
        p {failureLabel}
        Button(label={retryLabel} busy={list.pending()} disabled={list.pending()} onClick={list.retry})
    else
      WhenVisible(onVisible={list.more} margin={margin})
      // An always-present status, so a screen reader hears the text appear; the text's element coming and going is also what makes WhenVisible look again where the list stands, as it watches its parent's children.
      p(part="loading" role="status")
        if list.pending()
          span {loadingLabel}
