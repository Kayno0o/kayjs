---
import type { FieldSize } from './field-look'
import { fieldInvalid, fieldSize, keepInvalid, LABEL_TEXT } from './field-look'
import type { JSX } from 'kay'
import type { RangeValue } from './range'
import { effect, recipe, uid, untrack } from 'kay'
import { onFormReset, startRef } from './form-reset'
import { linkChoice } from './choice-link'
import { rangeFrom } from './range'
import { wording } from 'kay/words'

const look = recipe({ parts: { field: 'inline-flex flex-col items-start gap-1', heading: LABEL_TEXT, root: 'kui-range-input', box: 'kui-range-input-box', separator: 'kui-range-input-separator', unit: 'kui-range-input-unit' } })

const { size = 'md', invalid, value = [null, null], min, max, step, label, showLabel = false, fromLabel, toLabel, unit, onChange, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'children' | 'role' | 'onChange'> & {
  // The size of both boxes: `md` by default, `sm` and `lg` change their padding and type.
  size?: FieldSize | undefined
  // Marks the control as refused, in the danger colour with `aria-invalid`. A FormField marks its control on its own while it shows a message.
  invalid?: boolean | undefined
  // The bounds to start with; a pair whose parent passes another follows it.
  value?: RangeValue | undefined
  // The lowest and highest values allowed, shown as the empty boxes' placeholders.
  min?: number | undefined
  max?: number | undefined
  step?: number | undefined
  // Names the pair for screen readers, each box adding "from" or "to".
  label: string
  // Writes `label` above the boxes, in a Slider's label type, and names it by that text (`aria-labelledby`) in place of `aria-label`. Off by default.
  showLabel?: boolean | undefined
  // Each box's whole name in place of the label and "from" or "to", for another language.
  fromLabel?: string | undefined
  toLabel?: string | undefined
  // Written after the boxes, such as `h` or `%`.
  unit?: string | undefined
  // Runs once a box is committed, on blur or Enter, rather than on every keystroke, and only when the range changed.
  onChange?: ((value: RangeValue) => unknown) | undefined
}>()

let low: HTMLInputElement | undefined
let high: HTMLInputElement | undefined
// kay-allow once-read-prop: the drag starts from the value the component was created with
let last: RangeValue = value

effect(() => {
  last = value
})

function commit() {
  if (!low || !high)
    return

  const next = rangeFrom(low.value, high.value)

  // Written back, so a swapped pair shows in order.
  low.value = next[0]?.toString() ?? ''
  high.value = next[1]?.toString() ?? ''

  if (next[0] === last[0] && next[1] === last[1])
    return

  last = next
  onChange?.(next)
}
const lowRef = startRef<HTMLInputElement>((element) => {
  low = element
  linkChoice(element.closest<HTMLElement>('[data-kui-choice]'))
  keepInvalid(element, () => invalid)
  element.defaultValue = untrack(() => value[0]?.toString() ?? '')
})
const highRef = startRef<HTMLInputElement>((element) => {
  high = element
  keepInvalid(element, () => invalid)
  element.defaultValue = untrack(() => value[1]?.toString() ?? '')
})

// A reset puts the boxes back on their defaults, which the app's `onChange` then hears of.
onFormReset(() => low, commit)
// The heading's id while `showLabel` writes it, which then names the control in place of `aria-label`.
const heading = showLabel && label ? uid() : undefined
---
snippet range()
  div(part="root" {...rest} role="group" data-kui-choice="" aria-label={heading ? undefined : label} aria-labelledby={heading ?? rest['aria-labelledby']})
    input.kui-field-input(part="box" data-size={fieldSize(size)} aria-invalid={fieldInvalid(() => invalid)} ref={lowRef} type="number" inputmode="decimal" aria-label={fromLabel ?? wording('ui.rangeInput.from', '{label} from', { label })} placeholder={min?.toString()} min={min} max={max} step={step} value={value[0] ?? ''} onChange={commit})
    span(part="separator" aria-hidden="true") -
    input.kui-field-input(part="box" data-size={fieldSize(size)} aria-invalid={fieldInvalid(() => invalid)} ref={highRef} type="number" inputmode="decimal" aria-label={toLabel ?? wording('ui.rangeInput.to', '{label} to', { label })} placeholder={max?.toString()} min={min} max={max} step={step} value={value[1] ?? ''} onChange={commit})
    if unit
      span(part="unit") {unit}
if heading
  div(part="field")
    span(part="heading" id={heading}) {label}
    {range()}
else
  {range()}
