---
import type { JSX, Snippet } from 'kay'
import type { IconChoice } from './icon-picker'
import { batch, effect, flush, onCleanup, postedValue, recipe, signal } from 'kay'
import { fieldInvalid, keepInvalid } from './field-look'
import Icon from './icon.kay'
import IconButton from './icon-button.kay'
import { defaultKept, onFormReset } from './form-reset'
import { nameOf } from './icon-picker'
import { wording } from 'kay/words'

const PAGE_SIZE = 50
const DEBOUNCE_MS = 200

const look = recipe({ parts: { root: 'kui-icon-picker', search: '', grid: 'kui-icon-grid', option: 'kui-icon-grid-option', empty: 'kui-icon-grid-empty', bar: 'kui-icon-grid-bar', selection: 'kui-icon-grid-selection', clear: 'kui-icon-grid-clear', error: 'kui-icon-grid-error', more: 'kui-icon-grid-more' } })

const { search, icons: given, value = '', name, invalid, disabled = false, onChange, onSearch, onError, searchLabel = wording('ui.iconPicker.search', 'Search icons'), placeholder = wording('ui.iconPicker.placeholder', 'Search icons…'), gridLabel = wording('ui.iconPicker.grid', 'Icons'), searchingLabel = wording('ui.iconPicker.searching', 'Searching…'), emptyLabel = wording('ui.iconPicker.empty', 'No icons found.'), empty, errorLabel = wording('ui.iconPicker.error', 'The icons could not be loaded.'), clearLabel = wording('ui.iconPicker.clear', 'Clear icon selection'), moreLabel = wording('ui.iconPicker.more', 'Show more'), ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'children' | 'onChange' | 'onError'> & {
  // The icons matching `query` from the `offset`th on, at most `limit` of them: typically an action, since a whole icon set is too large to ship. A page of fewer than `limit` is the last. A rejection is logged and leaves the last grid on screen under `errorLabel`.
  search?: ((query: string, limit: number, offset: number) => Promise<IconChoice[]>) | undefined
  // A fixed set of icons instead of `search`, filtered by the text typed and paged like its answers: no action is needed for a small set. Give one of the two.
  icons?: readonly IconChoice[] | undefined
  // The chosen icon's name, or an empty string for none; a picker whose parent passes another follows it.
  value?: string | undefined
  // Submits the chosen icon's name under this name, for a picker inside a form.
  name?: string | undefined
  // Marks the picker as refused, its search box in the danger colour, with `aria-invalid`. A FormField showing a message marks it on its own.
  invalid?: boolean | undefined
  // Keeps the picker from changing: the search box, the icons and the buttons are disabled, and a form posts nothing for it.
  disabled?: boolean | undefined
  // Hands over a pick, or an empty string for a cleared one.
  onChange?: ((name: string) => unknown) | undefined
  // Called with the query each time a new search starts, the first one included, not for a page added by Show more.
  onSearch?: ((query: string) => unknown) | undefined
  // Called with what `search` rejected with, for the latest search or page only; the grid keeps its icons under `errorLabel`.
  onError?: ((error: unknown) => unknown) | undefined
  // What the picker says: the search box's name and placeholder, the grid's name, its states, and its two buttons.
  searchLabel?: string | undefined
  placeholder?: string | undefined
  gridLabel?: string | undefined
  searchingLabel?: string | undefined
  emptyLabel?: string | undefined
  // Replaces the empty text with the app's own markup, such as a link to add the missing one: an `@empty` block.
  empty?: Snippet | undefined
  errorLabel?: string | undefined
  clearLabel?: string | undefined
  moreLabel?: string | undefined
}>()

// A picker with no callback is plain: a refused post of its form, which the server renders it for, gives its icon back in place of its own.
const sent = onChange ? undefined : postedValue(name, value)
const picked = signal(sent ?? value)
const typed = signal('')
const query = signal('')
const icons = signal<IconChoice[]>([])

// The icons of a given set whose name holds the text, any case.
async function listed(needle: string, limit: number, offset: number): Promise<IconChoice[]> {
  const text = needle.trim().toLowerCase()

  return (given ?? []).filter(choice => choice.name.toLowerCase().includes(text)).slice(offset, offset + limit)
}
// Whether the last page came back full, so another may follow.
const more = signal(false)
const pending = signal(true)
// Whether the last search was rejected.
const failed = signal(false)
// The last pick, whose icon the selection keeps drawing once a new search no longer finds it.
const last = signal<IconChoice>()
let hidden: HTMLInputElement | undefined
let searchBox: HTMLInputElement | undefined
let request = 0
// The search the grid shows, and where its next page starts: a Show more asks for these, whatever has been typed since.
let shownQuery = ''
let nextOffset = 0

// The first run leaves a start the server refilled alone, which the browser reads from its markup.
let refilled = sent !== undefined

effect(() => {
  const next = value

  if (refilled)
    refilled = false
  else
    picked = next
})

effect(() => {
  const next = typed()
  // A new search starts back on its first page; the same one, such as on the first run, keeps the pages shown.
  const timer = setTimeout(() => next !== query() && query.set(next), DEBOUNCE_MS)

  onCleanup(() => clearTimeout(timer))
})

effect(() => void load(query(), 0))

// The last grid stays on screen while the next search is in flight, and only the latest search lands. A page after the first is added to the grid, the icons it shares with it left out.
async function load(needle: string, offset: number) {
  const mine = ++request

  pending = true

  if (offset === 0)
    onSearch?.(needle)

  try {
    const found = await (search ?? listed)(needle, PAGE_SIZE, offset)

    if (mine !== request)
      return

    const shown = offset === 0 ? new Set<string>() : new Set(icons().map(choice => choice.name))
    const fresh = found.filter(choice => !shown.has(choice.name))

    shownQuery = needle
    nextOffset = offset + found.length

    batch(() => {
      icons = offset === 0 ? found : [...icons(), ...fresh]
      // An app that ignores the offset gives the same page again: nothing new ends the paging.
      more = found.length >= PAGE_SIZE && fresh.length > 0
      failed = false
    })
  }
  catch (error) {
    if (mine === request) {
      console.error('kayjs-ui: an IconPicker\'s search failed', error)
      failed = true
      onError?.(error)
    }
  }
  finally {
    if (mine === request)
      pending = false
  }
}

// A click while a page is on its way asks for nothing more.
function showMore() {
  if (!pending())
    void load(shownQuery, nextOffset)
}

const chosen = () => icons().find(choice => choice.name === picked())?.icon ?? (last()?.name === picked() ? last()?.icon : undefined)

function pick(next: string) {
  picked = next
  onChange?.(next)

  if (!hidden)
    return

  // A pick types nothing, so once the hidden input holds it, an `input` event tells the form, as typing would.
  flush()
  hidden.dispatchEvent(new Event('input', { bubbles: true }))
}

// Read once: a ref an app writes inline is a new function on every read of the prop, which kay would run again on the root each time its attributes change.
const ref = rest.ref

// What a reset goes back to: the icon it started with, or the one last saved by a SaveForm.
const initial = defaultKept(() => searchBox, picked, value)

// The hidden input is no default of its own to reset to, so a reset sends the picker back to `initial`, and empties the search the browser emptied.
onFormReset(() => searchBox, () => {
  typed = ''

  if (picked() !== initial())
    pick(initial())
})

function choose(choice: IconChoice) {
  if (disabled)
    return

  last = choice
  pick(picked() === choice.name ? '' : choice.name)
}

// Enter in the search box has nothing to confirm, since the grid follows the typing; left alone, it would submit the whole form.
function keepEnter(event: KeyboardEvent) {
  if (event.key === 'Enter')
    event.preventDefault()
}
---
div(part="root" {...rest} ref={ref})
  if name
    input(type="hidden" name={name} value={picked()} disabled={disabled} ref={element => hidden = element})
  input.kui-field-input(part="search" ref={element => { searchBox = element; keepInvalid(element, () => invalid) }} aria-invalid={fieldInvalid(() => invalid)} disabled={disabled} type="search" data-kui-search placeholder={placeholder} aria-label={searchLabel} value={typed()} onInput={event => typed = event.currentTarget.value} onKeyDown={keepEnter})
  ul(part="grid" aria-label={gridLabel} aria-busy={pending() ? 'true' : undefined})
    for choice of icons() key={choice.name}
      li(part="item")
        button(part="option" type="button" disabled={disabled} aria-label={nameOf(choice.name)} data-tooltip={nameOf(choice.name)} aria-pressed={picked() === choice.name ? 'true' : 'false'} onClick={() => choose(choice)})
          Icon(icon={choice.icon})
    if icons().length === 0
      li(part="empty")
        if empty && !pending() && !failed()
          | {empty}
        else
          | {pending() ? searchingLabel : failed() ? errorLabel : emptyLabel}
  div(part="bar")
    if picked()
      span(part="selection" aria-live="polite")
        if chosen() as icon
          Icon(icon={icon})
        | {nameOf(picked())}
        IconButton(icon="close" label={clearLabel} size="xs" variant="inline" part="clear" disabled={disabled} onClick={() => pick('')})
    if failed() && icons().length > 0
      span(part="error" role="alert") {errorLabel}
    if more()
      button(part="more" type="button" disabled={disabled} onClick={showMore}) {moreLabel}
