---
import { recipe } from 'kay'
import type { JSX } from 'kay'
import type { IconProps } from 'kay/icons'
import type { IconSlot } from './defaults'
import Icon from './icon.kay'

// The base is the classes theme.css styles, so an app's CSS on them keeps working; `src/ui.ts` and the `class` object restyle each part.
const look = recipe({ parts: { root: 'kui-stat-badge', value: 'kui-stat-value', label: 'kui-stat-label' } })

const { value, label, icon, ...rest } = props<Omit<JSX.IntrinsicElements['span'], 'class' | 'children'> & {
  value: number | string
  label?: string | undefined
  icon?: IconSlot | IconProps | undefined
}>()
---
// A figure and what it counts, read together: "12 moons".
span({...rest})
  if icon
    Icon(icon={icon})
  span(part="value") {value}
  if label
    span(part="label") {label}
