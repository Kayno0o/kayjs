--- server
import { localize, t } from 'kay/i18n'
import Message from '../components/message.kay'
import Panel from '../components/panel.kay'
import PasskeyTwoFactor from '../components/passkey-two-factor.kay'
import { failure, schemas } from '../forms'
import Button from '@kaynooo/kayjs-ui/button.kay'
import FormField from '@kaynooo/kayjs-ui/form-field.kay'

// Visitors reach this page before signing in, so none of the app's guards run here, whatever they check: one asking for a session would keep everyone out.
export const page = { guards: false }

export const verify = action(schemas.twoFactor, async ({ code }, ctx) => {
  const result = await ctx.locals.auth.verifyTwoFactor(code)

  if (!result.ok)
    return ctx.fail(400, { error: result.error === 'invalid' ? 'code' : result.error })

  return ctx.redirect(result.redirect)
})

export const passkeyOptions = action(async (ctx) => {
  const result = await ctx.locals.auth.twoFactorPasskeyOptions()

  return result.ok ? result.options : ctx.fail(400, { error: result.error })
})

export const passkey = action(schemas.passkey, async (input, ctx) => {
  const result = await ctx.locals.auth.verifyTwoFactorPasskey(input.response)

  if (!result.ok)
    return ctx.fail(400, { error: result.error === 'invalid' ? 'code' : result.error })

  return ctx.redirect(result.redirect)
})

const auth = ctx.locals.auth
const features = auth.features()
const pending = await auth.twoFactorPending()
const error = ctx.failed(verify)?.data?.error
---
head
  title {t('auth.twoFactor.title')}
Panel(title={t('auth.twoFactor.title')})
  if pending
    form.flex.flex-col.gap-3(action={verify})
      p {t('auth.twoFactor.intro')}
      FormField(label={t('auth.code')} required)
        input(name="code" autocomplete="one-time-code" autocapitalize="off" spellcheck="false" required)
      if error
        Message(text={failure(error)})
      Button(type="submit" variant="accent" label={t('auth.twoFactor.submit')})
    if features.passkeys
      PasskeyTwoFactor(label={t('auth.twoFactor.passkey')} failed={failure('invalid')})
  else
    p {t('auth.twoFactor.nothing')}
    a(href={localize(features.signInPage)}) {t('auth.signIn.title')}
