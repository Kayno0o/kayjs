---
import AppHeader from '@kaynooo/kayjs-ui/app-header.kay'
import AppSwitcher from '@kaynooo/kayjs-ui/app-switcher.kay'
import Badge from '@kaynooo/kayjs-ui/badge.kay'
import CardRow from '@kaynooo/kayjs-ui/card-row.kay'
import CollapsibleSection from '@kaynooo/kayjs-ui/collapsible-section.kay'
import PageHeader from '@kaynooo/kayjs-ui/page-header.kay'
import PageSection from '@kaynooo/kayjs-ui/page-section.kay'
import Select from '@kaynooo/kayjs-ui/select.kay'
import SiteNav from '@kaynooo/kayjs-ui/site-nav.kay'
import TreeView from '@kaynooo/kayjs-ui/tree-view.kay'
import Widget from '@kaynooo/kayjs-ui/widget.kay'
---
main
  article#header
    PageHeader(title="Moons")
      @actions
        a(href="/table") New
      p Every moon of Mars.
  article#tree
    TreeView(nodes={[{ id: 'mars', label: 'Mars', children: [{ id: 'phobos', label: 'Phobos' }] }, { id: 'venus', label: 'Venus' }]} label="Planets" selected="phobos")
  article#bare-header
    PageHeader(title="Rings")
  article#section
    PageSection(title="Moons")
      @actions
        a(href="/table") New
      p Phobos
  article#collapsed
    CollapsibleSection(title="Older" open={false} boxed)
      @meta
        Badge(label={2})
      p Deimos
  article#widget
    Widget(title="Visits" icon="info")
      @actions
        a(href="/content") All
      p 42
  article#empty-widget
    Widget(title="Visits" isEmpty)
      @empty
        p.none No visits yet
      p 42
  article#hidden-widget
    Widget(title="Visits" isEmpty)
      p 42
  article#row
    CardRow
      @left
        span.dot
      @right
        span 3 moons
      @actions
        a(href="/form") Edit
      | Mars
  article#site-nav
    SiteNav(id="main-links" links={[{ href: '/', label: 'Home' }, { href: '/chart', label: 'Chart' }, { href: '/charts', label: 'Charts' }, { href: '/charts/moons', label: 'Moons' }, { href: '/data', label: 'Data' }]} current="/charts/moons/" label="Main" menuLabel="Ouvrir le menu")
  article#app-header
    AppHeader(links={[{ href: '/', label: 'Home', icon: 'info' }, { href: '/data', label: '<b>Data</b>' }]} current="/data/" label="Site")
      @brand
        a(href="/") Moons
      @end
        a(href="/form") Sign in
  article#url-nav
    SiteNav(id="url-links" links={[{ href: '/', label: 'Home' }, { href: '/data', label: 'Data' }]} current={new URL('https://example.com/data/?view=1')} label="By URL")
  article#busy-select
    Select#busy-new(value="a" options={[{ value: 'a', label: 'A' }]} busy aria-busy="false")
    Select#busy-new-plain(value="a" options={[{ value: 'a', label: 'A' }]} busy)
    Select#idle(value="a" options={[{ value: 'a', label: 'A' }]})
  article#app-header-bare
    AppHeader(links={[{ href: '/', label: 'Home' }]} current="/" label="Bare" sticky={false})
  article#app-switcher
    AppHeader(links={[{ href: '/', label: 'Home' }]} current="/" label="Switch")
      @end
        AppSwitcher(id="family" apps={[{ id: 'atlas', href: 'https://atlas.example.com/', label: 'Atlas', icon: 'globe', description: 'Maps' }, { id: 'hubble', href: 'https://hubble.example.com/', label: 'Hubble' }, { id: 'relay', href: 'https://relay.example.com/', label: 'Relay', newTab: true, rel: 'noopener noreferrer' }]} current="hubble")
