---
import { signal } from 'kay'
import type { TreeNode } from '@kayjs/ui'
import TreeView from '@kayjs/ui/tree-view.kay'

const folder = signal('ideas')
const nodes: TreeNode[] = [
  { key: 'work', label: 'Work', children: [{ key: 'specs', label: 'Specs', children: [{ key: 'api', label: 'API' }] }, { key: 'ideas', label: 'Ideas' }] },
  { key: 'travel', label: 'Travel', children: [] },
  { key: 'inbox', label: 'Inbox', icon: 'info' },
]
---
.flex.flex-col.gap-2.max-w-xs
  TreeView(nodes={nodes} label="Folders" selected={folder()} onSelectedChange={folder.set})
  p Showing {folder()}.
