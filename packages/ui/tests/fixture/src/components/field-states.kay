---
import { trustHtml } from 'kay'
import Combobox from '@kayjs/ui/combobox.kay'
import Checkbox from '@kayjs/ui/checkbox.kay'
import ChipGroup from '@kayjs/ui/chip-group.kay'
import ColorInput from '@kayjs/ui/color-input.kay'
import DateInput from '@kayjs/ui/date-input.kay'
import DateRangeInput from '@kayjs/ui/date-range-input.kay'
import DateTimeInput from '@kayjs/ui/date-time-input.kay'
import FileDrop from '@kayjs/ui/file-drop.kay'
import IconPicker from '@kayjs/ui/icon-picker.kay'
import MarkdownEditor from '@kayjs/ui/markdown-editor.kay'
import RowsField from '@kayjs/ui/rows-field.kay'
import MultiSelect from '@kayjs/ui/multi-select.kay'
import RadioGroup from '@kayjs/ui/radio-group.kay'
import RangeInput from '@kayjs/ui/range-input.kay'
import Rating from '@kayjs/ui/rating.kay'
import Select from '@kayjs/ui/select.kay'
import Segmented from '@kayjs/ui/segmented.kay'
import Slider from '@kayjs/ui/slider.kay'
import Textarea from '@kayjs/ui/textarea.kay'
import TextInput from '@kayjs/ui/text-input.kay'
import TimeInput from '@kayjs/ui/time-input.kay'
import Toggle from '@kayjs/ui/toggle.kay'

// Every form control once, large and refused, each in a wrapper named after it, and a TextInput left at its defaults.
const options = [{ value: 'a', label: 'A' }]
const icons = [{ name: 'tabler:star', icon: { 'viewBox': '0 0 24 24', 'width': '1em', 'height': '1em', 'aria-hidden': 'true' as const, 'innerHTML': trustHtml('<path d="M0 0"/>') } }]
const columns = [{ key: 'name', label: 'Name' }]
---
div#text
  TextInput(size="lg" invalid)
div#plain
  TextInput
div#area
  Textarea(size="lg" invalid)
div#select
  Select(size="lg" invalid options={options} value="a")
div#combobox
  Combobox(size="lg" invalid label="Planet" options={options})
div#multi
  MultiSelect(size="lg" invalid label="Tags" options={options})
div#date
  DateInput(size="lg" invalid)
div#time
  TimeInput(size="lg" invalid)
div#datetime
  DateTimeInput(size="lg" invalid)
div#dates
  DateRangeInput(size="lg" invalid label="Dates")
div#range
  RangeInput(size="lg" invalid label="Range")
div#slider
  Slider(size="lg" invalid label="Volume" value={3})
div#radios
  RadioGroup(invalid label="Plan" options={options} value="a")
div#segmented
  Segmented(invalid label="View" options={options} value="a")
div#chips
  ChipGroup(invalid label="Tags" options={options} value={[]})
div#rating
  Rating(invalid label="Stars" value={2} onChange={() => undefined})
div#color
  ColorInput(invalid label="Colour" value="#000000")
div#drop
  FileDrop(invalid onFiles={() => undefined})
    @content(zone)
      button(type="button" onClick={zone.open}) Pick
div#box
  Checkbox(label="Terms" invalid)
div#switch
  Toggle(label="News" invalid)
div#boxmsg
  Checkbox(label="Terms" issue="Tick it")
div#switchmsg
  Toggle(label="News" issue="Switch it")
div#rows
  RowsField(invalid label="Rows" columns={columns} rows={[{ name: 'a' }]})
div#markdown
  MarkdownEditor(invalid)
div#icons
  IconPicker(invalid icons={icons})
div#iconsoff
  IconPicker(disabled icons={icons})
