---
import type { JSX } from 'kay'
import type { IconProps } from 'kay/icons'
import type { TextEdit, ToolbarAction } from './markdown-edit'
import { entriesFromDataTransfer } from '@kaynooo/utils/browser/clipboard'
import { effect, onCleanup, onMount, signal, trustHtml, uid, untrack } from 'kay'
import { wording } from 'kay/words'
import bold from '~icons/tabler/bold'
import eye from '~icons/tabler/eye'
import heading from '~icons/tabler/heading'
import italic from '~icons/tabler/italic'
import link from '~icons/tabler/link'
import list from '~icons/tabler/list'
import listNumbers from '~icons/tabler/list-numbers'
import photo from '~icons/tabler/photo'
import { controlledValue } from './controlled-value'
import { startRef } from './form-reset'
import IconButton from './icon-button.kay'
import { enterEdit, headingEdit, imageEdit, indentEdit, linkEdit, listEdit, TOOLBAR_ACTIONS, wrapEdit } from './markdown-edit'
import { attempt } from './toast'

const SHORTCUT_MARKERS: Partial<Record<string, string>> = { b: '**', i: '*' }
const PREVIEW_DELAY = 250


const ACTIONS: Record<ToolbarAction, { icon: IconProps, edit: (text: string, start: number, end: number) => TextEdit }> = {
  bold: { icon: bold, edit: (text: string, start: number, end: number) => wrapEdit(text, start, end, '**') },
  italic: { icon: italic, edit: (text: string, start: number, end: number) => wrapEdit(text, start, end, '*') },
  heading: { icon: heading, edit: headingEdit },
  bulletList: { icon: list, edit: (text: string, start: number, end: number) => listEdit(text, start, end, false) },
  numberedList: { icon: listNumbers, edit: (text: string, start: number, end: number) => listEdit(text, start, end, true) },
  link: { icon: link, edit: linkEdit },
  image: { icon: photo, edit: imageEdit },
}

const { value = '', onInput, onImage, toolbar = true, preview, uploadFailure = wording('ui.markdownEditor.uploadFailure', 'Could not upload the image'), placeholder = wording('ui.markdownEditor.placeholder', 'Write markdown…'), keysHint = wording('ui.markdownEditor.keysHint', 'Tab indents a list item; Escape then Tab leaves the field.'), class: className, ...rest } = props<Omit<JSX.IntrinsicElements['textarea'], 'value' | 'class' | 'children' | 'onInput' | 'onKeyDown' | 'onPaste' | 'onDrop'> & {
  // The text to start with; an editor whose parent passes other text follows it.
  value?: string | undefined
  // The text after every change, typed or applied by a shortcut, a paste or an upload.
  onInput?: ((value: string) => void) | undefined
  // Uploads a pasted or dropped image and returns the url to embed it by. Without it, images are left to the browser.
  onImage?: ((file: File) => Promise<string>) | undefined
  // Toasted when an upload throws.
  uploadFailure?: string | undefined
  // The buttons over the field, in order: `false` for none, else any of `bold`, `italic`, `heading`, `bulletList`, `numberedList`, `link` and `image`, all of them by default.
  // `image` opens the file picker when `onImage` is given, else writes an image to fill in.
  toolbar?: boolean | readonly ToolbarAction[] | undefined
  // Renders the text as the page shows it, as HTML, on the server: given, a Preview button shows it beside the field, or in place of it on a narrow one. The HTML is trusted, so it must come from the app's own renderer.
  preview?: ((markdown: string) => Promise<string>) | undefined
  // Tells screen readers how to leave the field, since Tab on a list item indents it.
  keysHint?: string | undefined
  class?: string | undefined
}>()

// Per instance, as the page's locale is only known when it renders.
const labels: Record<ToolbarAction, string> = {
  bold: wording('ui.markdownEditor.bold', 'Bold'),
  italic: wording('ui.markdownEditor.italic', 'Italic'),
  heading: wording('ui.markdownEditor.heading', 'Heading'),
  bulletList: wording('ui.markdownEditor.bulletList', 'Bulleted list'),
  numberedList: wording('ui.markdownEditor.numberedList', 'Numbered list'),
  link: wording('ui.markdownEditor.link', 'Link'),
  image: wording('ui.markdownEditor.image', 'Image'),
}

const uploading = signal(0)
let area: HTMLTextAreaElement | undefined
const ref = startRef<HTMLTextAreaElement>((element) => {
  area = element
  element.defaultValue = untrack(() => value)
}, rest.ref)
// Set by Escape, so the Tab after it moves on rather than indenting.
let leaving = false

// Inside a form field's label, the buttons and the preview would be read as part of the field's name: the label's own text names it instead.
function nameByLabel(element: HTMLTextAreaElement): void {
  const label = element.closest('.kui-form-field-label')?.querySelector('.kui-label-text')

  if (!label || element.hasAttribute('aria-labelledby') || element.hasAttribute('aria-label'))
    return

  label.id ||= uid()
  element.setAttribute('aria-labelledby', label.id)
}

onMount(() => {
  if (area)
    nameByLabel(area)
})

function isImage(file: File): boolean {
  return file.type.startsWith('image/')
}

function actions(): readonly ToolbarAction[] {
  const chosen = toolbar

  if (typeof chosen === 'boolean')
    return chosen ? TOOLBAR_ACTIONS : []

  return chosen
}
const text = signal(untrack(() => value))
const previewing = signal(false)
const rendered = signal<string | undefined>(undefined)
const failed = signal(false)
// Counts the renders asked for, so a slow answer to an older text never lands over a newer one.
let asked = 0

effect(() => {
  text.set(value)
})

effect(() => {
  if (!previewing() || !preview)
    return

  const markdown = text()
  const render = preview
  const turn = ++asked
  const timer = setTimeout(async () => {
    try {
      const html = await render(markdown)

      if (turn === asked) {
        rendered.set(html)
        failed.set(false)
      }
    }
    catch (error) {
      console.error('kayjs-ui: a MarkdownEditor\'s preview failed', error)

      if (turn === asked)
        failed.set(true)
    }
  }, untrack(rendered) === undefined ? 0 : PREVIEW_DELAY)

  onCleanup(() => clearTimeout(timer))
})

// The attribute fills the field on the server and as it hydrates; afterwards the text lands on it only when it differs, since writing it moves the caret to the end. A reset is reported as if typed.
const { heard } = controlledValue({
  box: () => area,
  value: () => value,
  report: (element) => {
    heard(element.value)
    text.set(element.value)
    onInput?.(element.value)
  },
})

// Applies an edit through the browser's own editing, so Ctrl+Z undoes it like typing, else sets the text and reports it with an `input` event.
// An edit nobody typed, such as a finished upload, takes that second way unless the field still has focus, so it never pulls focus back.
function applyEdit(el: HTMLTextAreaElement, edit: TextEdit, takeFocus = true): void {
  const native = typeof document.execCommand === 'function' && (takeFocus || document.activeElement === el)

  if (native) {
    el.focus()
    el.setSelectionRange(edit.start, edit.end)
  }

  const done = edit.text === '' ? edit.start === edit.end || (native && document.execCommand('delete')) : native && document.execCommand('insertText', false, edit.text)

  if (!done) {
    el.setRangeText(edit.text, edit.start, edit.end, 'end')
    el.dispatchEvent(new Event('input', { bubbles: true }))
  }

  el.setSelectionRange(edit.selectionStart, edit.selectionEnd)
}

function togglePreview(): void {
  // What was shown last time is not what the text says now.
  if (previewing())
    rendered.set(undefined)

  previewing.set(on => !on)
}

function pickImage(): void {
  if (!onImage) {
    runAction('image')

    return
  }

  const input = document.createElement('input')

  input.type = 'file'
  input.accept = 'image/*'
  input.multiple = true
  input.addEventListener('change', () => void upload([...input.files ?? []].filter(isImage)))
  input.click()
}

function runAction(action: ToolbarAction): void {
  if (!area)
    return

  area.focus()
  applyEdit(area, ACTIONS[action].edit(area.value, area.selectionStart, area.selectionEnd))
}

function edit(next: TextEdit | null, event: Event): void {
  if (!next || !area)
    return

  event.preventDefault()
  applyEdit(area, next)
}

function keyDown(event: KeyboardEvent) {
  const field = event.currentTarget as HTMLTextAreaElement

  if (event.defaultPrevented || event.isComposing)
    return

  const left = leaving

  leaving = event.key === 'Escape'

  if (left && event.key === 'Tab')
    return

  const { selectionStart: start, selectionEnd: end } = field
  const text = field.value
  const key = event.key.toLowerCase()

  if ((event.ctrlKey || event.metaKey) && !event.altKey && !event.shiftKey) {
    const marker = SHORTCUT_MARKERS[key]

    if (marker)
      edit(wrapEdit(text, start, end, marker), event)
    else if (key === 'k')
      edit(linkEdit(text, start, end), event)

    return
  }

  if (event.key === 'Tab' && !event.ctrlKey && !event.metaKey && !event.altKey)
    edit(indentEdit(text, start, end, event.shiftKey), event)
  else if (event.key === 'Enter' && !event.shiftKey && !event.ctrlKey && !event.metaKey && !event.altKey)
    edit(enterEdit(text, start, end), event)
}

// Swaps a placeholder for what replaces it wherever the text has moved it to, keeping the caret where the user left it.
function swap(placeholder: string, replacement: string): boolean {
  const el = area

  if (!el)
    return false

  const at = el.value.indexOf(placeholder)

  if (at === -1)
    return false

  const { selectionStart, selectionEnd } = el
  const shift = (index: number) => index >= at + placeholder.length ? index + replacement.length - placeholder.length : Math.min(index, at)

  applyEdit(el, { start: at, end: at + placeholder.length, text: replacement, selectionStart: shift(selectionStart), selectionEnd: shift(selectionEnd) }, false)

  return true
}

// Embeds each image behind a placeholder right away, so writing goes on while it uploads.
async function upload(files: File[]): Promise<void> {
  const send = onImage
  const el = area

  if (!el || !send)
    return

  await Promise.all(files.map(async (file) => {
    const placeholder = `![Uploading ${file.name || 'image'}…]()`
    const { selectionStart, selectionEnd } = el
    const text = `${placeholder}\n`

    applyEdit(el, { start: selectionStart, end: selectionEnd, text, selectionStart: selectionStart + text.length, selectionEnd: selectionStart + text.length })
    uploading.set(count => count + 1)

    try {
      const url = await attempt(async () => send(file), uploadFailure)

      // A failed upload takes the line break the placeholder came with, unless typing has parted them.
      if (url === undefined)
        swap(text, '') || swap(placeholder, '')
      else
        swap(placeholder, `![](${url})`)
    }
    finally {
      uploading.set(count => count - 1)
    }
  }))
}

function paste(event: ClipboardEvent) {
  const field = event.currentTarget as HTMLTextAreaElement
  const data = event.clipboardData

  if (event.defaultPrevented || !data)
    return

  const images = onImage ? [...data.files].filter(isImage) : []

  if (images.length > 0) {
    event.preventDefault()
    void upload(images)

    return
  }

  const html = entriesFromDataTransfer(data).find(entry => entry.type === 'text/html')?.text

  if (html) {
    event.preventDefault()
    void pasteMarkdown(field, html, data.getData('text/plain'))
  }
}

// The HTML to Markdown converter loads on the first paste of rich text rather than with the island; the text alone goes in if it cannot load.
// The text lands where the paste was, unless the field changed while the converter loaded, as a second paste or typing does: then at the selection by then.
async function pasteMarkdown(field: HTMLTextAreaElement, html: string, plain: string): Promise<void> {
  const before = field.value
  const at = { start: field.selectionStart, end: field.selectionEnd }
  let text: string

  try {
    text = (await import('@kaynooo/utils/browser/markdown')).htmlToMarkdown(html)
  }
  catch {
    text = plain || (new DOMParser().parseFromString(html, 'text/html').body.textContent ?? '')
  }

  const { start, end } = field.value === before ? at : { start: field.selectionStart, end: field.selectionEnd }

  applyEdit(field, { start, end, text, selectionStart: start + text.length, selectionEnd: start + text.length })
}

function drop(event: DragEvent) {
  const images = onImage ? [...event.dataTransfer?.files ?? []].filter(isImage) : []

  if (event.defaultPrevented || images.length === 0)
    return

  event.preventDefault()
  void upload(images)
}
---
// A markdown field that writes like an editor, under a toolbar and beside a preview if asked: Ctrl+B, Ctrl+I and Ctrl+K wrap the selection, Enter continues a list and Tab indents one, Escape then Tab leaving the field, a pasted page turns into markdown, and pasted or dropped images upload behind a placeholder.
// The textarea comes first in the document, so the label a form field puts around the editor names it and not the first button; the bar is placed above it by the grid.
.kui-markdown
  .kui-markdown-grid(data-preview={previewing() ? '' : undefined})
    textarea.kui-field-input.kui-markdown-editor({...rest} ref={ref} value={untrack(() => value)} placeholder={placeholder} aria-description={keysHint} aria-busy={uploading() > 0 ? 'true' : 'false'} class={className} onInput={event => { heard(event.currentTarget.value); text.set(event.currentTarget.value); onInput?.(event.currentTarget.value) }} onKeyDown={keyDown} onPaste={paste} onDrop={drop})
    if actions().length > 0 || preview
      .kui-markdown-bar(role="toolbar" aria-label={wording('ui.markdownEditor.toolbarLabel', 'Formatting')})
        .kui-markdown-tools
          for action of actions() key={action}
            IconButton(icon={ACTIONS[action].icon} label={labels[action]} variant="ghost" size="sm" onClick={() => action === 'image' ? pickImage() : runAction(action)})
        if preview
          IconButton.kui-markdown-toggle(icon={eye} label={wording('ui.markdownEditor.preview', 'Preview')} variant="ghost" size="sm" aria-pressed={previewing() ? 'true' : 'false'} onClick={togglePreview})
    if previewing()
      .kui-markdown-preview(role="region" aria-label={wording('ui.markdownEditor.previewLabel', 'Preview')} aria-busy={rendered() === undefined && !failed() ? 'true' : 'false'})
        if failed()
          p.kui-markdown-preview-failed {wording('ui.markdownEditor.previewFailure', 'The preview could not be shown')}
        else
          .kui-markdown-preview-body(innerHTML={trustHtml(rendered() ?? '')})
