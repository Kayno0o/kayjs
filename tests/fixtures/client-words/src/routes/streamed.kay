--- server
import { t } from 'elysia'
import { action, defer } from 'kay'

export const check = action(t.Object({
  name: t.String({ minLength: 3 }),
}), () => undefined)

const rows = defer(Promise.resolve([1]))
---
p.shell Shell
// kay-allow uncaught-await -- the fixture streams an await with no catch on purpose
await rows then list
  form(action={check})
    input(field="name")
    button Check
