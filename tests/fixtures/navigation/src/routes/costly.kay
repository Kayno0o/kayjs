--- server
import { t } from 'elysia'
import { action } from 'kay'

// Each post costs the browser a challenge, solved in a worker.
export const pay = action(t.Object({ title: t.String({ maxLength: 200 }) }), ({ title }, ctx) => title === 'refused' ? ctx.fail(409, 'Refused') : title, { proofOfWork: 5000 })

const success = pay.succeeded()
const failure = pay.failed()
--- script
import Payer from '../components/payer.kay'
---
head
  title Costly
h1 Costly
form(action={pay})
  input(name="title" aria-label="Title")
  button Pay
if success as done
  p.paid Paid {done.data}
if failure as failed
  p.refused {failed.status}
Payer
