---
import { signal } from 'kay'
import Menu from '@kayjs/ui/menu.kay'
import type { MenuEntry } from '@kayjs/ui'

const files = signal(['report.pdf', 'notes.md', 'photo.png'])

function entries(file: string): MenuEntry[] {
  return [
    { label: 'Download', onSelect: () => undefined },
    { label: 'Archive', disabled: true, onSelect: () => undefined },
    'separator',
    {
      label: 'Delete',
      icon: 'delete',
      tone: 'danger',
      onSelect: () => files.set(list => list.filter(name => name !== file)),
    },
  ]
}
---
ul.w-72.divide-y.divide-muted.rounded-lg.border.border-muted
  for file of files()
    li.flex.items-center.justify-between.px-3.py-1
      | {file}
      Menu(
        label={`Actions for ${file}`}
        icon="menu"
        size="sm"
        items={entries(file)}
      )
