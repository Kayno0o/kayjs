--- server
import { t } from 'elysia'
import { action } from 'kay'

export const claim = action(t.Object({ handle: t.String({ minLength: 3, maxLength: 40, error: 'Three letters at least' }) }), () => 'ok')
---
---
import Form from '@kayjs/ui/form.kay'
import Toaster from '@kayjs/ui/toaster.kay'
---
main
  Form(action={claim} id="claim")
    input#handle(name="handle" value="ab")
    button#claim-submit(formnovalidate) Claim
  Toaster
