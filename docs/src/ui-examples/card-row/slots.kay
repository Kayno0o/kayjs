---
import CardRow from '@kayjs/ui/card-row.kay'
import Icon from '@kayjs/ui/icon.kay'

const moons = [
  { name: 'Io', radius: 1822 },
  { name: 'Europa', radius: 1561 },
  { name: 'Ganymede', radius: 2634 },
]
---
.flex.flex-col.gap-2
  for moon of moons key={moon.name}
    CardRow
      @left
        Icon(icon="success")
      @right
        span {moon.radius} km
      @actions
        a(href={`/moons/${moon.name.toLowerCase()}`}) Edit
      | {moon.name}
