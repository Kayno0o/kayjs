---
import ConfirmDelete from '@kaynooo/kayjs-ui/confirm-delete.kay'
import { toast } from '@kaynooo/kayjs-ui'

async function remove() {
  await new Promise(resolve => setTimeout(resolve, 600))
  toast.success('Deleted')
}
---
.flex.items-center.gap-3
  ConfirmDelete(message="Delete this post?" failure="Could not delete" onConfirm={remove})
  ConfirmDelete(message="Empty the trash?" failure="Could not empty it" onConfirm={remove} trigger="button" label="Empty trash")
