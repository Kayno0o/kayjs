---
import { signal } from 'kay'
import Textarea from '@kayjs/ui/textarea.kay'

const note = signal('Pack the telescope.')
const saved = signal('Pack the telescope.')
---
.flex.max-w-sm.flex-col.gap-2
  Textarea(
    value={note()}
    onInput={({ value }) => note = value}
    onChange={({ value }) => saved = value}
    rows={4}
    aria-label="Note"
  )
  p.text-muted Saved on blur: {saved()}.
