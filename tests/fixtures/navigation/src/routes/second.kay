--- server
import { t } from 'elysia'
import { action } from 'kay'
import { store } from '../state'

export const add = action(t.Object({ title: t.String({ maxLength: 200, minLength: 3, error: 'Too short' }) }), async ({ title }, ctx) => {
  await Bun.sleep(200)

  if (title === 'taken')
    return ctx.fail(409, { message: 'Already taken' })

  if (title === 'busy')
    return ctx.fail(503, 'Try later')

  store.titles.push(title)

  return title
})

const failure = ctx.failed(add)
const success = ctx.succeeded(add)
const titles = store.titles
--- script
import './second.css'
---
head
  title Second
  html.second(data-second data-theme="dark")
  meta(name="second-only" content="1")
h1 Second
form(action={add})
  input(name="title" value={failure?.values.title})
  if add.error('title') as message
    p.title-error {message}
  if add.error() as message
    p.form-error {message}
  button Add
  button.unchecked(formnovalidate) Add unchecked
if failure?.data as data
  p.error {data.message}
if success as done
  p.done Added {done.data}
ul
  for title, i of titles key={i}
    li {title}
div(style="height: 3000px")
