--- island
import type { MenuEntry } from '@kayjs/ui'
import { signal } from 'kay'
import Button from '@kayjs/ui/button.kay'
import Avatar from '@kayjs/ui/avatar.kay'
import Menu from '@kayjs/ui/menu.kay'

// Entries and triggers by `tone`.
const items: MenuEntry[] = [
  { label: 'Tone', tone: 'danger', onSelect: () => undefined },
  { label: 'Neutral', tone: 'neutral', onSelect: () => undefined },
  { label: 'Plain', onSelect: () => undefined },
]
const at = signal({ x: 0, y: 0 })
const pointOpen = signal(false)
const picked = signal('')
---
Menu(id="by-tone" items={items} label="By tone" icon="plus" tone="danger")
Menu(id="icons" items={[{ label: 'Add', icon: 'plus', onSelect: () => undefined }, { label: 'Bare', onSelect: () => undefined }]} label="Icons" icon="plus")
Menu(id="plain" items={items} label="Plain" icon="plus")

Menu(id="at-point" items={[{ label: 'First', onSelect: () => picked = 'First' }, 'separator', { label: 'Second', onSelect: () => picked = 'Second' }]} label="At a point" at={at()} open={pointOpen()} onOpenChange={open => pointOpen = open})
button#ask(onClick={() => { at = { x: 40, y: 60 }; pointOpen = true }}) Ask
Menu(id="links" items={[{ label: 'Same', href: '/here', onSelect: () => picked = 'Same' }, { label: 'Away', href: 'https://example.org/x' }, { label: 'Off', href: '/off', disabled: true }, { label: 'Plain', onSelect: () => undefined }]} label="Links" icon="plus")
p#picked {picked()}
Menu(id="labelled" items={items} label="Actions")
  @trigger(attributes)
    Button#labelled-trigger({...attributes} label="Actions")
Menu(id="avatar" items={items} label="Account")
  @trigger(attributes)
    button#avatar-trigger({...attributes})
      Avatar(name="Ada" label="Ada")
