---
import type { Duration, JSX } from 'kay'
import { durationMs, effect, onCleanup, recipe, signal } from 'kay'
import { claim } from './claim'

// An element carries its tooltip as `data-tooltip`, and where it sits as `data-tooltip-placement`, a CSS `position-area`, `top` by default. `data-hint` is a tooltip for the pointer alone, for text the keyboard has no stop on.
const CARRIER = '[data-tooltip], [data-hint]'
// The anchor name the tooltip's recipe positions against.
const ANCHOR = '--tooltip-anchor'
const WHITESPACE = /\s+/
// A control a tap acts on, whose tooltip a tap leaves alone, as it does what the tap asked instead.
const CONTROL = 'a[href], button, input, select, textarea, summary, label, [contenteditable], [role=button], [role=link], [role=menuitem], [role=tab], [role=option], [role=checkbox], [role=radio], [role=switch]'
// The id of the tooltip panel, which the element it shows for points at with `aria-describedby`.
const PANEL_ID = 'kui-tooltip'

// 'kui-tooltip' stays as the component's name for an app's CSS. Anchored to whichever element TooltipHost names --tooltip-anchor.
const look = recipe({ parts: { root: 'kui-tooltip inset-auto m-1.5 max-w-xs overflow-visible border-solid border-[length:var(--border-width)] border-border-strong bg-surface-strong px-2 py-1 text-2xs text-foreground [position-anchor:--tooltip-anchor] [position-try-fallbacks:flip-block,flip-inline]' } })

const { showDelay = '80ms', hideDelay = '150ms', fallback = false, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'children' | 'id' | 'popover' | 'role'> & {
  // How long the pointer or focus rests on an element before its tooltip shows.
  showDelay?: Duration | undefined
  // How long a tooltip lingers once the pointer leaves, long enough by default for it to cross the gap onto the tooltip, which stays while hovered.
  hideDelay?: Duration | undefined
  // For an extension's own host only (the one `ui()` mounts): it gives way to every other TooltipHost, whichever hydrates first, so an app setting it on its own loses it.
  fallback?: boolean | undefined
}>()

const aimed = signal<{ element: HTMLElement, text: string } | null>(null)
let at: HTMLElement | null = null
let timer: ReturnType<typeof setTimeout> | undefined
const panel = signal<HTMLElement>()
const owns = claim('tooltips', fallback)

// The element carrying a tooltip that an event's target is, or sits inside.
function found(event: Event): HTMLElement | null {
  return event.target instanceof Element ? event.target.closest<HTMLElement>(CARRIER) : null
}

function hide() {
  clearTimeout(timer)
  at = null
  aimed = null
}

function onto(next: HTMLElement | null) {
  // Crossing the same element again is the pointer moving within it, not onto a new one.
  if (next === at)
    return

  at = next
  clearTimeout(timer)

  const text = next?.dataset.tooltip ?? next?.dataset.hint

  // An element whose popover is open shows no tooltip, which would sit over the popover it opened.
  if (!next || !text || next.getAttribute('aria-expanded') === 'true') {
    timer = setTimeout(() => aimed = null, durationMs(hideDelay))

    return
  }

  timer = setTimeout(() => aimed = { element: next, text }, durationMs(showDelay))
}

function focused(event: FocusEvent) {
  const next = found(event)

  // A press has just closed the tooltip on purpose, so only a focus the browser rings, a tab, opens one, and a hint never opens by focus.
  if (!next || (next.matches(':focus-visible') && next.dataset.tooltip !== undefined))
    onto(next)
}

function blurred(event: FocusEvent) {
  if (found(event) === at)
    hide()
}

function over(event: PointerEvent) {
  const shown = panel()

  // On the tooltip itself, it stays, as it does while the pointer crosses over to it.
  if (shown && aimed() && event.target instanceof Node && shown.contains(event.target)) {
    clearTimeout(timer)
    at = shown

    return
  }

  onto(found(event))
}

// A touch screen has no hover, so a tap shows a hint, or the tooltip of an element no tap acts on, and a second tap on it hides it; a mouse press, or a tap anywhere else, hides it as before.
function pressed(event: PointerEvent) {
  const next = found(event)

  const text = next?.dataset.tooltip ?? next?.dataset.hint

  if (event.pointerType === 'mouse' || !next || !text || aimed()?.element === next || (next.dataset.hint === undefined && next.matches(CONTROL))) {
    hide()

    return
  }

  clearTimeout(timer)
  at = next
  aimed = { element: next, text }
}

// Escape closes the tooltip and leaves the key to whatever else it does; it stays closed until the pointer or the focus moves to another element.
function keyDown(event: KeyboardEvent) {
  if (event.key !== 'Escape' || !aimed())
    return

  clearTimeout(timer)
  aimed = null
}

// A popover opening hides the tooltip, as one shown for its trigger, by a tab say, would cover it.
function toggled(event: ToggleEvent) {
  if (event.newState === 'open' && event.target !== panel() && event.target instanceof Element && event.target.hasAttribute('popover'))
    hide()
}

// One set of listeners for every element carrying a tooltip, rather than a set each.
effect(() => {
  if (!owns())
    return

  document.addEventListener('pointerover', over)
  document.addEventListener('focusin', focused)
  document.addEventListener('focusout', blurred)
  document.addEventListener('pointerdown', pressed)
  document.addEventListener('keydown', keyDown)
  window.addEventListener('blur', hide)
  // A popover's toggle does not bubble, so it is caught on its way down.
  document.addEventListener('toggle', toggled, true)

  onCleanup(() => {
    clearTimeout(timer)
    document.removeEventListener('pointerover', over)
    document.removeEventListener('focusin', focused)
    document.removeEventListener('focusout', blurred)
    document.removeEventListener('pointerdown', pressed)
    document.removeEventListener('keydown', keyDown)
    window.removeEventListener('blur', hide)
    document.removeEventListener('toggle', toggled, true)
  })
})

effect(() => {
  const target = aimed()

  const element = panel()

  // The element is gone while another TooltipHost owns the job, and a detached one cannot show as a popover.
  if (!element?.isConnected)
    return

  if (!target) {
    if (element.matches(':popover-open'))
      element.hidePopover()

    return
  }

  // The element may already anchor something of its own, such as the popover it opens, so the tooltip adds its name to that list rather than taking the slot and then clearing it.
  const own = target.element.style.getPropertyValue('anchor-name')

  target.element.style.setProperty('anchor-name', own ? `${own}, ${ANCHOR}` : ANCHOR)
  // The element may describe itself already, so the tooltip adds its id to that list too, and takes only its own back out.
  const described = target.element.getAttribute('aria-describedby')

  // A tooltip repeating the name the element already has says nothing more, so it is not added as its description.
  const name = (target.element.getAttribute('aria-label') ?? target.element.textContent ?? '').trim()

  const added = !described?.split(WHITESPACE).includes(PANEL_ID) && target.text.trim() !== name

  if (added)
    target.element.setAttribute('aria-describedby', described ? `${described} ${PANEL_ID}` : PANEL_ID)

  element.style.setProperty('position-area', target.element.dataset.tooltipPlacement ?? 'top')

  if (!element.matches(':popover-open'))
    element.showPopover()

  onCleanup(() => {
    if (own)
      target.element.style.setProperty('anchor-name', own)
    else
      target.element.style.removeProperty('anchor-name')

    if (!added)
      return

    if (described)
      target.element.setAttribute('aria-describedby', described)
    else
      target.element.removeAttribute('aria-describedby')
  })
})
---
// Rendered in the root layout, it shows the tooltip of whichever element the pointer or a tab lands on. A second one, such as an extension's, renders nothing while the first is mounted.
if owns()
  div(part="root" {...rest} id={PANEL_ID} ref={element => panel = element} popover="manual" role="tooltip") {aimed()?.text}
