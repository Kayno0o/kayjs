---
import Stat from '@kaynooo/kayjs-ui/stat.kay'

// The inline pill, a tile, a tile whose figure is toned, a pill with a change and a link.
---
Stat#plain(value={12} label="moons")
Stat#tile(value={12} label="moons" variant="tile")
Stat#toned(value="91%" label="load" variant="tile" tone="danger")
Stat#changed(value={12} label="moons" delta={{ value: '+3', label: 'vs last week' }})
Stat#linked(value={12} label="moons" href="/moons")
