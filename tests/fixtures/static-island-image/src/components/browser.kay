---
island({ render: 'client' })
import { image } from 'kay/image'
import cover from '../cover.png'
---
img.browser(src={cover} sizes="50vw" alt="Browser")
img.browser-crop(src={cover} sizes="50vw" aspect="4/3" quality={75} alt="Cropped")
img.browser-small(src={cover} sizes="95px" alt="Small")
img.browser-upload({...image('/uploads/photo.png', { width: 400, height: 300, sizes: '95px' })} alt="Upload")
