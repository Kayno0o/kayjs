--- server
import { t } from 'elysia'
import { action } from 'kay'

const EARLIEST = new Date(Date.UTC(2000, 0, 1))

interface Section { id: number, name: string, parent: Section | null, rows: Section[] }

const hall: Section = { id: 1, name: 'Hall', parent: null, rows: [] }

hall.rows.push({ id: 2, name: 'Front', parent: hall, rows: [] })

export const schedule = action(t.Object({ title: t.String({ maxLength: 10_000, minLength: 1 }), at: t.Date() }), ({ title, at }, ctx) => {
  if (at < EARLIEST)
    return ctx.fail(422, { earliest: EARLIEST })

  return { title, at, tags: new Set(['new']), seats: 10n }
})

export const leak = action(t.Object({}), () => ({ format: new Intl.NumberFormat() }))

const scheduled = ctx.succeeded(schedule)
const failure = ctx.failed(schedule)
---
---
import List from '../components/list.kay'
import Picker from '../components/picker.kay'
import Rows from '../components/rows.kay'
import Since from '../components/since.kay'
---
Since(at={EARLIEST} seats={new Map([['front', 2n]])})
Picker(items={[{ id: 1, name: 'Front' }, { id: 2, name: 'Back' }]} field="name")
Picker(items={hall.rows} field="name")
List(items={[EARLIEST]} show={day => day.toISOString()})
Rows(items={[EARLIEST]})
  @row(day, i)
    li {i}: {day.toISOString()}
form(action={schedule})
  input(name="title")
  input(name="at")
  button Schedule
if scheduled as done
  p.done Scheduled {done.data.title} on {done.data.at.toISOString()}, {done.data.tags.size} tag, {String(done.data.seats)} seats
if failure?.data as data
  p.error Not before {data.earliest.getUTCFullYear()}
