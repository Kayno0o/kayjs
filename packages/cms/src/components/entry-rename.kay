---
import Button from '@kaynooo/kayjs-ui/button.kay'
import { signal } from 'kay'
import { wording } from 'kay/words'
import type { Denials } from '../access'
import type { EntryForm } from '../form'
import Refused from './refused.kay'
import RenameDialog from './rename-dialog.kay'

// The Rename button of a saved entry and its dialog. The old page redirects to the new one by itself, and the entries naming this one are pointed at the new slug.
// Edits not saved yet disable it, as the rename acts on the entry as saved.
const { form, denied = {} } = props<{ form: EntryForm, denied?: Denials }>()

const open = signal(false)
const entry = form.stored
const dirtyReason = () => form.dirty() ? wording('cms.entry.renameDirty', 'Save or reset your edits first') : undefined

function start(): void {
  open = true
  void form.readSlugs()
  void form.askReferrers()
}
---
if denied.redirects !== undefined || dirtyReason() !== undefined
  Refused(label={wording('cms.entry.rename', 'Rename')} reason={denied.redirects ?? dirtyReason()})
else
  Button(label={wording('cms.entry.rename', 'Rename')} disabled={form.saving()} onClick={start})
RenameDialog(open={open()} onOpenChange={shown => { open = shown }} slug={entry?.slug ?? ''} hasPage={Boolean(entry?.url)} report={form.slugReport} referrers={form.referrers()} blocked={dirtyReason()} rename={form.rename})
