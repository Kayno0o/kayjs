--- <Data>
import { signal } from 'kay'
import Button from './button.kay'
import Dialog from './dialog.kay'
import IconButton from './icon-button.kay'
import { attempt } from './toast'

const { message, onConfirm, failure, success, refused, tone = 'danger', trigger = 'icon', ask = 'dialog', label, title, confirmLabel, pendingLabel, cancelLabel = 'Cancel', size, variant, class: className } = props<{
  // The dialog's question; asked inline, the armed pair's name for screen readers and the confirm button's tooltip.
  message: string
  // Deletes, or does what a neutral confirm asks. The dialog stays open, its buttons disabled, until a returned promise settles, and closes once it resolves.
  onConfirm: () => void | Promise<void>
  // Toasted when `onConfirm` throws, which leaves the dialog open, unless the call carries a message of its own: see `attempt`.
  failure: string
  // Toasted once `onConfirm` went through.
  success?: string | undefined
  // What a refusal of the action's handler says, from the data it passed to `ctx.fail`: toasted in place of `failure`, which stays for an answer of undefined or another error.
  refused?: ((data: Data) => string | undefined) | undefined
  // `neutral` for a confirm that is not a deletion, such as a save with a consequence: accent buttons, a check icon, and every word taken from `label` unless given.
  tone?: 'danger' | 'neutral' | undefined
  // An icon by default; `button` is a labelled danger button, for a dialog footer, and `link` a plain underlined text button, for a confirm inside running text.
  trigger?: 'icon' | 'button' | 'link' | undefined
  // `inline` asks in place of the trigger instead of in a dialog: a click arms it into a danger button that deletes and one that cancels, for a row of a list.
  ask?: 'dialog' | 'inline' | undefined
  // What the trigger says, for a delete the reader knows by another name: "Empty trash", "Revoke link". `Delete` by default, `Confirm` when neutral.
  label?: string | undefined
  // The dialog's title: `Confirm Deletion` by default, the label when neutral.
  title?: string | undefined
  // The confirm button's text, and the one it shows while `onConfirm` is pending: `Delete` and `Deleting…` by default, the label when neutral.
  confirmLabel?: string | undefined
  pendingLabel?: string | undefined
  cancelLabel?: string | undefined
  // The icon trigger's size and look, `size` sizing the cancel button too when asking inline; the button trigger takes the tone's look.
  size?: 'xs' | 'sm' | 'md' | 'lg' | undefined
  variant?: 'solid' | 'ghost' | 'inline' | 'danger' | undefined
  // Goes on the trigger.
  class?: string | undefined
}>()

const danger = () => tone === 'danger'
const triggerLabel = () => label ?? (danger() ? 'Delete' : 'Confirm')
const dialogTitle = () => title ?? (danger() ? 'Confirm Deletion' : triggerLabel())
const confirmText = () => confirmLabel ?? (danger() ? 'Delete' : triggerLabel())
const pendingText = () => pendingLabel ?? (danger() ? 'Deleting…' : confirmText())
const look = () => danger() ? 'danger' : 'accent'

const open = signal(false)
const pending = signal(false)
// The trigger asking inline, hidden while armed, which takes the focus back once the pair goes; and the pair, which takes it back after a failed delete.
let opener: HTMLElement | undefined
let armed: HTMLElement | undefined

function start(event: MouseEvent) {
  opener = event.currentTarget as HTMLElement
  open.set(true)
}

function close() {
  open.set(false)

  if (ask === 'inline')
    queueMicrotask(() => opener?.focus())
}

async function confirm() {
  pending.set(true)

  const done = await attempt(async () => onConfirm(), { failure, success, refused })

  pending.set(false)

  if (done)
    close()
  else if (ask === 'inline')
    queueMicrotask(() => armed?.querySelector('button')?.focus())
}

function keyDown(event: KeyboardEvent) {
  if (event.key === 'Escape' && !pending()) {
    event.preventDefault()
    close()
  }
}
---
if trigger === 'button'
  Button(label={triggerLabel()} variant={look()} hidden={ask === 'inline' && open()} class={className} onClick={start})
else if trigger === 'link'
  button.kui-confirm-delete-link(type="button" hidden={ask === 'inline' && open()} class={className} onClick={start}) {triggerLabel()}
else
  IconButton(icon={danger() ? 'delete' : 'success'} label={triggerLabel()} size={size} variant={variant} hidden={ask === 'inline' && open()} class={className} onClick={start})
if ask === 'inline'
  if open()
    // Armed by a click, so the focus moves onto the button that deletes.
    span.kui-confirm-delete-armed(ref={element => { armed = element; queueMicrotask(() => element.querySelector('button')?.focus()) }} role="group" aria-label={message} onKeyDown={keyDown})
      Button(label={pending() ? pendingText() : confirmText()} variant={look()} busy={pending()} disabled={pending()} data-tooltip={message} onClick={confirm})
      IconButton(icon="close" label={cancelLabel} size={size} variant="ghost" disabled={pending()} onClick={close})
else
  Dialog(open={open()} title={dialogTitle()} dirty={pending()} onClose={() => open.set(false)})
    @footer
      Button(label={cancelLabel} disabled={pending()} onClick={() => open.set(false)})
      Button(label={pending() ? pendingText() : confirmText()} variant={look()} busy={pending()} disabled={pending()} onClick={confirm})
    p.kui-confirm-delete-message {message}
