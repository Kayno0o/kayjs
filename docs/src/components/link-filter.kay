---
import { memo, signal } from 'kay'

const { links, current, label } = props<{ links: { href: string, title: string }[], current: string, label: string }>()
const query = signal('')
const shown = memo(() => links.filter(link => link.title.toLowerCase().includes(query().trim().toLowerCase())))
---
input(type="search" aria-label={label} placeholder="Filter" bind:value={query})
ul
  for link of shown() key={link.href}
    li
      a(href={link.href} aria-current={link.href === current ? 'page' : undefined}) {link.title}
  else
    li.none Nothing matches
