---
import { effect, onCleanup, recipe, signal, trustHtml, untrack } from 'kay'
import { wording } from 'kay/words'

const PREVIEW_DELAY = 250

// The pane beside a MarkdownEditor's field, loaded the first time the preview is shown. It renders the text a pause after the last keystroke.
const look = recipe({ parts: { root: 'kui-markdown-preview', failed: 'kui-markdown-preview-failed', body: 'kui-markdown-preview-body' } })

const { text, render } = props<{
  text: string
  render: (markdown: string) => Promise<string>
}>()

const rendered = signal<string | undefined>(undefined)
const failed = signal(false)
// Counts the renders asked for, so a slow answer to an older text never lands over a newer one.
let asked = 0

effect(() => {
  const markdown = text
  const turn = ++asked
  const timer = setTimeout(async () => {
    try {
      const html = await render(markdown)

      if (turn === asked) {
        rendered.set(html)
        failed.set(false)
      }
    }
    catch (error) {
      console.error('kayjs-ui: a MarkdownEditor\'s preview failed', error)

      if (turn === asked)
        failed.set(true)
    }
  }, untrack(rendered) === undefined ? 0 : PREVIEW_DELAY)

  onCleanup(() => clearTimeout(timer))
})
---
div(part="root" role="region" aria-label={wording('ui.markdownEditor.previewLabel', 'Preview')} aria-busy={rendered() === undefined && !failed() ? 'true' : 'false'})
  if failed()
    p(part="failed") {wording('ui.markdownEditor.previewFailure', 'The preview could not be shown')}
  else
    div(part="body" innerHTML={trustHtml(rendered() ?? '')})
