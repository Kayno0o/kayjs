--- server
import { s } from 'kay'

export const contact = action(s.Object({
  name: s.String({ minLength: 2, maxLength: 100, error: 'Tell us your name' }),
  email: s.String({ format: 'email', maxLength: 254, error: 'Not an email address' }),
  topic: s.UnionEnum(['quote', 'other']),
  message: s.String({ minLength: 5, maxLength: 2000, error: 'A few words at least' }),
}), async () => undefined, { honeypot: 'website', minTime: '3s' })
---
---
import ContactForm from '@kaynooo/kayjs-ui/contact-form.kay'
import FormField from '@kaynooo/kayjs-ui/form-field.kay'
---
main
  ContactForm(action={contact} submitLabel="Send it")
    FormField(label="Topic" issue={contact.error('topic')})
      select(name="topic")
        option(value="quote") Quote
        option(value="other") Other
