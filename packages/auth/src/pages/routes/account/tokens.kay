--- server
import { formatDate } from 'kay/i18n'
import { wording } from 'kay/words'
import Message from '../../components/message.kay'
import Proof from '../../components/proof.kay'
import { failure, proofOf, schemas, scopeLabel } from '../../forms'
import Badge from '@kaynooo/kayjs-ui/badge.kay'
import Button from '@kaynooo/kayjs-ui/button.kay'
import CardRow from '@kaynooo/kayjs-ui/card-row.kay'
import CopyButton from '@kaynooo/kayjs-ui/copy-button.kay'
import EmptyState from '@kaynooo/kayjs-ui/empty-state.kay'
import FormField from '@kaynooo/kayjs-ui/form-field.kay'
import PageSection from '@kaynooo/kayjs-ui/page-section.kay'

const EXPIRIES = [30, 90, 365]

// Left out is the default, 0 is the form's "Never".
const expiry = (days: number | undefined) => days === undefined ? undefined : days === 0 ? null : `${days}d` as const

// The plain token comes back once, for the page to show it this one time.
export const create = action(schemas.createToken, async (input, ctx) => {
  // The app's scopes are its own type, which this page cannot name: createToken refuses any it does not declare.
  const result = await ctx.locals.auth.createToken(proofOf(input), input.label, { scopes: input.scopes?.length ? input.scopes as never[] : undefined, maxAge: expiry(input.days) })

  return result.ok ? result.token : ctx.fail(400, { error: result.error })
})

export const revoke = action(schemas.id, async ({ id }, ctx) => {
  return (await ctx.locals.auth.revokeBearerToken(id)).ok ? 'revoked' : ctx.fail(404, { error: 'not-found' })
})

const auth = ctx.locals.auth
const user = await auth.requireUser()
const features = auth.features()
const tokens = await auth.listTokens()
const created = create.succeeded()?.data
const refused = create.failed()?.data?.error
const date = (value: Date) => formatDate(value, { dateStyle: 'medium' })
---
PageSection(title={wording('auth.account.tokens.title', 'Access tokens')})
  .flex.flex-col.gap-2
    p {wording('auth.account.tokens.intro', 'Tokens let scripts and other apps use your account through the API.')}
    if created
      Message(tone="success" text={wording('auth.account.tokens.created', 'Copy this token now: it will not be shown again.')})
      code#kauth-token.break-all {created}
      CopyButton(text={created} label={wording('auth.account.tokens.copy', 'Copy the token')})
    for token of tokens key={token.id}
      CardRow(data-token={token.id})
        @right
          form(action={revoke})
            input(type="hidden" name="id" value={token.id})
            Button(type="submit" tone="danger" label={wording('auth.account.tokens.revoke', 'Revoke')} aria-label={`${wording('auth.account.tokens.revoke', 'Revoke')}: ${token.label}`})
        .flex.flex-col
          span.flex.flex-wrap.items-center.gap-2
            strong {token.label}
            if token.expired
              Badge(label={wording('auth.account.tokens.expired', 'Expired')} tone="warning")
          span.text-kui-muted {token.scopes ? token.scopes.map(scopeLabel).join(', ') : wording('auth.account.tokens.allScopes', 'Everything')}
          span.text-kui-muted
            | {token.lastUsedAt ? wording('auth.account.tokens.lastUsed', 'Last used {date}', { date: date(token.lastUsedAt) }) : wording('auth.account.tokens.neverUsed', 'Never used')}
            if token.expiresAt && !token.expired
              | · {wording('auth.account.tokens.expires', 'Expires {date}', { date: date(token.expiresAt) })}
    else
      EmptyState(title={wording('auth.account.tokens.none', 'No token yet.')})
PageSection(title={wording('auth.account.tokens.create', 'Create a token')})
  form.flex.flex-col.gap-3(action={create})
    FormField(label={wording('auth.account.tokens.label', 'Name')} required)
      input(name="label" maxlength="100" required)
    if features.scopes.length > 0
      FormField(label={wording('auth.account.tokens.scopes', 'Allowed to')} group)
        for scope of features.scopes key={scope}
          label.flex.items-center.gap-2
            input(type="checkbox" name="scopes" value={scope})
            | {scopeLabel(scope)}
    FormField(label={wording('auth.account.tokens.expiresIn', 'Expires')})
      select(name="days")
        option(value="0") {wording('auth.account.tokens.never', 'Never')}
        for days of EXPIRIES key={days}
          option(value={String(days)} selected={days === 90}) {wording('auth.account.tokens.days', days === 1 ? 'In {count} day' : 'In {count} days', { count: days })}
    Proof(user={user})
    if refused
      Message(text={failure(refused)})
    Button(type="submit" tone="accent" label={wording('auth.account.tokens.create', 'Create a token')})
