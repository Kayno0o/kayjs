---
import type { Unclickable } from 'kay/edit'
import type { EntryRef } from '../kay/contract'
import type { SavedState } from './live'
import type { FieldPath } from '../markers'
import { BODY_ID } from '../layout'
import { fieldsOf } from '../fields'
import Button from '@kaynooo/kayjs-ui/button.kay'
import Notice from '@kaynooo/kayjs-ui/notice.kay'
import PageSection from '@kaynooo/kayjs-ui/page-section.kay'
import { call, flush, navigate, refresh, resource, untrack } from 'kay'
import { wording } from 'kay/words'
import editorApi from '../api/editor'
import entriesApi from '../api/entries'
import { collectionPath, collectionTitle, entryTitle, SINGLE_SLUG } from '../listing'
import { entryKey } from '../markers'
import { drafts } from './drafts'
import { fieldAtPath, registerInline } from './inline'
import { savedHandler } from './live'
import { readReferrers } from './referrers'
import { rebuildFinished, rebuildStarted } from './rebuild'
import { createReview } from './review'
import { unfoldAround } from './reorder'
import { anchorsOf, keyOfPath, ownerOf } from './anchors'
import { forgetPlace, placeCaret } from './caret'
import { registerSaver } from './save-all'
import EntryFields from './entry-fields.kay'
import { formScope } from '../form'
import EntryPresence from '../components/entry-presence.kay'
import EntrySaveState from '../components/entry-save-state.kay'
import EntryReview from '../components/entry-review.kay'
import EntryReviewLog from '../components/entry-review-log.kay'
import EntryState from '../components/entry-state.kay'
import ResetButton from '../components/reset-button.kay'
import { entryRoom } from '../room'
import { changeField, deleteSaved, saveDraft, showRefusal } from './save'
import { isShown } from './session'
import { saveShortcut } from './shortcut'

const { entry, focus, typing, unclickable = [] } = props<{ entry: EntryRef, focus?: FieldPath | undefined, typing?: FieldPath | undefined, unclickable?: Unclickable[] }>()

// Named by what the page cannot mark: a value it transforms or shows in an island, and the fields of a frozen object.
const named = (isFrozen: boolean) => unclickable.filter(field => (field.frozen === true) === isFrozen).map(field => field.path).join(', ')
const unmarked = memo(() => named(false))
const frozen = memo(() => named(true))

const source = resource(entriesApi, '/:collection/:slug', {
  params: { collection: entry.collection, slug: entry.slug },
  query: entry.locale === undefined ? {} : { locale: entry.locale },
})
// A single collection's entry is the collection: no slug under its title, its locale still shown. Until the collection is known its slug is taken for a single one's when it is `index`, the only slug a single entry has, so that slug never flashes.
const isSingle = () => { const loaded = source.value(); return loaded === undefined ? entry.slug === SINGLE_SLUG : loaded.collection.single === true }
const collectionName = () => collectionTitle({ name: entry.collection, title: source.value()?.collection.title })
const subtitle = memo(() => isSingle() ? entry.locale : entry.locale === undefined ? collectionName() : `${collectionName()} (${entry.locale})`)
// The page editor asks no author and is listed with no name. The server strips the names of the room it joins for an edit link's holder, who is only counted, and sends them to an editor the app's guard let in.
const room = entryRoom(entry.collection, entry, { name: '', page: true })
const saving = signal(false)
// Set once the entry is deleted, which locks its form until the page has moved on.
const removed = signal(false)
// The collection's screen, held once a delete could not take the editor there because the leave was declined.
const stranded = signal<string>()
let created = false
const lastSave = signal<SavedState>()
const onSaved = savedHandler(() => source.value()?.entry.url, saved => lastSave.set(saved), rebuildFinished)
onCleanup(onSaved.stop)
// A click on the page types in the entry's text fields there while this form stands.
onCleanup(registerInline(entryKey(entry), { collection: () => source.value()?.collection, failed: () => source.status() === 'failed', busy: () => saving() || removed() }))
// What the signed-in person's role may not do, which locks the fields it covers once the server has said.
const can = resource(editorApi, '/can')
// One scope for as long as the answer stands, so the fields render in the one the notices ask which fields are shown.
const scope = memo(() => {
  const answer = source.value()

  return answer && Object.defineProperty(formScope(drafts, entry, answer.collection), 'denied', { get: () => can.value()?.denied })
})
let box: HTMLElement | undefined
let nav: HTMLElement | undefined

effect(() => {
  const answer = source.value()

  // A file that does not parse opens empty, and saving writes the form over it.
  if (answer)
    drafts.open({ ...entry, data: answer.entry.data ?? {}, body: answer.entry.body }, answer.entry.version)
})

// The item of the form it is collapsed to, or all of it while none: a click on the page or an anchor collapses it, Show all fields or a refused save opens it again. A field keeps what was typed in it while hidden.
const current = signal<string>()
const anchors = memo(() => {
  const answer = source.value()

  return answer ? anchorsOf(fieldsOf(answer.collection.schema), answer.collection.body !== undefined, answer.collection.layout?.form) : []
})

// Collapses the form to the item holding the field of a path of the form, brings the field into view (the unfolding is untracked, or the effect would follow the list's data and folds) and puts the caret in it. A path no item holds, such as a field the layout hides, changes nothing.
function reveal(path: string): void {
  untrack(() => {
    const owner = ownerOf(anchors(), path)

    if (owner === undefined) {
      forgetPlace()

      return
    }

    if (!box)
      return

    current = owner
    // The item was hidden until now, which a focus asks to be shown.
    flush()

    // A group, such as a list item, has no control of its own: its first field stands for it.
    const selector = path === BODY_ID ? '[data-kcms-body]' : `[data-kcms-path="${CSS.escape(path)}"], [data-kcms-path^="${CSS.escape(`${path}.`)}"]`
    const field = box.querySelector(selector)

    if (field)
      unfoldAround(field)

    field?.scrollIntoView({ block: 'nearest' })
    const control = field?.querySelector<HTMLElement>('input, textarea, select')

    control?.focus()
    placeCaret(control, entry, path, path === BODY_ID || fieldAtPath(fieldsOf(source.value()!.collection.schema), drafts.entry(entry)?.data, path)?.kind === 'markdown')
  })
}

// The form is loaded once its entry has come, which the page's clicks wait for.
const loaded = memo(() => source.value() !== undefined)

// Typing in a field on the page collapses the form to it, which keeps the focus where it is.
effect(() => {
  const path = typing

  if (path !== undefined && loaded())
    untrack(() => current = ownerOf(anchors(), keyOfPath(path)) ?? current())
})

// A click on the page reveals its field, once the form has loaded.
effect(() => {
  const path = focus

  if (path !== undefined && loaded() && box)
    reveal(keyOfPath(path))
})

// A refused save opens the form again when a field it needs fixed is hidden, so the message and the field are in view.
function openForIssues(): void {
  const at = current()

  if (at === undefined)
    return

  const stray = [...drafts.issues(entry).map(issue => issue.body === true ? BODY_ID : issue.path), ...drafts.blocked(entry).map(({ path }) => path)].filter(path => path !== '')

  if (stray.some(path => ownerOf(anchors(), path) !== at))
    current = undefined
}

// Opens the form again, the focus going to the anchors as the button it was on goes.
function showAll(): void {
  current = undefined
  flush()
  nav?.querySelector<HTMLElement>('button')?.focus()
}

// A text that does not parse keeps Save and Reset enabled, so pressing Save says what to fix.
const unsaved = () => drafts.changed(entry) || drafts.blocked(entry).length > 0

// True once the draft is saved.
async function save(): Promise<boolean> {
  if (!unsaved() || saving())
    return false

  saving = true

  let saved = false

  try {
    // A single collection's seed is no entry yet: the first save writes it.
    saved = await saveDraft(drafts, entry, { create: source.value()?.seeded === true && !created, onSaved: (outcome) => {
      created = true
      onSaved(outcome)

      if (outcome.rebuilding)
        rebuildStarted()
    } })
  }
  finally {
    saving = false
  }

  // The fields are unlocked by now, so the focus can land in one.
  if (!saved) {
    openForIssues()
    await showRefusal(drafts, entry)
  }

  return saved
}

// Publish and Unpublish change the draft flag alone: with edits not saved they refuse, saving nothing, and a refused save puts the flag back.
const draftField = () => source.value()?.collection.draftField
const stages = createReview(entry, undefined, drafts)

effect(() => {
  const answer = source.value()

  if (answer)
    stages.review.set(answer.review)
})

const isDraft = () => { const field = draftField(); return field !== undefined && drafts.value(entry, field) === true }

async function setDraft(value: boolean): Promise<void> {
  const field = draftField()

  if (field === undefined || saving())
    return

  await changeField(drafts, entry, field, value, { dirty: unsaved(), save })
}

// The entries referring to this one, read when the delete confirmation opens.
const referrers = signal<string[]>([])
const title = () => { const answer = source.value(); return answer ? entryTitle(answer.collection, answer.entry) : entry.slug }

async function askReferrers(): Promise<void> {
  referrers.set([])

  const found = await readReferrers(entry.collection, [entry.slug])

  referrers.set(found[entry.slug] ?? [])
}

// The page the entry rendered is gone with it. When it was the entry's own page, there is nothing to read again: the editor leads to the collection's screen, replacing that page in the history. Any other page is read again.
async function remove(): Promise<void> {
  if (saving())
    return

  const url = source.value()?.entry.url
  // Known before the delete, so a screens' address that cannot be read stops it rather than leaving a page that no longer exists.
  const screen = url !== undefined && isShown(url) ? collectionPath(can.value()?.prefix ?? (await call(editorApi, '/can')).prefix, entry.collection) : undefined

  if (!await deleteSaved(entry, drafts.version(entry) ?? source.value()?.entry.version))
    return

  drafts.reset(entry)
  removed.set(true)

  if (screen === undefined) {
    await refresh()

    return
  }

  // Declined over edits of other entries: the form stays locked and the notice offers the way on.
  if (!await navigate(screen, { replace: true }))
    stranded.set(screen)
}

saveShortcut(save)
onCleanup(registerSaver(entry, { pending: () => unsaved() && !saving() && !removed(), save }))
---
PageSection.kcms-entry(title={isSingle() ? collectionName() : title()} level={3} subtitle={subtitle()} sticky aria-busy={saving()} ref={element => box = element})
  @actions
    .kcms-entry-actions
      EntrySaveState(changed={drafts.changed(entry)} saving={saving()} saved={lastSave()} url={source.value()?.entry.url})
      ResetButton(disabled={saving() || removed() || !unsaved()} onReset={() => drafts.reset(entry)})
      Button(label={saving() ? wording('cms.entry.saving', 'Saving…') : wording('cms.entry.save', 'Save')} tone="accent" busy={saving()} disabled={saving() || removed() || !unsaved()} onClick={save})
  // Under the head, which stays on one line on a phone.
  if source.value() as answer
    if draftField() !== undefined || (!isSingle() && !answer.seeded)
      .kcms-entry-more
        EntryState(draftField={draftField()} draft={isDraft()} dirty={unsaved()} saving={saving() || removed()} denied={can.value()?.denied} title={title()} url={answer.entry.url} referrers={referrers()} deletable={!isSingle() && !answer.seeded} onPublish={() => setDraft(false)} onUnpublish={() => setDraft(true)} onRemove={remove} onAskReferrers={askReferrers})
        if answer.collection.review && !answer.seeded
          EntryReview(review={stages.review()} draft={isDraft()} denied={can.value()?.denied} dirty={unsaved()} busy={saving() || removed() || stages.busy()} onSubmit={stages.submit} onApprove={stages.approve} onSendBack={stages.sendBack})
  EntryPresence(room={room.room} member={room.member})
  if stages.review() as stage
    EntryReviewLog(review={stage} draft={isDraft()})
  if stranded() as screen
    Notice.kcms-entry-failure(tone="danger" size="sm" label={wording('cms.entry.deleted', 'This entry is deleted.')})
      a(href={screen}) {wording('cms.entry.deletedLeave', 'Go to the collection')}
  else if source.status() === 'failed'
    Notice.kcms-entry-failure(tone="danger" size="sm" label={wording('cms.entry.loadFailure', 'Could not load this entry: {message}', { message: source.error()?.message ?? '' })})
  else if source.value() as answer
    if answer.entry.problem as problem
      Notice.kcms-entry-failure(tone="danger" size="sm" label={wording('cms.entry.problem', 'This entry\'s file does not parse: {problem}. Saving writes the form over it.', { problem })})
    if unmarked() !== ''
      Notice.kcms-entry-hint(size="sm" label={wording('cms.entry.unclickable', 'A click on the page cannot reach {fields}, which it shows changed or not at all: edit it here.', { fields: unmarked() })})
    if frozen() !== ''
      Notice.kcms-entry-hint(size="sm" label={wording('cms.entry.frozen', 'A click on the page cannot reach {fields}, held by a frozen object: edit it here.', { fields: frozen() })})
    if anchors().length > 1
      nav.kcms-entry-anchors(aria-label={wording('cms.entry.fields', 'Fields')} ref={element => nav = element})
        for anchor of anchors() key={anchor.key}
          Button(label={anchor.label} size="sm" variant="ghost" pressed={current() === undefined ? undefined : anchor.key === current()} onClick={() => reveal(anchor.key)})
        if current() !== undefined
          Button(label={wording('cms.entry.showAll', 'Show all fields')} variant="inline" onClick={showAll})
    fieldset.kcms-entry-fields(disabled={saving() || removed()})
      EntryFields(form={scope()!} only={current()})
  else
    p.kcms-entry-loading {wording('cms.entry.loading', 'Loading…')}
