{
  "name": "@kaynooo/kayjs-ui",
  "type": "module",
  "version": "1.78.0",
  "description": "Components for kay apps: dialogs, tables, toasts, forms and more, as .kay sources the app compiles as its own",
  "author": "Kaynooo <https://github.com/Kayno0o>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kayno0o/kayjs",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/Kayno0o/kayjs/issues"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/"
  },
  "sideEffects": false,
  "kay": {
    "settings": "./src/settings.ts",
    "messages": "./src/messages",
    "context": "./src/context.ts"
  },
  "exports": {
    "./*.kay": "./src/*.kay",
    "./lib/*": "./src/*.ts",
    "./theme.css": "./src/theme.css",
    "./skins/*.css": "./src/skins/*.css",
    "./extension": "./src/extension.ts",
    "./add": "./src/add.ts",
    "./announce": "./src/announce.ts",
    "./dnd": "./src/dnd.ts",
    "./field-look": "./src/field-look.ts",
    ".": "./src/index.ts"
  },
  "files": [
    "LICENSE",
    "README.md",
    "llms",
    "llms.txt",
    "src"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "prepare": "$npm_execpath ../../scripts/link-fixture.ts",
    "check": "$npm_execpath check",
    "prelint": "$npm_execpath run --cwd ../.. build:eslint",
    "lint": "$npm_execpath ../../scripts/lint-cache.ts && keslint --cache",
    "prelint:fix": "$npm_execpath run --cwd ../.. build:eslint",
    "lint:fix": "$npm_execpath ../../scripts/lint-cache.ts && keslint --fix --cache",
    "test": "$npm_execpath test --parallel=6 --timeout 20000 && $npm_execpath run test:dom",
    "test:dom": "$npm_execpath --config=tests-dom/bunfig.toml test --parallel=6"
  },
  "peerDependencies": {
    "@iconify-json/tabler": "^1.2.42",
    "chartist": "^1.5.0",
    "hls.js": "^1.7.0",
    "kay": "~1.78.0",
    "leaflet": "^1.9.4",
    "tailwindcss": "^4.3.3"
  },
  "peerDependenciesMeta": {
    "chartist": {
      "optional": true
    },
    "hls.js": {
      "optional": true
    },
    "leaflet": {
      "optional": true
    }
  },
  "dependencies": {
    "@kaynooo/utils": "^2.30.1"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@iconify-json/tabler": "^1.2.42",
    "@kaynooo/eslint": "^7.1.1",
    "@types/bun": "^1.4.4",
    "@types/leaflet": "^1.9.22",
    "chartist": "^1.5.0",
    "elysia": "^1.4.30",
    "hls.js": "^1.7.0",
    "leaflet": "^1.9.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
