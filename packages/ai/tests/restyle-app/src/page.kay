--- island
import type { Action, Failure } from 'kay'
import type { AiMessage, Progress } from '@kayjs/ai'
import Chat from '@kayjs/ai/chat.kay'
import Calls from '@kayjs/ai/chat-calls.kay'
import Sources from '@kayjs/ai/chat-sources.kay'
import Launcher from '@kayjs/ai/chat-launcher.kay'
import Panel from '@kayjs/ai/chat-panel.kay'

// Never called: the page is only rendered.
const reply = (() => undefined) as unknown as Action<{ messages: AiMessage[] }, AsyncIterable<string | Progress> | Failure<unknown>>

const calls = [{ id: 'a', name: 'search', status: 'done' as const, input: {}, result: 'ok' }]
---
//- Renders the chat `src/ui.ts` restyles, for the library's restyle test.
Chat(action={reply} initial={[{ role: 'user', content: 'Hello' }, { role: 'assistant', content: 'Hi there' }]} class={{ log: 'max-h-96' }})
Chat(action={reply} suggestions={['One']} layout="plain" tone="neutral" size="sm" class="rounded-lg")

// kay-allow deprecated-ui-props
Chat(action={reply} layout="bubble" variant="plain" class="both-names")

Chat(action={reply} label="Icons prop" icons={{ send: 'close' }})
Launcher(action={reply} layout="plain" tone="neutral" size="lg" class="mb-2")
Calls(calls={calls} labels={{}} details={true} runningLabel="Running" doneLabel="Done" failedLabel="Failed" argumentsLabel="Arguments" resultLabel="Result")
Sources(sources={[{ n: 1, title: 'Tides', href: '/tides' }]} label="Sources" here={true})
Panel(label="Ask" icon={() => undefined} closeIcon={() => undefined} newIcon={() => undefined} expandIcon={() => undefined} collapseIcon={() => undefined})
  p body
