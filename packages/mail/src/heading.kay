---
import type { JSX } from 'kay'
import type { Align, Tone } from './tone'
import settings from './settings'
import { alignStyle, textTone, withStyle } from './tone'

// `tone` and `align` set the colour and alignment of one use, `style` goes after the heading's own, and the other attributes land on the element.
const { level = 1, tone, align, style, ...rest } = props<Omit<JSX.IntrinsicElements['h1'], 'class' | 'children' | 'align' | 'style'> & { level?: 1 | 2 | 3 | undefined, tone?: Tone | undefined, align?: Align | undefined, style?: string | undefined }>()
const look = textTone(settings, tone, 'text')
const tail = (own: string) => withStyle(`${own};color:${look.color}${alignStyle(align)}`, style)
---
match level
  when 2
    h2(class={look.className} {...rest} style={tail('font-size:18px;line-height:1.35;margin:24px 0 12px')})
      slot
  when 3
    h3(class={look.className} {...rest} style={tail('font-size:16px;line-height:1.4;margin:20px 0 8px')})
      slot
  else
    h1(class={look.className} {...rest} style={tail('font-size:22px;line-height:1.3;margin:0 0 20px')})
      slot
