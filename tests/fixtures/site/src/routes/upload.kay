--- server
import { t } from 'elysia'
import { action } from 'kay'
import { uploads } from '../data'

export const upload = action(t.Object({
  note: t.String({ maxLength: 200 }),
  file: t.File({ type: 'image/png', error: 'Upload a PNG image' }),
  attachment: t.Optional(t.File()),
  extra: t.Optional(t.Object({ copies: t.Number(), files: t.Files() })),
}), async ({ note, file, attachment, extra }) => {
  const text = `${note}: ${file.size} bytes (${file.name})${attachment ? `, attached ${attachment.name}` : ''}${extra ? `, ${extra.copies} copies of ${extra.files.length} more` : ''}`

  uploads.push(text)

  return text
})

const last = uploads.at(-1)
const failure = ctx.failed(upload)
---
form(action={upload})
  input(name="note" aria-label="Note" value={failure?.values.note})
  input(type="file" name="file" aria-label="File")
  input(type="file" name="attachment" aria-label="Attachment")
  if failure?.errors.file as message
    p.error {message}
  button Upload
if last as text
  p.received {text}
