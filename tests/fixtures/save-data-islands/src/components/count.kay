---
import { onMount, signal } from 'kay'

const { name } = props<{ name: string }>()
// Set as the island hydrates, which the server's markup never has.
const ready = signal('no')

onMount(() => ready = 'yes')
---
button.count(data-name={name} data-ready={ready()} onClick={() => ready = 'clicked'}) {name}
