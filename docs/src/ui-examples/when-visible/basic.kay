---
import WhenVisible from '@kaynooo/kayjs-ui/when-visible.kay'

const rows = signal(Array.from({ length: 15 }, (_, index) => index + 1))
const more = () =>
  rows.set(current => [
    ...current,
    ...Array.from({ length: 15 }, (_, index) => current.length + index + 1),
  ])
---
.h-48.overflow-y-auto.rounded-lg.border.border-kui-surface2
  for row of rows() key={row}
    p.px-3.py-1 Row {row}
  if rows().length < 60
    WhenVisible(onVisible={more})
