--- <Value extends string>
import type { JSX } from 'kay'
import type { MultiSelectOption } from './multi-select'
import type { PopoverPlacement } from './popover'
import { effect, signal } from 'kay'
import { stepIndex } from './cycle'
import { onFormDefaults, onFormReset, startRef } from './form-reset'
import Icon from './icon.kay'
import { pickedLabels, pickedShown, selectionSummary, toggledValue } from './multi-select'
import Popover from './popover.kay'

// Past this many options the panel opens on a search box.
const SEARCH_FROM = 8

// The keys that move focus through the options once one has it.
const MOVES: Partial<Record<string, (index: number, count: number) => number>> = {
  ArrowDown: (index, count) => stepIndex(index, 1, count),
  ArrowUp: (index, count) => stepIndex(index, -1, count),
  Home: () => 0,
  End: (_, count) => count - 1,
}

const { id, options, value = [], label, placeholder = 'Any', searchLabel = 'Search', allLabel = 'All', noneLabel = 'None', emptyLabel = 'No match', selectedLabel, name, search, disabled = false, placement = 'bottom-start', onChange, class: className, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'id' | 'class' | 'children' | 'onChange'> & {
  // The panel's id, unique on the page; one is drawn when none is given.
  id?: string | undefined
  options: readonly MultiSelectOption<Value>[]
  // The values picked to start with; a control whose parent passes others follows them.
  value?: readonly Value[] | undefined
  // Names the control for screen readers.
  label: string
  // What the trigger reads while nothing is picked.
  placeholder?: string | undefined
  // The search box's placeholder, and with `label` after it, its name for screen readers.
  searchLabel?: string | undefined
  // The buttons picking every option shown and none of them, and what a search matching none says.
  allLabel?: string | undefined
  noneLabel?: string | undefined
  emptyLabel?: string | undefined
  // What the trigger reads once several are picked, `3 selected` by default.
  selectedLabel?: ((count: number) => string) | undefined
  // Submits each picked value under this name, for a control inside a form.
  name?: string | undefined
  // Opens on a search box; on by default past eight options.
  search?: boolean | undefined
  disabled?: boolean | undefined
  placement?: PopoverPlacement | undefined
  onChange?: ((value: Value[]) => void) | undefined
  class?: string | undefined
}>()

const picked = signal<readonly Value[]>(value)
const query = signal('')
let root: HTMLElement | undefined
// What a reset goes back to: the values it started with, or the ones last saved by a SaveForm.
let initial: readonly Value[] = value

effect(() => picked.set(value))

const searchable = () => search ?? options.length > SEARCH_FROM
const summary = () => selectionSummary(options, picked(), placeholder, selectedLabel)

const shown = () => {
  const needle = query().trim().toLowerCase()

  return needle ? options.filter(option => option.label.toLowerCase().includes(needle)) : options
}

function set(next: Value[]) {
  picked.set(next)
  onChange?.(next)
}

// A reset puts the boxes back on their defaults, which are not the picked values; the control goes back to `initial` with an empty search and tells the app.
onFormReset(() => root, () => {
  const same = initial.length === picked().length && initial.every(one => picked().includes(one))

  query.set('')

  if (!same)
    set([...initial])

  for (const [index, box] of [...root?.querySelectorAll<HTMLInputElement>('.kui-multi-select-checkbox') ?? []].entries()) {
    const option = shown()[index]

    box.checked = option !== undefined && picked().includes(option.value)
  }
})

const ref = startRef<HTMLElement>(element => root = element, rest.ref)

onFormDefaults(() => root, () => {
  const held = picked()

  return () => {
    initial = held
  }
})

// The panel only shows once the browser has opened the popover, so focus moves on its toggle rather than on the click; closing clears the search.
function toggled(open: boolean) {
  if (open)
    root?.querySelector<HTMLInputElement>('.kui-multi-select-search, .kui-multi-select-checkbox')?.focus()
  else
    query.set('')
}

// From the search box or the bar, ArrowDown reaches the first option; there the arrows, Home and End move between options, which Tab would walk one by one.
function keyDown(event: KeyboardEvent) {
  const boxes = [...root?.querySelectorAll<HTMLInputElement>('.kui-multi-select-checkbox') ?? []]
  const index = boxes.indexOf(event.target as HTMLInputElement)
  let move = MOVES[event.key]

  if (index === -1)
    move = event.key === 'ArrowDown' ? () => 0 : undefined

  if (!move || boxes.length === 0)
    return

  event.preventDefault()
  boxes[move(index, boxes.length)]?.focus()
}

// Tab past the last control closes the panel rather than leaving it open over the page; focus going nowhere, as on a click on the panel's padding, keeps it.
function focusLeft(event: FocusEvent) {
  const panel = event.currentTarget as HTMLElement
  const next = event.relatedTarget as Node | null

  if (next && !panel.contains(next) && panel.matches(':popover-open'))
    panel.hidePopover()
}
---
.kui-multi-select({...rest} ref={ref} class={className})
  Popover(id={id} placement={placement} class="kui-multi-select-panel" role="group" aria-label={label} onToggle={toggled} onKeyDown={keyDown} onFocusOut={focusLeft})
    @trigger(attributes)
      // Named by its label and what is picked, which a name of the label alone would hide; a count is described by the labels it stands for.
      button.kui-field-input.kui-multi-select-trigger({...attributes} type="button" aria-label={`${label}: ${summary()}`} aria-description={picked().length > 1 ? pickedLabels(options, picked()).join(', ') : undefined} disabled={disabled} data-empty={picked().length === 0 || undefined})
        span.kui-multi-select-summary {summary()}
        Icon(icon="chevron" class="kui-multi-select-chevron")
    if searchable()
      input.kui-field-input.kui-multi-select-search(type="search" data-kui-search placeholder={searchLabel} aria-label={`${searchLabel} ${label}`} value={query()} onInput={event => query.set(event.currentTarget.value)})
    .kui-multi-select-bar
      // Under a search, All and None pick and drop only the options it shows.
      button.kui-multi-select-action(type="button" disabled={shown().every(option => picked().includes(option.value))} onClick={() => set(pickedShown(options, picked(), shown(), true))}) {allLabel}
      button.kui-multi-select-action(type="button" disabled={!shown().some(option => picked().includes(option.value))} onClick={() => set(pickedShown(options, picked(), shown(), false))}) {noneLabel}
    .kui-multi-select-options
      for option of shown() key={option.value}
        label.kui-multi-select-option
          input.kui-multi-select-checkbox(type="checkbox" checked={picked().includes(option.value)} onChange={() => set(toggledValue(options, picked(), option.value))})
          span.kui-multi-select-label {option.label}
    // Read out as a search empties the list, which otherwise changes in silence.
    p.kui-multi-select-empty(role="status") {shown().length === 0 ? emptyLabel : ''}
  if name
    for entry of picked() key={entry}
      input(type="hidden" name={name} value={entry} disabled={disabled})
