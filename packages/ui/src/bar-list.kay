--- <Row extends BarListRow>
import type { JSX } from 'kay'
import type { BarListRow } from './plot'

const { rows, onSelect, empty = 'No data yet.', class: className, ...rest } = props<Omit<JSX.IntrinsicElements['ul'], 'class' | 'children' | 'onSelect'> & {
  rows: Row[]
  // Makes every row a button handing back the row it was pressed on.
  onSelect?: (row: Row) => void
  // What the list reads with no rows.
  empty?: string
  class?: string
}>()

// Each bar's length against the largest value, so the largest row fills its track.
const percent = (row: Row) => {
  const largest = Math.max(0, ...rows.map(item => item.value))

  return largest > 0 ? Math.max(0, row.value) / largest * 100 : 0
}
---
if rows.length === 0
  p.bar-list-empty {empty}
else
  ul.bar-list({...rest} class={className})
    for row of rows key={row.key}
      li
        if onSelect
          button.bar-list-row(type="button" data-interactive onClick={() => onSelect?.(row)})
            span.bar-list-label {row.label}
            span.bar-list-value {row.display ?? row.value}
            span.bar-list-track
              span.bar-list-fill(style={`width: ${percent(row)}%`})
        else
          .bar-list-row
            span.bar-list-label {row.label}
            span.bar-list-value {row.display ?? row.value}
            span.bar-list-track
              span.bar-list-fill(style={`width: ${percent(row)}%`})
