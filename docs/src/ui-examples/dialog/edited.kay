---
import Button from '@kaynooo/kayjs-ui/button.kay'
import Dialog from '@kaynooo/kayjs-ui/dialog.kay'

const open = signal(false)
---
Button(label="New note" onClick={() => open.set(true)})
Dialog(open={open()} title="New note" onClose={() => open.set(false)})
  @footer
    Button(label="Discard" onClick={() => open.set(false)})
    Button(label="Save" variant="accent" onClick={() => open.set(false)})
  p.mb-2 Escape and a click outside close it, until you type something.
  textarea.kui-field-input(name="note" rows="3" aria-label="Note")
