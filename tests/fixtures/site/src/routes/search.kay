--- server
import { t } from 'elysia'

export const page = {
  query: t.Object({
    q: t.String({ minLength: 1, error: 'Type something to search' }),
    page: t.Optional(t.Integer({ minimum: 1 })),
    tags: t.Array(t.String()),
    exact: t.Boolean(),
  }),
}

const { q, page: number = 1, tags, exact } = ctx.query
---
h1 Results for {q}
p.types {typeof number} {typeof exact}
p.values {number} {tags.join(',')} {String(exact)}
