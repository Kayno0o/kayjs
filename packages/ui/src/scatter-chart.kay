--- <Point extends ScatterPoint>
import type { JSX } from 'kay'
import type { ScatterAxis, ScatterPoint } from './plot'
import { memo, recipe, signal } from 'kay'
import { axisExtent, axisPercent, dotSize, steppedPoint } from './plot'
import { wording } from 'kay/words'

const look = recipe({
  parts: {
    root: 'kui-scatter-chart m-0 grid grid-cols-[auto_minmax(0,1fr)] grid-rows-[minmax(0,1fr)_auto] gap-2',
    axisLabel: 'text-center text-kui-2xs text-kui-subtext0 data-[axis=x]:col-start-2 data-[axis=y]:row-start-1 data-[axis=y]:rotate-180 data-[axis=y]:self-center data-[axis=y]:[writing-mode:vertical-rl]',
    // Tick labels hang outside the plot, into the margin it keeps for them.
    plot: 'relative col-start-2 mb-5 ml-8 h-[var(--chart-height,var(--kui-scatter-chart-height,18rem))] border-solid border-(length:--kui-border-width) border-kui-surface2',
    grid: 'absolute bg-kui-surface2 data-[axis=x]:inset-y-0 data-[axis=x]:w-px data-[axis=y]:inset-x-0 data-[axis=y]:h-px',
    tick: 'absolute text-kui-2xs whitespace-nowrap text-kui-overlay1 tabular-nums data-[axis=x]:top-full data-[axis=x]:mt-1 data-[axis=x]:-translate-x-1/2 data-[axis=y]:right-full data-[axis=y]:mr-2 data-[axis=y]:-translate-y-1/2',
    guide: 'absolute bg-kui-overlay0 data-[axis=x]:inset-y-0 data-[axis=x]:w-px data-[axis=y]:inset-x-0 data-[axis=y]:h-px',
    corner: 'pointer-events-none absolute text-kui-2xs text-kui-overlay1 data-[corner=bottomLeft]:bottom-1.5 data-[corner=bottomLeft]:left-2 data-[corner=bottomRight]:right-2 data-[corner=bottomRight]:bottom-1.5 data-[corner=topLeft]:top-1.5 data-[corner=topLeft]:left-2 data-[corner=topRight]:top-1.5 data-[corner=topRight]:right-2',
    dot: 'absolute h-(--kui-dot-size) w-(--kui-dot-size) -translate-x-1/2 translate-y-1/2 rounded-full bg-kui-accent opacity-70 transition-opacity hover:z-10 hover:opacity-100 data-interactive:cursor-pointer data-interactive:focus-visible:opacity-100 data-interactive:focus-visible:outline-2 data-interactive:focus-visible:outline-kui-text',
  },
})

const { points, x = {}, y = {}, quadrant, corners, onSelect, emptyLabel, label, ...rest } = props<Omit<JSX.IntrinsicElements['figure'], 'class' | 'children' | 'onSelect'> & {
  points: Point[]
  x?: ScatterAxis | undefined
  y?: ScatterAxis | undefined
  // Guides through this point, splitting the plot into four regions that `corners` name.
  quadrant?: { x: number, y: number } | undefined
  corners?: { topLeft?: string, topRight?: string, bottomLeft?: string, bottomRight?: string } | undefined
  // Makes every dot a button handing back its point.
  onSelect?: ((point: Point) => unknown) | undefined
  // What the chart reads with no points.
  emptyLabel?: string | undefined
  // Describes the chart for screen readers.
  label: string
}>()

const xExtent = memo(() => axisExtent(points.map(point => point.x), x))
const yExtent = memo(() => axisExtent(points.map(point => point.y), y))
const heaviest = memo(() => Math.max(...points.map(point => point.weight ?? 1)))

// Where a dot sits and how large it is, its area following its weight against the heaviest point.
const place = (point: Point) => `left: ${axisPercent(point.x, xExtent(), x.scale)}%; bottom: ${axisPercent(point.y, yExtent(), y.scale)}%; --kui-dot-size: ${dotSize(point.weight ?? 1, heaviest())}rem`

// The dot the keyboard stands at when the dots are not buttons, one tab stop in all: the first until it moves.
const stop = signal(0)
const current = () => Math.min(stop(), Math.max(0, points.length - 1))

// The arrows walk the dots in the order of `points`, and Home and End reach either end.
function keyDown(event: KeyboardEvent) {
  if (event.altKey || event.ctrlKey || event.metaKey)
    return

  const next = steppedPoint(event.key, current(), points.length)

  if (next === undefined)
    return

  event.preventDefault()
  stop.set(next)

  const target = (event.currentTarget as HTMLElement).parentElement?.querySelectorAll<HTMLElement>('[role="img"]')[next]

  target?.focus()
}

const cornerEntries = () => Object.entries(corners ?? {}).filter(([, text]) => text)
---
if points.length === 0
  // The app's id and class stay on whichever element shows.
  p.kui-scatter-chart-empty.text-xs.text-kui-subtext0(part="root" id={rest.id}) {emptyLabel ?? wording('ui.scatterChart.empty', 'No data yet.')}
else
  figure(part="root" {...rest} aria-label={label})
    if y.label
      span(part="axisLabel" data-axis="y") {y.label}
    div(part="plot")
      for tick of y.ticks ?? [] key={tick.value}
        span(part="grid" data-axis="y" style={`bottom: ${axisPercent(tick.value, yExtent(), y.scale)}%`})
          span(part="tick" data-axis="y") {tick.label}
      for tick of x.ticks ?? [] key={tick.value}
        span(part="grid" data-axis="x" style={`left: ${axisPercent(tick.value, xExtent(), x.scale)}%`})
          span(part="tick" data-axis="x") {tick.label}
      if quadrant
        span(part="guide" data-axis="y" style={`bottom: ${axisPercent(quadrant.y, yExtent(), y.scale)}%`})
        span(part="guide" data-axis="x" style={`left: ${axisPercent(quadrant.x, xExtent(), x.scale)}%`})
      for entry of cornerEntries() key={entry[0]}
        span(part="corner" data-corner={entry[0]}) {entry[1]}
      for point, at of points key={point.key}
        if onSelect
          button(part="dot" type="button" data-interactive aria-label={point.label} data-tooltip={point.tooltip ?? point.label} style={place(point)} onClick={() => onSelect?.(point)})
        else
          span(part="dot" role="img" tabindex={at === current() ? '0' : '-1'} aria-label={point.label} data-tooltip={point.tooltip ?? point.label} style={place(point)} onKeyDown={keyDown} onFocus={() => stop.set(at)})
    if x.label
      span(part="axisLabel" data-axis="x") {x.label}
