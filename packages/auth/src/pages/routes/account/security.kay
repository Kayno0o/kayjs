--- server
import { formatDate } from 'kay/i18n'
import { wording } from 'kay/words'
import Message from '../../components/message.kay'
import PasskeyAdd from '../../components/passkey-add.kay'
import Proof from '../../components/proof.kay'
import RecoveryCodes from '../../components/recovery-codes.kay'
import { failure, issue, proofOf, schemas } from '../../forms'
import Badge from '@kaynooo/kayjs-ui/badge.kay'
import Button from '@kaynooo/kayjs-ui/button.kay'
import CardRow from '@kaynooo/kayjs-ui/card-row.kay'
import EmptyState from '@kaynooo/kayjs-ui/empty-state.kay'
import FormField from '@kaynooo/kayjs-ui/form-field.kay'
import PageSection from '@kaynooo/kayjs-ui/page-section.kay'
import QrCode from '@kaynooo/kayjs-ui/qr-code.kay'

export const changePassword = action(schemas.changePassword, async (input, ctx) => {
  const result = await ctx.locals.auth.changePassword(proofOf(input), input.newPassword)

  if (!result.ok)
    return ctx.fail(400, 'errors' in result ? { password: result.errors.password } : { error: result.error })

  return 'saved'
})

// Only the URI comes back: the page draws its QR code and reads the key off it.
export const setUp = action(schemas.proof, async (input, ctx) => {
  const result = await ctx.locals.auth.setUpTwoFactor(proofOf(input))

  return result.ok ? result.setup.uri : ctx.fail(400, { error: result.error })
})

// Posts the URI back with the code, so a wrong code shows the same QR code again.
export const enable = action(schemas.enableTwoFactor, async ({ code }, ctx) => {
  const result = await ctx.locals.auth.enableTwoFactor(code)

  return result.ok ? result.recoveryCodes : ctx.fail(400, { error: result.error === 'invalid' ? 'code' : result.error })
})

export const regenerate = action(schemas.proof, async (input, ctx) => {
  const result = await ctx.locals.auth.regenerateRecoveryCodes(proofOf(input))

  return result.ok ? result.recoveryCodes : ctx.fail(400, { error: result.error })
})

export const disable = action(schemas.proof, async (input, ctx) => {
  const result = await ctx.locals.auth.disableTwoFactor(proofOf(input))

  return result.ok ? 'disabled' : ctx.fail(400, { error: result.error })
})

export const passkeyOptions = action(schemas.proof, async (input, ctx) => {
  const result = await ctx.locals.auth.passkeyRegistrationOptions(proofOf(input))

  return result.ok ? result.options : ctx.fail(400, { error: result.error })
})

export const addPasskey = action(schemas.registerPasskey, async (input, ctx) => {
  const result = await ctx.locals.auth.registerPasskey(input.response, input.name)

  return result.ok ? result.passkey.id : ctx.fail(400, { error: result.error })
})

export const renamePasskey = action(schemas.renamePasskey, async ({ id, name }, ctx) => {
  return await ctx.locals.auth.renamePasskey(id, name) ? name : ctx.fail(404, { error: 'not-found' })
})

export const removePasskey = action(schemas.removePasskey, async (input, ctx) => {
  const result = await ctx.locals.auth.revokePasskey(input.id, proofOf(input))

  return result.ok ? 'removed' : ctx.fail(400, { error: result.error, id: input.id })
})

const auth = ctx.locals.auth
const user = await auth.requireUser()
const features = auth.features()
const passwordSaved = changePassword.succeeded() !== undefined
const passwordRefused = changePassword.failed()?.data
const setupUri = setUp.succeeded()?.data ?? enable.failed()?.values.uri
const setupKey = setupUri && new URL(setupUri).searchParams.get('secret')
const twoFactorError = setUp.failed()?.data?.error ?? enable.failed()?.data?.error ?? regenerate.failed()?.data?.error ?? disable.failed()?.data?.error
const recoveryCodes = enable.succeeded()?.data ?? regenerate.succeeded()?.data
const codesLeft = user.twoFactor ? await auth.recoveryCodesLeft() : 0
const passkeys = features.passkeys ? await auth.listPasskeys() : []
const removeRefused = removePasskey.failed()?.data
const passkeyErrors = Object.fromEntries((['proof', 'stale', 'limited', 'impersonating', 'expired', 'invalid', 'signed-out'] as const).map(code => [code, failure(code)]))
---
PageSection(title={wording('auth.account.password.title', 'Password')})
  form.flex.flex-col.gap-3(action={changePassword})
    if !user.hasPassword
      p {wording('auth.account.password.none', 'You sign in without a password. Set one to sign in with your address too.')}
    Proof(user={user})
    FormField(label={wording('auth.newPassword', 'New password')} hint={wording('auth.passwordHint', 'At least {min} characters', { min: features.rules.password.min })} issue={passwordRefused && 'password' in passwordRefused ? issue('password', passwordRefused.password, features.rules) : undefined} required)
      input(name="newPassword" type="password" autocomplete="new-password" minlength={features.rules.password.min} required)
    if passwordSaved
      Message(tone="success" text={wording('auth.account.password.changed', 'Your password is saved. Your other sessions were signed out.')})
    if passwordRefused && 'error' in passwordRefused
      Message(text={failure(passwordRefused.error)})
    Button(type="submit" label={user.hasPassword ? wording('auth.account.password.change', 'Change the password') : wording('auth.account.password.set', 'Set a password')})
PageSection(title={wording('auth.account.twoFactor.title', 'Two-step verification')})
  @actions
    Badge(label={user.twoFactor ? wording('auth.account.twoFactor.on', 'On') : wording('auth.account.twoFactor.off', 'Off')} tone={user.twoFactor ? 'success' : 'neutral'})
  .flex.flex-col.gap-3
    if recoveryCodes
      RecoveryCodes(codes={recoveryCodes})
    if twoFactorError
      Message(text={failure(twoFactorError)})
    if user.twoFactor
      p#kayjs-auth-codes-left {wording('auth.account.twoFactor.codesLeft', codesLeft === 0 ? 'No recovery code left' : codesLeft === 1 ? '{count} recovery code left' : '{count} recovery codes left', { count: codesLeft })}
      form.flex.flex-col.gap-3(action={regenerate})
        Proof(user={user} secondFactor)
        Button(type="submit" label={wording('auth.account.twoFactor.regenerate', 'Make new recovery codes')})
      form.flex.flex-col.gap-3(action={disable})
        Proof(user={user} secondFactor)
        Button(type="submit" tone="danger" label={wording('auth.account.twoFactor.disable', 'Turn off')})
    else if setupUri
      p {wording('auth.account.twoFactor.scan', 'Scan this code with your authenticator app, or type the key, then type the code it shows.')}
      QrCode(value={setupUri} label={wording('auth.account.twoFactor.qr', 'QR code for your authenticator app')} size={192})
      if setupKey
        p
          | {wording('auth.account.twoFactor.key', 'Key')}: #[code#kayjs-auth-key {setupKey}]
      form.flex.flex-col.gap-3(action={enable})
        input(type="hidden" name="uri" value={setupUri})
        FormField(label={wording('auth.code', 'Code')} required)
          input(name="code" inputmode="numeric" autocomplete="one-time-code" required)
        Button(type="submit" tone="accent" label={wording('auth.account.twoFactor.enable', 'Turn on')})
    else
      form.flex.flex-col.gap-3(action={setUp})
        p {wording('auth.account.twoFactor.intro', 'Ask for a code from an authenticator app at each sign-in.')}
        Proof(user={user})
        Button(type="submit" tone="accent" label={wording('auth.account.twoFactor.setUp', 'Set up two-step verification')})
if features.passkeys
  PageSection(title={wording('auth.account.passkeys.title', 'Passkeys')})
    .flex.flex-col.gap-3
      p {wording('auth.account.passkeys.intro', 'Sign in with your fingerprint, face or device PIN instead of a password.')}
      for passkey of passkeys key={passkey.id}
        CardRow
          form.flex.flex-wrap.items-end.gap-2(action={renamePasskey})
            input(type="hidden" name="id" value={passkey.id})
            FormField(label={wording('auth.account.passkeys.name', 'Name')})
              input(name="name" value={passkey.name} required)
            Button(type="submit" label={wording('auth.account.passkeys.rename', 'Rename')} aria-label={`${wording('auth.account.passkeys.rename', 'Rename')}: ${passkey.name}`})
          p.text-kui-muted
            | {wording('auth.account.passkeys.created', 'Added {date}', { date: formatDate(passkey.createdAt, { dateStyle: 'medium' }) })}
          form.flex.flex-wrap.items-end.gap-2(action={removePasskey})
            input(type="hidden" name="id" value={passkey.id})
            Proof(user={user})
            if removeRefused?.id === passkey.id
              Message(text={failure(removeRefused.error)})
            Button(type="submit" tone="danger" label={wording('auth.account.passkeys.remove', 'Remove')} aria-label={`${wording('auth.account.passkeys.remove', 'Remove')}: ${passkey.name}`})
      else
        EmptyState(title={wording('auth.account.passkeys.none', 'No passkey yet.')})
      PasskeyAdd(user={{ hasPassword: user.hasPassword, twoFactor: user.twoFactor }} label={wording('auth.account.passkeys.add', 'Add a passkey')} nameLabel={wording('auth.account.passkeys.name', 'Name')} passwordLabel={wording('auth.proof.password', 'Current password')} codeLabel={wording('auth.proof.code', 'Code from your authenticator app')} unsupported={wording('auth.account.passkeys.unsupported', 'This browser cannot make passkeys.')} failed={wording('auth.account.passkeys.failed', 'The passkey was not added.')} errors={passkeyErrors})
