---
import type { JSX } from 'kay'
import { recipe } from 'kay'
import type { IconProps } from 'kay/icons'
import type { IconSlot } from './defaults'
import Icon from './icon.kay'

const look = recipe({ parts: { root: 'kui-icon-btn' } })

const { icon, label, size = 'md', variant = 'solid', tone = 'neutral', type = 'button', ...rest } = props<Omit<JSX.IntrinsicElements['button'], 'type' | 'class' | 'children'> & {
  icon: IconSlot | IconProps
  // Names the action for screen readers and, as its tooltip, for everyone else, since the button shows nothing but the icon.
  label: string
  size?: 'xs' | 'sm' | 'md' | 'lg' | undefined
  // The form: `solid` is the framed button, `ghost` has no frame until hovered and `inline` is the icon alone.
  variant?: 'solid' | 'ghost' | 'inline' | undefined
  // What the button means: `accent` for the main action, `danger` for a destructive one.
  tone?: 'neutral' | 'accent' | 'danger' | undefined
  type?: 'button' | 'submit' | 'reset' | undefined
}>()

// Only the solid form is framed by the shell's hairline.
const framed = () => variant === 'solid'
---
button({...rest} part="root" type={type} aria-label={label} data-tooltip={label} data-size={size} data-variant={variant} data-tone={tone} class={{ 'kui-shell': framed(), 'kui-shell-danger': framed() && tone === 'danger' }})
  Icon(icon={icon})
