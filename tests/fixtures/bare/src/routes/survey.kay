--- server
import { t } from 'elysia'
import { action } from 'kay'

// Each handler shows what it received in a header, which a plain form post carries back with its redirect.
export const answer = action(t.Object({
  tags: t.Array(t.String({ maxLength: 200 })),
  scores: t.Optional(t.Array(t.Number())),
  age: t.Optional(t.Number()),
  count: t.Integer(),
  agree: t.Boolean(),
  email: t.Optional(t.String({ maxLength: 200, format: 'email' })),
  note: t.Optional(t.String({ maxLength: 200 })),
}), (input, ctx) => {
  ctx.headers.set('x-answer', JSON.stringify(input))
})

export const gallery = action(t.Object({ photos: t.Files() }), ({ photos }) => photos.length)

export const nothing = action(t.Object({}), () => undefined)

// No schema: the action takes no input and its handler gets the context alone.
export const ping = action((ctx) => {
  ctx.headers.set('x-ping', ctx.request.method)

  return 'pong'
})

export const trap = action(() => 'passed', { honeypot: 'website' })

export const fails = action(t.Object({ status: t.Number() }), ({ status }, ctx) => ctx.fail(status, 'Refused'))

export const away = action(t.Object({ to: t.String({ maxLength: 200 }) }), ({ to }, ctx) => ctx.redirect(to))
---
p Survey
