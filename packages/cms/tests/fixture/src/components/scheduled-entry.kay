--- client
import type { ScreenCollection, StoredEntry } from '@kayjs/cms'
import EntryActions from '@kayjs/cms/entry-actions.kay'
import EntryField from '@kayjs/cms/entry-field.kay'
import { cmsEntryForm } from '@kayjs/cms/form'

// The date field and the badge of an entry screen, mounted with `mountComponent`.
const { collection, entry } = props<{ collection: ScreenCollection, entry: StoredEntry }>()

const form = cmsEntryForm({ prefix: '/admin', collection, entry })
---
EntryActions(form={form})
EntryField(form={form} name="at")
