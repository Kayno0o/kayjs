---
import { signal } from 'kay'
import Badge from '@kayjs/ui/badge.kay'
import Card from '@kayjs/ui/card.kay'
import Notice from '@kayjs/ui/notice.kay'

const open = signal(false)
---
button(onClick={() => open = !open()}) Toggle
if open()
  Card#island-card(class="border-danger" title="Moons")
    Badge(tone="success" label="New")
  Notice(tone="danger" label="Failed")
