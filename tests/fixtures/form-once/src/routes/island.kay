--- server
import { t } from 'elysia'
import { action } from 'kay'

export const rename = action(t.Object({
  title: t.String({ minLength: 3, maxLength: 40, error: 'Too short' }),
  done: t.Optional(t.Boolean()),
  note: t.Optional(t.String()),
}), (_input, ctx) => ctx.deny(409, { message: 'Taken' }))
--- script
import { signal } from 'kay'

const todo = { title: 'Walk dog', done: true, note: 'from the record' }
const shown = signal(false)
const record = signal({ title: 'Rex' })
---
button.show(type="button" onClick={() => shown = true}) Show
button.next(type="button" onClick={() => record = { title: 'Fido' }}) Next
form.island(action={rename} values={todo})
  input(field="title")
  input(field="done" type="checkbox")
  textarea.note(field="note") its own text
  if shown()
    input.late(field="title")
  button Save
form.live(action={rename} values={record()})
  input.live(field="title")
