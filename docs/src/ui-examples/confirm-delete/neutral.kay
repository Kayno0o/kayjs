---
import ConfirmDelete from '@kaynooo/kayjs-ui/confirm-delete.kay'

async function publish() {
  await new Promise(resolve => setTimeout(resolve, 600))
}
---
ConfirmDelete(
  tone="neutral"
  trigger="button"
  label="Publish"
  message="Publishing sends the post to every subscriber."
  failure="Could not publish"
  success="Published"
  onConfirm={publish}
)
