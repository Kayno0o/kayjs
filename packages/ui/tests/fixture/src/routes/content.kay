---
import Avatar from '@kaynooo/kayjs-ui/avatar.kay'
import Badge from '@kaynooo/kayjs-ui/badge.kay'
import Card from '@kaynooo/kayjs-ui/card.kay'
import Carousel from '@kaynooo/kayjs-ui/carousel.kay'
import EmptyState from '@kaynooo/kayjs-ui/empty-state.kay'
import FileDrop from '@kaynooo/kayjs-ui/file-drop.kay'
import FormField from '@kaynooo/kayjs-ui/form-field.kay'
import Notice from '@kaynooo/kayjs-ui/notice.kay'
import QrCode from '@kaynooo/kayjs-ui/qr-code.kay'
import Select from '@kaynooo/kayjs-ui/select.kay'
---
main
  Card#card(title="Moons")
    @head
      Badge(tone="success" icon="success" label={3})
    p Phobos and Deimos
  Card#bare(bare)
    p Edge to edge
  Card#outlined(title="Orbits" level={2})
    p Elliptic
  Card#page(title="<i>Sign in</i>" level={1})
    @head
      span 1
    p Welcome
  h2#after-page Details
  Card#untitled(level={1})
    p No title
  Badge#badge Draft
  Badge#solid(tone="success" variant="solid" label="<b>Done</b>")
  a.group#solid-stamp(href="/data")
    // kay-allow deprecated-ui-prop
    Badge(stamp solid label="Winner")
  // kay-allow deprecated-ui-prop
  Badge#legacy-stamp(stamp label="Old")
  // kay-allow deprecated-ui-prop
  Badge#legacy-solid(solid label="Old")
  // kay-allow deprecated-ui-prop
  Badge#variant-wins(variant="outline" stamp solid label="New")
  // kay-allow deprecated-ui-prop
  Notice#legacy-compact(compact label="Old")
  #legacy-field
    // kay-allow deprecated-ui-prop
    FormField(label="Old" compact)
  #legacy-drop
    // kay-allow deprecated-ui-prop
    FileDrop(compact onFiles={() => undefined})
      @content(_zone)
        span Drop
  // kay-allow deprecated-ui-prop
  Badge#solid-variant-stamp(variant="solid" stamp label="New")
  // kay-allow deprecated-ui-prop
  Notice#md-compact(size="md" compact label="Old")
  #md-field
    // kay-allow deprecated-ui-prop
    FormField(label="Old" size="md" compact)
  #md-drop
    // kay-allow deprecated-ui-prop
    FileDrop(size="md" compact onFiles={() => undefined})
      @content(_zone)
        span Drop
  // kay-allow deprecated-ui-prop
  QrCode#legacy-qr(value="https://kaynooo.fr" size={90})
  a.group#stamped(href="/data")
    Badge(variant="stamp" label="Winner")
  EmptyState#empty(title="No moons" description="Add one to start")
  EmptyState#empty-action(title="No rockets")
    @actions
      a.go(href="/paging") Build one
  article#notice
    Notice(label="Saved")
  article#notice-error
    Notice(tone="danger" size="sm")
      | Could not save. #[a(href="/data") Retry]
  article#avatar
    Avatar(src="/ada.png" name="Ada" size="sm")
  article#avatar-initial
    Avatar(name=" grace" label="Grace")
  form#form
    Select(name="planet" value="earth" emptyOption="Any" options={[{ value: 'mars', label: 'Mars' }, { value: 'earth', label: 'Earth' }]})
  article#carousel
    Carousel(slides={[{ src: '/a.png', alt: 'Le jardin' }, { src: '/b.png', alt: 'La maison' }]} index={1} ratio="4 / 3" label="Galerie photos" slideLabel="{n} sur {count}" dotLabel="Aller à l'image {n}")
  article#lone-slide
    Carousel(slides={[{ src: '/a.png', alt: 'Le jardin' }]})
