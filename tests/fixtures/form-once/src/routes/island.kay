--- server
import { t } from 'elysia'
import { action } from 'kay'

export const rename = action(t.Object({
  title: t.String({ minLength: 3, maxLength: 40, error: 'Too short' }),
  done: t.Optional(t.Boolean()),
}), (_input, ctx) => ctx.fail(409, 'Taken'))
--- script
import { signal } from 'kay'

const todo = { title: 'Walk dog', done: true }
const shown = signal(false)
---
button.show(type="button" onClick={() => shown = true}) Show
form.island(action={rename} values={todo})
  input(field="title")
  input(field="done" type="checkbox")
  if shown()
    input.late(field="title")
  button Save
