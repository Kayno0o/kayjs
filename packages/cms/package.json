{
  "name": "@kaynooo/kayjs-cms",
  "type": "module",
  "version": "1.71.0",
  "description": "A CMS for kay sites: collection screens, and content edited on the page it renders",
  "author": "Kaynooo <https://github.com/Kayno0o>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kayno0o/kayjs",
    "directory": "packages/cms"
  },
  "bugs": {
    "url": "https://github.com/Kayno0o/kayjs/issues"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./add": "./src/add.ts",
    "./admin.css": "./src/routes/admin.css",
    "./entry-actions.kay": "./src/components/entry-actions.kay",
    "./entry-body.kay": "./src/components/entry-body.kay",
    "./entry-editor.kay": "./src/components/entry-editor.kay",
    "./entry-field.kay": "./src/components/entry-field.kay",
    "./entry-fields.kay": "./src/editor/entry-fields.kay",
    "./entry-header.kay": "./src/components/entry-header.kay",
    "./entry-identity.kay": "./src/components/entry-identity.kay",
    "./entry-notices.kay": "./src/components/entry-notices.kay",
    "./entry-presence.kay": "./src/components/entry-presence.kay",
    "./entry-table.kay": "./src/components/entry-table.kay",
    "./entry-watch.kay": "./src/components/entry-watch.kay",
    "./field-input.kay": "./src/editor/field-input.kay",
    "./file-input.kay": "./src/editor/file-input.kay",
    "./form": "./src/form.ts",
    "./pg": "./src/loaders/pg.ts",
    "./postgres": "./src/loaders/postgres.ts",
    "./presence": "./src/presence.ts",
    "./room": "./src/room.ts",
    "./sqlite": "./src/loaders/sqlite.ts",
    "./test": "./src/test.ts"
  },
  "kay": {
    "settings": "./src/look.ts",
    "messages": "./src/messages"
  },
  "files": [
    "LICENSE",
    "README.md",
    "llms",
    "llms.txt",
    "src",
    "types"
  ],
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "prepare": "$npm_execpath ../../scripts/link-fixture.ts",
    "check": "$npm_execpath check",
    "build:types": "rm -rf types && $npm_execpath ../../src/tsgo.ts -p tsconfig.build.json",
    "prepack": "$npm_execpath run build:types",
    "postpack": "rm -rf types",
    "prelint": "$npm_execpath run --cwd ../.. build:eslint",
    "lint": "$npm_execpath ../../scripts/lint-cache.ts && keslint --cache",
    "prelint:fix": "$npm_execpath run --cwd ../.. build:eslint",
    "lint:fix": "$npm_execpath ../../scripts/lint-cache.ts && keslint --fix --cache",
    "test": "$npm_execpath test --isolate --timeout 20000 && $npm_execpath run test:dom",
    "test:dom": "$npm_execpath --config=tests-dom/bunfig.toml test"
  },
  "peerDependencies": {
    "@kaynooo/kayjs-ui": "workspace:~",
    "kay": "~1.71.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.3",
    "@kaynooo/eslint": "^7.0.4",
    "@kaynooo/kayjs-ui": "workspace:~",
    "@types/bun": "^1.4.3",
    "bun-plugin-tailwind": "^0.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
