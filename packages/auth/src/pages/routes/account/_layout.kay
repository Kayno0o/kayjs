--- server
import { localize } from 'kay/i18n'
import { wording } from 'kay/words'
import Button from '@kaynooo/kayjs-ui/button.kay'
import TabNav from '@kaynooo/kayjs-ui/tab-nav.kay'

const features = ctx.locals.auth.features()
const current = ctx.url.pathname
const home = localize(features.pages?.home ?? '/')
const base = localize(`${features.pages?.prefix ?? features.prefix}/account`)
const links = [
  { href: base, label: wording('auth.account.nav.profile', 'Profile') },
  { href: `${base}/security`, label: wording('auth.account.nav.security', 'Security') },
  { href: `${base}/sessions`, label: wording('auth.account.nav.sessions', 'Sessions') },
  ...features.providers.length > 0 ? [{ href: `${base}/connections`, label: wording('auth.account.nav.connections', 'Connections') }] : [],
  { href: `${base}/tokens`, label: wording('auth.account.nav.tokens', 'Tokens') },
  ...features.oauthServer ? [{ href: `${base}/clients`, label: wording('auth.account.nav.clients', 'Apps') }] : [],
  { href: `${base}/data`, label: wording('auth.account.nav.data', 'Your data') },
]
// The tab on screen names the page, so a tab switch or a page swap announces where the user landed.
const here = links.find(link => link.href.replace(/\/$/, '') === current.replace(/\/$/, ''))
const title = here ? `${here.label} - ${wording('auth.account.title', 'Your account')}` : wording('auth.account.title', 'Your account')
---
head
  title {title}
.kayjs-auth.mx-auto.flex.w-full.max-w-3xl.flex-col.gap-6.px-4.py-8
  .flex.flex-wrap.items-center.justify-between.gap-4
    h1.kui-heading-section {wording('auth.account.title', 'Your account')}
    form(method="post" action={`${features.prefix}/sign-out`})
      input(type="hidden" name="redirect" value={home})
      Button(type="submit" label={wording('auth.account.signOut', 'Sign out')})
  TabNav(links={links} current={current} label={wording('auth.account.nav.label', 'Account')})
  slot
