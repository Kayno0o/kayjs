---
import Table from '@kaynooo/kayjs-ui/table.kay'
import Button from '@kaynooo/kayjs-ui/button.kay'
import type { Column } from '@kaynooo/kayjs-ui'

interface Moon {
  id: number
  name: string
  radius: number
}

const moons: Moon[] = [
  { id: 1, name: 'Io', radius: 1822 },
  { id: 2, name: 'Europa', radius: 1561 },
  { id: 3, name: 'Amalthea', radius: 84 },
]

const columns: Column<Moon>[] = [
  { key: 'name', header: 'Name', sortValue: true },
  { key: 'radius', header: 'Radius (km)', numeric: true },
]

const hidden = signal<number[]>([])
---
Table(columns={columns} rows={moons.filter(moon => !hidden().includes(moon.id))} rowKey="id" selectable)
  @bulk(keys)
    Button(label="Hide" onClick={() => {
      hidden.set([...hidden(), ...keys as number[]])
    }})
