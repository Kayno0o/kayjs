--- <Value extends string | number | null, Held extends Value | null = Value>
import type { JSX, Snippet } from 'kay'
import type { IconProps } from 'kay/icons'
import type { IconSlot } from './defaults'
import { postedValue, recipe, uid, untrack, withQuery } from 'kay'
import type { NullOption } from './null-option'
import { controlledRadios } from './controlled-radios'
import { GROUP_INVALID, LABEL_TEXT } from './field-look'
import { sentOption } from './refill'
import { loadOptions } from './options-source'
import type { OptionsSource } from './options-source'
import { wording } from 'kay/words'
import { paramChange } from './param-change'
import { paramPick } from './param-value'
import Icon from './icon.kay'

// 'kui-segmented' stays as the component's name for an app's CSS and the skins; the border colour reads --_control-line, which a skin sets.
const look = recipe({
  parts: {
    root: `kui-segmented group/segmented inline-flex border-solid border-[length:var(--border-width)] bg-surface [border-color:var(--_control-line,var(--color-border))] data-[orientation=vertical]:flex-col ${GROUP_INVALID}`,
    option: 'relative cursor-pointer has-[input:disabled]:opacity-50 group-aria-busy/segmented:cursor-progress group-not-aria-busy/segmented:has-[input:disabled]:cursor-not-allowed',
    input: 'peer/option absolute size-0 opacity-0',
    label: 'flex items-center gap-1 px-3 py-1.5 text-xs text-muted transition-colors hover:text-foreground peer-checked/option:bg-accent peer-checked/option:text-accent-foreground peer-checked/option:hover:text-accent-foreground peer-focus-visible/option:outline-2 peer-focus-visible/option:-outline-offset-2 peer-focus-visible/option:outline-accent',
    icon: 'size-3.5 shrink-0',
    link: 'absolute inset-0 overflow-hidden text-transparent no-underline outline-none',
    field: 'inline-flex flex-col items-start gap-1',
    heading: LABEL_TEXT,
    retry: 'cursor-pointer self-center text-xs text-accent underline',
    status: 'self-center px-2 text-xs text-muted',
  },
})

const { options, value, label, showLabel = false, name, invalid, required, param, paramDefault, disabled = false, orientation = 'horizontal', loadingLabel = wording('ui.segmented.loading', 'Loading…'), retryLabel = wording('ui.segmented.retry', 'Try again'), failureLabel = wording('ui.segmented.failure', 'Could not load the options'), onLoad, onError, onChange, option: drawRow, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'children' | 'role' | 'onChange' | 'onLoad' | 'onError'> & {
  // `icon` sits before the label; `disabled` keeps that option from being picked.
  // A list, a promise of one, or a function answering it, such as an action: asked in the browser, the group busy under `loadingLabel` until the answer lands, or under `failureLabel` once it rejected.
  options: OptionsSource<{ value: Value, label: string, icon?: IconSlot | IconProps | undefined, disabled?: boolean | undefined }> & NullOption<Value, Held>
  loadingLabel?: string | undefined
  retryLabel?: string | undefined
  failureLabel?: string | undefined
  // Called with each answer of a function or promise `options`, and with what it rejected with.
  onLoad?: ((options: readonly { value: Value, label: string, icon?: IconSlot | IconProps | undefined, disabled?: boolean | undefined }[], query: string) => unknown) | undefined
  onError?: ((failure: { error: unknown, query: string }) => unknown) | undefined
  // The option picked to start with, or `null` for none, such as while what shows matches no option; a group whose parent passes another follows it. Left out, the first option that is not disabled when the group is drawn starts picked, which a form reset goes back to.
  value?: Held | undefined
  // Names the group for screen readers.
  label: string
  // Writes `label` above the group, in a Slider's label type, and names the group by it.
  showLabel?: boolean | undefined
  // Disables every option; an option's own `disabled` still applies when this is false.
  disabled?: boolean | undefined
  // Marks the group as refused, its keyline in the danger colour, with `aria-invalid` on the group. A FormField showing a message marks the radios on its own.
  invalid?: boolean | undefined
  // Requires one of the options be picked: `required` on the radios, which the browser's validation and a post with no JavaScript know, and `aria-required` on the group. A FormField with `required` around it does the same for its first radio.
  required?: boolean | undefined
  // The radios' name, which the group submits under inside a form; one unique on the page is drawn when none is given.
  name?: string | undefined
  // Holds a query param of the page instead of, or besides, `onChange`: a pick goes to the current page with `param` set to the option and every other param kept, the group busy until the page shows it, and each option also covers a link to that address, so a middle click, a new tab, a copy or a crawler finds it. Left without `value`, the group shows the option the address names, else `paramDefault`. The radios take its name, so a GET form around the group sends it without JavaScript.
  param?: string | undefined
  // The value the page shows while `param` is left out: picking it leaves the param out.
  paramDefault?: string | number | undefined
  // `vertical` stacks the options in a column; the arrow keys keep moving between the radios, up and down as well as left and right.
  orientation?: 'horizontal' | 'vertical' | undefined
  // A promise holds the group busy until it settles, and puts the previous option back when it resolves to false, rejects or throws (logged): a refused change never shows as made.
  // Typed `unknown`, so a callback answering something else, such as `list.push`, still fits.
  // Hears `null` as well, for a reset to none, only when `value` is typed nullable.
  // Gets the option picked as a second argument, `undefined` for a reset to none with no null option.
  onChange?: ((value: Value | (null extends Held ? null : never), option: { value: Value, label: string, icon?: IconSlot | IconProps | undefined, disabled?: boolean | undefined } | undefined) => unknown) | undefined
  // Draws each option in place of its label (and icon): `@option(option)`. The input stays named by the option's `label`, and keeps its checked and disabled state.
  option?: Snippet<[option: { value: Value, label: string, icon?: IconSlot | IconProps | undefined, disabled?: boolean | undefined }]> | undefined
}>()

// A group with no callback or param is plain: a refused post of its form, which the server renders it for, gives its choice back in place of its own.
const source = loadOptions<{ value: Value, label: string, icon?: IconSlot | IconProps | undefined, disabled?: boolean | undefined }>(() => options, { onLoad, onError, label: 'Segmented' })
const list = source.options
// The option a group without a `value` starts on: the first that is not disabled, once the options are there.
const first = () => list().find(option => !option.disabled)?.value ?? null
const sent = onChange || param !== undefined ? undefined : postedValue(name, value === undefined ? first() : value)

// The option the group starts on and follows: the app's `value`, else the one a param holds, else the first.
const start = () => value === undefined ? paramPick(list(), param, paramDefault) ?? first() : value

const { group, picked, busy, ref, pick } = controlledRadios({
  control: 'Segmented',
  input: '[data-part=input]',
  options: list,
  value: () => sentOption(sent, list(), start()),
  name: () => name ?? param,
  onChange: () => paramChange(param, paramDefault, onChange as ((value: string | number | null, option: unknown) => unknown) | undefined),
  appRef: rest.ref,
})

// The heading's id while `showLabel` writes it, which then names the group in place of `aria-label`.
// The address of an option while `param` holds the group: the current page with the param set, other params kept and the default left out. A page rendered once at build time has no query to start from, so its options carry no link.
function optionLink(value: Value): { href: string } | undefined {
  if (param === undefined)
    return undefined

  try {
    return { href: withQuery({ [param]: paramDefault !== undefined && String(value) === String(paramDefault) ? null : value }) }
  }
  catch {
    return undefined
  }
}

// A plain click keeps going through the radio, so a refusing `onChange` holds it; a modified or middle click is left to the browser.
function follow(event: MouseEvent, value: Value) {
  if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
    return

  event.preventDefault()

  if (value !== picked())
    void pick(value)
}

const heading = showLabel ? uid() : undefined
---
// Real radios, so the arrow keys move between options and the group submits like any other field.
snippet radios()
  div(part="root" {...rest} ref={ref} role="radiogroup" data-kui-choice="" aria-label={heading ? undefined : label} aria-labelledby={heading ?? rest['aria-labelledby']} aria-invalid={invalid ? 'true' : rest['aria-invalid']} aria-required={required ? 'true' : rest['aria-required']} aria-orientation={orientation === 'vertical' ? 'vertical' : undefined} data-orientation={orientation === 'vertical' ? 'vertical' : undefined} aria-busy={busy() || source.loading() ? 'true' : undefined})
    for option of list() key={option.value}
      label(part="option")
        input(part="input" ref={element => element.defaultChecked = untrack(() => option.value === sentOption(sent, list(), start()))} type="radio" name={group} required={required} value={option.value ?? ''} checked={picked() === option.value} disabled={disabled || option.disabled} aria-label={drawRow ? option.label : undefined} onChange={() => pick(option.value)})
        span(part="label")
          if drawRow
            | {drawRow(option)}
          else
            if option.icon
              Icon(icon={option.icon} part="icon")
            | {option.label}
          if param !== undefined && !disabled && !option.disabled
            a(part="link" {...optionLink(option.value)} tabindex="-1" aria-hidden="true" draggable="false" aria-current={picked() === option.value ? 'true' : undefined} onClick={event => follow(event, option.value)}) {option.label}
    if source.loading()
      p(part="status" role="status") {loadingLabel}
    if source.failed()
      p(part="status" role="alert") {failureLabel}
      if source.retryable()
        button(part="retry" type="button" onClick={source.retry}) {retryLabel}
if showLabel
  div(part="field")
    span(part="heading" id={heading}) {label}
    {radios()}
else
  {radios()}
