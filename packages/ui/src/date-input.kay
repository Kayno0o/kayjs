---
import type { FieldSize } from './field-look'
import type { JSX, Snippet } from 'kay'
import { effect, memo, onMount, postedValue, recipe, signal, untrack } from 'kay'
import { addDays, addMonths, clampDate, dayName, firstDayOf, isDate, monthTitle, monthWeeks, sameMonth, today, weekdays, weekEdge, withinBounds } from './date'
import { startRef } from './form-reset'
import Icon from './icon.kay'
import Popover from './popover.kay'
import TextInput from './text-input.kay'
import { pageLocale, wording } from 'kay/words'

// The browser's own picker button gives way to the calendar's once it is drawn, and a step's chevron turns by the step's direction.
const look = recipe({
  parts: {
    root: 'kui-date-input inline-flex min-w-0 items-center gap-1 [&:has([data-part=trigger])_[data-part=input]::-webkit-calendar-picker-indicator]:hidden',
    input: 'min-w-0 flex-1 tabular-nums',
    trigger: 'inline-flex shrink-0 cursor-pointer items-center justify-center rounded-md p-1 text-muted hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:cursor-default disabled:opacity-40',
    panel: 'w-64 p-2',
    head: 'mb-1 flex items-center justify-between gap-2',
    title: 'text-sm font-medium capitalize',
    step: 'group/step inline-flex size-7 cursor-pointer items-center justify-center rounded-md text-muted hover:bg-hover hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:cursor-default disabled:opacity-40 disabled:hover:bg-transparent',
    stepIcon: 'group-data-[direction=previous]/step:rotate-90 group-data-[direction=previous]/step:rtl:-rotate-90 group-data-[direction=next]/step:-rotate-90 group-data-[direction=next]/step:rtl:rotate-90',
    grid: 'w-full table-fixed border-collapse text-center text-sm',
    weekday: 'py-1 text-2xs font-normal text-muted [font-family:var(--font-label,inherit)] [text-transform:var(--label-case)]',
    day: 'h-8 w-full cursor-pointer rounded-md tabular-nums hover:bg-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:cursor-default disabled:opacity-30 disabled:hover:bg-transparent data-outside:text-muted aria-[current=date]:font-semibold aria-[current=date]:text-accent [[aria-selected=true]>&]:bg-accent [[aria-selected=true]>&]:text-accent-foreground [[aria-selected=true]>&]:hover:bg-accent [[aria-selected=true]>&]:aria-[current=date]:text-accent-foreground',
    today: 'mt-1 w-full cursor-pointer rounded-md py-1 text-center text-2xs tracking-label text-muted [font-family:var(--font-label,inherit)] [text-transform:var(--label-case)] hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:cursor-default disabled:opacity-40',
  },
})

const { value, min, max, firstDay, openLabel = wording('ui.dateInput.open', 'Choose a date'), previousLabel = wording('ui.dateInput.previous', 'Previous month'), nextLabel = wording('ui.dateInput.next', 'Next month'), todayLabel = wording('ui.dateInput.today', 'Today'), unavailableLabel = wording('ui.dateInput.unavailable', 'This date is not available'), isDisabled, day, open, onOpenChange, onMonthChange, onChange, ...rest } = props<Omit<JSX.IntrinsicElements['input'], 'size' | 'value' | 'type' | 'class' | 'children' | 'min' | 'max' | 'onInput' | 'onChange'> & {
  // The box's size: `md` by default, `sm` and `lg` change its padding and type.
  size?: FieldSize | undefined
  // Marks the control as refused, in the danger colour with `aria-invalid`. A FormField marks its control on its own while it shows a message.
  invalid?: boolean | undefined
  // The date as `YYYY-MM-DD`, or `''` for none. Without it, the box starts empty and keeps what is picked, for a form posting it by its `name`.
  value?: string | undefined
  // The earliest and latest date allowed, as `YYYY-MM-DD`; the calendar greys out the days outside them.
  min?: string | undefined
  max?: string | undefined
  // The first day of the calendar's weeks, 0 for Sunday to 6 for Saturday; the page's locale decides by default.
  firstDay?: 0 | 1 | 2 | 3 | 4 | 5 | 6 | undefined
  // The calendar button's name, and its buttons for the previous and next month and for today.
  openLabel?: string | undefined
  previousLabel?: string | undefined
  nextLabel?: string | undefined
  todayLabel?: string | undefined
  // What a typed date `isDisabled` refuses says to the browser's validation, which holds a form back from posting it.
  unavailableLabel?: string | undefined
  // Whether a single day cannot be chosen, such as a closed day or a booked one: its button is disabled, the arrow keys skip it, a click cannot pick it, and a typed date it refuses is flagged as invalid and not reported to `onChange`, as one outside `min` and `max` is flagged. The earliest and latest date stay `min` and `max`.
  isDisabled?: ((iso: string) => boolean) | undefined
  // Draws the inside of a day's button in place of its number, which the block writes itself (`{Number(iso.slice(8))}`), for a price or a dot under it; the button, its `aria-label` and the selection stay.
  day?: Snippet<[iso: string, state: { selected: boolean, today: boolean, outside: boolean, disabled: boolean }]> | undefined
  // Called with the month on show as `YYYY-MM` each time the calendar opens on it or moves to another, so an app can load that month's availability.
  onMonthChange?: ((month: string) => unknown) | undefined
  // Shows the calendar when the page sets it; the button, a click outside and Escape open and close it on their own, and `onOpenChange` reports each change so a page driving `open` can set it back.
  open?: boolean | undefined
  onOpenChange?: ((open: boolean) => unknown) | undefined
  // Called with the new date, or `''` once emptied, however it was set: typed, picked in the calendar or reset by a form.
  onChange?: ((value: string) => unknown) | undefined
}>()

// A box with no callback is plain: a refused post of its form, which the server renders it for, gives its date back in place of its own.
const sent = onChange ? undefined : postedValue(rest.name)

// The calendar is drawn once the island runs, so the server renders the plain date field alone and a form posts it without JavaScript.
const ready = signal(false)
const opened = signal(false)
const current = signal(untrack(() => value ?? ''))
const cursor = signal(today())
const now = signal(today())
let box: HTMLInputElement | undefined
let root: HTMLElement | undefined

onMount(() => {
  ready = true
  flag(untrack(current))
})

const first = () => firstDay ?? firstDayOf(pageLocale())
const weeks = memo(() => monthWeeks(cursor(), first()))
const names = memo(() => weekdays(pageLocale(), first()))

const ref = startRef<HTMLInputElement>(element => box = element, rest.ref)

// Whether a day cannot be chosen, outside the bounds or refused by the app.
const blocked = (iso: string) => !withinBounds(iso, min, max) || isDisabled?.(iso) === true

// A typed date the app refuses stays out of the value and holds the form back, as one outside the bounds does through the browser's own validation.
function flag(next: string): boolean {
  const refused = isDate(next) && isDisabled?.(next) === true

  box?.setCustomValidity(refused ? unavailableLabel : '')

  return refused
}

function heard(next: string) {
  if (flag(next) || next === current())
    return

  current = next
  onChange?.(next)
}

// A parent handing another date moves the box through TextInput, which then reports it back as the same date.
effect(() => {
  if (value !== undefined)
    current = value
})

// A page driving `open` sets the calendar; the browser's light dismiss still closes it, and reports `false`.
effect(() => {
  if (open !== undefined)
    opened = open
})

// The month on show is reported on opening and on each move, once.
let announced = ''

effect(() => {
  if (!opened()) {
    announced = ''

    return
  }

  const month = cursor().slice(0, 7)

  if (month === announced)
    return

  announced = month
  untrack(() => onMonthChange?.(month))
})

// The nearest day of the month of `iso` that can be chosen, `iso` itself when none can.
function nearest(iso: string): string {
  const target = clampDate(iso, min, max)

  if (!blocked(target))
    return target

  for (let step = 1; step < 31; step++) {
    for (const sign of [1, -1]) {
      const near = addDays(target, sign * step)

      if (sameMonth(near, target) && !blocked(near))
        return near
    }
  }

  return target
}

function toggled(isOpen: boolean) {
  opened = isOpen
  onOpenChange?.(isOpen)

  if (!isOpen)
    return

  now = today()
  cursor = nearest(isDate(current()) ? current() : today())
  focusCursor()
}

// Focus lands once the day's button is in the page, which a move to another month draws first.
function focusCursor() {
  queueMicrotask(() => root?.querySelector<HTMLElement>('[data-cursor]')?.focus())
}

function go(iso: string) {
  cursor = nearest(iso)
  focusCursor()
}

// Moves by `step` days until a day that can be chosen, and not past the bounds nor a year on: the cursor stays where it is when there is none.
function skipTo(target: string, step: number) {
  let at = clampDate(target, min, max)

  for (let tries = 0; tries < 366; tries++) {
    if (!blocked(at)) {
      cursor = at
      focusCursor()

      return
    }

    at = addDays(at, step)

    if (!withinBounds(at, min, max))
      return
  }
}

// Written into the field as if typed, so a controlled parent, a form and the app's `onChange` all hear it.
function pick(iso: string) {
  if (!box || box.readOnly || box.disabled || blocked(iso))
    return

  box.value = iso
  box.dispatchEvent(new Event('input', { bubbles: true }))
  box.dispatchEvent(new Event('change', { bubbles: true }))
  opened = false
}

const MOVES: Partial<Record<string, (iso: string, shift: boolean) => string>> = {
  ArrowLeft: iso => addDays(iso, -1),
  ArrowRight: iso => addDays(iso, 1),
  ArrowUp: iso => addDays(iso, -7),
  ArrowDown: iso => addDays(iso, 7),
  Home: iso => weekEdge(iso, first(), false),
  End: iso => weekEdge(iso, first(), true),
  PageUp: (iso, shift) => addMonths(iso, shift ? -12 : -1),
  PageDown: (iso, shift) => addMonths(iso, shift ? 12 : 1),
}

// The arrows move by day and week, Home and End to the week's ends, PageUp and PageDown by month, with Shift by year; Enter and Space press the day's button.
function keyDown(event: KeyboardEvent) {
  const move = MOVES[event.key]

  if (!move || !(event.target as Element).closest('[data-day]'))
    return

  event.preventDefault()

  const target = move(cursor(), event.shiftKey)
  const jump = event.key === 'ArrowUp' || event.key === 'ArrowDown' ? 7 : 1

  skipTo(target, target < cursor() ? -jump : jump)
}

// Tab past the last control closes the panel rather than leaving it open over the page; focus going nowhere, as on a click on the panel's padding, keeps it.
function focusLeft(event: FocusEvent) {
  const panel = event.currentTarget as HTMLElement
  const next = event.relatedTarget as Node | null

  if (next && !panel.contains(next) && panel.matches(':popover-open'))
    panel.hidePopover()
}

const canStepBack = () => !isDate(min) || addMonths(cursor(), -1).slice(0, 7) >= min.slice(0, 7)
const canStepOn = () => !isDate(max) || addMonths(cursor(), 1).slice(0, 7) <= max.slice(0, 7)
---
div(ref={element => root = element})
  TextInput({...rest} part="input" type="date" ref={ref} min={min} max={max} value={sent ?? value} onInput={heard} onChange={heard})
  if ready()
    // The panel's click is cancelled so a FormField's label, which holds it in the DOM, does not move focus to the field and close the calendar.
    Popover(part="panel" open={opened()} role="dialog" aria-label={openLabel} onOpenChange={toggled} onKeyDown={keyDown} onFocusOut={focusLeft} onClick={event => event.preventDefault()})
      @trigger(attributes)
        button({...attributes} part="trigger" type="button" aria-label={openLabel} disabled={rest.disabled || rest.readonly})
          Icon(icon="calendar")
      div(part="head")
        button(part="step" type="button" data-direction="previous" aria-label={previousLabel} disabled={!canStepBack()} onClick={() => go(addMonths(cursor(), -1))})
          Icon(icon="chevron" part="stepIcon")
        // Read out as the month changes, which is otherwise silent.
        div(part="title" aria-live="polite") {monthTitle(cursor(), pageLocale())}
        button(part="step" type="button" data-direction="next" aria-label={nextLabel} disabled={!canStepOn()} onClick={() => go(addMonths(cursor(), 1))})
          Icon(icon="chevron" part="stepIcon")
      // The days are built while the panel is open, as a range input holds two calendars that are mostly shut.
      if opened()
        table(part="grid" role="grid" aria-label={monthTitle(cursor(), pageLocale())})
          thead
            tr(part="weekdayRow")
              for name of names() key={name.long}
                th(part="weekday" scope="col" abbr={name.long}) {name.short}
          tbody
            for week of weeks() key={week[0]}
              tr(part="week")
                for iso of week key={iso}
                  td(part="cell" role="gridcell" aria-selected={current() === iso ? 'true' : 'false'})
                    button(part="day" type="button" tabindex={iso === cursor() ? 0 : -1} data-day={iso} data-cursor={iso === cursor() ? '' : undefined} data-outside={sameMonth(iso, cursor()) ? undefined : ''} aria-label={dayName(iso, pageLocale())} aria-current={iso === now() ? 'date' : undefined} disabled={blocked(iso)} onClick={() => pick(iso)})
                      if day
                        | {day(iso, { selected: current() === iso, today: iso === now(), outside: !sameMonth(iso, cursor()), disabled: blocked(iso) })}
                      else
                        | {Number(iso.slice(8))}
      button(part="today" type="button" disabled={blocked(now())} onClick={() => pick(now())}) {todayLabel}
