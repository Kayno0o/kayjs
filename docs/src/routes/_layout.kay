--- server
import { guides, reference } from '../content.config'

const topics = (await reference.all()).filter(topic => topic.slug !== 'overview').map(topic => ({ href: `/reference/${topic.slug}`, title: topic.data.title }))
const tutorials = (await guides.all()).map(guide => ({ href: `/guides/${guide.slug}`, title: guide.data.title }))
const current = ctx.url.pathname.replace(/\/$/, '') || '/'
---
---
import CodeCopy from '../components/code-copy.kay'
import Search from '../components/search.kay'
import TopicFilter from '../components/topic-filter.kay'
import '../styles.css'
---
a.skip-link(href="#content") Skip to the content
.shell
  aside.side
    header.bar
      a.brand(href="/")
        img(src="/icon-192.png" alt="" width="28" height="28")
        span kay
      Search(persist)
      button.menu(type="button" popovertarget="sidebar" aria-label="Open the menu") Menu
    nav#sidebar.sidebar(popover aria-label="Documentation")
      p.group Guides
      ul
        for guide of tutorials key={guide.href}
          li
            a(href={guide.href}) {guide.title}
      p.group Reference
      TopicFilter(topics={topics} current={current})
  main#content
    slot
CodeCopy(persist)
