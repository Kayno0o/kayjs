---
import Avatar from '@kaynooo/kayjs-ui/avatar.kay'
import Badge from '@kaynooo/kayjs-ui/badge.kay'
import Card from '@kaynooo/kayjs-ui/card.kay'
import CardRow from '@kaynooo/kayjs-ui/card-row.kay'
import Timeline from '@kaynooo/kayjs-ui/timeline.kay'

const { onSelect } = props<{ onSelect: (key: string | undefined) => void }>()

const entries = [
  { key: 'a', time: '08:30', text: 'Plain' },
  { key: 'b', time: '09:00', text: 'Linked', href: 'https://example.com/b' },
  { key: 'c', time: '09:30', text: 'Picked', href: 'https://example.com/c' },
]
---
Avatar#avatar-link(name="Ada Lovelace" href="https://example.com/ada")
Avatar#avatar-labelled(name="Ada" label="Ada's page" href="https://example.com/ada")
Avatar#avatar-plain(name="Ada")
Badge#badge-link(label="tag" href="https://example.com/tag")
Badge#badge-plain(label="tag")
Card#card-link(title="Moons" href="https://example.com/moons")
  @head
    button#card-control(type="button") Edit
  p Body
Card#card-plain(title="Plain")
  p Body
CardRow#row-link(href="https://example.com/io")
  @left
    input#row-toggle(type="checkbox")
  @actions
    button#row-action(type="button") Delete
  | Io
CardRow#row-plain
  | Europa
Timeline#timeline(entries={entries} selected="c" onSelectedChange={onSelect} label="Day")
