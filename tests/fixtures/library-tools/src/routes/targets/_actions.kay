--- server
import { action, s } from 'kay'

export const addNote = action(s.Object({
  title: s.String({ minLength: 3, error: 'Too short' }),
  pinned: s.Optional(s.Boolean()),
}), ({ title }) => ({ id: 1, title, at: new Date(0) }))

export const worded = action({ input: s.Object({}), tool: { text: ({ items }) => items.join(' ') } }, () => ({ items: ['a', 'b'] }))

export const described = action({ input: s.Object({}), tool: 'Says it was described' }, () => 'described')

export const named = action({ tool: { name: 'Say-Hello', description: 'Says hello' } }, () => 'named')

export const refuses = action(s.Object({}), (_input, ctx) => ctx.fail(409, { reason: 'full' }))

export const sendsAway = action(s.Object({}), (_input, ctx) => ctx.redirect('/done'))

export const breaks = action(s.Object({}), () => {
  throw new Error('boom')
})

export const language = action(s.Object({}), (_input, ctx) => ({ locale: ctx.locale }))

export const upload = action(s.Object({ photo: s.File() }), () => 'stored')

export const signup = action({ input: s.Object({ email: s.String(), website: s.Optional(s.String()) }), protect: { honeypot: 'website', minTime: '1h', rateLimit: { max: 2, window: '1m' } } }, ({ email }) => ({ email }))

export const vetoed = action({ input: s.Object({}), tool: false }, () => 'vetoed')

export const limited = action({ input: s.Object({}), protect: { rateLimit: { max: 2, window: '1m' } } }, () => 'counted')

export const solve = action({ input: s.Object({}), protect: { proofOfWork: true } }, () => 'solved')

// Actions with an `output`, for the dev check of a library's tool: one lying, one fitting, one answering nothing, one whose output is no object schema.
export const lies = action({ input: s.Object({}), tool: { output: s.Object({ count: s.Number() }) } }, () => ({ count: 'two' as unknown as number }))

export const honest = action({ input: s.Object({}), tool: { output: s.Object({ count: s.Number() }) } }, () => ({ count: 2 }))

export const silent = action({ input: s.Object({}), tool: { output: s.Object({ n: s.Number() }) } }, () => undefined as never)

export const unlisted = action({ input: s.Object({}), tool: { output: s.Array(s.Number()) as never } }, () => ({ count: 2 }))
---
