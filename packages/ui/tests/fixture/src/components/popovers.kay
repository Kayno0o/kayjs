---
import type { DurationText } from 'kay'
import { signal } from 'kay'
import IconButton from '@kaynooo/kayjs-ui/icon-button.kay'
import Popover from '@kaynooo/kayjs-ui/popover.kay'
import TooltipHost from '@kaynooo/kayjs-ui/tooltip-host.kay'

const { onToggle, showDelay, hideDelay } = props<{ onToggle: (open: boolean) => void, showDelay?: DurationText | undefined, hideDelay?: DurationText | undefined }>()

const open = signal(false)
---
button#show(onClick={() => open.set(true)}) Show
Popover(id="menu" open={open()} placement="top-end" onOpenChange={shown => { open.set(shown); onToggle(shown) }})
  @trigger(attributes)
    IconButton#trigger({...attributes} icon="chevron" label="Menu")
  p#inside Inside
IconButton#delete(icon="delete" label="Delete" data-tooltip-placement="bottom")
span#figure(data-hint="Damage per second") 12
button#focusable(data-hint="Only under the pointer") Focus
TooltipHost(showDelay={showDelay} hideDelay={hideDelay})
