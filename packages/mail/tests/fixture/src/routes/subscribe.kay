--- server
import { mail } from '../mail'
import Counted from '../mails/counted-confirm.kay'
import SubscribeForm from '@kaynooo/kayjs-mail/subscribe-form.kay'

export const subscribe = action(...mail.list().form())
export const subscribeStrict = action(...mail.list('strict', { protection: { rateLimit: { max: 2, window: '10m' } } }).form())
export const subscribeFlood = action(...mail.list('flood', { protection: { rateLimit: { max: 1000, window: '10m' } } }).form())
export const subscribeCounted = action(...mail.list('counted', { view: Counted }).form())
---
SubscribeForm(action={subscribe})
