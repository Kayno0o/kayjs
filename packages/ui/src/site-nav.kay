---
import type { JSX } from 'kay'
import { effect, listen, signal, uid } from 'kay'
import type { NavLink } from './defaults'
import Icon from './icon.kay'
import IconButton from './icon-button.kay'
import { wording } from 'kay/words'

const TRAILING_SLASHES = /\/+$/

const { id, links, current, label, menuLabel = wording('ui.siteNav.menuLabel', 'Menu'), class: className, ...rest } = props<Omit<JSX.IntrinsicElements['nav'], 'id' | 'class' | 'children'> & {
  // The list's id, unique on the page; one is drawn when none is given.
  id?: string | undefined
  // `icon` is drawn before the label, for the reader who sees it; the label still names the link.
  links: readonly NavLink[]
  // The path of the page on screen: its link is marked as the page, and a link to a section holding it as current.
  current: string
  // Names the navigation for screen readers.
  label: string
  // Names the button opening the links on a narrow screen.
  menuLabel?: string | undefined
  class?: string | undefined
}>()

const listId = id ?? uid()
const anchor = `--kui-site-nav-${listId}`
const open = signal(false)
let nav: HTMLElement | undefined
let toggle: HTMLElement | undefined

// A page the parent says is now on screen, as for an island kept from page to page, closes the menu.
effect(() => {
  void current
  open.set(false)
})

// A path with a trailing slash is the same page as without one.
const trimmed = (path: string) => path.length > 1 ? path.replace(TRAILING_SLASHES, '') : path

// The home page holds every path, so only an exact match marks it.
function marked(href: string) {
  const own = trimmed(href)
  const here = trimmed(current)

  if (own === here)
    return 'page'

  return own !== '/' && here.startsWith(`${own}/`) ? 'true' : undefined
}

// A press anywhere outside closes the open menu, as the browser's own popovers do, and leaves the focus where the press put it.
listen(document, 'pointerdown', (event) => {
  if (open() && !nav?.contains(event.target as Node))
    open.set(false)
})

function escape(event: KeyboardEvent) {
  if (event.key !== 'Escape' || !open())
    return

  open.set(false)
  toggle?.focus()
}
---
nav.kui-site-nav({...rest} ref={element => nav = element} aria-label={label} data-open={open() || undefined} class={className} onKeyDown={escape})
  IconButton(icon={open() ? 'close' : 'menu'} label={menuLabel} variant="ghost" class="kui-site-nav-toggle" aria-expanded={String(open())} aria-controls={listId} style={`anchor-name: ${anchor}`} ref={element => toggle = element} onClick={() => open.set(!open())})
  ul.kui-site-nav-list(id={listId} style={`position-anchor: ${anchor}`})
    for link of links key={link.href}
      li
        a.kui-site-nav-link(href={link.href} aria-current={marked(link.href)} onClick={() => open.set(false)})
          if link.icon
            Icon(icon={link.icon} class="kui-site-nav-icon")
          | {link.label}
