---
import type { EditorProps } from 'kay/edit'
import type { EntryRef } from '../kay/contract'
import type { FieldMarker, FieldPath, MarkedField } from '../markers'
import type { Dock, Layout } from './dock'
import type { Marks } from './marks'
import type { Choice, ListBar, ListTarget, Removed } from './page-lists'
import type { Direction } from './reorder'
import Button from '@kaynooo/kayjs-ui/button.kay'
import IconButton from '@kaynooo/kayjs-ui/icon-button.kay'
import Menu from '@kaynooo/kayjs-ui/menu.kay'
import Notice from '@kaynooo/kayjs-ui/notice.kay'
import SidePanel from '@kaynooo/kayjs-ui/side-panel.kay'
import Toaster from '@kaynooo/kayjs-ui/toaster.kay'
import TooltipHost from '@kaynooo/kayjs-ui/tooltip-host.kay'
import { attempt } from '@kaynooo/kayjs-ui'
import layoutBottom from '~icons/tabler/layout-bottombar'
import layoutSide from '~icons/tabler/layout-sidebar-right'
import browse from '~icons/tabler/pointer'
import outline from '~icons/tabler/scan'
import { announce } from '@kaynooo/kayjs-ui/announce'
import { call, guardLeave, listen, refresh, untrack } from 'kay'
import { wording } from 'kay/words'
import previewApi from '../api/preview'
import { BODY, entryKey, fieldsAt, formatMarker, markersOf } from '../markers'
import { blockTargetOf, inlineTargetOf, isBusy, isLoaded, isTypingInline, markedLabel, reachMarked, startInline } from './inline'
import { createMarks, readMarking, writeMarking } from './marks'
import { MARKER_MENU, OWN } from './own'
import { addItem, blockChoices, emptyListAt, focusItem, itemsAround, itemsOf, listFieldOf, movedWords, moveItem, removeItem, restoreItem, titleOf, watchLists } from './page-lists'
import type { PageListWatch } from './page-lists'
import { browserStorage, canSide, dockOf, readLayout, revealBy, writeLayout } from './dock'
import { drafts } from './drafts'
import { rebuilding, watchRebuild } from './rebuild'
import { notePlace } from './caret'
import { forgetOpened, isOpened, openEntry } from './opened'
import { replaceImage, watchImages } from './page-images'
import type { ImageBar } from './page-images'
import { saveAll } from './save-all'
import { shipWords } from './words'
import EntrySlot from './entry-slot.kay'
import PageImageTools from './page-image-tools.kay'
import PageListTools from './page-list-tools.kay'
import './editor.css'

// Where across the window the top is probed for a header, and the positions that hold one there.
const PROBES = [0.25, 0.5, 0.75]
const PINNED = new Set(['fixed', 'sticky'])
// The collapsed button's distance from the window's right edge, which what keeps off it counts too.
const COLLAPSED_GAP = 16
// How long a change of a list waits for the page to show it before the editor takes new ones again.
const SETTLE_LIMIT = 4000

// kay renders it at the end of the page in edit mode only, kept across page swaps, with the entries the page read.
const { entries, unclickable } = props<EditorProps>()

// Looks up what the editor reads only once the page has loaded, so the page sends it.
shipWords()

const open = signal(true)
const focused = signal<FieldMarker>()
// The field typed in on the page, which the form collapses to without taking the focus off it.
const typing = signal<FieldMarker>()
const leaving = signal(false)
// Set while Save all goes through the entries holding edits.
const savingAll = signal(false)
// Set once Stop editing was asked with edits not saved, until the editor chooses between keeping them and dropping them.
const confirming = signal(false)
// Where the editor was left, read once mounted since the server has no storage: the page renders with the window's choice, then takes the kept one.
const chosen = signal<Dock>()
const side = signal<number>()
const bottom = signal<number>()
const ready = signal(false)
// Browsing lets the page's links, menus and tabs work with the editor open, as a click edits nothing then.
const browsing = signal(false)
// Whether every marked field is outlined, else only the one under the pointer.
const marking = signal(false)
// What the editor asks the person to choose among next to a click or under an element a key reached: the fields of an element holding several, the block types of a list, the actions on a list item.
const choosing = signal<{ label: string, choices: Choice[], x: number, y: number }>()
// The bars of the list items and empty lists on the page, the item taken out last (which Undo puts back), and whether a change of a list waits for the page to show it.
const bars = signal<ListBar[]>([])
const removed = signal<Removed>()
const settling = signal(false)
// The button that opens the hidden editor.
const toggle = signal<HTMLElement>()
const room = signal({ width: 0, height: 0 })
// How far down a fixed header holds the top of the window.
const clear = signal(0)
// The page the edits were last shown on: a render of the drafts swaps the page as well, which leaves its path as it was.
let shownPath = ''
let marks: Marks | undefined
let lists: PageListWatch | undefined
// Where the focus goes once the page shows the list changed, and whether a render has begun since.
let pending: { target: ListTarget, index: number, form: boolean } | undefined
let rendered = false
let settleId = 0
// While the grip is dragged the layout is only kept when the drag ends, not on every move.
let dragging = 0
let frame = 0

const layout = (): Layout => ({ open: open(), dock: chosen(), side: side(), bottom: bottom() })
// None until the window is measured, which the server cannot do.
const dock = memo(() => room().width === 0 ? undefined : dockOf(layout(), room().width))
// The editor's own parts, the panel, its collapsed button and the choice of field: a click or a hover on them is no business of the page's fields.
const OWN_PARTS = `.kcms-editor, .kcms-editor-toggle, #${MARKER_MENU}`
const isOwn = (node: Node | null | undefined) => (node instanceof Element ? node : node?.parentElement)?.closest(OWN_PARTS) != null
const panelBox = () => document.querySelector('.kcms-editor[open]')?.getBoundingClientRect()

// How far down the page's own header, fixed or sticky at the top of the window, reaches, so the side dock sits under it and a reveal keeps clear of it.
function measureClear(): void {
  let bottom = 0

  for (const x of PROBES) {
    for (const hit of document.elementsFromPoint(window.innerWidth * x, 1)) {
      if (isOwn(hit))
        continue

      for (let element: Element | null = hit; element && element !== document.body; element = element.parentElement) {
        if (!PINNED.has(getComputedStyle(element).position))
          continue

        const box = element.getBoundingClientRect()

        if (box.top <= 1 && box.height <= 240)
          bottom = Math.max(bottom, box.bottom)
      }
    }
  }

  if (bottom !== clear())
    clear = bottom
}

function measure(): void {
  if (window.innerWidth !== room().width || window.innerHeight !== room().height)
    room = { width: window.innerWidth, height: window.innerHeight }

  measureClear()
}

// Scrolls and size changes arrive in bursts, so they are measured once a frame.
function measureSoon(): void {
  if (frame !== 0)
    return

  frame = requestAnimationFrame(() => {
    frame = 0
    measure()
  })
}

onMount(() => {
  const kept = readLayout(browserStorage())

  open = kept.open
  chosen = kept.dock
  side = kept.side
  bottom = kept.bottom
  measure()
  marking = readMarking(browserStorage()) ?? matchMedia('(hover: none)').matches
  ready = true

  shownPath = location.pathname + location.search
  watchRebuild()
})

// Another page replaced the one the edits were shown on, so they are shown on it too.
effect(() => {
  const navigated = () => {
    const path = location.pathname + location.search

    if (path === shownPath)
      return

    shownPath = path
    drafts.reapply()
  }

  document.addEventListener('kay:navigate', navigated)
  onCleanup(() => document.removeEventListener('kay:navigate', navigated))
})

listen(() => window, 'resize', measureSoon)
listen(() => window, 'scroll', measureSoon, { passive: true })

effect(() => {
  const value = layout()

  if (ready() && dragging === 0)
    writeLayout(browserStorage(), value)
})

// The grip of the panel reports each size it reached; the layout is kept once a drag ends or a key moved it.
function resized(next: number, settled: boolean): void {
  if (dock() === 'side')
    side = next
  else
    bottom = next

  dragging = settled ? 0 : 1

  if (settled)
    writeLayout(browserStorage(), layout())
}

// Scrolls the page so a clicked element lies above the bottom sheet, not under it; a click already in the visible part leaves the page, whatever the size of the element around it.
function reveal(element: Element, clickedAt?: number): void {
  const covered = (open() && dock() === 'bottom' ? panelBox()?.top ?? window.innerHeight : window.innerHeight) - 16

  measureClear()

  if (clickedAt !== undefined && clickedAt >= clear() && clickedAt <= covered)
    return

  const by = revealBy(element.getBoundingClientRect(), { top: clear(), bottom: covered })

  if (by !== 0)
    window.scrollBy({ top: by })
}

// The field a click on the page asked for, when it belongs to that entry.
function focusIn(entry: EntryRef): FieldPath | undefined {
  const marker = focused()

  return marker && entryKey(marker) === entryKey(entry) ? marker.path : undefined
}

// The field typed in on the page, when it belongs to that entry.
function typingIn(entry: EntryRef): FieldPath | undefined {
  const marker = typing()

  return marker && entryKey(marker) === entryKey(entry) ? marker.path : undefined
}

// The text node under the pointer, so a click on a field marked by a comment pair inside a larger element finds that field.
function clickedNode(event: MouseEvent): Node | undefined {
  const target = event.target instanceof Node ? event.target : undefined
  const caret = document.caretPositionFromPoint(event.clientX, event.clientY)?.offsetNode

  return caret?.nodeType === Node.TEXT_NODE && caret.parentNode === target ? caret : target
}

// While the editor is open, a click on a marked element edits its field instead of following a link or a button there: a one-line text is typed in on the page, any other field is brought up in the form.
listen(() => document, 'click', (event) => {
  const node = open() && !browsing() ? clickedNode(event) : undefined

  act(event, node, { x: event.clientX, y: event.clientY })
}, { capture: true })

// The fields under the pointer are outlined, whichever way the page marks them, once a frame at most.
let hoverFrame = 0
// The frame reads the pointer where it is by then, not where it was when the frame was asked for.
let pointer: PointerEvent | undefined

function stopHover(): void {
  cancelAnimationFrame(hoverFrame)
  hoverFrame = 0
  pointer = undefined
  marks?.hover(undefined)
  lists?.hover(undefined)
}

function inBars(node: Node | undefined): boolean {
  return (node instanceof Element ? node : node?.parentElement)?.closest('.kcms-page-lists') != null
}

// A touch has no hover, so the item it presses is the one whose bar shows.
listen(() => document, 'pointerdown', (event) => {
  const node = event.target instanceof Node ? event.target : undefined

  if (event.pointerType !== 'mouse' && open() && !browsing() && node && !inBars(node) && !isOwn(node))
    lists?.hover(node, { x: event.clientX, y: event.clientY })
}, { passive: true, capture: true })

listen(() => document, 'pointermove', (event) => {
  pointer = event

  if (hoverFrame !== 0)
    return

  hoverFrame = requestAnimationFrame(() => {
    hoverFrame = 0

    const node = pointer && open() && !browsing() ? clickedNode(pointer) : undefined
    const own = isOwn(node)

    marks?.hover(node && !own ? fieldsAt(node) : undefined)

    // The bars of a list item stay while the pointer is on them.
    if (!inBars(node))
      lists?.hover(node && !own ? node : undefined, pointer && { x: pointer.clientX, y: pointer.clientY })
  })
}, { passive: true })
listen(() => document.documentElement, 'pointerleave', stopHover)
onCleanup(stopHover)

// The element the keyboard reached is outlined as the pointer's is.
function focusedFields(): MarkedField[] | undefined {
  const element = document.activeElement
  const found = element && element !== document.body && !isOwn(element) ? markersOf(element) : []

  return found.length > 0 ? found : undefined
}

// The element holding the focus, unless it is the editor's own.
function focusedElement(): Element | undefined {
  const element = document.activeElement

  return element && element !== document.body && !isOwn(element) && !inBars(element) ? element : undefined
}

// The bar of the focused item keeps the item while the focus is on it.
listen(() => document, 'focusin', () => {
  marks?.focus(focusedFields())

  if (!inBars(document.activeElement ?? undefined))
    lists?.focus(focusedElement())
})
listen(() => document, 'focusout', (event) => {
  marks?.focus(undefined)

  if (!inBars(event.relatedTarget instanceof Node ? event.relatedTarget : undefined))
    lists?.focus(undefined)
})

// Tab goes through the bar of an item after the item's last tab stop.
listen(() => document, 'keydown', (event) => {
  const element = event.target instanceof HTMLElement ? event.target : undefined

  if (event.key !== 'Tab' || !open() || browsing() || event.isComposing || !element || event.altKey || event.ctrlKey || event.metaKey || (element.closest(OWN) && !inBars(element)))
    return

  const stop = lists?.tab(element, event.shiftKey)

  if (stop) {
    event.preventDefault()
    stop.focus()
  }
}, { capture: true })

// Alt and Shift with an arrow moves the list item holding the focus, with Delete takes it out, with Enter asks what to do with it; Enter on an empty list adds its first item.
listen(() => document, 'keydown', (event) => {
  const element = event.target instanceof HTMLElement ? event.target : undefined

  if (!open() || browsing() || event.isComposing || !element || element.isContentEditable || element.closest(OWN) || event.ctrlKey || event.metaKey)
    return

  const empty = event.key === 'Enter' && !event.altKey && !event.shiftKey ? emptyListAt(element, drafts) : undefined

  if (empty?.element === element) {
    event.preventDefault()
    event.stopImmediatePropagation()
    addTo(empty.target, 0, { element })

    return
  }

  // A text box keeps these keys: they select a paragraph on macOS and Delete erases there.
  if (!event.altKey || !event.shiftKey || element.matches('textarea, input, select'))
    return

  const [hit] = itemsAround(element, drafts)
  const direction = event.key === 'ArrowUp' ? 'up' : event.key === 'ArrowDown' ? 'down' : undefined

  if (!hit || (direction === undefined && event.key !== 'Delete' && event.key !== 'Backspace' && event.key !== 'Enter'))
    return

  event.preventDefault()
  event.stopImmediatePropagation()

  const { target } = hit.list

  if (direction)
    moveOne(target, hit.index, direction)
  else if (event.key === 'Enter')
    itemMenu(target, hit.index, { element })
  else
    removeOne(target, hit.index)
}, { capture: true })

// Enter on a marked element reached by the keyboard edits its field as a click on it does.
listen(() => document, 'keydown', (event) => {
  const element = event.target instanceof HTMLElement ? event.target : undefined

  const pressed = event.key === 'Enter' || (event.key === ' ' && element?.getAttribute('role') === 'button')

  if (!open() || browsing() || !pressed || event.isComposing || !element || markersOf(element).length === 0 || element.isContentEditable || element.matches('button, summary, input, select, textarea, label, a[href]'))
    return

  act(event, element)
}, { capture: true })

// What names a field to the editor: the form's label for it, the attribute it renders in beside it.
function describe(field: MarkedField): string {
  const name = field.marker.path === BODY ? wording('cms.marker.body', 'Body') : markedLabel(field, drafts) ?? field.marker.path

  return field.attribute ? wording('cms.marker.attribute', '{field} ({attribute})', { field: name, attribute: field.attribute }) : name
}

// Keeps marked fields on the tab order while the editor is open, with a name saying what they edit.
effect(() => {
  if (!open() || browsing())
    return

  onCleanup(reachMarked(found => untrack(() => wording('cms.marker.edit', 'Edit {fields}', { fields: found.map(describe).join(', ') }))))
})

// Outlines the marked fields while the editor is open, all of them or the one under the pointer.
effect(() => {
  if (!open() || browsing())
    return

  const made = createMarks(marking(), focusedFields)

  marks = made
  onCleanup(() => {
    made.destroy()
    marks = undefined
  })
})

// Keeps the bars of the list items and the empty lists of the page while the editor is open.
effect(() => {
  if (!open() || browsing())
    return

  const watched = watchLists(drafts, found => bars = found)

  lists = watched
  onCleanup(() => {
    watched.destroy()
    lists = undefined
  })
})

// The button over the image of the page under the pointer or the focus, and the drop of a file on one.
const imageBar = signal<ImageBar>()

effect(() => {
  if (!open() || browsing())
    return

  const watched = watchImages(drafts, found => imageBar = found, (bar, file) => void replaceImage(drafts, bar, file))

  onCleanup(watched.destroy)
})

// The bars follow the drafts: a form that has loaded names its lists, and an edit changes their length.
effect(() => {
  for (const entry of entries)
    drafts.entry(entry)

  untrack(() => lists?.refresh())
})

// An item taken out of an entry the page no longer shows cannot be put back.
effect(() => {
  const gone = removed()

  if (gone && !entries.some(entry => entryKey(entry) === entryKey(gone.target)))
    removed = undefined
})

// Stepping away from the editor or the page closes the question of which field.
effect(() => {
  if (!open() || browsing()) {
    choosing = undefined
    removed = undefined
  }
})

// Only a choice of the editor is kept, not the default a screen without hover starts with.
function toggleMarking(): void {
  marking = !marking()
  writeMarking(browserStorage(), marking())
}


// The open question as a list of at most one, so the menu is keyed by it.
function asked() {
  const question = choosing()

  return question ? [question] : []
}

// Asks next to (`x`, `y`), or under the element a key reached, in a menu the browser keeps inside the window.
function ask(label: string, choices: Choice[], x: number, y: number): void {
  choosing = { label, choices, x, y }
}

// Where a menu for a list opens: under the button or element it was asked from.
function below(from: { element?: HTMLElement, event?: Event }): { x: number, y: number, back: HTMLElement | undefined } {
  const element = from.element ?? (from.event?.currentTarget instanceof HTMLElement ? from.event.currentTarget : undefined)
  const box = element?.getBoundingClientRect()

  return { x: box?.left ?? 0, y: box?.bottom ?? 0, back: element }
}

// Until the page shows the draft, its items are not the draft's: a change made in the form counts as much as one made here.
const unsettled = () => settling() || drafts.pending()

// A change of a list is shown by the page rendering the draft again: until then the page's items are not the draft's, so no other change is made, and the focus goes to the item once they match.
function settle(target: ListTarget, index: number, form = false): void {
  const id = ++settleId

  pending = { target, index, form }
  rendered = false
  settling = true
  setTimeout(() => {
    if (settleId === id) {
      pending = undefined
      settling = false
    }
  }, SETTLE_LIMIT)
}

effect(() => {
  const busy = drafts.rendering()

  if (!pending)
    return

  if (busy) {
    rendered = true

    return
  }

  if (!rendered)
    return

  requestAnimationFrame(() => {
    if (!pending)
      return

    const { target, index, form } = pending

    pending = undefined
    settling = false
    lists?.reach()

    // A new item the page cannot mark, as an empty text is, has no element to take the focus, nor has one the draft's issues keep the page from showing: its field in the form does.
    if (drafts.stale().some(entry => entryKey(entry) === entryKey(target)))
      showInForm({ ...target, path: `${target.path}.${index}` })
    else if (focusItem(target, index) !== 'item' && form)
      showInForm({ ...target, path: `${target.path}.${index}` })

    lists?.refresh()
  })
})

// Brings a field up in the form, even when it was the last one brought up.
function showInForm(marker: FieldMarker): void {
  focused = undefined
  requestAnimationFrame(() => focused = marker)
}

function addTo(target: ListTarget, at: number, from: { element?: HTMLElement, event?: Event }): void {
  if (unsettled() || isBusy(target))
    return

  const blocks = blockChoices(target, drafts)

  if (blocks.length === 0) {
    addOne(target, at)

    return
  }

  const { x, y } = below(from)

  ask(wording('cms.blocks.add', 'Add a block to {list}', { list: listFieldOf(target, drafts)?.label ?? '' }), blocks.map(block => ({ key: block.type, label: block.label, run: () => addOne(target, at, block.type) })), x, y)
}

function addOne(target: ListTarget, at: number, type?: string): void {
  if (unsettled() || isBusy(target))
    return

  const place = addItem(drafts, target, at, type)

  if (place === undefined)
    return

  removed = undefined
  settle(target, place, true)
}

function moveOne(target: ListTarget, from: number, direction: Direction): void {
  if (unsettled() || isBusy(target))
    return

  const title = titleOf(drafts, target, from)
  const to = moveItem(drafts, target, from, direction)

  if (to === undefined)
    return

  removed = undefined
  announce(movedWords(title, to, itemsOf(drafts, target).length))
  settle(target, to)
}

function removeOne(target: ListTarget, at: number): void {
  if (unsettled() || isBusy(target))
    return

  const gone = removeItem(drafts, target, at)

  if (!gone)
    return

  removed = gone
  announce(wording('cms.list.removed', '{item} removed', { item: gone.title }))
  settle(target, Math.min(at, itemsOf(drafts, target).length - 1))
}

function undoRemoval(): void {
  const gone = removed()

  if (!gone || unsettled() || isBusy(gone.target))
    return

  const place = restoreItem(drafts, gone)

  if (place === undefined)
    return

  removed = undefined
  settle(gone.target, place)
}

// What can be done with an item: put one before or after it, move it, take it out.
function itemMenu(target: ListTarget, index: number, from: { element?: HTMLElement, event?: Event }): void {
  if (unsettled() || isBusy(target))
    return

  const count = itemsOf(drafts, target).length
  const item = titleOf(drafts, target, index)
  const field = listFieldOf(target, drafts)
  const full = field?.maxItems !== undefined && count >= field.maxItems
  const choices: Choice[] = []
  const { x, y, back } = below(from)

  if (!full) {
    choices.push({ key: 'before', label: wording('cms.pageList.addBefore', 'Add before {item}', { item }), run: () => addTo(target, index, { element: back }) })
    choices.push({ key: 'after', label: wording('cms.pageList.addAfter', 'Add after {item}', { item }), run: () => addTo(target, index + 1, { element: back }) })
  }

  if (index > 0)
    choices.push({ key: 'up', label: wording('cms.reorder.up', 'Move {item} up', { item }), run: () => moveOne(target, index, 'up') })

  if (index < count - 1)
    choices.push({ key: 'down', label: wording('cms.reorder.down', 'Move {item} down', { item }), run: () => moveOne(target, index, 'down') })

  if (field?.minItems === undefined || count > field.minItems)
    choices.push({ key: 'remove', label: wording('cms.field.removeItem', 'Remove {item}', { item }), run: () => removeOne(target, index) })

  if (choices.length > 0)
    ask(wording('cms.pageList.actions', 'What to do with {item}?', { item }), choices, x, y)
}

// What a click, or an Enter on a field reached by the keyboard, does at `node`.
function act(event: Event, node: Node | undefined, at?: { x: number, y: number }): void {
  // A click in the text being typed in places the caret, which the browser did on the press: the click itself acts on nothing.
  if (node && isTypingInline(node)) {
    event.preventDefault()
    event.stopPropagation()

    return
  }

  const found = node && !isOwn(node) ? fieldsAt(node) : []
  const [field] = found

  if (!field)
    return

  event.preventDefault()
  event.stopPropagation()

  // An element with several fields asks which one, next to the click or under the element a key reached.
  if (found.length > 1) {
    const box = field.element.getBoundingClientRect()
    const back = at ? undefined : field.element as HTMLElement

    ask(wording('cms.marker.choose', 'Edit which field?'), found.map(each => ({ key: formatMarker(each.marker) + (each.attribute ?? ''), label: describe(each), run: () => edit(each, at?.x, at?.y, back) })), at?.x ?? box.left, at?.y ?? box.bottom)

    return
  }

  edit(field, at?.x, at?.y, undefined, node)
}

let waiting = 0

// Runs the edit once the field's entry has loaded, or after a few seconds, unless a later click has taken over.
async function editOnceLoaded(field: MarkedField, ticket: number, run: () => void): Promise<void> {
  for (let tries = 0; tries < 50 && !isLoaded(field.marker); tries++)
    await new Promise(resolve => setTimeout(resolve, 100))

  if (ticket === waiting)
    run()
}

// Types in a field on the page when it is a text or a paragraph of Markdown, else brings it up in the form. A block of Markdown needs the node clicked to know which one.
function edit(field: MarkedField, x?: number, y?: number, back?: HTMLElement, node?: Node, waited = false): void {
  waiting += 1

  // An entry still a row or loading is waited for, and the click answered once it has loaded, the last click winning: a text types in place at once, any other field brings up the form.
  if (!waited && !isLoaded(field.marker)) {
    if (!isOpened(field.marker))
      openEntry(field.marker)

    void editOnceLoaded(field, waiting, () => edit(field, x, y, back, node, true))

    return
  }

  const inline = inlineTargetOf([field], drafts) ?? (node && blockTargetOf(field, node, drafts))

  if (inline && !inline.busy()) {
    typing = field.marker
    startInline(inline, drafts, back || x === undefined || y === undefined ? undefined : { x, y })
    reveal(inline.element, y)

    return
  }

  notePlace(field, x, y)
  focused = field.marker
  reveal(field.element, y)
}

// What the head's button does: leaves at once, or with edits not saved shows the question, which only its own two buttons answer.
async function askStop(): Promise<void> {
  if (!drafts.anyChanged(entries))
    return stopEditing()

  confirming = true
}

// As an entry's own Save counts it: edits, or a text that does not parse, which saving explains.
const hasEdits = () => drafts.anyChanged(entries) || entries.some(entry => drafts.blocked(entry).length > 0)

// Saves every entry of the page holding edits, each as its own Save would.
async function saveEverything(): Promise<void> {
  if (savingAll())
    return

  savingAll = true

  try {
    await saveAll(entries)
  }
  finally {
    savingAll = false
  }
}

// Asks before the page, a link or a reload drops edits not saved.
guardLeave(() => drafts.anyChanged(entries))
onCleanup(() => {
  waiting += 1
  forgetOpened()
})

// Renders the page again as visitors see it, once kay forgot the edit mode.
async function stopEditing(): Promise<void> {
  confirming = false
  leaving = true

  if (!await attempt(() => call(previewApi, '/exit', { method: 'post' }), wording('cms.editor.leaveFailure', 'Could not leave edit mode'))) {
    leaving = false

    return
  }

  // The edits go with the edit mode, so nobody signing in on this browser next finds them.
  drafts.discardAll()
  await refresh()
}

// The page outlines its fields while the editor is open. The Toaster and TooltipHost below give way to a site page's own.
effect(() => {
  document.documentElement.classList.toggle('kcms-editing', open())
  document.documentElement.classList.toggle('kcms-browsing', browsing())
  onCleanup(() => document.documentElement.classList.remove('kcms-editing', 'kcms-browsing'))
})

// The collapsed button is a panel too, so the dev tool's bar and a floating drawer at the bottom right keep off it.
effect(() => {
  const button = toggle()

  if (!ready() || open() || !button)
    return

  const root = document.documentElement
  const width = button.offsetWidth

  if (width > 0)
    root.style.setProperty('--kay-panel-right', `${width + COLLAPSED_GAP}px`)

  onCleanup(() => root.style.removeProperty('--kay-panel-right'))
})

// The page's own styles read the dock from its root, where the panel makes the room, and the panel clears a fixed header at the top.
effect(() => {
  const root = document.documentElement
  const at = dock()

  root.classList.toggle('kcms-dock-side', at === 'side')
  root.classList.toggle('kcms-dock-bottom', at === 'bottom')

  if (at)
    root.style.setProperty('--kui-dock-top', `${clear()}px`)

  onCleanup(() => {
    root.classList.remove('kcms-dock-side', 'kcms-dock-bottom')
    root.style.removeProperty('--kui-dock-top')
  })
})

// A question to answer asks Stop editing's two buttons to be seen, wherever the form is scrolled to.
let confirmBox: HTMLElement | undefined

effect(() => {
  if (confirming() && confirmBox)
    confirmBox.scrollIntoView({ block: 'nearest' })
})
---
if !open()
  IconButton.kcms-editor-toggle(ref={element => toggle = element} icon="menu" label={wording('cms.editor.open', 'Edit this page')} variant="ghost" onClick={() => open = true})
SidePanel.kcms-editor(open={open()} modal={false} dock={dock() === 'bottom' ? 'bottom' : 'right'} size={dock() === 'side' ? side() : bottom()} onSizeChange={resized} resizeLabel={wording('cms.editor.resize', 'Resize the editor')} closeLabel={wording('cms.editor.hide', 'Hide the editor')} title={wording('cms.editor.title', 'Edit this page')} style={`z-index: 2147483000${ready() && open() ? '' : '; visibility: hidden'}`} onOpenChange={shown => open = shown})
  @actions
    Button(label={leaving() ? wording('cms.editor.leaving', 'Leaving…') : wording('cms.editor.stop', 'Stop editing')} busy={leaving()} onClick={askStop})
    if dock() && canSide(room().width)
      IconButton(icon={dock() === 'side' ? layoutBottom : layoutSide} label={dock() === 'side' ? wording('cms.editor.dockBottom', 'Dock the editor to the bottom') : wording('cms.editor.dockSide', 'Dock the editor to the side')} variant="ghost" onClick={() => chosen = dock() === 'side' ? 'bottom' : 'side'})
    IconButton(icon={outline} label={marking() ? wording('cms.editor.markingOff', 'Stop outlining every field') : wording('cms.editor.markingOn', 'Outline every field of the page')} variant={marking() ? 'solid' : 'ghost'} aria-pressed={marking()} onClick={toggleMarking})
    IconButton(icon={browse} label={browsing() ? wording('cms.editor.browseOff', 'Edit the page again') : wording('cms.editor.browseOn', 'Browse the page: links and menus work')} variant={browsing() ? 'solid' : 'ghost'} aria-pressed={browsing()} onClick={() => browsing = !browsing()})
  if confirming()
    .kcms-editor-confirm(role="alert" ref={element => confirmBox = element})
      p {wording('cms.editor.discardAsk', 'You have changes that are not saved. Stopping drops them.')}
      .kcms-editor-choice
        Button(label={wording('cms.editor.keepEditing', 'Keep editing')} onClick={() => confirming = false})
        Button(label={wording('cms.editor.discard', 'Drop them and stop')} tone="danger" onClick={stopEditing})
  .kcms-editor-status(role="status" aria-live="polite")
    if removed() as gone
      .kcms-editor-undo
        span {wording('cms.list.removed', '{item} removed', { item: gone.title })}
        Button(label={wording('cms.list.undo', 'Undo')} variant="inline" disabled={unsettled()} onClick={undoRemoval})
    if drafts.rendering()
      p {wording('cms.editor.rendering', 'Updating the page…')}
    if drafts.stale().length > 0
      Notice.kcms-editor-failure(tone="warning" size="sm" label={wording('cms.editor.stale', 'The page shows the saved text of {entries} until your changes there are valid.', { entries: drafts.stale().map(entry => `${entry.collection}/${entry.slug}`).join(', ') })})
    if rebuilding()
      p {wording('cms.editor.rebuilding', 'Your last save is still reaching the live site, which shows the old content until it has rebuilt.')}
  if drafts.failure() as failure
    Notice.kcms-editor-failure(tone="danger" size="sm" label={wording('cms.editor.draftFailure', 'The page could not show your changes: {failure}', { failure })})
  if entries.length > 1
    .kcms-editor-all
      Button(label={savingAll() ? wording('cms.entry.saving', 'Saving…') : wording('cms.editor.saveAll', 'Save all')} tone="accent" busy={savingAll()} disabled={savingAll() || !hasEdits()} onClick={saveEverything})
  for entry of entries key={entryKey(entry)}
    EntrySlot(entry={entry} alone={entries.length === 1} focus={focusIn(entry)} typing={typingIn(entry)} unclickable={unclickable.filter(field => entryKey(field) === entryKey(entry))})
  else
    p.kcms-editor-empty {wording('cms.editor.empty', 'Nothing on this page comes from a collection.')}
// Keyed by the question, so a choice that asks another one mounts a menu that opens afresh.
for question of asked() key={question}
  Menu(id={MARKER_MENU} label={question.label} at={{ x: question.x, y: question.y }} open items={question.choices.map(choice => ({ label: choice.label, onSelect: choice.run }))} onOpenChange={shown => !shown && choosing() === question && (choosing = undefined)})
PageImageTools(bar={imageBar()} onPick={(bar, file) => void replaceImage(drafts, bar, file)})
PageListTools(bars={settling() ? [] : bars()} onMove={(bar, direction) => moveOne(bar.target, bar.index!, direction)} onAdd={(bar, event) => addTo(bar.target, bar.index === undefined ? 0 : bar.index + 1, { event })} onRemove={bar => removeOne(bar.target, bar.index!)})
Toaster
TooltipHost
