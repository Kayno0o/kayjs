---
import { onMount, signal } from 'kay'
import Button from '@kaynooo/kayjs-ui/button.kay'
import { askPasskey, canAskPasskey, passkeyFailure } from '../../browser'
import { passkey, passkeyOptions } from '../routes/two-factor.kay'

const { label, failed } = props<{ label: string, failed: string }>()

const supported = signal(false)
const error = signal('')

// Shown once the browser proves it can, since a passkey needs script.
onMount(() => supported.set(canAskPasskey()))

async function verify() {
  error.set('')

  try {
    const options = await passkeyOptions({}, { refresh: false })
    const response = await askPasskey(options)

    if (response)
      await passkey({ response })
  }
  catch (caught) {
    error.set(passkeyFailure(caught, {}, failed))
  }
}
---
if supported()
  Button(label={label} onClick={verify} busy={passkey.pending()})
  if error()
    p.kayjs-auth-error.text-kui-error(role="alert") {error()}
