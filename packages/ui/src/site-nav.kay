---
import type { JSX, Snippet } from 'kay'
import { recipe, uid } from 'kay'
import type { NavLink } from './defaults'
import Icon from './icon.kay'
import SiteNavState from './internal/site-nav-state.kay'
import { addressHref } from './tab-nav'
import { wording } from 'kay/words'

const TRAILING_SLASHES = /\/+$/

// 'kui-site-nav' stays as the component's name for an app's CSS. Below lg the links fold behind the toggle, a popover its popovertarget opens, and the open popover's frame is theme.css's; from lg they sit in a row, the toggle hidden.
const look = recipe({
  parts: {
    root: 'kui-site-nav group/nav flex items-center',
    toggle: 'lg:hidden',
    menuIcon: 'group-has-[[data-part=list]:popover-open]/nav:hidden',
    closeIcon: 'hidden group-has-[[data-part=list]:popover-open]/nav:inline-block',
    list: 'gap-1 lg:static lg:m-0 lg:flex lg:min-w-0 lg:flex-row lg:items-center lg:overflow-visible lg:border-0 lg:bg-transparent lg:p-0 lg:text-inherit',
    item: 'lg:flex lg:items-center',
    link: 'block px-3 py-2 text-sm text-muted transition-colors hover:text-foreground aria-[current]:text-accent has-[[data-part=icon]]:flex has-[[data-part=icon]]:items-center has-[[data-part=icon]]:gap-2',
    icon: 'size-4 shrink-0',
    // The chevron beside a link with `children` opens them from lg; below it they are always shown, nested in the list.
    expand: 'inline-flex items-center px-1 py-2 text-muted hover:text-foreground max-lg:hidden',
    expandIcon: 'size-3.5 shrink-0',
    // From lg a popover under its chevron; below it the nested list of the menu, shown whether or not it is open.
    children: 'gap-1 max-lg:static max-lg:m-0 max-lg:flex max-lg:flex-col max-lg:border-0 max-lg:bg-transparent max-lg:p-0 max-lg:ps-4 max-lg:text-inherit lg:m-0 lg:mt-2 lg:min-w-48 lg:list-none lg:border-solid lg:border-[length:var(--border-width)] lg:border-border lg:bg-popover lg:p-2 lg:text-foreground lg:[inset:auto] lg:[position-area:block-end_span-inline-end] lg:[position-try-fallbacks:flip-inline]',
  },
})

const { id, links, link, current, label, menuLabel = wording('ui.siteNav.menu', 'Menu'), expandLabel = wording('ui.siteNav.expand', 'Show the pages under {label}'), open, onOpenChange, ...rest } = props<Omit<JSX.IntrinsicElements['nav'], 'id' | 'class' | 'children'> & {
  // The list's id, unique on the page; one is drawn when none is given.
  id?: string | undefined
  // `icon` is drawn before the label, for the reader who sees it; the label still names the link. A link with `children` keeps its own page and gains a button that opens them under it from lg, the whole list nested in the menu below.
  links: readonly NavLink[]
  // Draws the text of each link, children included, in place of its `label`: `@link(link)`, given the link. The icon it names is still drawn before it. A block taking the link makes the SiteNav an island.
  link?: Snippet<[link: NavLink]> | undefined
  // The path of the page on screen, or its URL, `ctx.url`: its link is marked as the page, and a link to a section holding it as current.
  current: string | URL
  // Names the navigation for screen readers.
  label: string
  // Names the button opening the links on a narrow screen.
  menuLabel?: string | undefined
  // Names the button opening a link's children, `{label}` standing for the link's.
  expandLabel?: string | undefined
  // Shows the menu of a narrow screen when the page sets it, such as to close it on its own navigation; the toggle, a press outside and Escape open and close it on their own. An `onOpenChange` makes the SiteNav an island.
  open?: boolean | undefined
  // Called with the menu's new state whenever it shows or hides, however it did.
  onOpenChange?: ((open: boolean) => unknown) | undefined
}>()

const listId = id ?? uid()
const anchor = `--_site-nav-${listId}`

// A path with a trailing slash is the same page as without one.
const trimmed = (path: string) => path.length > 1 ? path.replace(TRAILING_SLASHES, '') : path

const expanded = (entry: NavLink) => expandLabel.replaceAll('{label}', entry.label)

// The home page holds every path, so only an exact match marks it.
function marked(href: string) {
  const own = trimmed(addressHref(href))
  const here = trimmed(typeof current === 'string' ? current : current.pathname)

  if (own === here)
    return 'page'

  return own !== '/' && here.startsWith(`${own}/`) ? 'true' : undefined
}
---
// One link of the list or of a group under one: its icon, then the app's block or the label.
snippet destination(entry: NavLink)
  a(part="link" href={entry.href} aria-current={marked(entry.href)})
    if entry.icon
      Icon(icon={entry.icon} part="icon")
    if link
      slot link(entry)
    else
      | {entry.label}
// The list is a popover its toggle opens, so the browser owns showing it, closing it on a press outside or Escape, and giving the focus back; the page swap closes one left open.
// The toggle is an IconButton's markup with both icons drawn, so CSS shows the close one while the list is open.
// A link with children is followed by a button opening them as a popover from lg; below it they stay nested and always shown, so the button hides.
nav(part="root" {...rest} aria-label={label})
  button.kui-icon-btn(part="toggle" type="button" aria-label={menuLabel} data-tooltip={menuLabel} data-size="md" data-variant="ghost" data-tone="neutral" popovertarget={listId} style={`anchor-name: ${anchor}`})
    Icon(icon="menu" part="menuIcon")
    Icon(icon="close" part="closeIcon")
  ul(part="list" id={listId} popover style={`position-anchor: ${anchor}`})
    for entry, position of links key={entry.href}
      li(part="item")
        | {destination(entry)}
        if entry.children && entry.children.length > 0
          button(part="expand" type="button" aria-label={expanded(entry)} data-tooltip={expanded(entry)} popovertarget={`${listId}-${position}`} style={`anchor-name: ${anchor}-${position}`})
            Icon(icon="chevron" part="expandIcon")
          ul(part="children" id={`${listId}-${position}`} popover style={`position-anchor: ${anchor}-${position}`})
            for child of entry.children key={child.href}
              li(part="item")
                | {destination(child)}
  if open !== undefined || onOpenChange
    SiteNavState(listId={listId} open={open} onOpenChange={onOpenChange})
