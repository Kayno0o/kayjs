--- server
import { t } from 'elysia'
import { action } from 'kay'
import Panel from '../components/panel.kay'

export const slow = action(t.Object({}), () => 'done')

const view = ctx.url.searchParams.get('view') ?? 'none'
---
head
  title Home
h1 Home
p.view {view}
nav
  a.query(href="/?view=b") Query
  a.cross(href="/other") Other
  a.self(href="/") Self
  a.styled(href="/styled") Styled
Panel(run={slow})
