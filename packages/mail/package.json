{
  "name": "@kayjs/mail",
  "type": "module",
  "version": "1.103.0",
  "description": "Mail for kay apps: SMTP configured from typed env variables, mails written as .kay components, a development outbox page, a test outbox and queued sending",
  "author": "Kaynooo <https://github.com/Kayno0o>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kayno0o/kayjs",
    "directory": "packages/mail"
  },
  "bugs": {
    "url": "https://github.com/Kayno0o/kayjs/issues"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/"
  },
  "kay": {
    "settings": "./src/settings.ts",
    "messages": "./src/messages"
  },
  "exports": {
    "./*.kay": "./src/*.kay",
    "./add": "./src/add.ts",
    "./pg": "./src/pg.ts",
    "./sqlite": "./src/sqlite.ts",
    "./test": "./src/test.ts",
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "llms",
    "llms.txt",
    "src",
    "types"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "prepare": "$npm_execpath ../../scripts/link-fixture.ts",
    "check": "$npm_execpath check && $npm_execpath ../../src/cli.ts check tests/fixture",
    "build:types": "rm -rf types && $npm_execpath ../../src/tsgo.ts -p tsconfig.build.json",
    "prepack": "$npm_execpath run build:types && $npm_execpath ../../scripts/pack-links.ts rewrite ../..",
    "postpack": "rm -rf types && $npm_execpath ../../scripts/pack-links.ts restore ../..",
    "prelint": "$npm_execpath run --cwd ../.. build:eslint",
    "lint": "$npm_execpath ../../scripts/lint-cache.ts && keslint --cache",
    "prelint:fix": "$npm_execpath run --cwd ../.. build:eslint",
    "lint:fix": "$npm_execpath ../../scripts/lint-cache.ts && keslint --fix --cache",
    "test": "$npm_execpath test --parallel=6 --timeout 20000"
  },
  "peerDependencies": {
    "elysia": "^1.4.31",
    "kay": "~1.103.0"
  },
  "dependencies": {
    "@kaynooo/utils": "^3.1.0",
    "nodemailer": "^10.2.1"
  },
  "devDependencies": {
    "@kaynooo/eslint": "^7.1.6",
    "@types/bun": "^1.4.4",
    "elysia": "^1.4.31",
    "typescript": "^6.0.3"
  }
}
