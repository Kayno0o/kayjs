---
import type { Action, Failure } from 'kay'
import { ActionError, signal } from 'kay'
import FormDialog from '@kaynooo/kayjs-ui/form-dialog.kay'
import FormField from '@kaynooo/kayjs-ui/form-field.kay'
import Toaster from '@kaynooo/kayjs-ui/toaster.kay'

// What the handler passes to `ctx.fail`: a message, for a field or the whole form.
interface Refusal {
  error: string
  field?: string
}

// `save` stands in for the server: it answers the saved name, the messages a schema refusal carries, the data of a handler's refusal, or throws for a call that failed outright.
// `plain` leaves `refused` out, as a page reading nothing from its handler's refusals does.
const { save, onSave, onError, plain = false, old } = props<{ old?: Record<string, unknown> | undefined, onError?: ((failure: { error: unknown }) => unknown) | undefined, save: (input: { name: string }) => Promise<string | { errors: Record<string, string> } | { fail: Refusal }>, onSave: (name: string) => void, plain?: boolean }>()

const open = signal(true)
const pending = signal(false)
// Like a real action, it keeps its last refusal until a call goes through.
const last = signal<ActionError | undefined>(undefined)

// What a page's action is to an island: a call that answers or throws ActionError, its `pending()` and its `url`.
const rename = Object.assign(async (form: FormData) => {
  pending = true

  try {
    const answer = await save({ name: String(form.get('name')) })

    if (typeof answer !== 'string')
      throw 'fail' in answer ? new ActionError(400, '', {}, answer.fail) : new ActionError(422, '', answer.errors)

    last = undefined

    return answer
  }
  catch (error) {
    last = error instanceof ActionError ? error : undefined

    throw error
  }
  finally {
    pending = false
  }
}, { [Symbol.for('kay.action')]: true, pending, url: '/_kay/action/form/rename', failed: () => last() ? { status: last()!.status, errors: last()!.errors } : undefined, error: (field = '') => last()?.errors[field] }) as unknown as Action<{ name: string }, string | Failure<Refusal>>

function said(refusal: Refusal) {
  return refusal.field ? { [refusal.field]: refusal.error } : refusal.error
}
---
button#open(onClick={() => open = true}) Open
button#hide(onClick={() => open = false}) Hide
FormDialog(open={open()} title="Rename" action={rename} submitLabel="Rename" failureLabel="Could not rename" refused={plain ? undefined : said} onSave={onSave} onError={onError} onOpenChange={() => open = false} {...old})
  FormField(label="Name" name="name" hint="As the profile shows it")
    input#name(name="name" value="Ada" aria-describedby="name-note")
  p#name-note Public
  textarea#notes(name="notes")
  FormField(label="Access" name="access" group)
    input#login(type="checkbox" name="access" value="login")
    input#admin(type="checkbox" name="access" value="admin")
Toaster
