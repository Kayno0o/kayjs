--- server
import { ask, chatMessages } from '@kayjs/ai'
import { action } from 'kay'

// A chat that takes files: a message holds the images the visitor attached.
export const reply = action({ input: { messages: chatMessages({ maxItems: 50, attachments: { type: 'image/png' } }) }, maxSize: '2mb' }, ({ messages }) => ask(messages))
---
p Chat
