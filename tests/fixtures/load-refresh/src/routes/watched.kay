--- server
import { t } from 'elysia'
import { action } from 'kay'
import { run } from '../calls'
import Bump from '../components/bump.kay'
import Visitors from '../components/visitors.kay'
import { raise } from '../raise'

export const bump = action(t.Object({}), () => {
  raise()

  return 'ok'
})

const cart = await run('cart', n => ({ n }))
const wishlist = await run('wishlist', n => ({ n }))
---
main
  section.cart
    p.cart {cart.n}
    Visitors
  section.wishlist
    p.wish {wishlist.n}
    Bump(run={bump} loads="wishlist")
