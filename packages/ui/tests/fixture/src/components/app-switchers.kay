--- island
import type { SwitcherApp } from '@kaynooo/kayjs-ui'
import AppSwitcher from '@kaynooo/kayjs-ui/app-switcher.kay'

const apps: SwitcherApp[] = [
  { key: 'atlas', href: '/atlas', label: 'Atlas', icon: 'globe' },
  { key: 'aurora', href: '/aurora', label: 'Aurora' },
  { key: 'hubble', href: 'https://hubble.example.com/', label: 'Hubble', description: 'Telescope' },
  { key: 'relay', href: '/relay', label: 'Relay' },
  { key: 'sage', href: '/sage', label: 'Sage' },
]
---
AppSwitcher(id="plain" apps={apps} current="aurora")
AppSwitcher(id="named" apps={apps} label="Our apps" icon="plus" newTab)
AppSwitcher(id="custom" apps={apps.slice(0, 2)})
  @tile(app)
    em {app.label}!
AppSwitcher(id="trigger" apps={apps.slice(0, 2)})
  @trigger(attributes)
    button#switch({...attributes}) Switch
