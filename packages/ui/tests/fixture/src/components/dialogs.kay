---
import { ActionError, ApiError, signal } from 'kay'
import ConfirmDelete from '@kaynooo/kayjs-ui/confirm-delete.kay'
import Dialog from '@kaynooo/kayjs-ui/dialog.kay'
import Toaster from '@kaynooo/kayjs-ui/toaster.kay'

// What the test reads back: how often the dialog closed, and whether a delete failed or went through.
const { onClose, onDelete, dirty = false, apiRefusal } = props<{ onClose: () => void, onDelete: () => Promise<void>, dirty?: boolean, apiRefusal?: { status: number, message: string, answer?: unknown } }>()

const open = signal(false)
const bareOpen = signal(false)

// A delete made with `call()`, which throws ApiError for a refusal, built here so it is the class the library reads.
async function removeByApi() {
  if (apiRefusal)
    throw new ApiError(apiRefusal.status, apiRefusal.message, apiRefusal.answer)

  await onDelete()
}

// An archive the action's handler refuses, as `ctx.fail(409, { error })` reaches an island.
async function archive() {
  throw new ActionError(409, '', {}, { error: 'Still referenced' })
}
---
button#open(onClick={() => open.set(true)}) Open
Dialog#dialog(open={open()} title="Rename" dirty={dirty} onOpenChange={() => { open.set(false); onClose() }})
  @footer
    button#cancel.kui-btn(onClick={() => open.set(false)}) Cancel
  input#name(name="name")
ConfirmDelete(message="Delete this?" failure="Could not delete" onConfirm={removeByApi})
ConfirmDelete(message="Archive this?" failure="Could not archive" onConfirm={archive} label="Archive" refused={(data: { error?: string }) => data.error})
ConfirmDelete(message="Revoke this link?" failure="Could not revoke" onConfirm={onDelete} trigger="button" label="Revoke link" class="revoke")
ConfirmDelete(message="Rotating breaks every link." failure="Could not rotate" onConfirm={onDelete} trigger="link" label="Rotate link" title="Rotate link" confirmLabel="Rotate" pendingLabel="Rotating…" class="rotate")
ConfirmDelete(message="Its verdicts go with it." failure="Could not remove" onConfirm={onDelete} ask="inline" label="Remove")
ConfirmDelete(message="Unshare it?" failure="Could not unshare" onConfirm={onDelete} ask="inline" trigger="button" label="Unshare" class="unshare")
ConfirmDelete(message="Forget it?" failure="Could not forget" onConfirm={onDelete} ask="inline" trigger="link" label="Forget" class="forget")
ConfirmDelete(message="Save without your own IP?" failure="Could not save" success="Saved" onConfirm={onDelete} tone="neutral" trigger="button" label="Save" class="save")
ConfirmDelete(message="Tone?" failure="Could not" onConfirm={onDelete} class="v-plain")
ConfirmDelete(message="Tone?" failure="Could not" onConfirm={onDelete} variant="solid" class="v-solid")
ConfirmDelete(message="Tone?" failure="Could not" onConfirm={onDelete} variant="ghost" class="v-ghost")
ConfirmDelete(message="Tone?" failure="Could not" onConfirm={onDelete} variant="inline" class="v-inline")
ConfirmDelete(message="Tone?" failure="Could not" onConfirm={onDelete} tone="neutral" class="n-plain")
ConfirmDelete(message="Tone?" failure="Could not" onConfirm={onDelete} tone="neutral" variant="solid" class="n-solid")
ConfirmDelete(message="Tone?" failure="Could not" onConfirm={onDelete} tone="neutral" variant="ghost" class="n-ghost")
ConfirmDelete(message="Tone?" failure="Could not" onConfirm={onDelete} trigger="button" variant="ghost" class="n-button")
ConfirmDelete(message="Release it?" failure="Could not release" onConfirm={removeByApi} label="Release" refused={(data: { reason?: string }) => data.reason} class="release")
Toaster
button#open-bare(onClick={() => bareOpen.set(true)}) Open bare
Dialog#bare(open={bareOpen()} title="Bare" onOpenChange={() => bareOpen.set(false)})
  input#bare-name(name="bare")
