--- server
import { libraries } from '../../../content.config'
import { FORGE_ROOT, neighbours } from '../../../pages'

export const prerender = libraries

const library = await libraries.get(ctx.params.library) ?? ctx.notFound()
const { Content } = library
const sections = library.headings.filter(heading => heading.depth === 2 || heading.depth === 3)
const { previous, next } = neighbours(await libraries.all(), library.slug, slug => `/libraries/${slug}`)
---
---
import Pager from '../../../components/pager.kay'
import Toc from '../../../components/toc.kay'
---
head
  title {library.data.title} · kay
.page
  header.page-head
    p.eyebrow Library · {library.data.version}
    h1 {library.data.title}
  if sections.length > 0
    Toc(sections={sections})
  article.prose
    Content
  Pager(previous={previous} next={next} source={`${FORGE_ROOT}/${library.slug}/src/branch/main/llms.txt`})
