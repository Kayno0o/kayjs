---
import Stat from '@kayjs/ui/stat.kay'

// The inline pill, a tile, a tile whose figure is toned, a pill with a change, a link, and a link tile with a change.
---
Stat#plain(value={12} label="moons")
Stat#tile(value={12} label="moons" layout="tile")
Stat#toned(value="91%" label="load" layout="tile" tone="danger")
Stat#changed(value={12} label="moons" delta={{ value: '+3', label: 'vs last week' }})
Stat#linked(value={12} label="moons" href="/moons")
Stat#linkedChange(value={12} label="moons" href="/moons" layout="tile" delta={{ value: '+3', label: 'vs last week' }})
