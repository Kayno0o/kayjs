---
import { signal } from 'kay'
import TextInput from '@kayjs/ui/text-input.kay'

const title = signal('Moons of Jupiter')
const saved = signal('Moons of Jupiter')
---
.flex.max-w-sm.flex-col.gap-2
  TextInput(
    value={title()}
    onInput={({ value }) => title = value}
    onChange={({ value }) => saved = value}
    aria-label="Title"
  )
  p.text-muted Typed: {title()}. Saved on blur or Enter: {saved()}.
