{
  "name": "@kaynooo/kayjs-auth",
  "type": "module",
  "version": "0.10.0",
  "description": "Auth for kay apps on kay sessions: OAuth, passwords, two-factor, magic links and bearer tokens",
  "author": "Kaynooo <https://git.kaynooo.fr/kaynooo>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://git.kaynooo.fr/kaynooo/kayjs-auth"
  },
  "bugs": {
    "url": "https://git.kaynooo.fr/kaynooo/kayjs-auth/issues"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./rules": {
      "types": "./types/rules.d.ts",
      "default": "./src/rules.ts"
    },
    "./pg": {
      "types": "./types/pg.d.ts",
      "default": "./src/pg.ts"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "llms.txt",
    "src",
    "types"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "check": "$npm_execpath check",
    "build:types": "rm -rf types && tsgo -p tsconfig.build.json",
    "prepack": "bun run build:types",
    "postpack": "rm -rf types",
    "lint": "keslint --cache",
    "lint:fix": "keslint --fix --cache",
    "test": "bun test"
  },
  "peerDependencies": {
    "@kaynooo/pg-orm": "^7.0.0",
    "elysia": "^1.4.30",
    "kay": "^0.8.1 || ^0.9.0 || ^0.10.0 || ^0.11.0 || ^0.12.0 || ^0.13.0 || ^0.14.0 || ~1.0.0 || ~1.1.0 || ~1.2.0 || ~1.3.0 || ~1.4.0 || ~1.5.0 || ~1.6.0 || ~1.7.0 || ~1.8.0 || ~1.9.0 || ~1.10.0 || ~1.11.0 || ~1.12.0 || ~1.13.0 || ~1.14.0 || ~1.15.0 || ~1.16.0 || ~1.17.0 || ~1.18.0 || ~1.19.0 || ~1.20.0 || ~1.21.0 || ~1.23.0 || ~1.24.0 || ~1.25.0 || ~1.26.0 || ~1.27.0 || ~1.28.0 || ~1.29.0 || ~1.30.0 || ~1.31.0 || ~1.32.0 || ~1.33.0 || ~1.34.0 || ~1.35.0"
  },
  "peerDependenciesMeta": {
    "@kaynooo/pg-orm": {
      "optional": true
    }
  },
  "dependencies": {
    "@kaynooo/kayjs-ui": "^0.4.28 || ^0.5.0",
    "@kaynooo/utils": "^2.27.0",
    "@simplewebauthn/server": "^14.0.3",
    "jose": "^6.2.12",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@kaynooo/eslint": "^6.0.1",
    "@kaynooo/kayjs-mail": "^0.3.0",
    "@kaynooo/pg-orm": "^7.0.1",
    "@types/bun": "^1.4.2",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "elysia": "^1.4.30",
    "kay": "npm:@kaynooo/kayjs@~1.35.0",
    "typescript": "^6.0.3"
  }
}
