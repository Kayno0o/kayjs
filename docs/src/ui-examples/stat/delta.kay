---
import Stat from '@kaynooo/kayjs-ui/stat.kay'
---
.grid.grid-cols-3.gap-3
  Stat(variant="tile" value={12} label="errors" href="/errors" delta={{ value: '+12%', label: 'vs previous', tone: 'danger' }})
  Stat(variant="tile" value={340} label="visits" delta={{ value: '-4%', label: 'vs previous' }})
  Stat(variant="tile" value="99.9%" label="uptime" delta={{ value: '0%', label: 'vs previous', tone: 'success' }})
