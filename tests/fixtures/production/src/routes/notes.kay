--- server
import { t } from 'elysia'
import { action } from 'kay'

export const note = action(t.Object({ text: t.String({ maxLength: 4 * 1024 * 1024 }) }), ({ text }) => text.length)
export const attach = action({ input: t.Object({ text: t.String({ maxLength: 4 * 1024 * 1024 }) }), maxSize: 4 * 1024 * 1024 }, ({ text }) => text.length)

const failure = note.form.failed()
const sent = note.status() === 'ready'
---
form(action={note})
  textarea(name="text" aria-label="Text")
  button Send
if failure
  p.error {failure.status} {Object.values(failure.errors).join(' ')}
if sent
  p.sent Sent {note.data()}
