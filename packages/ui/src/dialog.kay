---
import type { JSX, Snippet } from 'kay'
import { effect, recipe, signal, uid } from 'kay'
import { wording } from 'kay/words'
import IconButton from './icon-button.kay'
import type { Discard } from './confirm'
import { closeWatcher, discardAndClose, followsHref, leave, renderedOpen, syncOpen } from './overlay'

// 'kui-dialog' stays as the component's name for an app's CSS and the always-hidden guard.
const look = recipe({
  parts: {
    root: 'kui-dialog m-auto flex max-h-[calc(100dvh-2rem)] w-full max-w-[min(42rem,calc(100vw-2rem))] flex-col overflow-hidden rounded-lg border-solid border-[length:var(--border-width)] border-border-strong bg-surface p-0 [&[open]:not(:modal)]:fixed [&[open]:not(:modal)]:inset-0 [&[open]:not(:modal)]:z-30 [&[open]:not(:modal)]:h-fit [&[open]:not(:modal):not([data-modal=false])]:shadow-[0_0_0_100vmax_rgb(0_0_0/0.5)]',
    head: 'flex shrink-0 items-center gap-2 border-b border-border px-5 py-3',
    title: 'min-w-0 flex-1 text-lg [font-weight:var(--font-weight-semibold)] tracking-label text-foreground [font-family:var(--font-label,inherit)] [text-transform:var(--label-case)]',
    // The body of a `bare` dialog writes data-bare too, as a child cannot read the attribute of its parent in a utility.
    body: 'min-h-0 flex-1 overflow-y-auto px-5 py-4 data-bare:overflow-hidden data-bare:p-0',
    footer: 'flex shrink-0 flex-wrap justify-end gap-2 border-t border-border px-5 py-4',
  },
  variants: {
    // The width, the one vocabulary of every overlay: `sm`, `md` (the default), `lg`, or `full`, which takes the whole viewport width and height less the margin, for content such as a canvas that fills the dialog.
    size: {
      sm: { root: 'max-w-[min(28rem,calc(100vw-2rem))]' },
      md: '',
      lg: { root: 'max-w-[min(72rem,calc(100vw-2rem))]' },
      full: { root: 'h-[calc(100dvh-2rem)] max-w-[calc(100vw-2rem)]' },
    },
  },
  defaults: { size: 'md' },
})

const { open, trigger, title, label, heading, level = 2, size = 'md', bare = false, dirty = false, autosave = false, discard, modal = true, closeHref, actions, header, close, closeLabel = wording('ui.dialog.close', 'Close'), onOpenChange, footer, ...rest } = props<Omit<JSX.IntrinsicElements['dialog'], 'open' | 'class' | 'title' | 'onClose' | 'onInput' | 'closedby' | 'closedBy'> & {
  // Shows the dialog, as a modal unless `modal` is false; the parent sets it back to false in `onOpenChange`. Left out, the dialog keeps its own state, opened by `trigger`.
  open?: boolean | undefined
  // Renders what opens the dialog when `open` is left to the component: `@trigger(attributes)`, then `button({...attributes})`.
  trigger?: Snippet<[attributes: { 'onClick': () => void, 'aria-haspopup': 'dialog' }]> | undefined
  // The heading, and the dialog's name for screen readers. A `@title` block draws markup in its place, such as an icon, a status badge or an emphasised name: the dialog is then named by that heading's text, or by `label`.
  title: string | Snippet
  // The dialog's name for screen readers when it differs from the visible title, such as a short name beside a `@title` full of markup.
  label?: string | undefined
  // @deprecated Use a `@title` block, with `label` for the string that named the dialog; `deprecated-ui-props` rewrites it. Removed in 2.0.0.
  heading?: Snippet
  // The title's heading level: a modal opens over the page's own `h1`.
  level?: 2 | 3 | 4 | 5 | 6 | undefined
  // No inset or scroll on the body, for content that runs to the dialog's edge; the title and footer keep theirs.
  bare?: boolean | undefined
  // Work the dialog must not drop, such as a request in flight: a click outside, Escape and the close button leave it open. Typing is not that: it asks first, see `discard`.
  dirty?: boolean | undefined
  // What a modal dialog asks (`confirm()`, `danger`) when Escape, a click outside or the close button would drop typed text: `{ title, message, confirmLabel, cancelLabel }` to word it, `false` to lock the close instead, as before 1.100. Not asked with `autosave`, or while `dirty`.
  discard?: Discard | undefined
  // Fields inside save as they are typed, so typing does not lock the close: a click outside and Escape close the dialog as before anything was typed. `dirty` still locks it.
  autosave?: boolean | undefined
  // `false` shows the dialog over the page without blocking it: the page stays interactive, a click outside leaves it open and only Escape or the close control closes it. It renders open on the server, so a page driven by the URL shows it with no JavaScript.
  modal?: boolean | undefined
  // Controls in the head line, before its close button, such as previous and next.
  actions?: Snippet
  // The whole head line in place of the title, `actions` and the close button.
  header?: Snippet
  // The close button in place of the library's own: it closes by `onOpenChange(false)`, or by going to `closeHref`.
  close?: Snippet
  closeLabel?: string | undefined
  footer?: Snippet
} & (
  // Makes the close control a link to this URL, for a dialog open on the server whose close needs no JavaScript; the link navigates and `onOpenChange(false)` is called as well, so its handler need not navigate. Without an `onOpenChange`, Escape follows it too, so a server page renders the dialog with no island of its own.
  | { closeHref: string, onOpenChange?: undefined }
  // Called with `true` when `trigger` opens it and with `false` however the dialog closes, a click outside and Escape included. Closed by Escape or a click outside, its content is still there to read; closed by the parent setting `open` to false, it is already gone.
  | { closeHref?: string | undefined, onOpenChange?: ((open: boolean) => unknown) | undefined }
)>()

// The state of a dialog the app leaves to the component: `open` wins when given. Every close, the guarded ones too, ends in `closed()`, which comes here.
const inner = signal(false)
const isOpen = () => open ?? inner()

function change(next: boolean) {
  if (open === undefined) {
    if (inner() === next)
      return

    inner = next
  }

  onOpenChange?.(next)
}

const opener = { 'onClick': () => change(true), 'aria-haspopup': 'dialog' } as const

// The name a screen reader announces: `label`, else a string title; a markup title names the dialog through its heading, which a `header` block replaces: that one needs a `label`.
const name = () => label ?? (typeof title === 'string' ? title : undefined)
const titleId = uid()

// Set by any typing inside, and cleared however the dialog closes, since every way ends in its `close` event.
const edited = signal(false)
let dialog: HTMLDialogElement | undefined

// Read once: the open attribute is what the server renders, and the client opens and closes the dialog by its methods.
const serverOpen = renderedOpen(isOpen(), modal, closeHref)

effect(() => {
  const shown = isOpen()

  if (dialog)
    syncOpen(dialog, shown, modal)
})

// Typed text a modal dialog would lose is asked about first.
const guarded = () => edited() && modal && !autosave && !dirty && discard !== false

function closed() {
  edited = false
  if (followsHref(closeHref, onOpenChange)) {
    // A client-side navigation may keep this instance, so an own state is reset too.
    if (open === undefined)
      inner = false

    leave(closeHref, onOpenChange)
  }
  else
    change(false)
}

// Escape, which the dialog hears itself while typed text is at stake.
function cancelled(event: Event) {
  if (!guarded())
    return

  event.preventDefault()
  void discardAndClose(dialog, discard || undefined)
}

// A click on the backdrop, which the browser leaves alone while the close is guarded.
// The keydown comes first and stops the browser's own close, which a second Escape with no click or key between would otherwise take for an uncancellable request.
function pressed(event: KeyboardEvent) {
  // An Escape an inner control used, such as to close its own list, is not a request to close this.
  if (event.key === 'Escape' && !event.defaultPrevented && !event.isComposing)
    cancelled(event)
}

function clicked(event: MouseEvent) {
  if (event.target === dialog && guarded())
    void discardAndClose(dialog, discard || undefined)
}

function leaving() {
  if (followsHref(closeHref, onOpenChange))
    return

  if (guarded())
    void discardAndClose(dialog, discard || undefined)
  else
    dialog?.close()
}
---
if trigger
  | {trigger(opener)}
// Named by its title for screen readers, which announce the dialog as it opens.
dialog(part="root" aria-label={name()} aria-labelledby={name() === undefined && !header ? titleId : undefined} {...rest} open={serverOpen} data-modal={modal ? undefined : 'false'} data-size={size === 'md' ? undefined : size} data-bare={bare ? '' : undefined} ref={element => dialog = element} closedby={closeWatcher({ modal, dirty, autosave, edited: edited(), footer: footer !== undefined, guarded: guarded() })} onInput={() => edited = true} onCancel={event => { rest.onCancel?.(event); cancelled(event) }} onClick={event => { rest.onClick?.(event); clicked(event) }} onKeyDown={event => { rest.onKeyDown?.(event); pressed(event) }} onClose={closed})
  if isOpen()
    header(part="head")
      if header
        | {header}
      else
        if level === 2
          h2(part="title" id={name() === undefined ? titleId : undefined}) {heading ?? title}
        else if level === 3
          h3(part="title" id={name() === undefined ? titleId : undefined}) {heading ?? title}
        else if level === 4
          h4(part="title" id={name() === undefined ? titleId : undefined}) {heading ?? title}
        else if level === 5
          h5(part="title" id={name() === undefined ? titleId : undefined}) {heading ?? title}
        else
          h6(part="title" id={name() === undefined ? titleId : undefined}) {heading ?? title}
        | {actions}
        if close
          | {close}
        else
          IconButton(icon="close" label={closeLabel} variant="ghost" href={closeHref} disabled={dirty} onClick={leaving})
    div(part="body" data-bare={bare ? '' : undefined})
      slot
    if footer
      div(part="footer")
        | {footer}
