--- island
import { signal } from 'kay'
import BellInbox from '@kayjs/ui/bell-inbox.kay'

const open = signal(false)
const log = signal<string[]>([])
---
button#show(onClick={() => open = true}) Show
BellInbox(items={[{ key: 'a', label: 'Deploy done' }, { key: 'b', label: 'Review asked' }]} open={open()} onOpenChange={shown => { open = shown; log = [...log(), String(shown)] }})
  @trigger(attributes, unread)
    button#bell({...attributes}) Inbox ({unread()})
p#log {log().join(',')}
