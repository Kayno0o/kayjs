---
import { recipe } from 'kay'
import type { JSX, Snippet } from 'kay'
import type { NavLink } from './defaults'
import SiteNav from './site-nav.kay'

// 'kui-app-header' stays as the component's name for an app's CSS. A long brand or end area wraps inside its box rather than push the bar past the screen, and the nav comes after the brand in the tab order and on screen, so the menu button comes before the end area; with no end area it takes the far end.
const look = recipe({
  parts: {
    root: 'kui-app-header flex items-center gap-4 border-b border-border bg-background px-4 py-2 data-sticky:sticky data-sticky:top-0 data-sticky:z-20',
    brand: 'flex min-w-0 items-center gap-2 [font-weight:var(--font-weight-semibold)] text-foreground [overflow-wrap:anywhere]',
    nav: 'last:ml-auto lg:last:ml-0',
    end: 'ml-auto flex min-w-0 items-center gap-2 [overflow-wrap:anywhere]',
  },
})

const { links, current, label, menuLabel, brand, end, sticky = true, ...rest } = props<Omit<JSX.IntrinsicElements['header'], 'class' | 'children'> & {
  links: readonly NavLink[]
  // The path of the page on screen, as for `SiteNav`.
  current: string | URL
  // Names the navigation for screen readers.
  label: string
  // Names the button opening the links on a narrow screen.
  menuLabel?: string | undefined
  // At the start: a logo and the site's name, usually a link home.
  brand?: Snippet
  // At the far end: a user menu, a theme toggle.
  end?: Snippet
  // Stays at the top of the page while it scrolls; `false` lets it scroll away.
  sticky?: boolean | undefined
}>()
---
// The bar across the top of an app: its brand, its main links, which fold into a menu on a narrow screen, and an area at the far end.
header(part="root" {...rest} data-sticky={sticky ? '' : undefined})
  if brand
    div(part="brand")
      | {brand}
  SiteNav(links={links} current={current} label={label} menuLabel={menuLabel} part="nav")
  if end
    div(part="end")
      | {end}
