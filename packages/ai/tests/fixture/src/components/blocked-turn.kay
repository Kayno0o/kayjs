--- island
import { blocked } from '../routes/tools.kay'
import Chat from '@kayjs/ai/chat.kay'
---
Chat(action={blocked} label="Assistant" regenerate)
  @turn(turn, index)
    div.card(data-index={index} data-pending={turn.pending ? '' : undefined} data-calls={turn.calls.length} data-stopped={turn.stopped ? '' : undefined}) {turn.role}: {turn.content}
