# Copy to .env for `kay dev`; production sets these on the app's service, as compose.prod.yaml does.
# KAY_SECRET is optional here, as development derives one; production needs at least 32 characters kept out of the repository: `bun -e "console.log(crypto.randomUUID() + crypto.randomUUID())"`.
KAY_SECRET=
# The public origin mailed links start with.
SITE_URL=http://localhost:3000
DATABASE_URL=postgres://app:app@127.0.0.1:5433/noticeboard
COMPOSE_FILE=compose.dev.yaml
