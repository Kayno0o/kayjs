---
import type { JSX } from 'kay'
import { effect, postedChecked, recipe, uid, untrack } from 'kay'
import { controlledCheckbox } from './controlled-checkbox'
import { CHECKBOX, FIELD_MESSAGE, fieldInvalid, keepInvalid } from './field-look'
import { fieldIssueList, fieldNamed } from './forms'
import { without } from './props-without'

const look = recipe({ parts: { root: CHECKBOX.root, input: CHECKBOX.input, label: CHECKBOX.label, hint: CHECKBOX.hint, field: 'inline-flex flex-col items-start gap-1', issues: FIELD_MESSAGE.issues, issue: FIELD_MESSAGE.issue } })

const given = props<Omit<JSX.IntrinsicElements['input'], 'type' | 'checked' | 'class' | 'children' | 'onChange'> & {
  // Whether it starts ticked; a box whose parent passes another value follows it. Inside a form posting to an action, a box with no `onChange` takes the refused post's choice in its place.
  checked?: boolean | undefined
  // Neither ticked nor not, for a box standing over a partly ticked set; a click toggles it from `checked`, and the box stays drawn so while the parent keeps it.
  indeterminate?: boolean | undefined
  // Names the box, and is written next to it unless `showLabel` is false; omit it and pass `aria-label` instead to leave it unnamed here.
  label?: string | undefined
  // Whether `label` is written as text. On by default; off keeps it for screen readers only, as an `aria-label`.
  showLabel?: boolean | undefined
  // A note after the label, quieter: a count, a shortcut, a code name.
  hint?: string | number | undefined
  // The field the box posts as: inside a FormDialog, the message its call was refused with for that field shows under the box, as a FormField shows it.
  name?: string | undefined
  // A message of the page's own, such as `add.error('terms')` after a plain form post, shown under the box.
  issue?: string | undefined
  // Marks the box as refused, in the danger colour with `aria-invalid`. A message shown for the box marks it on its own.
  invalid?: boolean | undefined
  // Requires the box be ticked to submit: the native `required`, which the browser's validation and a post with no JavaScript know.
  required?: boolean | undefined
  // A promise holds the box busy until it settles, and puts it back where it was when it rejects (logged) or resolves to false: a refused change never shows as made.
  // Typed `unknown`, so a callback answering something else, such as `list.push`, still fits.
  onChange?: ((checked: boolean) => unknown) | undefined
}>()

// Read through `given`, never destructured, so each prop stays live; `name` is read once, as the field a control posts as.
const name = given.name
const rest = without(given, 'checked', 'indeterminate', 'label', 'showLabel', 'hint', 'name', 'issue', 'invalid', 'onChange', 'class', ...look.variants)
const showLabel = given.showLabel ?? true

let box: HTMLInputElement | undefined

const sent = given.onChange ? undefined : postedChecked(name, rest.value as string | number | undefined, given.checked ?? false)
// Whether the page passed `issue` or `invalid`, even as undefined for now, as `issue={add.error('terms')}` does.
const shown = name !== undefined || 'issue' in given
const checking = shown || 'invalid' in given
// A FormField naming the same field shows its messages itself.
const framed = checking ? fieldNamed.use() : undefined
const found = checking ? fieldIssueList(() => framed?.() === name ? undefined : name, () => given.issue) : () => []
const messages = () => found().map(item => item.message)
const marked = () => given.invalid === true || messages().length > 0
const issuesId = shown ? uid() : ''

const { on, busy, ref, change } = controlledCheckbox({
  control: 'Checkbox',
  checked: () => sent ?? given.checked ?? false,
  onChange: () => given.onChange,
  start: (element) => {
    box = element
    element.indeterminate = untrack(() => given.indeterminate ?? false)
    if (checking)
      keepInvalid(element, marked)
  },
  // The click cleared it, whatever the parent still says.
  settled: input => input.indeterminate = given.indeterminate ?? false,
  appRef: rest.ref,
})

// A property only, which no attribute sets.
effect(() => {
  if (box)
    box.indeterminate = given.indeterminate ?? false
})
---
// A native checkbox, so it submits inside a form and the keyboard and screen readers know it. A click while a change is under way ticks nothing.
snippet control()
  label(part="root")
    input({...rest} aria-label={rest['aria-label'] || (showLabel ? undefined : given.label)} name={name} part="input" ref={ref} type="checkbox" checked={on()} aria-invalid={fieldInvalid(marked) ?? rest['aria-invalid']} aria-describedby={[rest['aria-describedby'], messages().length > 0 ? issuesId : undefined].filter(id => id).join(' ') || undefined} aria-busy={busy() ? 'true' : undefined} onClick={event => { if (busy()) event.preventDefault() }} onChange={event => change(event.currentTarget)})
    if given.label && showLabel
      span(part="label") {given.label}
    if given.hint !== undefined
      span(part="hint") {given.hint}
if shown
  div(part="field" data-kui-control="checkbox")
    {control()}
    span(part="issues" id={messages().length > 0 ? issuesId : undefined} aria-live="polite" data-field={name})
      for item, index of found() key={index}
        span(part="issue" data-form-issue={item.form ? '' : undefined}) {item.message}
else
  {control()}
