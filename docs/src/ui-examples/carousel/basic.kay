---
import Carousel from '@kaynooo/kayjs-ui/carousel.kay'

// Plain colored panels standing in for photos.
const panel = (color: string) => `data:image/svg+xml,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" width="640" height="360"><rect width="640" height="360" fill="${color}"/></svg>`)}`

const slides = [
  { src: panel('#6d8f7a'), alt: 'A green panel' },
  { src: panel('#7a86b8'), alt: 'A blue panel' },
  { src: panel('#c08a6a'), alt: 'An orange panel' },
]
---
.max-w-md
  Carousel(slides={slides} label="Panels")
