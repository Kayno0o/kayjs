---
import TabNav from '@kaynooo/kayjs-ui/tab-nav.kay'

const links = ['profile', 'keys', 'billing', 'danger'].map(name => ({ href: `/settings/${name}`, label: name }))
---
TabNav#tabs(links={links} current="/settings/billing" label="Settings")
TabNav#kept(links={links} current={new URL('https://example.com/settings/keys?period=7d&page=2')} keep={['period']} label="Kept")
TabNav#sub(links={[{ href: '/traffic', label: 'Traffic', prefix: true }, { href: '/logs', label: 'Logs', also: ['/logs/archive'] }]} current={new URL('https://example.com/traffic/requests/4?period=7d')} label="Sub-pages")
