---
import type { CustomFieldProps } from '@kayjs/cms'
import FormField from '@kayjs/ui/form-field.kay'

const { value, onChange, label, hint, issue, required } = props<CustomFieldProps>()
---
FormField(label={label} hint={hint} issue={issue} required={required})
  input.swatch(type="color" value={typeof value === 'string' ? value : '#000000'} onInput={event => onChange(event.currentTarget.value)})
