---
import LineChart from '@kaynooo/kayjs-ui/line-chart.kay'

const labels = ['2026-09-01', '2026-09-02', '2026-09-03', '2026-09-04', '2026-09-05', '2026-09-06', '2026-09-07']
const series = [
  { name: 'Visits', values: [120, 180, 150, 210, 260, 190, 240] },
  { name: 'Sign-ups', values: [40, 62, null, 75, 110, 70, 96] },
]
---
.max-w-xl
  LineChart(label="Visits and sign-ups in the first week of September" labels={labels} series={series} xLabels)
