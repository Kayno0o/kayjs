---
import { memo, signal } from 'kay'

const { topics, current } = props<{ topics: { href: string, title: string }[], current: string }>()
const query = signal('')
const shown = memo(() => topics.filter(topic => topic.title.toLowerCase().includes(query().trim().toLowerCase())))
---
input(type="search" aria-label="Filter the reference" placeholder="Filter" bind:value={query})
ul
  for topic of shown key={topic.href}
    li
      a(href={topic.href} aria-current={topic.href === current ? 'page' : undefined}) {topic.title}
  else
    li.none Nothing matches
