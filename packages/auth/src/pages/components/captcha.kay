---
import type { CaptchaAction, CaptchaWidget } from '../../captcha'
import { wording } from 'kay/words'

const { widget, challenge = null, action } = props<{ widget: CaptchaWidget | 'proof-of-work', challenge?: string | null, action: CaptchaAction }>()
---
// Kay's script solves the challenge while the form is filled in and posts the solution in this field's place; without JavaScript it posts empty.
if widget === 'proof-of-work'
  if challenge
    input(type="hidden" name="kayjs-captcha" data-kay-work={challenge})
    noscript
      p.text-sm {wording('auth.errors.captchaScript', 'This form runs a check in your browser, which needs JavaScript: turn it on, then send it again.')}
else
  // The provider's script fills the element and adds the field its token posts as; Turnstile hands the action back, which the check compares.
  div(class={widget.class} data-sitekey={widget.siteKey} data-action={action})
  script(src={widget.script} async defer)
