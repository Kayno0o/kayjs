{
  "publisher": "kaynooo",
  "name": "kay",
  "displayName": "Kay",
  "version": "1.70.0",
  "description": "Language support for .kay components: highlighting, diagnostics, hover, completion, go-to-definition and formatting through the kay language server",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kayno0o/kayjs",
    "directory": "editors/vscode"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.91.0"
  },
  "activationEvents": [
    "onLanguage:kay",
    "workspaceContains:**/kay.config.ts"
  ],
  "contributes": {
    "languages": [
      {
        "id": "kay",
        "aliases": [
          "Kay",
          "kay"
        ],
        "extensions": [
          ".kay"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "title": "Kay",
      "properties": {
        "kay.bun.path": {
          "type": "string",
          "default": "bun",
          "description": "The Bun executable that runs the language server."
        },
        "kay.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to the kay CLI, absolute or relative to the workspace. Empty uses the workspace's node_modules/kay, or src/cli.ts inside the kay repository itself."
        },
        "kay.routes": {
          "type": "string",
          "default": "",
          "description": "Directory of the pages, relative to the workspace, so route params and links are typed. Empty takes the project's kay.config.ts, else src/routes."
        },
        "kay.lsp.trace": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the messages between the editor and the language server into its output."
        },
        "kay.dev.url": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "The address Kay: Open the dev server opens, the one kay dev listens on."
        }
      }
    },
    "grammars": [
      {
        "language": "kay",
        "scopeName": "source.kay",
        "path": "./syntaxes/kay.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.typescript": "typescript",
          "meta.embedded.expression.kay": "typescript"
        }
      }
    ],
    "commands": [
      {
        "command": "kay.restartServer",
        "title": "Restart the language server",
        "category": "Kay"
      },
      {
        "command": "kay.check",
        "title": "Run kay check",
        "category": "Kay"
      },
      {
        "command": "kay.openDevServer",
        "title": "Open the dev server",
        "category": "Kay"
      },
      {
        "command": "kay.showOutput",
        "title": "Show the output",
        "category": "Kay"
      }
    ],
    "snippets": [
      {
        "language": "kay",
        "path": "./snippets/kay.json"
      }
    ]
  },
  "scripts": {
    "build": "bun build.ts",
    "check": "bun ../../src/tsgo.ts --noEmit -p tsconfig.json",
    "package": "bun build.ts && bunx @vscode/vsce@4.0.0 package --no-dependencies -o kay.vsix",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/vscode": "~1.91.0",
    "vscode-languageclient": "10.1.2",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  },
  "homepage": "https://kayjs.kaynooo.fr",
  "keywords": [
    "kay",
    "kayjs",
    "bun",
    "pug",
    "template"
  ]
}
