---
import Checkbox from '@kayjs/ui/checkbox.kay'
import ChipGroup from '@kayjs/ui/chip-group.kay'
import Segmented from '@kayjs/ui/segmented.kay'
import Toggle from '@kayjs/ui/toggle.kay'

// Controls whose `onChange` the test answers, kept off the page's signals so a refused change is put back by the control itself.
const { answer } = props<{ answer: (name: string, value: unknown) => unknown }>()

const decks = [{ value: 'films', label: 'Films' }, { value: 'games', label: 'Games' }] as const
const sizes = [{ value: 's', label: 'S' }, { value: 'm', label: 'M' }, { value: 'l', label: 'L' }] as const
---
form#form
  Checkbox(name="agree" label="Agree" checked onChange={({ checked: value }) => answer('agree', value)})
  Toggle(name="power" label="Power" onChange={({ checked: value }) => answer('power', value)})
  ChipGroup(label="Decks" name="decks" options={decks} value={['films']} onChange={({ value }) => answer('decks', value)})
  Segmented(label="Size" name="size" options={sizes} value="m" onChange={({ value }) => answer('size', value)})
  Segmented(label="Sort" name="sort" options={sizes} value={null} onChange={({ value }) => answer('sort', value)})
  button#reset(type="reset") Reset
