{
  "name": "@kaynooo/kayjs-ai",
  "type": "module",
  "version": "1.69.0",
  "description": "Call an LLM from kay apps with no SDK and no streaming code: Anthropic and OpenAI-compatible providers over HTTP, replies that stream into await blocks and actions, and a scripted fake in development and tests",
  "author": "Kaynooo <https://github.com/Kayno0o>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kayno0o/kayjs",
    "directory": "packages/ai"
  },
  "bugs": {
    "url": "https://github.com/Kayno0o/kayjs/issues"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/"
  },
  "exports": {
    "./add": "./src/add.ts",
    "./chat.kay": "./src/chat.kay",
    "./chat-launcher.kay": "./src/chat-launcher.kay",
    "./chat-calls.kay": "./src/chat-calls.kay",
    "./chat-panel.kay": "./src/chat-panel.kay",
    "./test": "./src/test.ts",
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "THIRD-PARTY-NOTICES.md",
    "llms",
    "llms.txt",
    "src",
    "types"
  ],
  "kay": {
    "messages": "./src/messages"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "prepare": "$npm_execpath ../../scripts/link-fixture.ts",
    "check": "$npm_execpath check",
    "build:types": "rm -rf types && bun ../../src/tsgo.ts -p tsconfig.build.json",
    "prepack": "bun run build:types",
    "postpack": "rm -rf types",
    "prelint": "bun run --cwd ../.. build:eslint",
    "lint": "keslint --cache",
    "prelint:fix": "bun run --cwd ../.. build:eslint",
    "lint:fix": "keslint --fix --cache",
    "test": "bun test --timeout 20000"
  },
  "peerDependencies": {
    "@kaynooo/kayjs-ui": "workspace:~",
    "kay": "~1.69.0"
  },
  "peerDependenciesMeta": {
    "@kaynooo/kayjs-ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@iconify-json/tabler": "^1.2.42",
    "@kaynooo/eslint": "^7.0.4",
    "@kaynooo/kayjs-ui": "workspace:~",
    "@types/bun": "^1.4.3",
    "typescript": "^6.0.3"
  }
}
