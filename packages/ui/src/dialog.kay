---
import type { JSX } from 'kay'
import { effect, signal } from 'kay'

const { open, title, dirty = false, onClose, footer, class: className, ...rest } = props<Omit<JSX.IntrinsicElements['dialog'], 'open' | 'class' | 'onClose' | 'onInput' | 'closedby' | 'closedBy'> & {
  // Shows the dialog as a modal; the parent sets it back to false in `onClose`.
  open: boolean
  title: string
  // Work the dialog must not drop, such as a request in flight: a click outside or Escape leaves it open. Typing inside the dialog counts on its own.
  dirty?: boolean
  // Called however the dialog closes, a click outside and Escape included. Closed by Escape or a click outside, its content is still there to read; closed by the parent setting `open` to false, it is already gone.
  onClose: (event: Event) => void
  footer?: JSX.Element
  class?: string
}>()

// Set by any typing inside, and cleared however the dialog closes, since every way ends in its `close` event.
const edited = signal(false)
let dialog: HTMLDialogElement | undefined

effect(() => {
  const shown = open

  if (!dialog)
    return

  if (shown && !dialog.open)
    dialog.showModal()
  else if (!shown && dialog.open)
    dialog.close()
})

function closed(event: Event) {
  onClose(event)
  edited.set(false)
}
---
// Named by its title for screen readers, which announce the dialog as it opens.
dialog.kui-dialog(aria-label={title} {...rest} ref={element => dialog = element} closedby={dirty || edited() ? 'none' : 'any'} onInput={() => edited.set(true)} onClose={closed} class={className})
  if open
    h3.kui-dialog-title {title}
    .kui-dialog-body
      slot
    if footer
      .kui-dialog-footer
        | {footer}
