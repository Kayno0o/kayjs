---
import { navigate, signal } from 'kay'
import { bump, join } from '../routes/index.kay'

const calls = signal(0)

async function away() {
  await bump({})
  await navigate('/other')
}

async function call() {
  calls.set(count => count + 1)

  try {
    await join({ email: 'x' })
  }
  catch {
    calls.set(count => count + 1)
  }
}
---
form.signup(action={join})
  input(name="email")
  if join.error('email') as message
    p.signup-error {message}
  error.joined email
  button.post(formnovalidate) Join
  button.call(type="button" onClick={call} data-calls={calls()}) Call
button.bump(type="button" onClick={() => void bump({})}) Bump
button.quiet(type="button" onClick={() => void bump({}, { refresh: false })}) Quiet
button.away(type="button" onClick={away}) Away
