--- server
import { contactForm, mailer } from '@kaynooo/kayjs-mail'

const unconfigured = mailer({ from: 'Fixture <hello@fixture.test>', optional: true })
const down = mailer({ from: 'Fixture <hello@fixture.test>', transport: { send: () => Promise.reject(new Error('connection refused')) } })

export const noRecipient = action(...contactForm(unconfigured, { reach: 'hello@fixture.test' }))
export const serverDown = action(...contactForm(down, { to: 'team@fixture.test' }))
---
form(action={noRecipient} novalidate)
  input(field="name" aria-label="Name")
  input(field="email" aria-label="Email")
  textarea(field="message" aria-label="Message")
form(action={serverDown} novalidate)
  input(field="name" aria-label="Name")
  input(field="email" aria-label="Email")
  textarea(field="message" aria-label="Message")
