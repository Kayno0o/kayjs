--- server
import { shareCard } from 'kay/image'
import { reference } from '../../../content.config'
import { FORGE } from '../../../forge'
import { libraryRoot, neighbours } from '../../../pages'
import { llmsHref } from '../../../reference'

export const page = {
  prerender: async () => {
    return (await reference.all()).map(topic => topic.slug === 'overview' ? {} : { topic: topic.slug })
  },
  // Written for agents: its hits come after the pages written for people.
  search: { weight: 0.25 },
}

const topic = await reference.get(ctx.params.topic ?? 'overview') ?? ctx.notFound()
const { Content } = topic
const sections = topic.headings.filter(heading => heading.depth === 2 || heading.depth === 3)
const { previous, next } = neighbours(await reference.all(), topic.slug, llmsHref)
const { version } = topic.data
const source = version !== undefined ? `${libraryRoot(topic.slug)}/llms.txt` : topic.slug === 'overview' ? `${FORGE}/llms.txt` : `${FORGE}/llms/${topic.slug}.md`
--- script
import Pager from '../../../components/pager.kay'
import Toc from '../../../components/toc.kay'
---
head
  title {topic.data.title} · Full reference · kay
  meta(property="og:image" content={shareCard({ title: topic.data.title })})
  meta(property="og:image:alt" content={topic.data.title})
.page
  header.page-head
    p.eyebrow
      | Full reference
      if version as published
        |  · {published}
    h1 {topic.data.title}
    p.lede Every option and edge case, written for coding agents as much as for people. For the common path, start from the #[a(href="/getting-started/introduction") guide].
  if sections.length > 0
    Toc(sections={sections})
  article.prose
    Content
  Pager(previous={previous} next={next} source={source})
