--- server
import { action } from 'kay'
import { formatDate, localize } from 'kay/i18n'
import { durationWords } from 'kay/library'
import { wording } from 'kay/words'
import Message from '../../components/message.kay'
import Proof from '../../components/proof.kay'
import { failure, proofOf, schemas } from '../../forms'
import Button from '@kaynooo/kayjs-ui/button.kay'
import PageSection from '@kaynooo/kayjs-ui/page-section.kay'

// Re-proves the user, so the export link below shows for the next ten minutes.
export const prove = action(schemas.proof, async (input, ctx) => {
  const result = await ctx.locals.auth.reprove(proofOf(input))

  return !result.ok ? ctx.fail(400, { error: result.error.code }) : undefined
})

export const remove = action(schemas.proof, async (input, ctx) => {
  const result = await ctx.locals.auth.account.delete(proofOf(input))

  if (!result.ok)
    return ctx.fail(400, { error: result.error.code })

  const { pages, prefix } = ctx.locals.auth.features()

  // A deletion left pending keeps the user signed in, on the page that offers to cancel it.
  return ctx.redirect(localize(result.deleteAt === undefined ? pages?.home ?? '/' : `${pages?.prefix ?? prefix}/account/data`))
})

export const cancelPending = action(async (ctx) => {
  const { pages, prefix } = ctx.locals.auth.features()

  await ctx.locals.auth.account.cancelDeletion()

  return ctx.redirect(localize(`${pages?.prefix ?? prefix}/account/data`))
})

// An account with neither a password nor a second factor proves it is still the user by a recent sign-in alone, so it signs in again and comes back here.
export const signInAgain = action(async (ctx) => {
  const { signInPage, pages, prefix } = ctx.locals.auth.features()
  const signIn = localize(signInPage)

  await ctx.locals.auth.signOut()

  return ctx.redirect(`${signIn}${signIn.includes('?') ? '&' : '?'}redirect=${encodeURIComponent(localize(`${pages?.prefix ?? prefix}/account/data`))}`)
})

const auth = ctx.locals.auth
const user = await auth.requireUser()
const features = auth.features()
const refused = remove.failed()?.data?.error
const notProved = prove.failed()?.data?.error
const proved = await auth.provedLately()
// Neither proof form can pass: an admin acting as the user proves nothing, and an account with nothing to prove it by has only its sign-in, now old.
const impersonated = await auth.impersonator() !== null
const impact = await auth.account.deletionImpact()
const stale = !proved && !user.hasPassword && !user.twoFactor
const pending = await auth.account.deletion()
const deleteIntro = features.deleteAfter === null
  ? wording('auth.account.data.deleteIntro', 'Your account and everything tied to it are deleted for good. This cannot be undone.')
  : wording('auth.account.data.deleteGraceIntro', 'Your account and everything tied to it are deleted for good {after} from now. Until then you can cancel, and signing in is enough to reach the button.', { after: durationWords(`${features.deleteAfter}s`, ctx.locale) })
---
if impersonated
  p {failure('impersonating')}
else
  PageSection(title={wording('auth.account.data.export', 'Download your data')})
    .flex.flex-col.items-start.gap-3
      p {wording('auth.account.data.exportIntro', 'Everything we keep about your account, as a JSON file.')}
      if proved
        Button(href={`${features.prefix}/export`} label={wording('auth.account.data.export', 'Download your data')} download data-no-prefetch)
      else if stale
        form.flex.flex-col.items-start.gap-3(action={signInAgain})
          p {wording('auth.proof.stale', 'For your safety, sign in again before doing this.')}
          Button(type="submit" label={wording('auth.proof.signInAgain', 'Sign in again')})
      else
        form.flex.flex-col.gap-3(action={prove})
          Proof(user={user})
          if notProved
            Message(text={failure(notProved)})
          Button(type="submit" label={wording('auth.account.data.confirmExport', 'Confirm to download my data')})
  PageSection(title={wording('auth.account.data.delete', 'Delete your account')})
    if pending
      form.flex.flex-col.items-start.gap-3(action={cancelPending})
        p {wording('auth.account.data.deletePending', 'Your account will be deleted on {date}.', { date: formatDate(pending.deleteAt, { dateStyle: 'long' }) })}
        Button(type="submit" label={wording('auth.deletion.cancel', 'Cancel the deletion')})
    else if stale
      form.flex.flex-col.items-start.gap-3(action={signInAgain})
        p {deleteIntro}
        if impact.deleted.length > 0
          p {wording('auth.account.data.deleteOrganizations', 'These organizations are deleted with it, as you are their only member: {names}.', { names: impact.deleted.join(', ') })}
        if impact.blocked.length > 0
          p {wording('auth.account.data.deleteBlocked', 'You are the only owner of {names}: make another member an owner first.', { names: impact.blocked.join(', ') })}
        p {wording('auth.proof.stale', 'For your safety, sign in again before doing this.')}
        Button(type="submit" label={wording('auth.proof.signInAgain', 'Sign in again')})
    else
      form.flex.flex-col.gap-3(action={remove})
        p {deleteIntro}
        if impact.deleted.length > 0
          p {wording('auth.account.data.deleteOrganizations', 'These organizations are deleted with it, as you are their only member: {names}.', { names: impact.deleted.join(', ') })}
        if impact.blocked.length > 0
          p {wording('auth.account.data.deleteBlocked', 'You are the only owner of {names}: make another member an owner first.', { names: impact.blocked.join(', ') })}
        Proof(user={user})
        if refused
          Message(text={failure(refused)})
        Button(type="submit" tone="danger" label={wording('auth.account.data.confirmDelete', 'Delete my account')})
