--- server
import { s } from 'kay'
import { invalidatePage } from 'kay/server'
import { news } from '../news'

export const page = {
  prerender: true,
  revalidate: 60,
}

export const publish = action(s.Object({ edition: s.Integer({ minimum: 1, maximum: 1000 }) }), ({ edition }) => {
  news.edition = edition
  invalidatePage('/news')
})

if (news.failing)
  throw new Error('the news feed is down')

const edition = news.edition
---
h1 Edition {edition}
