---
import { recipe } from 'kay'
import type { Action, FormFailure, JSX, Snippet } from 'kay'
import { wording } from 'kay/words'
import Button from './button.kay'
import Checkbox from './checkbox.kay'
import FormField from './form-field.kay'
import { FIELD_MESSAGE } from './field-look'
import Notice from './notice.kay'
import FormOutcome from './internal/form-outcome.kay'
import { OUTSIDE } from './outside'

const look = recipe({ parts: { root: 'kui-contact-form flex flex-col items-start gap-4', consent: 'kui-contact-consent flex flex-col gap-1', privacy: 'kui-contact-privacy text-xs', consentBox: '', issues: FIELD_MESSAGE.issues, issue: FIELD_MESSAGE.issue } })

const { action, nameLabel = wording('ui.contactForm.name', wording('mail.contact.form.name', 'Name')), emailLabel = wording('ui.contactForm.email', wording('mail.contact.form.email', 'Email')), messageLabel = wording('ui.contactForm.message', wording('mail.contact.form.message', 'Message')), submitLabel = wording('ui.contactForm.submit', wording('mail.contact.form.submit', 'Send')), sentLabel = wording('ui.contactForm.sent', wording('mail.contact.form.sent', 'Thank you, your message has been sent.')), consentLabel = wording('ui.contactForm.consent', wording('mail.contact.form.consent', 'I agree that my details are used to answer my message.')), privacyLabel = wording('ui.contactForm.privacy', wording('mail.contact.form.privacy', 'Privacy policy')), privacy, consent, rows = 6, onSent, onError, sent, ...rest } = props<Omit<JSX.IntrinsicElements['form'], 'class' | 'action' | 'novalidate' | 'children' | 'onError'> & {
  // The action `contactForm(mail)` from kayjs-mail gives, or any with a `name`, an `email` and a `message` field.
  action: Action<never, unknown>
  // The labels read the `ui.contactForm.*` messages, then kayjs-mail's `mail.contact.form` ones in the page's language, English and French, which these replace.
  nameLabel?: string | undefined
  emailLabel?: string | undefined
  messageLabel?: string | undefined
  submitLabel?: string | undefined
  // Shown once the message went out.
  sentLabel?: string | undefined
  // Replaces the success notice, whatever `sentLabel` says.
  sent?: Snippet
  // Called once the message went out, with what the action returned: for an analytics conversion, closing a dialog around the form or a redirect.
  onSent?: ((data: unknown) => unknown) | undefined
  // Called when the post was refused or failed, with the messages by field (the whole form's under ''), the status and the failure's data; the notice and the field messages still show.
  onError?: ((failure: FormFailure<never, unknown>) => unknown) | undefined
  // The consent checkbox, drawn when the action asks for one (`consent: true` in `contactForm`), and the link after it to the privacy page, drawn when `privacy` is given.
  consentLabel?: string | undefined
  privacyLabel?: string | undefined
  // Whether to draw the consent checkbox, which is read from the action when left out; an action inside an island is a stub that carries no schema, so say `consent` there.
  consent?: boolean | undefined
  // Where the privacy page is, such as `/privacy`: linked beside the consent checkbox, or on its own under the message when there is none.
  privacy?: string | undefined
  // The message box's height, in lines.
  rows?: number | undefined
}>()

// Server actions carry their schema; the consent checkbox is drawn when `consent: true` marked the field.
const asksConsent = () => consent ?? (action as { schema?: { properties?: Record<string, Record<string, unknown> | undefined> } }).schema?.properties?.consent?.['x-kay-consent'] === true
---
// Posts without JavaScript; the honeypot, the time check and the refused fields' messages come from the action, each FormField showing its own by `name`. Fields beyond those three go in as children, between the email and the message.
form(part="root" {...rest} action={action} novalidate)
  FormField(label={nameLabel} required name="name")
    input(field="name" autocomplete="name")
  FormField(label={emailLabel} required name="email")
    input(field="email" autocomplete="email")
  slot
  FormField(label={messageLabel} required name="message")
    textarea(field="message" rows={rows})
  if asksConsent()
    div(part="consent")
      // The Checkbox renders as an island of its own, which does not know this form, so its message is handed over.
      Checkbox(part="consentBox issues issue" name="consent" label={consentLabel} issue={action.error('consent')})
      if privacy
        a(part="link" href={privacy} {...OUTSIDE}) {privacyLabel}
  else if privacy
    p(part="privacy")
      a(part="link" href={privacy} {...OUTSIDE}) {privacyLabel}
  Button(type="submit" tone="accent" label={submitLabel})
  // Only an island renders the form with a callback, which this passes on; the cast keeps `kay check` from reading the form as a static component handing an island a function.
  if onSent || onError
    FormOutcome(action={action} whenSent={onSent as never} whenRefused={onError as never})
  if action.succeeded()
    if sent
      | {sent}
    else
      Notice(tone="success" size="sm") {sentLabel}
  else if action.error() as message
    Notice(tone="danger" size="sm") {message}
