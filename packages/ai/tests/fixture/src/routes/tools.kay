--- server

import { ask, tool } from '@kayjs/ai'
import { action, s } from 'kay'
import { done, heard, hooks, testing } from '../testing'
import { wipe } from './locked/_actions.kay'

export const addNote = action({ title: s.string({ min: 3, max: 100, error: 'Too short' }) }, ({ title }) => {
  done.push(`addNote:${title}`)

  return { id: 1, title }
})

export const refuses = action({}, (_input, ctx) => ctx.deny(409, { data: { reason: 'full' } }))

export const sendsAway = action({}, (_input, ctx) => ctx.redirect('/'))

export const breaks = action({}, () => {
  throw new Error('boom secret')
})

export const slow = action({}, async () => {
  hooks.slowStarted?.()
  await Bun.sleep(150)
  done.push('slow')

  return 'slow done'
})

export const limited = action({ input: {}, protect: { rateLimit: { max: 1, window: '1m' } } }, () => 'counted')

export const vetoed = action({ input: {}, tool: false }, () => 'vetoed')

export const upload = action({ photo: s.file() }, () => 'stored')

// A read that names its calls for a chat.
export const homeState = action({ input: {}, tool: { description: 'Reads the home', label: 'Read the home', readOnly: true } }, () => 'lit')

const tools = [addNote, refuses, sendsAway, breaks, slow, limited, wipe, homeState]

export const converse = action({ prompt: s.string({ max: 200 }), maxSteps: s.int({ optional: true, min: 1, max: 10 }), offer: s.list(s.string({ max: 40 }), { optional: true, max: 10 }) }, async ({ prompt, maxSteps, offer }) => {
  const reply = ask(prompt, { tools: offer === undefined ? tools : tools.filter(tool => offer.includes(tool.url.slice(tool.url.lastIndexOf('/') + 1))), maxSteps, approval: false, provider: testing.provider })

  return { text: await reply, calls: await reply.calls, finish: await reply.finish, usage: await reply.usage }
})

// A posted file shown to a model that calls tools, as an app's scan reader would.
export const looks = action({ input: { photo: s.file({ type: 'image/png' }) }, maxSize: '1mb' }, async ({ photo }) => await ask([{ role: 'user', content: 'look', attachments: [photo] }], { tools: [addNote], approval: false, provider: testing.provider }))

export const watch = action({ prompt: s.string({ max: 200 }) }, ({ prompt }) => ask(prompt, { tools: [addNote, slow], approval: false, provider: testing.provider }).progress())

// A tool loop an app reads itself, as it would to speak the reply aloud, which `outlive` lets go on once the visitor left.
export const staying = action({ prompt: s.string({ max: 200 }), outlive: s.boolean() }, ({ prompt, outlive }) => {
  const reply = ask(prompt, { tools: [addNote, slow], approval: false, outlive, provider: testing.provider })

  void (async () => {
    let text = ''

    for await (const snapshot of reply)
      text = snapshot

    heard.push(text)
  })()

  return reply.progress()
})

const stamp = tool({ name: 'stamp', description: 'Stamps something', input: s.object({}), run: () => {
  done.push('stamp')

  return 'stamped'
} })
const addNoteTwin = tool({ name: 'add_note', description: 'A function tool named as an action', input: s.object({}), run: () => 'twin' })

// An action and a function tool in one ask, whose approval refuses every action.
export const mixed = action({ prompt: s.string({ max: 200 }), twin: s.boolean({ optional: true }) }, ({ prompt, twin }) => ask(prompt, { tools: twin === true ? [addNoteTwin, addNote] : [addNote, stamp], approval: () => false, provider: testing.provider }).progress())

// A tool loop whose every call the visitor has not confirmed.
export const unconfirmed = action({ prompt: s.string({ max: 200 }) }, ({ prompt }) => ask(prompt, { tools: [addNote], approval: () => false, provider: testing.provider }).progress())

export const lookup = action({ input: {}, tool: { description: 'Looks something up', readOnly: true } }, () => 'found')

// A chat whose tools are asked about by default: the write waits for the visitor's Allow, the read does not.
export const approving = action({ messages: s.list(s.object({ role: s.enum(['user', 'assistant']), content: s.string({ max: 4000 }) }), { min: 1, max: 50 }) }, ({ messages }) => ask(messages, { tools: [addNote, lookup], provider: testing.provider }).progress())

// The chat's action when the model has tools: the stream carries the calls too.
export const helper = action({ messages: s.list(s.object({ role: s.enum(['user', 'assistant']), content: s.string({ max: 4000 }) }), { min: 1, max: 50 }) }, ({ messages }) => ask(messages, { tools: [addNote, breaks], approval: false, provider: testing.provider }).progress())

export const labelled = action({ messages: s.list(s.object({ role: s.enum(['user', 'assistant']), content: s.string({ max: 4000 }) }), { min: 1, max: 50 }) }, ({ messages }) => ask(messages, { tools: [homeState], provider: testing.provider }).progress())

export const sourced = action({ messages: s.list(s.object({ role: s.enum(['user', 'assistant']), content: s.string({ max: 4000 }) }), { min: 1, max: 50 }) }, ({ messages }) => ask(messages, { sources: [{ n: 1, title: 'Tides', href: 'https://example.com/tides?a=1&b=2' }, { n: 2, title: 'Moon', href: '/moon' }, { n: 3, title: 'Never cited', href: 'https://example.com/3' }, { n: 4, title: 'Hostile', href: 'javascript:alert(1)' }] }).progress())

// A chat with a tool and sources, for the blocks that replace how each is drawn.
export const blocked = action({ messages: s.list(s.object({ role: s.enum(['user', 'assistant']), content: s.string({ max: 4000 }) }), { min: 1, max: 50 }) }, ({ messages }) => ask(messages, { tools: [homeState], sources: [{ n: 1, title: 'Tides', href: 'https://example.com/tides' }, { n: 2, title: 'Moon', href: '/moon' }] }).progress())

export const refusedTools = action({ which: s.enum(['vetoed', 'upload']) }, ({ which }) => {
  ask('x', { tools: [which === 'vetoed' ? vetoed : upload] })

  return 'unreachable'
})
---
p Tools
