--- server
import { t } from 'elysia'
import { action } from 'kay'

export const summary = action({ input: t.Object({}), tool: true }, () => ({ count: 2, at: new Date(0), tags: ['a'] as string[], note: undefined as string | undefined }))

export const declared = action({ input: t.Object({}), tool: { output: t.Object({ count: t.Number() }) } }, () => ({ count: 2, extra: 'x' }))

export const worded = action({ input: t.Object({}), tool: { text: ({ count }) => `${count} things` } }, () => ({ count: 2 }))

export const plain = action({ tool: true }, () => 'plain')

export const refuses = action({ input: t.Object({}), tool: true }, (_input, ctx) => ctx.deny(409, { data: { reason: 'full' } }))

export const hidden = action(t.Object({}), () => ({ secret: true }))

export const stream = action({ tool: true }, async function* () {
  yield { n: 1 }
})
---
h1 Tools
