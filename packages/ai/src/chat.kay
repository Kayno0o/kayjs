---
import type { Action, ActionStream, Failure, SanitizeOptions } from 'kay'
import type { Message, Progress, ToolCall } from './types'
import { ActionError, effect, onCleanup, onMount, sanitizeHtml, signal, trustHtml, untrack } from 'kay'
import { markdownHtml } from 'kay/markdown'
import { posted, restored, stored } from './chat-history'
import Calls from './chat-calls.kay'
import './chat.css'

// What a reply keeps of markdown: no image, which a model reading a hostile page could point at a URL carrying the conversation, and no task checkbox. Tables stay.
const REPLY: SanitizeOptions = { tags: ['table', 'thead', 'tbody', 'tr', 'th', 'td'] }
// How close to the end of the log the visitor must be for new text to keep it scrolled down.
const PINNED_PX = 48
const ATTRIBUTE_UNSAFE = /[&"<]/g
// The opening tag `sanitizeHtml` writes for a link, which `linksOpenApart` rewrites: the two change together. The href is captured to tell a link of this site from another.
const SANITIZED_LINK = /<a href="([^"]*)" rel="nofollow ugc">/g
// A path of this site, or an anchor in the page: `//host` is another site.
const LOCAL_HREF = /^(?:\/(?!\/)|#)/
const ENTITIES: Record<string, string> = { '&': '&amp;', '"': '&quot;', '<': '&lt;' }

const attribute = (text: string) => text.replace(ATTRIBUTE_UNSAFE, char => ENTITIES[char]!)

interface Turn extends Message {
  id: number
  // A reply the visitor stopped, or one whose stream broke off, cut where it was.
  stopped?: boolean | undefined
  // The tools the reply called, when the action streams `reply.progress()`.
  calls?: ToolCall[] | undefined
}

const { action, initial = [], label = 'Chat', placeholder = 'Write a message…', sendLabel = 'Send', stopLabel = 'Stop', retryLabel = 'Try again', thinkingLabel = 'Thinking…', stoppedLabel = 'Stopped', errorMessage = 'The reply failed.', keep = 20, tableLabel = 'Table', toolDetails = true, remember, links = 'apart', runningLabel = 'Running', doneLabel = 'Done', failedLabel = 'Failed', argumentsLabel = 'Arguments', resultLabel = 'Result', class: className } = props<{
  // The page's streaming action, `action(schema, ({ messages }) => ask(messages))`, which may also `ctx.fail`; the chat posts the latest messages to it and reads the reply as it streams.
  // Returning `ask(messages, { tools }).progress()` instead streams the tool calls as well, which the chat shows before the text of their turn.
  action: Action<{ messages: Message[] }, AsyncIterable<string | Progress> | Failure<unknown>>
  // The messages shown to start with.
  initial?: Message[] | undefined
  // Names the message list and the field for screen readers.
  label?: string | undefined
  placeholder?: string | undefined
  sendLabel?: string | undefined
  stopLabel?: string | undefined
  retryLabel?: string | undefined
  // Said, and read out, while the first words of a reply are awaited.
  thinkingLabel?: string | undefined
  // Marks a reply cut short by Stop.
  stoppedLabel?: string | undefined
  // How many of the latest messages each send posts, so the history never outgrows the action's `maxItems`; the history posted opens on a user message, so an assistant one at its start is left out.
  keep?: number | undefined
  // Names a table of a reply, which scrolls sideways inside its bubble when it is wider; a reply with several numbers them, `Table 1`, `Table 2`.
  tableLabel?: string | undefined
  // Whether each tool call opens to its arguments and result, shown as plain text; false shows its name and status only.
  toolDetails?: boolean | undefined
  // The status of a tool call, and the names of its two parts.
  runningLabel?: string | undefined
  doneLabel?: string | undefined
  failedLabel?: string | undefined
  argumentsLabel?: string | undefined
  resultLabel?: string | undefined
  // Shown when the call is refused or the stream breaks off.
  errorMessage?: string | undefined
  // A name under which the conversation is kept in the tab's session storage, so a reload of the tab finds it again; the tool calls of the replies are not kept. Without it, a reload starts afresh.
  remember?: string | undefined
  // Where a link of a reply opens: `apart` in a new tab, so following it does not swap the page and drop a conversation that lives in it; `here` for a link of this site opens in place, for a chat that survives a swap (kept by `persist`, or by `remember`), while a link to another site still opens apart.
  links?: 'apart' | 'here' | undefined
  class?: string | undefined
}>()

let nextId = 0
const history = signal<Turn[]>(untrack(() => initial).map(message => ({ ...message, id: nextId++ })))
const draft = signal('')
// The call is out and no word of the reply is there yet.
const waiting = signal(false)
const streaming = signal<ActionStream<string | Progress> | undefined>(undefined)
// The reply so far, which becomes a turn of the history once the stream ends.
const partial = signal('')
// The tool calls of the reply being written, as last seen.
const calls = signal<ToolCall[]>([])
// What the status line said of the calls, one line each and added to it, since a line replaced before the screen reader reads it is lost.
const spoken = signal<{ id: number, text: string }[]>([])
const failure = signal<string | undefined>(undefined)
// The last call was refused and its message taken back, so no message waits for an answer that Try again could ask for.
const takenBack = signal(false)
const busy = () => waiting() || streaming() !== undefined
let run: AbortController | undefined
let field: HTMLTextAreaElement | undefined
let log: HTMLElement | undefined
let pinned = true
const told = new Map<string, string>()
const statuses = { running: runningLabel, done: doneLabel, failed: failedLabel }

// Says the calls whose status changed since the last snapshot, each as `name: status`.
function announce(next: ToolCall[]) {
  const said: { id: number, text: string }[] = []

  for (const call of next) {
    if (told.get(call.id) === call.status)
      continue

    told.set(call.id, call.status)
    said.push({ id: nextId++, text: `${call.name}: ${statuses[call.status]}` })
  }

  if (said.length > 0)
    spoken.set([...spoken(), ...said])
}

function show(value: string | Progress) {
  if (typeof value === 'string') {
    partial.set(value)

    return
  }

  partial.set(value.text)
  calls.set(value.calls)
  announce(value.calls)
}

// A link of a reply opens in a new tab, as the conversation lives in this page and a page swap would drop it, unless `links` is `here` and the link leads to this site.
function linksOpenApart(html: string): string {
  return html.replaceAll(SANITIZED_LINK, (tag, href: string) => links === 'here' && LOCAL_HREF.test(href) ? tag : tag.replace('rel="nofollow ugc"', 'target="_blank" rel="nofollow ugc noopener"'))
}

// A table is wrapped, once sanitized, in a box that scrolls sideways and takes the keyboard's focus, except in the turn being written, which is hidden from screen readers. Several tables of one reply are numbered, so no two groups share a name.
function markdown(text: string, scrollable = true) {
  const html = linksOpenApart(sanitizeHtml(markdownHtml(text), REPLY))
  const tables = html.split('<table>').length - 1

  if (tables === 0)
    return trustHtml(html)

  let count = 0

  return trustHtml(html.replaceAll('<table>', () => {
    count++

    return `<div class="kai-chat-table"${scrollable ? ` tabindex="0" role="group" aria-label="${attribute(tables === 1 ? tableLabel : `${tableLabel} ${count}`)}"` : ''}><table>`
  }).replaceAll('</table>', '</table></div>'))
}

// A message the schema refuses would fail every later send, and one stopped before any word came has no answer, so a next send would post two user turns: it leaves the history and goes back to the field, ahead of what the visitor typed since.
function takeBack() {
  const last = history().at(-1)

  if (last?.role !== 'user')
    return

  history.set(history().slice(0, -1))
  takenBack.set(true)
  draft.set(draft() === '' ? last.content : `${last.content}\n${draft()}`)
}

// The reply ended on its own, was stopped or broke off: what arrived joins the history.
function finish(state: string) {
  const text = partial()
  const made = calls()

  streaming.set(undefined)
  partial.set('')
  calls.set([])

  if (text !== '' || made.length > 0)
    history.set([...history(), { id: nextId++, role: 'assistant', content: text, calls: made, stopped: state === 'closed' }])

  if (state === 'failed')
    failure.set(errorMessage)
  else if (state === 'closed' && text === '' && made.length === 0)
    takeBack()
}

let recalled = false

// The conversation of the tab's last visit, put back once hydrated since the server renders the initial one.

onMount(() => {
  if (remember === undefined)
    return

  const turns = restored(remember)

  recalled = true

  if (turns.length > 0)
    history.set(turns.map(turn => ({ ...turn, id: nextId++ })))
})

effect(() => {
  const turns = history()

  // Before the last visit's turns are back, the history would overwrite them with the initial one.
  if (remember !== undefined && recalled)
    stored(remember, turns)
})

effect(() => {
  const stream = streaming()

  if (stream === undefined)
    return

  const state = stream.status()

  if (state !== 'open')
    untrack(() => finish(state))
})

// Keeps the newest text in view unless the visitor scrolled up to read.
effect(() => {
  history()
  partial()
  calls()
  waiting()

  if (pinned)
    queueMicrotask(() => log?.scrollTo({ top: log.scrollHeight }))
})

async function send(again = false) {
  const text = draft().trim()

  if (busy() || (!again && text === ''))
    return

  if (!again) {
    history.set([...history(), { id: nextId++, role: 'user', content: text }])
    draft.set('')
  }

  const mine = new AbortController()

  run = mine
  pinned = true
  failure.set(undefined)
  takenBack.set(false)
  partial.set('')
  calls.set([])
  told.clear()
  spoken.set([])
  waiting.set(true)

  try {
    // A turn that only called tools has no text to post, which a provider refuses.
    const stream = await action({ messages: posted(history(), keep) }, { signal: mine.signal, refresh: false })

    if (mine.signal.aborted) {
      stream.close()
      takeBack()

      return
    }

    stream.on(show)
    streaming.set(stream)
  }
  catch (error) {
    // A call stopped before its first word is not a failure, and its message returns to the field.
    if (mine.signal.aborted) {
      takeBack()
    }
    else {
      console.error(error)

      if (error instanceof ActionError && error.status === 422)
        takeBack()

      failure.set(error instanceof ActionError && error.status < 500 && error.errors[''] ? error.errors[''] : errorMessage)
    }
  }
  finally {
    waiting.set(false)
    field?.focus()
  }
}

function stop() {
  const stream = streaming()

  // Aborting a call whose answer arrived would break the body read; closing the stream is enough then.
  if (stream === undefined)
    run?.abort()
  else
    stream.close()

  field?.focus()
}

// Heard on the whole chat, so the Stop button and the log stop a reply too.
function escape(event: KeyboardEvent) {
  if (event.key === 'Escape' && busy() && !event.isComposing) {
    // Stops the reply and nothing else, such as the panel around the chat closing.
    event.preventDefault()
    stop()
  }
}

function keyDown(event: KeyboardEvent) {
  if (event.key === 'Enter' && !event.shiftKey && !event.isComposing) {
    event.preventDefault()
    void send()
  }
}

// A log shown again, such as in a panel reopened, is scrolled to the end when the visitor was at it, as it has no scroll position while hidden.
function watch(element: HTMLElement) {
  log = element

  if (typeof ResizeObserver === 'undefined')
    return

  const observer = new ResizeObserver(() => {
    if (pinned)
      element.scrollTo({ top: element.scrollHeight })
  })

  observer.observe(element)
  onCleanup(() => observer.disconnect())
}

function scrolled() {
  pinned = log !== undefined && log.scrollHeight - log.scrollTop - log.clientHeight < PINNED_PX
}
---
section.kai-chat(class={className} onKeyDown={escape})
  // The log is the turns so far; the reply streaming in is hidden from screen readers until it is whole, so the finished turn is announced once, not word by word. The status line says the thinking label, then each tool call as it starts and ends.
  .kai-chat-log(role="log" aria-label={label} tabindex="0" ref={watch} onScroll={scrolled})
    for turn of history() key={turn.id}
      article.kai-chat-turn(data-role={turn.role})
        if turn.role === 'user'
          p.kai-chat-text {turn.content}
        else
          if turn.calls && turn.calls.length > 0
            Calls(calls={turn.calls} details={toolDetails} runningLabel={runningLabel} doneLabel={doneLabel} failedLabel={failedLabel} argumentsLabel={argumentsLabel} resultLabel={resultLabel})
          if turn.content !== ''
            .kai-chat-text(innerHTML={markdown(turn.content)})
          if turn.stopped
            small.kai-chat-note {stoppedLabel}
    if busy()
      article.kai-chat-turn(data-role="assistant" data-pending="" aria-hidden="true")
        if calls().length > 0
          Calls(calls={calls()} details={toolDetails} runningLabel={runningLabel} doneLabel={doneLabel} failedLabel={failedLabel} argumentsLabel={argumentsLabel} resultLabel={resultLabel})
        if partial() !== ''
          .kai-chat-text(innerHTML={markdown(partial(), false)})
        else if calls().length === 0
          p.kai-chat-text.kai-chat-thinking {thinkingLabel}
  .kai-chat-status(role="status" aria-atomic="false")
    for line of spoken() key={line.id}
      p {line.text}
    if busy() && partial() === '' && calls().length === 0
      p {thinkingLabel}
  if failure()
    .kui-notice(role="alert" data-tone="danger")
      | {failure()}
      |
      if !busy() && !takenBack() && history().at(-1)?.role === 'user'
        button.kui-btn(type="button" onClick={() => void send(true)}) {retryLabel}
  form.kai-chat-form(onSubmit={event => { event.preventDefault(); void send() }})
    textarea.kui-field-input(ref={element => { field = element }} bind:value={draft} rows="1" aria-label={label} placeholder={placeholder} onKeyDown={keyDown})
    if busy()
      button.kui-btn(type="button" onClick={stop}) {stopLabel}
    else
      button.kui-btn(type="submit") {sendLabel}
