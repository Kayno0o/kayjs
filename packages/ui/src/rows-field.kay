--- <Row extends Record<string, string>>
import type { JSX, Snippet } from 'kay'
import { announce } from './announce'
import { defaultKept, onFormReset, startRef } from './form-reset'
import { effect, flush, formErrors, postedValues, recipe, signal, uid, untrack } from 'kay'
import { wording } from 'kay/words'
import type { FieldSize } from './field-look'
import { FIELD_MESSAGE } from './field-look'
import { linkChoice } from './choice-link'
import { formIssues } from './forms'
import { labelText } from './label-text'
import Button from './button.kay'
import IconButton from './icon-button.kay'
import TextInput from './text-input.kay'

// 'kui-rows-field' stays as the name of the field for an app's CSS; the columns are a grid sized by `--_columns`, so the headings, every row and the remove buttons line up.
const look = recipe({
  parts: {
    root: 'kui-rows-field flex flex-col gap-2',
    head: 'grid grid-cols-[repeat(var(--_columns),minmax(0,1fr))_2rem] gap-2 px-px text-xs text-muted',
    heading: 'truncate',
    row: 'grid grid-cols-[repeat(var(--_columns),minmax(0,1fr))_2rem] items-center gap-2',
    input: 'min-w-0',
    remove: '',
    issue: `${FIELD_MESSAGE.issue} col-span-full`,
    issueItem: 'block',
    add: 'self-start',
  },
})

const NONE: never[] = []

const { rows = NONE, style, columns, label, name, invalid, size = 'md', rowIssues, onChange, onAdd, onRemove, cell, min = 0, max, addLabel = wording('ui.rowsField.add', 'Add row'), removeLabel, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'children' | 'role' | 'onChange' | 'style'> & {
  style?: string | undefined
  // The rows to start with, and the ones to show whenever the parent passes others: a field in a form posting to an action needs nothing else, and an editor keeping them in a signal writes them back in `onChange`.
  rows?: readonly Row[] | undefined
  // One text box per column of a row: `key` is the property of the row it edits (a plain string, so a `columns` array declared apart from the call needs no `as const`), `label` names it for screen readers and heads its column, `placeholder` defaults to the label. A `number` column holds the figure as text in the row, `''` once emptied. A column marked `cell: true` is drawn by the `@cell` block instead.
  columns: readonly { key: string, label: string, placeholder?: string | undefined, type?: 'text' | 'email' | 'url' | 'tel' | 'search' | 'number' | undefined, name?: string | undefined, cell?: boolean | undefined }[]
  // Names the field for screen readers.
  label: string
  // Marks the field as refused: its text boxes in the danger colour, with `data-invalid` on the group. A cell drawn by `@cell` takes it from `invalid` itself.
  invalid?: boolean | undefined
  // The size of every text box, `md` by default; a cell drawn by `@cell` reads it as `column.size`.
  size?: FieldSize | undefined
  // What a row is refused for, its text boxes drawn invalid and the message shown under the row, linked to its boxes with `aria-describedby`: a function of the row's place (from 0) or a record by place, `undefined` or `''` for a row with no issue. A cell drawn by `@cell` gets the row's issue as the block's fifth argument. Inside a Form, FormDialog or SaveForm an action's refusal is read as well, so it shows under its row instead of as a toast: `<name>_<key>.<n>` or `<name>_<key>[n]` marks that cell of row n (from 0), `<name>.<n>` or `<name>[n]` the row, and a bare `<name>_<key>`, which a schema refusal of an array column comes under, marks that column and shows under the first row.
  rowIssues?: ((index: number) => string | undefined) | Record<number, string | undefined> | undefined
  // Inside a form, each column posts under `<name>_<key>` (or its own `name`), once per row in the order shown, so a blank cell keeps its place: an action reads them as `s.Array(s.String())` fields of one length.
  name?: string | undefined
  // Gets the new rows after every edit, an added row and a removed one. Called without a wait: it can store the rows, not refuse a change.
  onChange?: ((rows: Row[]) => unknown) | undefined
  // Called with the row an Add button appended and its place, and with the row a Remove button took out and the place it had, besides `onChange`.
  onAdd?: ((row: Row, index: number) => unknown) | undefined
  onRemove?: ((row: Row, index: number) => unknown) | undefined
  // Draws the control of each column marked `cell: true`, such as a Select of units, a checkbox or a Combobox: `set(text)` writes the value into the row, so the cell takes part in `onChange`, adding and removing, posting and reset like a text box. The `column` it gets carries the `name` the cell posts under (`<name>_<key>`, or the column's own), which the control takes as its `name`; `index` is a function of the row's place (from 0): name the control by `${column.label} ${index() + 1}` for screen readers, and the name follows the row when one above it is removed, and read its value off `row[column.key]`.
  // The cell is drawn once per row and keeps its control while the row is edited: `issue` (`invalid`, `message` and the `id` of the message under the row, for `aria-describedby`) reads the same way, and `row` reads the current row where it is used, as in `value={row.unit}`, so read it in a prop or an expression, not once at the top of the block. The block is not drawn again for a row that stays, whatever happens to the rows around it.
  cell?: Snippet<[column: { key: string, label: string, name: string | undefined, size: FieldSize }, row: Row, index: () => number, set: (value: string) => void, issue: { readonly invalid: boolean, readonly message: string | undefined, readonly id: string | undefined }]> | undefined
  // The fewest rows: Remove stops there. The most: Add stops there.
  min?: number | undefined
  max?: number | undefined
  addLabel?: string | undefined
  // Names the button removing the row at `index` (from 0), such as `Remove header 2`.
  removeLabel?: string | ((index: number) => string) | undefined
}>()

let root: HTMLElement | undefined

const ref = startRef<HTMLElement>((element) => {
  root = element
  linkChoice(element)
}, rest.ref)
let nextId = 0
// A field with no callback is plain: a refused post of its form, which the server renders it for, gives its rows back, each column posting one value per row.
function postedRows(): Row[] | undefined {
  const lists = columns.map((column) => {
    const held = rows.map(row => String(row[column.key] ?? ''))

    return { key: column.key, held, values: postedValues(column.name ?? (name === undefined ? undefined : `${name}_${column.key}`), held) }
  })

  if (lists.every(list => list.values === undefined))
    return undefined

  const count = Math.max(0, ...lists.map(list => (list.values ?? list.held).length))

  return Array.from({ length: count }, (_, at) => Object.fromEntries(lists.map(list => [list.key, (list.values ?? list.held)[at] ?? ''])) as Row)
}

const sent = onChange ? undefined : postedRows()
const current = signal<readonly Row[]>(sent ?? rows)
// One id per row, so a row removed from the middle leaves the boxes of the others as they are.
const ids = signal<number[]>(untrack(() => (sent ?? rows).map(() => nextId++)))

// What the form goes back to on a reset: the rows it started with, or the ones last saved by a SaveForm.
const initial = defaultKept(() => root, () => current(), untrack(() => rows))

// The parent passed other rows, which have the last word; their ids are kept while their count is.
effect(() => {
  const next = rows

  if (untrack(current) === next)
    return

  current = next

  if (untrack(ids).length !== next.length)
    ids = next.map(() => nextId++)
})

const issuesBase = uid()
const placeOf = (id: number) => ids().indexOf(id)
const rowOf = (id: number) => current()[placeOf(id)]
const textOf = (id: number, key: string) => rowOf(id)?.[key] ?? ''
const refused = formIssues.use()
const held = formErrors()
const refusal = (key: string | undefined) => key === undefined ? undefined : (refused ? refused()[key] : held(key)) || undefined
const givenFor = (at: number) => {
  const found = typeof rowIssues === 'function' ? rowIssues(at) : rowIssues?.[at]

  return found === undefined || found === '' ? undefined : found
}
// What an action refused the row at `at` with, by the key it came under: its cells' (`<name>_<key>.<n>`, `<name>_<key>[n]`, and the bare `<name>_<key>` for the first row), then the row's own (`<name>.<n>`, `<name>[n]`).
function refusalsOf(at: number): { key: string, message: string, column: string | undefined }[] {
  const keys = [
    ...columns.flatMap((column) => {
      const post = postName(column)

      return post === undefined ? [] : [`${post}.${at}`, `${post}[${at}]`, ...at === 0 ? [post] : []].map(key => ({ key, column: column.key as string | undefined }))
    }),
    ...name === undefined ? [] : [`${name}.${at}`, `${name}[${at}]`].map(key => ({ key, column: undefined as string | undefined })),
  ]

  return keys.flatMap(({ key, column }) => {
    const message = refusal(key)

    return message === undefined ? [] : [{ key, message, column }]
  })
}
// Every message under the row, the editor's `rowIssues` first.
function messagesOf(id: number): { key: string | undefined, message: string }[] {
  const at = placeOf(id)
  const given = givenFor(at)

  return [...given === undefined ? [] : [{ key: undefined, message: given }], ...refusalsOf(at)]
}
const issueOf = (id: number): string | undefined => {
  const all = messagesOf(id)

  return all.length === 0 ? undefined : all.map(item => item.message).join(' ')
}
// Whether the cell of `column` in row `id` is refused: by the field, the editor's row issue, an action's refusal of the row, of the cell, or of the column.
function refusedCell(id: number, column: { key: string, name?: string | undefined }): boolean {
  if (invalid === true)
    return true

  const at = placeOf(id)

  return givenFor(at) !== undefined || refusal(postName(column)) !== undefined || refusalsOf(at).some(item => item.column === undefined || item.column === column.key)
}

// The cell block is called once per row, not on each edit or move: a call made from the template would track the row it is handed, so every keystroke drew its control again and lost the focus. The row it gets reads the current one where the block uses it.
function drawCell(id: number, column: { key: string, label: string, name?: string | undefined }) {
  const issue = {
    get invalid() { return refusedCell(id, column) },
    get message() { return issueOf(id) },
    get id() { return issueOf(id) === undefined ? undefined : `${issuesBase}_${id}` },
  }
  const view = new Proxy({} as Row, {
    get: (_, key) => (rowOf(id) as Record<PropertyKey, unknown> | undefined)?.[key],
    has: (_, key) => key in (rowOf(id) ?? {}),
    ownKeys: () => Reflect.ownKeys(rowOf(id) ?? {}),
    getOwnPropertyDescriptor: (_, key) => {
      const own = Object.getOwnPropertyDescriptor(rowOf(id) ?? {}, key)

      return own && { ...own, configurable: true }
    },
  })

  return untrack(() => cell!({ key: column.key, label: column.label, name: postName(column), size }, view, () => placeOf(id), text => edit(placeOf(id), column.key, text), issue))
}
const full = () => max !== undefined && current().length >= max
const removeName = (index: number) => removeLabel === undefined ? wording('ui.rowsField.remove', 'Remove row {n}', { n: index + 1 }) : labelText(removeLabel, { n: index + 1, index }, index)
const boxes = () => [...root?.querySelectorAll<HTMLElement>('[data-part=row]') ?? []]

function commit(next: readonly Row[]) {
  current = next
  onChange?.([...next])
}

function edit(index: number, key: string, text: string) {
  commit(current().map((row, at) => at === index ? { ...row, [key]: text } : row))
}

// The name a column posts under, which a cell block hands to its control.
const postName = (column: { key: string, name?: string | undefined }) => column.name ?? (name === undefined ? undefined : `${name}_${column.key}`)
const FIELD = 'input, select, textarea, button, [tabindex]'

function add() {
  if (full())
    return

  const row = Object.fromEntries(columns.map(column => [column.key, ''])) as Row

  ids = [...ids(), nextId++]
  commit([...current(), row])
  flush()
  boxes().at(-1)?.querySelector<HTMLElement>(FIELD)?.focus()
  onAdd?.(row, current().length - 1)
  announce(wording('ui.rowsField.added', 'Row {n} added', { n: current().length }))
}

function drop(index: number) {
  if (current().length <= min)
    return

  const removed = current()[index]!

  ids = ids().filter((_, at) => at !== index)
  commit(current().filter((_, at) => at !== index))
  onRemove?.(removed, index)
  flush()

  // Focus goes to the row that took its place, else the one before it, else the Add button.
  const rowsLeft = boxes()

  ;(rowsLeft[index] ?? rowsLeft.at(-1))?.querySelector<HTMLElement>(FIELD)?.focus()

  if (rowsLeft.length === 0)
    root?.querySelector<HTMLElement>('[data-part=add]')?.focus()

  announce(wording('ui.rowsField.removed', 'Row {n} removed', { n: index + 1 }))
}

// A reset puts the boxes back on their defaults, but not the rows added or removed since: those come back as they started.
onFormReset(() => root, () => {
  const start = initial()

  ids = start.map(() => nextId++)
  commit(start)
})
---
div(part="root" {...rest} ref={ref} data-kui-choice="" role="group" aria-label={label} data-invalid={invalid ? '' : undefined} style={[`--_columns:${columns.length}`, style].filter(Boolean).join('; ')})
  if current().length > 0
    div(part="head" aria-hidden="true")
      for column of columns key={column.key}
        span(part="heading") {column.label}
  for id of ids()
    div(part="row")
      for column of columns key={column.key}
        if column.cell === true && cell
          | {drawCell(id, column)}
        else if column.type === 'number'
          TextInput(part="input" type="number" name={postName(column)} size={size} invalid={refusedCell(id, column)} aria-label={`${column.label} ${placeOf(id) + 1}`} aria-describedby={issueOf(id) === undefined ? undefined : `${issuesBase}_${id}`} placeholder={column.placeholder ?? column.label} value={textOf(id, column.key)} onInput={figure => edit(placeOf(id), column.key, figure === null ? '' : String(figure))})
        else
          TextInput(part="input" type={column.type} name={postName(column)} size={size} invalid={refusedCell(id, column)} aria-label={`${column.label} ${placeOf(id) + 1}`} aria-describedby={issueOf(id) === undefined ? undefined : `${issuesBase}_${id}`} placeholder={column.placeholder ?? column.label} value={textOf(id, column.key)} onInput={text => edit(placeOf(id), column.key, text)})
      IconButton(part="remove" icon="close" variant="ghost" size="sm" label={removeName(placeOf(id))} disabled={current().length <= min} onClick={() => drop(placeOf(id))})
      p(part="issue" id={`${issuesBase}_${id}`} aria-live="polite" hidden={issueOf(id) === undefined})
        for item of messagesOf(id) key={item.key ?? item.message}
          span(part="issueItem" data-field={item.key}) {item.message}
  Button(part="add" icon="plus" variant="ghost" size="sm" label={addLabel} disabled={full()} onClick={add})
