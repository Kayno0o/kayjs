---
import type { JSX } from 'kay'
import { onMount, recipe } from 'kay'
import { currentTab, keptHref } from './tab-nav'

const look = recipe({ parts: { root: 'kui-tab-nav', link: 'kui-tab-nav-link' } })

const { links, current, keep = [], label, ...rest } = props<Omit<JSX.IntrinsicElements['nav'], 'class' | 'children'> & {
  links: readonly { href: string, label: string }[]
  // The `href` of the page on screen, which the link to it marks as current; or its URL, `ctx.url`, matched by its path and the params a link sets.
  current: string | URL
  // The params of `current` each link carries on, such as a period or a filter the tabs share, unless the link sets its own.
  keep?: readonly string[] | undefined
  // Names the navigation for screen readers.
  label: string
}>()

let nav: HTMLElement | undefined

const marked = () => currentTab(links.map(link => link.href), current)

// A tab bar wider than a phone scrolls, so the current tab is centred in it rather than left off screen. Only the bar scrolls: `scrollIntoView` would also move the page to it.
onMount(() => {
  const link = nav?.querySelector('[aria-current="page"]')

  if (!nav || !link)
    return

  const bar = nav.getBoundingClientRect()
  const tab = link.getBoundingClientRect()

  nav.scrollLeft += tab.left - bar.left - (bar.width - tab.width) / 2
})
---
// Links rather than buttons: each tab is a page of its own, which a reload, a new tab or a shared url opens. The bar sits mid-page, so following a tab keeps the window where it was (`data-keep-scroll` on the link), except a link to a `#section`, which scrolls to it.
nav({...rest} part="root" ref={element => nav = element} aria-label={label})
  for link of links key={link.href}
    a(part="link" data-keep-scroll={link.href.includes('#') ? undefined : ''} href={keptHref(link.href, current, keep)} aria-current={link.href === marked() ? 'page' : undefined}) {link.label}
