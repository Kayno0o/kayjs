---
import type { JSX } from 'kay'
import type { MediaItem } from './media'
import { effect, onCleanup, recipe, signal } from 'kay'
import { stepIndex } from './cycle'
import Icon from './icon.kay'
import IconButton from './icon-button.kay'
import { isPlayable, playSource } from './media'
import { wording } from 'kay/words'

// How far a finger moves sideways before a swipe turns the gallery.
const SWIPE_PX = 48

const look = recipe({ parts: { root: 'kui-media-gallery', empty: 'kui-media-gallery-empty', stage: 'kui-media-gallery-stage', frame: 'kui-media-gallery-frame', zoom: 'kui-media-gallery-zoom', step: 'kui-media-gallery-step', counter: 'kui-media-gallery-counter', caption: 'kui-media-gallery-caption', strip: 'kui-media-gallery-strip', thumb: 'kui-media-gallery-thumb', thumbImage: 'kui-media-gallery-thumb-image', play: 'kui-media-gallery-play', lightbox: 'kui-media-gallery-lightbox', full: 'kui-media-gallery-full', close: 'kui-media-gallery-close' } })

const { items, index = 0, onIndexChange, ratio = '16 / 9', emptyLabel, previousLabel = wording('ui.mediaGallery.previousLabel', 'Previous'), nextLabel = wording('ui.mediaGallery.nextLabel', 'Next'), closeLabel = wording('ui.mediaGallery.closeLabel', 'Close'), openLabel = wording('ui.mediaGallery.openLabel', 'Open full size'), itemLabel = wording('ui.mediaGallery.itemLabel', 'Media {n}'), ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'children'> & {
  items: MediaItem[]
  // The item on the stage to start with; a gallery whose parent passes another follows it, and `onIndexChange` reports each turn.
  index?: number | undefined
  onIndexChange?: ((index: number) => void) | undefined
  // The stage's CSS `aspect-ratio`.
  ratio?: string | undefined
  // What the gallery reads with no items.
  emptyLabel?: string | undefined
  previousLabel?: string | undefined
  nextLabel?: string | undefined
  closeLabel?: string | undefined
  // Names the button opening the lightbox, followed by the item's title when it has one.
  openLabel?: string | undefined
  // Names an item with no title, `{n}` standing for its number.
  itemLabel?: string | undefined
}>()

const nothing = () => emptyLabel ?? wording('ui.mediaGallery.emptyLabel', 'No media.')
const shown = signal(index)
const zoomed = signal(false)
// Each video's player, stopped once its element leaves the page.
const players = new Map<HTMLVideoElement, () => void>()
let strip: HTMLElement | undefined
let lightbox: HTMLDialogElement | undefined
let swipeFrom: { x: number, y: number } | null = null

effect(() => shown.set(index))

const active = () => Math.min(Math.max(shown(), 0), Math.max(items.length - 1, 0))
const current = () => items[active()]
const named = (position: number) => itemLabel.replaceAll('{n}', String(position + 1))

function go(next: number) {
  const target = stepIndex(next, 0, items.length)

  shown.set(target)
  onIndexChange?.(target)
}

function step(delta: number) {
  go(stepIndex(active(), delta, items.length))
}

function sweep() {
  for (const [video, stop] of players) {
    if (!video.isConnected) {
      stop()
      players.delete(video)
    }
  }
}

function play(video: HTMLVideoElement, src: string) {
  sweep()
  players.set(video, playSource(video, src))
}

onCleanup(() => {
  for (const stop of players.values())
    stop()
})

function keyDown(event: KeyboardEvent) {
  const target = event.target as HTMLElement

  // A video's own controls and a text box keep their arrows.
  if (items.length < 2 || event.altKey || event.ctrlKey || event.metaKey || target.closest('video, input, textarea'))
    return

  const moves: Partial<Record<string, () => void>> = { ArrowLeft: () => step(-1), ArrowRight: () => step(1), Home: () => go(0), End: () => go(items.length - 1) }
  const move = moves[event.key]

  if (!move)
    return

  event.preventDefault()
  move()
}

function swipeStart(event: PointerEvent) {
  if (event.pointerType === 'mouse') {
    swipeFrom = null

    return
  }

  const surface = event.currentTarget as HTMLElement

  swipeFrom = { x: event.clientX, y: event.clientY }
  // A finger lifted past the stage's edge still ends the swipe here.
  surface.setPointerCapture(event.pointerId)
}

function swipeEnd(event: PointerEvent) {
  const from = swipeFrom

  swipeFrom = null

  if (!from)
    return

  const dx = event.clientX - from.x

  if (Math.abs(dx) > SWIPE_PX && Math.abs(dx) > Math.abs(event.clientY - from.y))
    step(dx < 0 ? 1 : -1)
}

effect(() => {
  const wanted = zoomed()

  if (!lightbox)
    return

  if (wanted && !lightbox.open)
    lightbox.showModal()
  else if (!wanted && lightbox.open)
    lightbox.close()
})

// The thumbnail on stage is scrolled into the middle of the strip, the images either side start loading, and the players of videos no longer shown stop.
effect(() => {
  const at = active()
  const thumb = strip?.children[at] as HTMLElement | undefined

  sweep()
  strip?.scrollTo?.({ left: (thumb?.offsetLeft ?? 0) - (strip.clientWidth - (thumb?.offsetWidth ?? 0)) / 2, behavior: 'smooth' })

  for (const delta of items.length > 1 ? [1, -1] : []) {
    const neighbour = items[stepIndex(at, delta, items.length)]

    if (neighbour && !isPlayable(neighbour))
      new Image().src = zoomed() ? neighbour.full ?? neighbour.preview : neighbour.preview
  }
})
---
if !current()
  // The app's id and class stay on whichever element shows.
  p.kui-media-gallery-empty(part="root" id={rest.id}) {nothing()}
else
  // Arrows turn the gallery while focus is anywhere inside it, which a keyboard user reaches through its buttons.
  div({...rest} part="root" onKeyDown={keyDown})
    div(part="stage" style={`aspect-ratio: ${ratio}`} onPointerDown={swipeStart} onPointerUp={swipeEnd} onPointerCancel={() => swipeFrom = null})
      // Keyed on the item, so a video and its player are made afresh for each.
      for item of [current()!] key={item.key}
        if isPlayable(item)
          video(part="frame" ref={element => play(element, item.src)} controls preload="none" poster={item.preview})
            if item.captions
              track(kind="captions" src={item.captions} default)
        else
          button(part="zoom" type="button" aria-label={item.title ? `${openLabel}: ${item.title}` : openLabel} onClick={() => zoomed.set(true)})
            // kay-allow unsized-image
            img(part="frame" src={item.preview} alt={item.title ?? ''})
      if items.length > 1
        IconButton(icon="chevron" label={previousLabel} variant="ghost" part="step" data-side="previous" onClick={() => step(-1)})
        IconButton(icon="chevron" label={nextLabel} variant="ghost" part="step" data-side="next" onClick={() => step(1)})
        span(part="counter") {active() + 1} / {items.length}
      if current()!.title
        span(part="caption") {current()!.title}
    if items.length > 1
      div(part="strip" ref={element => strip = element})
        for item, position of items key={item.key}
          button(part="thumb" type="button" aria-current={position === active() ? 'true' : undefined} aria-label={item.title ?? named(position)} onClick={() => go(position)})
            // kay-allow unsized-image
            img(part="thumbImage" src={item.thumb} alt="" loading="lazy" decoding="async")
            if item.kind === 'video'
              Icon(icon="play" part="play")
    dialog(part="lightbox" ref={element => lightbox = element} closedby="any" aria-label={current()!.title ?? named(active())} onClose={() => zoomed.set(false)} onPointerDown={swipeStart} onPointerUp={swipeEnd} onPointerCancel={() => swipeFrom = null})
      if zoomed()
        for item of [current()!] key={item.key}
          if isPlayable(item)
            video(part="full" ref={element => play(element, item.src)} controls preload="none" poster={item.preview})
              if item.captions
                track(kind="captions" src={item.captions} default)
          else
            // kay-allow unsized-image
            img(part="full" src={item.full ?? item.preview} alt={item.title ?? ''})
        if items.length > 1
          IconButton(icon="chevron" label={previousLabel} variant="ghost" part="step" data-side="previous" onClick={() => step(-1)})
          IconButton(icon="chevron" label={nextLabel} variant="ghost" part="step" data-side="next" onClick={() => step(1)})
        if current()!.title
          span(part="caption") {current()!.title}
        IconButton(icon="close" label={closeLabel} variant="ghost" part="close" onClick={() => zoomed.set(false)})
