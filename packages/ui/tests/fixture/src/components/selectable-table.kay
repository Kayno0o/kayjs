---
import type { Column } from '@kaynooo/kayjs-ui'
import Button from '@kaynooo/kayjs-ui/button.kay'
import Table from '@kaynooo/kayjs-ui/table.kay'

interface Moon {
  id: number
  name: string
  radius: number
}

const { rows, selected, onSelect, filter, narrow, selectAllLabel, selectedLabel, selectRowLabel, onBulk } = props<{
  rows: Moon[]
  selected?: unknown[]
  onSelect?: (keys: unknown[]) => void
  filter?: boolean
  narrow?: 'stack' | 'scroll'
  selectAllLabel?: string
  selectedLabel?: (count: number) => string
  selectRowLabel?: (row: Moon) => string
  onBulk?: (keys: unknown[]) => void
}>()

const current = signal(rows)

const columns: Column<Moon>[] = [
  { key: 'name', header: 'Name', sortValue: true, defaultDirection: 'asc' },
  { key: 'radius', header: 'Radius', numeric: true },
]
---
button.drop(type="button" onClick={() => current.set(rows.filter(row => row.id !== 2))}) Drop
button.restore(type="button" onClick={() => current.set(rows)}) Restore
Table(columns={columns} rows={current()} rowKey="id" selectable selected={selected} onSelect={onSelect} filter={filter ? ['name'] as const : undefined} narrow={narrow} selectAllLabel={selectAllLabel} selectedLabel={selectedLabel} selectRowLabel={selectRowLabel})
  @bulk(keys, clear)
    Button.bulk-action(label="Act" onClick={() => { onBulk?.(keys); clear() }})
  @empty
    p.nothing No moons
