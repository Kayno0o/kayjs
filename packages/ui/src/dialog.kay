---
import type { JSX } from 'kay'
import { effect, signal } from 'kay'

const { open, title, level = 2, dirty = false, onOpenChange, onClose, footer, class: className, ...rest } = props<Omit<JSX.IntrinsicElements['dialog'], 'open' | 'class' | 'onClose' | 'onInput' | 'closedby' | 'closedBy'> & {
  // Shows the dialog as a modal; the parent sets it back to false in `onOpenChange`.
  open: boolean
  title: string
  // The title's heading level: a modal opens over the page's own `h1`.
  level?: 2 | 3 | 4 | 5 | 6 | undefined
  // Work the dialog must not drop, such as a request in flight: a click outside or Escape leaves it open. Typing inside the dialog counts on its own, though Escape still closes one with no footer.
  dirty?: boolean | undefined
  footer?: JSX.Element
  class?: string | undefined
} & (
  | {
    // Called with `false` however the dialog closes, a click outside and Escape included. Closed by Escape or a click outside, its content is still there to read; closed by the parent setting `open` to false, it is already gone.
    onOpenChange: (open: boolean) => void
    // Deprecated: use `onOpenChange`, which wins when both are given.
    onClose?: ((event: Event) => void) | undefined
  }
  | {
    onOpenChange?: ((open: boolean) => void) | undefined
    // Deprecated: use `onOpenChange`, which hears `false` where this heard the close event.
    onClose: (event: Event) => void
  }
)>()

// Set by any typing inside, and cleared however the dialog closes, since every way ends in its `close` event.
const edited = signal(false)
let dialog: HTMLDialogElement | undefined

effect(() => {
  const shown = open

  if (!dialog)
    return

  if (shown && !dialog.open)
    dialog.showModal()
  else if (!shown && dialog.open)
    dialog.close()
})

// Work in flight or typed text keeps a click outside from closing it; a dialog with no footer to close it from still closes with Escape once typed in.
function closeWatcher() {
  if (dirty)
    return 'none'

  if (!edited())
    return 'any'

  return footer ? 'none' : 'closerequest'
}

function closed(event: Event) {
  if (onOpenChange)
    onOpenChange(false)
  else
    onClose?.(event)

  edited.set(false)
}
---
// Named by its title for screen readers, which announce the dialog as it opens.
dialog.kui-dialog(aria-label={title} {...rest} ref={element => dialog = element} closedby={closeWatcher()} onInput={() => edited.set(true)} onClose={closed} class={className})
  if open
    if level === 2
      h2.kui-dialog-title {title}
    else if level === 3
      h3.kui-dialog-title {title}
    else if level === 4
      h4.kui-dialog-title {title}
    else if level === 5
      h5.kui-dialog-title {title}
    else
      h6.kui-dialog-title {title}
    .kui-dialog-body
      slot
    if footer
      .kui-dialog-footer
        | {footer}
