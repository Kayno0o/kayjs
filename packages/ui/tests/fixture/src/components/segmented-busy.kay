---
import Segmented from '@kaynooo/kayjs-ui/segmented.kay'

// A Segmented whose change stays busy until the test releases it, to see where focus lands when a pick is taken back.
const sizes = [{ value: 's', label: 'S' }, { value: 'm', label: 'M' }, { value: 'l', label: 'L' }] as const
let release: () => void = () => undefined

function hold(value: 's' | 'm' | 'l') {
  return new Promise<boolean>((resolve) => {
    release = () => resolve(false)
    const page = window as unknown as { held: string }
    page.held = value
  })
}
---
form
  Segmented(label="Size" name="size" options={sizes} value="m" onChange={hold})
  button#release(type="button" onClick={() => release()}) Release
