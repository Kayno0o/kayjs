---
import { signal } from 'kay'
import SidePanel from '@kaynooo/kayjs-ui/side-panel.kay'
import SplitLayout from '@kaynooo/kayjs-ui/split-layout.kay'

// What the test reads back: how often the panel closed.
const { onClose, listWidthKey } = props<{ onClose: () => void, listWidthKey?: string }>()

const open = signal(false)
const beside = signal(false)
const sidebarOpen = signal(true)
---
button#open(onClick={() => open.set(true)}) Open
button#open-beside(onClick={() => beside.set(true)}) Open beside
button#shut(onClick={() => open.set(false)}) Shut
SidePanel#panel(open={open()} title="Mars" onOpenChange={() => { open.set(false); onClose() }})
  @actions
    button#next Next
  @footer
    button#save Save
  p#body Fourth planet
SidePanel#beside(open={beside()} modal={false} closeHref="/list" title="Venus" onOpenChange={() => { beside.set(false); onClose() }})
  p#beside-body Second planet
SplitLayout#split(sidebarOpen={sidebarOpen()} onSidebarClose={() => sidebarOpen.set(false)} sidebarTitle="Planets" resizableList listWidthKey={listWidthKey} detailOpen)
  @sidebar
    nav Inner, outer
  @list
    ul#list
      li Mars
  @detail
    p#detail Mars
