---
import CopyButton from '@kaynooo/kayjs-ui/copy-button.kay'
import { memo } from 'kay'
import { accent, scheme, themeCss } from '../theme'

const css = memo(() => themeCss(accent()))
---
// The theme picked in the header, as an app's app.css and root layout would set it.
.code.theme-tokens
  .code-bar
    span css
    CopyButton(text={css()} label="Copy")
  pre
    code {css()}
// Hidden rather than left out on the system scheme: a stored scheme can apply while this island still hydrates (#451), and a branch on it would not match the server markup.
p(hidden={scheme() === 'system'}) And its root layout's #[code head] block holds #[code html(data-theme="{scheme()}")].
