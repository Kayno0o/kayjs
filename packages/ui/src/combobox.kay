--- <Value extends string>
import type { FieldSize } from './field-look'
import { fieldInvalid, fieldSize, keepInvalid } from './field-look'
import type { JSX, Snippet } from 'kay'
import type { ComboboxOption, ComboboxOptions } from './combobox'
import { effect, onCleanup, recipe, signal, uid, untrack } from 'kay'
import { enabledIndex, exactOption, matchingOptions, offersCreate } from './combobox'
import { defaultKept, onFormReset, startRef } from './form-reset'
import { wording } from 'kay/words'

// 'kui-field-input' is the field's name for the skins and an app's CSS, which the input takes its look from.
const look = recipe({
  parts: {
    root: 'kui-combobox relative inline-flex min-w-0 flex-col',
    input: 'kui-field-input',
    list: 'absolute inset-x-0 top-full z-20 m-0 mt-1 max-h-64 list-none overflow-y-auto border-solid border-[length:var(--border-width)] border-border-strong bg-popover p-1 text-sm text-foreground [&[hidden]]:hidden',
    option: 'cursor-pointer px-2 py-1.5 hover:bg-hover aria-selected:bg-hover aria-selected:outline-2 aria-selected:-outline-offset-2 aria-selected:outline-transparent aria-selected:[box-shadow:inset_2px_0_0_var(--color-accent)] aria-disabled:cursor-not-allowed aria-disabled:opacity-50 data-create:italic data-picked:font-medium data-picked:text-accent',
    optionLabel: 'block',
    optionDescription: 'block text-xs text-muted',
    status: 'sr-only',
  },
})

// A remote search waits this long after the last key.
const DEBOUNCE_MS = 200

const { size = 'md', invalid, id, options, value = '', valueLabel, label, name, minLength = 1, create = false, createLabel = (text: string) => wording('ui.combobox.create', 'Create "{text}"', { text }), loadingLabel = wording('ui.combobox.loading', 'Loading…'), emptyLabel = wording('ui.combobox.empty', 'No match'), failureLabel = wording('ui.combobox.failure', 'Could not load the options'), disabled = false, open, onOpenChange, onChange, onCreate, onInput, onLoad, onError, option: drawRow, ...rest } = props<Omit<JSX.IntrinsicElements['input'], 'size' | 'id' | 'value' | 'name' | 'class' | 'children' | 'onChange' | 'onInput' | 'onLoad' | 'onError' | 'disabled' | 'role' | 'minLength'> & {
  // The input's size: `md` by default, `sm` and `lg` change its padding and type.
  size?: FieldSize | undefined
  // Marks the control as refused, in the danger colour with `aria-invalid`. A FormField marks its control on its own while it shows a message.
  invalid?: boolean | undefined
  // The listbox's id, unique on the page; one is drawn when none is given.
  id?: string | undefined
  // A list, filtered as the visitor types, or a function handed `{ q }` that answers the options for it: an action, or an API call wrapped in one. Only the latest answer is shown.
  options: ComboboxOptions<Value>
  // The value picked; a control whose parent passes another follows it. Empty while nothing is picked.
  value?: Value | '' | undefined
  // The text of `value`, for a remote list that has not returned it: the input shows it, and no load is made for it.
  valueLabel?: string | undefined
  // Names the input for screen readers, unless a FormField labels it.
  label?: string | undefined
  // Submits the value picked, or the text typed while nothing is. Without JavaScript the input posts its text.
  name?: string | undefined
  // The characters typed before a function is asked for options.
  minLength?: number | undefined
  // Offers what was typed as a new option when no option bears its label. Picking it hands the text as the value, and `onCreate` the text.
  create?: boolean | undefined
  createLabel?: ((text: string) => string) | undefined
  loadingLabel?: string | undefined
  emptyLabel?: string | undefined
  failureLabel?: string | undefined
  disabled?: boolean | undefined
  // Shows the list when the page sets it; focus, typing, Escape, a pick and focus leaving open and close it on their own, and `onOpenChange` reports each change so a page driving `open` can set it back.
  open?: boolean | undefined
  onOpenChange?: ((open: boolean) => unknown) | undefined
  onChange?: ((value: Value | '', option: ComboboxOption<Value> | undefined) => unknown) | undefined
  // Called with the text of a created option, once it is picked.
  onCreate?: ((text: string) => unknown) | undefined
  // Called with the text in the input on every edit of it, for a filter or analytics kept beside the combobox.
  onInput?: ((text: string) => unknown) | undefined
  // Called with the options a function answered and the text it was asked for, for the latest question only: an answer that arrives after a newer key press is not reported.
  onLoad?: ((options: readonly ComboboxOption<Value>[], query: string) => unknown) | undefined
  // Called with what a function rejected with and the text it was asked for, for the latest question only; `failureLabel` still shows.
  onError?: ((error: unknown, query: string) => unknown) | undefined
  // Draws each row in place of its label and description: `@option(option)`. The row stays named by the option's `label`, and the input shows the label once it is picked.
  option?: Snippet<[option: ComboboxOption<Value>]> | undefined
}>()

const listId = id ?? uid()
const remote = typeof options === 'function'
const known = () => typeof options === 'function' ? [] : options
const startOption = () => known().find(option => option.value === value)

// A remote value has no label to show until the visitor searches, so its raw id stays out of the input; a list shows the value for want of a label.
const fallbackLabel = (next: string) => valueLabel ?? (remote ? '' : next)
const startLabel = () => startOption()?.label ?? fallbackLabel(value)

// Without JavaScript the input posts its text, which a refused post of its form gives back in place of the starting one.
const sent = onChange ? undefined : postedValue(name, startLabel())
const text = signal(sent ?? startLabel())
const picked = signal<ComboboxOption<Value> | undefined>(startOption() ?? (value ? { value: value as Value, label: startLabel() } : undefined))
const opened = signal(false)
const active = signal(-1)
const found = signal<readonly ComboboxOption<Value>[]>([])
// The text the answers held in `found` are for.
const answered = signal<string | undefined>(undefined)
const failed = signal(false)
// Set once the browser runs, so the first render is the page without JavaScript: the text posts as it is and the browser's own suggestions apply, which the listbox drawn here replaces.
const enhanced = signal(false)
let input: HTMLInputElement | undefined
let request = 0

effect(() => {
  const next = value

  if (next === untrack(() => picked()?.value ?? ''))
    return

  const option = untrack(() => [...known(), ...found()].find(candidate => candidate.value === next))
  const chosen = option ?? (next ? { value: next, label: fallbackLabel(next) } : undefined)

  picked = chosen
  text = chosen?.label ?? ''
})

effect(() => {
  enhanced = true
})

// A FormField wraps the control in its label, so the status line and the rows would join the input's name: it is named by the label's own text instead, and so is the list.
effect(() => {
  if (!enhanced() || label !== undefined || rest['aria-labelledby'] !== undefined)
    return

  const labelText = input?.closest('label')?.querySelector('.kui-label-text')

  if (!labelText)
    return

  labelText.id ||= uid()
  input?.setAttribute('aria-labelledby', labelText.id)
  document.getElementById(listId)?.setAttribute('aria-labelledby', labelText.id)
})

// The option whose value goes in a hidden field of its own, once the browser runs: one posting its label alone is the input's text.
const carried = () => {
  const option = picked()

  return enhanced() && option && option.value !== option.label ? option : undefined
}

const rows = () => remote ? found() : matchingOptions(known(), text())
// A remote list is asked for once the text reaches `minLength`, and is waiting until its answer lands.
const waiting = () => remote && text().trim().length >= minLength && answered() !== text()
const offered = () => create && !waiting() && offersCreate(remote ? found() : known(), text())
const shown = () => opened() && count() > 0
const count = () => rows().length + (offered() ? 1 : 0)
// The description, none when it is only whitespace.
const described = (option: ComboboxOption<Value>) => option.description?.trim() || undefined

const optionId = (index: number) => `${listId}-option-${index}`
const flags = () => [...rows().map(option => option.disabled === true), ...offered() ? [false] : []]

const status = () => {
  if (!opened() || (remote && text().trim().length < minLength))
    return ''

  if (waiting())
    return loadingLabel

  if (failed())
    return failureLabel

  return count() === 0 ? emptyLabel : wording('ui.combobox.results', count() === 1 ? '1 result' : '{count} results', { count: count() })
}

// An app's callback that throws is logged, not taken for a failed load.
function notify(call: () => unknown) {
  try {
    call()
  }
  catch (error) {
    console.error('kayjs-ui: a Combobox callback threw', error)
  }
}

// Only the latest question lands: an answer arriving after a newer key press is dropped.
async function load(query: string) {
  const mine = ++request

  if (typeof options !== 'function' || query.trim().length < minLength) {
    found = []
    answered = query

    return
  }

  try {
    const answer = await options({ q: query })

    if (mine !== request)
      return

    found = answer
    answered = query
    failed = false
    active = -1
    notify(() => onLoad?.(answer, query))
  }
  catch (error) {
    if (mine === request) {
      console.error('kayjs-ui: a Combobox could not load its options', error)
      found = []
      answered = query
      failed = true
      notify(() => onError?.(error, query))
    }
  }
}

// What the page was last told, so a change it made itself is not echoed back.
let told = untrack(() => opened())

effect(() => {
  if (open === undefined)
    return

  told = open
  opened = open

  if (open && untrack(() => remote && found().length === 0))
    void load(untrack(() => text()))
})

effect(() => {
  const now = opened()

  if (now === told)
    return

  told = now
  untrack(() => onOpenChange?.(now))
})

// The search waits for a pause in typing; a list filters at once.
effect(() => {
  const query = text()

  if (!untrack(() => opened()) || !remote)
    return

  const timer = setTimeout(() => void load(query), DEBOUNCE_MS)

  onCleanup(() => clearTimeout(timer))
})

// A new key drops the rows and the answer still on its way: they are for an older text.
function type(next: string) {
  request++
  opened = true
  text = next
  active = -1
  failed = false
  onInput?.(next)

  if (remote)
    found = []

  if (picked()) {
    picked = undefined
    onChange?.('', undefined)
  }
}

function pick(index: number) {
  const row = rows()[index]
  const option = row ?? (index === rows().length && offered() ? { value: text().trim() as Value, label: text().trim() } : undefined)

  if (!option || option.disabled)
    return

  picked = option
  text = option.label
  opened = false
  active = -1

  if (!row)
    onCreate?.(option.label)

  onChange?.(option.value, option)
}

// Typing a label whole is a pick, for the visitor who never reaches for the list.
function adopt(): boolean {
  if (picked())
    return false

  const option = exactOption(remote ? found() : known(), text())

  if (!option)
    return false

  picked = option
  text = option.label
  onChange?.(option.value, option)

  return true
}

function move(step: 1 | -1) {
  if (!opened()) {
    opened = true

    if (remote)
      void load(text())
  }

  active = enabledIndex(flags(), active(), step)
}

// The arrows move through the options with focus staying in the input, as the combobox pattern has it; Enter picks the active one, Escape closes the list and a second Escape clears the text.
function keyDown(event: KeyboardEvent) {
  if (event.altKey && event.key === 'ArrowDown') {
    event.preventDefault()
    opened = true

    return
  }

  if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey)
    return

  switch (event.key) {
    case 'ArrowDown':
      event.preventDefault()
      move(1)
      break
    case 'ArrowUp':
      event.preventDefault()
      move(-1)
      break
    case 'Enter':
      if (shown() && active() !== -1) {
        event.preventDefault()
        pick(active())
      }
      else if (adopt()) {
        event.preventDefault()
        opened = false
      }

      break
    case 'Escape':
      if (opened()) {
        // An open list with no row to hold the press leaves it to an enclosing dialog.
        if (shown())
          event.preventDefault()

        opened = false
        active = -1
      }
      else if (text() !== '' || picked()) {
        const had = picked()

        event.preventDefault()
        text = ''
        picked = undefined

        if (had)
          onChange?.('', undefined)
      }

      break
    default:
      break
  }
}

function focusIn() {
  if (remote && (picked() || text().trim().length < minLength))
    return

  opened = true

  if (remote && found().length === 0)
    void load(text())
}

// A click on an option keeps focus in the input, so the list closes on focus leaving rather than on that press.
function focusOut() {
  adopt()
  opened = false
  active = -1
}

effect(() => {
  const index = active()

  if (index !== -1 && shown())
    document.getElementById(optionId(index))?.scrollIntoView({ block: 'nearest' })
})

// What a reset goes back to: the pick it started with, or the one last saved by a SaveForm.
const initial = defaultKept(() => input, () => ({ text: text(), picked: picked() }), untrack(() => ({ text: text(), picked: picked() })))

onFormReset(() => input, () => {
  text = initial().text
  picked = initial().picked
  opened = false
  active = -1
})

const ref = startRef<HTMLInputElement>((element) => {
  input = element
  keepInvalid(element, () => invalid)
}, rest.ref)
---
div(part="root")
  input(
    part="input"
    {...rest}
    data-size={fieldSize(size)} aria-invalid={fieldInvalid(() => invalid) ?? rest['aria-invalid']}
    ref={ref}
    type="text"
    role="combobox"
    autocomplete="off"
    name={carried() ? undefined : name}
    value={text()}
    disabled={disabled}
    list={!remote && !enhanced() ? `${listId}-native` : undefined}
    aria-label={label}
    aria-expanded={shown() ? 'true' : 'false'}
    aria-controls={listId}
    aria-autocomplete="list"
    aria-activedescendant={shown() && active() !== -1 ? optionId(active()) : undefined}
    onInput={event => type(event.currentTarget.value)}
    onKeyDown={keyDown}
    onFocusIn={focusIn}
    onFocusOut={focusOut}
  )
  if name && carried() as option
    input(type="hidden" name={name} value={option.value} disabled={disabled})
  if !remote
    datalist(id={`${listId}-native`})
      for option of known() key={option.value}
        option(value={option.label})
  // Pressing the list, its scrollbar included, keeps focus in the input.
  ul(part="list" id={listId} role="listbox" aria-label={label} aria-busy={waiting() ? 'true' : undefined} hidden={!shown()} onMouseDown={event => event.preventDefault()})
    for option, index of rows() key={option.value}
      li(part="option" id={optionId(index)} role="option" aria-selected={active() === index ? 'true' : 'false'} aria-disabled={option.disabled ? 'true' : undefined} aria-label={drawRow ? option.label : undefined} aria-labelledby={!drawRow && described(option) ? `${optionId(index)}-label` : undefined} aria-describedby={!drawRow && described(option) ? `${optionId(index)}-description` : undefined} data-picked={picked()?.value === option.value ? '' : undefined} onClick={() => pick(index)})
        if drawRow
          | {drawRow(option)}
        else if described(option)
          span(part="optionLabel" id={`${optionId(index)}-label`}) {option.label}
          span(part="optionDescription" id={`${optionId(index)}-description`}) {described(option)}
        else
          | {option.label}
    if offered()
      li(part="option" id={optionId(rows().length)} role="option" aria-selected={active() === rows().length ? 'true' : 'false'} data-create="" onClick={() => pick(rows().length)}) {createLabel(text().trim())}
  // Read out as the list loads and settles, which otherwise changes in silence.
  p(part="status" role="status") {status()}
