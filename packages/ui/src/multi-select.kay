---
import type { JSX } from 'kay'
import type { MultiSelectOption } from './multi-select'
import type { PopoverPlacement } from './popover'
import { effect, signal } from 'kay'
import Icon from './icon.kay'
import { selectionSummary, toggledValue } from './multi-select'
import Popover from './popover.kay'

// Past this many options the panel opens on a search box.
const SEARCH_FROM = 8

const { id, options, value = [], label, placeholder = 'Any', name, search, disabled = false, placement = 'bottom-start', onChange, class: className, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'id' | 'class' | 'children' | 'onChange'> & {
  // Pairs the panel with its trigger, so it is unique on the page.
  id: string
  options: readonly MultiSelectOption[]
  // The values picked to start with; a control whose parent passes others follows them.
  value?: string[]
  // Names the control for screen readers.
  label: string
  // What the trigger reads while nothing is picked.
  placeholder?: string
  // Submits each picked value under this name, for a control inside a form.
  name?: string
  // Opens on a search box; on by default past eight options.
  search?: boolean
  disabled?: boolean
  placement?: PopoverPlacement
  onChange?: (value: string[]) => void
  class?: string
}>()

const picked = signal<string[]>(value)
const query = signal('')
let root: HTMLElement | undefined

effect(() => picked.set(value))

const searchable = () => search ?? options.length > SEARCH_FROM

const shown = () => {
  const needle = query().trim().toLowerCase()

  return needle ? options.filter(option => option.label.toLowerCase().includes(needle)) : options
}

function set(next: string[]) {
  picked.set(next)
  onChange?.(next)
}

// The panel only shows once the browser has opened the popover, so focus moves on its toggle rather than on the click; closing clears the search.
function toggled(open: boolean) {
  if (open)
    root?.querySelector<HTMLInputElement>('.multi-select-search, .multi-select-checkbox')?.focus()
  else
    query.set('')
}
---
.multi-select({...rest} ref={element => root = element} class={className})
  Popover(id={id} placement={placement} class="multi-select-panel" aria-label={label} onToggle={toggled})
    @trigger(attributes)
      button.field-input.multi-select-trigger({...attributes} type="button" aria-label={label} disabled={disabled} data-empty={picked().length === 0 || undefined})
        span.multi-select-summary {selectionSummary(options, picked(), placeholder)}
        Icon(icon="chevron" class="multi-select-chevron")
    if searchable()
      input.field-input.multi-select-search(type="search" placeholder="Search" aria-label={`Search ${label}`} value={query()} onInput={event => query.set(event.currentTarget.value)})
    .multi-select-bar
      button.multi-select-action(type="button" disabled={picked().length === options.length} onClick={() => set(options.map(option => option.value))}) All
      button.multi-select-action(type="button" disabled={picked().length === 0} onClick={() => set([])}) None
    .multi-select-options(role="group" aria-label={label})
      for option of shown() key={option.value}
        label.multi-select-option
          input.multi-select-checkbox(type="checkbox" checked={picked().includes(option.value)} onChange={() => set(toggledValue(options, picked(), option.value))})
          span.multi-select-label {option.label}
      if shown().length === 0
        p.multi-select-empty No match
  if name
    for entry of picked() key={entry}
      input(type="hidden" name={name} value={entry})
