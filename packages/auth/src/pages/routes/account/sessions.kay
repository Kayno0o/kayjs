--- server
import { formatRelativeTime, localize } from 'kay/i18n'
import { wording } from 'kay/words'
import { schemas } from '../../forms'
import Badge from '@kaynooo/kayjs-ui/badge.kay'
import Button from '@kaynooo/kayjs-ui/button.kay'
import CardRow from '@kaynooo/kayjs-ui/card-row.kay'
import PageSection from '@kaynooo/kayjs-ui/page-section.kay'

// Ending this device's own session signs it out, so it leaves the account pages.
export const end = action(schemas.id, async ({ id }, ctx) => {
  const auth = ctx.locals.auth
  const current = (await auth.listSessions()).find(session => session.current)?.id === id

  await auth.revokeSession(id)

  return current ? ctx.redirect(localize(auth.features().pages?.home ?? '/')) : 'ended'
})

export const endOthers = action(async (ctx) => {
  await ctx.locals.auth.signOutEverywhere({ keepThisOne: true })

  return 'ended'
})

const sessions = await ctx.locals.auth.listSessions()
const describe = (session: (typeof sessions)[number]) => [session.device.browser, session.device.os].filter(Boolean).join(', ') || wording('auth.account.sessions.unknown', 'Unknown device')
---
PageSection(title={wording('auth.account.sessions.title', 'Where you are signed in')})
  @actions
    if sessions.length > 1
      form(action={endOthers})
        Button(type="submit" label={wording('auth.account.sessions.endOthers', 'Sign out everywhere else')})
  .flex.flex-col.gap-2
    for session of sessions key={session.id}
      CardRow(data-session={session.id})
        @right
          form(action={end})
            input(type="hidden" name="id" value={session.id})
            Button(type="submit" label={wording('auth.account.sessions.end', 'Sign out')} aria-label={`${wording('auth.account.sessions.end', 'Sign out')}: ${describe(session)}`})
        .flex.flex-col
          span.flex.flex-wrap.items-center.gap-2
            strong {describe(session)}
            if session.device.mobile
              span.text-kui-muted {wording('auth.account.sessions.mobile', 'mobile')}
            if session.current
              Badge(label={wording('auth.account.sessions.current', 'This device')} tone="accent")
          span.text-kui-muted
            | {[session.place, session.ip].filter(Boolean).join(' · ')}
          span.text-kui-muted {wording('auth.account.sessions.lastSeen', 'Last seen {date}', { date: formatRelativeTime(session.lastSeenAt) })}
