---
import TooltipHost from '@kaynooo/kayjs-ui/tooltip-host.kay'
---
//- A group locked with a disabled fieldset, as kayjs-cms locks the fields a role may not change: its tooltip must show under the pointer over the fieldset and over a disabled control inside it.
main
  fieldset#locked(disabled data-tooltip="Your role may not publish" tabindex="0")
    input#locked-input(type="date" aria-label="Publish on")
  p#elsewhere Elsewhere
  TooltipHost
