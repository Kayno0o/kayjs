---
import type { Component, Snippet } from 'kay'
import Chat from './chat.kay'
import Panel from './chat-panel.kay'

import Icon from '@kaynooo/kayjs-ui/icon.kay'

type ChatProps = typeof Chat extends Component<infer Props> ? Props : never

const { icons, icon, closeIcon, turn, actions, call, source, empty, footer, sendIcon, stopIcon, attachIcon, newIcon, expandIcon, collapseIcon, note, openLabel, closeLabel, open, onOpenChange, hash, onSend, onReply, onStop, onError, onToolCall, onRegenerate, onEdit, onSuggestion, suggestions, newLabel, expandLabel, collapseLabel, remember, class: className, ...chat } = props<Omit<ChatProps, 'class' | 'links' | 'remember' | 'conversationIn' | 'newButton' | 'sendIcon' | 'stopIcon' | 'attachIcon' | 'onSend' | 'onReply' | 'onStop' | 'onError' | 'onToolCall' | 'onRegenerate' | 'onEdit' | 'onSuggestion' | 'suggestions' | 'turn' | 'actions' | 'call' | 'source' | 'empty' | 'footer'> & {
  // The text of the button while the panel is closed and while it is open; `Open the chat` and `Close the chat` by default. The chat's `label` heads the panel.
  openLabel?: string | undefined
  closeLabel?: string | undefined
  // Opens and closes the panel when the app sets it, such as an "Ask the assistant" button elsewhere on the page, or to close it after a navigation; left out, the button and Escape work on their own. `onOpenChange(open)` is called when the visitor opens or closes it, so the app's state follows.
  open?: boolean | undefined
  onOpenChange?: ((open: boolean) => unknown) | undefined
  // The address fragment that opens the panel, on load and when it changes to it, so a plain `<a href="#chat">` opens it; `#chat` by default, `false` for none. A window `kai-chat-open` event opens it too.
  hash?: string | false | undefined
  // The tab's session storage key the conversation is kept under, so a reload finds it; none by default, as the next visitor to use the tab would read it. A site with sign-in gives one per visitor.
  remember?: string | undefined
  // What the round buttons draw, by name, in place of the library's own, as `Chat` takes them, with the panel's `open`, `close`, `expand` and `collapse` besides.
  icons?: (ChatProps['icons'] & Partial<Record<'open' | 'close' | 'expand' | 'collapse', NonNullable<ChatProps['icons']>['send']>>) | undefined
  // Before 1.90 each icon was a block of its own; they work until 1.93 and win over `icons` (`deprecated-chat-icons`). These two draw the button and the panel's close button, in place of a chat bubble and a cross.
  icon?: Snippet
  closeIcon?: Snippet
  // The header's two other buttons, which clear the conversation and enlarge the panel: a new-chat plus, and a pair of arrows out and in.
  newIcon?: Snippet
  // What the chat hears and the questions it offers, as `Chat` takes them: the callbacks, and `suggestions` as a list or a function.
  onSend?: ChatProps['onSend']
  onReply?: ChatProps['onReply']
  onStop?: ChatProps['onStop']
  onError?: ChatProps['onError']
  onToolCall?: ChatProps['onToolCall']
  onRegenerate?: ChatProps['onRegenerate']
  onEdit?: ChatProps['onEdit']
  onSuggestion?: ChatProps['onSuggestion']
  suggestions?: ChatProps['suggestions']
  // The chat's blocks, as `Chat` takes them: its turns, the buttons under a turn, a tool call, a cited source, the empty chat and a footer under the form.
  turn?: ChatProps['turn']
  actions?: ChatProps['actions']
  call?: ChatProps['call']
  source?: ChatProps['source']
  empty?: ChatProps['empty']
  footer?: ChatProps['footer']
  // The chat's round buttons, as `Chat` takes them.
  sendIcon?: Snippet
  stopIcon?: Snippet
  attachIcon?: Snippet
  expandIcon?: Snippet
  collapseIcon?: Snippet
  // Names and tooltips of those buttons: `New conversation`, `Enlarge the chat` and `Shrink the chat`.
  newLabel?: string | undefined
  expandLabel?: string | undefined
  collapseLabel?: string | undefined
  // A line under the chat, such as a warning that its answers can be wrong.
  note?: Snippet
  // On the button and panel's wrapper.
  class?: string | undefined
}>()

// The blocks the app gave, passed on to the chat. A function passed to the chat island makes this component render as an island when the app gives one, and only then.
function forwarded() {
  const given: Pick<ChatProps, 'turn' | 'actions' | 'call' | 'source' | 'empty' | 'footer' | 'onSend' | 'onReply' | 'onStop' | 'onError' | 'onToolCall' | 'onRegenerate' | 'onEdit' | 'onSuggestion' | 'suggestions'> = {}

  if (onSend) given.onSend = onSend
  if (onReply) given.onReply = onReply
  if (onStop) given.onStop = onStop
  if (onError) given.onError = onError
  if (onToolCall) given.onToolCall = onToolCall
  if (onRegenerate) given.onRegenerate = onRegenerate
  if (onEdit) given.onEdit = onEdit
  if (onSuggestion) given.onSuggestion = onSuggestion
  if (suggestions) given.suggestions = suggestions

  if (turn) given.turn = turn
  if (actions) given.actions = actions
  if (call) given.call = call
  if (source) given.source = source
  if (empty) given.empty = empty
  if (footer) given.footer = footer

  return given
}

// What the app set of the panel's opening, as getters so a change of `open` reaches the panel; a function passed to the panel by name would make this component an island whatever the app gives.
function opening() {
  return {
    get open() { return open },
    get onOpenChange() { return onOpenChange },
    get hash() { return hash },
  }
}
---
// The panel keeps its state across page swaps, and the chat inside hydrates, and so loads, when the panel is first shown. A conversation kept on the server is named by the browser, as the panel is on every page and the address of none.
Panel(persist {...opening()} label={chat.label} openLabel={openLabel} closeLabel={closeLabel} newLabel={newLabel} expandLabel={expandLabel} collapseLabel={collapseLabel} class={className})
  @icon
    if icon
      | {icon}
    else
      Icon(icon={icons?.open ?? 'chat'})
  @closeIcon
    if closeIcon
      | {closeIcon}
    else
      Icon(icon={icons?.close ?? 'close'})
  @newIcon
    if newIcon
      | {newIcon}
    else
      Icon(icon={icons?.new ?? 'plus'})
  @expandIcon
    if expandIcon
      | {expandIcon}
    else
      Icon(icon={icons?.expand ?? 'expand'})
  @collapseIcon
    if collapseIcon
      | {collapseIcon}
    else
      Icon(icon={icons?.collapse ?? 'collapse'})
  Chat(hydrate="visible" {...chat} {...forwarded()} icons={icons} remember={remember} links="here" conversationIn="browser")
    @sendIcon
      if sendIcon
        | {sendIcon}
      else
        Icon(icon={icons?.send ?? 'send'})
    @stopIcon
      if stopIcon
        | {stopIcon}
      else
        Icon(icon={icons?.stop ?? 'stop'})
    @attachIcon
      if attachIcon
        | {attachIcon}
      else
        Icon(icon={icons?.attach ?? 'plus'})
  if note
    .kai-launcher-note
      | {note}
