---
import type { Source } from './types'
import { recipe, uid } from 'kay'
import { opensApart, REL_APART, REL_HERE } from './chat-sources'

const look = recipe({ parts: { root: 'kai-chat-sources', label: 'kai-chat-sources-label', list: 'kai-chat-sources-list', item: 'kai-chat-source', link: 'kai-chat-source-link' } })

const { sources, label, here } = props<{
  sources: Source[]
  label: string
  // A source of this site opens in place instead of a new tab.
  here: boolean
}>()

const labelId = uid()
---
div(part="root")
  small(part="label" id={labelId}) {label}
  ol(part="list" aria-labelledby={labelId})
    for source of sources key={source.n}
      const apart = opensApart(source.href, here)
      li(part="item" value={source.n})
        a(part="link" href={source.href} target={apart ? '_blank' : undefined} rel={apart ? REL_APART : REL_HERE} data-new-tab={apart ? '' : undefined}) {source.title}
