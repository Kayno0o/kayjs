--- server
import { t } from 'elysia'
import { action } from 'kay'

// Each post costs the browser a challenge, solved in a worker.
export const pay = action({ input: t.Object({ title: t.String({ maxLength: 200 }) }), protect: { proofOfWork: 5000 } }, ({ title }, ctx) => title === 'refused' ? ctx.deny(409, { message: 'Refused' }) : title)

const success = pay.succeeded()
const failure = pay.form.failed()
--- script
import Payer from '../components/payer.kay'
---
head
  title Costly
h1 Costly
form(action={pay})
  input(name="title" aria-label="Title")
  button Pay
if success then done
  p.paid Paid {done.data}
if failure then failed
  p.refused {failed.status}
Payer
