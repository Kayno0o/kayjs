--- server
import Badge from '@kayjs/ui/badge.kay'
import Button from '@kayjs/ui/button.kay'
import CardRow from '@kayjs/ui/card-row.kay'
import EmptyState from '@kayjs/ui/empty-state.kay'
import Icon from '@kayjs/ui/icon.kay'
import PageSection from '@kayjs/ui/page-section.kay'
import { wording } from 'kay/words'
import EntryEdited from '../components/entry-edited.kay'
import Refused from '../components/refused.kay'
import { denials, reachOf } from '../access'
import { hiddenOf } from '../hidden'
import { collections } from '../kay/content'
import { activityPath, adminTitle, collectionTitle, groupCollections, problemId } from '../listing'
import { screenPath } from '../paths'
import { indexRows } from '../screens'
import { settings } from '../settings'

const { prefix } = settings()
const all = await collections()
const localized = all.some(collection => collection.localized && (collection.locales?.length ?? 0) > 1)
const logged = all.some(collection => hiddenOf(collection.name, 'activity') !== undefined)
const denied = await denials(ctx)
const groups = groupCollections(await indexRows(await reachOf(ctx)), row => row.layout)
---
head
  title {adminTitle(wording('cms.admin.content', 'Content'))}
PageSection(title={wording('cms.admin.content', 'Content')} level={1})
  @actions
    if localized
      Button(href={screenPath(prefix, '/translations')} label={wording('cms.locales.title', 'Translations')})
    if denied.redirects then reason
      Refused(label={wording('cms.missing.title', 'Missing pages')} reason={reason})
    else
      Button(href={screenPath(prefix, '/not-found')} label={wording('cms.missing.title', 'Missing pages')})
    if logged
      if denied.delete then reason
        Refused(label={wording('cms.activity.title', 'Activity')} reason={reason})
      else
        Button(href={activityPath(prefix)} label={wording('cms.activity.title', 'Activity')})
    if denied.site then reason
      Refused(label={wording('cms.admin.media', 'Media')} reason={reason})
      Refused(label={wording('cms.admin.uploads', 'Unused uploads')} reason={reason})
    else
      Button(href={screenPath(prefix, '/media')} label={wording('cms.admin.media', 'Media')})
      Button(href={screenPath(prefix, '/uploads')} label={wording('cms.admin.uploads', 'Unused uploads')})
  for group of groups key={group.name ?? ''}
    if group.name
      h2.kcms-group-title {group.name}
    for row of group.collections key={row.collection.name}
      CardRow
        @left
          if row.layout?.icon then icon
            Icon(icon={icon})
        @right
          if row.collection.problem then problem
            Badge(tone="danger" label={wording('cms.admin.unreadable', 'Cannot be read')})
            span.kcms-sr-only(id={problemId(row.collection.name)}) {problem}
          else
            if row.drafts
              Badge(tone="warning" label={wording('cms.admin.draftCount', row.drafts === 1 ? '1 draft' : '{count} drafts', { count: row.drafts })})
            if row.scheduled
              Badge(tone="info" label={wording('cms.admin.scheduledCount', row.scheduled === 1 ? '1 scheduled' : '{count} scheduled', { count: row.scheduled })})
            if !row.collection.single
              span {wording('cms.admin.entryCount', row.collection.total === 1 ? '1 entry' : '{count} entries', { count: row.collection.total ?? 0 })}
            if row.newHref then href
              Button(href={href} label={wording('cms.admin.newEntry', 'New entry')} aria-label={wording('cms.admin.newEntryIn', 'New entry in {collection}', { collection: collectionTitle(row.collection) })} icon="plus" size="sm")
        a(href={row.href} data-tooltip={row.collection.problem} aria-describedby={row.collection.problem === undefined ? undefined : problemId(row.collection.name)}) {collectionTitle(row.collection)}
        if row.collection.description
          p.kcms-entry-subtitle {row.collection.description}
        if row.edited then edit
          p.kcms-entry-subtitle
            EntryEdited(editedAt={new Date(edit.at)} author={edit.author} sentence)
  else
    EmptyState(title={wording('cms.admin.noCollections', 'No collections')} description={wording('cms.admin.noCollectionsHint', 'This site declares no content collection in its content config.')})
