---
import type { MediaItem } from '@kaynooo/kayjs-ui'
import ImageCropper from '@kaynooo/kayjs-ui/image-cropper.kay'
import Masonry from '@kaynooo/kayjs-ui/masonry.kay'
import MediaGallery from '@kaynooo/kayjs-ui/media-gallery.kay'
import WhenVisible from '@kaynooo/kayjs-ui/when-visible.kay'
import ZoomPane from '@kaynooo/kayjs-ui/zoom-pane.kay'

// What the test reads back: each turn of the gallery, each crop, and each call for more rows; `onTiles` hands it a way to change the masonry's tiles.
const { onIndexChange, onCrop, onCropEnd, onCropError, startCrop, onMore, onTiles } = props<{ onCropEnd?: (crop: { x: number, y: number, w: number, h: number }) => void, onCropError?: () => void, startCrop?: { x: number, y: number, w: number, h: number }, onIndexChange: (index: number) => void, onCrop: (crop: { x: number, y: number, w: number, h: number }) => void, onMore: () => void, onTiles?: (set: (tiles: string[]) => void) => void }>()

const tiles = signal(['a', 'b', 'c'])
// The crop the app controls: `#preset` sets another, as a preset button would.
const controlled = signal(startCrop)

onTiles?.(next => tiles = next)

const items: MediaItem[] = [
  { key: 1, kind: 'image', thumb: '/a-thumb.png', preview: '/a.png', full: '/a-full.png', title: 'Mars' },
  { key: 2, kind: 'video', thumb: '/b-thumb.png', preview: '/b.png', src: '/b.mp4', captions: '/b.vtt' },
  { key: 3, kind: 'image', thumb: '/c-thumb.png', preview: '/c.png' },
]
---
MediaGallery#gallery(items={items} onIndexChange={onIndexChange})
ZoomPane#zoom(label="Map")
  // kay-allow unsized-image
  img(src="/map.png" alt="")
  input#zoom-field(aria-label="Note")
button#preset(type="button" onClick={() => controlled = { x: 40, y: 20, w: 100, h: 50 }}) Preset
ImageCropper#cropper(src="/photo.png" ratio={2} crop={controlled()} onCrop={onCrop} onCropEnd={onCropEnd} onError={onCropError})
  @footer(reset)
    button#reset(type="button" onClick={reset}) Reset
Masonry#masonry(items={tiles()} key={item => item})
  @tile(item)
    p {item}
WhenVisible(onVisible={onMore})
