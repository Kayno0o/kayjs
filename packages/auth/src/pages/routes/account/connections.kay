--- server
import { localize, t } from 'kay/i18n'
import Message from '../../components/message.kay'
import Proof from '../../components/proof.kay'
import { failure, oauthFailure, proofOf, schemas } from '../../forms'
import Badge from '@kaynooo/kayjs-ui/badge.kay'
import Button from '@kaynooo/kayjs-ui/button.kay'
import CardRow from '@kaynooo/kayjs-ui/card-row.kay'
import PageSection from '@kaynooo/kayjs-ui/page-section.kay'

// Leaves for the provider once the proof holds, and comes back here.
export const connect = action(schemas.unlink, async (input, ctx) => {
  const auth = ctx.locals.auth
  const features = auth.features()
  const started = await auth.linkProvider(input.provider, proofOf(input), { redirect: localize(`${features.pages?.prefix ?? features.prefix}/account/connections`) })

  return started.ok ? ctx.redirect(started.url) : ctx.fail(400, { error: started.error, provider: input.provider })
})

export const disconnect = action(schemas.unlink, async (input, ctx) => {
  const result = await ctx.locals.auth.unlink(input.provider, proofOf(input))

  return result.ok ? 'disconnected' : ctx.fail(400, { error: result.error, provider: input.provider })
})

const auth = ctx.locals.auth
const user = (await auth.user())!
const features = auth.features()
const linked = new Set(await auth.identities())
const refused = ctx.failed(connect)?.data ?? ctx.failed(disconnect)?.data
---
PageSection(title={t('auth.account.connections.title')})
  .flex.flex-col.gap-2
    p {t('auth.account.connections.intro')}
    for provider of features.providers key={provider.name}
      CardRow(data-provider={provider.name})
        .flex.flex-col.gap-2
          span.flex.items-center.gap-2
            strong {provider.label}
            if linked.has(provider.name)
              Badge(label={t('auth.account.connections.connected')} tone="success")
          if refused?.provider === provider.name
            Message(text={oauthFailure(refused.error) ?? failure(refused.error)})
          if linked.has(provider.name)
            form.flex.flex-wrap.items-end.gap-2(action={disconnect})
              input(type="hidden" name="provider" value={provider.name})
              Proof(user={user})
              Button(type="submit" variant="danger" label={t('auth.account.connections.disconnect')})
          else
            form.flex.flex-wrap.items-end.gap-2(action={connect})
              input(type="hidden" name="provider" value={provider.name})
              Proof(user={user} secondFactor)
              Button(type="submit" label={t('auth.account.connections.connect')})
    else
      p {t('auth.account.connections.none')}
