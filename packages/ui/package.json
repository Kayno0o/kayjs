{
  "name": "@kaynooo/kayjs-ui",
  "type": "module",
  "version": "0.4.36",
  "description": "kay components: dialogs, tables, toasts, forms and the rest of what the user's sites share, as .kay sources the app compiles as its own",
  "author": "Kaynooo <https://git.kaynooo.fr/kaynooo>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://git.kaynooo.fr/kaynooo/kayjs-ui"
  },
  "bugs": {
    "url": "https://git.kaynooo.fr/kaynooo/kayjs-ui/issues"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/"
  },
  "sideEffects": false,
  "kay": {
    "settings": "./src/settings.ts"
  },
  "exports": {
    "./*.kay": "./src/*.kay",
    "./theme.css": "./src/theme.css",
    "./dnd": "./src/dnd.ts",
    ".": "./src/index.ts"
  },
  "files": [
    "LICENSE",
    "README.md",
    "llms.txt",
    "src"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "prepare": "bun scripts/link-fixture.ts",
    "check": "$npm_execpath check",
    "lint": "keslint --cache",
    "lint:fix": "keslint --fix --cache",
    "test": "bun test && bun run test:dom",
    "test:dom": "bun --config=tests-dom/bunfig.toml test"
  },
  "peerDependencies": {
    "@iconify-json/tabler": "^1.2.41",
    "chartist": "^1.5.0",
    "hls.js": "^1.7.0",
    "kay": "^0.8.1 || ^0.9.0 || ^0.10.0 || ^0.11.0 || ^0.12.0 || ^0.13.0 || ^0.14.0 || ~1.0.0 || ~1.1.0 || ~1.2.0 || ~1.3.0 || ~1.4.0 || ~1.5.0 || ~1.6.0 || ~1.7.0 || ~1.8.0 || ~1.9.0 || ~1.10.0 || ~1.11.0 || ~1.12.0 || ~1.13.0 || ~1.14.0 || ~1.15.0 || ~1.16.0 || ~1.17.0 || ~1.18.0 || ~1.19.0 || ~1.20.0 || ~1.21.0 || ~1.23.0 || ~1.24.0 || ~1.25.0 || ~1.26.0 || ~1.27.0 || ~1.28.0 || ~1.29.0 || ~1.30.0",
    "tailwindcss": "^4.3.3"
  },
  "peerDependenciesMeta": {
    "chartist": {
      "optional": true
    },
    "hls.js": {
      "optional": true
    }
  },
  "dependencies": {
    "@kaynooo/utils": "^2.24.1"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@iconify-json/tabler": "^1.2.41",
    "@kaynooo/eslint": "^6.0.1",
    "@types/bun": "^1.4.2",
    "chartist": "^1.5.0",
    "elysia": "^1.4.30",
    "hls.js": "^1.7.0",
    "kay": "npm:@kaynooo/kayjs@~1.30.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
