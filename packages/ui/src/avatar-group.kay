---
import type { JSX, Snippet } from 'kay'
import type { GroupedAvatar } from './avatar-group'
import type { OptionsSource } from './options-source'
import type { PopoverPlacement } from './popover'
import type { Size } from './size'
import { recipe } from 'kay'
import { wording } from 'kay/words'
import Avatar from './avatar.kay'
import { loadOptions } from './options-source'
import Popover from './popover.kay'

// 'kui-avatar-group' is the component's name for an app's CSS and tests. The avatars overlap; the overflow chip is an avatar-sized button or link, the rest of the people a list in its popover.
const look = recipe({
  parts: {
    root: 'kui-avatar-group flex items-center [&>.kui-avatar:not(:first-child)]:-ms-2',
    more: '-ms-2 first:ms-0 grid shrink-0 cursor-pointer place-items-center rounded-[calc(infinity*1px)] border-0 bg-transparent p-0 text-foreground no-underline outline-none focus-visible:[outline:2px_solid_var(--color-accent)] focus-visible:outline-offset-2',
    count: 'text-xs [font-weight:var(--font-weight-semibold)]',
    panel: 'kui-avatar-group-panel min-w-48 [--_avatar-ground:var(--color-popover)]',
    item: '',
    list: 'm-0 flex list-none flex-col gap-1 p-2',
    row: 'flex items-center gap-2 rounded-md p-1 text-sm text-foreground no-underline [&:is(a)]:hover:bg-hover [&:is(a)]:focus-visible:bg-hover',
    name: 'min-w-0 [overflow-wrap:anywhere]',
    retry: 'cursor-pointer self-center text-xs text-accent underline',
    status: 'self-center text-xs text-muted',
  },
})

const { avatars, max = 4, size = 'md', label, moreLabel, moreHref, placement = 'bottom-start', open, onOpenChange, loadingLabel = wording('ui.avatarGroup.loading', 'Loading…'), retryLabel = wording('ui.avatarGroup.retry', 'Try again'), failureLabel = wording('ui.avatarGroup.failure', 'Could not load the people'), onLoad, onError, avatar, rest: drawRest, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'children' | 'role' | 'onLoad' | 'onError'> & {
  // A list, a promise of one, or a function answering it, such as an action: asked in the browser, the group busy under `loadingLabel` until the answer lands, or under `failureLabel` once it rejected.
  avatars: OptionsSource<GroupedAvatar>
  // How many avatars are drawn before the overflow chip takes the rest; the chip is left out when they all fit.
  max?: number | undefined
  // Every avatar's size, whatever the entries say, the chip's included.
  size?: Size | 'xl' | undefined
  // Names the group for screen readers: `Project members`.
  label?: string | undefined
  // Names the overflow chip: a string where `{count}` stands for the people it holds, or a function of that count; `{count} more` by default, from the `ui.avatarGroup.more` message.
  moreLabel?: string | ((count: number) => string) | undefined
  // Makes the chip a link to the page listing everyone, in place of the popover.
  moreHref?: string | undefined
  placement?: PopoverPlacement | undefined
  // Shows the popover when the page sets it; the chip, a click outside and Escape open and close it on their own, and `onOpenChange` reports each change so a page driving `open` can set it back.
  open?: boolean | undefined
  onOpenChange?: ((open: boolean) => unknown) | undefined
  loadingLabel?: string | undefined
  retryLabel?: string | undefined
  failureLabel?: string | undefined
  // Called with each answer of a function or promise `avatars`, and with what it rejected with.
  onLoad?: ((avatars: readonly GroupedAvatar[], query: string) => unknown) | undefined
  onError?: ((failure: { error: unknown, query: string }) => unknown) | undefined
  // Replaces the avatar drawn for a person, in the stack and in the list: `@avatar(person)`.
  avatar?: Snippet<[person: GroupedAvatar]> | undefined
  // Replaces the popover's list of the people past `max`: `@rest(people)`.
  rest?: Snippet<[people: readonly GroupedAvatar[]]> | undefined
}>()

const source = loadOptions<GroupedAvatar>(() => avatars, { onLoad, onError, label: 'AvatarGroup' })

// A max that is no whole number counts as none.
const limit = () => Math.max(0, Math.floor(max) || 0)
const shown = () => source.options().slice(0, limit())
const hidden = () => source.options().slice(limit())

const moreName = () => {
  const count = hidden().length

  return typeof moreLabel === 'function' ? moreLabel(count) : (moreLabel ?? wording('ui.avatarGroup.more', '{count} more', { count })).replace('{count}', String(count))
}
---
snippet person(entry: GroupedAvatar, named: boolean)
  if avatar
    | {avatar(entry)}
  else
    Avatar(src={entry.src} name={entry.name} size={size} label={named ? (entry.status ? entry.label : undefined) : (entry.label ?? entry.name)} href={named ? undefined : entry.href} status={entry.status} statusLabel={entry.statusLabel})

snippet chip()
  Avatar(name={`+${hidden().length}`} size={size})
    @fallback
      span(part="count" aria-hidden="true") +{hidden().length}

div(part="root" {...rest} role={label ? 'group' : undefined} aria-label={label} aria-busy={source.loading() ? 'true' : undefined})
  // Workaround for #3229: a `key` cannot read the loop's index, so it is the person's `key`, else the name.
  for entry of shown() key={entry.key ?? entry.name}
    {person(entry, false)}
  if source.loading()
    span(part="status" role="status") {loadingLabel}
  if source.failed()
    span(part="status" role="status") {failureLabel}
    if source.retryable()
      button(part="retry" type="button" onClick={() => source.retry()}) {retryLabel}
  if hidden().length > 0
    if moreHref !== undefined
      a(part="more" href={moreHref} aria-label={moreName()})
        {chip()}
    else
      Popover(placement={placement} open={open} part="panel" onOpenChange={onOpenChange})
        @trigger(attributes)
          button(part="more" type="button" {...attributes} aria-label={moreName()})
            {chip()}
        if drawRest
          | {drawRest(hidden())}
        else
          ul(part="list")
            // Workaround for #3229, as above.
            for entry of hidden() key={entry.key ?? entry.name}
              li(part="item")
                if entry.href !== undefined
                  a(part="row" href={entry.href})
                    {person(entry, true)}
                    span(part="name" aria-hidden={entry.status ? 'true' : undefined}) {entry.name}
                else
                  div(part="row")
                    {person(entry, true)}
                    span(part="name" aria-hidden={entry.status ? 'true' : undefined}) {entry.name}
