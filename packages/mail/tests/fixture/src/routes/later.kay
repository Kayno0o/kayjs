--- server
import { action, s } from 'kay'
import { mail } from '../mail'
import Welcome from '../mails/welcome.kay'

// Answers first and mails after, unawaited: the app declares nothing for a test to wait on.
export const signUpLater = action({ name: s.string({ min: 1, max: 100 }), email: s.string({ format: 'email', max: 254 }) }, ({ name, email }) => {
  void mail.enqueue({ to: email, subject: `Welcome, ${name}`, view: Welcome, props: { name, url: 'https://fixture.test/confirm?token=abc' } })
})
---
form(action={signUpLater})
  label
    | Name
    input(name="name")
  label
    | Email
    input(name="email" type="email" autocomplete="email")
  button Sign up
