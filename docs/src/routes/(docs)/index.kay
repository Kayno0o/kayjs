--- server
import { guides, reference } from '../../content.config'
import { FORGE } from '../../pages'

const overview = await reference.get('overview') ?? ctx.notFound()
const { Content } = overview
const sections = overview.headings.filter(heading => heading.depth === 2 || heading.depth === 3)
const first = (await guides.all())[0]
const topic = (await reference.all()).find(entry => entry.slug !== 'overview')
const next = first && { href: `/guides/${first.slug}`, title: first.data.title }
---
---
import Pager from '../../components/pager.kay'
import Toc from '../../components/toc.kay'
---
head
  title kay
.page
  header.page-head.hero
    h1 kay
    p.lede A Bun web framework: one #[code .kay] file per component, pages rendered to plain HTML on the server, islands hydrated by kay's own signals, everything typed down to the template line.
    .hero-actions
      a.button.primary(href={next?.href ?? "/"}) Start the tutorial
      a.button(href={topic ? `/reference/${topic.slug}` : "/"}) Browse the reference
  if sections.length > 0
    Toc(sections={sections})
  article.prose
    Content
  Pager(next={next} source={`${FORGE}/llms.txt`})
