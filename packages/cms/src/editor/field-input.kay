---
import type { Component } from 'kay'
import type { Drafts } from '../drafts'
import type { Field } from '../fields'
import type { CustomFieldProps, EntryRef } from '../kay/contract'
import Button from '@kaynooo/kayjs-ui/button.kay'
import FormField from '@kaynooo/kayjs-ui/form-field.kay'
import IconButton from '@kaynooo/kayjs-ui/icon-button.kay'
import MarkdownEditor from '@kaynooo/kayjs-ui/markdown-editor.kay'
import Select from '@kaynooo/kayjs-ui/select.kay'
import Textarea from '@kaynooo/kayjs-ui/textarea.kay'
import TextInput from '@kaynooo/kayjs-ui/text-input.kay'
import Toggle from '@kaynooo/kayjs-ui/toggle.kay'
import copy from '~icons/tabler/copy'
import { guardLeave, uid } from 'kay'
import { announce } from '@kaynooo/kayjs-ui/announce'
import { wording } from 'kay/words'
import { today } from '../datetime'
import { checkField, emptyBlock, emptyValue, htmlPattern, isCompact, itemAt, itemTitle } from '../fields'
import { fieldId, joinPath, siblingPath } from '../paths'
import { markdownOptions } from './markdown-options'
import { previewMarkdown } from './preview'
import { referenceChoices } from './references'
import { sizeOfPath } from '../upload-text'
import Adorned from './adorned.kay'
import ReadyInput from './ready-input.kay'
import DatetimeInput from './datetime-input.kay'
import FieldInput from './field-input.kay'
import FileInput from './file-input.kay'
import Reorder from './reorder.kay'
import { announceMove, focusItem, followFocus, reordered, reorderKey } from './reorder'
import { uploadFile, uploading, uploadRefusal } from './upload'
import './fields.css'

// `note` is said under a text field with its hint, such as that it still reads as its source.
const { drafts, entry, field, path, note } = props<{ drafts: Drafts, entry: EntryRef, field: Field, path: string, note?: string | undefined }>()

// The components the app gives its own field kinds, `src/cms/fields/<kind>.kay` each, bundled with the editor.
const kinds = import.meta.glob<Component<CustomFieldProps>>('/src/cms/fields/*.kay', { eager: true, import: 'default' })

// The hint to add a component is for the author running the site, not for an editor on a deployed one: only a development server, where the island's build defines the same `NODE_ENV`, shows it, so the server render and the island agree whatever `NODE_ENV` a server started without.
const development = process.env.NODE_ENV === 'development'

// What a box with limits has been left once: its limits are checked from then on, as it is typed, not while the editor is still on the first letters.
// An image dropped or pasted into a Markdown box is an upload the page must not be left over.
if (field.kind === 'markdown')
  guardLeave(uploading)

// Whether the role may upload an image dropped or pasted into a Markdown box.
const uploadRefused = field.kind === 'markdown' ? uploadRefusal() : () => undefined
const markdown = markdownOptions.use()

const touched = signal(false)
// The text of a JSON box while it is edited, which the draft's value is formatted from once the box is left.
const jsonText = signal<string>()
const jsonFocused = signal(false)
// The list's items folded away by place, and the last item removed, which Undo puts back.
const folded = signal<readonly boolean[]>([])
const removed = signal<{ at: number, title: string, value: unknown }>()
// The entries a reference field can pick, undefined while they load and null once they cannot be read, the field then taking the slug typed.
const choices = signal<{ value: string, label: string }[] | null>()
let rows: HTMLElement | undefined
let box: HTMLElement | undefined

const hinted = () => [field.hint, note].filter(Boolean).join(' ') || undefined
const value = () => drafts.value(entry, path)
const text = () => value() === undefined || value() === null ? '' : String(value())
const items = () => Array.isArray(value()) ? value() as unknown[] : []
const kindOf = (name: string) => Object.hasOwn(kinds, `/src/cms/fields/${name}.kay`) ? kinds[`/src/cms/fields/${name}.kay`] : undefined
// A pick among more options than this opens on a search box narrowing them, the option held always kept.
const SEARCH_FROM = 12
const search = signal('')
const matching = (options: { value: string, label: string }[]) => options.filter(option => option.value === text() || option.label.toLowerCase().includes(search().trim().toLowerCase()))

// A list item is never marked required: a list holds as many items as it has, none of them optional or mandatory on its own.
const starred = () => field.required && typeof field.key === 'string'
// The schema's refusal of the last save or render, else what the box holds that cannot be saved, else a limit it breaks, the last two once the editor has left the box.
const issue = () => drafts.issues(entry, path)[0]?.message ?? (touched() ? drafts.blocked(entry, path)[0]?.message ?? checkField(field, value()) : undefined)
const formatted = () => value() === undefined ? '' : JSON.stringify(value(), null, 2)
// A text with rows starts at them and grows from there. The minimum is set on the element, as a style attribute would be dropped by a strict content security policy; until the island hydrates, the `rows` attribute sizes it.
function grow(element: HTMLTextAreaElement, rows: number | undefined): void {
  if (rows === undefined)
    return

  element.style.setProperty('--kcms-rows', String(rows))
  element.setAttribute('data-kcms-grow', '')
}

// The text typed stands while it is being edited or does not parse; once the draft is dropped or the box is left, the box shows the draft.
const jsonShown = () => jsonFocused() || drafts.blocked(entry, path).length > 0 ? jsonText() ?? formatted() : formatted()

// A reference picks among the target collection's entries.
effect(() => {
  const target = field.kind === 'reference' ? field.collection : ''

  if (target === '')
    return

  void (async () => {
    try {
      choices.set(await referenceChoices(target))
    }
    catch {
      choices.set(null)
    }
  })()
})

// The entries to pick, the one the field holds now among them even when the collection lacks it, so a reference left dangling shows rather than vanishes.
const picks = () => {
  const held = text()
  const list = choices() ?? []

  return held === '' || list.some(choice => choice.value === held) ? list : [{ value: held, label: held }, ...list]
}

// A box that goes (a list item removed) no longer blocks the save.
effect(() => {
  onCleanup(() => drafts.block(entry, path, undefined))
})

// A box typed in is checked once left; any other control, a pick or a choice, at its first change.
function set(next: unknown, typing = false): void {
  drafts.set(entry, path, next)

  if (!typing)
    touched = true
}

// What an emptied control stores: nothing, or `null` for a field the schema lists as required but allows to be null, which a missing key would break.
const cleared = field.nullable === true ? null : undefined

// Emptying an optional text unsets it, as emptying a number does, instead of storing an empty string.
function typed(next: string): void {
  set(next === '' && !field.required ? cleared : next, true)
}

// A list of lines emptied on an optional field is unset, as emptying a text is.
function typedLines(next: string): void {
  const lines = next.split('\n').map(line => line.trim()).filter(line => line !== '')

  set(lines.length === 0 && !field.required ? cleared : lines, true)
}

// A field waiting for a sibling shows once that holds a value.
const parent = path.includes('.') ? path.slice(0, path.lastIndexOf('.')) : ''
const filled = (found: unknown) => found !== undefined && found !== null && found !== '' && found !== false && !(Array.isArray(found) && found.length === 0)
// A field the schema refused, or one of its children, is shown whatever its sibling holds, and stays so while it is edited: a save cannot be fixed through a field that stays hidden, and an edit drops the issue that surfaced it.
// Once the refusal is gone and the focus has left it, the field waits for its sibling again. A refusal of the body or of the slug names no field.
const surfaced = signal(false)
const inside = signal(false)
// Whether an issue is on `at` or one of its children.
const within = (at: string, found: { path: string }) => found.path === at || found.path.startsWith(`${at}.`)
const refused = () => drafts.issues(entry).some(found => found.body !== true && found.key === undefined && within(path, found))
const shown = () => field.when === undefined || surfaced() || filled(drafts.value(entry, joinPath(parent, field.when)))

effect(() => {
  if (refused())
    surfaced = true
  else if (!inside())
    surfaced = false
})

// What a limited text says of its length.
const counter = () => field.limits?.maxLength === undefined ? undefined : wording('cms.field.counter', '{count} / {max}', { count: text().length, max: field.limits.maxLength })

// Ties a toggle to its hint and issue.
const noteId = `kcms-note-${uid()}`

// An integer takes digits and a minus: the keys that would write a decimal or an exponent are refused, and a pasted decimal is cut to its whole part.
const NOT_INTEGER = new Set(['.', ',', 'e', 'E', '+'])

let numberBox: HTMLInputElement | undefined

function entered(next: number | null): void {
  const whole = next !== null && field.kind === 'integer' ? Math.trunc(next) : next

  set(whole === null ? cleared : whole, true)

  // A pasted decimal cut to the figure the draft already holds changes no signal, so the box is written to.
  if (numberBox && whole !== next && whole !== null)
    numberBox.value = String(whole)
}

// The wheel over a focused number box changes its figure unasked: it leaves the box instead.
function wheel(event: WheelEvent): void {
  (event.currentTarget as HTMLInputElement).blur()
}

function digits(event: KeyboardEvent): void {
  if (field.kind === 'integer' && NOT_INTEGER.has(event.key))
    event.preventDefault()
}

const list = field.kind === 'list' ? field : undefined
const count = () => items().length
const atMax = () => list?.maxItems !== undefined && count() >= list.maxItems
const atMin = () => list?.minItems !== undefined && count() <= list.minItems
const foldedAt = (at: number) => folded()[at] === true
const addButton = () => box?.querySelector('[data-kcms-add]')
// A list this long gets a menu to jump to an item.
const JUMP_FROM = 8
const blockOptions = () => list?.blocks?.map(block => ({ value: block.type, label: block.label })) ?? []
const titles = () => list ? items().map((item, at) => ({ value: at, label: `${at + 1}. ${itemTitle(list, item, at)}` })) : []

// The refusals inside an item, its own and its fields', and the texts in it that do not parse, which a folded item has no field showing.
const itemIssues = (at: number) => [...drafts.issues(entry).filter(found => found.body !== true && found.key === undefined), ...drafts.blocked(entry)].filter(found => within(joinPath(path, at), found))

// What a list says of its size: how many items it holds, and the bounds its schema sets.
function countText(): string {
  return wording('cms.list.count', count() === 1 ? '1 item' : '{count} items', { count: count() })
}

function boundsText(): string | undefined {
  const min = list?.minItems
  const max = list?.maxItems

  if (min !== undefined && max !== undefined)
    return wording('cms.list.between', 'Between {min} and {max} items', { min, max })

  if (min !== undefined)
    return wording('cms.list.atLeast', min === 1 ? 'At least 1 item' : 'At least {min} items', { min, count: min })

  return max === undefined ? undefined : wording('cms.list.atMost', max === 1 ? 'At most 1 item' : 'At most {max} items', { max, count: max })
}

// The folds follow the items they were made on: every change of the list says how it moved them.
function mirror(change: (list: boolean[]) => boolean[]): void {
  folded.set(change(items().map((_, at) => foldedAt(at))))
}

function fold(at: number): void {
  mirror(states => states.map((state, place) => place === at ? !state : state))
}

function append(value: unknown): void {
  if (atMax())
    return

  removed.set(undefined)
  set([...items(), value])
  focusItem(rows, count() - 1)
}

function prepend(type?: string): void {
  if (atMax() || !list)
    return

  const block = list.blocks?.find(found => found.type === type)

  removed.set(undefined)
  mirror(states => [false, ...states])
  set([block ? emptyBlock(block) : emptyValue(list.item), ...items()])
  focusItem(rows, 0)
}

// The item picked in the menu takes the focus, which unfolds nothing but reaches the fold button of a folded one.
function jump(at: number): void {
  focusItem(rows, at)
  rows?.querySelectorAll(':scope > [data-kcms-row]')[at]?.scrollIntoView({ block: 'nearest' })

  // The menu goes back to its prompt, so picking the same item again changes it.
  const menu = box?.querySelector<HTMLSelectElement>('.kcms-list-tools select')

  if (menu)
    menu.value = ''
}

function duplicate(at: number): void {
  if (atMax())
    return

  removed.set(undefined)
  mirror(states => states.toSpliced(at + 1, 0, false))
  set(items().toSpliced(at + 1, 0, structuredClone(items()[at])))
  focusItem(rows, at + 1)
}

function remove(at: number): void {
  if (!list || atMin())
    return

  const title = itemTitle(list, items()[at], at)

  removed.set({ at, title, value: items()[at] })
  announce(wording('cms.list.removed', '{item} removed', { item: title }))
  mirror(states => states.filter((_, place) => place !== at))
  set(items().filter((_, place) => place !== at))
  focusItem(rows, at, addButton())
}

function undo(): void {
  const gone = removed()

  if (!gone || atMax())
    return

  const at = Math.min(gone.at, count())

  removed.set(undefined)
  mirror(states => states.toSpliced(at, 0, false))
  set(items().toSpliced(at, 0, gone.value))
  focusItem(rows, at)
}

// A move is said to a screen reader, whose focus follows the item but does not read where it landed. A numbered item is named by the place it left, as its number at the new place would read as the one it now holds.
function moveItem(from: number, to: number): void {
  const title = list ? itemTitle(list, items()[from], from) : ''

  removed.set(undefined)
  mirror(states => reordered(states, from, to))
  set(reordered(items(), from, to))

  if (list)
    announceMove(title, to, count())
}

// Alt and Shift with an arrow in any control of an item moves it, as the buttons beside it do.
function itemKey(event: KeyboardEvent, from: number): void {
  // A list inside an item sees the key first: the item holding that list is not moved too.
  const move = reorderKey(event, from, items().length)

  if (move?.to === undefined)
    return

  moveItem(from, move.to)
  followFocus((event.currentTarget as HTMLElement).closest('[data-kcms-row]'), move.to, move.direction)
}

// The alt text paired with an image field, read from the field beside it.
function altOf(): { id: string, value: string, issue?: string | undefined, required: boolean } | undefined {
  const alt = field.kind === 'image' ? field.upload?.alt : undefined

  if (alt === undefined)
    return undefined

  const at = siblingPath(path, alt.key)

  return { id: fieldId(entry, `f:${at}`), value: String(drafts.value(entry, at) ?? ''), issue: drafts.issues(entry, at)[0]?.message, required: alt.required }
}

// The refusals of the image's width and height, which the form draws no field for.
function sizeIssues(): { id: string, message: string }[] {
  if (field.kind !== 'image')
    return []

  return [field.upload?.width, field.upload?.height].flatMap((part) => {
    const at = part === undefined ? undefined : siblingPath(path, part.key)
    const issue = at === undefined ? undefined : drafts.issues(entry, at)[0]

    return at === undefined || issue === undefined ? [] : [{ id: fieldId(entry, `f:${at}`), message: issue.message }]
  })
}

function setAlt(text: string): void {
  const alt = field.kind === 'image' ? field.upload?.alt : undefined

  if (alt !== undefined)
    drafts.set(entry, siblingPath(path, alt.key), text === '' ? undefined : text)
}

// The file set, and the size of an image beside it when the schema keeps one: the upload's answer, else the size kay's storage put in the name of a file picked or typed; a path with none leaves no size behind that would describe the old image.
function setFile(next: string, uploaded?: { width: number, height: number }): void {
  const size = uploaded ?? sizeOfPath(next)

  set(next)

  if (field.kind !== 'image')
    return

  // The alt text described the image that went.
  if (next === '' && field.upload?.alt !== undefined)
    drafts.set(entry, siblingPath(path, field.upload.alt.key), undefined)

  if (field.upload?.width !== undefined)
    drafts.set(entry, siblingPath(path, field.upload.width.key), size?.width)

  if (field.upload?.height !== undefined)
    drafts.set(entry, siblingPath(path, field.upload.height.key), size?.height)
}

// The draft takes each text that parses as it is typed; one that does not keeps the last value and stops the save until it is fixed.
function setJson(next: string): void {
  jsonText = next

  try {
    drafts.block(entry, path, undefined)
    set(next.trim() === '' ? cleared : JSON.parse(next), true)
  }
  catch {
    drafts.block(entry, path, wording('cms.field.invalidJson', '{field} is not valid JSON', { field: field.label }))
  }
}

function leaveJson(): void {
  touched = true
  jsonFocused = false

  if (drafts.blocked(entry, path).length === 0)
    jsonText = undefined
}

---
.kcms-field(data-kcms-path={path} id={fieldId(entry, `f:${path}`)} hidden={!shown()} onFocusIn={() => { inside = true }} onFocusOut={(event) => { if (!(event.currentTarget as Element).contains(event.relatedTarget as Node | null)) inside = false }})
  const current = field
  match current.kind
    when 'boolean'
      Toggle(label={current.label} checked={value() === true} aria-describedby={noteId} aria-invalid={issue() === undefined ? undefined : 'true'} onChange={set})
      .kui-form-field-issues(id={noteId} aria-live="polite")
        if current.hint
          span.kui-form-field-hint {current.hint}
        if issue()
          span.kui-form-field-issue {issue()}
    when 'list'
      FormField(label={current.label} hint={[current.hint, boundsText()].filter(Boolean).join(' ') || undefined} issue={issue()} required={starred()} group action={countText()})
        .kcms-list(ref={element => box = element})
          if count() > 0
            .kcms-list-tools
              if !atMax()
                if current.blocks
                  Select(value="" options={blockOptions()} emptyOption={wording('cms.blocks.addFirst', 'Add at the top…')} aria-label={wording('cms.blocks.addFirstLabel', 'Add a block at the top of {list}', { list: current.label })} onChange={(type) => { if (type !== '') prepend(type) }})
                else
                  Button(label={wording('cms.list.addFirst', 'Add at the top')} icon="plus" variant="ghost" size="sm" onClick={() => prepend()})
              if count() >= JUMP_FROM
                Select(value="" options={titles()} emptyOption={wording('cms.list.jump', 'Go to item…')} aria-label={wording('cms.list.jumpLabel', 'Go to an item of {list}', { list: current.label })} onChange={(at) => { if (at !== '') jump(at) }})
          .kcms-list-items(ref={element => rows = element})
            for item, i of items() key={i}
              .kcms-list-item(data-kcms-row data-compact={isCompact(current) ? '' : undefined} onKeyDown={event => itemKey(event, i)})
                const title = itemTitle(current, item, i)
                const itemField = itemAt(current, i, item)
                if isCompact(current)
                  FieldInput(drafts={drafts} entry={entry} field={itemAt(current, i)} path={joinPath(path, i)})
                  .kcms-item-controls
                    Reorder(item={title} index={i} count={count()} onMove={to => moveItem(i, to)})
                    IconButton(icon={copy} label={wording('cms.list.duplicate', 'Duplicate {item}', { item: title })} variant="ghost" size="sm" disabled={atMax()} data-kcms-item-control onClick={() => duplicate(i)})
                    IconButton(icon="delete" label={wording('cms.field.removeItem', 'Remove {item}', { item: title, n: i + 1 })} variant="ghost" size="sm" disabled={atMin()} data-kcms-item-control onClick={() => remove(i)})
                else
                  .kcms-item-head
                    IconButton.kcms-fold(icon="chevron" data-kcms-fold label={foldedAt(i) ? wording('cms.list.expand', 'Expand {item}', { item: title }) : wording('cms.list.collapse', 'Collapse {item}', { item: title })} variant="ghost" size="sm" aria-expanded={foldedAt(i) ? 'false' : 'true'} data-kcms-item-control onClick={() => fold(i)})
                    span.kcms-item-title {title}
                    if foldedAt(i) && itemIssues(i).length > 0
                      span.kcms-item-issues {wording('cms.list.itemIssues', itemIssues(i).length === 1 ? '1 issue' : '{count} issues', { count: itemIssues(i).length })}
                    .kcms-item-controls
                      Reorder(item={title} index={i} count={count()} onMove={to => moveItem(i, to)})
                      IconButton(icon={copy} label={wording('cms.list.duplicate', 'Duplicate {item}', { item: title })} variant="ghost" size="sm" disabled={atMax()} data-kcms-item-control onClick={() => duplicate(i)})
                      IconButton(icon="delete" label={wording('cms.field.removeItem', 'Remove {item}', { item: title, n: i + 1 })} variant="ghost" size="sm" disabled={atMin()} data-kcms-item-control onClick={() => remove(i)})
                  .kcms-item-body(role="group" aria-label={title} hidden={foldedAt(i)})
                    if itemField.kind === 'group'
                      if drafts.issues(entry, joinPath(path, i))[0] as own
                        p.kcms-item-error(role="alert") {own.message}
                      for child of itemField.fields key={child.key}
                        FieldInput(drafts={drafts} entry={entry} field={child} path={joinPath(joinPath(path, i), child.key)})
                    else
                      FieldInput(drafts={drafts} entry={entry} field={itemField} path={joinPath(path, i)})
          if removed() as gone
            p.kcms-item-removed
              span {wording('cms.list.removed', '{item} removed', { item: gone.title })}
              Button(label={wording('cms.list.undo', 'Undo')} variant="inline" disabled={atMax()} onClick={undo})
          if !atMax() && current.blocks
            .kcms-block-add(role="group" aria-label={wording('cms.blocks.add', 'Add a block')})
              for block of current.blocks key={block.type}
                Button(label={wording('cms.blocks.addType', 'Add {block}', { block: block.label })} icon="plus" variant="ghost" data-kcms-add onClick={() => append(emptyBlock(block))})
          else if !atMax()
            if current.item.kind === 'image' || current.item.kind === 'file'
              FileInput(value="" image={current.item.kind === 'image'} collection={entry.collection} upload={current.item.kind === 'image' || current.item.kind === 'file' ? current.item.upload : undefined} many onChange={path => append(path)})
            Button(label={wording('cms.field.add', 'Add')} icon="plus" data-kcms-add onClick={() => append(emptyValue(current.item))})
    when 'group'
      FormField.kcms-group(label={current.label} hint={current.hint} issue={issue()} required={starred()} group)
        for child of current.fields key={child.key}
          FieldInput(drafts={drafts} entry={entry} field={child} path={joinPath(path, child.key)})
    when 'lines'
      FormField(label={current.label} hint={current.hint} issue={issue()} required={starred()})
        Textarea(rows="4" placeholder={current.placeholder} value={items().join('\n')} onInput={typedLines} onBlur={() => touched = true})
    when 'textarea'
      FormField(label={current.label} hint={hinted()} issue={issue()} required={starred()} action={counter()})
        Textarea(rows={current.rows ?? 4} placeholder={current.placeholder} ref={element => grow(element, current.rows)} value={text()} onInput={typed} onBlur={() => touched = true} required={starred()} minlength={current.limits?.minLength} maxlength={current.limits?.maxLength})
    when 'markdown'
      FormField(label={current.label} hint={hinted()} issue={issue()} required={starred()} action={counter()})
        MarkdownEditor(toolbar={markdown.toolbar} previewClass={markdown.previewClass} preview={source => previewMarkdown(source, entry)} value={text()} onInput={typed} onBlur={() => touched = true} required={starred()} minlength={current.limits?.minLength} maxlength={current.limits?.maxLength} onImage={uploadRefused() === undefined ? async file => (await uploadFile(entry.collection, file)).path : undefined})
    when 'number', 'integer'
      FormField(label={current.label} hint={current.hint} issue={issue()} required={starred()})
        Adorned(prefix={current.prefix} suffix={current.suffix})
          TextInput(ref={element => numberBox = element} type="number" step={current.kind === 'integer' ? '1' : 'any'} inputmode={current.kind === 'integer' ? 'numeric' : 'decimal'} required={starred()} min={current.limits?.minimum} max={current.limits?.maximum} placeholder={current.placeholder} value={text()} onInput={entered} onKeyDown={digits} onWheel={wheel} onBlur={() => touched = true})
    when 'date'
      FormField(label={current.label} hint={current.hint} issue={issue()} required={starred()} group)
        .kcms-adorned
          TextInput(type="date" aria-label={current.label} required={starred()} value={text().slice(0, 10)} onInput={next => set(next === '' ? cleared : next)})
          Button(label={wording('cms.field.today', 'Today')} variant="inline" onClick={() => set(today())})
          if text() !== '' && !starred()
            Button(label={wording('cms.field.clear', 'Clear')} variant="inline" onClick={() => set(cleared)})
    when 'datetime'
      DatetimeInput(label={current.label} hint={current.hint} issue={issue()} required={starred()} value={text()} onChange={next => set(next ?? cleared)})
    when 'color', 'tags', 'icon'
      ReadyInput(field={current} value={value()} onChange={set} cleared={cleared} label={current.label} hint={current.hint} issue={issue()} required={starred()} touch={() => touched = true})
    when 'select'
      if current.options.length > SEARCH_FROM
        FormField(label={current.label} hint={current.hint} issue={issue()} required={starred()} group)
          TextInput(type="search" aria-label={wording('cms.field.search', 'Search {field}', { field: current.label })} placeholder={wording('cms.field.search', 'Search {field}', { field: current.label })} value={search()} onInput={next => search.set(next)})
          Select(aria-label={current.label} required={starred()} value={text()} options={matching(current.options)} emptyOption={!current.required || value() === undefined} onChange={next => set(current.options.find(option => option.value === next)?.raw ?? cleared)})
      else
        FormField(label={current.label} hint={current.hint} issue={issue()} required={starred()})
          Select(required={starred()} value={text()} options={current.options} emptyOption={!current.required || value() === undefined} onChange={next => set(current.options.find(option => option.value === next)?.raw ?? cleared)})
    when 'image', 'file'
      FormField(label={current.label} hint={current.hint} issue={issue()} required={starred()} group)
        FileInput(value={text()} image={current.kind === 'image'} collection={entry.collection} upload={current.upload} alt={altOf()} sizeIssues={sizeIssues()} onAlt={setAlt} onChange={setFile})
    when 'reference'
      FormField(label={current.label} hint={current.hint} issue={issue()} required={starred()})
        if choices() === null || current.collection === ''
          TextInput(placeholder={current.placeholder} value={text()} onInput={typed} onBlur={() => touched = true} required={starred()})
        else
          Select(required={starred()} value={text()} options={picks()} loading={choices() === undefined} emptyOption={!current.required || value() === undefined} onChange={next => set(next === '' ? cleared : next)})
    when 'custom'
      const Kind = kindOf(current.name)
      if Kind
        Kind(value={value()} onChange={set} label={current.label} hint={current.hint} issue={issue()} required={starred()})
      else
        FormField(label={current.label} hint={[current.hint, development ? wording('cms.field.noKind', 'No editor for the {kind} kind: add src/cms/fields/{kind}.kay. Edited as JSON until then.', { kind: current.name }) : undefined].filter(Boolean).join(' ')} issue={issue()} required={starred()})
          Textarea.kcms-json(rows="4" value={jsonShown()} onInput={setJson} onFocus={() => jsonFocused = true} onBlur={leaveJson})
    when 'json'
      FormField(label={current.label} hint={current.hint ?? 'JSON'} issue={issue()} required={starred()})
        Textarea.kcms-json(rows="4" value={jsonShown()} onInput={setJson} onFocus={() => jsonFocused = true} onBlur={leaveJson})
    else
      FormField(label={current.label} hint={hinted()} issue={issue()} required={starred()} action={counter()})
        Adorned(prefix={current.prefix} suffix={current.suffix})
          TextInput(type={current.inputType ?? 'text'} placeholder={current.placeholder} value={text()} onInput={typed} onBlur={() => touched = true} required={starred()} minlength={current.limits?.minLength} maxlength={current.limits?.maxLength} pattern={htmlPattern(current.limits?.pattern)})
