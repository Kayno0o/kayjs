---
import AlertTriangle from '~icons/tabler/alert-triangle'
import Bulb from '~icons/tabler/bulb'
import InfoCircle from '~icons/tabler/info-circle'

const TONES = { note: 'info', tip: 'success', warning: 'warning' } as const

const { type = 'note' } = props<{ type?: 'note' | 'tip' | 'warning' }>()
---
// Notice's look without its status role, as a callout is prose the page holds rather than an outcome to read out; the tone marks the border and the icon, the prose keeps the text colour.
aside.kui-notice.callout(class="text-kui-text text-[length:inherit] leading-[inherit]" data-tone={TONES[type]})
  if type === 'tip'
    Bulb
  else if type === 'warning'
    AlertTriangle
  else
    InfoCircle
  .callout-body
    slot
