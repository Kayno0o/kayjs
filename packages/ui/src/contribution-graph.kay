---
import { recipe, signal } from 'kay'
import type { JSX } from 'kay'
import type { ContributionDay } from './contribution'
import { tabOf } from './outside'
import type { NewTab } from './outside'
import { activeMarks, markKind } from './chart-marks'
import { monthStarts, steppedCell } from './contribution'
import { shade } from './shade'
import { wording } from 'kay/words'

const look = recipe({
  parts: {
    // With month labels the cells are placed by hand under a row of them, and fixed-width columns let a label run past its own week.
    root: 'kui-contribution-graph grid w-fit grid-flow-col grid-rows-7 gap-[3px] data-months:auto-cols-[0.75rem] data-months:grid-flow-row data-months:grid-rows-[auto_repeat(7,0.75rem)]',
    month: 'row-start-1 w-0 text-2xs leading-none whitespace-nowrap text-muted',
    cell: 'size-3 rounded-[3px] bg-surface transition-transform hover:scale-125 data-lit:scale-125 data-[kind=link]:cursor-pointer data-[kind=button]:cursor-pointer data-[kind=button]:border-0 data-[kind=button]:p-0 data-today:ring-1 data-today:ring-accent data-today:ring-offset-1 data-today:ring-offset-surface',
  },
})

const { days, color, today, label = wording('ui.contributionGraph.label', 'Contributions'), months = false, onSelect, href, newTab, onActive, active, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'children' | 'onSelect'> & {
  // Ascending days starting on a Monday, as `gridDays` from `@kaynooo/utils` lists them, each with how full its cell is.
  days: readonly ContributionDay[]
  // The CSS colour the filled cells shade towards.
  color: string
  // The ISO date of today, whose cell is marked.
  today: string
  // Names the grid for screen readers.
  label?: string | undefined
  // Names each month above the week it starts in, placing every cell by hand.
  months?: boolean | undefined
  // Makes every cell a button handing back its day; with `href` too, a cell that has an address stays a link and a plain click goes to this.
  onSelect?: ((day: ContributionDay) => unknown) | undefined
  // The address a cell links to, or `undefined` for none.
  href?: ((day: ContributionDay) => string | undefined) | undefined
  // Opens the links of `href` in a new tab (`true`), the same one (`false`), or a new one when the address leaves the site (`'auto'`, the default).
  newTab?: NewTab | undefined
  // Hears the index of the cell the pointer or the focus is on, `null` when it leaves.
  onActive?: ((index: number | null) => unknown) | undefined
  // The cell to draw as active, `null` for none; the app controls it when it gives it.
  active?: number | null | undefined
}>()

const marks = activeMarks({ active: () => active, onActive: () => onActive })

function link(day: ContributionDay) {
  const to = href?.(day)

  return to === undefined || to === '' ? undefined : { href: to, ...tabOf(to, newTab) }
}

// A plain click on a link goes to `onSelect` when the app gave one; a modified or middle click is left to the browser.
function pressed(event: MouseEvent, day: ContributionDay) {
  if (!onSelect || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
    return

  event.preventDefault()
  void onSelect(day)
}

function focused(event: FocusEvent, index: number) {
  stop = index
  marks.enter(index, event.currentTarget as Element)
}

// A day without a description is read as how full it is, which its colour alone shows.
const describe = (day: ContributionDay) => `${day.description ?? `${Math.round(day.intensity * 100)}%`} · ${day.day}`

// The cell the keyboard stands at, one tab stop in all: today's until it moves.
const stop = signal<number | null>(null)
const current = () => Math.min(stop() ?? Math.max(0, days.findIndex(day => day.day === today)), Math.max(0, days.length - 1))

// The arrows walk the cells, a day up and down and a week across, and Home and End reach either end, so each cell's details show on focus as they do under the pointer.
function keyDown(event: KeyboardEvent) {
  if (event.altKey || event.ctrlKey || event.metaKey)
    return

  const next = steppedCell(event.key, current(), days.length)

  if (next === undefined || days.length === 0)
    return

  event.preventDefault()
  stop = next

  const target = (event.currentTarget as HTMLElement).querySelectorAll<HTMLElement>('[data-part="cell"]')[next]

  target?.focus()
}

const style = (day: ContributionDay, index: number) => {
  const fill = shade(color, day.intensity)
  const parts = [fill && `background-color: ${fill}`, months && `grid-row: ${index % 7 + 2}; grid-column: ${Math.floor(index / 7) + 1}`].filter(Boolean)

  return parts.length > 0 ? parts.join('; ') : undefined
}
---
// A year of days as a grid of weeks, each cell shaded by how full its day was.
div(part="root" {...rest} role="group" aria-label={label} onKeyDown={keyDown} data-months={months ? '' : undefined})
  if months
    for start of monthStarts(days.map(day => day.day)) key={start.column}
      span(part="month" aria-hidden="true" style={`grid-column: ${start.column + 1}`}) {start.label}
  for day, index of days key={day.day}
    if markKind(link(day)?.href, onSelect !== undefined) === 'link'
      a(part="cell" {...link(day)} data-kind="link" tabindex={index === current() ? '0' : '-1'} aria-label={describe(day)} data-tooltip={describe(day)} data-lit={marks.current() === index ? '' : undefined} data-today={day.day === today || undefined} style={style(day, index)} onClick={event => pressed(event, day)} onFocus={event => focused(event, index)} onBlur={() => marks.leave(index)} onPointerEnter={event => marks.enter(index, event.currentTarget)} onPointerLeave={() => marks.leave(index)})
    else if onSelect
      button(part="cell" type="button" data-kind="button" tabindex={index === current() ? '0' : '-1'} aria-label={describe(day)} data-tooltip={describe(day)} data-lit={marks.current() === index ? '' : undefined} data-today={day.day === today || undefined} style={style(day, index)} onClick={() => void onSelect?.(day)} onFocus={event => focused(event, index)} onBlur={() => marks.leave(index)} onPointerEnter={event => marks.enter(index, event.currentTarget)} onPointerLeave={() => marks.leave(index)})
    else
      span(part="cell" role="img" tabindex={index === current() ? '0' : '-1'} aria-label={describe(day)} data-tooltip={describe(day)} data-lit={marks.current() === index ? '' : undefined} data-today={day.day === today || undefined} style={style(day, index)} onFocus={event => focused(event, index)} onBlur={() => marks.leave(index)} onPointerEnter={event => marks.enter(index, event.currentTarget)} onPointerLeave={() => marks.leave(index)})
