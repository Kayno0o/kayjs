--- island
import { toast } from '@kaynooo/kayjs-ui'
import Button from '@kaynooo/kayjs-ui/button.kay'
import FormField from '@kaynooo/kayjs-ui/form-field.kay'
import Select from '@kaynooo/kayjs-ui/select.kay'
import TextInput from '@kaynooo/kayjs-ui/text-input.kay'
---
form.flex.flex-col.gap-4
  FormField(label="Site name" name="site")
    TextInput(name="site" value="Items")
  FormField(label="Interval" name="interval")
    Select(name="interval" options={['1m', '5m', '1h']} value="5m")
  Button(label="Save" tone="accent" onClick={() => toast('Saved')})
