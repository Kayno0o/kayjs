---
import ChipGroup from '@kayjs/ui/chip-group.kay'
import MultiSelect from '@kayjs/ui/multi-select.kay'
import Segmented from '@kayjs/ui/segmented.kay'
import Select from '@kayjs/ui/select.kay'
import Tabs from '@kayjs/ui/tabs.kay'

// One option shape across the groups: `{ value, label, icon?, disabled? }`, a Select taking no icon.
const { onTab } = props<{ onTab: (value: string) => void }>()

const options = [{ value: 'a', label: 'Alpha', icon: 'plus' as const }, { value: 'b', label: 'Beta', disabled: true }, { value: 'c', label: 'Gamma' }]
---
ChipGroup#chips(options={options} value={['a']} label="Chips")
Segmented#segmented(options={options} value="a" label="Segmented")
MultiSelect#multi(options={options} value={['b']} label="Multi")
Select#select(options={options.map(({ value, label, disabled }) => ({ value, label, disabled }))} value="a" aria-label="Select")
Tabs#tabs(tabs={options} value="a" label="Tabs" onChange={onTab})
  @panel(value)
    p {value}
