--- island
import SaveForm from '@kaynooo/kayjs-ui/save-form.kay'
import Toaster from '@kaynooo/kayjs-ui/toaster.kay'

// SaveForm under the names it had before 1.92: the spread keeps `kay check` from reporting them, as a test of what still works.
const { old } = props<{ old: { onSave?: () => Promise<unknown>, onSaved?: () => void } }>()
---
Toaster
SaveForm(dirty={true} {...old})
  input#name(name="name" value="Ada")
