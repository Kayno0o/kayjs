--- server
import Button from '@kaynooo/kayjs-ui/button.kay'
import PageSection from '@kaynooo/kayjs-ui/page-section.kay'
import Pagination from '@kaynooo/kayjs-ui/pagination.kay'
import { s } from 'kay'
import { wording } from 'kay/words'
import ActivityLog from '../components/activity-log.kay'
import { forbidden, may } from '../access'
import { adminTitle } from '../listing'
import { screenPath } from '../paths'
import { activityScreen } from '../screens'

export const page = { query: s.Object({ page: s.Optional(s.Integer()) }) }

// The log names every editor and what each did, the people the `delete` role may erase from the history.
if (!await may(ctx, 'delete'))
  forbidden(ctx, 'delete')

const { prefix, rows, page: current, pages } = await activityScreen(ctx.query.page) ?? ctx.notFound()
const url = ctx.url
---
head
  title {adminTitle(wording('cms.activity.title', 'Activity'))}
PageSection(title={wording('cms.activity.title', 'Activity')} level={1})
  @actions
    Button(href={screenPath(prefix, '')} label={wording('cms.activity.back', 'Back to the content')})
  ActivityLog(rows={rows})
  Pagination(page={current} pages={pages} url={url})
