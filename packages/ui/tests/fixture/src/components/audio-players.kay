---
import { signal } from 'kay'
import AudioPlayer from '@kaynooo/kayjs-ui/audio-player.kay'

// The test reads back each position and chapter the player reports; `#jump` passes it another position, as a parent would, and `#late` passes back one it reported a while ago.
const { onPosition, onChapter, events } = props<{ onPosition: (seconds: number) => void, onChapter: (index: number) => void, events?: string[] }>()

const seconds = signal(0)
const chapters = [
  { title: 'Intro', start: 0 },
  { title: 'News', start: 30, url: 'https://example.com/news' },
  { title: 'Outro', start: 90 },
]
const cues = [
  { start: 0, end: 10, text: 'Hello.' },
  { start: 10, end: 30, text: 'Welcome.' },
  { start: 30, end: 60, text: 'The news.' },
  { start: 95, end: 100, text: 'Bye.' },
]
---
AudioPlayer#player(src="/episode.mp3" title="Episode" artist="Show" chapters={chapters} cues={cues} position={seconds()} onPositionChange={(value) => { seconds = value; onPosition(value) }} onChapterChange={onChapter} onPlay={() => events?.push('play')} onPause={() => events?.push('pause')} onEnd={() => events?.push('ended')} onError={({ error, event }) => events?.push(`error ${error instanceof DOMException ? error.name : 'media'} ${event?.type}`)})
  @actions(chapter, index)
    button.act(type="button") {`Like ${chapter.title} ${index}`}
AudioPlayer#plain(src="/plain.mp3")
AudioPlayer#legacy(src="/legacy.mp3" onEnd={() => { events?.push('ended'); if (events?.includes('boom')) throw new Error('first') }} {...{ onEnded: () => events?.push('legacy ended') }})
button#jump(type="button" onClick={() => seconds = 45}) Jump
button#late(type="button" onClick={() => seconds = 90}) Late
