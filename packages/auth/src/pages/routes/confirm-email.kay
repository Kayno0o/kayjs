--- server
import { localize, t } from 'kay/i18n'
import Message from '../components/message.kay'
import Panel from '../components/panel.kay'
import { failure, schemas } from '../forms'
import Button from '@kaynooo/kayjs-ui/button.kay'

// Visitors reach this page before signing in, so none of the app's guards run here, whatever they check: one asking for a session would keep everyone out.
// The link's token sits in the address, which no Referer header may carry to another site; `same-origin` still lets a form post carry its Origin.
export const page = { guards: false, security: { headers: { 'referrer-policy': 'same-origin' } } }

// The link only shows this button, so a mail scanner opening it spends nothing.
export const confirm = action(schemas.token, async ({ token }, ctx) => {
  const result = await ctx.locals.auth.confirmEmailChange(token)

  if (!result.ok)
    return ctx.fail(400, { error: result.error === 'invalid' ? 'link' : result.error })

  return ctx.redirect(localize(result.redirect))
})

const token = ctx.url.searchParams.get('token') ?? confirm.failed()?.values.token
const error = confirm.failed()?.data?.error
---
head
  title {t('auth.confirmEmail.title')}
Panel(title={t('auth.confirmEmail.title')})
  if token
    form.flex.flex-col.gap-3(action={confirm})
      input(type="hidden" name="token" value={token})
      p {t('auth.confirmEmail.intro')}
      if error
        Message(text={failure(error)})
      Button(type="submit" tone="accent" label={t('auth.confirmEmail.submit')})
  else
    Message(text={failure('link')})
