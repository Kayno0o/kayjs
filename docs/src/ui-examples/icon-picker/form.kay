---
import IconPicker from '@kaynooo/kayjs-ui/icon-picker.kay'
import type { IconChoice } from '@kaynooo/kayjs-ui'
import Bell from '~icons/tabler/bell'
import Home from '~icons/tabler/home'
import Rocket from '~icons/tabler/rocket'
import Star from '~icons/tabler/star'

const all: IconChoice[] = [
  { name: 'tabler:bell', icon: Bell },
  { name: 'tabler:home', icon: Home },
  { name: 'tabler:rocket', icon: Rocket },
  { name: 'tabler:star', icon: Star },
]
const submitted = signal('')

const search = async (query: string, limit: number) =>
  all.filter(choice => choice.name.includes(query)).slice(0, limit)

function read(event: Event) {
  const data = new FormData(event.currentTarget as HTMLFormElement)

  submitted.set(String(data.get('icon') ?? ''))
}
---
form.flex.flex-col.items-start.gap-2(onInput={read})
  IconPicker(search={search} name="icon")
  p.text-kui-subtext0 The form holds icon: {submitted() || 'nothing'}.
