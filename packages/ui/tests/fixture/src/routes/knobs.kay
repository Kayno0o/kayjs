---
import Avatar from '@kaynooo/kayjs-ui/avatar.kay'
import Badge from '@kaynooo/kayjs-ui/badge.kay'
import Button from '@kaynooo/kayjs-ui/button.kay'
import Card from '@kaynooo/kayjs-ui/card.kay'
import ColorInput from '@kaynooo/kayjs-ui/color-input.kay'
import Notice from '@kaynooo/kayjs-ui/notice.kay'
import PageHeader from '@kaynooo/kayjs-ui/page-header.kay'
import PageSection from '@kaynooo/kayjs-ui/page-section.kay'
import Select from '@kaynooo/kayjs-ui/select.kay'
import Stat from '@kaynooo/kayjs-ui/stat.kay'
import TextInput from '@kaynooo/kayjs-ui/text-input.kay'
import '../app.css'

const choices = [{ value: 'a', label: 'A' }, { value: 'b', label: 'B' }]
---
//- One of each component whose look an old knob of kayjs-ui sets, drawn by its recipe.
main
  div#scope
    Card#scoped-card(title="Scoped")
      p inside
  Card#card(title="Moons")
    p body
  Badge#badge(label="New")
  Badge#stamp(variant="stamp" label="New")
  Badge#solid(variant="solid" label="New")
  Notice#notice(label="Heads up")
  Avatar#avatar(name="Mars")
  TextInput#text(value="" placeholder="Name")
  Select#select(value="a" options={choices})
  Button#button(label="Go")
  Button#danger(tone="danger" label="Delete")
  ColorInput#color(label="Colour" value="#ff0000")
  Stat#stat(value={3} label="Moons" variant="tile")
  PageHeader#header(title="Page")
  PageSection#section(title="Section")
    p part
