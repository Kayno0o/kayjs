---
import { signal } from 'kay'
import Tabs from '@kayjs/ui/tabs.kay'

const tabs = [
  { value: 'details', label: 'Details' },
  { value: 'reviews', label: 'Reviews' },
]
const shown = signal('details')
---
Tabs(items={tabs} value={shown()} label="Product" onValueChange={({ value }) => shown = value})
  @panel(tab)
    if tab === 'details'
      p A telescope with a 70 mm lens.
    else
      p Rated 4.6 out of 5 by 120 buyers.
