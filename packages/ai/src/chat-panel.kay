---
import type { JSX } from 'kay'
import { signal, uid } from 'kay'

const { label = 'Chat', openLabel = 'Open the chat', closeLabel = 'Close the chat', icon, closeIcon, class: className } = props<{
  // Names the panel for screen readers and heads it.
  label?: string | undefined
  // Name and tooltip of the button while the panel is closed, and while it is open.
  openLabel?: string | undefined
  closeLabel?: string | undefined
  // What the button and the panel's close button draw.
  icon: JSX.Element
  closeIcon: JSX.Element
  class?: string | undefined
}>()

const open = signal(false)
const panelId = uid()
let button: HTMLButtonElement | undefined
let panel: HTMLElement | undefined

function show() {
  open.set(true)
  queueMicrotask(() => (panel?.querySelector<HTMLElement>('textarea') ?? panel)?.focus())
}

function hide() {
  open.set(false)
  button?.focus()
}

function keyDown(event: KeyboardEvent) {
  // A reply under way stops on Escape first, which the chat marks by preventing the event's default.
  if (event.key === 'Escape' && open() && !event.defaultPrevented && !event.isComposing) {
    event.preventDefault()
    hide()
  }
}
---
.kai-launcher(class={className} onKeyDown={keyDown})
  section.kai-launcher-panel(id={panelId} role="dialog" aria-labelledby={`${panelId}-title`} tabindex="-1" hidden={!open()} ref={element => { panel = element }})
    header.kai-launcher-head
      h2.kai-launcher-title(id={`${panelId}-title`}) {label}
      button.kui-icon-btn(type="button" aria-label={closeLabel} data-tooltip={closeLabel} data-size="md" data-variant="ghost" data-tone="neutral" onClick={hide})
        | {closeIcon}
    .kai-launcher-body
      slot
  button.kui-icon-btn.kai-launcher-button(type="button" ref={element => { button = element }} aria-label={openLabel} aria-expanded={open()} aria-controls={panelId} data-tooltip={open() ? closeLabel : openLabel} data-tooltip-placement="top span-left" data-size="lg" data-variant="solid" data-tone="accent" onClick={() => open() ? hide() : show()})
    | {icon}
