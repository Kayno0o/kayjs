---
import Button from '@kaynooo/kayjs-ui/button.kay'
import FileDrop from '@kaynooo/kayjs-ui/file-drop.kay'
import TextInput from '@kaynooo/kayjs-ui/text-input.kay'
import { attempt, toast } from '@kaynooo/kayjs-ui'
import { wording } from 'kay/words'
import { uploadFile, uploadRules } from './upload'

// An image or file field: the path of an upload dropped or picked, or one typed.
// With `many`, the zone of a list of them: it takes several files, calls `onChange` with the path of each in order as it lands, and shows no path of its own.
const { value, image, collection, many = false, onChange } = props<{ value: string, image: boolean, collection: string, many?: boolean, onChange: (path: string) => void }>()

// The share of the upload sent, from 0 to 1, while one is under way.
const sent = signal<number>()

// Until the server has said what it takes, an image field offers images and a file field anything.
const accept = signal<string>()

async function offer(): Promise<void> {
  const rules = await uploadRules()

  accept = rules === undefined ? undefined : image ? rules.images : rules.accept
}

void offer()

// A dropped file the picker's types miss, which FileDrop would otherwise ignore without a word.
function reject(files: File[]): void {
  for (const file of many ? files : files.slice(0, 1))
    toast.error(wording('cms.file.rejected', '{name} is {type} that uploads here do not take: {accept}', { name: file.name || wording('cms.upload.theFile', 'The file'), type: file.type || wording('cms.file.someType', 'of a type'), accept: accept() ?? 'images' }))
}

function label(): string {
  const share = sent()

  if (share === undefined)
    return many ? wording('cms.file.uploadMany', 'Upload files') : value === '' ? wording('cms.file.upload', 'Upload') : wording('cms.file.replace', 'Replace')

  return wording('cms.file.uploading', 'Uploading {percent}%', { percent: Math.round(share * 100) })
}

// One after the other, so the items land in the order the files were given, and a refused file is toasted while the others still land.
async function upload(files: File[]): Promise<void> {
  try {
    for (const file of many ? files : files.slice(0, 1)) {
      sent = 0

      const path = await attempt(() => uploadFile(collection, file, share => sent = share), wording('cms.file.failure', 'Could not upload'))

      if (path)
        onChange(path)
    }
  }
  finally {
    sent = undefined
  }
}
---
.kcms-file
  if value !== '' && !many
    if image
      // kay-allow unsized-image
      img.kcms-file-preview(src={value} alt="")
    else
      a.kcms-file-link(href={value}) {value.split('/').at(-1)}
  FileDrop.kcms-file-drop(accept={accept() ?? (image ? 'image/*' : undefined)} multiple={many} disabled={sent() !== undefined} onFiles={upload} onReject={reject})
    @content(zone)
      Button(label={label()} busy={sent() !== undefined} onClick={zone.open})
      span.kcms-file-hint {zone.dragging() ? wording('cms.file.dropNow', 'Drop to upload') : many ? wording('cms.file.dropMany', 'or drop files here') : wording('cms.file.drop', 'or drop a file here')}
  // Uploading is how a path is usually set, so typing one waits behind a disclosure.
  if !many
    details.kcms-file-path
      summary {wording('cms.file.pathLabel', 'Path')}
      TextInput(value={value} placeholder={wording('cms.file.pathHint', 'Or a path the site serves')} aria-label={wording('cms.file.pathLabel', 'Path')} onInput={onChange})
