; A line indents what is written under it. @indent.begin is nvim-treesitter's capture, @indent Helix's and Zed's.
[
  (element)
  (slot_fill)
  (slot_outlet)
  (snippet)
  (if_line)
  (else_line)
  (for_line)
  (await_line)
  (then_line)
  (catch_line)
  (try_line)
  (pending_line)
  (match_line)
  (when_line)
] @indent.begin @indent
