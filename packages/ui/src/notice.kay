---
import type { JSX } from 'kay'
import { recipe } from 'kay'

const look = recipe({
  parts: { root: 'kui-notice rounded-kui-card border-solid border-kui-overlay0 bg-kui-surface1 px-4 py-3 text-sm font-kui-notice text-kui-text [border-width:var(--kui-border-notice)] data-compact:border-0 data-compact:bg-transparent data-compact:p-0' },
  variants: { tone: { info: '', success: 'border-kui-success text-kui-success', warning: 'border-kui-warning text-kui-warning', danger: 'border-kui-error bg-kui-canvas text-kui-error' } },
  defaults: { tone: 'info' },
})

const { tone = 'info', label, compact = false, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'role'> & {
  // A danger is an alert, read out at once; the other tones are a status, read once the reader is idle.
  tone?: 'info' | 'success' | 'warning' | 'danger' | undefined
  label?: string | undefined
  // A line of text without the box, such as under a form's fields.
  compact?: boolean | undefined
}>()
---
// A form's outcome or a refusal, in place: what a toast says in passing, said where the page stays.
div({...rest} role={tone === 'danger' ? 'alert' : 'status'} data-tone={tone} data-compact={compact ? '' : undefined})
  | {label}
  slot
