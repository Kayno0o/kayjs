---
// kay-island
import { signal } from 'kay'
import ConfirmDelete from '@kaynooo/kayjs-ui/confirm-delete.kay'
import Menu from '@kaynooo/kayjs-ui/menu.kay'

const { onDelete } = props<{ onDelete: () => Promise<void> }>()

const row = signal(false)
const inline = signal(false)
const states = signal<string[]>([])
---
p#states {states().join(',')}
Menu(id="row-menu" label="Row" icon="plus" items={[{ label: 'Delete row', tone: 'danger', onSelect: () => row = true }]})
ConfirmDelete(message="Delete the row?" failure="Could not" onConfirm={onDelete} trigger="none" open={row()} onOpenChange={open => { row = open; states = [...states(), open ? 'open' : 'closed'] }})
Menu(id="inline-menu" label="Inline" icon="plus" items={[{ label: 'Remove row', onSelect: () => inline = true }]})
ConfirmDelete(message="Remove the row?" failure="Could not" onConfirm={onDelete} trigger="none" ask="inline" open={inline()} onOpenChange={open => inline = open})
button#ask-inline(onClick={() => inline = true}) Ask
