---
import type { Action, Failure } from 'kay'
import { ActionError, signal } from 'kay'
import FormField from '@kaynooo/kayjs-ui/form-field.kay'
import SaveForm from '@kaynooo/kayjs-ui/save-form.kay'

const pending = signal(false)

// Stands in for a page's action, which a static site cannot serve: it refuses a title under two letters, as the schema would.
const rename = Object.assign(async (form: FormData) => {
  pending.set(true)
  await new Promise(resolve => setTimeout(resolve, 800))
  pending.set(false)

  const title = String(form.get('title'))

  if (title.length < 2)
    throw new ActionError(422, '', { title: 'Two letters at least' })

  return title
}, { pending, url: '' }) as unknown as Action<{ title: string }, string | Failure<never>>
---
.max-w-md
  SaveForm(action={rename} failure="Could not save" saved="Saved.")
    FormField(label="Title" name="title" required)
      input.kui-field-input(name="title" value="Notes from the road")
    FormField(label="Summary" name="summary")
      textarea.kui-field-input(name="summary")
