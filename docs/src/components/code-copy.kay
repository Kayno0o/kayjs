---
import { attempt } from '@kaynooo/kayjs-ui'
import { onCleanup, onMount } from 'kay'

const COPIED_MS = 2000

// The highlighter writes each code block's button as HTML, CopyButton's look without its island, so one listener on the document answers them all, pages swapped in later included, as CopyButton would: the label says it went through, a toast says it did not.
async function copy(event: MouseEvent) {
  const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('[data-copy]') : null
  const code = button?.closest('.code')?.querySelector('code')

  if (!button || !code)
    return

  if (!await attempt(async () => navigator.clipboard.writeText(code.textContent ?? ''), 'Could not copy to the clipboard'))
    return

  button.textContent = 'Copied!'
  setTimeout(() => button.textContent = 'Copy', COPIED_MS)
}

const onClick = (event: MouseEvent) => void copy(event)

onMount(() => document.addEventListener('click', onClick))

onCleanup(() => document.removeEventListener('click', onClick))
---
