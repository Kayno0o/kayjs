--- server
import { t } from 'elysia'
import { action } from 'kay'

export const rename = action(t.Object({ name: t.String({ minLength: 2, maxLength: 200, error: 'Two letters at least' }) }), async ({ name }) => name)

const failure = rename.failed()
---
---
import FormField from '@kaynooo/kayjs-ui/form-field.kay'
import TextInput from '@kaynooo/kayjs-ui/text-input.kay'
import Textarea from '@kaynooo/kayjs-ui/textarea.kay'
---
main
  form#form(action={rename})
    section#field
      FormField(label="Name" hint="As it shows on the site" issue={failure?.errors.name} required)
        input(name="name" value={failure?.values.name})
    section#plain
      TextInput(name="email" type="email" required autocomplete="email" aria-label="Email")
      Textarea(name="bio" value="Hi" rows={3} aria-label="Bio")
    button Rename
  form#filters(method="get")
    section#compact
      FormField(label="Period" compact)
        select(name="period")
