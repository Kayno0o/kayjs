---
import type { JSX } from 'kay'

const { title, description, class: className, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'title' | 'children'> & {
  title: string
  description?: string | undefined
  class?: string | undefined
}>()
---
.kui-empty-state({...rest} class={className})
  p.kui-empty-state-title {title}
  if description
    p.kui-empty-state-description {description}
