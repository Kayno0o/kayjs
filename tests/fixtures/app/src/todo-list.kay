---
import type { Todo } from './todo'
import { fadeIn } from './todo'
import { selection, signal } from 'kay'
import TodoItem from './todo-item.kay'

const { todos, title = 'Todos' } = props<{ todos: Todo[], title?: string }>()
const filter = signal('')
const shown = () => todos.filter(todo => todo.title.includes(filter()))
const selected = selection<number>()
---
section.todo-list
  h1 {title}
  input(type="search" bind:value={filter} placeholder="Filter" aria-label="Filter")
  ul
    for todo, i of shown() key={todo.id}
      TodoItem(todo={todo} index={i} selected={selected.is(todo.id)} onToggle={id => selected.set(id)})
    else
      li.empty(transition={fadeIn}) Nothing matches
  if todos.find(todo => todo.id === selected()) as todo
    p Selected #[strong {todo.title}]
