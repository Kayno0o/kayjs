---
import settings from './settings'

const { href } = props<{ href: string }>()
---
div(style="margin:24px 0")
  a(href={href} style={`display:inline-block;padding:12px 20px;background:${settings.accent};color:${settings.onAccent};text-decoration:none;font-weight:600;border-radius:${settings.radius}`})
    slot
