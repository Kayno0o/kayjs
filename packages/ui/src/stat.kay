---
import type { JSX } from 'kay'
import type { IconProps } from 'kay/icons'
import type { IconSlot } from './defaults'
import Icon from './icon.kay'

const { value, label, icon, class: className, ...rest } = props<Omit<JSX.IntrinsicElements['span'], 'class' | 'children'> & {
  value: number | string
  label?: string
  icon?: IconSlot | IconProps
  class?: string
}>()
---
// A figure and what it counts, read together: "12 moons".
span.stat-badge({...rest} class={className})
  if icon
    Icon(icon={icon})
  span.stat-value {value}
  if label
    span.stat-label {label}
