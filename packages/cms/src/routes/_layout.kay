--- server
import Toaster from '@kaynooo/kayjs-ui/toaster.kay'
import TooltipHost from '@kaynooo/kayjs-ui/tooltip-host.kay'
import { wording } from 'kay/words'
import { screenPath } from '../paths'
import { settings } from '../settings'
import './admin.css'

const { prefix } = settings()
// Toaster and TooltipHost give way to the app's own when its root layout renders them.
---
.kcms-admin
  header.kcms-admin-head
    a.kcms-admin-home(href={screenPath(prefix)}) {wording('cms.admin.content', 'Content')}
  main.kcms-admin-main
    slot
Toaster
TooltipHost
