---
import type { JSX } from 'kay'

const { value, label, class: className, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'children' | 'role'> & {
  // How far along the task is, from 0 to 1 as `add.progress()` and an upload's `progress()` read; without it the bar is indeterminate.
  value?: number | undefined
  // Names the bar for screen readers.
  label: string
  class?: string | undefined
}>()

// A value that is not a number leaves the bar indeterminate.
const fraction = () => value === undefined || Number.isNaN(value) ? undefined : Math.min(1, Math.max(0, value))
---
.kui-progress({...rest} role="progressbar" aria-label={label} aria-valuemin={0} aria-valuemax={100} aria-valuenow={fraction() === undefined ? undefined : Math.round(fraction()! * 100)} data-indeterminate={fraction() === undefined ? '' : undefined} class={className})
  .kui-progress-fill(style={fraction() === undefined ? undefined : `width: ${fraction()! * 100}%`})
