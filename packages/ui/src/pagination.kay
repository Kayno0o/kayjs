---
import type { JSX } from 'kay'
import { pageHref, pageItems } from './pagination'

const { page, pages, url, param = 'page', siblings = 1, label = 'Pagination', previousLabel = 'Previous', nextLabel = 'Next', class: className, ...rest } = props<Omit<JSX.IntrinsicElements['nav'], 'class' | 'children'> & {
  // The page on screen, from 1.
  page: number
  // How many pages there are; with one or none, nothing is drawn.
  pages: number
  // The URL of the page on screen, `ctx.url`: each link keeps its path and query, `param` set to the page.
  url: URL | string
  // The query parameter holding the page, `page` by default.
  param?: string
  // How many pages show on each side of the current one, 1 by default.
  siblings?: number
  // Names the navigation for screen readers.
  label?: string
  previousLabel?: string
  nextLabel?: string
  class?: string
}>()
---
// Plain links through the query, so a page renders on the server, its pages crawlable, and needs no island.
if pages > 1
  nav.kui-pagination({...rest} aria-label={label} class={className})
    if page > 1
      a.kui-pagination-step(href={pageHref(url, page - 1, param)} rel="prev") {previousLabel}
    else
      span.kui-pagination-step(aria-disabled="true") {previousLabel}
    for item, index of pageItems(page, pages, siblings) key={index}
      if item === 'gap'
        span.kui-pagination-gap(aria-hidden="true") …
      else
        a.kui-pagination-page(href={pageHref(url, item, param)} aria-current={item === page ? 'page' : undefined}) {item}
    if page < pages
      a.kui-pagination-step(href={pageHref(url, page + 1, param)} rel="next") {nextLabel}
    else
      span.kui-pagination-step(aria-disabled="true") {nextLabel}
