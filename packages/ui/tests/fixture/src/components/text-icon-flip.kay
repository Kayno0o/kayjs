---
import { signal } from 'kay'
import Combobox from '@kayjs/ui/combobox.kay'
import TextInput from '@kayjs/ui/text-input.kay'

const kind = signal<'text' | 'search'>('text')
const icon = signal<'globe' | false | undefined>(undefined)
const typed = signal('')
const comboIcon = signal<'search' | undefined>(undefined)
---
TextInput#box(type={kind()} icon={icon()} value={typed()} onInput={typed.set} aria-label="Flip")
button#search(onClick={() => kind = 'search'}) Search
button#text(onClick={() => kind = 'text'}) Text
button#globe(onClick={() => icon = 'globe'}) Globe
button#none(onClick={() => icon = false}) None
button#auto(onClick={() => icon = undefined}) Auto
Combobox#combo(icon={comboIcon()} label="Pick" options={[{ value: 'a', label: 'A' }]})
button#combo-icon(onClick={() => comboIcon = 'search'}) Combo icon
button#combo-bare(onClick={() => comboIcon = undefined}) Combo bare
