---
import type { FieldSize } from './field-look'
import type { JSX, Snippet } from 'kay'
import type { DateRange } from './date'
import { effect, recipe, signal, untrack } from 'kay'
import DateInput from './date-input.kay'
import { dateRangeFrom } from './date'
import { defaultKept, onFormReset, startRef } from './form-reset'
import { wording } from 'kay/words'

const look = recipe({
  parts: {
    root: 'kui-date-range-input inline-flex items-center gap-1.5',
    separator: 'text-xs text-muted',
  },
})

const { size = 'md', invalid, value = [null, null], min, max, firstDay, label, fromLabel, toLabel, fromName, toName, disabled, isDisabled, day, open, onOpenChange, onMonthChange, onChange, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'children' | 'role' | 'onChange'> & {
  // The box's size: `md` by default, `sm` and `lg` change its padding and type.
  size?: FieldSize | undefined
  // Marks the control as refused, in the danger colour with `aria-invalid`. A FormField marks its control on its own while it shows a message.
  invalid?: boolean | undefined
  // The dates to start with as `YYYY-MM-DD`, each open when null; a pair whose parent passes another follows it.
  value?: DateRange | undefined
  // The earliest and latest date allowed, as `YYYY-MM-DD`.
  min?: string | undefined
  max?: string | undefined
  // The first day of the calendars' weeks, 0 for Sunday to 6 for Saturday; the page's locale decides by default.
  firstDay?: 0 | 1 | 2 | 3 | 4 | 5 | 6 | undefined
  // Names the pair for screen readers, each box adding "from" or "to".
  label: string
  // Each box's whole name in place of the label and "from" or "to", for another language.
  fromLabel?: string | undefined
  toLabel?: string | undefined
  // Post each date under its own name, for a range inside a form; `dateRangeFrom(from, to)` reads them back on the server.
  fromName?: string | undefined
  toName?: string | undefined
  disabled?: boolean | undefined
  // Whether a single day cannot be chosen, and the block drawing the inside of a day's button, as on a DateInput; both boxes share them.
  isDisabled?: ((iso: string) => boolean) | undefined
  day?: Snippet<[iso: string, state: { selected: boolean, today: boolean, outside: boolean, disabled: boolean }]> | undefined
  // Shows the calendar of that box when the page sets it, and none for `false`; left out, the buttons, a click outside and Escape work on their own. `onOpenChange` reports each change, so a page driving `open` can set it back.
  open?: 'from' | 'to' | false | undefined
  // Called as either calendar shows or hides, with the box it belongs to.
  onOpenChange?: ((open: boolean, box: 'from' | 'to') => unknown) | undefined
  // Called with the month on show as `YYYY-MM` as either calendar opens on it or moves to another, with the box it belongs to.
  onMonthChange?: ((month: string, box: 'from' | 'to') => unknown) | undefined
  // Runs once a date is set, with the pair in order, and only when the range changed.
  onChange?: ((value: DateRange) => unknown) | undefined
}>()

const pair = signal<DateRange>(untrack(() => value))

effect(() => pair = value)

let root: HTMLElement | undefined

// What a reset goes back to: the pair it started with, or the one last saved by a SaveForm.
const initial = defaultKept<DateRange>(() => root, pair, untrack(() => value))

// The boxes follow the pair they are given, so a reset only has to put the pair back, which the app's `onChange` then hears of; it waits for the boxes' own reset, so it has the last word.
onFormReset(() => root, () => {
  const start = initial()

  if (start[0] === pair()[0] && start[1] === pair()[1])
    return

  pair = start
  onChange?.(start)
}, true)

const ref = startRef<HTMLElement>(element => root = element, rest.ref)

// A reversed pair is put back in order, in both boxes too.
function commit(from: string, to: string) {
  const next = dateRangeFrom(from, to)

  if (next[0] === pair()[0] && next[1] === pair()[1])
    return

  pair = next
  onChange?.(next)
}
---
div({...rest} ref={ref} role="group" aria-label={label})
  DateInput(size={size} invalid={invalid} name={fromName} min={min} max={max} firstDay={firstDay} disabled={disabled} isDisabled={isDisabled} day={day} onMonthChange={month => onMonthChange?.(month, 'from')} open={open === undefined ? undefined : open === 'from'} onOpenChange={now => onOpenChange?.(now, 'from')} aria-label={fromLabel ?? wording('ui.dateRangeInput.from', '{label} from', { label })} value={pair()[0] ?? ''} onChange={next => commit(next, pair()[1] ?? '')})
  span(part="separator" aria-hidden="true") -
  DateInput(size={size} invalid={invalid} name={toName} min={min} max={max} firstDay={firstDay} disabled={disabled} isDisabled={isDisabled} day={day} onMonthChange={month => onMonthChange?.(month, 'to')} open={open === undefined ? undefined : open === 'to'} onOpenChange={now => onOpenChange?.(now, 'to')} aria-label={toLabel ?? wording('ui.dateRangeInput.to', '{label} to', { label })} value={pair()[1] ?? ''} onChange={next => commit(pair()[0] ?? '', next)})
