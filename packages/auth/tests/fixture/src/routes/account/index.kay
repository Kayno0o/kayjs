--- server
import { t } from 'elysia'
import { action } from 'kay'

export const setUp = action(t.Object({ password: t.String() }), async ({ password }, ctx) => {
  const result = await ctx.locals.auth.setUpTwoFactor({ password })

  return result.ok ? result.setup.secret : ctx.fail(400, { error: result.error })
})

export const enable = action(t.Object({ code: t.String({ maxLength: 32 }) }), async ({ code }, ctx) => {
  const result = await ctx.locals.auth.enableTwoFactor(code)

  return result.ok ? result.recoveryCodes.length : ctx.fail(400, { error: result.error })
})

export const signOut = action(t.Object({}), async (_input, ctx) => {
  await ctx.locals.auth.signOut()
  return ctx.redirect('/')
})

const user = (await ctx.locals.auth.user())!
const secret = ctx.succeeded(setUp)
---
h1#account {user.email}
form#set-up(action={setUp})
  input(name="password" type="password" aria-label="password")
  button Set up two-factor
if secret?.data as shown
  p#secret {shown}
form#enable(action={enable})
  input(name="code" aria-label="code")
  button Turn on
form#sign-out(action={signOut})
  button Sign out
