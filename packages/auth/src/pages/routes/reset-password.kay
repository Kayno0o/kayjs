--- server
import { localize, t } from 'kay/i18n'
import Captcha from '../components/captcha.kay'
import Message from '../components/message.kay'
import Panel from '../components/panel.kay'
import { captchaFor, captchaOf, failure, guarded, issue, refusal, refusedFor, schemas } from '../forms'
import Button from '@kaynooo/kayjs-ui/button.kay'
import FormField from '@kaynooo/kayjs-ui/form-field.kay'

// Visitors reach this page before signing in, so none of the app's guards run here, whatever they check: one asking for a session would keep everyone out.
export const page = { guards: false }

export const request = action(schemas.requestReset, async (input, ctx) => {
  const result = await ctx.locals.auth.requestPasswordReset(input.email, { captcha: captchaOf(input) })

  return result.ok ? 'sent' : ctx.fail(400, { error: refusedFor(result.error, input) })
}, guarded)

export const reset = action(schemas.reset, async ({ token, password }, ctx) => {
  const result = await ctx.locals.auth.resetPassword(token, password)

  if (!result.ok)
    return ctx.fail(400, 'errors' in result ? { password: result.errors.password } : { error: result.error === 'invalid' ? 'link' : result.error })

  return ctx.redirect(localize(result.redirect))
})

const auth = ctx.locals.auth
const features = auth.features()
const token = ctx.url.searchParams.get('token') ?? ctx.failed(reset)?.values.token
// Only the request form asks for a captcha, so a visit with a token never reads the client's attempts.
const captcha = token ? { shown: false, challenge: null } : await captchaFor(auth, features.captcha, 'reset')
const requestError = refusal(ctx.failed(request), features.captcha)
const refused = ctx.failed(reset)?.data
const sent = ctx.succeeded(request) !== undefined
---
head
  title {t('auth.reset.title')}
if token
  Panel(title={t('auth.reset.choose')})
    form.flex.flex-col.gap-3(action={reset})
      input(type="hidden" name="token" value={token})
      FormField(label={t('auth.newPassword')} hint={t('auth.passwordHint', { min: features.rules.password.min })} issue={refused && 'password' in refused ? issue('password', refused.password, features.rules) : undefined} required)
        input(name="password" type="password" autocomplete="new-password" minlength={features.rules.password.min} required)
      if refused && 'error' in refused
        Message(text={failure(refused.error)})
      Button(type="submit" variant="accent" label={t('auth.reset.save')})
else
  Panel(title={t('auth.reset.title')})
    if sent
      Message(tone="success" text={t('auth.reset.sent')})
    else if !features.email
      Message(text={failure('unavailable')})
    else
      form.flex.flex-col.gap-3(action={request})
        p {t('auth.reset.intro')}
        FormField(label={t('auth.email')} required)
          input(name="email" type="email" autocomplete="email" required)
        if features.captcha && captcha.shown
          Captcha(widget={features.captcha} challenge={captcha.challenge})
        if requestError
          Message(text={requestError})
        Button(type="submit" variant="accent" label={t('auth.reset.submit')})
