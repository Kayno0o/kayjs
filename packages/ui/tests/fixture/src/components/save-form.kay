---
import type { Action, Failure } from 'kay'
import { ActionError, signal } from 'kay'
import FormField from '@kaynooo/kayjs-ui/form-field.kay'
import SaveForm from '@kaynooo/kayjs-ui/save-form.kay'
import Toaster from '@kaynooo/kayjs-ui/toaster.kay'

// `save` stands in for the server: it answers the saved name, the messages a schema refusal carries, or throws for a call that failed outright.
const { save, onSaved, onDiscard, shortcut } = props<{ save: (input: { name: string }) => Promise<string | { errors: Record<string, string> }>, onSaved: (name: string) => void, onDiscard: () => void, shortcut?: string | false | undefined }>()

const pending = signal(false)
const extra = signal(false)

const rename = Object.assign(async (form: FormData) => {
  pending.set(true)

  try {
    const answer = await save({ name: String(form.get('name')) })

    if (typeof answer !== 'string')
      throw new ActionError(422, '', answer.errors)

    return answer
  }
  finally {
    pending.set(false)
  }
}, { pending, url: '/_kay/action/form/rename' }) as unknown as Action<{ name: string }, string | Failure<never>>
---
button#more(onClick={() => extra.set(true)}) More
SaveForm(action={rename} failure="Could not save" saved="Saved." onSaved={onSaved} onDiscard={onDiscard} shortcut={shortcut})
  FormField(label="Name" name="name")
    input#name(name="name" value="Ada")
  textarea#notes(name="notes")
  input#nameless
  if extra()
    input#extra(name="extra")
Toaster
