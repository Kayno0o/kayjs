---
import type { JSX, Snippet } from 'kay'
import type { LeafletApi, LeafletGroup, LeafletLayer, LeafletPath, LeafletView, MapMarker, MapPoint } from './map-view'
import { effect, mediaQuery, onCleanup, onMount, recipe, reducedMotion, signal, untrack } from 'kay'
import { comesIntoView, drawnPoints, OSM_ATTRIBUTION, OSM_TILES, validPoint } from './map-view'
import { steppedPoint } from './plot'

const look = recipe({
  parts: {
    root: 'kui-map-view relative z-0 isolate w-full overflow-hidden border-solid border-[length:var(--border-width)] border-border',
    // Leaflet draws into it, and the rules it needs from its own stylesheet stay on this class in theme.css.
    canvas: 'kui-map-view-canvas w-full',
    // The box Leaflet takes over, which adds its own classes and style to it.
    surface: 'size-full overflow-hidden',
    // What screen readers read in place of the drawing.
    list: 'sr-only',
    item: 'block',
  },
})

const { lines = [], markers = [], highlight, tiles = OSM_TILES, attribution = OSM_ATTRIBUTION, darkTiles, darkAttribution, maxZoom = 19, center = [20, 0], zoom = 2, label, onMarkerClick, onMove, popup, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'children' | 'role'> & {
  // Polylines, each an array of [latitude, longitude] points; a change redraws them, refitting only while the visitor has not moved the map.
  lines?: readonly (readonly MapPoint[])[] | undefined
  // Round markers; a `label` shows on hover or focus and is read by screen readers, a `popup` opens on a click, Enter or Space and is read in the list too. A marker is clickable, and a tab stop, when it has a label, a popup or the map has `onMarkerClick`.
  markers?: readonly MapMarker[] | undefined
  // A path drawn over the lines and brought into view, such as the entry picked in a timeline; one point draws a dot. Unset, the map fits what it draws again.
  highlight?: readonly MapPoint[] | undefined
  // The tile layer's URL template; OpenStreetMap's by default, whose attribution the map shows; `tiles`, `attribution` and `maxZoom` follow later changes. Its host needs `img-src`, which kay admits for any https host.
  tiles?: string | undefined
  // HTML shown in the corner for the tiles' source; set it with `tiles`, and the map follows a change to either.
  attribution?: string | undefined
  // The tiles drawn while the map's colour scheme is dark, in place of the filter that darkens `tiles` otherwise, credited with `darkAttribution` (`attribution` unset).
  darkTiles?: string | undefined
  darkAttribution?: string | undefined
  maxZoom?: number | undefined
  // Where the map looks while there is nothing to fit, and how close. A new `center` or `zoom` from the parent moves the map there and counts as the visitor's own move, so later changes to the lines or markers no longer refit it; the view `onMove` reports passed back is the view it already has.
  center?: MapPoint | undefined
  zoom?: number | undefined
  // Called with the marker and its place in `markers` as a click, Enter or Space presses it, besides opening its popup.
  onMarkerClick?: ((marker: MapMarker, index: number) => unknown) | undefined
  // Called with `{ center, zoom }` once the visitor has moved or zoomed the map, not for a fit the map makes itself nor for a `center` or `zoom` the parent set.
  onMove?: ((view: { center: MapPoint, zoom: number }) => unknown) | undefined
  // Draws the content of a marker's popup in place of its `popup` text, such as a link or a button; it is moved into the popup while open, and an empty block leaves that marker with none.
  popup?: Snippet<[marker: MapMarker, index: number]> | undefined
  // Describes the map for screen readers.
  label: string
}>()

let canvas: HTMLElement | undefined

// What a screen reader reads of a marker: its label, and its popup's text, which a click opens for everyone else.
// A marker the map cannot name still gets an entry when its popup is a block or the app listens to its clicks.
const entries = () => markers.flatMap((marker, index) => marker.label || marker.popup || popup || onMarkerClick ? [{ marker, index, name: [marker.label, marker.popup].filter(Boolean).join(': ') }] : [])

// The block of each marker's popup, once drawn: Leaflet takes the element out of the list while the popup is open.
const bodies = new Map<number, HTMLElement>()

// Leaflet writes a string into the page as HTML, so text goes in as an element holding it as text.
const textNode = (leaflet: LeafletApi, text: string) => Object.assign(leaflet.DomUtil.create('div'), { textContent: text })

const still = reducedMotion()
const systemDark = mediaQuery('(prefers-color-scheme: dark)')

// Whether the map's own colour scheme is dark, which `data-theme` on any element around it sets as the system does.
const dark = signal(false)

// The map once Leaflet has loaded, which the effects below draw on.
const drawing = signal<{ view: LeafletView, base: LeafletGroup, picked: LeafletGroup, leaflet: LeafletApi } | null>(null)

onMount(() => {
  let gone = false
  let view: LeafletView | undefined
  let observer: ResizeObserver | undefined
  const waiting = canvas ? comesIntoView(canvas) : undefined

  // A computed `light dark` leaves the choice to the system.
  const readScheme = (prefersDark: boolean) => {
    const scheme = canvas ? getComputedStyle(canvas).colorScheme : ''

    dark = scheme.includes('dark') && (!scheme.includes('light') || prefersDark)
  }

  const themes = typeof MutationObserver === 'undefined' ? undefined : new MutationObserver(() => readScheme(untrack(systemDark)))

  themes?.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'], subtree: true })
  effect(() => readScheme(systemDark()))

  void (async () => {
    let leaflet: LeafletApi

    // Leaflet is a chunk of its own, loaded once the map is near the viewport: a map below the fold costs nothing until it is scrolled to.
    await waiting?.near

    if (gone)
      return

    try {
      // Leaflet ships no types, and an app with @types/leaflet resolves them: @ts-expect-error would fail there, so the import is ignored and cast to the surface above.
      // eslint-disable-next-line ts/ban-ts-comment
      // @ts-ignore
      leaflet = await import('leaflet') as unknown as LeafletApi
    }
    catch (error) {
      console.error('kayjs-ui: MapView draws with Leaflet, which could not be loaded; install it with `bun add leaflet`', error)

      return
    }

    if (gone || !canvas)
      return

    try {
      const calm = untrack(still)

      view = leaflet.map(canvas, { zoomSnap: 0.5, attributionControl: false, zoomAnimation: !calm, fadeAnimation: !calm, markerZoomAnimation: !calm })
      view.addControl(leaflet.control.attribution({ prefix: false }))
      // Any move but a fit is the visitor's, a popup's auto-pan included; a fit's own moves end with the first `moveend`, its zoom animation starting a frame later.
      view.on('movestart zoomstart', () => moved ||= !fitting)
      view.on('dragstart', () => moved = true)
      view.on('moveend', () => {
        const mine = fitting || following

        fitting = false
        following = false

        if (!mine)
          onMove?.({ center: [view!.getCenter().lat, view!.getCenter().lng], zoom: view!.getZoom() })
      })

      // A map mounted hidden has no size to fit into: it fits once the box gets one, and learns of later resizes.
      if (typeof ResizeObserver !== 'undefined') {
        // A map that has a size at mount is fitted by the effects, so a later resize leaves the visitor's pan and zoom.
        let sized = view.getSize().x > 0 && view.getSize().y > 0

        observer = new ResizeObserver(() => {
          view?.invalidateSize({ animate: false })

          const { x, y } = view?.getSize() ?? { x: 0, y: 0 }
          const ready = drawing()

          if (x > 0 && y > 0 && !sized && ready) {
            sized = true
            fit(ready.view)
          }
          else if (x === 0 || y === 0) {
            sized = false
          }
        })
        observer.observe(canvas)
      }

      drawing = { view, base: leaflet.layerGroup().addTo(view), picked: leaflet.layerGroup().addTo(view), leaflet }
    }
    catch (error) {
      console.error('kayjs-ui: MapView could not draw', error)
    }
  })()

  // Where the map fits: the highlight when there is one, else everything drawn, else the centre.
  let all: MapPoint[] = []
  let chosen: MapPoint[] = []
  // Whether the visitor panned or zoomed since the last fit, which a change to the lines or markers then leaves be.
  let moved = false
  let fitting = false
  // Set while the map moves to a view the parent passed, which is not the visitor's to report.
  let following = false

  const fit = (map: LeafletView) => {
    const leaflet = drawing()?.leaflet
    const animate = !untrack(still)

    if (!leaflet)
      return

    moved = false
    fitting = true

    if (chosen.length > 0)
      map.fitBounds(leaflet.latLngBounds(chosen), { padding: [48, 48], maxZoom: 16, animate })
    else if (all.length > 0)
      map.fitBounds(leaflet.latLngBounds(all), { padding: [24, 24], maxZoom: 16, animate })
    else
      map.setView(center, zoom, { animate })
  }

  // A `center` or `zoom` the parent changes moves the map there, once it is drawn and unless it already looks there.
  let looking: { center: MapPoint, zoom: number } | undefined

  effect(() => {
    const ready = drawing()
    const next = { center: [center[0], center[1]] as MapPoint, zoom }

    if (!ready)
      return

    if (looking === undefined) {
      looking = next

      return
    }

    if (looking.center[0] === next.center[0] && looking.center[1] === next.center[1] && looking.zoom === next.zoom)
      return

    looking = next

    const now = ready.view.getCenter()

    if (Math.abs(now.lat - (next.center[0] ?? Number.NaN)) < 1e-6 && Math.abs(now.lng - (next.center[1] ?? Number.NaN)) < 1e-6 && ready.view.getZoom() === next.zoom)
      return

    moved = true
    following = true
    ready.view.setView(next.center, next.zoom, { animate: !untrack(still) })
  })

  // The tile layer is replaced with the props that make it, which its attribution follows.
  let tileLayer: LeafletLayer | undefined

  effect(() => {
    const ready = drawing()

    if (!ready)
      return

    const night = darkTiles !== undefined && dark() ? darkTiles : undefined

    tileLayer?.remove()
    tileLayer = ready.leaflet.tileLayer(night ?? tiles, { maxZoom, attribution: night === undefined ? attribution : darkAttribution ?? attribution }).addTo(ready.view)
  })

  // The markers with a label or a popup, one tab stop in all: the arrows and Home and End walk them in the order of `markers`, as a scatter chart's dots.
  let stops: SVGElement[] = []
  let stop = 0

  const focusable = (dot: LeafletPath, marker: MapMarker, index: number, at: number, map: LeafletView, opens: boolean) => {
    const element = dot.getElement()

    if (!element)
      return

    element.setAttribute('tabindex', at === stop ? '0' : '-1')
    element.setAttribute('role', opens || onMarkerClick ? 'button' : 'img')
    element.setAttribute('aria-label', marker.label || marker.popup || '')
    // Leaflet shows the label on focus, and the marker comes into view if the visitor moved away from it.
    element.addEventListener('focus', () => {
      stops[stop]?.setAttribute('tabindex', '-1')
      stop = at
      element.setAttribute('tabindex', '0')
      map.panInside(marker.at, { padding: [24, 24], animate: !untrack(still) })
    })
    element.addEventListener('keydown', (event) => {
      if (event.altKey || event.ctrlKey || event.metaKey)
        return

      if ((opens || onMarkerClick) && (event.key === 'Enter' || event.key === ' ')) {
        event.preventDefault()

        if (opens)
          dot.togglePopup()

        onMarkerClick?.(marker, index)

        return
      }

      if (event.key === 'Escape') {
        dot.closePopup()

        return
      }

      const next = steppedPoint(event.key, at, stops.length)

      if (next === undefined)
        return

      event.preventDefault()
      stops[next]?.focus({ preventScroll: true })
    })
    stops.push(element)
  }

  effect(() => {
    const ready = drawing()

    if (!ready)
      return

    const { view: map, base, leaflet } = ready
    const paths = lines.map(path => path.filter(validPoint)).filter(path => path.length > 0)
    const marks = markers.filter(marker => validPoint(marker.at))

    all = drawnPoints(paths, marks)

    // Fitting first gives a new map its view, which Leaflet waits for before drawing a layer, so the markers' elements exist below.
    if (!moved)
      fit(map)

    base.clearLayers()
    stops = []
    stop = Math.min(stop, Math.max(0, entries().length - 1))

    for (const path of paths)
      leaflet.polyline(path, { weight: 3, className: 'kui-map-view-line' }).addTo(base)

    const clicked = onMarkerClick

    for (const [index, marker] of markers.entries()) {
      if (!validPoint(marker.at))
        continue

      const block = popup ? bodies.get(index) : undefined
      const opens = Boolean(marker.popup) || Boolean(block?.hasChildNodes())
      const live = Boolean(marker.label) || opens || Boolean(onMarkerClick)
      const dot = leaflet.circleMarker(marker.at, { radius: 5, weight: 1, className: 'kui-map-view-marker', interactive: live }).addTo(base)

      if (marker.label)
        dot.bindTooltip(textNode(leaflet, marker.label))

      if (block?.hasChildNodes())
        dot.bindPopup(block)
      else if (marker.popup)
        dot.bindPopup(textNode(leaflet, marker.popup))

      if (clicked)
        dot.on('click', () => clicked(marker, index))

      if (live)
        focusable(dot, marker, index, stops.length, map, opens)
    }
  })

  effect(() => {
    const ready = drawing()

    if (!ready)
      return

    const { view: map, picked, leaflet } = ready
    const path = highlight?.filter(validPoint) ?? []

    picked.clearLayers()

    if (path.length === 1) {
      leaflet.circleMarker(path[0]!, { radius: 9, weight: 3, className: 'kui-map-view-pick-dot', interactive: false }).addTo(picked)
    }
    else if (path.length > 1) {
      leaflet.polyline(path, { weight: 10, className: 'kui-map-view-casing', interactive: false }).addTo(picked)
      leaflet.polyline(path, { weight: 6, className: 'kui-map-view-pick', interactive: false }).addTo(picked)
    }

    chosen = path
    fit(map)
  })

  onCleanup(() => {
    gone = true
    waiting?.stop()
    observer?.disconnect()
    themes?.disconnect()
    view?.remove()
  })
})
---
div(part="root" {...rest} role="region" aria-label={label})
  div(part="canvas" data-dark-tiles={dark() && darkTiles === undefined ? '' : undefined})
    div(part="surface" ref={el => canvas = el})
  if entries().length > 0
    ul(part="list")
      for entry of entries() key={entry.index}
        li(part="item")
          | {entry.name}
          if popup
            div(part="popup" ref={element => bodies.set(entry.index, element)})
              | {popup(entry.marker, entry.index)}
