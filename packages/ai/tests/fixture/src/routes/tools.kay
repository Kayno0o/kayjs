--- server
import { ask, tool } from '@kaynooo/kayjs-ai'
import { action, s } from 'kay'
import { done, heard, hooks, testing } from '../testing'
import { wipe } from './locked/_actions.kay'

export const addNote = action(s.Object({ title: s.String({ minLength: 3, maxLength: 100, error: 'Too short' }) }), ({ title }) => {
  done.push(`addNote:${title}`)

  return { id: 1, title }
})

export const refuses = action(s.Object({}), (_input, ctx) => ctx.fail(409, { reason: 'full' }))

export const sendsAway = action(s.Object({}), (_input, ctx) => ctx.redirect('/'))

export const breaks = action(s.Object({}), () => {
  throw new Error('boom secret')
})

export const slow = action(s.Object({}), async () => {
  hooks.slowStarted?.()
  await Bun.sleep(150)
  done.push('slow')

  return 'slow done'
})

export const limited = action(s.Object({}), () => 'counted', { protect: { rateLimit: { max: 1, window: '1m' } } })

export const vetoed = action(s.Object({}), () => 'vetoed', { tool: false })

export const upload = action(s.Object({ photo: s.File() }), () => 'stored')

const tools = [addNote, refuses, sendsAway, breaks, slow, limited, wipe]

export const converse = action(s.Object({ prompt: s.String({ maxLength: 200 }), maxSteps: s.Optional(s.Integer({ minimum: 1, maximum: 10 })), offer: s.Optional(s.Array(s.String({ maxLength: 40 }), { maxItems: 10 })) }), async ({ prompt, maxSteps, offer }) => {
  const reply = ask(prompt, { tools: offer === undefined ? tools : tools.filter(tool => offer.includes(tool.url.slice(tool.url.lastIndexOf('/') + 1))), maxSteps, confirm: false, provider: testing.provider })

  return { text: await reply, calls: await reply.calls, finish: await reply.finish, usage: await reply.usage }
})

// A posted file shown to a model that calls tools, as an app's scan reader would.
export const looks = action(s.Object({ photo: s.File({ type: 'image/png' }) }), async ({ photo }) => await ask([{ role: 'user', content: 'look', attachments: [photo] }], { tools: [addNote], confirm: false, provider: testing.provider }), { maxSize: '1mb' })

export const watch = action(s.Object({ prompt: s.String({ maxLength: 200 }) }), ({ prompt }) => ask(prompt, { tools: [addNote, slow], confirm: false, provider: testing.provider }).progress())

// A tool loop an app reads itself, as it would to speak the reply aloud, which `outlive` lets go on once the visitor left.
export const staying = action(s.Object({ prompt: s.String({ maxLength: 200 }), outlive: s.Boolean() }), ({ prompt, outlive }) => {
  const reply = ask(prompt, { tools: [addNote, slow], confirm: false, outlive, provider: testing.provider })

  void (async () => {
    let text = ''

    for await (const snapshot of reply)
      text = snapshot

    heard.push(text)
  })()

  return reply.progress()
})

const stamp = tool({ name: 'stamp', description: 'Stamps something', input: s.Object({}), run: () => {
  done.push('stamp')

  return 'stamped'
} })
const addNoteTwin = tool({ name: 'add_note', description: 'A function tool named as an action', input: s.Object({}), run: () => 'twin' })

// An action and a function tool in one ask, whose confirm refuses every action.
export const mixed = action(s.Object({ prompt: s.String({ maxLength: 200 }), twin: s.Optional(s.Boolean()) }), ({ prompt, twin }) => ask(prompt, { tools: twin === true ? [addNoteTwin, addNote] : [addNote, stamp], confirm: () => false, provider: testing.provider }).progress())

// A tool loop whose every call the visitor has not confirmed.
export const unconfirmed = action(s.Object({ prompt: s.String({ maxLength: 200 }) }), ({ prompt }) => ask(prompt, { tools: [addNote], confirm: () => false, provider: testing.provider }).progress())

export const lookup = action(s.Object({}), () => 'found', { tool: { description: 'Looks something up', readOnly: true } })

// A chat whose tools are asked about by default: the write waits for the visitor's Allow, the read does not.
export const approving = action(s.Object({ messages: s.Array(s.Object({ role: s.UnionEnum(['user', 'assistant']), content: s.String({ maxLength: 4000 }) }), { minItems: 1, maxItems: 50 }) }), ({ messages }) => ask(messages, { tools: [addNote, lookup], provider: testing.provider }).progress())

// The chat's action when the model has tools: the stream carries the calls too.
export const helper = action(s.Object({ messages: s.Array(s.Object({ role: s.UnionEnum(['user', 'assistant']), content: s.String({ maxLength: 4000 }) }), { minItems: 1, maxItems: 50 }) }), ({ messages }) => ask(messages, { tools: [addNote, breaks], confirm: false, provider: testing.provider }).progress())

export const sourced = action(s.Object({ messages: s.Array(s.Object({ role: s.UnionEnum(['user', 'assistant']), content: s.String({ maxLength: 4000 }) }), { minItems: 1, maxItems: 50 }) }), ({ messages }) => ask(messages, { sources: [{ n: 1, title: 'Tides', href: 'https://example.com/tides?a=1&b=2' }, { n: 2, title: 'Moon', href: '/moon' }, { n: 3, title: 'Never cited', href: 'https://example.com/3' }, { n: 4, title: 'Hostile', href: 'javascript:alert(1)' }] }).progress())

export const refusedTools = action(s.Object({ which: s.UnionEnum(['vetoed', 'upload']) }), ({ which }) => {
  ask('x', { tools: [which === 'vetoed' ? vetoed : upload] })

  return 'unreachable'
})
---
p Tools
