---
import { wording } from 'kay/words'
import { editedDay, useEditorZone } from '../datetime'

// The day an entry was last edited, which the browser writes in the editor's zone and the page's language once it has loaded; `sentence` words it as the content list does, `Last edited 21 Oct 2026 by Ada`, `author` naming who when it is known.
const { at, sentence = false, author } = props<{ at: number, sentence?: boolean, author?: string | undefined }>()

const zone = useEditorZone()
const lang = signal<string>()

onMount(() => lang.set(document.documentElement.lang))

const text = () => {
  const date = editedDay(at, zone(), lang())

  if (!sentence)
    return date

  return author ? wording('cms.admin.lastEditedBy', 'Last edited {date} by {author}', { date, author }) : wording('cms.admin.lastEdited', 'Last edited {date}', { date })
}
---
time(datetime={new Date(at).toISOString()}) {text()}
