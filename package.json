{
  "name": "@kaynooo/kayjs",
  "type": "module",
  "version": "1.52.3",
  "description": "A Bun web framework: one .kay file per component, pages rendered to plain HTML on the server, interactive islands in the browser",
  "author": "Kaynooo <https://github.com/Kayno0o>",
  "license": "MIT",
  "homepage": "https://kayjs.kaynooo.fr",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kayno0o/kayjs"
  },
  "bugs": {
    "url": "https://github.com/Kayno0o/kayjs/issues"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/"
  },
  "imports": {
    "#schema": {
      "types": "./types/runtime/schema.d.ts",
      "browser": "./src/runtime/schema.client.ts",
      "default": "./src/runtime/schema.ts"
    }
  },
  "exports": {
    ".": {
      "types": "./types/runtime/index.d.ts",
      "default": "./src/runtime/index.ts"
    },
    "./island": {
      "types": "./types/runtime/island.server.d.ts",
      "browser": "./src/runtime/island.client.ts",
      "default": "./src/runtime/island.server.ts"
    },
    "./await": {
      "types": "./types/runtime/await.d.ts",
      "browser": "./src/runtime/await.ts",
      "default": "./src/runtime/await.server.ts"
    },
    "./html": {
      "types": "./types/runtime/html.d.ts",
      "default": "./src/runtime/html.ts"
    },
    "./icons": {
      "types": "./types/runtime/icons.d.ts",
      "default": "./src/runtime/icons.ts"
    },
    "./seo": {
      "types": "./types/runtime/seo.d.ts",
      "default": "./src/runtime/seo.ts"
    },
    "./dev-tool": {
      "types": "./types/runtime/dev-tool.public.d.ts",
      "default": "./src/runtime/dev-tool.public.ts"
    },
    "./edit": {
      "types": "./types/runtime/edit.d.ts",
      "default": "./src/runtime/edit.ts"
    },
    "./content": {
      "types": "./types/content/index.d.ts",
      "default": "./src/content/index.ts"
    },
    "./i18n": {
      "types": "./types/runtime/i18n.server.d.ts",
      "browser": "./src/runtime/i18n.client.ts",
      "default": "./src/runtime/i18n.server.ts"
    },
    "./words": {
      "types": "./types/runtime/words.server.d.ts",
      "browser": "./src/runtime/words.client.ts",
      "default": "./src/runtime/words.server.ts"
    },
    "./params": {
      "types": "./types/runtime/params.d.ts",
      "default": "./src/runtime/params.ts"
    },
    "./cache": {
      "types": "./types/runtime/cache.server.d.ts",
      "browser": "./src/runtime/cache.ts",
      "default": "./src/runtime/cache.server.ts"
    },
    "./markdown": {
      "types": "./types/runtime/markdown.server.d.ts",
      "browser": "./src/runtime/markdown.client.ts",
      "default": "./src/runtime/markdown.server.ts"
    },
    "./image": {
      "types": "./types/runtime/image.public.d.ts",
      "default": "./src/runtime/image.public.ts"
    },
    "./jsx-runtime": {
      "types": "./types/runtime/jsx-runtime.d.ts",
      "default": "./src/runtime/jsx-runtime.ts"
    },
    "./dom": {
      "types": "./types/runtime/dom.d.ts",
      "default": "./src/runtime/dom.ts"
    },
    "./arrival": {
      "types": "./types/runtime/arrival.d.ts",
      "default": "./src/runtime/arrival.ts"
    },
    "./client": {
      "types": "./types/runtime/client.d.ts",
      "default": "./src/runtime/client.ts"
    },
    "./mount": {
      "types": "./types/runtime/mount.d.ts",
      "default": "./src/runtime/mount.ts"
    },
    "./compiler": {
      "types": "./types/compiler/public.d.ts",
      "default": "./src/compiler/public.ts"
    },
    "./bun": {
      "types": "./types/build/bun.d.ts",
      "default": "./src/build/bun.ts"
    },
    "./eslint": {
      "types": "./types/eslint/index.d.ts",
      "bun": "./src/eslint/index.ts",
      "default": "./dist/eslint.js"
    },
    "./server": {
      "types": "./types/server/index.d.ts",
      "default": "./src/server/index.ts"
    },
    "./internal": {
      "types": "./types/runtime/internal.d.ts",
      "default": "./src/runtime/internal.ts"
    },
    "./internal/title": {
      "types": "./types/runtime/page-title.d.ts",
      "default": "./src/runtime/page-title.ts"
    },
    "./internal/server": {
      "types": "./types/server/internal.d.ts",
      "default": "./src/server/internal.ts"
    },
    "./library": {
      "types": "./types/server/library.d.ts",
      "default": "./src/server/library.ts"
    },
    "./test": {
      "types": "./types/test/index.d.ts",
      "default": "./src/test/index.ts"
    },
    "./test/preload": {
      "types": "./types/test/preload.d.ts",
      "default": "./src/test/preload.ts"
    },
    "./test/dom": {
      "types": "./types/test/dom.d.ts",
      "default": "./src/test/dom.ts"
    },
    "./tsconfig.json": "./src/tsconfig.app.json",
    "./kay.tmLanguage.json": "./editors/vscode/syntaxes/kay.tmLanguage.json"
  },
  "bin": {
    "kay": "./src/cli.ts",
    "tsgo": "./src/tsgo.ts"
  },
  "files": [
    "LICENSE",
    "LICENSES",
    "NOTICE",
    "README.md",
    "dist",
    "editors/vscode/syntaxes/kay.tmLanguage.json",
    "llms",
    "llms.txt",
    "src",
    "types"
  ],
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "check": "$npm_execpath check",
    "build:types": "rm -rf types && bun src/tsgo.ts -p tsconfig.build.json",
    "build:eslint": "bun build src/eslint/index.ts --target node --packages external --outfile dist/eslint.js",
    "prepack": "bun run build:types && bun run build:eslint",
    "postpack": "rm -rf types dist",
    "prelint": "bun run build:eslint",
    "lint": "keslint --cache --ignore-pattern 'packages/**' && $npm_execpath run --filter './packages/*' --sequential lint",
    "prelint:fix": "bun run build:eslint",
    "lint:fix": "keslint --fix --cache --ignore-pattern 'packages/**' && $npm_execpath run --filter './packages/*' --sequential lint:fix",
    "test": "bun test --parallel --timings=tests/timings.json",
    "test:timings": "bun test --parallel --timings=tests/timings.json --update-timings",
    "bench": "$npm_execpath bench/run.ts",
    "bench:origins": "$npm_execpath bench/origins.ts",
    "bench:server": "$npm_execpath bench/server-cost.ts",
    "bench:sites": "$npm_execpath bench/sites/run.ts",
    "bench:soak": "$npm_execpath bench/soak.ts",
    "bench:test": "$npm_execpath test ./bench",
    "docs:build": "$npm_execpath src/cli.ts build docs --static",
    "bench:check": "$npm_execpath run bench:check:kay && $npm_execpath run bench:check:apps",
    "bench:check:kay": "$npm_execpath src/cli.ts check bench/apps/kay",
    "bench:check:apps": "bun src/tsgo.ts --noEmit -p bench/apps/solid && bun src/tsgo.ts --noEmit -p bench/apps/svelte && bun src/tsgo.ts --noEmit -p bench/apps/next && $npm_execpath --cwd=bench/apps/nuxt --bun run check && $npm_execpath --cwd=bench/apps/astro --bun run check"
  },
  "peerDependencies": {
    "@happy-dom/global-registrator": "^20.14.6 || ^21.0.3",
    "@types/bun": "^1.4.3"
  },
  "peerDependenciesMeta": {
    "@happy-dom/global-registrator": {
      "optional": true
    }
  },
  "dependencies": {
    "@babel/parser": "^7.29.7",
    "@babel/traverse": "^7.29.10",
    "@babel/types": "^7.29.7",
    "@jsquash/avif": "2.1.1",
    "@kaynooo/utils": "^2.29.0",
    "@resvg/resvg-js": "^2.6.2",
    "axe-core": "^4.14.0",
    "devalue": "^6.0.3",
    "elysia": "^1.4.30",
    "marked": "~18.1.1",
    "typescript": "^6.0.3",
    "typescript7": "npm:typescript@^7.0.2"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@happy-dom/global-registrator": "^21.0.3",
    "@iconify-json/tabler": "^1.2.42",
    "@kaynooo/eslint": "^7.0.4",
    "@kaynooo/kayjs-ai": "workspace:*",
    "@kaynooo/kayjs-auth": "workspace:*",
    "@kaynooo/kayjs-cms": "workspace:*",
    "@kaynooo/kayjs-mail": "workspace:*",
    "@kaynooo/kayjs-ui": "workspace:*",
    "@kaynooo/pg-orm": "^7.0.4",
    "@types/babel__traverse": "^7.28.0",
    "@types/bun": "^1.4.3",
    "bun-plugin-tailwind": "^0.1.2",
    "kay": "link:.",
    "mitata": "1.0.34",
    "playwright-core": "1.64.1",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3"
  },
  "workspaces": [
    "docs",
    "packages/*"
  ]
}
