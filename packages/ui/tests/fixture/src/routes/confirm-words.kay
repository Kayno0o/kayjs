---
import ConfirmDelete from '@kaynooo/kayjs-ui/confirm-delete.kay'
---
main
  div#plain
    ConfirmDelete(message="Delete this?" failureLabel="Could not delete" onConfirm={async () => undefined})
  div#given
    ConfirmDelete(message="Delete that?" failureLabel="Could not delete" onConfirm={async () => undefined} cancelLabel="Never mind")
