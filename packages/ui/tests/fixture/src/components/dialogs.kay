---
import { ActionError, ApiError, signal } from 'kay'
import ConfirmDelete from '@kaynooo/kayjs-ui/confirm-delete.kay'
import Dialog from '@kaynooo/kayjs-ui/dialog.kay'
import Toaster from '@kaynooo/kayjs-ui/toaster.kay'

// What the test reads back: how often the dialog closed, and whether a delete failed or went through.
const { onClose, onDelete, dirty = false, apiRefusal } = props<{ onClose: () => void, onDelete: () => Promise<void>, dirty?: boolean, apiRefusal?: { status: number, message: string, answer?: unknown } }>()

const open = signal(false)
const bareOpen = signal(false)
const busy = signal(false)
const states = signal<string[]>([])

// A delete made with `call()`, which throws ApiError for a refusal, built here so it is the class the library reads.
async function removeByApi() {
  if (apiRefusal)
    throw new ApiError(apiRefusal.status, apiRefusal.message, apiRefusal.answer)

  await onDelete()
}

// An archive the action's handler refuses, as `ctx.fail(409, { error })` reaches an island.
async function archive() {
  throw new ActionError(409, '', {}, { error: 'Still referenced' })
}
---
button#open(onClick={() => open = true}) Open
Dialog#dialog(open={open()} title="Rename" dirty={dirty} onOpenChange={() => { open = false; onClose() }})
  @footer
    button#cancel.kui-btn(onClick={() => open = false}) Cancel
  input#name(name="name")
ConfirmDelete(message="Delete this?" failureLabel="Could not delete" onConfirm={removeByApi})
ConfirmDelete(message="Archive this?" failureLabel="Could not archive" onConfirm={archive} label="Archive" refused={(data: { error?: string }) => data.error})
ConfirmDelete(message="Revoke this link?" failureLabel="Could not revoke" onConfirm={onDelete} triggerLook="button" label="Revoke link" class="revoke")
ConfirmDelete(message="Rotating breaks every link." failureLabel="Could not rotate" onConfirm={onDelete} triggerLook="link" label="Rotate link" title="Rotate link" confirmLabel="Rotate" pendingLabel="Rotating…" class="rotate")
ConfirmDelete(message="Its verdicts go with it." failureLabel="Could not remove" onConfirm={onDelete} ask="inline" label="Remove")
ConfirmDelete(message="Unshare it?" failureLabel="Could not unshare" onConfirm={onDelete} ask="inline" triggerLook="button" label="Unshare" class="unshare")
ConfirmDelete(message="Forget it?" failureLabel="Could not forget" onConfirm={onDelete} ask="inline" triggerLook="link" label="Forget" class="forget")
ConfirmDelete(message="Save without your own IP?" failureLabel="Could not save" success="Saved" onConfirm={onDelete} tone="neutral" triggerLook="button" label="Save" class="save")
ConfirmDelete(message="Tone?" failureLabel="Could not" onConfirm={onDelete} class="v-plain")
ConfirmDelete(message="Tone?" failureLabel="Could not" onConfirm={onDelete} variant="solid" class="v-solid")
ConfirmDelete(message="Tone?" failureLabel="Could not" onConfirm={onDelete} variant="ghost" class="v-ghost")
ConfirmDelete(message="Tone?" failureLabel="Could not" onConfirm={onDelete} variant="inline" class="v-inline")
ConfirmDelete(message="Tone?" failureLabel="Could not" onConfirm={onDelete} tone="neutral" class="n-plain")
ConfirmDelete(message="Tone?" failureLabel="Could not" onConfirm={onDelete} tone="neutral" variant="solid" class="n-solid")
ConfirmDelete(message="Tone?" failureLabel="Could not" onConfirm={onDelete} tone="neutral" variant="ghost" class="n-ghost")
ConfirmDelete(message="Tone?" failureLabel="Could not" onConfirm={onDelete} triggerLook="button" variant="ghost" class="n-button")
ConfirmDelete(message="Release it?" failureLabel="Could not release" onConfirm={removeByApi} label="Release" refused={(data: { reason: string }) => data.reason.toUpperCase()} class="release")
p#states {states().join(',')}
ConfirmDelete(message="Watch it?" failureLabel="Could not" onConfirm={onDelete} onOpenChange={open => states = [...states(), open ? 'open' : 'closed']} label="Watched" class="watched")
ConfirmDelete(message="Watch it inline?" failureLabel="Could not" onConfirm={onDelete} ask="inline" onOpenChange={open => states = [...states(), open ? 'inline-open' : 'inline-closed']} label="Watched inline" class="watched-inline")
Toaster
button#open-bare(onClick={() => bareOpen = true}) Open bare
Dialog#bare(open={bareOpen()} title="Bare" onOpenChange={() => bareOpen = false})
  input#bare-name(name="bare")
button#busy(onClick={() => busy = !busy()}) Busy
ConfirmDelete(message="Hold it?" failureLabel="Could not" onConfirm={onDelete} disabled={busy()} triggerLook="button" class="held")
