---
import SiteNav from '@kaynooo/kayjs-ui/site-nav.kay'

const links = [{ href: '/', label: 'Overview' }, { href: '/guides/tutorial', label: 'Tutorial' }, { href: '/ui/site-nav', label: 'SiteNav' }]
---
header.flex.items-center.gap-4
  strong kay
  SiteNav(links={links} current="/ui/site-nav" label="Main")
