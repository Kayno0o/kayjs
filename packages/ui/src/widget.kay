---
import { recipe } from 'kay'
import type { JSX, Snippet } from 'kay'
import type { IconSlot } from './defaults'
import type { IconProps } from 'kay/icons'
import Icon from './icon.kay'

const look = recipe({
  parts: {
    root: 'kui-widget flex w-full flex-col gap-3 rounded-lg border-[length:var(--border-width)] border-solid border-border bg-surface p-4 [box-shadow:var(--shadow-raised)]',
    head: 'flex items-center gap-2',
    title: 'min-w-0 flex-1',
  },
})

const { title, level = 2, icon, actions, empty = false, emptyState, isEmpty = false, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'title'> & {
  // A `@title` block draws markup inside the heading instead of the string.
  title?: string | Snippet | undefined
  // The title's heading level, under the page's outline.
  level?: 1 | 2 | 3 | 4 | 5 | 6 | undefined
  icon?: IconSlot | IconProps | undefined
  // The end of the head line: a link, a button, a row of actions.
  actions?: Snippet
  // Whether the data behind the widget is empty. With an `@emptyState` block, the frame and its head stay while the body shows the block; without one, an empty widget renders nothing at all.
  // Before 1.89 this was `isEmpty` and the block `@empty`; both work until 1.92 (`deprecated-ui-props`), a snippet in `empty` being the old block.
  empty?: boolean | Snippet | undefined
  emptyState?: Snippet
  isEmpty?: boolean | undefined
}>()
const none = typeof empty === 'boolean' ? empty : isEmpty
const block = emptyState ?? (typeof empty === 'boolean' ? undefined : empty)
---
// A dashboard tile: a framed body under a head line of icon, title and actions.
if block !== undefined || !none
  div(part="root" {...rest})
    if title || icon || actions
      div(part="head")
        if icon
          Icon(icon={icon})
        if title
          if level === 1
            h1.kui-heading-section(part="title") {title}
          else if level === 2
            h2.kui-heading-section(part="title") {title}
          else if level === 3
            h3.kui-heading-section(part="title") {title}
          else if level === 4
            h4.kui-heading-section(part="title") {title}
          else if level === 5
            h5.kui-heading-section(part="title") {title}
          else
            h6.kui-heading-section(part="title") {title}
        | {actions}
    if none
      | {block}
    else
      slot
