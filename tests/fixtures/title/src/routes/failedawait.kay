--- server
import { defer } from 'kay'

const answer = defer(Bun.sleep(10).then(() => 42))
--- script
import Failing from '../components/failing.kay'
import Room from '../components/room.kay'
---
h1 Failed await
Room(label="Healthy")
await answer
  p.pending Thinking
then value
  try
    Failing(label="Late")
  catch
    p.fallback Fallback
