--- <Value extends string | number, Empty extends string | boolean | undefined = undefined>
import type { JSX } from 'kay'
import { recipe, untrack } from 'kay'
import { controlledValue } from './controlled-value'
import { startRef } from './form-reset'
import { wording } from 'kay/words'

const look = recipe({ parts: { root: 'kui-field-input' } })

const { value, options, onChange, submit = false, emptyOption, loading = false, loadingLabel = wording('ui.select.loadingLabel', 'Loading…'), onBlur, onKeyDown, onPointerDown, ...rest } = props<Omit<JSX.IntrinsicElements['select'], 'value' | 'options' | 'class' | 'children' | 'onChange'> & {
  // One of the options' values, or the empty string once there is an `emptyOption`.
  value: Value | (Empty extends string | true ? '' : never)
  // `disabled` keeps that option from being picked. A native option draws no icon, so it has none.
  options: readonly { value: Value, label: string, disabled?: boolean | undefined }[]
  // Handed the option's own value, a number for a number option, or the empty string for the `emptyOption`.
  onChange?: ((value: Value | (Empty extends string | true ? '' : never)) => void) | undefined
  // Submits the form holding it once an option is picked, after `onChange`: a GET filter form then needs no ref to itself. A pick by keyboard, which some browsers report on each arrow key, waits for Enter or for the select to lose focus.
  submit?: boolean | undefined
  // A first option worth the empty string: a string is its label, `true` leaves it blank.
  emptyOption?: Empty
  // Shows a disabled row saying the options are on their way.
  loading?: boolean | undefined
  loadingLabel?: string | undefined
}>()

let box: HTMLSelectElement | undefined

// The options carry the value to the select, so only what the app last handed is kept; a reset that changes the select has the app's `onChange` told, without submitting.
const { heard } = controlledValue({ box: () => box, value: () => String(value), write: false, report: select => report(select) })

function report(select: HTMLSelectElement) {
  heard(select.value)

  const choice = options.find(option => String(option.value) === select.value)

  // No option matches only the empty one, which the type allows exactly when there is one.
  onChange?.(choice === undefined ? '' as never : choice.value)
}

// The keys that open the list: what is picked in it then arrives as one change, so it submits at once.
const OPENERS = new Set([' ', 'F4'])

// Whether the last key went to the select since the last pointer press, and a keyboard pick still waiting for Enter or blur.
let keyed = false
let waiting = false

function submitNow(select: HTMLSelectElement) {
  waiting = false
  select.form?.requestSubmit()
}

function picked(select: HTMLSelectElement) {
  report(select)

  if (!submit)
    return

  if (keyed)
    waiting = true
  else
    submitNow(select)
}

function pressed(event: KeyboardEvent & { currentTarget: HTMLSelectElement }) {
  onKeyDown?.(event as never)

  if (event.key === 'Enter' && waiting && !event.defaultPrevented)
    submitNow(event.currentTarget)
  else if (event.key !== 'Enter')
    keyed = !OPENERS.has(event.key) && !(event.altKey && event.key.startsWith('Arrow'))
}

function grabbed(event: PointerEvent & { currentTarget: HTMLSelectElement }) {
  onPointerDown?.(event as never)
  keyed = false
}

function left(event: FocusEvent & { currentTarget: HTMLSelectElement }) {
  onBlur?.(event as never)

  if (waiting)
    submitNow(event.currentTarget)
}

const ref = startRef<HTMLSelectElement>(element => box = element, rest.ref)
---
// Each option says whether it is selected, so the right one stays chosen when the options arrive after the value.
select({...rest} ref={ref} onChange={event => picked(event.currentTarget)} onKeyDown={submit ? pressed : onKeyDown} onPointerDown={submit ? grabbed : onPointerDown} onBlur={submit ? left : onBlur})
  if emptyOption !== undefined && emptyOption !== false
    option(value="") {typeof emptyOption === 'string' ? emptyOption : ''}
  if loading
    option(value="" disabled) {loadingLabel}
  for choice of options key={choice.value}
    option(ref={element => element.toggleAttribute('selected', untrack(() => String(choice.value) === String(value)))} value={choice.value} disabled={choice.disabled} selected={String(choice.value) === String(value)}) {choice.label}
