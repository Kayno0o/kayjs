---
import '../app.css'
---
//- One of each box the keyline token sizes, written with its class whole so its rules ship.
main
  div#card.kui-card
    div#card-head.kui-card-head head
  div#row.kui-card-row row
  div#widget.kui-widget widget
  div#notice.kui-notice notice
  span#avatar.kui-avatar A
  button#button.kui-btn(type="button") button
  div#side-panel.kui-side-panel panel
  div#tooltip.kui-tooltip tip
  div#table-wrap.kui-table-wrap table
  div#section.kui-collapsible-section(data-boxed) section
  div#save-bar.kui-save-bar bar
  div#segmented.kui-segmented choices
  div#file-drop.kui-file-drop drop
  div#step.kui-pagination-step step
  div#chart-tooltip.kui-line-chart-tooltip chart
  span#chip-label.kui-chip-label chip
  ul#icon-grid.kui-icon-grid
  div#scatter-plot.kui-scatter-chart-plot plot
  div#cropper-stage.kui-image-cropper-stage stage
  span#toggle.kui-toggle-track
  div#table-filter.kui-table-filter filter
  div#table-selection.kui-table-selection selected
  div#narrow-table.kui-table-wrap(data-narrow="stack" style="width: 15rem")
    table.kui-table
      thead
        tr#narrow-head
          th.kui-table-head-cell
            button#sort-btn.kui-table-sort-btn(type="button") sort
  nav.kui-site-nav
    ul#site-nav-list.kui-site-nav-list(popover)
      li.kui-site-nav-link link
