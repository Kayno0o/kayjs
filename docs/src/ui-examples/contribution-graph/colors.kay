---
import ContributionGraph from '@kaynooo/kayjs-ui/contribution-graph.kay'
import type { ContributionDay } from '@kaynooo/kayjs-ui'

const start = Date.UTC(2026, 4, 4)
const days: ContributionDay[] = Array.from({ length: 70 }, (_, index) => ({
  day: new Date(start + index * 86_400_000).toISOString().slice(0, 10),
  intensity: (index * 53 % 13) / 12,
}))
---
.flex.flex-col.gap-4
  ContributionGraph(days={days} color="var(--color-kui-success)" today="2026-06-20")
  ContributionGraph(days={days} color="var(--color-kui-error)" today="2026-06-20")
