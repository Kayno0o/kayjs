--- server
import { wording } from 'kay/words'
import Message from '../../components/message.kay'
import Panel from '../../components/panel.kay'
import { schemas, scopeLabel } from '../../forms'
import Button from '@kaynooo/kayjs-ui/button.kay'

// Visitors reach this page before signing in, so none of the app's guards run here, whatever they check: one asking for a session would keep an MCP client out.
export const page = { guards: false }

const FIELDS = ['client_id', 'redirect_uri', 'response_type', 'code_challenge', 'code_challenge_method', 'scope', 'state', 'resource', 'prompt'] as const

// The answer is checked again as the request is, so a form edited by hand gets no more than the request could.
export const decide = action(schemas.oauthConsent, async ({ decision, ...fields }, ctx) => {
  const result = await ctx.locals.auth.oauthDecide({ ...fields, scope: fields.scope === '' ? undefined : fields.scope, state: fields.state === '' ? undefined : fields.state, resource: fields.resource === '' ? undefined : fields.resource }, decision === 'allow')

  return result.ok ? ctx.redirect(result.redirect) : ctx.fail(400, { error: result.error })
})

const auth = ctx.locals.auth
const refused = decide.failed()?.data?.error
const request: Parameters<typeof auth.oauthAuthorize>[0] = {}

for (const field of FIELDS) {
  const value = ctx.url.searchParams.get(field)

  if (value !== null)
    request[field] = value
}

const resources = ctx.url.searchParams.getAll('resource')

if (resources.length > 1)
  request.resource = resources

const outcome = refused ? undefined : await auth.oauthAuthorize(request)

if (outcome?.kind === 'sign-in')
  ctx.redirect(auth.signInUrl())

if (outcome?.kind === 'redirect')
  ctx.redirect(outcome.url)

const problem = refused ?? (outcome?.kind === 'error' ? outcome.error : undefined)
const words = {
  'client': ['client', 'This app is not known to this site, so nothing was shared with it.'],
  'redirect_uri': ['redirectUri', 'This app asked to come back to an address it did not register, so nothing was shared with it.'],
  'signed-out': ['signedOut', 'You are signed out: start again from the app.'],
} as const
---
head
  title {wording('auth.consent.title', 'Allow access')}
  meta(name="robots" content="noindex")
Panel(title={wording('auth.consent.title', 'Allow access')})
  if problem
    Message(text={wording(`auth.consent.${words[problem][0]}`, words[problem][1])})
  else if outcome?.kind === 'consent'
    p {wording('auth.consent.intro', '{client} wants to use your account.', { client: outcome.client.name })}
    if outcome.client.host
      p.text-kui-muted {wording('auth.consent.from', 'This app lives at {host}. Only continue if you started this sign-in.', { host: outcome.client.host })}
    p.text-kui-muted {wording('auth.consent.returnsTo', 'After you decide, you go back to {host}.', { host: outcome.redirectHost })}
    p {wording('auth.consent.scopes', 'It will be allowed to')}
    ul.list-disc.pl-5
      if outcome.scopes === null
        li {wording('auth.consent.everything', 'Do everything you can do')}
      else if outcome.scopes.length === 0
        li {wording('auth.consent.noScopes', 'Identify you, with no access to the features that need a permission')}
      else
        for scope of outcome.scopes key={scope}
          li {scopeLabel(scope)}
    form.flex.flex-wrap.gap-3(action={decide})
      for field of Object.entries(outcome.fields) key={field[0]}
        input(type="hidden" name={field[0]} value={field[1]})
      Button(type="submit" name="decision" value="allow" tone="accent" label={wording('auth.consent.allow', 'Allow')})
      Button(type="submit" name="decision" value="deny" label={wording('auth.consent.deny', 'Deny')})
