---
import settings from './settings'
---
// A one-time or verification code: large, spaced, and selected whole by one click where the client allows it.
table(role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:24px 0")
  tr
    td(class="km-bg km-text" bgcolor={settings.background} style={`padding:12px 20px;background:${settings.background};border-radius:${settings.radius};font-family:${settings.mono};font-size:28px;line-height:1.2;font-weight:700;letter-spacing:6px;color:${settings.text};user-select:all`})
      slot
