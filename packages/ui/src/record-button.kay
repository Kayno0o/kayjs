---
import type { Duration, JSX } from 'kay'
import { durationMs, effect, recipe, untrack } from 'kay'
import { wording } from 'kay/words'
import Button from './button.kay'
import Notice from './notice.kay'
import type { RecordFailure, RecordStop } from './record'
import { elapsed, RECORD_LIMIT, recorder, recordWords } from './record'

// 'kui-record' stays as the component's name for an app's CSS. The variants are the Button's, handed to it.
const look = recipe({
  parts: {
    root: 'kui-record inline-flex flex-wrap items-center gap-2',
    button: '',
    time: 'text-sm text-muted tabular-nums',
    live: 'sr-only',
    problem: 'basis-full',
  },
  variants: {
    // As a Button's: `solid` is the framed button, `ghost` has no frame until hovered and `inline` reads as a link.
    variant: { solid: '', ghost: '', inline: '' },
    // As a Button's: `accent` for the main action.
    tone: { neutral: '', accent: '', success: '', warning: '', danger: '', info: '' },
    size: { xs: '', sm: '', md: '', lg: '' },
  },
  defaults: { variant: 'solid', tone: 'neutral', size: 'md' },
})

const { onRecord, onStart, onStop, onCancel, onError, recording, onRecordingChange, label = wording('ui.recordButton.label', 'Record'), failureLabel, maxDuration = RECORD_LIMIT, variant = 'solid', tone = 'neutral', size = 'md', ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'children' | 'onCancel' | 'onError'> & {
  // Takes what was said as a `File`, `recording.webm` (`recording.m4a` in Safari), which an action's `s.File()` field takes as it is. A promise it returns holds the button busy until it settles, and a rejection says `failure`.
  onRecord: (audio: File) => unknown
  // Called once the microphone is open and the recording runs: to dim the page, stop a player.
  onStart?: (() => unknown) | undefined
  // Called when the recording ends, before `onRecord`: `press` when the visitor stopped it, `limit` when `maxDuration` ran out.
  onStop?: ((reason: RecordStop) => unknown) | undefined
  // Called when Escape drops the recording.
  onCancel?: (() => unknown) | undefined
  // Called with `{ problem }`, why nothing was recorded, the code of the Notice shown (`denied`, `missing`, `taken`, `insecure`, `unsupported`, `failed`, `lost`, `empty`), or `send` with the rejection as `error` when `onRecord` rejected. The Notice still shows.
  onError?: ((failure: RecordFailure) => unknown) | undefined
  // Whether it records, set by the app: `true` starts a recording as a press would (and asks for the microphone), `false` stops it and hands it over. Left out, the button keeps it itself.
  recording?: boolean | undefined
  // Called with `true` as a recording starts (the microphone is asked for) and `false` once it is over, however it ended: stopped, cancelled, out of time, refused or lost.
  onRecordingChange?: ((recording: boolean) => unknown) | undefined
  // Names the button, which stays pressed while it records: a press starts, the next stops and hands the recording over, and Escape drops it.
  label?: string | undefined
  // Said when the promise of `onRecord` rejects.
  failureLabel?: string | undefined

  // How long a recording runs before it stops and is handed over as if pressed, `5m` by default, so one left running does not outgrow the action's `maxSize`.
  maxDuration?: Duration | undefined
}>()

const voice = recorder({ onAudio: audio => onRecord(audio), words: recordWords(), failure: failureLabel ?? wording('ui.recordButton.failure', 'The recording could not be sent.'), maxMs: durationMs(maxDuration), onStart, onStop, onCancel, onError, onRecordingChange })

// Follows `recording` when the app sets it; only its changes act, so a recording that ended on its own is not started again.
effect(() => {
  const wanted = recording

  if (wanted === undefined)
    return

  untrack(() => {
    if (wanted)
      void voice.start()
    else
      voice.stop()
  })
})

function key(event: KeyboardEvent) {
  // Drops the recording and nothing else, such as a dialog around the button closing.
  if (event.key === 'Escape' && voice.cancel())
    event.preventDefault()
}
---
div(part="root" {...rest})
  Button(part="button" variant={variant} tone={tone} size={size} icon={voice.state() === 'recording' ? 'stop' : 'microphone'} label={label} pressed={voice.state() === 'recording'} busy={voice.state() === 'asking' || voice.state() === 'sending'} onClick={voice.press} onKeyDown={key})
  // The time ticks every second, so it is shown and not read; the status region says when recording starts and stops.
  if voice.state() === 'recording'
    span(part="time" aria-hidden="true") {elapsed(voice.seconds())}
  span(part="live" role="status") {voice.said()}
  if voice.problem()
    Notice(part="problem" tone="danger" label={voice.problem()})
