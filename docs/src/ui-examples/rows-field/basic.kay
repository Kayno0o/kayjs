---
import RowsField from '@kaynooo/kayjs-ui/rows-field.kay'

const headers = signal([{ name: 'Cache-Control', value: 'no-store' }])
---
.flex.flex-col.items-stretch.gap-2
  RowsField(rows={headers()} columns={[{ key: 'name', label: 'Header' }, { key: 'value', label: 'Value' }]} label="Response headers" addLabel="Add header" onChange={headers.set})
  p.text-muted {headers().length} headers.
