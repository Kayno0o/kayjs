---
import type { JSX } from 'kay'

const { left, right, actions, class: className, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class'> & {
  // The leading element: a toggle, an icon, a colour dot.
  left?: JSX.Element
  // A trailing readout, always shown.
  right?: JSX.Element
  // Controls at the end of the row, dimmed until the row is hovered or focused.
  actions?: JSX.Element
  class?: string
}>()
---
// One line of a list drawn as cards: the children are its body, between what leads and what trails.
.kui-card-row({...rest} class={className})
  | {left}
  .kui-card-row-body
    slot
  | {right}
  if actions
    .kui-card-row-actions
      | {actions}
