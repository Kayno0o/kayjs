--- server
import { localPath } from 'kay'
import { localize, t } from 'kay/i18n'
import Captcha from '../components/captcha.kay'
import Message from '../components/message.kay'
import Panel from '../components/panel.kay'
import ProviderButtons from '../components/provider-buttons.kay'
import Separator from '../components/separator.kay'
import { captchaFor, captchaOf, guarded, issue, refusal, refusedFor, remembered, rememberOf, schemas } from '../forms'
import Button from '@kaynooo/kayjs-ui/button.kay'
import FormField from '@kaynooo/kayjs-ui/form-field.kay'

// Visitors reach this page before signing in, so none of the app's guards run here, whatever they check: one asking for a session would keep everyone out.
export const page = { guards: false }

export const register = action(schemas.register, async (input, ctx) => {
  const result = await ctx.locals.auth.register({ email: input.email, password: input.password, ...(input.username === undefined ? {} : { username: input.username }), remember: remembered(ctx.locals.auth.features(), input.remember), captcha: captchaOf(input), locale: ctx.locale })

  if (!result.ok)
    return ctx.fail(400, 'errors' in result ? { fields: result.errors } : { error: refusedFor(result.error, input) })

  if (!result.signedIn)
    return 'verify'

  return ctx.redirect(localPath(input.redirect, localize(ctx.locals.auth.features().pages?.home ?? '/')))
}, guarded)

const auth = ctx.locals.auth
const features = auth.features()

if (!features.signUp)
  ctx.notFound()

const prefix = features.pages?.prefix ?? features.prefix
const redirect = localPath(ctx.url.searchParams.get('redirect'), localize(features.pages?.home ?? '/'))
const user = await auth.user()

if (user && !user.guest)
  ctx.redirect(redirect)

const { askRemember, providerLinks } = rememberOf(features, redirect, provider => t('auth.signIn.provider', { provider }), features.providers)
const captcha = await captchaFor(auth, features.captcha, 'register')
const refused = ctx.failed(register)?.data
const fields = refused && 'fields' in refused ? refused.fields : {}
const error = refusal(ctx.failed(register), features.captcha)
const verify = ctx.succeeded(register) !== undefined
---
head
  title {t('auth.register.title')}
Panel(title={t('auth.register.title')})
  if verify
    Message(tone="success" text={t('auth.register.checkMail')})
  else
    if features.providers.length > 0
      .flex.flex-col.gap-2
        ProviderButtons(providers={providerLinks})
      Separator
    form.flex.flex-col.gap-3(action={register})
      input(type="hidden" name="redirect" value={redirect})
      FormField(label={t('auth.email')} issue={fields.email && issue('email', fields.email)} required)
        input(name="email" type="email" autocomplete="email" required)
      FormField(label={t('auth.password')} hint={t('auth.passwordHint', { min: features.rules.password.min })} issue={fields.password && issue('password', fields.password, features.rules)} required)
        input(name="password" type="password" autocomplete="new-password" minlength={features.rules.password.min} required)
      if askRemember
        label.flex.items-center.gap-2
          input(name="remember" type="checkbox")
          span {t('auth.remember')}
      if features.captcha && captcha.shown
        Captcha(widget={features.captcha} challenge={captcha.challenge})
      if error
        Message(text={error})
      Button(type="submit" tone="accent" label={t('auth.register.submit')})
  p.text-center
    | {t('auth.register.haveAccount')} #[a(href={localize(`${prefix}/sign-in?redirect=${encodeURIComponent(redirect)}`)}) {t('auth.register.signIn')}]
