---
import type { Denials } from '../access'
import type { ScreenCollection } from '../kay/contract'
import type { TrashScreen } from '../screens'
import Badge from '@kaynooo/kayjs-ui/badge.kay'
import ConfirmDelete from '@kaynooo/kayjs-ui/confirm-delete.kay'
import EmptyState from '@kaynooo/kayjs-ui/empty-state.kay'
import { refresh } from 'kay'
import { wording } from 'kay/words'
import { eraseDeleted, restoreDeleted } from '../editor/save'
import { shipWords } from '../editor/words'
import EntryEdited from './entry-edited.kay'
import Refused from './refused.kay'

// The entries deleted from a collection and still kept, newest first, each with a button that writes it back under its slug.
// `denied`, from `denials`, disables the erasure when the signed-in person's role may not delete.
const { collection, rows, denied = {} } = props<{ collection: ScreenCollection, rows: TrashScreen['rows'], denied?: Denials }>()

// Looks up what a restore says once the page has loaded, so the page sends it.
shipWords()

async function restore(id: string): Promise<void> {
  if (await restoreDeleted(collection.name, id))
    await refresh()
}

async function erase(row: TrashScreen['rows'][number]): Promise<void> {
  if (await eraseDeleted({ collection: collection.name, slug: row.slug, locale: row.locale }))
    await refresh()
}
---
if rows.length === 0
  EmptyState(title={wording('cms.trash.empty', 'The trash is empty')} description={wording('cms.trash.emptyHint', 'An entry deleted from here is kept for a while, so it can be brought back.')})
else
  ol.kcms-history
    for row of rows key={row.id}
      li.kcms-revision
        .kcms-revision-head
          strong {row.title}
          Badge(label={row.locale ? `${row.slug} (${row.locale})` : row.slug})
          span
            | {wording('cms.trash.deleted', 'Deleted')} 
            EntryEdited(at={row.at} moment author={row.author})
          ConfirmDelete(tone="neutral" trigger="button" label={wording('cms.history.restoreButton', 'Restore')} message={wording('cms.trash.restoreMessage', 'Restore {title}? It comes back under its slug.', { title: row.title })} failure={wording('cms.history.restoreFailure', 'Could not restore')} onConfirm={async () => { await restore(row.id) }})
          if denied.delete !== undefined
            Refused(label={wording('cms.trash.erase', 'Erase for good')} reason={denied.delete})
          else
            ConfirmDelete(trigger="button" label={wording('cms.trash.erase', 'Erase for good')} message={wording('cms.trash.eraseMessage', 'Erase {title} for good? It leaves the trash, its revisions and the activity log, and cannot come back.', { title: row.title })} failure={wording('cms.trash.eraseFailure', 'Could not erase')} onConfirm={async () => { await erase(row) }})
