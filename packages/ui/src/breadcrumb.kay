---
import { recipe } from 'kay'
import type { JSX, Snippet } from 'kay'
import type { NavItem } from './nav-item'
import BreadcrumbHead from './internal/breadcrumb-head.kay'
import Icon from './icon.kay'

// 'kui-breadcrumb' stays as the component's name for an app's CSS; the separators between items are drawn by theme.css. On a phone the middle of a long trail gives way to an ellipsis.
const look = recipe({
  parts: {
    root: 'kui-breadcrumb block',
    list: 'm-0 flex list-none flex-wrap items-center gap-x-2 gap-y-1 p-0 text-sm text-muted',
    more: 'hidden max-sm:list-item',
    item: 'max-sm:data-[middle]:hidden',
    link: 'text-muted underline-offset-2 hover:text-foreground hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent',
    text: 'aria-[current=page]:text-foreground',
    icon: 'mr-1 inline size-3.5 shrink-0 align-text-bottom',
  },
})

const { items, label, structured = false, item, ...rest } = props<Omit<JSX.IntrinsicElements['nav'], 'class' | 'children'> & {
  // The trail, the top of the site first and the page on screen last. Every item but the last is a link when it has an `href`; the last is marked as the current page and never a link.
  items: readonly (Pick<NavItem, 'label' | 'icon'> & { href?: string | undefined })[]
  // Draws the text of each item in place of its `label`: `@item(item)`, given the item. The `icon` it names is still drawn before it, and the structured data keeps the `label`.
  item?: Snippet<[item: Pick<NavItem, 'label' | 'icon'> & { href?: string | undefined }]> | undefined
  // Names the navigation for screen readers.
  label: string
  // Describes the trail to search engines as a `BreadcrumbList` in the head, each `href` made absolute by the site's origin (`site` in kay.config.ts, which it then needs).
  structured?: boolean | undefined
}>()

const last = items.length - 1
// From four items on, a phone keeps the first and the last two: the middle gives way to an ellipsis.
const collapses = items.length > 3
---
snippet inside(crumb: (typeof items)[number])
  if crumb.icon
    Icon(icon={crumb.icon} part="icon")
  if item
    slot item(crumb)
  else
    | {crumb.label}
// A list of links, the page on screen last: the separators are drawn by the style, so a screen reader hears the list and its length.
if structured
  BreadcrumbHead(items={items})
nav(part="root" {...rest} aria-label={label})
  ol(part="list")
    for crumb, index of items key={index}
      if collapses && index === 1
        li(part="more" aria-hidden="true") …
      li(part="item" data-middle={collapses && index > 0 && index < last - 1 ? '' : undefined})
        if index < last && crumb.href !== undefined
          a(part="link" href={crumb.href})
            | {inside(crumb)}
        else
          span(part="text" aria-current={index === last ? 'page' : undefined})
            | {inside(crumb)}
