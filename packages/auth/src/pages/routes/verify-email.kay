--- server
import { localize } from 'kay/i18n'
import { wording } from 'kay/words'
import Message from '../components/message.kay'
import Panel from '../components/panel.kay'
import { failure, schemas } from '../forms'
import Button from '@kaynooo/kayjs-ui/button.kay'
import FormField from '@kaynooo/kayjs-ui/form-field.kay'

// Visitors reach this page before signing in, so none of the app's guards run here, whatever they check: one asking for a session would keep everyone out.
// The link's token sits in the address, which no Referer header may carry to another site; `same-origin` still lets a form post carry its Origin.
export const page = { guards: false, security: { headers: { 'referrer-policy': 'same-origin' } } }

// The link only shows this button, so a mail scanner opening it spends nothing.
export const verify = action(schemas.verify, async ({ token, password }, ctx) => {
  const result = await ctx.locals.auth.verifyEmail(token, password)

  if (!result.ok)
    return ctx.fail(400, { error: result.error === 'invalid' ? 'link' : result.error })

  return ctx.redirect(localize(result.redirect))
})

export const code = action(schemas.emailCode, async ({ code }, ctx) => {
  const result = await ctx.locals.auth.verifyEmailCode(code)

  if (!result.ok)
    return ctx.fail(400, { error: result.error === 'invalid' ? 'code' : result.error })

  return ctx.redirect(localize(result.redirect))
})

export const resend = action(async (ctx) => {
  const result = await ctx.locals.auth.sendVerification()

  return result.ok ? 'sent' : ctx.fail(400, { error: result.error })
})

const auth = ctx.locals.auth
const token = ctx.url.searchParams.get('token') ?? verify.failed()?.values.token
const user = await auth.user()
const pending = await auth.emailCodePending()
const refused = verify.failed()?.data?.error
const codeError = code.failed()?.data?.error
const resendError = resend.failed()?.data?.error
const resent = resend.succeeded() !== undefined
---
head
  title {wording('auth.verify.title', 'Verify your address')}
Panel(title={wording('auth.verify.title', 'Verify your address')})
  if token
    form.flex.flex-col.gap-3(action={verify})
      input(type="hidden" name="token" value={token})
      if refused === 'confirm'
        p {wording('auth.verify.confirm', 'This link was opened in another browser: type your password to confirm it is you.')}
        FormField(label={wording('auth.password', 'Password')} required)
          input(name="password" type="password" autocomplete="current-password" required)
      else
        p {wording('auth.verify.intro', 'Press the button to verify your address.')}
        if refused
          Message(text={failure(refused)})
      Button(type="submit" tone="accent" label={wording('auth.verify.submit', 'Verify my address')})
  else if pending?.type === 'verify'
    form.flex.flex-col.gap-3(action={code})
      p {wording('auth.verify.codeIntro', 'Type the code mailed to {email}.', { email: pending.email })}
      FormField(label={wording('auth.code', 'Code')} required)
        input(name="code" inputmode="numeric" autocomplete="one-time-code" required)
      if codeError
        Message(text={failure(codeError)})
      Button(type="submit" tone="accent" label={wording('auth.verify.submit', 'Verify my address')})
  else if user?.email && !user.emailVerified
    form.flex.flex-col.gap-3(action={resend})
      p {wording('auth.verify.unverified', 'Your address {email} is not verified yet.', { email: user.email })}
      if resent
        Message(tone="success" text={wording('auth.verify.resent', 'A new link is on its way.')})
      if resendError
        Message(text={failure(resendError)})
      Button(type="submit" label={wording('auth.verify.resend', 'Mail me a new link')})
  else if user?.emailVerified
    Message(tone="success" text={wording('auth.verify.done', 'Your address is verified.')})
  else
    Message(text={failure('link')})
