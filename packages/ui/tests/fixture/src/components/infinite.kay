--- island
import { infiniteList } from '@kaynooo/kayjs-ui'
import LoadMore from '@kaynooo/kayjs-ui/load-more.kay'

const { first = [{ id: 1 }, { id: 2 }, { id: 3 }], size, onLoad, loadingLabel, failureLabel, retryLabel, button, expose } = props<{
  first?: { id: number }[]
  size: number
  onLoad: (offset: number) => Promise<{ id: number }[] | undefined>
  loadingLabel?: string
  failureLabel?: string
  retryLabel?: string
  button?: boolean
  expose?: (list: ReturnType<typeof infiniteList<{ id: number }>>) => void
}>()

const feed = infiniteList(first, { pageSize: size, key: row => row.id, load: ({ offset }) => onLoad(offset) })

expose?.(feed)
---
for row of feed.rows() key={row.id}
  p.row {row.id}
LoadMore(list={feed} loadingLabel={loadingLabel} failureLabel={failureLabel} retryLabel={retryLabel} button={button})
