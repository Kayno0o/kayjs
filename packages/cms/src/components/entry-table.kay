---
import type { Column } from '@kaynooo/kayjs-ui'
import type { ScreenCollection } from '../kay/contract'
import type { EntryRow } from '../listing'
import Badge from '@kaynooo/kayjs-ui/badge.kay'
import Button from '@kaynooo/kayjs-ui/button.kay'
import ConfirmDelete from '@kaynooo/kayjs-ui/confirm-delete.kay'
import EmptyState from '@kaynooo/kayjs-ui/empty-state.kay'
import Table from '@kaynooo/kayjs-ui/table.kay'
import { refresh } from 'kay'
import { wording } from 'kay/words'
import { deleteSaved, moveSaved, publishSaved, unpublishSaved } from '../editor/save'
import EntryStatus from './entry-status.kay'
import EntryWatch from './entry-watch.kay'
import { shipWords } from '../editor/words'
import { fieldsOf } from '../fields'
import { listColumns, rowActions } from '../layout'
import { deleteMessage, entryPath, onPagePath, problemId } from '../listing'
import { WATCHED_ROWS } from '../room'

const { prefix, collection, rows, searched } = props<{ prefix: string, collection: ScreenCollection, rows: EntryRow[], searched: boolean }>()

// Looks up what a save says once the page has loaded, so the page sends it.
shipWords()

// The columns and row actions the collection's layout names, all actions by default.
const shown = listColumns(fieldsOf(collection.schema), collection.layout?.list)
const actions = rowActions(collection.layout?.list)

// A field's column is keyed apart from the built-in ones, so a field named `title` or `actions` clashes with none.
const cellKey = (key: string | number) => `cell:${key}`

// Numbers sort by value, not by their text.
const sortKey = (kind: string, text = ''): string | number => kind === 'number' || kind === 'integer' ? Number(text) || 0 : text

const columns: Column<EntryRow>[] = [
  { key: 'title', header: wording('cms.table.title', 'Title'), sortValue: true, defaultDirection: 'asc', cell: true },
  ...shown.map(field => ({ key: cellKey(field.key), header: field.label, sortValue: (row: EntryRow) => sortKey(field.kind, row.cells?.[field.key]), cell: true }) satisfies Column<EntryRow>),
  ...(collection.localized ? [{ key: 'locale', header: wording('cms.table.locale', 'Locale'), sortValue: true } satisfies Column<EntryRow>] : []),
  ...(collection.draftField === undefined && collection.publishField === undefined ? [] : [{ key: 'draft', header: wording('cms.table.status', 'Status'), cell: true } satisfies Column<EntryRow>]),
  ...(actions.size === 0 ? [] : [{ key: 'actions', header: wording('cms.table.actions', 'Actions'), align: 'end', cell: true } satisfies Column<EntryRow>]),
]

const ref = (row: EntryRow) => ({ collection: collection.name, slug: row.slug, locale: row.locale })
const keyOf = (row: EntryRow) => row.locale === undefined ? row.slug : `${row.slug}@${row.locale}`
// Only the first rows of a page watch their entry.
const watched = (row: EntryRow) => rows.slice(0, WATCHED_ROWS).some(first => keyOf(first) === keyOf(row))

async function publish(row: EntryRow): Promise<void> {
  if (await publishSaved(ref(row)))
    await refresh()
}

async function unpublish(row: EntryRow): Promise<void> {
  if (await unpublishSaved(ref(row)))
    await refresh()
}

async function move(row: EntryRow, direction: 'up' | 'down'): Promise<void> {
  if (await moveSaved(ref(row), direction))
    await refresh()
}

async function remove(row: EntryRow): Promise<void> {
  if (await deleteSaved(ref(row), row.version))
    await refresh()
}
---
Table.kcms-entries(columns={columns} rows={rows} rowKey={keyOf})
  @cell(row, column)
    if column.key === 'title'
      // Why an entry is broken shows on the link too, so a keyboard reaches it and a screen reader reads it with the title.
      a(href={entryPath(prefix, ref(row))} data-tooltip={row.problem} aria-describedby={row.problem === undefined ? undefined : problemId(collection.name, keyOf(row))}) {row.title}
      if row.problem as problem
        Badge(tone="danger" label={wording('cms.table.broken', 'Broken')})
        span.kcms-sr-only(id={problemId(collection.name, keyOf(row))}) {problem}
      if watched(row)
        EntryWatch(collection={collection.name} entry={ref(row)})
    else if column.key.startsWith('cell:')
      span {row.cells?.[column.key.slice(5)] ?? ''}
    else if column.key === 'draft'
      if row.draft
        Badge(tone="warning" label={wording('cms.entry.draft', 'Draft')})
      else
        EntryStatus(at={row.scheduledAt})
    else
      .kcms-row-actions
        if actions.has('move')
          if row.move as place
            Button(label={wording('cms.table.moveUp', 'Up')} aria-label={wording('cms.table.moveUpLabel', 'Move {title} up', { title: row.title })} disabled={!place.up} onClick={() => move(row, 'up')})
            Button(label={wording('cms.table.moveDown', 'Down')} aria-label={wording('cms.table.moveDownLabel', 'Move {title} down', { title: row.title })} disabled={!place.down} onClick={() => move(row, 'down')})
        if actions.has('publish') && row.draft && collection.draftField !== undefined
          Button(label={wording('cms.entry.publish', 'Publish')} aria-label={wording('cms.table.publishLabel', 'Publish {title}', { title: row.title })} onClick={() => publish(row)})
        if actions.has('unpublish') && !row.draft && collection.draftField !== undefined
          ConfirmDelete(tone="neutral" trigger="button" label={wording('cms.table.unpublishLabel', 'Unpublish {title}', { title: row.title })} message={wording('cms.entry.unpublishMessage', 'Unpublish {title}? Visitors stop seeing it until you publish it again.', { title: row.title })} failure={wording('cms.entry.unpublishFailure', 'Could not unpublish')} onConfirm={() => unpublish(row)})
        if actions.has('editOnPage')
          if row.url as url
            Button(href={onPagePath(prefix, url)} label={wording('cms.entry.editOnPage', 'Edit on page')} aria-label={wording('cms.table.editOnPageLabel', 'Edit on page: {title}', { title: row.title })})
        if actions.has('delete')
          ConfirmDelete(message={deleteMessage(row.title, row.url, 'table', row.referencedBy)} label={wording('cms.table.deleteLabel', 'Delete {title}', { title: row.title })} failure={wording('cms.save.deleteFailure', 'Could not delete')} size="sm" variant="ghost" onConfirm={() => remove(row)})
  @empty
    if searched
      EmptyState(title={wording('cms.table.noMatch', 'No match')} description={wording('cms.table.noMatchHint', 'No entry\'s title or slug holds every word searched.')})
    else
      EmptyState(title={wording('cms.table.empty', 'No entries yet')})
