--- server
import { t } from 'elysia'
import { action } from 'kay'

export const check = action(t.Object({
  name: t.String({ minLength: 3 }),
  nick: t.String({ maxLength: 2 }),
  code: t.String({ pattern: '^x$' }),
  age: t.Numeric({ minimum: 18 }),
  own: t.String({ minLength: 3, error: 'Mine' }),
  req: t.String(),
}), () => undefined)

export const listed = action(t.Object({
  mail: t.String({ format: 'email' }),
  tags: t.Array(t.String(), { minItems: 2 }),
  extra: t.Array(t.String(), { maxItems: 1 }),
  slug: t.String({ pattern: '^x$', format: 'email' }),
  flag: t.BooleanString(),
  after: t.String({ pattern: '^[a-z]+$', format: 'email' }),
}), () => undefined)

export const guarded = action(t.Object({ website: t.Optional(t.String()) }), () => undefined, { honeypot: 'website', rateLimit: { max: 1, window: '1m' }, maxSize: 200 })

export const owned = action(t.Object({ website: t.Optional(t.String()) }), () => undefined, { honeypot: 'website', messages: { honeypot: 'Own words' } })

export const boom = action(t.Object({}), () => {
  throw new Error('down')
})
---
form(action={check})
  input(field="name")
  error name
  input(field="nick")
  error nick
  input(field="code")
  error code
  input(field="age")
  error age
  input(field="own")
  error own
  input(field="req")
  error req
  button Check
form(action={listed})
  input(field="mail")
  error mail
  input(field="tags")
  error tags
  input(field="extra")
  error extra
  input(field="slug")
  error slug
  input(field="flag")
  error flag
  input(field="after")
  error after
  button List
form(action={guarded})
  if guarded.error('website') as message
    p.refused {message}
  if guarded.error() as message
    p.whole {message}
  button Send
form(action={owned})
  if owned.error('website') as message
    p.refused {message}
  button Send
form(action={boom})
  if boom.error() as message
    p.refused {message}
  button Boom
