---
import { navigate, persisted } from 'kay'

const search = persisted.query('q', '')
---
input.search(aria-label="Search" value={search()} onInput={event => search = event.currentTarget.value})
p.searched Searched {search() || 'nothing'}
button.sort(name="sort" onClick={() => navigate({ query: { sort: 'name' } })}) Sort
