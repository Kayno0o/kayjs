---
import Badge from '@kaynooo/kayjs-ui/badge.kay'
---
.flex.flex-wrap.items-center.gap-2
  Badge(label="Draft" variant="solid")
  Badge(label="New" tone="accent" variant="solid")
  Badge(label="Live" tone="success" variant="solid")
  Badge(label="Expiring" tone="warning" variant="solid")
  Badge(label="Failed" tone="danger" variant="solid")
  Badge(label="Info" tone="info" variant="solid")
