---
import type { JSX, SearchHit, Snippet } from 'kay'
import type { PaletteAction, PaletteEntry, PaletteLink } from './palette'
import { effect, memo, onCleanup, recipe, searchResults, shortcut, signal, uid } from 'kay'
import { stepIndex } from './cycle'
import { startRef } from './form-reset'
import Icon from './icon.kay'
import { tabOf } from './outside'
import { isPaletteLink, paletteHits, paletteMatches, paletteSections, splitMatches, withRecent } from './palette'
import { wording } from 'kay/words'
import { labelText } from './label-text'

const DEBOUNCE_MS = 200

// 'kui-command-palette' stays as the component's name for an app's CSS and the always-hidden guard.
const look = recipe({
  parts: {
    root: 'kui-command-palette mx-auto mt-[10vh] mb-auto flex max-h-[min(70dvh,40rem)] w-full max-w-[min(36rem,calc(100vw-2rem))] flex-col overflow-hidden rounded-lg border-solid border-[length:var(--border-width)] border-border-strong bg-surface p-0 text-foreground',
    search: 'flex shrink-0 items-center gap-2 border-b border-border px-4',
    // The icon of the search line and of an option.
    icon: 'size-5 shrink-0 text-[var(--color-muted)]',
    input: 'h-11 min-w-0 flex-1 bg-transparent text-sm text-foreground outline-none placeholder:text-[var(--color-muted)] focus-visible:[outline:2px_solid_var(--color-accent)] focus-visible:[outline-offset:-2px]',
    list: 'min-h-0 flex-1 overflow-y-auto py-1',
    heading: 'px-4 pt-2 pb-1',
    // The tint alone is too faint to find, so an accent bar marks the option Enter opens; forced colours drop both and paint the transparent outline instead. One holding a section the site search found writes data-snippet, taller than the others.
    option: 'flex h-11 w-full cursor-pointer items-center gap-3 px-4 text-left text-sm text-foreground no-underline outline-none aria-selected:bg-hover aria-selected:[box-shadow:inset_2px_0_0_var(--color-accent)] aria-selected:[outline-offset:-2px] aria-selected:[outline:2px_solid_transparent] data-snippet:h-auto data-snippet:py-2',
    label: 'min-w-0 flex-1 truncate',
    group: 'max-w-[40%] shrink-0 truncate text-xs text-muted',
    shortcut: 'shrink-0 font-sans text-xs text-muted',
    text: 'flex min-w-0 flex-1 flex-col',
    snippet: 'line-clamp-2 text-xs text-muted',
    more: 'text-xs text-muted',
    mark: 'bg-transparent font-semibold text-accent',
    empty: 'px-4 py-6 text-center text-sm text-muted',
    count: 'sr-only',
  },
  variants: {
    // The width, the one vocabulary of every overlay: `md` is the default 36rem of a palette.
    size: {
      sm: { root: 'max-w-[min(28rem,calc(100vw-2rem))]' },
      md: '',
      lg: { root: 'max-w-[min(72rem,calc(100vw-2rem))]' },
      full: { root: 'max-w-[calc(100vw-2rem)]' },
    },
  },
  defaults: { size: 'md' },
})

const { open = false, onOpenChange, size = 'md', entries, groups = [], recent = [], onRecentChange, shortcut: keys, siteSearch = false, siteSearchLabel = wording('ui.commandPalette.siteSearch', 'In the pages'), siteSearchError = wording('ui.commandPalette.siteSearchError', 'The pages could not be searched'), label = wording('ui.commandPalette.label', 'Search'), placeholder = wording('ui.commandPalette.placeholder', 'Search'), emptyLabel = wording('ui.commandPalette.empty', 'No results'), empty, recentLabel = wording('ui.commandPalette.recent', 'Recent'), resultsLabel, siteSearchMore, search, searchLabel = wording('ui.commandPalette.search', 'Found'), searchError = wording('ui.commandPalette.searchError', 'The search failed'), ...rest } = props<Omit<JSX.IntrinsicElements['dialog'], 'class' | 'children' | 'open' | 'onClose' | 'closedby'> & {
  // Shows the palette; the shortcut opens and closes it too, and `onOpenChange` reports every change for a parent driving it.
  open?: boolean | undefined
  onOpenChange?: ((open: boolean) => unknown) | undefined
  entries: PaletteEntry[]
  // The order groups are listed in; the rest follow as they come.
  groups?: string[] | undefined
  // Hrefs of the links followed from it, most recent first, listed on top while the query is empty; `onRecentChange` hands the new list over for the app to keep.
  recent?: string[] | undefined
  onRecentChange?: ((recent: string[]) => unknown) | undefined
  // The keys that open and close it from anywhere, `mod+k` (Ctrl or Cmd with K) by default, unless something handled the key first; `false` or `null` leaves opening to the app. Written as kay's `shortcut` takes them.
  shortcut?: string | false | null | undefined
  // Searches the text of the site's pages too, as kay indexes them under `search: true`: a query lists the sections it finds, `limit` of them, after the entries it matches, under `siteSearchLabel`. Read once, as the palette is set up.
  siteSearch?: boolean | { limit?: number | undefined } | undefined
  siteSearchLabel?: string | undefined
  // Shown under the entries when the index could not load.
  siteSearchError?: string | undefined
  label?: string | undefined
  placeholder?: string | undefined
  emptyLabel?: string | undefined
  // Replaces the empty text with the app's own markup, such as a link to add the missing one: an `@empty` block.
  empty?: Snippet | undefined
  // The heading the recently followed links sit under.
  recentLabel?: string | undefined
  // How many rows a query lists, as screen readers hear it.
  resultsLabel?: string | ((count: number) => string) | undefined
  // How many more times a section found holds the words searched for, past the line shown.
  siteSearchMore?: ((count: number) => string) | undefined
  // Rows for a query the app looks up itself, such as a server's: called once typing pauses, with the query trimmed, and its rows are listed under `searchLabel` after the entries and the site's sections. An answer for an older query is dropped; a rejection shows `searchError`. An action works as is.
  search?: ((query: string) => PromiseLike<PaletteEntry[]>) | undefined
  searchLabel?: string | undefined
  searchError?: string | undefined
}>()

// A row of the list, numbered the way the arrow keys walk it; a section the site search found carries the line of text it was found in, and its heading's words found marked.
interface Row {
  entry: PaletteEntry
  index: number
  snippet?: SearchHit['snippet'] | undefined
  labelParts?: SearchHit['headingParts'] | undefined
  more?: number | undefined
  // Found by `search`, so not kept as recent.
  remote?: boolean | undefined
}

const id = uid()
const counted = (count: number) => resultsLabel === undefined ? wording('ui.commandPalette.results', count === 1 ? '1 result' : '{count} results', { count }) : labelText(resultsLabel, { count }, count)
const countedMore = (count: number) => (siteSearchMore ?? (found => wording('ui.commandPalette.siteSearchMore', found === 1 ? '1 more match' : '{count} more matches', { count: found })))(count)
const shown = signal(open)
const followedRecently = signal<string[]>(recent)
const query = signal('')
const selected = signal(0)
let dialog: HTMLDialogElement | undefined
const ref = startRef<HTMLDialogElement>(element => dialog = element, rest.ref)
const searching = siteSearch
const site = searching ? searchResults(query, searching === true ? {} : searching) : undefined
// The rows `search` answered, with the query they answer.
const answered = signal<{ query: string, entries: PaletteEntry[] } | undefined>(undefined)
const looking = signal(false)
const lookFailed = signal(false)
let request = 0

effect(() => shown = open)
effect(() => followedRecently = recent)

// Only the latest question lands: the answer to an older query is dropped.
async function lookUp(text: string, mine: number) {
  try {
    const entries = await search!(text)

    if (mine !== request)
      return

    answered = { query: text, entries }
  }
  catch (error) {
    if (mine !== request)
      return

    console.error('kayjs-ui: a CommandPalette could not run its search', error)
    lookFailed = true
  }

  looking = false
}

// The search waits for a pause in typing, and a new query drops the rows and the answer still on its way.
effect(() => {
  const text = query().trim()
  const mine = ++request

  answered = undefined
  lookFailed = false
  looking = Boolean(search) && text !== ''

  if (!search || !text)
    return

  const timer = setTimeout(() => void lookUp(text, mine), DEBOUNCE_MS)

  onCleanup(() => clearTimeout(timer))
})

// Headed groups while the query is empty, one flat ranked list once it is not, then the sections the site search found that no entry links already.
const sections = memo(() => {
  let index = 0
  const numbered = (members: PaletteEntry[]): Row[] => members.map(entry => ({ entry, index: index++ }))

  if (!query().trim())
    return paletteSections(entries, followedRecently(), groups, recentLabel).map(section => ({ group: section.group as string | null, rows: numbered(section.entries) }))

  const matches = paletteMatches(entries, query(), groups)
  const split = splitMatches(matches, query())
  const found = numbered(split.strong)
  const hits = paletteHits(site?.hits() ?? [], matches).map(hit => ({ entry: hit.link, index: index++, snippet: hit.snippet, labelParts: hit.labelParts, more: hit.more }))
  const answer = answered()
  const remote = answer?.query === query().trim() ? numbered(answer.entries).map(row => ({ ...row, remote: true })) : []
  const loose = numbered(split.loose)

  if (hits.length === 0 && remote.length === 0)
    return [{ group: null, rows: [...found, ...loose] }]

  return [
    { group: null, rows: found },
    ...hits.length > 0 ? [{ group: siteSearchLabel, rows: hits }] : [],
    ...remote.length > 0 ? [{ group: searchLabel, rows: remote }] : [],
    ...loose.length > 0 ? [{ group: null, rows: loose }] : [],
  ]
})

const rows = memo(() => sections().flatMap(section => section.rows))
// The highlighted row, kept within the list as hits arriving shorten it.
const active = memo(() => Math.min(selected(), Math.max(rows().length - 1, 0)))

const optionId = (index: number) => `${id}-option-${index}`

// A row's entry as the link or the action it is, for the template to draw each.
const linkOf = (entry: PaletteEntry) => isPaletteLink(entry) ? entry : undefined
const actionOf = (entry: PaletteEntry) => isPaletteLink(entry) ? undefined : entry

effect(() => {
  const current = active()

  if (shown())
    document.getElementById(optionId(current))?.scrollIntoView?.({ block: 'nearest' })
})

effect(() => {
  const wanted = shown()

  if (!dialog)
    return

  if (wanted && !dialog.open)
    dialog.showModal()
  else if (!wanted && dialog.open)
    dialog.close()
})

function setShown(next: boolean) {
  if (next === shown())
    return

  shown = next
  onOpenChange?.(next)
}

// A close event lands a task after the dialog closed, so one the shortcut has already reopened it past is stale.
function closed() {
  if (dialog?.open)
    return

  query = ''
  selected = 0
  setShown(false)
}

shortcut(() => keys === undefined ? 'mod+k' : keys || null, () => setShown(!(dialog?.open ?? shown())))

// A section the site search found is not kept as recent: the list only shows the entries' own links.
function followed(link: PaletteLink, found: boolean) {
  if (!found) {
    const next = withRecent(followedRecently(), link.href)

    followedRecently = next
    onRecentChange?.(next)
  }

  dialog?.close()
}

// Run once the palette has closed, so a dialog the action opens takes focus from the page rather than from a vanished palette.
function act(action: PaletteAction) {
  dialog?.close()
  action.onSelect()
}

function keyDown(event: KeyboardEvent) {
  const count = rows().length

  if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
    event.preventDefault()
    selected = stepIndex(active(), event.key === 'ArrowDown' ? 1 : -1, count)

    return
  }

  const row = rows()[active()]
  const entry = row?.entry

  if (event.key !== 'Enter' || !entry)
    return

  event.preventDefault()

  if (isPaletteLink(entry) && (event.ctrlKey || event.metaKey)) {
    // The rendered option's own href, which went through the script-URL guard that a bound attribute gets.
    const option = document.getElementById(optionId(active()))

    if (option instanceof HTMLAnchorElement)
      window.open(option.href, '_blank', 'noopener,noreferrer')

    followed(entry, row.snippet !== undefined || row.remote === true)

    return
  }

  // A real click on the link, so kay's navigation takes it as it takes any other.
  document.getElementById(optionId(active()))?.click()
}
---
dialog({...rest} part="root" data-size={size === 'md' ? undefined : size} ref={ref} closedby="any" aria-label={label} onClose={closed})
  if shown()
    div(part="search")
      Icon(icon="search" part="icon")
      input(part="input" value={query()} onInput={event => { query = event.currentTarget.value; selected = 0 }} onKeyDown={keyDown} role="combobox" aria-label={label} aria-expanded="true" aria-controls={`${id}-list`} aria-autocomplete="list" aria-activedescendant={rows()[active()] ? optionId(active()) : undefined} autocomplete="off" spellcheck="false" placeholder={placeholder})
    div(part="list" id={`${id}-list`} role="listbox" aria-label={label})
      for section, sectionIndex of sections() key={sectionIndex}
        div(part="section" role="group" aria-labelledby={section.group === null ? undefined : `${id}-group-${sectionIndex}`})
          if section.group !== null
            div.kui-heading-section(part="heading" id={`${id}-group-${sectionIndex}`}) {section.group}
          for row of section.rows key={row.index}
            if linkOf(row.entry) then link
              a(part="option" data-snippet={row.snippet ? '' : undefined} href={link.href} {...tabOf(link.href, link.newTab ?? (link.external ? true : undefined))} id={optionId(row.index)} role="option" aria-selected={row.index === active() ? 'true' : 'false'} tabindex="-1" onPointerMove={() => selected = row.index} onClick={() => followed(link, row.snippet !== undefined || row.remote === true)})
                if link.icon then icon
                  Icon(icon={icon} part="icon")
                if row.snippet then snippet
                  span(part="text")
                    span(part="label")
                      for part, partIndex of row.labelParts ?? [{ text: row.entry.label, hit: false }] key={partIndex}
                        if part.hit
                          mark(part="mark") {part.text}
                        else
                          | {part.text}
                    span(part="snippet")
                      for part, partIndex of snippet key={partIndex}
                        if part.hit
                          mark(part="mark") {part.text}
                        else
                          | {part.text}
                    if row.more then more
                      span(part="more") {countedMore(more)}
                else
                  span(part="label") {row.entry.label}
                if query().trim() && row.entry.group
                  span(part="group") {row.entry.group}
                if row.entry.shortcut
                  kbd(part="shortcut") {row.entry.shortcut}
            else if actionOf(row.entry) then action
              button(part="option" type="button" id={optionId(row.index)} role="option" aria-selected={row.index === active() ? 'true' : 'false'} tabindex="-1" onPointerMove={() => selected = row.index} onClick={() => act(action)})
                if action.icon then icon
                  Icon(icon={icon} part="icon")
                span(part="label") {row.entry.label}
                if query().trim() && row.entry.group
                  span(part="group") {row.entry.group}
                if row.entry.shortcut
                  kbd(part="shortcut") {row.entry.shortcut}
      if site?.error() && query().trim()
        p(part="empty") {siteSearchError}
      else if lookFailed() && query().trim()
        p(part="empty") {searchError}
      else if rows().length === 0 && !site?.loading() && !looking()
        p(part="empty")
          if empty
            | {empty}
          else
            | {emptyLabel}
    p(part="count" role="status") {query().trim() && !site?.loading() && !looking() ? counted(rows().length) : ''}
