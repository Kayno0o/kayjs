---
import { signal } from 'kay'
import Slider from '@kaynooo/kayjs-ui/slider.kay'

// A Slider the page keeps in a signal, one it formats, one it hides the value of, and a second form field to prove the name posts.
const { onInput, onChange } = props<{ onInput?: (value: number) => void, onChange?: (value: number) => unknown }>()

const delay = signal(40)
---
form#form
  Slider#delay(label="Delay" name="delay" min={0} max={100} step={10} value={delay()} formatValue={value => `${value} ms`} onInput={(value: number) => { delay.set(value); onInput?.(value) }} onChange={onChange})
  Slider#locked(label="Locked" name="locked" min={0} max={10} value={5} disabled)
  Slider#quiet(label="Quiet" name="quiet" min={0} max={10} value={3} showValue={false})
  button#set(type="button" onClick={() => delay.set(80)}) Set
  button#reset(type="reset") Reset
  p#state {delay()}
