---
import DateRangeInput from '@kaynooo/kayjs-ui/date-range-input.kay'
import type { DateRange } from '@kaynooo/kayjs-ui'

const stay = signal<DateRange>(['2026-10-02', null])
---
.flex.flex-col.items-start.gap-2
  DateRangeInput(label="Stay" value={stay()} onChange={stay.set})
  p.text-kui-subtext0 From {stay()[0] ?? 'any day'} to {stay()[1] ?? 'any day'}.
