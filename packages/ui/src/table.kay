--- module
// What turns a use of the Table into an island, each prop with whether it is on when left out: a page or a server component drawing it with none of them on, and passing no function, gets plain markup and no script.
export const island = { interactive: { sortable: true, filter: false, filterParam: false, fields: false, selectable: false, exportable: false, columnToggle: false, expandable: false, pageSize: false, rowHref: false, onRowClick: false, virtual: false, sortParam: false, list: false } } as const
--- <Row, Key extends RowKey<Row>>
import type { JSX, Snippet } from 'kay'
import type { InfiniteList } from './infinite-list'
import type { RowsSource } from './source'
import type { Column, FilterField, RowFilter, RowKey, RowKeyValue, SortState } from './table'
import { effect, memo, onCleanup, onMount, persisted, recipe, signal, uid } from 'kay'
import Button from './button.kay'
import Checkbox from './checkbox.kay'
import Icon from './icon.kay'
import IconButton from './icon-button.kay'
import LoadMore from './load-more.kay'
import Pagination from './pagination.kay'
import { followList } from './table-list'
import { paging } from './table-page'
import { selection } from './table-select'
import { tableFilter } from './table-filter'
import { expanding } from './table-expand'
import { downloadCsv } from './table-export'
import { uses } from './uses'
import Popover from './popover.kay'
import Select from './select.kay'
import { cellText, columnStyle, drawnByBlock, exportHref, nextSort, resolvedColumn, restoredSort, rowKeyOf, rowLabel, rowsMatching, sortedRows } from './table'
import { asyncRows } from './source'
import { virtualRows } from './virtual'
import { wording } from 'kay/words'

// 'kui-table-wrap' stays as the component's name for an app's CSS. The narrow form is a container named `table`, which its parts read with `@max-[30rem]/table:`; the name carries no `kui-` prefix so no old rule keeps its class alive.
const look = recipe({
  parts: {
    root: 'kui-table-wrap group/table w-full overflow-x-auto border-solid border-[length:var(--border-width)] border-border bg-surface data-[narrow=stack]:@container/table data-virtual:overflow-y-auto data-virtual:max-h-[var(--table-height,70vh)] data-virtual:[overflow-anchor:none] data-virtual:focus-visible:outline-2 data-virtual:focus-visible:-outline-offset-2 data-virtual:focus-visible:outline-accent',
    caption: 'sr-only',
    table: 'aria-busy:opacity-60 w-full border-collapse text-sm group-data-[narrow=stack]/table:[overflow-wrap:anywhere] @max-[30rem]/table:block',
    // Below 30rem of width the rows of a stacked table become cards and its headers one row of sort buttons, the only part of the head that stays. Each card draws its own top line instead of the row's bottom border, so an app dropping the row borders of the wide table still sees the cards apart.
    head: '@max-[30rem]/table:has-[[data-part=sortButton]]:block @max-[30rem]/table:group-data-virtual/table:sticky @max-[30rem]/table:group-data-virtual/table:top-0 @max-[30rem]/table:group-data-virtual/table:z-2 @max-[30rem]/table:group-data-virtual/table:bg-surface @max-[30rem]/table:not-has-[[data-part=sortButton]]:hidden',
    headRow: '@max-[30rem]/table:flex @max-[30rem]/table:flex-wrap @max-[30rem]/table:gap-2 @max-[30rem]/table:border-solid @max-[30rem]/table:border-b-[length:var(--border-width)] @max-[30rem]/table:border-border @max-[30rem]/table:px-3 @max-[30rem]/table:py-2',
    body: '@max-[30rem]/table:block',
    headCell: 'border-b border-border px-3 py-2 text-left text-xs [font-weight:var(--font-weight-normal)] tracking-label text-muted [font-family:var(--font-label,inherit)] [text-transform:var(--label-case)] data-[align=center]:text-center data-[align=end]:text-right aria-[sort=ascending]:text-accent aria-[sort=descending]:text-accent group-data-virtual/table:sticky group-data-virtual/table:top-0 group-data-virtual/table:z-2 group-data-virtual/table:bg-surface @max-[30rem]/table:border-0 @max-[30rem]/table:p-0 @max-[30rem]/table:not-has-[[data-part=sortButton]]:hidden w-[var(--column-width,auto)] min-w-[var(--column-min-width,0)] @max-[30rem]/table:w-auto @max-[30rem]/table:min-w-0 data-[sticky]:z-[1] data-[sticky]:bg-surface data-[sticky=start]:sticky data-[sticky=start]:left-0 data-[sticky=end]:sticky data-[sticky=end]:right-0 @max-[30rem]/table:data-[sticky]:static',
    selectText: 'sr-only',
    foot: '@max-[30rem]/table:block',
    footRow: '@max-[30rem]/table:flex @max-[30rem]/table:flex-wrap @max-[30rem]/table:gap-2 @max-[30rem]/table:px-3 @max-[30rem]/table:py-2',
    footCell: 'border-t border-border px-3 py-2 text-sm text-foreground data-[numeric]:tabular-nums data-[align=center]:text-center data-[align=end]:text-right w-[var(--column-width,auto)] min-w-[var(--column-min-width,0)] @max-[30rem]/table:w-auto @max-[30rem]/table:min-w-0 data-[sticky]:z-[1] data-[sticky]:bg-surface data-[sticky=start]:sticky data-[sticky=start]:left-0 data-[sticky=end]:sticky data-[sticky=end]:right-0 @max-[30rem]/table:data-[sticky]:static @max-[30rem]/table:border-0 @max-[30rem]/table:p-0 @max-[30rem]/table:empty:hidden',
    sortButton: 'group/sort inline-flex cursor-pointer items-center gap-1 border-0 bg-transparent p-0 text-inherit [font-family:var(--font-label,inherit)] [text-transform:var(--label-case)] @max-[30rem]/table:min-h-8 @max-[30rem]/table:border-solid @max-[30rem]/table:border-[length:var(--border-width)] @max-[30rem]/table:border-border @max-[30rem]/table:px-2 @max-[30rem]/table:py-0.5',
    sortIcon: 'size-3.5 group-data-[direction=asc]/sort:rotate-180',
    row: 'border-b border-border @max-[30rem]/table:border-b-0 @max-[30rem]/table:[:is([data-part=row],[data-part=detailRow])+&]:border-t hover:bg-hover aria-selected:bg-hover data-linked:relative data-linked:isolate data-linked:[&_:where(a,button,input,select,textarea,label,summary,[tabindex],[role=button]):not([data-part=rowLink],[data-part=rowButton])]:relative data-linked:[&_:where(a,button,input,select,textarea,label,summary,[tabindex],[role=button]):not([data-part=rowLink],[data-part=rowButton])]:z-1 @max-[30rem]/table:grid @max-[30rem]/table:grid-cols-[fit-content(40%)_minmax(0,1fr)] @max-[30rem]/table:gap-x-4 @max-[30rem]/table:px-3 @max-[30rem]/table:py-2',
    cell: 'px-3 py-1.5 text-foreground data-[numeric]:tabular-nums data-[align=center]:text-center data-[align=end]:text-right @max-[30rem]/table:col-span-full @max-[30rem]/table:grid @max-[30rem]/table:grid-cols-subgrid @max-[30rem]/table:items-baseline @max-[30rem]/table:px-0 @max-[30rem]/table:py-1 @max-[30rem]/table:data-[align]:text-left w-[var(--column-width,auto)] min-w-[var(--column-min-width,0)] @max-[30rem]/table:w-auto @max-[30rem]/table:min-w-0 data-[sticky]:z-[1] data-[sticky]:[tr:not(:hover,[aria-selected=true])>&]:bg-surface data-[sticky]:[tr:is(:hover,[aria-selected=true])>&]:bg-hover data-[sticky=start]:sticky data-[sticky=start]:left-0 data-[sticky=end]:sticky data-[sticky=end]:right-0 @max-[30rem]/table:data-[sticky]:static',
    // Outside a narrow table a cell holds its content alone: the column header names it.
    cellLabel: 'hidden @max-[30rem]/table:block @max-[30rem]/table:text-left [font-size:var(--text-2xs)] [line-height:var(--text-2xs--line-height)] [font-weight:var(--font-weight-normal)] tracking-label text-muted [font-family:var(--font-label,inherit)] [text-transform:var(--label-case)]',
    cellBody: 'contents @max-[30rem]/table:block @max-[30rem]/table:min-w-0 @max-[30rem]/table:[overflow-wrap:anywhere] @max-[30rem]/table:first:col-span-full',
    // A row standing for the rows still on their way, its bars pulsing.
    skeletonRow: 'border-b border-border @max-[30rem]/table:block @max-[30rem]/table:px-3 @max-[30rem]/table:py-2',
    skeletonCell: 'px-3 py-2.5 @max-[30rem]/table:block @max-[30rem]/table:px-0 @max-[30rem]/table:py-1',
    skeletonBar: 'block h-[1em] w-full animate-pulse bg-surface-strong motion-reduce:animate-none',
    status: 'sr-only',
    failure: 'flex flex-wrap items-center justify-center gap-3 px-3 py-4 text-sm',
    message: 'm-0',
    emptyCell: 'px-3 py-8 text-center text-xs text-muted @max-[30rem]/table:block',
    ...(uses('filter') || uses('filterParam') || uses('fields'))
      ? {
        // Sticky, so the filter and the selection bar stay in view while a wide table scrolls under them.
        filter: 'sticky left-0 flex flex-wrap items-center gap-x-4 gap-y-2 border-solid border-b-[length:var(--border-width)] border-border px-3 py-2',
        field: 'flex items-center gap-2',
        filterInput: 'w-56 max-w-full',
        count: 'sr-only',
      }
      : {},
    ...(uses('selectable') || uses('exportable') || uses('columnToggle'))
      ? {
        selection: 'sticky left-0 flex flex-wrap items-center gap-3 border-solid border-b-[length:var(--border-width)] border-border px-3 py-2 text-sm [&_.kui-checkbox]:min-h-6 [&_.kui-checkbox]:min-w-6',
      }
      : {},
    ...(uses('selectable'))
      ? {
        selected: 'm-0',
        bulk: 'flex flex-wrap items-center gap-2',
        selectHead: 'border-b border-border px-3 py-2 text-left text-xs [font-weight:var(--font-weight-normal)] tracking-label text-muted [font-family:var(--font-label,inherit)] [text-transform:var(--label-case)] data-[align=center]:text-center data-[align=end]:text-right aria-[sort=ascending]:text-accent aria-[sort=descending]:text-accent group-data-virtual/table:sticky group-data-virtual/table:top-0 group-data-virtual/table:z-2 group-data-virtual/table:bg-surface @max-[30rem]/table:border-0 @max-[30rem]/table:p-0 @max-[30rem]/table:not-has-[[data-part=sortButton]]:hidden w-0 @max-[30rem]/table:w-auto',
        // The box is 1rem, so its label grows to the 1.5rem a finger needs.
        selectCell: 'px-3 py-1.5 text-foreground data-[numeric]:tabular-nums data-[align=center]:text-center data-[align=end]:text-right @max-[30rem]/table:col-span-full @max-[30rem]/table:grid @max-[30rem]/table:grid-cols-subgrid @max-[30rem]/table:items-baseline @max-[30rem]/table:px-0 @max-[30rem]/table:py-1 @max-[30rem]/table:data-[align]:text-left w-0 @max-[30rem]/table:w-auto [&_.kui-checkbox]:min-h-6 [&_.kui-checkbox]:min-w-6 [&_.kui-checkbox]:justify-center',
      }
      : {},
    ...(uses('columnToggle'))
      ? {
        columnsPanel: 'flex flex-col gap-1 p-3',
      }
      : {},
    ...(uses('expandable'))
      ? {
        toggleHead: 'border-b border-border px-3 py-2 text-left text-xs w-0 @max-[30rem]/table:hidden',
        toggleCell: 'px-3 py-1.5 w-0 @max-[30rem]/table:w-auto @max-[30rem]/table:col-span-full @max-[30rem]/table:px-0 @max-[30rem]/table:py-1',
        // The chevron turns over while the row is open.
        toggle: 'aria-expanded:[&_svg]:rotate-180',
        // The detail stands under its row across every column, and under its card in the narrow form.
        detailRow: 'border-b border-border @max-[30rem]/table:block @max-[30rem]/table:border-b-0',
        detailCell: 'px-3 py-3 text-foreground @max-[30rem]/table:block @max-[30rem]/table:px-3 @max-[30rem]/table:pt-0',
      }
      : {},
    ...(uses('pageSize'))
      ? {
        // The Pagination under the rows of a table with a `pageSize`, kept in view like the filter bar.
        pager: 'sticky left-0 border-solid border-t-[length:var(--border-width)] border-border px-3 py-2',
      }
      : {},
    ...(uses('rowHref') || uses('onRowClick'))
      ? {
        // A row that is a link or a button: the first cell holds an anchor or a button stretched over the whole row.
        rowLink: 'absolute inset-0 z-0 m-0 block h-full w-full cursor-pointer border-0 bg-transparent p-0 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-accent',
        rowButton: 'absolute inset-0 z-0 m-0 block h-full w-full cursor-pointer border-0 bg-transparent p-0 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-accent',
      }
      : {},
    ...(uses('virtual'))
      ? {
        // The rows standing for those a virtual table does not draw.
        spacer: '@max-[30rem]/table:block',
      }
      : {},
  },
})

const { columns: given, label, header, footer, columnToggle = false, columnsLabel = wording('ui.table.columns', 'Columns'), hiddenColumns, onHiddenColumnsChange, onScrollChange, rows: passed, list, rowKey, sort, sortable = true, serverSort = false, onSort, cell, empty, emptyLabel = wording('ui.table.empty', 'No rows.'), filter, fields, filterLabel = wording('ui.table.filter', 'Filter'), filterPlaceholder, filterParam, sortParam, countLabel, noMatch, narrow = 'stack', selectable = false, selected, onSelectedChange, bulk, selectAllLabel = wording('ui.table.selectAll', 'Select all'), selectedLabel, selectRowLabel, exportable = false, exportLabel = wording('ui.table.export', 'Export CSV'), exportName = 'table.csv', busy = false, skeletonRows = 5, loadingLabel = wording('ui.table.loading', 'Loading…'), failureLabel = wording('ui.table.failure', 'Could not load the rows.'), retryLabel = wording('ui.table.retry', 'Try again'), onLoad, onError, rowHref, onRowClick, openRowLabel, pageSize, pageSizes, page, pageParam = 'page', limitParam = 'limit', onPageChange, virtual = false, expandable = false, expanded, onOpenChange, detail, expandLabel, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'children' | 'onSelect' | 'onToggle' | 'onLoad' | 'onError'> & {
  columns: Column<Row>[]
  // The rows to draw: an array, a function returning them, or a promise of them. An array is drawn by the server; a function is called in the browser only (it may touch `window`, and the server draws the skeleton), and so is a promise's answer, skeleton rows standing in meanwhile; a refresh keeps the rows shown, then a failure row with a retry (a function is called again) if it rejects. Left out when `list` holds them: one of the two is required.
  rows?: RowsSource<Row> | undefined
  // Rows loaded page by page, from `infiniteList`: the table draws its rows with `LoadMore` after them, and a header click sorts on the server, the list starting over from offset 0 with the sort passed to its `load` (and to `onSort` too). The columns to sort by carry a `sortValue` (`numeric` ones have it), which only marks them sortable here. The table's own sort, from `sort` or the URL, is sent to the list too. A sort restarts the list, so a selected row outside the first page leaves the selection. The list loads again from offset 0 when the table's sort differs from the `sort` the list was made with, on mount included, so give `infiniteList` the same `sort` the table starts from to keep the first page. `exportable` as `true` exports the rows loaded so far; give it an endpoint to export them all.
  list?: InfiniteList<Row> | undefined
  rowKey: Key
  // The sort to start from; a table whose parent passes a new one follows it.
  sort?: SortState | undefined
  // `false` leaves every header unsortable, `numeric` columns included, for rows the page holds only a part of, which a header click would sort alone.
  sortable?: boolean | undefined
  // Rows already sorted by the data source: the table reflects the sort in its headers and never reorders them itself.
  serverSort?: boolean | undefined
  // Called with each sort a header click asks for, to fetch the rows sorted that way when `serverSort` is set.
  onSort?: ((sort: SortState) => unknown) | undefined
  // Names the table for screen readers, as a caption only they see, and its scroll box when it scrolls, unless an `aria-label` names that already.
  label?: string | undefined
  // Draws a column's header in place of its `header` text: `@header(column)`. A sortable column keeps its sort button around it, and a stacked card's label stays the text.
  header?: Snippet<[column: Column<Row>]> | undefined
  // Draws a column's line of the foot in place of its `footer` text: `@footer(column)`. With the block, every column that is shown has a foot cell.
  footer?: Snippet<[column: Column<Row>]> | undefined
  // A button above the rows opening a list of checkboxes that show and hide each column that has a `header`.
  columnToggle?: boolean | undefined
  // Names the column toggle's button.
  columnsLabel?: string | undefined
  // The keys of the columns hidden, replacing each column's `hidden`; a table whose parent passes another list follows it.
  hiddenColumns?: string[] | undefined
  // Called with the keys of the columns hidden each time the reader shows or hides one.
  onHiddenColumnsChange?: ((keys: string[]) => unknown) | undefined
  // Called with whether the table now scrolls, when that changes: its box takes the focus then, to scroll by keyboard.
  onScrollChange?: ((scrolls: boolean) => unknown) | undefined
  // Draws the cells of the columns it covers, see `Column.cell`.
  cell?: Snippet<[row: Row, column: Column<Row>]> | undefined
  // Shown in place of the rows when there are none.
  empty?: Snippet
  // A search box above the rows, keeping those where a value it reads holds the typed text: the row's fields named, or what a function of the row returns. For a table over a `list` the rows are the server's to filter: the text goes to the list's `load` as `filter.text` (the list starting over from offset 0 after a pause in typing, as it does for a sort) and `filter` only has to be there to show the box.
  filter?: RowFilter<Row> | undefined
  // Extra fields beside the search box of a table over a `list`, each a text box or, with `options`, a select, whose value goes to the list's `load` as `filter.fields[key]` and to the page's URL under `key`, so a reload or a shared link filters the same. The list starts over from offset 0 when one changes. Decided once, when the table is made.
  fields?: readonly FilterField[] | undefined
  // Names the search box.
  filterLabel?: string | undefined
  filterPlaceholder?: string | undefined
  // The query parameter keeping the typed text in the page's URL, so a reload or a shared link filters the same; without it the text stays on the page.
  filterParam?: string | undefined
  // The query parameter keeping the sort a header click picks in the page's URL, the column's key under it and its direction under `direction` (`<name>Direction` for any name but `sort`), so a reload, a shared link or back and forward sort the same; a click replaces the history entry. The URL's sort wins over `sort` on load.
  sortParam?: string | undefined
  // How many rows the filter keeps, as screen readers hear it.
  countLabel?: ((count: number) => string) | undefined
  // What the table reads with no rows, `No rows.` by default; `empty` replaces it with the app's own markup.
  emptyLabel?: string | undefined
  // Shown in place of the rows when the filter hides every one; `empty` otherwise.
  noMatch?: Snippet
  // Below 30rem of width, rows stack as cards labelled by their headers, or the table scrolls sideways.
  narrow?: 'stack' | 'scroll' | undefined
  // A checkbox on each row and, above the rows, a tri-state select-all beside the count of rows picked, in the stacked cards as in the wide table.
  selectable?: boolean | undefined
  // The keys of the rows picked to start from, as `rowKey` reads them; a table whose parent passes another list follows it. A key whose row is no longer in `rows` leaves the selection.
  selected?: RowKeyValue<Row, Key>[] | undefined
  // Called with the keys picked, as `selected` takes them, and the rows they stand for, both in the rows' order, each time the selection changes, a row leaving `rows` included.
  onSelectedChange?: ((keys: RowKeyValue<Row, Key>[], rows: Row[]) => unknown) | undefined
  // Drawn beside the count while something is picked, with the keys and a function emptying the selection: the page's bulk actions.
  bulk?: Snippet<[keys: RowKeyValue<Row, Key>[], clear: () => void]> | undefined
  // Names the select-all box, and the column's header for screen readers.
  selectAllLabel?: string | undefined
  // The count of rows picked, read out as it changes: `N selected`.
  selectedLabel?: ((count: number) => string) | undefined
  // Names a row's box: `Select <first column's text>`.
  selectRowLabel?: ((row: Row) => string) | undefined
  // A button above the rows downloading them as CSV, the headers on top and the cells as the rows hold them, with the filter and the sort on screen applied. A string is the address of an endpoint to download from instead, for rows the page holds only a part of: it gets the sort as `sort` and `direction` and the typed filter text under `filterParam` (`q` without one), and answers with `toCsv(rows, columns)`.
  exportable?: boolean | string | undefined
  // Names the export button.
  exportLabel?: string | undefined
  // The file name the download is saved as.
  exportName?: string | undefined
  // Draws only the rows in view, between room standing for the others, so a table of ten thousand rows and more stays as light as a short one. The table scrolls in a box of its own (`--table-height`, 70vh by default) with its headers kept on top. Decided once, when the table is made. The server draws the first screenful, so the rest shows once the page loads its script. Find-in-page sees the drawn rows alone, and a focused row that scrolls out of the window loses its focus. Name the scroll box with an `aria-label`.
  virtual?: boolean | undefined
  // A toggle on each row opening the `@detail(row)` block in a full-width row under it, or under its card when stacked. Closed to start; it cannot be combined with `virtual`, whose rows all share one height.
  expandable?: boolean | undefined
  // The keys of the rows open to start from, as `rowKey` reads them; a table whose parent passes another list follows it.
  expanded?: RowKeyValue<Row, Key>[] | undefined
  // Called with a row's key and whether it is now open, each time a toggle is used.
  onOpenChange?: ((key: RowKeyValue<Row, Key>, open: boolean) => unknown) | undefined

  // What an open row shows under it.
  detail?: Snippet<[row: Row]> | undefined
  // Names a row's toggle: `Details of <first column's text>`.
  expandLabel?: ((row: Row) => string) | undefined
  // Marks the rows as on their way: with none to show, `skeletonRows` skeleton rows are drawn, and with some they stay, dimmed, the table `aria-busy`. A source still loading and a `list` still on its first page set it themselves.
  busy?: boolean | undefined
  // How many skeleton rows a busy table draws.
  skeletonRows?: number | undefined
  // Read out while the rows load.
  loadingLabel?: string | undefined
  // Shown in a row with the retry button when the rows could not be loaded.
  failureLabel?: string | undefined
  retryLabel?: string | undefined
  // Called with the rows each time a `rows` function or promise answers.
  onLoad?: ((rows: Row[]) => unknown) | undefined
  // Called with `{ error }` when a `rows` function or promise rejects.
  onError?: ((failure: { error: unknown }) => unknown) | undefined
  // Makes each row a link: the address of a row, or undefined for one that leads nowhere. The first cell holds an anchor stretched over the row, named `openRowLabel`, so a real link opens in a new tab and a click on the row follows it, while the checkbox, the toggle and the links and buttons of the cells stay clickable above it.
  rowHref?: ((row: Row) => string | undefined) | undefined
  // Makes each row a button, or hears the click of a link row (call `event.preventDefault()` to follow the link yourself).
  onRowClick?: ((row: Row, event: MouseEvent) => unknown) | undefined
  // Draws the rows a page at a time, this many to a page, with a Pagination under them: its summary beside the pages, and `pageSizes` as links that change the size. The pages count the rows the filter keeps, and a sort or a typed filter starts again from the first, which `onPageChange` hears. The page and a size picked from `pageSizes` are kept in the address, under `pageParam` and `limitParam`, so the server draws the page a link or a shared URL names and the pager's links open it. `pageSizes` does nothing without a `pageSize`. Not for a `list` or a `virtual` table, which page or window their rows themselves.
  pageSize?: number | undefined
  // The sizes to offer under the rows of a table with a `pageSize`, such as `[10, 25, 50]`; the one on screen is marked, and one the address names is taken only when listed here.
  pageSizes?: readonly number[] | undefined
  // The page on screen, from 1, which the app holds: the table then leaves the address alone and the app sets it from `onPageChange`. Left out, the table keeps the page itself, in the address.
  page?: number | undefined
  // The query parameters holding the page and the page size, `page` and `limit` by default, which the pager's links set.
  pageParam?: string | undefined
  limitParam?: string | undefined
  // Called with the page and the size after each change to either, a click on a page or a size or a sort or a filter starting again from the first page; the page restarts at 1 when the size changes.
  onPageChange?: ((page: number, size: number) => unknown) | undefined
  // Names a row's link or button: `Open <first column's text>`.
  openRowLabel?: ((row: Row) => string) | undefined
} & ({ rows: RowsSource<Row>, list?: undefined } | { rows?: undefined, list: InfiniteList<Row> })>()

if ((rest as { onSelect?: unknown }).onSelect !== undefined)
  throw new Error('kayjs-ui: a Table has no onSelect since 1.91; use onSelectedChange')

if (expandable && virtual)
  throw new Error('kayjs-ui: a Table cannot be both expandable and virtual, a detail row breaks the single row height a virtual table measures by')

if (pageSize !== undefined && (virtual || list))
  throw new Error('kayjs-ui: a Table with a pageSize cannot be virtual or take a list, which already hold their rows by the window or by the page')

const source = asyncRows<Row>(() => passed, { onLoad: loaded => onLoad?.(loaded), onError: failure => onError?.(failure) })
const rows = () => list ? list.rows() : source.rows()
const columns = memo(() => given.map(column => resolvedColumn(column, sortable)))
// The sort kept in the address is read when the table is made.
const keptKey = uses('sortParam') && sortParam !== undefined ? persisted.query(sortParam, '') : undefined
const directionParam = uses('sortParam') && sortParam !== undefined ? sortParam === 'sort' ? 'direction' : `${sortParam}Direction` : undefined
const keptDirection = directionParam === undefined ? undefined : persisted.query(directionParam, '')
const restored = restoredSort(columns(), keptKey?.(), keptDirection?.())
const current = signal(restored ?? sort)
let following = restored === undefined
// The search box and the extra fields, decided when the table is made.
const search = uses('filter') || uses('fields') || uses('filterParam') ? tableFilter({ filterParam, fields, reserved: [sortParam, directionParam, ...pageSize === undefined ? [] : [pageParam, limitParam]] }) : undefined
// A table over a list searches on the server, so a `filterParam` alone shows the box.
const searching = () => filter !== undefined || (list !== undefined && filterParam !== undefined)
const fielded = () => (search?.extra.length ?? 0) > 0
const filtering = () => search?.active() ?? false

effect(() => {
  const next = sort

  // The URL's sort stands over the one the table starts from, until the parent passes a new one.
  if (following)
    current = next

  following = true
})

if (uses('list'))
  followList(() => list, current, () => search?.asked() ?? { text: '', fields: {} })

// The rows the filter keeps, all of them without one.
const kept = memo(() => uses('filter') && filter !== undefined && !list ? rowsMatching(rows(), filter, search!.typed()) : rows())
const counted = (count: number) => countLabel ? countLabel(count) : wording('ui.table.rowCount', count === 1 ? '1 row' : '{count} rows', { count })
const hiddenKeys = signal(hiddenColumns ?? given.filter(column => column.hidden).map(column => column.key))

effect(() => {
  const next = hiddenColumns

  if (next)
    hiddenKeys = next
})

const shownColumns = memo(() => columns().filter(column => !hiddenKeys().includes(column.key)))
const hasFoot = () => footer !== undefined || shownColumns().some(column => column.footer !== undefined)
const columnCount = () => shownColumns().length + (selectable ? 1 : 0) + (expandable ? 1 : 0)
const regionName = () => (rest as { 'aria-label'?: string })['aria-label'] ?? label
const scrolls = signal(virtual)
const countChosen = (count: number) => selectedLabel ? selectedLabel(count) : wording('ui.table.selected', '{count} selected', { count })
const shown = memo(() => serverSort || list ? kept() : sortedRows(kept(), columns(), current()))
const waiting = () => busy || (list ? list.pending() && !list.failed() : source.loading())
const skeleton = () => waiting() && shown().length === 0
const skeletonIndexes = () => Array.from({ length: Math.max(1, Math.floor(skeletonRows)) }, (_, index) => index)
const skeletonCells = () => Array.from({ length: columnCount() }, (_, index) => index)
const openLabel = (row: Row) => (openRowLabel ?? (item => wording('ui.table.openRow', 'Open {row}', { row: rowLabel(item, columns(), rowKey) })))(row)
const broke = () => list ? list.failed() : source.failed()
const select = uses('selectable') ? selection({ rowKey, rows, kept, selected: () => selected, onChange: () => onSelectedChange, enabled: () => selectable, settling: () => waiting() || broke() }) : undefined
// Drawn whatever the variant, as the server draws it: an id taken only by a Table with `expandable` would shift every later one of the island.
const tableId = uid()
const expansion = uses('expandable') ? expanding({ tableId, rowKey, expanded: () => expanded, onOpenChange: () => onOpenChange }) : undefined
const linked = () => rowHref !== undefined || onRowClick !== undefined
const sorting = (column: Column<Row>) => column.sortValue !== undefined && current()?.key === column.key

const endpoint = memo(() => {
  const value = exportable

  return typeof value === 'string' ? value : undefined
})

const pager = uses('pageSize')
  ? paging({ pageSize: () => pageSize, pageSizes: () => pageSizes, page: () => page, pageParam: () => pageParam, limitParam: () => limitParam, onPageChange: () => onPageChange, shown, restarts: () => {
    current()
    search?.typed()
    search?.fieldsNow()
  } })
  : undefined

// Without `virtual` every row is drawn; with it the others stand for room above and below.
const windowed = uses('virtual') && virtual ? virtualRows({ items: () => shown(), keyOf: row => rowKeyOf(row, rowKey), estimate: () => 48, overscan: () => 8 }) : undefined
const drawn = memo(() => windowed ? windowed.rows() : pager ? pager.pageRows() : shown())
let box: HTMLElement | undefined
let body: HTMLElement | undefined

function measure() {
  // One pixel of tolerance: sub-pixel rounding can make the scroll size exceed the client size on a box that does not scroll.
  const now = virtual || box!.scrollWidth - box!.clientWidth > 1 || box!.scrollHeight - box!.clientHeight > 1

  if (now === scrolls())
    return

  scrolls = now
  onScrollChange?.(now)
}

onMount(() => {
  if (windowed)
    onCleanup(windowed.attach(box!, body!))

  measure()

  if (typeof ResizeObserver === 'undefined')
    return

  const observer = new ResizeObserver(measure)

  observer.observe(box!)
  observer.observe(box!.querySelector('table')!)
  onCleanup(() => observer.disconnect())
})

const showColumn = uses('columnToggle')
  ? (key: string, on: boolean) => {
    const next = on ? hiddenKeys().filter(other => other !== key) : [...hiddenKeys(), key]

    if (hiddenColumns === undefined)
      hiddenKeys = next

    onHiddenColumnsChange?.(next)
  }
  : undefined

function toggle(column: Column<Row>) {
  const next = nextSort(current(), column)

  current = next
  keptKey?.set(next.key)
  keptDirection?.set(next.direction)
  onSort?.(next)
}

function ariaSort(column: Column<Row>): 'ascending' | 'descending' | undefined {
  if (!sorting(column))
    return undefined

  return current()?.direction === 'asc' ? 'ascending' : 'descending'
}
---
div({...rest} ref={element => box = element} data-narrow={narrow} data-virtual={virtual ? '' : undefined} tabindex={scrolls() ? '0' : undefined} role={scrolls() && regionName() ? 'region' : undefined} aria-label={scrolls() ? regionName() : (rest as { 'aria-label'?: string })['aria-label']})
  if (uses('filter') || uses('filterParam') || uses('fields')) && (searching() || fielded())
    div(part="filter")
      if searching()
        label(part="field")
          span.kui-label-text(part="filterLabel") {filterLabel}
          input.kui-field-input(part="filterInput" type="search" value={search!.typed()} placeholder={filterPlaceholder} autocomplete="off" onInput={event => search!.typed.set(event.currentTarget.value)})
      for field, index of search!.extra key={field.key}
        label(part="field")
          span.kui-label-text(part="filterLabel") {field.label}
          if field.options
            Select(value={search!.values[index]!()} options={field.options} emptyOption onChange={search!.values[index]!.set})
          else
            input.kui-field-input(part="filterInput" type="search" value={search!.values[index]!()} autocomplete="off" onInput={event => search!.values[index]!.set(event.currentTarget.value)})
    p(part="count" role="status") {list ? (filtering() && !list.pending() ? counted(rows().length) : '') : (search!.typed() ? counted(kept().length) : '')}
  if (uses('selectable') && selectable) || (uses('exportable') && exportable) || (uses('columnToggle') && columnToggle)
    div(part="selection")
      if uses('columnToggle') && columnToggle
        Popover(placement="bottom-start" part="columnsPanel" label={columnsLabel})
          @trigger(attributes)
            Button({...attributes} label={columnsLabel} variant="ghost" size="sm")
          for column of columns() key={column.key}
            if column.header
              Checkbox(label={column.header} checked={!hiddenKeys().includes(column.key)} onChange={on => showColumn!(column.key, on)})
      if uses('selectable') && selectable
        Checkbox(label={selectAllLabel} checked={select!.allChosen()} indeterminate={select!.someChosen() && !select!.allChosen()} disabled={select!.visible().length === 0} onChange={select!.pickAll})
        p(part="selected" role="status") {select!.chosen().length > 0 ? countChosen(select!.chosen().length) : ''}
        if select!.chosen().length > 0 && bulk
          div(part="bulk")
            | {bulk(select!.chosen(), () => select!.commit([]))}
      if uses('exportable') && exportable
        if (waiting() ? undefined : endpoint()) then address
          Button(href={exportHref(address, current(), filterParam ?? 'q', search?.typed() ?? '', search?.fieldsNow() ?? {})} download={exportName} label={exportLabel} variant="ghost" size="sm")
        else
          Button(label={exportLabel} variant="ghost" size="sm" disabled={waiting()} onClick={endpoint() ? undefined : () => downloadCsv(shown(), shownColumns(), exportName)})
  p(part="status" role="status") {skeleton() && (!list || !list.pending()) ? loadingLabel : ''}
  if source.failed()
    div(part="failure" role="alert")
      p(part="message") {failureLabel}
      if source.retryable()
        Button(label={retryLabel} variant="ghost" size="sm" onClick={source.retry})
  table(part="table" aria-busy={waiting() ? 'true' : undefined} aria-rowcount={virtual ? shown().length + (hasFoot() ? 2 : 1) : undefined})
    if label
      caption(part="caption") {label}
    thead(part="head")
      tr(part="headRow" aria-rowindex={virtual ? 1 : undefined})
        if uses('expandable') && expandable
          th(part="toggleHead" scope="col")
            span(part="selectText") {wording('ui.table.details', 'Details')}
        if uses('selectable') && selectable
          th(part="selectHead" scope="col")
            span(part="selectText") {selectAllLabel}
        for column of shownColumns() key={column.key}
          th(part="headCell" class={column.class} style={columnStyle(column)} scope="col" data-align={column.align ?? 'start'} data-sticky={column.sticky} aria-sort={ariaSort(column)})
            if column.sortValue
              button(part="sortButton" type="button" data-direction={sorting(column) ? current()?.direction : undefined} onClick={() => toggle(column)})
                if header
                  | {header(column)}
                else
                  | {column.header}
                if sorting(column)
                  Icon(icon="chevron" part="sortIcon")
            else if header
              | {header(column)}
            else
              | {column.header}
    tbody(part="body" ref={element => body = element})
      if uses('virtual') && windowed && windowed.before() > 0
        tr(part="spacer" aria-hidden="true" style={`height: ${windowed.before()}px`})
          td(colspan={columnCount()} style="padding: 0; border: 0")
      for row, position of drawn() key={rowKeyOf(row, rowKey)}
        tr(part="row" data-linked={linked() ? '' : undefined} data-virtual-index={windowed ? windowed.start() + position : undefined} aria-rowindex={windowed ? windowed.start() + position + 2 : undefined} aria-selected={uses('selectable') && selectable ? (select!.chosenSet().has(rowKeyOf(row, rowKey)) ? 'true' : 'false') : undefined})
          if uses('expandable') && expandable
            td(part="toggleCell")
              IconButton(part="toggle" icon="chevron" variant="ghost" size="xs" label={(expandLabel ?? (item => wording('ui.table.expandRow', 'Details of {row}', { row: rowLabel(item, columns(), rowKey) })))(row)} aria-expanded={expansion!.openSet().has(rowKeyOf(row, rowKey)) ? 'true' : 'false'} aria-controls={expansion!.detailId(row)} onClick={() => expansion!.toggleRow(rowKeyOf(row, rowKey))})
          if uses('selectable') && selectable
            td(part="selectCell")
              div(part="cellBody")
                Checkbox(checked={select!.chosenSet().has(rowKeyOf(row, rowKey))} aria-label={(selectRowLabel ?? (item => wording('ui.table.selectRow', 'Select {row}', { row: rowLabel(item, columns(), rowKey) })))(row)} onChange={on => select!.pick(rowKeyOf(row, rowKey), on)})
          for column, columnIndex of shownColumns() key={column.key}
            td(part="cell" class={column.class} style={columnStyle(column)} data-align={column.align ?? 'start'} data-numeric={column.numeric ? '' : undefined} data-sticky={column.sticky})
              if narrow === 'stack' && column.header
                span(part="cellLabel") {column.header}
              div(part="cellBody")
                if cell && drawnByBlock(column, given)
                  | {cell(row, column)}
                else
                  | {cellText(row, column)}
              if (uses('rowHref') || uses('onRowClick')) && columnIndex === 0 && linked()
                if rowHref?.(row) then href
                  a(part="rowLink" href={href} aria-label={openLabel(row)} onClick={event => onRowClick?.(row, event)})
                else if onRowClick
                  button(part="rowButton" type="button" aria-label={openLabel(row)} onClick={event => onRowClick?.(row, event)})
        if uses('expandable') && expandable && detail && expansion!.openSet().has(rowKeyOf(row, rowKey))
          tr(part="detailRow" id={expansion!.detailId(row)})
            td(part="detailCell" colspan={columnCount()})
              | {detail(row)}
      else
        if skeleton()
          for index of skeletonIndexes() key={index}
            tr(part="skeletonRow" aria-hidden="true")
              for cellIndex of skeletonCells() key={cellIndex}
                td(part="skeletonCell")
                  span(part="skeletonBar")
        else if !broke() && (list ? filtering() : rows().length > 0) && noMatch
          tr
            td(part="emptyCell" colspan={columnCount()})
              | {noMatch}
        else if !broke() && (empty || emptyLabel !== '') && (!list || (list.ended() && !list.failed() && !list.pending()))
          tr
            td(part="emptyCell" colspan={columnCount()})
              if empty
                | {empty}
              else
                | {emptyLabel}
      if uses('virtual') && windowed && windowed.after() > 0
        tr(part="spacer" aria-hidden="true" style={`height: ${windowed.after()}px`})
          td(colspan={columnCount()} style="padding: 0; border: 0")
    if hasFoot()
      tfoot(part="foot")
        tr(part="footRow" aria-rowindex={virtual ? shown().length + 2 : undefined})
          if uses('expandable') && expandable
            td(part="footCell")
          if uses('selectable') && selectable
            td(part="footCell")
          for column of shownColumns() key={column.key}
            td(part="footCell" class={column.class} style={columnStyle(column)} data-align={column.align ?? 'start'} data-numeric={column.numeric ? '' : undefined} data-sticky={column.sticky})
              if footer
                | {footer(column)}
              else
                | {column.footer ?? ''}
  if uses('pageSize') && pager!.paged() && !skeleton()
    Pagination(part="pager" page={pager!.pageShown()} total={shown().length} pageSize={pager!.sizeNow()} sizes={pageSizes} param={pageParam} limitParam={limitParam} onPage={pager!.goTo} onSize={pager!.resize})
  if uses('list') && list
    LoadMore(list={list})
