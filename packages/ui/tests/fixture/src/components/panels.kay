---
import { signal } from 'kay'
import SidePanel from '@kaynooo/kayjs-ui/side-panel.kay'
import SplitLayout from '@kaynooo/kayjs-ui/split-layout.kay'

// What the test reads back: how often the panel closed.
const { onClose, listWidthKey, onSettled, sizeKey } = props<{ onClose: () => void, listWidthKey?: string, onSettled?: (size: number) => void, sizeKey?: string }>()

const open = signal(false)
const beside = signal(false)
const linked = signal(false)
const launched = signal(false)
const sidebarOpen = signal(true)
const detailOpen = signal(true)
const dockOpen = signal(true)
const dockEdge = signal<'right' | 'bottom'>('right')
const dockSize = signal<number | undefined>(undefined)
const scrollKey = signal('mercury')
const lateEdge = signal<'right' | 'bottom' | undefined>(undefined)
---
button#open(onClick={() => open = true}) Open
button#open-beside(onClick={() => beside = true}) Open beside
button#open-sidebar(onClick={() => sidebarOpen = true}) Sidebar
button#toggle-detail(onClick={() => detailOpen = !detailOpen()}) Detail
button#open-linked(onClick={() => linked = true}) Open linked
button#shut(onClick={() => open = false}) Shut
SidePanel#panel(open={open()} title="Mars" onOpenChange={() => { open = false; onClose() }})
  @actions
    button#next Next
  @footer
    button#save Save
  p#body Fourth planet
SidePanel#beside(open={beside()} modal={false} closeHref="/list" title="Venus" onOpenChange={() => { beside = false; onClose() }})
  p#beside-body Second planet
SidePanel#linked(open={linked()} modal={false} closeHref="/list" title="Earth")
  p#linked-body Third planet
SplitLayout#split(sidebarOpen={sidebarOpen()} onSidebarOpenChange={() => sidebarOpen = false} sidebarTitle="Planets" resizableList listWidthKey={listWidthKey} detailOpen={detailOpen()})
  @sidebar
    nav Inner, outer
  @list
    ul#list
      li
        button#mars Mars
  @detail
    p#detail Mars
    button#edit Edit
SidePanel#docked(open={dockOpen()} modal={false} dock={dockEdge()} size={dockSize()} sizeKey={sizeKey} onSizeChange={(size, settled) => { dockSize = size; if (settled) onSettled?.(size) }} title="Jupiter" launcher="Open Jupiter" launcherLayer={41} style="z-index: 77; opacity: 0.9" onOpenChange={shown => dockOpen = shown})
  p#docked-body Fifth planet
SidePanel#scrolled(open={true} modal={false} title="Venus" scrollKey={scrollKey()} onOpenChange={() => undefined})
  p#scrolled-body Second planet
button#next-scroll(onClick={() => scrollKey = 'venus'}) Next
button#same-scroll(onClick={() => scrollKey = scrollKey()}) Same
button#show-launched(onClick={() => launched = true}) Show launched
if launched()
  SidePanel#launched(open={false} modal={false} dock="right" closeHref="/list" title="Saturn" launcher="Open Saturn" launcherHref="/saturn")
    p Sixth planet
button#open-docked(onClick={() => dockOpen = true}) Open docked
button#dock-bottom(onClick={() => dockEdge = 'bottom'}) Dock bottom
SidePanel#late(open={true} modal={false} dock={lateEdge()} title="Saturn" onOpenChange={() => undefined})
  p Sixth planet
button#late-dock(onClick={() => lateEdge = 'bottom'}) Dock late
