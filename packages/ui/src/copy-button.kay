---
import type { Duration, JSX } from 'kay'
import { copy } from '@kaynooo/utils/browser/clipboard'
import { durationMs, onCleanup, recipe, signal } from 'kay'
import { attempt } from './toast'
import { wording } from 'kay/words'

// 'kui-copy-btn' stays as the component's name for an app's CSS; its padding is a utility, which beats the Button's per-size rules.
const look = recipe({
  parts: {
    root: 'kui-copy-btn px-1.5 py-0.5',
    text: 'inline-flex flex-col items-center after:invisible after:h-0 after:overflow-hidden after:content-[attr(data-other)]',
    live: 'sr-only',
  },
  variants: { tone: { neutral: '', accent: 'kui-btn-accent', success: 'kui-btn-success', danger: 'kui-btn-danger' } },
})

const { text, label, html, variant = 'solid', size = 'md', copiedFor = '2s', copiedLabel = wording('ui.copyButton.copied', 'Copied!'), failure = wording('ui.copyButton.failure', 'Could not copy to the clipboard'), onCopy, onFail, ...rest } = props<Omit<JSX.IntrinsicElements['button'], 'class' | 'children' | 'onClick' | 'type'> & {
  // What is copied: the text, or a function returning it, or a promise of it, for a value that has to be fetched or built on the click (a signed link). Nothing is copied while it is empty.
  text: string | (() => string | Promise<string>)
  label: string
  // A rendered version copied alongside `text`, which rich editors paste instead.
  html?: string | undefined
  // As a Button's: `solid`, `ghost` or `inline`.
  variant?: 'solid' | 'ghost' | 'inline' | undefined
  size?: 'xs' | 'sm' | 'md' | 'lg' | undefined
  // How long the button says `copiedLabel` once the copy went through.
  copiedFor?: Duration | undefined
  // What the button says once the copy went through.
  copiedLabel?: string | undefined
  // Toasted when the browser refuses the copy.
  failure?: string | undefined
  // Called with the text copied, once the copy went through.
  onCopy?: ((text: string) => unknown) | undefined
  // Called with the error when the text could not be built or the browser refused the copy, beside the `failure` toast.
  onFail?: ((error: unknown) => unknown) | undefined
}>()

const copied = signal(false)
let timer: ReturnType<typeof setTimeout> | undefined

onCleanup(() => clearTimeout(timer))

// Writes the text and answers it, empty when there was nothing to copy. A text still on its way is handed to the clipboard as it is, since Safari only accepts a copy started inside the click.
async function write(): Promise<string> {
  const pending = typeof text === 'function' ? text() : text

  if (typeof pending !== 'string' && html === undefined && typeof ClipboardItem !== 'undefined' && navigator.clipboard?.write) {
    let resolved = ''
    const blob = (async () => {
      resolved = await pending

      return new Blob([resolved], { type: 'text/plain' })
    })()

    await navigator.clipboard.write([new ClipboardItem({ 'text/plain': blob })])

    return resolved
  }

  const resolved = await pending

  if (resolved)
    await copy(resolved, html === undefined ? {} : { html })

  return resolved
}

let pressing = false

async function press() {
  if (pressing)
    return

  pressing = true

  let written = ''
  const done = await attempt(async () => {
    try {
      written = await write()
    }
    catch (error) {
      onFail?.(error)
      throw error
    }
  }, failure)

  pressing = false

  if (!done || !written)
    return

  copied = true
  clearTimeout(timer)
  timer = setTimeout(() => copied = false, durationMs(copiedFor))
  onCopy?.(written)
}
---
button.kui-btn(part="root" {...rest} type="button" data-variant={variant} data-size={size} onClick={press})
  // The label not showing is drawn invisibly by CSS from `data-other`, so the button keeps the wider label's width while its text and accessible name stay the one showing.
  span(part="text" data-other={copied() ? label : copiedLabel}) {copied() ? copiedLabel : label}
// A button's new text is not read out, so the copy is said here too.
span(part="live" role="status") {copied() ? copiedLabel : ''}
