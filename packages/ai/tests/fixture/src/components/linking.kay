---
import { reply } from '../routes/chat.kay'
import ChatLauncher from '@kaynooo/kayjs-ai/chat-launcher.kay'

const changes = signal<boolean[]>([])
---
a.link(href="#chat") Ask
button.event(type="button" onClick={() => window.dispatchEvent(new CustomEvent('kai-chat-open'))}) Event
button.send(type="button" onClick={() => window.dispatchEvent(new CustomEvent('kai-chat-send', { detail: 'Sent from outside' }))}) Send
button.draft(type="button" onClick={() => window.dispatchEvent(new CustomEvent('kai-chat-draft', { detail: 'Drafted from outside' }))}) Draft
p.changes {changes().join(';')}
ChatLauncher(action={reply} label="Assistant" onOpenChange={value => { changes = [...changes(), value] }})
