{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@kayjs/kay",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@kayjs/kay": ["./packages/kay/src/index.ts"],
      "@kayjs/kay/server": ["./packages/kay/src/server/public.ts"],
      "@kayjs/kay/config": ["./packages/kay/src/plugins/public.ts"],
      "@kayjs/kay/test": ["./packages/kay/src/test/index.ts"],
      "@kayjs/kay/build": ["./packages/kay/src/build/index.ts"],
      "@kayjs/kay/jsx-runtime": ["./packages/kay/src/jsx-runtime.ts"],
      "@kayjs/kay/jsx-dev-runtime": ["./packages/kay/src/jsx-runtime.ts"],
      "@kayjs/kay/internal/dom": ["./packages/kay/src/dom/index.ts"],
      "@kayjs/kay/internal/dom-extras": ["./packages/kay/src/dom/extras.ts"],
      "@kayjs/kay/internal/dom-loop": ["./packages/kay/src/dom/loop.ts"],
      "@kayjs/kay/internal/action": ["./packages/kay/src/dom/action.ts"],
      "@kayjs/kay/internal/island": ["./packages/kay/src/dom/island.ts"],
      "@kayjs/kay/internal/ssr": ["./packages/kay/src/ssr/index.ts"],
      "@kayjs/kay/internal/server": ["./packages/kay/src/server/index.ts"],
      "@kayjs/icons": ["./packages/plugin-icons/src/index.ts"],
      "@kayjs/icons/plugin": ["./packages/plugin-icons/src/plugin.ts"],
      "@kayjs/icons/search": ["./packages/plugin-icons/src/search.ts"],
      "@kayjs/images": ["./packages/plugin-images/src/index.ts"],
      "@kayjs/seo": ["./packages/plugin-seo/src/index.ts"],
      "@kayjs/mail": ["./packages/plugin-mail/src/index.ts"],
      "@kayjs/auth": ["./packages/plugin-auth/src/index.ts"],
      "@kayjs/auth/sqlite": ["./packages/plugin-auth/src/sqlite.ts"],
      "@kayjs/auth/oauth": ["./packages/plugin-auth/src/oauth.ts"],
      "@kayjs/live": ["./packages/plugin-live/src/index.ts"],
      "@kayjs/live/client": ["./packages/plugin-live/src/client.ts"],
      "@kayjs/mcp": ["./packages/plugin-mcp/src/index.ts"],
      "@kayjs/content": ["./packages/plugin-content/src/index.ts"],
      "@kayjs/ui": ["./packages/ui/src/index.ts"],
      "@kayjs/ui/plugin": ["./packages/ui/src/plugin.ts"],
      "@kayjs/tailwind": ["./packages/plugin-tailwind/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src",
    "packages/*/tests",
    "bench-app",
    "examples/*/src",
    "examples/*/kay.config.ts",
    "packages/kay/templates/*/src",
    "packages/kay/templates/*/kay.config.ts"
  ]
}
