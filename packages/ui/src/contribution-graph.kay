---
import { recipe } from 'kay'
import type { JSX } from 'kay'
import type { ContributionDay } from './contribution'
import { monthStarts } from './contribution'
import { shade } from './shade'
import { wording } from 'kay/words'

const look = recipe({ parts: { root: 'kui-contribution-graph', month: 'kui-contribution-month', cell: 'kui-contribution-cell' } })

const { days, color, today, label = wording('ui.contributionGraph.label', 'Contributions'), months = false, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'children'> & {
  // Ascending days starting on a Monday, as `gridDays` from `@kaynooo/utils` lists them, each with how full its cell is.
  days: readonly ContributionDay[]
  // The CSS colour the filled cells shade towards.
  color: string
  // The ISO date of today, whose cell is marked.
  today: string
  // Names the grid for screen readers.
  label?: string | undefined
  // Names each month above the week it starts in, placing every cell by hand.
  months?: boolean | undefined
}>()

// A day without a description is read as how full it is, which its colour alone shows.
const describe = (day: ContributionDay) => `${day.description ?? `${Math.round(day.intensity * 100)}%`} · ${day.day}`

const style = (day: ContributionDay, index: number) => {
  const fill = shade(color, day.intensity)
  const parts = [fill && `background-color: ${fill}`, months && `grid-row: ${index % 7 + 2}; grid-column: ${Math.floor(index / 7) + 1}`].filter(Boolean)

  return parts.length > 0 ? parts.join('; ') : undefined
}
---
// A year of days as a grid of weeks, each cell shaded by how full its day was.
div({...rest} part="root" role="group" aria-label={label} class={{ 'kui-contribution-graph-months': months }})
  if months
    for start of monthStarts(days.map(day => day.day)) key={start.column}
      span(part="month" aria-hidden="true" style={`grid-column: ${start.column + 1}`}) {start.label}
  for day, index of days key={day.day}
    span(part="cell" role="img" aria-label={describe(day)} data-tooltip={describe(day)} data-today={day.day === today || undefined} style={style(day, index)})
