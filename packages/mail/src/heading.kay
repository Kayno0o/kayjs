---
import settings from './settings'

const { level = 1 } = props<{ level?: 1 | 2 | 3 | undefined }>()
---
match level
  when 2
    h2(style={`font-size:18px;line-height:1.35;margin:24px 0 12px;color:${settings.text}`})
      slot
  when 3
    h3(style={`font-size:16px;line-height:1.4;margin:20px 0 8px;color:${settings.text}`})
      slot
  else
    h1(style={`font-size:22px;line-height:1.3;margin:0 0 20px;color:${settings.text}`})
      slot
