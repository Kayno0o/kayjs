---
import { recipe } from 'kay'

const look = recipe({ parts: { root: '' } })

// The callbacks are not named `on*`: an `onX` attribute on a component makes the component passing it an island, which a Pagination would then be on every page.
const { whenPage, whenSize } = props<{
  whenPage?: ((page: number) => unknown) | undefined
  whenSize?: ((size: number) => unknown) | undefined
}>()

// A plain click on a page or size link goes to the handler; a modified or middle one is left to the browser, which opens the link's real address.
function pick(event: MouseEvent) {
  if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
    return

  const link = (event.target as Element).closest<HTMLElement>('a[data-page], a[data-size]')

  if (!link)
    return

  const handler = link.dataset.size === undefined ? whenPage : whenSize
  const value = Number(link.dataset.size ?? link.dataset.page)

  if (!handler || Number.isNaN(value))
    return

  event.preventDefault()
  void handler(value)
}
---
// Wraps a Pagination's navigation only when it was given a handler, so one of plain links stays static and ships no script.
// kay-allow unreachable-click -- the click comes from a link inside, which the keyboard follows
div(part="root" style="display: contents" onClick={pick})
  slot
