---
import type { IconSlot } from './defaults'
import type { ToastType } from './toast'
import { effect, onMount, recipe, shortcut, signal } from 'kay'
import { claim } from './claim'
import Icon from './icon.kay'
import IconButton from './icon-button.kay'
import { dismissToast, holdToasts, toasts } from './toast'
import { wording } from 'kay/words'

function toneOf(item: { tone?: string | undefined, type: ToastType }): string {
  return item.tone ?? (item.type === 'error' ? 'danger' : item.type)
}

const ICONS: Record<ToastType, IconSlot> = { error: 'alert', success: 'success', info: 'info' }

// 'kui-toaster' and 'kui-toast' stay as the components' names for an app's CSS and skins; theme.css keeps the toast's raised shadow. A toast's tone is the colour its icon takes.
const look = recipe({
  parts: {
    root: 'kui-toaster pointer-events-none fixed inset-auto right-4 bottom-4 z-100 m-0 flex w-[calc(100%-2rem)] max-w-sm flex-col gap-2 overflow-visible border-0 bg-transparent p-0',
    live: 'sr-only',
    toast: 'kui-toast pointer-events-auto flex items-start gap-2 rounded-lg border-solid border-[length:var(--kui-border-width,var(--border-width))] border-border-strong bg-surface px-3 py-2 [--_toast-tone:var(--color-accent)] data-[tone=danger]:[--_toast-tone:var(--color-danger)] data-[tone=success]:[--_toast-tone:var(--color-success)] data-[tone=info]:[--_toast-tone:var(--color-info)]',
    icon: 'mt-0.5 size-4 shrink-0 text-(--_toast-tone)',
    message: 'min-w-0 flex-1 text-xs/snug text-foreground',
    dismiss: 'shrink-0 text-[var(--color-kui-overlay1,var(--color-muted))] hover:text-foreground',
  },
})

const { dismissLabel = wording('ui.toaster.dismiss', 'Dismiss notification'), hotkey = 't' } = props<{
  // Names each toast's close button for screen readers.
  dismissLabel?: string | undefined
  // Alt and this key move focus to the toasts on screen, where Escape dismisses the focused one; `null` leaves it to the app.
  hotkey?: string | null | undefined
}>()

const toaster = signal<HTMLElement>()
// An extension rendering its own Toaster inside an app that has one shows each toast once.
const owns = claim('toaster')
// The toasts outlive a page swap, so one on screen when the next page's Toaster hydrates is not in the server markup: shown from the mount on, hydration meets the markup it was given.
const mounted = signal(false)

onMount(() => mounted.set(true))

function listed() {
  return mounted() ? toasts() : []
}

// A manual popover lives in the top layer, and showing it again lifts it above any dialog opened since.
effect(() => {
  const shown = listed().length > 0

  const element = toaster()

  // The element is gone while another Toaster owns the job, and a detached one cannot show as a popover.
  if (!element?.isConnected)
    return

  if (element.matches(':popover-open'))
    element.hidePopover()

  if (shown)
    element.showPopover()
})

shortcut(() => hotkey ? `alt+${hotkey}` : null, (event) => {
  const button = owns() ? toaster()?.querySelector('button') : null

  if (!button)
    return

  event.preventDefault()
  button.focus()
}, { preventDefault: false })

// Escape dismisses the focused toast alone, not the dialog under it, and focus moves on to the next toast's button rather than falling to the page.
function dismissed(event: KeyboardEvent) {
  const toast = event.currentTarget as HTMLElement

  if (event.key !== 'Escape')
    return

  event.preventDefault()
  event.stopPropagation()

  const next = (toast.nextElementSibling ?? toast.previousElementSibling)?.querySelector('button')

  dismissToast(Number(toast.dataset.id))
  next?.focus()
}
---
// Screen readers hear a toast from regions kept in the page, which a message joining reads out: a live region shown only as it fills, as the toaster is, is often not read.
if owns()
  div(part="live" role="status")
    for item of listed().filter(item => toneOf(item) !== 'danger') key={item.id}
      span {item.message}
  div(part="live" role="alert")
    for item of listed().filter(item => toneOf(item) === 'danger') key={item.id}
      span {item.message}
  // Holding still while the pointer is on the toasts or focus is in them, as timed content must let itself be paused.
  div(part="root" ref={element => toaster.set(element)} popover="manual" onPointerEnter={() => holdToasts('pointer', true)} onPointerLeave={() => holdToasts('pointer', false)} onFocusIn={() => holdToasts('focus', true)} onFocusOut={event => toaster()?.contains(event.relatedTarget as Node | null) || holdToasts('focus', false)})
    for item of listed() key={item.id}
      div(part="toast" data-id={item.id} data-tone={toneOf(item)} data-type={item.type} onKeyDown={dismissed})
        Icon(icon={ICONS[item.type]} part="icon")
        p(part="message") {item.message}
        IconButton(icon="close" label={dismissLabel} size="sm" variant="inline" part="dismiss" onClick={() => dismissToast(item.id)})
