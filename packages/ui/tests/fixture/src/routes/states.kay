---
import { signal } from 'kay'
import Combobox from '@kaynooo/kayjs-ui/combobox.kay'
import FileDrop from '@kaynooo/kayjs-ui/file-drop.kay'
import '../app.css'

const planets = [{ value: 'mars', label: 'Mars' }, { value: 'earth', label: 'Earth' }]
const dropped = signal<string[]>([])
---
//- A Combobox on a picked option and a disabled FileDrop beside an enabled one, for the browser test to read the states they carry.
head
  title States
main.flex.flex-col.items-start.gap-4.p-8
  h1 States
  Combobox(label="Planet" name="planet" options={planets} value="mars")
  FileDrop#live(aria-label="Live" onFiles={() => dropped = [...dropped(), 'live']})
    @content(_zone)
      | Drop here
  FileDrop#locked(aria-label="Locked" disabled onFiles={() => dropped = [...dropped(), 'locked']})
    @content(_zone)
      | Drop here
  p#dropped {dropped().join(',')}
