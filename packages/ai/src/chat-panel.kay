---
import type { Snippet } from 'kay'
import type { ChatLauncherLabels } from './types'
import { effect, onCleanup, recipe, signal, uid, untrack } from 'kay'
import { wording } from 'kay/words'
import BareIconButton from '@kayjs/ui/bare-icon-button.kay'
import SidePanel from '@kayjs/ui/side-panel.kay'
import { eventText } from './chat-events'

const look = recipe({ parts: { root: 'kai-launcher', new: 'kai-launcher-action', expand: 'kai-launcher-action kai-launcher-expand', close: 'kai-launcher-action' } })

const { labels = {}, label = wording('ai.chat.label', 'Chat'), icon, closeIcon, newIcon, expandIcon, collapseIcon, open: wanted, onOpenChange, hash = '#chat' } = props<{
  // Names the panel for screen readers and heads it.
  label?: string | undefined
  // The texts of the buttons, by key: `open` and `close` are the name and tooltip of the button while the panel is closed and while it is open, `new` clears the conversation, `expand` and `collapse` switch the size.
  labels?: Pick<ChatLauncherLabels, 'open' | 'close' | 'new' | 'expand' | 'collapse'> | undefined
  // What the button and the panel's close button draw.
  icon: Snippet
  closeIcon: Snippet
  // The header's buttons: one clears the conversation, one switches the panel between its two sizes.
  newIcon: Snippet
  expandIcon: Snippet
  collapseIcon: Snippet
  // Opens and closes the panel when the page sets it; the button, the close button and Escape work on their own, so it can be left out.
  open?: boolean | undefined
  // Called with the new state when the visitor opens or closes the panel, not when the page sets `open`.
  onOpenChange?: ((event: { open: boolean }) => unknown) | undefined
  // The address fragment that opens the panel, on load and whenever it changes to it; `false` for none.
  hash?: string | false | undefined
}>()

const openLabel = labels.open ?? wording('ai.chat.open', 'Open the chat')
const closeLabel = labels.close ?? wording('ai.chat.close', 'Close the chat')
const newLabel = labels.new ?? wording('ai.chat.new', 'New conversation')
const expandLabel = labels.expand ?? wording('ai.chat.expand', 'Enlarge the chat')
const collapseLabel = labels.collapse ?? wording('ai.chat.collapse', 'Shrink the chat')

const open = signal(wanted === true)
const large = signal(false)
const panelId = uid()
let root: HTMLElement | undefined

// The panel is a card above the round button, whose size the app sets with `--kai-chat-width`, `-height` and their `-large` forms. Set inline, it wins over the side panel's own edge geometry.
function panelStyle() {
  const width = large() ? 'var(--kai-chat-width-large, 56rem)' : 'var(--kai-chat-width, 36rem)'
  const height = large() ? 'var(--kai-chat-height-large, 100dvh)' : 'var(--kai-chat-height, 40rem)'

  return `position: fixed; box-sizing: border-box; padding: 0; z-index: 40; inset: auto max(1rem, env(safe-area-inset-right)) calc(5.25rem + var(--kay-dev-inset-bottom, 0px)) auto; width: min(${width}, calc(100vw - 2rem)); height: min(${height}, calc(100dvh - 7.5rem)); max-width: none; max-height: none; border: 1px solid var(--color-border); border-radius: calc(var(--kai-chat-radius, 0.75rem) + 0.25rem); background-color: var(--color-background); box-shadow: var(--kai-chat-shadow, none); transition: none; translate: none`
}

const dialog = () => root?.querySelector('dialog') ?? null

function show() {
  open = true
  queueMicrotask(() => (dialog()?.querySelector<HTMLElement>('textarea') ?? dialog())?.focus())
}

async function logged(pending: Promise<unknown>) {
  try {
    await pending
  }
  catch (error) {
    console.error(error)
  }
}

// The visitor's own opening or closing, which the page hears of.
function toggle(next: boolean) {
  if (next)
    show()
  else
    open = false

  try {
    const result = onOpenChange?.({ open: next })

    if (result instanceof Promise)
      void logged(result)
  }
  catch (error) {
    console.error(error)
  }
}

// The side panel reports every change, the ones the page made included: only a difference from what is shown is the visitor's.
function changed(event: { open: boolean }) {
  if (event.open !== open())
    toggle(event.open)
}

// The page sets `open`: the panel follows it, the focus where the visitor has it, since nobody pressed a button.
effect(() => {
  const next = wanted

  untrack(() => {
    if (next !== undefined && next !== open())
      open = next
  })
})

// The chat inside is told to start over; it hears the event once the launcher hydrated.
function startOver() {
  dialog()?.querySelector('.kai-chat')?.dispatchEvent(new CustomEvent('kai:chat-new', { detail: {} }))
  queueMicrotask(() => dialog()?.querySelector('textarea')?.focus())
}

// The visitor opening the panel from a link, the address or an event of the page: the same as pressing the button, if it is not open already.
function visitorOpens() {
  if (!open())
    toggle(true)
}

function hashMatches() {
  if (hash !== false && hash !== '' && location.hash === hash)
    visitorOpens()
}

// A link to the fragment opens the panel whether or not the address changes: a second click on it, or a link to another page that the page swap follows, fires no `hashchange`.
function linkClicked(event: MouseEvent) {
  if (hash === false || hash === '' || !(event.target instanceof Element))
    return

  if (event.target.closest('a')?.hash === hash)
    visitorOpens()
}

let disposed = false

const RETRY_MS = 50
const RETRY_LIMIT = 200

// Hands the text to the chat once it is there to hear it: the launcher hydrates when the browser is idle, and a listener cancels the event it takes.
function forward(type: string, text: string, tries = 0) {
  const chat = dialog()?.querySelector('.kai-chat')
  const handled = chat !== null && chat !== undefined && !chat.dispatchEvent(new CustomEvent(type, { detail: type.includes(':') ? { text } : text, cancelable: true }))

  if (!handled && !disposed && tries < RETRY_LIMIT)
    setTimeout(forward, RETRY_MS, type, text, tries + 1)
}

function relay(event: Event) {
  // Only the page's own events, not the ones the chat sends up from inside the panel.
  if (event.target instanceof Node && dialog()?.contains(event.target))
    return

  const text = eventText((event as CustomEvent<unknown>).detail)

  if (text === undefined)
    return

  visitorOpens()
  forward(event.type, text)
}


effect(() => {
  disposed = false
  // Untracked, or the effect would run again as the panel closes and open it once more.
  untrack(hashMatches)
  window.addEventListener('hashchange', hashMatches)
  document.addEventListener('click', linkClicked)
  document.addEventListener('kai:chat-open', visitorOpens)
  document.addEventListener('kai:chat-send', relay)
  document.addEventListener('kai:chat-draft', relay)

  onCleanup(() => {
    disposed = true
    document.removeEventListener('click', linkClicked)
    window.removeEventListener('hashchange', hashMatches)

    document.removeEventListener('kai:chat-open', visitorOpens)
    document.removeEventListener('kai:chat-send', relay)
    document.removeEventListener('kai:chat-draft', relay)
  })
})
---
div(part="root" ref={element => { root = element }})
  SidePanel(id={panelId} open={open()} onOpenChange={changed} modal={false} keep title={label} closeLabel={closeLabel} launcher={openLabel} launcherLayer={40} launcherButton={{ openLabel: closeLabel, size: 'lg', variant: 'solid', tone: 'accent', tooltip: 'left' }} style={panelStyle()} data-large={large()} parts={{ root: 'kai-launcher-panel', launcher: 'kai-launcher-button size-13 rounded-full border-0 bg-[var(--kai-chat-accent,var(--color-accent))] text-accent-foreground shadow-[var(--kai-chat-shadow,none)] hover:bg-accent-hover', body: 'kai-launcher-body flex flex-col px-4 pt-2 pb-3', head: 'px-4 py-2', title: 'text-[0.9375rem]' }})
    @actions
      BareIconButton(part="new" label={newLabel} size="md" variant="ghost" tone="neutral" data-tooltip-placement="bottom span-left" onClick={startOver})
        | {newIcon}
      BareIconButton(part="expand" label={large() ? collapseLabel : expandLabel} size="md" variant="ghost" tone="neutral" data-tooltip-placement="bottom span-left" onClick={() => large = !large()})
        | {large() ? collapseIcon : expandIcon}
    @launcherIcon
      | {icon}
    @launcherOpenIcon
      | {closeIcon}
    @close
      BareIconButton(part="close" label={closeLabel} size="md" variant="ghost" tone="neutral" data-tooltip-placement="bottom span-left" onClick={() => toggle(false)})
        | {closeIcon}
    slot
