---
import { signal } from 'kay'
import { T, t } from 'kay/i18n'

const count = signal(0)
---
div
  button(onClick={() => count.set(value => value + 1)}) {t('counter.label')} {count()}
  p.rich
    T(key="intro" name={String(count())})
      @about(text)
        strong {text}
      @docs(text)
        em {text}
