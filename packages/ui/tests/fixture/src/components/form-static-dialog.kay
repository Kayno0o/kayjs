---
import type { Action } from 'kay'
import { signal } from 'kay'
import FormDialog from '@kaynooo/kayjs-ui/form-dialog.kay'

// The island holding the dialog's state; the fields are the page's, handed in as its slot.
const { claim, validate = false } = props<{ claim: Action<never, string>, validate?: 'blur' | 'submit' | false }>()

const open = signal(false)
---
button#open(onClick={() => open = true}) Open
FormDialog(open={open()} title="Claim" action={claim} validate={validate} submitLabel="Claim" onOpenChange={shown => open = shown})
  slot
