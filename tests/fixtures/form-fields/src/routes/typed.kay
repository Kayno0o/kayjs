--- server
import { action, s } from 'kay'

export const TOPICS = { sales: 'Sales', support: 'Support & help', 'a>b': 'Angle' }

export const typed = action(s.object({
  email: s.email(),
  site: s.url({ optional: true }),
  age: s.int({ min: 18 }),
  price: s.number(),
  born: s.date(),
  agree: s.boolean(),
  consent: s.boolean({ optional: true }),
  cv: s.file({ type: 'application/pdf' }),
  photos: s.files({ type: ['image/png', 'image/jpeg'] }),
  topic: s.enum(TOPICS),
  tier: s.enum(['free', 'pro'], { optional: true }),
  plan: s.union([s.literal('basic'), s.literal('plus')]),
  firstName: s.string({ optional: true }),
  code: s.string({ optional: true, autocomplete: 'one-time-code' }),
}), (_input, ctx) => ctx.deny(409, { message: 'Taken' }))

const record = { born: new Date(Date.UTC(2020, 0, 5, 12)) }
--- script
import RequiredField from '../components/required-field.kay'
---
form(action={typed})
  input(field="email")
  input(field="site" type="text")
  input(field="age")
  input(field="price")
  input(field="born")
  input(field="agree")
  input(field="consent" value="yes" checked)
  input(field="cv")
  input(field="photos")
  select(field="topic")
  select(field="tier")
  select(field="plan" disabled)
  input(field="firstName")
  input(field="code" autocomplete="off")
  textarea(field="firstName")
  button Send
form(action={typed} values={record})
  input(field="born")
  input(field="email" type="email" aria-label="Email")
  input(field="newPassword" type="password" aria-label="Password")
form(action={typed})
  RequiredField
    input(field="cv")
