---
import type { Column } from '@kayjs/ui'
import Table from '@kayjs/ui/table.kay'

interface Moon {
  id: number
  name: string
}

const { rows, expanded, onToggle, narrow } = props<{
  rows: Moon[]
  expanded?: number[]
  onToggle?: (key: number, open: boolean) => void
  narrow?: 'stack' | 'scroll'
}>()

const columns: Column<Moon>[] = [{ key: 'name', header: 'Name' }]
---
Table(columns={columns} rows={rows} rowKey="id" expandable expanded={expanded} onOpenChange={onToggle} narrow={narrow})
  @detail(moon)
    p.more Orbit of {moon.name}
