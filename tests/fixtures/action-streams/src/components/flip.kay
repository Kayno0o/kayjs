---
import type { ActionStream } from 'kay'
import { signal } from 'kay'
import { quiet } from '../routes/index.kay'

// Where the button that starts the stream sits: a block the call's own result removes, as an `if`, a `for` row, a `match` arm or an `await` block's `then`.
const { mode } = props<{ mode: 'if' | 'for' | 'match' | 'await' }>()
const answer = signal<ActionStream<number> | undefined>(undefined)
const waiting = new Promise<never>(() => undefined)
const ready = signal<Promise<unknown>>(Promise.resolve(1))

async function open() {
  answer.set(await quiet())
  ready.set(waiting)
}
---
if mode === 'if'
  if answer() === undefined
    button.begin(type="button" onClick={open}) Begin
  else
    p.shown shown
else if mode === 'for'
  for row of answer() === undefined ? [1] : []
    button.begin(type="button" onClick={open}) Begin
else if mode === 'match'
  match answer() === undefined
    when true
      button.begin(type="button" onClick={open}) Begin
    else
      p.shown shown
else
  await ready()
    p.waiting waiting
  then
    button.begin(type="button" onClick={open}) Begin
p.status {answer()?.status() ?? 'none'}
a.away(href="/other") Away
