---
import { recipe } from 'kay'
import type { JSX } from 'kay'
import type { IconProps } from 'kay/icons'
import type { IconSlot } from './defaults'
import Icon from './icon.kay'

const look = recipe({
  // 'kui-stat-badge' keeps the hairline and the fill of the shell it shares with buttons; the figure alone takes the tone, so the label keeps its text colour. A tile fills its grid cell, the figure large above its label.
  parts: {
    root: 'kui-stat-badge inline-flex items-center gap-kui-inline rounded-kui-card px-2.25 py-0.75 text-xs',
    icon: 'size-4 shrink-0',
    value: 'font-semibold text-kui-text',
    label: 'text-kui-subtext0',
  },
  variants: {
    // `inline` is the pill, figure and label side by side; `tile` is a framed box with the figure above its label, to stack in a grid.
    variant: {
      inline: '',
      tile: {
        root: 'flex flex-col items-start gap-1 px-kui-field-x py-3',
        value: 'text-2xl/none',
        label: 'text-kui-micro font-kui-label tracking-kui-label [font-family:var(--kui-label-font,var(--font-kui-body,inherit))] [text-transform:var(--kui-label-case)]',
      },
    },
    // Colours the figure, such as `danger` past a threshold; `neutral` keeps the text colour.
    tone: {
      neutral: '',
      accent: { value: 'text-kui-accent' },
      success: { value: 'text-kui-success' },
      warning: { value: 'text-kui-warning' },
      danger: { value: 'text-kui-error' },
      info: { value: 'text-kui-info' },
    },
  },
  defaults: { variant: 'inline', tone: 'neutral' },
})

const { value, label, icon, variant = 'inline', tone = 'neutral', ...rest } = props<Omit<JSX.IntrinsicElements['span'], 'class' | 'children'> & {
  value: number | string
  label?: string | undefined
  icon?: IconSlot | IconProps | undefined
}>()
---
// A figure and what it counts, read together: "12 moons".
span({...rest} data-variant={variant === 'tile' ? 'tile' : undefined} data-tone={tone === 'neutral' ? undefined : tone})
  if icon
    Icon(icon={icon} part="icon")
  span(part="value") {value}
  if label
    span(part="label") {label}
