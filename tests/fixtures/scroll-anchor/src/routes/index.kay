--- server
import { t } from 'elysia'
import { action } from 'kay'

const rows = Array.from({ length: 40 }, (_, at) => at + 1)

// A row posted is dropped from the list, as a review list drops the entry it just sorted.
export const sort = action(t.Object({ id: t.String(), category: t.String() }), ({ id }) => {
  rows.splice(rows.indexOf(Number(id)), 1)
})
---
head
  title Rows
h1 Rows
for id of rows
  form(key={id} id={`row-${id}`} action={sort} style="display: block; height: 56px; margin: 0")
    input(type="hidden" name="id" value={id})
    input(type="text" name="note" class={`n${rows.length}`} aria-label={`Note ${id}`})
    select(name="category")
      option(value="") Row {id}
      option(value="a") A
      option(value="b") B
