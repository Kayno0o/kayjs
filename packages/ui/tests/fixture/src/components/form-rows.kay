---
import type { Action } from 'kay'
import { ActionError, signal } from 'kay'
import FormField from '@kaynooo/kayjs-ui/form-field.kay'
import Form from '@kaynooo/kayjs-ui/form.kay'
import RowsField from '@kaynooo/kayjs-ui/rows-field.kay'
import Toaster from '@kaynooo/kayjs-ui/toaster.kay'

// The action refuses with the `errors` it is given, as a handler's refusal of a row cell does.
const { errors } = props<{ errors: Record<string, string> }>()
const columns = [{ key: 'name', label: 'Item' }, { key: 'qty', label: 'Quantity', type: 'number' as const }]
const last = signal<ActionError | undefined>(undefined)

const add = Object.assign(async () => {
  const error = new ActionError(422, '', errors)

  last = error
  throw error
}, {
  [Symbol.for('kay.action')]: true,
  pending: signal(false),
  url: '/_kay/action/form-rows/add',
  failed: () => last() ? { status: last()!.status, errors: last()!.errors } : undefined,
  error: (field = '') => last()?.errors[field],
}) as unknown as Action<unknown, string>
---
Form(action={add} failureLabel="Could not add")
  RowsField#lines(rows={[{ name: 'A', qty: '1' }, { name: 'B', qty: '2' }]} columns={columns} name="line" label="Lines" size="sm")
  FormField(label="Tags" name="tags")
    input#tags(name="tags")
  button#submit(type="submit") Save
Toaster
