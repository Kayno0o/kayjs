--- server
import { formatDate } from 'kay/i18n'
import { wording } from 'kay/words'
import { schemas, scopeLabel } from '../../forms'
import Button from '@kaynooo/kayjs-ui/button.kay'
import CardRow from '@kaynooo/kayjs-ui/card-row.kay'
import EmptyState from '@kaynooo/kayjs-ui/empty-state.kay'
import PageSection from '@kaynooo/kayjs-ui/page-section.kay'

export const revoke = action(schemas.oauthClient, async ({ id }, ctx) => {
  return await ctx.locals.auth.revokeOAuthClient(id) ? 'revoked' : ctx.fail(404, { error: 'not-found' })
})

const clients = await ctx.locals.auth.listOAuthClients()
const date = (value: Date) => formatDate(value, { dateStyle: 'medium' })
---
PageSection(title={wording('auth.account.clients.title', 'Connected apps')})
  .flex.flex-col.gap-2
    p {wording('auth.account.clients.intro', 'These apps signed in to your account. Revoking one ends its access at once.')}
    for client of clients key={client.id}
      CardRow(data-client={client.id})
        @right
          form(action={revoke})
            input(type="hidden" name="id" value={client.id})
            Button(type="submit" tone="danger" label={wording('auth.account.clients.revoke', 'Revoke')} aria-label={`${wording('auth.account.clients.revoke', 'Revoke')}: ${client.name}`})
        .flex.flex-col
          strong {client.name}
          span.text-kui-muted {client.scopes === null ? wording('auth.account.clients.allScopes', 'Everything') : client.scopes.length === 0 ? wording('auth.consent.noScopes', 'Identify you, with no access to the features that need a permission') : client.scopes.map(scopeLabel).join(', ')}
          span.text-kui-muted
            | {wording('auth.account.clients.approved', 'Approved {date}', { date: date(client.createdAt) })} · {client.lastUsedAt ? wording('auth.account.clients.lastUsed', 'Last used {date}', { date: date(client.lastUsedAt) }) : wording('auth.account.clients.neverUsed', 'Never used')}
    else
      EmptyState(title={wording('auth.account.clients.none', 'No app is connected.')})
