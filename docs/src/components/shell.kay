---
import type { Navigation } from '../pages'
import Button from '@kaynooo/kayjs-ui/button.kay'
import Toaster from '@kaynooo/kayjs-ui/toaster.kay'
import CodeCopy from './code-copy.kay'
import LinkFilter from './link-filter.kay'
import Search from './search.kay'

const { nav, current } = props<{ nav: Navigation, current: string }>()
---
a.skip-link(href="#content") Skip to the content
.shell
  aside.side
    header.bar
      a.brand(href="/")
        img(src="/favicon.svg" alt="" width="28" height="28")
        span kay
      Search(persist nav={nav})
      // Shown once the sidebar folds into a popover.
      Button(class="hidden max-[56rem]:inline-flex" label="Menu" icon="menu" popovertarget="sidebar")
    nav#sidebar.sidebar(popover aria-label="Documentation")
      for group of nav.groups key={group.title}
        p.group {group.title}
        ul
          for link of group.links key={link.href}
            li
              a(href={link.href}) {link.title}
      p.group UI components
      LinkFilter(links={nav.components} current={current} label="Filter the components")
      details.full-reference(open={current.startsWith('/llms')})
        summary.group Full reference
        ul
          for link of nav.reference key={link.href}
            li
              a(href={link.href}) {link.title}
  main#content
    slot
    footer.site-foot
      p Built with #[a(href="https://git.kaynooo.fr/kaynooo/kayjs") kay]. #[span(data-page-weight)]
CodeCopy(persist)
Toaster(persist)
