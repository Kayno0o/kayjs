{
  "name": "@kayjs/kay",
  "version": "2.0.0-beta.1",
  "description": "Bun-native TSX web framework with zero-directive automatic islands, fine-grained signals, and single-binary deploys",
  "license": "MIT",
  "homepage": "https://kayjs.kaynooo.fr",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "kay": "./src/cli/index.ts"
  },
  "files": [
    "src"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./dom": "./src/dom/index.ts",
    "./dom-extras": "./src/dom/extras.ts",
    "./dom-loop": "./src/dom/loop.ts",
    "./action": "./src/dom/action.ts",
    "./island": "./src/dom/island.ts",
    "./ssr": "./src/ssr/index.ts",
    "./server": "./src/server/index.ts",
    "./compiler": "./src/compiler/index.ts",
    "./build": "./src/build/index.ts",
    "./dev": "./src/dev/index.ts",
    "./test": "./src/test/index.ts",
    "./jsx-runtime": "./src/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/jsx-runtime.ts"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kayno0o/kayjs",
    "directory": "packages/kay"
  },
  "dependencies": {
    "oxc-parser": "^0.155.0"
  }
}
