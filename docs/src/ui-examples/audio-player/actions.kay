---
import { signal } from 'kay'
import type { AudioChapter } from '@kayjs/ui'
import AudioPlayer from '@kayjs/ui/audio-player.kay'
import IconButton from '@kayjs/ui/icon-button.kay'
import { SILENCE } from './clip'

const chapters: AudioChapter[] = [
  { label: 'Welcome', start: 0 },
  { label: 'The news', start: 5 },
  { label: 'Goodbye', start: 10 },
]
const liked = signal<number[]>([])

function like(index: number) {
  liked = liked().includes(index) ? liked().filter(other => other !== index) : [...liked(), index]
}
---
.max-w-xl
  AudioPlayer(src={SILENCE} chapters={chapters})
    @actions(chapter, index)
      IconButton(icon="star" label={`Like ${chapter.label}`} size="sm" variant="ghost" aria-pressed={liked().includes(index)} onClick={() => like(index)})
