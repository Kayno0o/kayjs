---
import type { Unclickable } from 'kay/edit'
import type { EntryRef } from '../kay/contract'
import type { SavedState } from './live'
import type { FieldPath } from '../markers'
import Button from '@kaynooo/kayjs-ui/button.kay'
import { refresh, resource, untrack } from 'kay'
import { wording } from 'kay/words'
import editorApi from '../api/editor'
import entriesApi from '../api/entries'
import { collectionTitle, deleteMessage, entryTitle, SINGLE_SLUG } from '../listing'
import { BODY, entryKey } from '../markers'
import { drafts } from './drafts'
import { registerInline } from './inline'
import { savedHandler } from './live'
import { readReferrers } from './referrers'
import { rebuildFinished, rebuildStarted } from './rebuild'
import { unfoldAround } from './reorder'
import EntryFields from './entry-fields.kay'
import { formScope } from '../form'
import EntryPresence from '../components/entry-presence.kay'
import EntrySaveState from '../components/entry-save-state.kay'
import Refused from '../components/refused.kay'
import ResetButton from '../components/reset-button.kay'
import ConfirmDelete from '@kaynooo/kayjs-ui/confirm-delete.kay'
import { entryRoom } from '../room'
import { deleteSaved, refuseUnsaved, saveDraft, showRefusal } from './save'
import { saveShortcut } from './shortcut'

const { entry, focus, unclickable = [] } = props<{ entry: EntryRef, focus?: FieldPath | undefined, unclickable?: Unclickable[] }>()

// Named by what the page cannot mark: a value it transforms or shows in an island, and the fields of a frozen object.
const named = (isFrozen: boolean) => unclickable.filter(field => (field.frozen === true) === isFrozen).map(field => field.path).join(', ')
const unmarked = memo(() => named(false))
const frozen = memo(() => named(true))

const source = resource(entriesApi, '/:collection/:slug', {
  params: { collection: entry.collection, slug: entry.slug },
  query: entry.locale === undefined ? {} : { locale: entry.locale },
})
// A single collection's entry is the collection: no slug under its title, its locale still shown. Until the collection is known its slug is taken for a single one's when it is `index`, the only slug a single entry has, so that slug never flashes.
const isSingle = () => { const loaded = source.value(); return loaded === undefined ? entry.slug === SINGLE_SLUG : loaded.collection.single === true }
const subtitle = memo(() => isSingle() ? entry.locale : entry.locale === undefined ? entry.slug : `${entry.slug} (${entry.locale})`)
// The page editor asks no author, so its editors are counted, and named ones are told of them.
const room = entryRoom(entry.collection, entry, { name: '' })
const saving = signal(false)
let created = false
const lastSave = signal<SavedState>()
const onSaved = savedHandler(() => source.value()?.entry.url, saved => lastSave.set(saved), rebuildFinished)
onCleanup(onSaved.stop)
// A click on the page types in the entry's text fields there while this form stands.
onCleanup(registerInline(entryKey(entry), { collection: () => source.value()?.collection, busy: () => saving() }))
// What the signed-in person's role may not do, which locks the fields it covers once the server has said.
const can = resource(editorApi, '/can')
// One scope for as long as the answer stands, so the fields render in the one the notices ask which fields are shown.
const scope = memo(() => {
  const answer = source.value()

  return answer && Object.defineProperty(formScope(drafts, entry, answer.collection), 'denied', { get: () => can.value()?.denied })
})
let box: HTMLElement | undefined

effect(() => {
  const answer = source.value()

  // A file that does not parse opens empty, and saving writes the form over it.
  if (answer)
    drafts.open({ ...entry, data: answer.entry.data ?? {}, body: answer.entry.body }, answer.entry.version)
})

// A click on the page brings its field into view (the unfolding is untracked, or the effect would follow the list's data and folds) and puts the caret in it, once the form has loaded.
effect(() => {
  const path = focus

  if (path === undefined || !source.value() || !box)
    return

  // A group, such as a list item, has no control of its own: its first field stands for it.
  const selector = path === BODY ? '[data-kcms-body]' : `[data-kcms-path="${CSS.escape(path)}"], [data-kcms-path^="${CSS.escape(`${path}.`)}"]`
  const field = box.querySelector(selector)

  if (field)
    untrack(() => unfoldAround(field))

  field?.scrollIntoView({ block: 'nearest' })
  field?.querySelector<HTMLElement>('input, textarea, select')?.focus()
})

// A text that does not parse keeps Save and Reset enabled, so pressing Save says what to fix.
const unsaved = () => drafts.changed(entry) || drafts.blocked(entry).length > 0

async function save(): Promise<void> {
  if (!unsaved() || saving())
    return

  saving = true

  let saved = false

  try {
    // A single collection's seed is no entry yet: the first save writes it.
    saved = await saveDraft(drafts, entry, { create: source.value()?.seeded === true && !created, onSaved: (outcome) => {
      created = true
      onSaved(outcome)

      if (outcome.rebuilding)
        rebuildStarted()
    } })
  }
  finally {
    saving = false
  }

  // The fields are unlocked by now, so the focus can land in one.
  if (!saved)
    await showRefusal(drafts, entry)
}

// Publish and Unpublish change the draft flag alone: with edits not saved they refuse, saving nothing, and a refused save puts the flag back.
const draftField = () => source.value()?.collection.draftField
const isDraft = () => { const field = draftField(); return field !== undefined && drafts.value(entry, field) === true }

async function setDraft(value: boolean): Promise<void> {
  const field = draftField()

  if (field === undefined || saving())
    return

  if (drafts.changed(entry))
    return refuseUnsaved()

  const before = drafts.value(entry, field)

  drafts.set(entry, field, value)
  await save()

  if (drafts.changed(entry))
    drafts.set(entry, field, before)
}

// The entries referring to this one, read when the delete confirmation opens.
const referrers = signal<string[]>([])
const title = () => { const answer = source.value(); return answer ? entryTitle(answer.collection, answer.entry) : entry.slug }

async function askReferrers(): Promise<void> {
  referrers.set([])

  const found = await readReferrers(entry.collection, [entry.slug])

  referrers.set(found[entry.slug] ?? [])
}

// The page the entry rendered is gone with it, so the page is read again.
async function remove(): Promise<void> {
  if (await deleteSaved(entry, source.value()?.entry.version)) {
    drafts.reset(entry)
    await refresh()
  }
}

saveShortcut(save)
---
section.kcms-entry(aria-busy={saving()} ref={element => box = element})
  header.kcms-entry-head
    hgroup
      h3.kcms-entry-title {collectionTitle({ name: entry.collection, title: source.value()?.collection.title })}
      if subtitle() !== undefined
        p.kcms-entry-slug {subtitle()}
    .kcms-entry-actions
      EntrySaveState(changed={drafts.changed(entry)} saving={saving()} saved={lastSave()} url={source.value()?.entry.url})
      ResetButton(disabled={saving() || !unsaved()} onReset={() => drafts.reset(entry)})
      Button(label={saving() ? wording('cms.entry.saving', 'Saving…') : wording('cms.entry.save', 'Save')} tone="accent" busy={saving()} disabled={saving() || !unsaved()} onClick={save})
  // Beside the head, which stays on one line on a phone.
  if source.value() as answer
    .kcms-entry-more
      if draftField() !== undefined
        if can.value()?.denied.publish as reason
          Refused(label={isDraft() ? wording('cms.entry.publish', 'Publish') : wording('cms.entry.unpublish', 'Unpublish')} reason={reason})
        else if isDraft()
          Button(label={wording('cms.entry.publish', 'Publish')} disabled={saving()} onClick={() => setDraft(false)})
        else if drafts.changed(entry)
          Button(label={wording('cms.entry.unpublish', 'Unpublish')} disabled={saving()} onClick={() => setDraft(true)})
        else
          ConfirmDelete(tone="neutral" trigger="button" label={wording('cms.entry.unpublish', 'Unpublish')} message={wording('cms.entry.unpublishMessage', 'Unpublish {title}? Visitors stop seeing it until you publish it again.', { title: title() })} failure={wording('cms.entry.unpublishFailure', 'Could not unpublish')} onConfirm={() => setDraft(true)})
      if !isSingle() && !answer.seeded
        if can.value()?.denied.delete as reason
          Refused(label={wording('cms.bulk.delete', 'Delete')} reason={reason} tone="danger")
        else
          ConfirmDelete(message={deleteMessage(title(), answer.entry.url, 'entry', referrers())} onOpen={askReferrers} failure={wording('cms.save.deleteFailure', 'Could not delete')} trigger="button" onConfirm={remove})
  EntryPresence(room={room.room} member={room.member})
  if source.status() === 'failed'
    p.kcms-entry-failure {wording('cms.entry.loadFailure', 'Could not load this entry: {message}', { message: source.error()?.message ?? '' })}
  else if source.value() as answer
    if answer.entry.problem as problem
      p.kcms-entry-failure(role="alert") {wording('cms.entry.problem', 'This entry\'s file does not parse: {problem}. Saving writes the form over it.', { problem })}
    if unmarked() !== ''
      p.kcms-entry-hint {wording('cms.entry.unclickable', 'A click on the page cannot reach {fields}, which it shows changed or not at all: edit it here.', { fields: unmarked() })}
    if frozen() !== ''
      p.kcms-entry-hint {wording('cms.entry.frozen', 'A click on the page cannot reach {fields}, held by a frozen object: edit it here.', { fields: frozen() })}
    fieldset.kcms-entry-fields(disabled={saving()})
      EntryFields(form={scope()!})
  else
    p.kcms-entry-loading {wording('cms.entry.loading', 'Loading…')}
