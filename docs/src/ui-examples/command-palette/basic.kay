---
import { signal } from 'kay'
import Button from '@kayjs/ui/button.kay'
import CommandPalette from '@kayjs/ui/command-palette.kay'
import type { PaletteEntry } from '@kayjs/ui'
import { toast } from '@kayjs/ui'

const open = signal(false)
const entries: PaletteEntry[] = [
  {
    label: 'New moon',
    group: 'Actions',
    icon: 'plus',
    onSelect: () => toast.info('New moon'),
  },
  {
    label: 'Export',
    group: 'Actions',
    keywords: 'download csv',
    onSelect: () => toast.info('Exported'),
  },
  { label: 'Button', group: 'Pages', href: '/ui/button' },
  { label: 'Dialog', group: 'Pages', href: '/ui/dialog' },
]
---
Button(label="Open the palette" onClick={() => open = true})
CommandPalette(
  open={open()}
  onOpenChange={open.set}
  entries={entries}
  groups={['Actions', 'Pages']}
)
