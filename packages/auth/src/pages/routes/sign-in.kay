--- server
import { localPath } from 'kay'
import { localize } from 'kay/i18n'
import { wording } from 'kay/words'
import Captcha from '../components/captcha.kay'
import Message from '../components/message.kay'
import Panel from '../components/panel.kay'
import PasskeySignIn from '../components/passkey-sign-in.kay'
import ProviderButtons from '../components/provider-buttons.kay'
import Separator from '../components/separator.kay'
import { captchaFor, captchaOf, failure, guarded, oauthFailure, refusal, refusedFor, remembered, rememberOf, schemas } from '../forms'
import Button from '@kaynooo/kayjs-ui/button.kay'
import FormField from '@kaynooo/kayjs-ui/form-field.kay'

// Visitors reach this page before signing in, so none of the app's guards run here, whatever they check: one asking for a session would keep everyone out.
export const page = { guards: false }

export const password = action(schemas.signIn, async (input, ctx) => {
  const result = await ctx.locals.auth.signInWithPassword({ identifier: input.identifier, password: input.password }, { remember: remembered(ctx.locals.auth.features(), input.remember), redirect: input.redirect, captcha: captchaOf(input) })

  if (!result.ok)
    return ctx.fail(400, { error: result.error === 'invalid' ? 'credentials' : refusedFor(result.error, input) })

  return ctx.redirect(localize(result.redirect))
}, guarded)

export const magicLink = action(schemas.magicLink, async (input, ctx) => {
  const result = await ctx.locals.auth.requestMagicLink(input.email, { redirect: input.redirect, captcha: captchaOf(input), remember: remembered(ctx.locals.auth.features(), input.remember) })

  return result.ok ? input.email : ctx.fail(400, { error: refusedFor(result.error, input) })
}, guarded)

export const emailCode = action(schemas.emailCode, async ({ code }, ctx) => {
  const result = await ctx.locals.auth.signInWithEmailCode(code)

  if (!result.ok)
    return ctx.fail(400, { error: result.error === 'invalid' ? 'code' : result.error })

  return ctx.redirect(localize(result.redirect))
})

export const passkeyOptions = action(async (ctx) => ctx.locals.auth.passkeySignInOptions())

export const passkey = action(schemas.passkey, async (input, ctx) => {
  const result = await ctx.locals.auth.signInWithPasskey(input.response, { redirect: input.redirect, remember: remembered(ctx.locals.auth.features(), input.remember) })

  return !result.ok ? ctx.fail(400, { error: result.error }) : ctx.redirect(localize(result.redirect))
})

const auth = ctx.locals.auth
const features = auth.features()
const prefix = features.pages?.prefix ?? features.prefix
const redirect = localPath(ctx.url.searchParams.get('redirect'), localize(features.pages?.home ?? '/'))
const user = await auth.user()

// A guest signs in to keep what they did; anyone else is signed in already.
if (user && !user.guest)
  ctx.redirect(redirect)

const [captchaSignIn, captchaMagic] = await Promise.all([captchaFor(auth, features.captcha, 'sign-in'), captchaFor(auth, features.captcha, 'magic-link')])
const pending = await auth.emailCodePending()
const oauthError = oauthFailure(ctx.url.searchParams.get('error'))
const signInError = refusal(password.failed(), features.captcha)
const mailError = refusal(magicLink.failed(), features.captcha)
const codeError = emailCode.failed()?.data?.error
const mailedTo = magicLink.succeeded()?.data
const { askRemember, providerLinks } = rememberOf(features, redirect, provider => wording('auth.signIn.provider', 'Continue with {provider}', { provider }), features.providers)
const codes = features.codes?.['magic-link'] ?? 'link'
---
head
  title {wording('auth.signIn.title', 'Sign in')}
Panel(title={wording('auth.signIn.title', 'Sign in')})
  if oauthError
    Message(text={oauthError})
  if features.providers.length > 0
    .flex.flex-col.gap-2
      ProviderButtons(providers={providerLinks})
    Separator
  if pending?.type === 'sign-in'
    form.flex.flex-col.gap-3(action={emailCode})
      p {wording('auth.signIn.codeSent', 'Type the code mailed to {email}.', { email: pending.email })}
      FormField(label={wording('auth.code', 'Code')} required)
        input(name="code" inputmode="numeric" autocomplete="one-time-code" required)
      if codeError
        Message(text={failure(codeError)})
      Button(type="submit" tone="accent" label={wording('auth.signIn.codeSubmit', 'Sign in')})
  form.flex.flex-col.gap-3(action={password})
    input(type="hidden" name="redirect" value={redirect})
    FormField(label={wording('auth.signIn.identifier', 'Email or username')} required)
      input(name="identifier" autocomplete="username webauthn" required)
    FormField(label={wording('auth.password', 'Password')} required)
      input(name="password" type="password" autocomplete="current-password" required)
    if askRemember
      label.flex.items-center.gap-2
        input(name="remember" type="checkbox")
        span {wording('auth.remember', 'Keep me signed in')}
    if features.captcha && captchaSignIn.shown
      Captcha(widget={features.captcha} challenge={captchaSignIn.challenge} action="sign-in")
    if signInError
      Message(text={signInError})
    Button(type="submit" tone="accent" label={wording('auth.signIn.submit', 'Sign in')})
    if features.email
      a(href={localize(`${prefix}/reset-password?redirect=${encodeURIComponent(redirect)}`)}) {wording('auth.signIn.forgot', 'Forgot your password?')}
  if features.passkeys
    PasskeySignIn(redirect={redirect} label={wording('auth.signIn.passkey', 'Sign in with a passkey')} failed={failure('invalid')})
  if features.email
    Separator
    if mailedTo && codes === 'link'
      Message(tone="success" text={wording('auth.signIn.sent', 'If an account has this address, a mail is on its way.')})
    form.flex.flex-col.gap-3(action={magicLink})
      input(type="hidden" name="redirect" value={redirect})
      FormField(label={wording('auth.email', 'Email')} required)
        input(name="email" type="email" autocomplete="email" required)
      if askRemember
        label.flex.items-center.gap-2
          input(name="remember" type="checkbox")
          span {wording('auth.remember', 'Keep me signed in')}
      if features.captcha && captchaMagic.shown
        Captcha(widget={features.captcha} challenge={captchaMagic.challenge} action="magic-link")
      if mailError
        Message(text={mailError})
      Button(type="submit" label={codes === 'link' ? wording('auth.signIn.magic', 'Mail me a sign-in link') : wording('auth.signIn.magicCode', 'Mail me a sign-in code')})
  if features.signUp
    p.text-center
      | {wording('auth.signIn.noAccount', 'No account yet?')} #[a(href={localize(`${prefix}/register?redirect=${encodeURIComponent(redirect)}`)}) {wording('auth.signIn.register', 'Create one')}]
