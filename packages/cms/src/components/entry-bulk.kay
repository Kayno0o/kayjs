---
import type { ScreenCollection } from '../kay/contract'
import type { EntryRow } from '../listing'
import Button from '@kaynooo/kayjs-ui/button.kay'
import ConfirmDelete from '@kaynooo/kayjs-ui/confirm-delete.kay'
import { toast } from '@kaynooo/kayjs-ui'
import { refresh } from 'kay'
import { wording } from 'kay/words'
import { bulk } from '../editor/bulk'
import { bulkDeleteMessage } from '../bulk-message'
import type { BulkAction } from '../editor/bulk'

// The actions on the rows ticked in the list, each saved one after another and told in one toast.
const { collection, rows, actions, clear } = props<{ collection: ScreenCollection, rows: EntryRow[], actions: ReadonlySet<string>, clear: () => void }>()

const targets = () => rows.map(row => ({ ref: { collection: collection.name, slug: row.slug, locale: row.locale }, version: row.version }))
const drafts = () => collection.draftField !== undefined

async function run(action: BulkAction): Promise<void> {
  const { done, failed } = await bulk(action, targets())

  if (done > 0) {
    if (action === 'publish')
      toast.success(wording('cms.bulk.published', done === 1 ? '1 entry published' : '{count} entries published', { count: done }))
    else if (action === 'unpublish')
      toast.success(wording('cms.bulk.unpublished', done === 1 ? '1 entry unpublished' : '{count} entries unpublished', { count: done }))
    else
      toast.success(wording('cms.bulk.deleted', done === 1 ? '1 entry deleted' : '{count} entries deleted', { count: done }))
  }

  if (failed > 0)
    toast.error(wording('cms.bulk.failed', failed === 1 ? '1 entry could not be changed' : '{count} entries could not be changed', { count: failed }))

  clear()
  await refresh()
}
---
if actions.has('publish') && drafts()
  Button(label={wording('cms.entry.publish', 'Publish')} onClick={() => run('publish')})
if actions.has('unpublish') && drafts()
  ConfirmDelete(tone="neutral" trigger="button" label={wording('cms.entry.unpublish', 'Unpublish')} message={wording('cms.bulk.unpublishMessage', rows.length === 1 ? 'Unpublish 1 entry? Visitors stop seeing it until you publish it again.' : 'Unpublish {count} entries? Visitors stop seeing them until you publish them again.', { count: rows.length })} failure={wording('cms.entry.unpublishFailure', 'Could not unpublish')} onConfirm={() => run('unpublish')})
if actions.has('delete')
  ConfirmDelete(trigger="button" label={wording('cms.bulk.delete', 'Delete')} message={bulkDeleteMessage(rows)} failure={wording('cms.save.deleteFailure', 'Could not delete')} onConfirm={() => run('delete')})
