--- server
import { t } from 'elysia'
import { action } from 'kay'

export const sign = action(t.Object({
  title: t.String({ minLength: 3, maxLength: 40, error: 'Too short' }),
}), (_input, ctx) => ctx.fail(409, 'Full'))
---
form.sign(action={sign})
  error
  input(type="hidden" name="noValidate")
  input(type="hidden" name="elements")
  input(type="hidden" name="requestSubmit")
  input(type="hidden" name="reportValidity")
  input(type="hidden" name="style")
  input(field="title")
  error title
  button Sign
