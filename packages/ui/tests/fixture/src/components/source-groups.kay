--- island
import ChipGroup from '@kayjs/ui/chip-group.kay'
import RadioGroup from '@kayjs/ui/radio-group.kay'
import Segmented from '@kayjs/ui/segmented.kay'

const { source, calls } = props<{ source: () => Promise<{ value: string, label: string }[]>, calls: string[] }>()
---
RadioGroup#radios(options={source} label="Plan" onLoad={(options, query) => calls.push(`radios ${options.length}:${query}`)} onError={failure => calls.push(`radios error ${failure.query}`)})
Segmented#segments(options={source} label="Plan" name="plan")
ChipGroup#chips(options={source} label="Plans" value={['b']})
