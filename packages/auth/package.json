{
  "name": "@kayjs/auth",
  "type": "module",
  "version": "1.112.2",
  "description": "Auth for kay apps on kay sessions: OAuth, passwords, two-factor, magic links and bearer tokens",
  "author": "Kaynooo <https://github.com/Kayno0o>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kayno0o/kayjs",
    "directory": "packages/auth"
  },
  "bugs": {
    "url": "https://github.com/Kayno0o/kayjs/issues"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./add": "./src/add.ts",
    "./browser": {
      "types": "./types/browser.d.ts",
      "default": "./src/browser.ts"
    },
    "./test": "./src/test.ts",
    "./rules": {
      "types": "./types/rules.d.ts",
      "default": "./src/rules.ts"
    },
    "./components/*.kay": "./src/components/*.kay",
    "./pages/*.kay": "./src/pages/routes/*.kay",
    "./pg": {
      "types": "./types/pg.d.ts",
      "default": "./src/pg.ts"
    },
    "./sqlite": {
      "types": "./types/sqlite.d.ts",
      "default": "./src/sqlite.ts"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "llms",
    "llms.txt",
    "src",
    "types"
  ],
  "kay": {
    "messages": "./src/messages"
  },
  "engines": {
    "bun": ">=1.4.5"
  },
  "scripts": {
    "check": "$npm_execpath check && $npm_execpath ../../src/cli.ts check tests/fixture",
    "build:types": "rm -rf types && $npm_execpath ../../src/tsgo.ts -p tsconfig.build.json",
    "prepack": "$npm_execpath run build:types && $npm_execpath ../../scripts/pack-links.ts rewrite ../..",
    "postpack": "rm -rf types && $npm_execpath ../../scripts/pack-links.ts restore ../..",
    "prelint": "$npm_execpath run --cwd ../.. build:eslint",
    "lint": "$npm_execpath ../../scripts/lint-cache.ts && keslint --cache",
    "prelint:fix": "$npm_execpath run --cwd ../.. build:eslint",
    "lint:fix": "$npm_execpath ../../scripts/lint-cache.ts && keslint --fix --cache",
    "test": "$npm_execpath test --parallel=${KAY_TEST_WORKERS:-6} --timeout 20000 --path-ignore-patterns='**/{pgStore,lastOne,sharedDatabase}.test.ts' && $npm_execpath test --isolate --timeout 20000 pgStore.test lastOne.test sharedDatabase.test"
  },
  "peerDependencies": {
    "@kayjs/ui": "workspace:~",
    "@kaynooo/pg-orm": "^8.0.0 || ^9.0.0",
    "elysia": "^1.4.31",
    "kay": "~1.112.0"
  },
  "peerDependenciesMeta": {
    "@kaynooo/pg-orm": {
      "optional": true
    }
  },
  "dependencies": {
    "@kaynooo/utils": "^3.2.0",
    "jose": "^6.2.13"
  },
  "devDependencies": {
    "@kayjs/mail": "workspace:~",
    "@kayjs/ui": "workspace:~",
    "@kaynooo/eslint": "^8.0.3",
    "@kaynooo/pg-orm": "^9.0.0",
    "@types/bun": "^1.4.4",
    "elysia": "^1.4.31",
    "typescript": "^6.0.3"
  }
}
