---
import { signal } from 'kay'
import Button from '@kayjs/ui/button.kay'
import CommandPalette from '@kayjs/ui/command-palette.kay'
import type { PaletteEntry } from '@kayjs/ui'
import { toast } from '@kayjs/ui'

const open = signal(false)
const entries: PaletteEntry[] = [
  {
    label: 'Export report',
    group: 'Actions',
    icon: 'star',
    keywords: 'download csv spreadsheet',
    onSelect: () => toast.info('Exported'),
  },
  {
    label: 'Archive project',
    group: 'Actions',
    keywords: 'hide close',
    onSelect: () => toast.info('Archived'),
  },
  { label: 'Settings', group: 'Pages', href: '/ui/button' },
  {
    label: 'Billing',
    group: 'Pages',
    keywords: 'invoice payment',
    href: '/ui/dialog',
  },
]
---
.flex.flex-wrap.items-center.gap-3
  Button(label="Open the palette" onClick={() => open = true})
  p.text-muted Try "csv" or "invoice".
CommandPalette(
  open={open()}
  onOpenChange={open.set}
  entries={entries}
  groups={['Actions', 'Pages']}
)
