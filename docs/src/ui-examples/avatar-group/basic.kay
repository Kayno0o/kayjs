---
import AvatarGroup from '@kaynooo/kayjs-ui/avatar-group.kay'

const team = [
  { name: 'Ada Lovelace', status: 'online' as const },
  { name: 'Grace Hopper', href: '/ui/avatar' },
  { name: 'Linus Torvalds' },
  { name: 'Margaret Hamilton', status: 'away' as const },
  { name: 'Dennis Ritchie' },
]
---
AvatarGroup(avatars={team} max={3} label="Team")
