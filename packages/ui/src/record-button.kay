---
import type { Duration } from 'kay'
import { durationMs, recipe } from 'kay'
import { wording } from 'kay/words'
import Button from './button.kay'
import Notice from './notice.kay'
import { elapsed, RECORD_LIMIT, recorder, recordWords } from './record'

// 'kui-record' stays as the component's name for an app's CSS. The variants are the Button's, handed to it.
const look = recipe({
  parts: {
    root: 'kui-record inline-flex flex-wrap items-center gap-2',
    button: '',
    time: 'text-sm text-muted tabular-nums',
    live: 'sr-only',
    problem: 'basis-full',
  },
  variants: {
    // As a Button's: `solid` is the framed button, `ghost` has no frame until hovered and `inline` reads as a link.
    variant: { solid: '', ghost: '', inline: '' },
    // As a Button's: `accent` for the main action.
    tone: { neutral: '', accent: '', success: '', danger: '' },
    size: { xs: '', sm: '', md: '', lg: '' },
  },
  defaults: { variant: 'solid', tone: 'neutral', size: 'md' },
})

const { onRecord, label = wording('ui.recordButton.label', 'Record'), failure = wording('ui.recordButton.failure', 'The recording could not be sent.'), maxDuration = RECORD_LIMIT, variant = 'solid', tone = 'neutral', size = 'md' } = props<{
  // Takes what was said as a `File`, `recording.webm` (`recording.m4a` in Safari), which an action's `s.File()` field takes as it is. A promise it returns holds the button busy until it settles, and a rejection says `failure`.
  onRecord: (audio: File) => unknown
  // Names the button, which stays pressed while it records: a press starts, the next stops and hands the recording over, and Escape drops it.
  label?: string | undefined
  // Said when the promise of `onRecord` rejects.
  failure?: string | undefined
  // How long a recording runs before it stops and is handed over as if pressed, `5m` by default, so one left running does not outgrow the action's `maxSize`.
  maxDuration?: Duration | undefined
}>()

const voice = recorder({ onAudio: audio => onRecord(audio), words: recordWords(), failure, maxMs: durationMs(maxDuration) })

function key(event: KeyboardEvent) {
  // Drops the recording and nothing else, such as a dialog around the button closing.
  if (event.key === 'Escape' && voice.cancel())
    event.preventDefault()
}
---
div(part="root")
  Button(part="button" variant={variant} tone={tone} size={size} icon={voice.state() === 'recording' ? 'stop' : 'microphone'} label={label} pressed={voice.state() === 'recording'} busy={voice.state() === 'asking' || voice.state() === 'sending'} onClick={voice.press} onKeyDown={key})
  // The time ticks every second, so it is shown and not read; the status region says when recording starts and stops.
  if voice.state() === 'recording'
    span(part="time" aria-hidden="true") {elapsed(voice.seconds())}
  span(part="live" role="status") {voice.said()}
  if voice.problem()
    Notice(part="problem" tone="danger" label={voice.problem()})
