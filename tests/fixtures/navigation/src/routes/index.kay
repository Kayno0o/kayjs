--- server
import { t } from 'elysia'
import { action } from 'kay'
import { store } from '../state'

export const bump = action(t.Object({}), () => {
  store.bumps++
})

// A form on the page the swap leaves, whose schema must not stand in for the next page's.
export const note = action(t.Object({ text: t.String({ maxLength: 5 }) }), () => undefined)

const bumps = store.bumps
---
---
import Bump from '../components/bump.kay'
---
head
  title Home
h1 Home
p.bumps Bumped {bumps}
Bump
form(action={note})
  input(name="text")
  button.note Note
div(style="height: 3000px")
