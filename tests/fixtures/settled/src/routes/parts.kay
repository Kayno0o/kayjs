--- server
async function* words() {
  yield 'one'
  await Bun.sleep(20)
  yield 'two'
}

const rows = words()
const nothing = Promise.resolve('')
const broken = Promise.reject(new Error('no'))
broken.catch(() => undefined)
---
p.shell Shell
await rows
  p.pending Waiting
then text
  p.word {text}
// kay-allow uncaught-await
await nothing
  p.gone Gone
then text
  | {text}
// kay-allow uncaught-await
await broken
  p.fail Failing
then value
  p {value}
catch error
  p.caught Caught
