---
import type { Action, FormFailure } from 'kay'
import { effect, untrack } from 'kay'

// Reports how a form posting to `action` went to the app, drawing nothing. ContactForm and SubscribeForm render it only when given `onSend` or `onError`, so a form that asks for neither stays static and ships no JavaScript.
// The callbacks are not named `on*`: an `onX` attribute on a component makes the component passing it an island, which the forms rendering this would then be even with no callback given.
const { action, whenSent, whenRefused } = props<{
  action: Action<never, unknown>
  whenSent?: ((data: unknown) => unknown) | undefined
  whenRefused?: ((failure: FormFailure<never, unknown>) => unknown) | undefined
}>()

effect(() => {
  const done = action.succeeded()

  if (done) {
    untrack(() => whenSent?.(done.data))
  }
})

effect(() => {
  const failure = action.failed()

  if (failure)
    untrack(() => whenRefused?.(failure))
})
---
| {''}
