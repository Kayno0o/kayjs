---
import type { ScreenCollection } from '../kay/contract'
import type { TranslationRow } from '../translations'
import EmptyState from '@kaynooo/kayjs-ui/empty-state.kay'
import { wording } from 'kay/words'
import { BODY_FIELD } from '../translations'
import { collectionTitle, entryPath, translatePath } from '../listing'

// The entries of one localized collection that lack a locale or hold a text still as the default locale's.
const { prefix, collection, rows } = props<{ prefix: string, collection: ScreenCollection, rows: TranslationRow[] }>()

const base = collection.defaultLocale ?? collection.locales?.[0] ?? ''
const link = (locale: string, slug: string) => entryPath(prefix, { collection: collection.name, slug, locale })
const label = (field: string) => field === BODY_FIELD ? wording('cms.locales.body', 'Body') : field
---
section.kcms-translations
  h2 {collectionTitle(collection)}
  if rows.length === 0
    EmptyState(title={wording('cms.locales.complete', 'Every entry is translated')})
  else
    ul
      for row of rows key={row.key}
        li
          strong {row.slugs[base] ?? row.key}
          for locale of row.missing key={locale}
            |  
            if row.slugs[base] as slug
              a(href={translatePath(prefix, { collection: collection.name, slug, locale: base }, locale)}) {wording('cms.locales.translate', 'Translate to {locale}', { locale })}
            else
              span {wording('cms.table.missingLocales', 'No {locales}', { locales: locale })}
          for gap of Object.entries(row.gaps) key={gap[0]}
            |  
            a(href={link(gap[0], row.slugs[gap[0]] ?? row.key)}) {gap[0]}
            |  {gap[1].map(item => `${label(item.field)} (${item.gap === 'same' ? wording('cms.locales.sameShort', 'same') : wording('cms.locales.emptyShort', 'empty')})`).join(', ')}
