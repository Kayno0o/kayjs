--- server
import { t } from 'kay'
import { FAILURE_WORDS, PASSWORD_WORDS } from '../words'

export const query = t.Object({ token: t.Optional(t.String()) })

export const request = action(t.Object({ email: t.String({ maxLength: 254 }) }), async ({ email }, ctx) => {
  const result = await ctx.locals.auth.requestPasswordReset(email)

  if (!result.ok)
    return ctx.fail(result.error === 'limited' ? 429 : 503, { error: result.error })

  return { sent: true }
})

export const choose = action(t.Object({ token: t.String(), password: t.String({ maxLength: 128 }) }), async ({ token, password }, ctx) => {
  const result = await ctx.locals.auth.resetPassword(token, password)

  if (!result.ok)
    return ctx.fail(400, 'errors' in result ? { errors: result.errors } : { error: result.error })

  return ctx.redirect(result.redirect)
})

const requestFailure = ctx.failed(request)?.data?.error
const refused = ctx.failed(choose)?.data
const passwordIssue = refused?.errors?.password && PASSWORD_WORDS[refused.errors.password]
const chooseFailure = refused?.error
const token = ctx.query.token
---
---
import Button from '@kaynooo/kayjs-ui/button.kay'
import FormField from '@kaynooo/kayjs-ui/form-field.kay'
---
head
  title Reset your password
h1.text-2xl.font-bold Reset your password
if token
  form.page-form(action={choose})
    input(type="hidden" name="token" value={token})
    FormField(label="New password" hint="10 characters or more" issue={passwordIssue} required)
      input(name="password" type="password" autocomplete="new-password" required)
    if chooseFailure === 'invalid'
      p.text-kui-error This link has expired or was already used.
    else if chooseFailure
      p.text-kui-error {FAILURE_WORDS[chooseFailure]}
    Button(label="Set the password" variant="accent" type="submit")
else
  form.page-form(action={request})
    FormField(label="Email" required)
      input(name="email" type="email" autocomplete="email" required)
    if request.succeeded()
      p.text-kui-success If a member has this address, a link to reset the password is on its way.
    if requestFailure
      p.text-kui-error {FAILURE_WORDS[requestFailure]}
    Button(label="Mail me a link" variant="accent" type="submit")
