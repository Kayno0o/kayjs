---
import type { ButtonProps, TagAttributes } from '../button-props'
import { recipe, signal } from 'kay'
import { buttonOf, linkOf } from '../button-props'
import { isPromiseLike } from '../change'
import Icon from '../icon.kay'

// Button hands its root classes down as `class`, so its recipe and `src/ui.ts` reach this root as well; the spinner is this component's own part.
const look = recipe({ parts: { spinner: 'kui-spinner' } })

const { variant = 'solid', tone, size = 'md', icon, busy, label, onClick, ...rest } = props<ButtonProps>()

const attributes = rest as TagAttributes

const pending = signal(false)
const spinning = () => busy ?? pending()

async function press(event: MouseEvent) {
  if (busy === undefined && pending()) {
    event.preventDefault()

    return
  }

  const answer: unknown = (onClick as ((event: MouseEvent) => unknown) | undefined)?.(event)

  if (!isPromiseLike(answer))
    return

  pending.set(true)

  // Logged rather than thrown, as a Toggle's: the button coming back is what the user sees.
  try {
    await answer
  }
  catch (error) {
    console.error('kayjs-ui: a Button\'s onClick failed', error)
  }
  finally {
    pending.set(false)
  }
}
---
if linkOf(attributes) as link
  a({...link} part="root" data-variant={variant} data-size={size} aria-busy={spinning() ? 'true' : undefined} onClick={press})
    if spinning()
      Icon(icon="spinner" part="spinner")
    else if icon
      Icon(icon={icon})
    | {label}
    slot
else if buttonOf(attributes) as button
  button({...button} part="root" data-variant={variant} data-size={size} disabled={button.disabled || (busy === undefined && pending() && button.type !== 'submit' && button.type !== 'reset')} aria-busy={spinning() ? 'true' : undefined} onClick={press})
    if spinning()
      Icon(icon="spinner" class="kui-spinner")
    else if icon
      Icon(icon={icon})
    | {label}
    slot
