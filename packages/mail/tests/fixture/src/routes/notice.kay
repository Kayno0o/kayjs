--- server
import { action } from 'kay'
import { mail } from '../mail'

export const subscribeNoticed = action(...mail.list('spring', { title: 'Spring news', privacy: '/privacy' }).form())
---
form(action={subscribeNoticed} novalidate)
  label
    | Email
    input(field="email" type="email" autocomplete="email")
  p One mail a month about the spring season.
  input(type="hidden" name="wording" value="spring-v1")
  button(type="submit") Subscribe
