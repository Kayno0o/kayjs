--- <Item extends BellItem>
import type { Snippet } from 'kay'
import type { BellItem, BellItems } from './bell'
import type { PopoverPlacement } from './popover'
import { call, effect, recipe, resource, signal } from 'kay'
import { wording } from 'kay/words'
import inboxApi from './api/inbox'
import IconButton from './icon-button.kay'
import { MENU_FOOTER, MENU_ITEM, MENU_LIST } from './menu-look'
import { OUTSIDE } from './outside'
import Popover from './popover.kay'

const look = recipe({
  parts: {
    root: 'kui-bell relative inline-flex',
    count: 'pointer-events-none absolute -end-1 -top-1 grid min-w-4 place-items-center rounded-full bg-accent px-1 text-[0.625rem]/4 font-semibold text-accent-foreground',
    // The same look as the popover, list and items of a Menu.
    menu: 'kui-menu min-w-48',
    list: MENU_LIST,
    item: MENU_ITEM,
    dot: 'size-2 shrink-0 rounded-full bg-accent data-read:bg-transparent',
    title: 'min-w-0 flex-1 truncate',
    empty: 'px-2 py-1.5 text-sm text-muted',
    unread: 'sr-only',
    announce: 'sr-only',
    all: MENU_FOOTER,
  },
})

const { label = wording('ui.bell.label', 'Notifications'), placement = 'bottom-end', items: source, unread: unreadCount, onRead, onOpenChange, item: drawRow } = props<{
  // Names the button and the list it opens; the `ui.bell.label` message by default.
  label?: string | undefined
  placement?: PopoverPlacement | undefined
  // The app's own notifications in place of the signed-in visitor's inbox: a list, or a function answering one.
  items?: BellItems<Item> | undefined
  // The unread count of a custom source; the unread items of `items` by default.
  unread?: number | undefined
  // Called with the id of an item opened, or `undefined` for "Mark all as read". The inbox is marked first when it is the source; a custom source marks here, and a promise is awaited before the list is asked again.
  onRead?: ((id: string | undefined) => unknown) | undefined
  onOpenChange?: ((open: boolean) => unknown) | undefined
  // Draws each row in place of its dot and title: `@item(note)`.
  item?: Snippet<[note: Item]> | undefined
}>()

// The routes answer a path of the site or an http(s) URL only; checked again here, as the link is drawn.
const LINKED = /^(?:\/(?![/\\])|https?:\/\/)/
const WEB = /^https?:\/\//
const custom = source !== undefined
const inbox = custom ? undefined : resource(inboxApi, '/')
// A function source is asked once the Bell is in the page, again when a signal it reads changes and after a read.
const asked = typeof source === 'function' ? resource(async () => await source()) : undefined

const items = (): readonly BellItem[] => {
  if (!custom)
    return inbox?.value()?.items ?? []

  return typeof source === 'function' ? asked?.value() ?? [] : source
}
const unread = () => custom ? unreadCount ?? items().filter(note => !note.read).length : inbox?.value()?.unread ?? 0
const linked = (url: string | undefined) => url !== undefined && LINKED.test(url) ? url : undefined
const external = (url: string | undefined) => url !== undefined && WEB.test(url)

// A live region naming a notification that arrives while the page is open; the first load announces nothing.
const announced = signal('')
let known: Set<string> | undefined

effect(() => {
  if (typeof source === 'function' ? asked?.value() === undefined : inbox?.value() === undefined)
    return

  const fresh = items().find(note => !note.read && known !== undefined && !known.has(note.id))

  known = new Set(items().map(note => note.id))

  if (fresh)
    announced = wording('ui.bell.new', 'New notification: {title}', { title: fresh.title })
})

// A failed call changes nothing: the live update or the next visit shows how the inbox stands.
async function send(id?: string) {
  if (!custom) {
    try {
      await call(inboxApi, '/read', { method: 'post', body: id === undefined ? {} : { id } })
    }
    catch {
      // nothing to undo
    }
  }

  try {
    await onRead?.(id)
  }
  catch (error) {
    console.error('kayjs-ui: a Bell could not run its onRead', error)
  }

  inbox?.refresh()
  asked?.refresh()
}
---
span(part="root")
  Popover(placement={placement} part="menu" onOpenChange={onOpenChange})
    @trigger(attributes)
      IconButton({...attributes} icon="bell" label={unread() > 0 ? wording('ui.bell.unread', '{label}, {count} unread', { label, count: unread() }) : label} variant="ghost" aria-haspopup="true")
    div(part="list" aria-label={label})
      if items().length === 0
        p(part="empty") {wording('ui.bell.empty', 'No notifications')}
      for note of items() key={note.id}
        if linked(note.url) as url
          a(part="item" href={url} {...external(url) ? OUTSIDE : {}} onClick={() => send(note.id)})
            if drawRow
              | {drawRow(note as Item)}
            else
              span(part="dot" data-read={note.read ? '' : undefined} aria-hidden="true")
              span(part="title") {note.title}
            if !note.read
              span(part="unread") {wording('ui.bell.unreadMark', '(unread)')}
        else
          button(part="item" type="button" onClick={() => send(note.id)})
            if drawRow
              | {drawRow(note as Item)}
            else
              span(part="dot" data-read={note.read ? '' : undefined} aria-hidden="true")
              span(part="title") {note.title}
            if !note.read
              span(part="unread") {wording('ui.bell.unreadMark', '(unread)')}
      if unread() > 0
        button(part="all" type="button" onClick={() => send()}) {wording('ui.bell.markAll', 'Mark all as read')}
  span(part="announce" role="status") {announced()}
  if unread() > 0
    span(part="count" aria-hidden="true") {unread() > 99 ? '99+' : unread()}
