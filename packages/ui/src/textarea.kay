---
import type { JSX } from 'kay'
import { untrack } from 'kay'
import { controlledValue } from './controlled-value'
import { startRef } from './form-reset'

const { value, onInput, onChange, onBlur, class: className, ...rest } = props<Omit<JSX.IntrinsicElements['textarea'], 'value' | 'class' | 'children' | 'onInput' | 'onChange'> & {
  // Without it, the box starts empty and keeps what is typed, for a form posting it by its `name`.
  value?: string | undefined
  onInput?: ((value: string) => void) | undefined
  // Called once the value is committed, on blur, after `onInput`.
  onChange?: ((value: string) => void) | undefined
  class?: string | undefined
}>()

let box: HTMLTextAreaElement | undefined

// The parent may write back its own reading of the text, such as without the blank line just typed: the box takes it once left, never while focused, which would throw the caret to the end.
const { heard, sync } = controlledValue({
  box: () => box,
  value: () => value,
  writable: element => document.activeElement !== element,
  report: (element) => {
    heard(element.value)
    ;(onInput ?? onChange)?.(element.value)
  },
})

// The box starts once: its default is what it was first drawn with.
const ref = startRef<HTMLTextAreaElement>((element) => {
  const start = untrack(() => value)

  box = element

  if (start !== undefined)
    element.defaultValue = start
}, rest.ref)

---
textarea.kui-field-input({...rest} ref={ref} value={untrack(() => value)} class={className} onInput={event => { heard(event.currentTarget.value); onInput?.(event.currentTarget.value) }} onChange={event => { heard(event.currentTarget.value); onChange?.(event.currentTarget.value) }} onBlur={event => { sync(true); onBlur?.(event) }})
