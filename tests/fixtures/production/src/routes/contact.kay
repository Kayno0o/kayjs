--- server
import { t } from 'elysia'
import { action } from 'kay'

export const send = action({ input: t.Object({ message: t.String({ maxLength: 200 }) }), protect: { rateLimit: { max: 2, window: '1m' }, honeypot: 'website' } }, ({ message }) => message.length)
// Refused in the site's own language.
export const write = action({ input: t.Object({ message: t.String({ maxLength: 2000 }) }), protect: { rateLimit: { max: 1, window: '1m' }, honeypot: 'website' }, maxSize: '1kb', messages: { honeypot: 'Laissez ce champ vide', rateLimit: wait => `Réessayez dans ${wait} s`, maxSize: bytes => `${bytes} octets au plus` } }, ({ message }) => message.length)

const failure = send.form.failed()
const sent = send.status() === 'ready'
---
form(action={send})
  input(name="message" aria-label="Message")
  button Send
if failure
  p.error {failure.status} {Object.values(failure.errors).join(' ')}
if sent
  p.sent Sent {send.data()}
