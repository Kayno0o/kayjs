--- server
import { t } from 'elysia'
import { action } from 'kay'

// A person takes 3 s to ask; a post sooner is refused, or answered as sent for `quick`.
export const ask = action({ input: t.Object({ message: t.String({ maxLength: 200 }) }), protect: { minTime: '3s' } }, ({ message }) => message.length)
export const quick = action({ input: t.Object({ message: t.String({ maxLength: 200 }) }), protect: { minTime: { after: '3s', ttl: '1h', pretend: true } } }, ({ message }) => message.length)

const failure = ask.form.failed()
const asked = ask.status() === 'ready'
const sent = quick.status() === 'ready'
---
form(action={ask})
  input(name="message" aria-label="Message")
  button Ask
if failure
  p.error {failure.status} {Object.values(failure.errors).join(' ')}
if asked
  p.asked Asked {ask.data()}
form(action={quick})
  input(name="message" aria-label="Message")
  button Send
if sent
  p.sent Sent {quick.data()}
