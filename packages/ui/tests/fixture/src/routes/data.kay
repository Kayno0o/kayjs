---
import BarList from '@kaynooo/kayjs-ui/bar-list.kay'
import CopyButton from '@kaynooo/kayjs-ui/copy-button.kay'
import MediaGallery from '@kaynooo/kayjs-ui/media-gallery.kay'
import Meter from '@kaynooo/kayjs-ui/meter.kay'
import Progress from '@kaynooo/kayjs-ui/progress.kay'
import Rating from '@kaynooo/kayjs-ui/rating.kay'
import SiteFavicon from '@kaynooo/kayjs-ui/site-favicon.kay'
import Skeleton from '@kaynooo/kayjs-ui/skeleton.kay'
import Stat from '@kaynooo/kayjs-ui/stat.kay'
---
main
  article#stat
    Stat(value={12} label="moons" icon="info")
  article#meter
    Meter(value={140} label="Disk" fillClass="bg-kui-error")
  article#skeleton
    Skeleton(lines={3} label="Loading")
  article#avatar-skeleton
    Skeleton(shape="avatar" width="4rem")
  article#progress
    Progress(value={42.6} label="Export")
  article#progress-max
    Progress(value={0.5} max={1} label="Upload")
  article#indeterminate
    Progress(label="Loading")
  article#meter-max
    Meter(value={3} max={4} label="Quota")
  article#bars
    BarList(rows={[{ key: 'mars', label: 'Mars', value: 2 }, { key: 'earth', label: 'Earth', value: 1, display: 'one' }, { key: 'venus', label: 'Venus', value: 0 }]})
  article#no-bars-label
    BarList(rows={[]} emptyLabel="No visits")
  article#no-bars-default
    BarList(rows={[]})
  article#no-media
    MediaGallery(items={[]} emptyLabel="No photos")
  article#no-media-default
    MediaGallery(items={[]})
  article#favicon
    SiteFavicon(src="/favicon.png" name="kaynooo.fr")
  article#no-favicon
    SiteFavicon(name="kaynooo.fr")
  article#copy
    CopyButton(text="https://kaynooo.fr" label="Copy link")
  article#copy-accent
    CopyButton(text="https://kaynooo.fr" label="Copy link" tone="accent")
  article#rating
    Rating(value={4.6})
  article#rating-out
    Rating(value={9} max={4} label="Top marks")
  article#rating-below
    Rating(value={-1})
  article#rating-nan
    Rating(value={Number.NaN})
  article#rating-none
    Rating(value={3} max={0})
