--- server
import { t } from 'elysia'
import { action } from 'kay'
import { addTodo, listTodos } from '../data'

export const add = action(t.Object({ title: t.String({ minLength: 1 }) }), async ({ title }) => (await addTodo(title)).id)

const todos = await listTodos()
const open = todos.filter(todo => !todo.done).length
---
---
import Card from '../components/card.kay'
import Counter from '../components/counter.kay'
---
Card(title="Todos")
  p {open} open
  ul
    for todo of todos key={todo.id}
      li: a(href={`/todos/${todo.id}`}) {todo.title}
  form.add(action={add})
    input(name="title" placeholder="New todo")
    button Add
Counter(start={open})
