---
import ConfirmDelete from '@kaynooo/kayjs-ui/confirm-delete.kay'
import Toaster from '@kaynooo/kayjs-ui/toaster.kay'

// A ConfirmDelete whose call always fails, the failure words left to the test's props.
const { words } = props<{ words: { failureLabel?: string, failure?: string } }>()

---
ConfirmDelete(message="Sure?" onConfirm={async () => Promise.reject(new Error('down'))} {...words})
Toaster
