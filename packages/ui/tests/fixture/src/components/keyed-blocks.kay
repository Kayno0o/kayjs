--- island
import TreeView from '@kayjs/ui/tree-view.kay'

// A list under the names before 1.100: its blocks still read `key`, typed as set. A cast keeps the upgrade lint from rewriting it.
function old<T>(items: unknown): T {
  return items as T
}
const nodes = old<{ id: string, label: string }[]>([{ id: 'root', label: 'Root' }])
const keyOf = (key: string) => key
---
TreeView#tree(nodes={nodes} label="Files")
  @actions(node)
    span.node {keyOf(node.key)}
