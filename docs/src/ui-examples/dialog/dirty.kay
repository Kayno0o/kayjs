---
import Button from '@kaynooo/kayjs-ui/button.kay'
import Dialog from '@kaynooo/kayjs-ui/dialog.kay'

const open = signal(false)
const saving = signal(false)

function save() {
  saving.set(true)
  setTimeout(() => {
    saving.set(false)
    open.set(false)
  }, 2000)
}
---
Button(label="Publish" onClick={() => open.set(true)})
Dialog(
  open={open()}
  title="Publish the post"
  dirty={saving()}
  onClose={() => open.set(false)}
)
  @footer
    Button(label="Cancel" onClick={() => open.set(false)})
    Button(label="Publish" variant="accent" busy={saving()} onClick={save})
  p Publishing takes two seconds, and the dialog ignores Escape while it runs.
