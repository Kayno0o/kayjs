--- <Data>
import { signal } from 'kay'
import Button from './button.kay'
import Dialog from './dialog.kay'
import IconButton from './icon-button.kay'
import { attempt } from './toast'

const { message, onConfirm, failure, refused, trigger = 'icon', label = 'Delete', size, variant, class: className } = props<{
  message: string
  // Deletes. The dialog stays open, its buttons disabled, until a returned promise settles, and closes once it resolves.
  onConfirm: () => void | Promise<void>
  // Toasted when `onConfirm` throws, which leaves the dialog open.
  failure: string
  // What a refusal of the action's handler says, from the data it passed to `ctx.fail`: toasted in place of `failure`, which stays for an answer of undefined or another error.
  refused?: (data: Data) => string | undefined
  // An icon by default; `button` is a labelled danger button, for a dialog footer.
  trigger?: 'icon' | 'button'
  // What the trigger says, for a delete the reader knows by another name: "Empty trash", "Revoke link".
  label?: string
  // The icon trigger's size and look; the button trigger is always a danger button.
  size?: 'xs' | 'sm' | 'md' | 'lg'
  variant?: 'solid' | 'ghost' | 'inline' | 'danger'
  // Goes on the trigger.
  class?: string
}>()

const open = signal(false)
const pending = signal(false)

async function confirm() {
  pending.set(true)

  const deleted = await attempt(async () => {
    await onConfirm()

    return true
  }, failure, refused)

  pending.set(false)

  if (deleted)
    open.set(false)
}
---
if trigger === 'button'
  Button(label={label} variant="danger" class={className} onClick={() => open.set(true)})
else
  IconButton(icon="delete" label={label} size={size} variant={variant} class={className} onClick={() => open.set(true)})
Dialog(open={open()} title="Confirm Deletion" dirty={pending()} onClose={() => open.set(false)})
  @footer
    Button(label="Cancel" disabled={pending()} onClick={() => open.set(false)})
    Button(label={pending() ? 'Deleting…' : 'Delete'} variant="danger" busy={pending()} disabled={pending()} onClick={confirm})
  p.kui-confirm-delete-message {message}
