---
import Button from '@kaynooo/kayjs-ui/button.kay'
import FormField from '@kaynooo/kayjs-ui/form-field.kay'
import Select from '@kaynooo/kayjs-ui/select.kay'
import TextInput from '@kaynooo/kayjs-ui/text-input.kay'

const PERIODS = [
  { value: '24h', label: 'Last 24 hours' },
  { value: '30d', label: 'Last 30 days' },
]
const STATUSES = [
  { value: 'ok', label: 'OK' },
  { value: 'error', label: 'Error' },
]
---
form.flex.flex-wrap.items-end.gap-3(method="get" role="search")
  FormField(label="Search" size="sm")
    TextInput(name="q" type="search")
  FormField(label="Period" size="sm")
    Select(name="period" value="" options={PERIODS} emptyOption="Last 7 days")
  FormField(label="Status" size="sm")
    Select(name="status" value="" options={STATUSES} emptyOption="Any")
  Button(type="submit" label="Filter")
