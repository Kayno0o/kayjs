---
import Keeper from '../components/keeper.kay'
---
// kay-allow-file deprecated-link-flags -- keep-link, group-link and true-link use the names before 1.105, which still work
head
  title Scrolled
h1 Scrolled
Keeper
div(style="height: 3000px")
a.keep-link(href="/second" data-keep-scroll) Keep link
div(data-keep-scroll data-no-transition)
  a.group-link(href="/second") Group link
a.plain-link(href="/second") Plain link
a.false-link(href="/second" data-keep-scroll="false") False link
a.true-link(href="/second" data-keep-scroll="true") True link
a.empty-link(href="/second" data-scroll="") Empty link
a.hash-link(href="/second#top" data-scroll="keep") Hash link
a.hash-false-link(href="/second#top" data-scroll="top") Hash false link
nav(data-scroll="keep")
  a.nested-false-link(href="/second" data-scroll="top") Nested false link
  a.nested-keep-link(href="/second") Nested keep link
div(data-scroll="top")
  a.false-group-keep-link(href="/second" data-scroll="keep") Keep inside false
  a.false-group-link(href="/second") False group link
div(data-scroll="keep")
  div(data-scroll="top")
    a.deep-false-link(href="/second") Deep false link
div(data-transition="false")
  a.new-off-link(href="/second" data-scroll="keep") Off link
  a.new-on-link(href="/second" data-scroll="keep" data-transition) On link inside off
div(style="height: 200px")
