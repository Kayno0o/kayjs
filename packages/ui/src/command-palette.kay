---
import type { SearchHit } from 'kay'
import type { PaletteAction, PaletteEntry, PaletteLink } from './palette'
import { effect, memo, searchResults, shortcut, signal, uid } from 'kay'
import { stepIndex } from './cycle'
import Icon from './icon.kay'
import { isPaletteLink, paletteHits, paletteMatches, paletteSections, withRecent } from './palette'
import { word } from './words'

const { open = false, onOpenChange, entries, groups = [], recent = [], onRecentChange, hotkey = 'k', siteSearch = false, siteSearchLabel = word('commandPalette.siteSearchLabel', 'In the pages'), siteSearchError = word('commandPalette.siteSearchError', 'The pages could not be searched'), label = word('commandPalette.label', 'Search'), placeholder = word('commandPalette.placeholder', 'Search'), emptyLabel = word('commandPalette.emptyLabel', 'No results'), recentLabel = word('commandPalette.recentLabel', 'Recent'), resultsLabel, class: className } = props<{
  // Shows the palette; the hotkey opens and closes it too, and `onOpenChange` reports every change for a parent driving it.
  open?: boolean | undefined
  onOpenChange?: ((open: boolean) => void) | undefined
  entries: PaletteEntry[]
  // The order groups are listed in; the rest follow as they come.
  groups?: string[] | undefined
  // Hrefs of the links followed from it, most recent first, listed on top while the query is empty; `onRecentChange` hands the new list over for the app to keep.
  recent?: string[] | undefined
  onRecentChange?: ((recent: string[]) => void) | undefined
  // Ctrl or Cmd and this key opens and closes it from anywhere, unless something handled the key first; `null` leaves opening to the app.
  hotkey?: string | null | undefined
  // Searches the text of the site's pages too, as kay indexes them under `search: true`: a query lists the sections it finds, `limit` of them, after the entries it matches, under `siteSearchLabel`. Read once, as the palette is set up.
  siteSearch?: boolean | { limit?: number | undefined } | undefined
  siteSearchLabel?: string | undefined
  // Shown under the entries when the index could not load.
  siteSearchError?: string | undefined
  label?: string | undefined
  placeholder?: string | undefined
  emptyLabel?: string | undefined
  // The heading the recently followed links sit under.
  recentLabel?: string | undefined
  // How many rows a query lists, as screen readers hear it.
  resultsLabel?: ((count: number) => string) | undefined
  class?: string | undefined
}>()

// A row of the list, numbered the way the arrow keys walk it; a section the site search found carries the line of text it was found in, and its heading's words found marked.
interface Row {
  entry: PaletteEntry
  index: number
  snippet?: SearchHit['snippet'] | undefined
  labelParts?: SearchHit['headingParts'] | undefined
}

const id = uid()
const counted = resultsLabel ?? ((count: number) => word('commandPalette.resultsLabel', count === 1 ? '1 result' : '{count} results', { count }))
const shown = signal(open)
const followedRecently = signal<string[]>(recent)
const query = signal('')
const selected = signal(0)
let dialog: HTMLDialogElement | undefined
const searching = siteSearch
const site = searching ? searchResults(query, searching === true ? {} : searching) : undefined

effect(() => shown.set(open))
effect(() => followedRecently.set(recent))

// Headed groups while the query is empty, one flat ranked list once it is not, then the sections the site search found that no entry links already.
const sections = memo(() => {
  let index = 0
  const numbered = (members: PaletteEntry[]): Row[] => members.map(entry => ({ entry, index: index++ }))

  if (!query().trim())
    return paletteSections(entries, followedRecently(), groups, recentLabel).map(section => ({ group: section.group as string | null, rows: numbered(section.entries) }))

  const matches = paletteMatches(entries, query(), groups)
  const found = numbered(matches)
  const hits = paletteHits(site?.hits() ?? [], matches).map(hit => ({ entry: hit.link, index: index++, snippet: hit.snippet, labelParts: hit.labelParts }))

  return hits.length > 0 ? [{ group: null, rows: found }, { group: siteSearchLabel, rows: hits }] : [{ group: null, rows: found }]
})

const rows = memo(() => sections().flatMap(section => section.rows))
// The highlighted row, kept within the list as hits arriving shorten it.
const active = memo(() => Math.min(selected(), Math.max(rows().length - 1, 0)))

const optionId = (index: number) => `${id}-option-${index}`

// A row's entry as the link or the action it is, for the template to draw each.
const linkOf = (entry: PaletteEntry) => isPaletteLink(entry) ? entry : undefined
const actionOf = (entry: PaletteEntry) => isPaletteLink(entry) ? undefined : entry

effect(() => {
  const current = active()

  if (shown())
    document.getElementById(optionId(current))?.scrollIntoView?.({ block: 'nearest' })
})

effect(() => {
  const wanted = shown()

  if (!dialog)
    return

  if (wanted && !dialog.open)
    dialog.showModal()
  else if (!wanted && dialog.open)
    dialog.close()
})

function setShown(next: boolean) {
  if (next === shown())
    return

  shown.set(next)
  onOpenChange?.(next)
}

// A close event lands a task after the dialog closed, so one the hotkey has already reopened it past is stale.
function closed() {
  if (dialog?.open)
    return

  query.set('')
  selected.set(0)
  setShown(false)
}

shortcut(() => hotkey ? `mod+${hotkey}` : null, () => setShown(!(dialog?.open ?? shown())))

// A section the site search found is not kept as recent: the list only shows the entries' own links.
function followed(link: PaletteLink, found: boolean) {
  if (!found) {
    const next = withRecent(followedRecently(), link.href)

    followedRecently.set(next)
    onRecentChange?.(next)
  }

  dialog?.close()
}

// Run once the palette has closed, so a dialog the action opens takes focus from the page rather than from a vanished palette.
function act(action: PaletteAction) {
  dialog?.close()
  action.onSelect()
}

function keyDown(event: KeyboardEvent) {
  const count = rows().length

  if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
    event.preventDefault()
    selected.set(stepIndex(active(), event.key === 'ArrowDown' ? 1 : -1, count))

    return
  }

  const row = rows()[active()]
  const entry = row?.entry

  if (event.key !== 'Enter' || !entry)
    return

  event.preventDefault()

  if (isPaletteLink(entry) && (event.ctrlKey || event.metaKey)) {
    window.open(entry.href, '_blank', 'noopener')
    followed(entry, row.snippet !== undefined)

    return
  }

  // A real click on the link, so kay's navigation takes it as it takes any other.
  document.getElementById(optionId(active()))?.click()
}
---
dialog.kui-command-palette(ref={element => dialog = element} closedby="any" aria-label={label} onClose={closed} class={className})
  if shown()
    .kui-command-palette-search
      Icon(icon="search")
      input.kui-command-palette-input(value={query()} onInput={event => { query.set(event.currentTarget.value); selected.set(0) }} onKeyDown={keyDown} role="combobox" aria-label={label} aria-expanded="true" aria-controls={`${id}-list`} aria-autocomplete="list" aria-activedescendant={rows()[active()] ? optionId(active()) : undefined} autocomplete="off" spellcheck="false" placeholder={placeholder})
    .kui-command-palette-list(id={`${id}-list`} role="listbox" aria-label={label})
      for section, sectionIndex of sections() key={section.group ?? ''}
        div(role="group" aria-labelledby={section.group === null ? undefined : `${id}-group-${sectionIndex}`})
          if section.group !== null
            .kui-heading-section.kui-command-palette-heading(id={`${id}-group-${sectionIndex}`}) {section.group}
          for row of section.rows key={row.index}
            if linkOf(row.entry) as link
              a.kui-command-palette-option(href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined} id={optionId(row.index)} role="option" aria-selected={row.index === active() ? 'true' : 'false'} tabindex="-1" onPointerMove={() => selected.set(row.index)} onClick={() => followed(link, row.snippet !== undefined)})
                if link.icon as icon
                  Icon(icon={icon})
                if row.snippet as snippet
                  span.kui-command-palette-text
                    span.kui-command-palette-label
                      for part, partIndex of row.labelParts ?? [{ text: row.entry.label, hit: false }] key={partIndex}
                        if part.hit
                          mark {part.text}
                        else
                          | {part.text}
                    span.kui-command-palette-snippet
                      for part, partIndex of snippet key={partIndex}
                        if part.hit
                          mark {part.text}
                        else
                          | {part.text}
                else
                  span.kui-command-palette-label {row.entry.label}
                if query().trim() && row.entry.group
                  span.kui-command-palette-group {row.entry.group}
            else if actionOf(row.entry) as action
              button.kui-command-palette-option(type="button" id={optionId(row.index)} role="option" aria-selected={row.index === active() ? 'true' : 'false'} tabindex="-1" onPointerMove={() => selected.set(row.index)} onClick={() => act(action)})
                if action.icon as icon
                  Icon(icon={icon})
                span.kui-command-palette-label {row.entry.label}
                if query().trim() && row.entry.group
                  span.kui-command-palette-group {row.entry.group}
      if site?.error() && query().trim()
        p.kui-command-palette-empty {siteSearchError}
      else if rows().length === 0 && !site?.loading()
        p.kui-command-palette-empty {emptyLabel}
    p.kui-command-palette-count(role="status") {query().trim() && !site?.loading() ? counted(rows().length) : ''}
