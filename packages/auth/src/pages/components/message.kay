---
const { text, tone = 'error' } = props<{ text: string, tone?: 'error' | 'success' }>()
---
// An error is announced at once, a confirmation when the reader gets to it.
if tone === 'error'
  p.kauth-error.text-kui-error(role="alert") {text}
else
  p.kauth-success.text-kui-success(role="status") {text}
