---
import { call, local } from 'kay'
import { drop, save } from '../routes/index.kay'
import notesApi from '../api/notes'

const { theirs = false, both = false, version = 1 } = props<{ theirs?: boolean, both?: boolean, version?: number }>()
const notes = local({
  key: 'id',
  read: async () => call(notesApi, '/'),
  put: save,
  remove: drop,
  version,
  conflict: theirs ? () => undefined : both ? ({ mine, theirs: held }) => ({ ...held, title: `${mine?.title}+${held.title}` }) : undefined,
})
const text = signal('')
---
p.status {notes.status()}
p.pending {notes.pending()}
ul
  for note of notes.rows()
    li.note(data-id={note.id}) {note.title} {note.rev}
ul
  for issue of notes.issues()
    li.issue {issue.kind} {issue.key} {issue.status ?? ''}
input.title(bind:value={text} aria-label="Title")
button.add(onClick={() => notes.put({ id: 'a', title: text(), rev: 0 })}) Add
button.addb(onClick={() => notes.put({ id: 'b', title: text(), rev: 0 })}) Add b
button.edit(onClick={() => notes.put({ id: 'a', title: text(), rev: notes.get('a')?.rev ?? 0 })}) Edit
button.remove(onClick={() => notes.remove('a')}) Remove
button.sync(onClick={() => notes.sync()}) Sync
button.clear(onClick={() => notes.clear()}) Clear
