---
import type { Member } from '../room'
import { effect, memo, presence } from 'kay'
import { wording } from 'kay/words'
import { editorsOf, openRoom, watchRoom } from '../room'

// Who else has an entry open: their names when `cms({ author })` gives them, else how many they are. `room` and `member` come from `entryPresence`, or from `entryRoom` with `page: true` for the on-page editor, which asks no author.
// The server sends the names of the entry's room to an editor the app's guard let in alone, the on-page editor's included, and an edit link's holder is sent the members with none, so counts only. The room that holds no name counts everyone.
const { room, member } = props<{ room: string, member: Member }>()
const onPage = member.page === true
const open = openRoom(room)
const nameless: Member = onPage ? member : { name: '' }
const everyone = presence(open, nameless)
// Also listed in the rooms a list watches the entry through, which nothing here shows: a room is joined by reading it.
const watchedBy = presence(watchRoom(open), nameless)
const named = presence(room, member)
const namedWatchedBy = presence(watchRoom(room), member)

effect(() => void watchedBy.count())
effect(() => void namedWatchedBy.count())

const editors = memo(() => editorsOf(named.others(), named.count(), member))
// A screen's editor is told of an editor on a page by their number, as the page lists none by name.
const paged = memo(() => everyone.others().some(other => other.page === true))
const text = memo(() => {
  if (editors().names.length > 0)
    return wording('cms.entry.alsoOpen', 'Also open: {names}', { names: editors().names.join(', ') })

  const others = onPage || member.name === '' ? everyone.count() : Math.max(editors().unnamed, paged() ? 1 : 0)

  return others > 0 ? wording('cms.entry.otherEditors', others === 1 ? '1 other editor' : '{count} other editors', { count: others }) : ''
})
---
.kcms-entry-presence(role="status")
  if text() !== ''
    p {text()}
