---
import wasm from '../add.wasm'
import { add } from '../threads.js'

const sum = signal('')
const echoed = signal('')
const threaded = signal('')
const blobbed = signal('')

onMount(async () => {
  const { instance } = await WebAssembly.instantiateStreaming(fetch(wasm))

  sum = String((instance.exports.add as (a: number, b: number) => number)(2, 3))

  const worker = new Worker(new URL('../echo.ts', import.meta.url), { type: 'module' })

  worker.onmessage = (event: MessageEvent<string>) => echoed = event.data
  worker.postMessage(20)
  threaded = String(await add(4, 5))

  const { timesSeven } = await import('../blob.js')

  blobbed = String(await timesSeven(6))
})
---
p.sum {sum()}
p.echo {echoed()}
p.thread {threaded()}
p.blob {blobbed()}
