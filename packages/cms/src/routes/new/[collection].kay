--- server
import EmptyState from '@kaynooo/kayjs-ui/empty-state.kay'
import { s } from 'kay'
import { wording } from 'kay/words'
import EntryEditor from '../../components/entry-editor.kay'
import EntryHeader from '../../components/entry-header.kay'
import { adminTitle, collectionTitle } from '../../listing'
import { collectionScreen } from '../../screens'

export const page = { query: s.Object({ locale: s.Optional(s.String()) }) }

const { prefix, collection } = await collectionScreen(ctx.params.collection) ?? ctx.notFound()
const locale = ctx.query.locale
---
head
  title {adminTitle(collection.single ? collectionTitle(collection) : wording('cms.admin.newEntryTitle', 'New entry - {collection}', { collection: collectionTitle(collection) }))}
if collection.problem as problem
  EntryHeader(prefix={prefix} collection={collection} title={wording('cms.admin.newEntry', 'New entry')})
  EmptyState(title={wording('cms.admin.collectionUnreadable', 'This collection cannot be read')} description={problem})
else
  EntryEditor(prefix={prefix} collection={collection} locale={locale})
