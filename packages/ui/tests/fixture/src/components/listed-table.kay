---
import type { FilterField, ListFilter, SortState } from '@kaynooo/kayjs-ui'
import { infiniteList } from '@kaynooo/kayjs-ui'
import Table from '@kaynooo/kayjs-ui/table.kay'

const { onLoad, onSort, sort, sortParam, filterParam, fields, searchable = false } = props<{
  onLoad: (at: { offset: number, sort: SortState | undefined, filter: ListFilter }) => Promise<{ id: number, name: string, moons: number }[] | undefined>
  onSort?: (sort: SortState) => void
  sort?: SortState
  sortParam?: string
  filterParam?: string
  fields?: FilterField[]
  searchable?: boolean
}>()

const feed = infiniteList([{ id: 1, name: 'Io', moons: 0 }, { id: 2, name: 'Europa', moons: 1 }], { pageSize: 2, key: row => row.id, load: onLoad })
---
Table(columns={[{ key: 'name', header: 'Name', sortValue: true, defaultDirection: 'asc' }, { key: 'moons', header: 'Moons', numeric: true }]} list={feed} rowKey="id" onSort={onSort} sort={sort} sortParam={sortParam} filter={searchable ? ['name'] : undefined} filterParam={filterParam} fields={fields})
  @noMatch
    p.no-match Nothing matches
