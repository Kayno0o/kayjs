---
import { signal } from 'kay'
import Select from '@kaynooo/kayjs-ui/select.kay'

const { heard = [], submit = true } = props<{ heard?: string[], submit?: boolean }>()
const posts = signal(0)
const options = [{ value: 'a', label: 'Alpha' }, { value: 'b', label: 'Beta' }, { value: 'c', label: 'Gamma' }]
---
form#filter(onSubmit={event => { event.preventDefault(); posts.set(posts() + 1) }})
  Select#kind(name="kind" options={options} value="a" aria-label="Kind" submit={submit} onKeyDown={() => heard.push('keydown')} onPointerDown={() => heard.push('pointerdown')} onBlur={() => heard.push('blur')})
output#posts {posts()}
