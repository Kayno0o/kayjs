---
import type { JSX } from 'kay'
import type { StepItem } from './steps'
import { wording } from 'kay/words'
import { stepHref } from './steps'
import { recipe } from 'kay'

// 'kui-steps' stays as the component's name for an app's CSS. A numbered row, the current step marked by aria-current and the ones behind it links.
const look = recipe({
  parts: {
    root: 'kui-steps block',
    list: 'm-0 flex list-none flex-wrap gap-x-6 gap-y-2 p-0',
    item: 'group/step flex items-center text-sm text-kui-subtext0 data-[state=current]:font-medium data-[state=current]:text-kui-text',
    link: 'flex items-center gap-2 rounded-md no-underline [&:is(a)]:text-kui-text [&:is(a)]:hover:text-kui-accent',
    marker: 'flex size-6 shrink-0 items-center justify-center rounded-full border border-kui-overlay0 text-xs group-data-[state=current]/step:border-kui-accent group-data-[state=current]/step:bg-kui-accent group-data-[state=current]/step:text-kui-on-accent group-data-[state=done]/step:border-kui-accent group-data-[state=done]/step:text-kui-accent',
    label: 'min-w-0',
    state: 'sr-only',
  },
})

const { steps, current, url, done = [], param = 'step', label, doneLabel = wording('ui.steps.done', 'completed'), ...rest } = props<Omit<JSX.IntrinsicElements['nav'], 'class' | 'children'> & {
  steps: readonly StepItem[]
  // The key of the step on screen, which `currentStep(ctx.url, keys, done)` reads off the URL.
  current: string
  // The page's URL, `ctx.url`: each link to a step keeps its other params.
  url: string | URL
  // The keys of the steps whose values were kept; a step before the current one or in this list is a link back, any other plain text.
  done?: readonly string[] | undefined
  // The query param holding the step.
  param?: string | undefined
  // Names the navigation for screen readers.
  label: string
  // What a screen reader hears after a completed step's name.
  doneLabel?: string | undefined
}>()

const at = () => steps.findIndex(step => step.key === current)
const state = (index: number, key: string) => key === current ? 'current' : index < at() || done.includes(key) ? 'done' : 'upcoming'
---
nav(part="root" {...rest} aria-label={label})
  ol(part="list")
    for step, index of steps key={step.key}
      li(part="item" data-state={state(index, step.key)})
        if state(index, step.key) === 'done'
          a(part="link" href={stepHref(url, step.key, param)})
            span(part="marker" aria-hidden="true") {index + 1}
            span(part="label") {step.label}
            span(part="state") {doneLabel}
        else
          span(part="link" aria-current={step.key === current ? 'step' : undefined})
            span(part="marker" aria-hidden="true") {index + 1}
            span(part="label") {step.label}
