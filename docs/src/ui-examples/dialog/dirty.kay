---
import Button from '@kaynooo/kayjs-ui/button.kay'
import Dialog from '@kaynooo/kayjs-ui/dialog.kay'

const open = signal(false)
const saving = signal(false)

function save() {
  saving = true
  setTimeout(() => {
    saving = false
    open = false
  }, 2000)
}
---
Button(label="Publish" onClick={() => open = true})
Dialog(
  open={open()}
  title="Publish the post"
  dirty={saving()}
  onOpenChange={() => open = false}
)
  @footer
    Button(label="Cancel" onClick={() => open = false})
    Button(label="Publish" tone="accent" busy={saving()} onClick={save})
  p Publishing takes two seconds, and the dialog ignores Escape while it runs.
