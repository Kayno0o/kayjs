--- server
import { t } from 'elysia'
import { action } from 'kay'
import Calling from '../components/calling.kay'
import Saving from '../components/saving.kay'

export const slow = action(t.Object({}), async () => {
  await Bun.sleep(500)
})

export const refused = action(t.Object({}), async (_input, ctx) => {
  await Bun.sleep(500)

  return ctx.fail(409, 'Taken')
})

export const leaves = action(t.Object({}), async (_input, ctx) => {
  await Bun.sleep(500)
  ctx.redirect('/other')
})

export const leavesLate = action(t.Object({}), async (_input, ctx) => {
  await Bun.sleep(200)
  ctx.redirect('/late')
})

// Where the `external` form's post redirects to, a slow server of the test's own on another origin.
export const away = action(t.Object({}), async (_input, ctx) => {
  await Bun.sleep(200)
  ctx.redirect(process.env.KAY_PENDING_AWAY!)
})

await Bun.sleep(Number(process.env.KAY_PENDING_HOLD ?? 0))
---
h1 Pending
form.slow(action={slow})
  button Slow
  pending
    p.saving Saving slow
form.refused(action={refused})
  button Refuse
  pending
    p.saving Saving refused
form.leaves(action={leaves})
  button Leave
  pending
    p.saving Saving leaves
Saving
form.external(action={away})
  button Away
  pending
    p.saving Saving external
form.reloads(action={slow})
  button Reload
  pending
    p.saving Saving reloads
form.late(action={leavesLate})
  button Late
  pending
    p.saving Saving late
Calling
dialog.box
  form.boxed(action={slow})
    button Boxed
    pending
      p.saving Saving boxed
