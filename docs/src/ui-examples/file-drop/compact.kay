---
import { signal } from 'kay'
import Button from '@kayjs/ui/button.kay'
import FileDrop from '@kayjs/ui/file-drop.kay'

const name = signal('')
---
FileDrop(
  accept="image/*"
  size="sm"
  onFiles={files => name = files[0]!.name}
)
  @content(zone)
    Button(label="Choose a favicon" onClick={zone.open})
    span.text-muted {name() || 'or drop it here'}
