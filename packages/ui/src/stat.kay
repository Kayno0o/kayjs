---
import { recipe } from 'kay'
import type { JSX } from 'kay'
import type { IconProps } from 'kay/icons'
import type { IconSlot } from './defaults'
import Icon from './icon.kay'
import { deltaIcon } from './stat'
import type { StatDelta } from './stat'

const look = recipe({
  // 'kui-stat-badge' keeps the hairline and the fill of the shell it shares with buttons; the figure alone takes the tone, so the label keeps its text colour. A tile fills its grid cell, the figure large above its label.
  parts: {
    root: 'kui-stat-badge inline-flex items-center gap-[calc(var(--spacing)*1.25*var(--density))] rounded-lg px-2.25 py-0.75 text-xs [&:is(a)]:no-underline',
    icon: 'size-4 shrink-0',
    // The label comes before the change for a screen reader, and `order` puts the change back beside the figure.
    value: 'order-1 font-semibold text-foreground',
    label: 'order-3 text-muted',
    delta: 'order-2 inline-flex items-center gap-1 font-normal text-muted data-[tone=success]:text-success data-[tone=warning]:text-warning data-[tone=danger]:text-danger data-[tone=info]:text-info',
    deltaIcon: 'size-3.5 shrink-0',
    deltaValue: '',
    deltaLabel: 'text-muted',
  },
  variants: {
    // `inline` is the pill, figure and label side by side; `tile` is a framed box with the figure above its label, to stack in a grid.
    variant: {
      inline: '',
      tile: {
        root: 'grid grid-cols-[auto_1fr] items-baseline justify-items-start gap-x-2 gap-y-1 px-[calc(var(--spacing)*2.25*var(--density))] py-3',
        icon: 'col-span-full',
        value: 'text-2xl/none',
        label: 'col-span-full [font-size:var(--text-2xs)] [line-height:var(--text-2xs--line-height)] [font-weight:var(--font-weight-normal)] tracking-label [font-family:var(--font-label,inherit)] [text-transform:var(--label-case)]',
      },
    },
    // Colours the figure, such as `danger` past a threshold; `neutral` keeps the text colour.
    tone: {
      neutral: '',
      accent: { value: 'text-accent' },
      success: { value: 'text-success' },
      warning: { value: 'text-warning' },
      danger: { value: 'text-danger' },
      info: { value: 'text-info' },
    },
  },
  defaults: { variant: 'inline', tone: 'neutral' },
})

const { value, label, icon, href, delta, variant = 'inline', tone = 'neutral', ...rest } = props<Omit<JSX.IntrinsicElements['span'], 'class' | 'children'> & {
  value: number | string
  label?: string | undefined
  icon?: IconSlot | IconProps | undefined
  // Makes the whole stat a link, to the list it counts.
  href?: string | undefined
  // How the figure moved since the period before, beside the figure with an arrow, so colour is not the only signal.
  delta?: StatDelta | undefined
}>()
---
snippet body()
  if icon
    Icon(icon={icon} part="icon")
  span(part="value") {value}
  if label
    span(part="label") {label}
  if delta
    span(part="delta" data-tone={delta.tone === 'neutral' ? undefined : delta.tone})
      Icon(icon={deltaIcon(delta)} part="deltaIcon")
      span(part="deltaValue") {delta.value}
      if delta.label
        span(part="deltaLabel") {delta.label}

// A figure and what it counts, read together: "12 moons".
if href !== undefined
  a(part="root" {...rest} href={href} data-variant={variant === 'tile' ? 'tile' : undefined} data-tone={tone === 'neutral' ? undefined : tone})
    {body()}
else
  span(part="root" {...rest} data-variant={variant === 'tile' ? 'tile' : undefined} data-tone={tone === 'neutral' ? undefined : tone})
    {body()}
