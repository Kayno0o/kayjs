---
import { signal } from 'kay'

const n = signal(0)
const label = signal('Début')
const shown = signal(true)
const open = signal(false)
const rows = signal(['un'])
---
div.counter
  p.total Total : {n()} !
  p.label {label()}
  p.mixed Prix : {label()} ?
  if shown()
    | Reste : {n()} !
  code.code {label()}
  pre.pre
    | Ligne : {label()}
  div.late
    if open()
      p.fresh Tard : fin !
      code.fresh-code Tard : fin {label()}
    for row of rows()
      p.row Ligne : {row} ?
  button.plus(type="button" onClick={() => { n = n() + 1; label = `Reste : ${n()} !` }}) Plus
  button.typed(type="button" onClick={() => label = 'Déjà : fin ! « a ». 12:30 http://a.fr:80/x?y=1'}) Typed
  button.hostile(type="button" onClick={() => label = '<b>x</b> : y'}) Hostile
  button.open(type="button" onClick={() => { open = true; rows = [...rows(), 'deux'] }}) Open
  button.toggle(type="button" onClick={() => shown = !shown()}) Toggle
