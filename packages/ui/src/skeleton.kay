---
import { recipe } from 'kay'
import type { JSX } from 'kay'

const look = recipe({
  parts: {
    root: 'kui-skeleton flex w-(--_skeleton-width,100%) flex-col gap-2',
    block: 'block h-(--_skeleton-height,1em) w-full animate-pulse bg-surface-strong motion-reduce:animate-none data-last:w-3/5',
    label: 'sr-only',
  },
  variants: {
    // `text` draws `lines` bars, the last one shorter; `avatar` a round block; `card` a block.
    shape: {
      text: '',
      avatar: { root: 'w-(--_skeleton-width,2.5rem)', block: 'aspect-square h-auto rounded-[var(--radius-kui-full,calc(infinity*1px))]' },
      card: { block: 'h-(--_skeleton-height,8rem)' },
    },
  },
  defaults: { shape: 'text' },
})

const { shape = 'text', lines = 1, width, height, label, style, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'children' | 'style'> & {
  // Written after the component's own declarations, so it wins.
  style?: string | undefined
  // How many bars `text` draws.
  lines?: number | undefined
  // A CSS length for the bars, the avatar or the card; `100%` by default, `2.5rem` for an avatar.
  width?: string | undefined
  // A CSS length: a bar's height or the card's; the avatar is square, sized by `width`.
  height?: string | undefined
  // Read out as a status for screen readers, which never see the shapes; leave it out when the pending block already says something.
  label?: string | undefined
}>()

const own = () => [width ? `--_skeleton-width: ${width}` : undefined, height ? `--_skeleton-height: ${height}` : undefined].filter(Boolean).join('; ')
const count = () => shape === 'text' ? Number.isFinite(lines) ? Math.max(1, Math.floor(lines)) : 1 : 1
---
div(part="root" {...rest} data-shape={shape} style={[own(), style].filter(Boolean).join('; ') || undefined})
  for index of Array.from({ length: count() }, (_, position) => position) key={index}
    span(part="block" aria-hidden="true" data-last={shape === 'text' && count() > 1 && index === count() - 1 ? '' : undefined})
  if label
    span(part="label" role="status") {label}
