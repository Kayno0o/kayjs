--- server
import { t } from 'elysia'
import { action } from 'kay'
import Saving from '../components/saving.kay'

export const slow = action(t.Object({}), async () => {
  await Bun.sleep(500)
})

export const refused = action(t.Object({}), async (_input, ctx) => {
  await Bun.sleep(500)

  return ctx.fail(409, 'Taken')
})

export const leaves = action(t.Object({}), async (_input, ctx) => {
  await Bun.sleep(500)
  ctx.redirect('/other')
})
---
h1 Pending
form.slow(action={slow})
  button Slow
  pending
    p.saving Saving slow
form.refused(action={refused})
  button Refuse
  pending
    p.saving Saving refused
form.leaves(action={leaves})
  button Leave
  pending
    p.saving Saving leaves
Saving
