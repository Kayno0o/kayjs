---
import { recipe } from 'kay'
import type { JSX, Snippet } from 'kay'
import { fillOf, thresholdTone } from './threshold'
import type { Threshold } from './threshold'
import type { Tone } from './tone'

// One part of the total: `tone` (the accent when absent) colours it, `class` adds to it, `label` is what screen readers hear after its value.
export interface MeterSegment {
  value: number
  label: string
  tone?: Tone | undefined
  class?: string | undefined
}

const look = recipe({
  parts: { root: 'kui-meter flex w-full overflow-hidden bg-surface', field: 'block', fill: 'h-full transition-[width] motion-reduce:transition-none', reading: 'mt-1 block text-xs text-muted tabular-nums' },
>>>>>>> 694d91a (feat(ui): Meter segments for parts of one total)
=======
  parts: { root: 'kui-meter flex w-full overflow-hidden bg-surface-strong', field: 'block', fill: 'h-full transition-[width] motion-reduce:transition-none', reading: 'mt-1 block text-xs text-muted tabular-nums' },
=======
  parts: { root: 'kui-meter flex w-full overflow-hidden bg-surface', field: 'block', fill: 'h-full transition-[width] motion-reduce:transition-none', reading: 'mt-1 block text-xs text-muted tabular-nums' },
>>>>>>> 694d91a (feat(ui): Meter segments for parts of one total)
  variants: {
    // The bar's height: `sm`, `md` (default) or `lg`.
    size: { sm: { root: 'h-1' }, md: { root: 'h-2' }, lg: { root: 'h-3' } },
  },
  defaults: { size: 'md' },
})

const { value, segments, max = 100, label, fillClass, size = 'md', formatValue, thresholds, showValue, reading, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'children' | 'role'> & {
  // How much is filled, held between 0 and `max`. Ignored when `segments` is given.
  value?: number | undefined
  // Parts of one total laid end to end, `[{ value: 5, tone: 'success', label: 'known' }, { value: 2, tone: 'danger', label: 'missed' }]`, each held so the sum never passes `max`. Screen readers hear `5 known, 2 missed of 22` unless `formatValue` words the total.
  segments?: MeterSegment[] | undefined
  // The value of a full meter, 100 by default so `value` reads as a percentage.
  max?: number | undefined
  // Names the meter for screen readers.
  label: string
  /** @deprecated Use `class={{ fill: '...' }}`, which replaces the accent the same way. Removed in 2.0.0. No lint: an old prop with no mechanical rewrite to a class map. */
  fillClass?: string | undefined

  // Words the value, `(value, max) => '3 of 10 GB'`: screen readers hear it as `aria-valuetext`, and `showValue` and `@reading` draw it.
  formatValue?: ((value: number, max: number) => string) | undefined
  // Colours the fill by value: the first entry whose `upTo` is at least the value gives its `tone`, whatever the order, and a value past all of them keeps the accent. `[{ upTo: 70, tone: 'success' }, { upTo: 90, tone: 'warning' }, { upTo: Infinity, tone: 'danger' }]`.
  thresholds?: Threshold[] | undefined
  // Draws the value as text under the bar: `formatValue`'s words, else `value / max`.
  showValue?: boolean | undefined
  // Draws the value's text in place of the default one, `@reading(text, value, max)`, for an icon or a unit in markup. It shows without `showValue`.
  reading?: Snippet<[text: string, value: number, max: number]> | undefined
}>()

const clamp = (amount: number | undefined, room: number) => Math.min(room, Math.max(0, amount === undefined || Number.isNaN(amount) ? 0 : amount))
// Each segment takes what is left of `max`, so the sum is held to it.
const shares = () => {
  let room = max > 0 ? max : 0
  return (segments ?? []).map(segment => {
    const share = clamp(segment.value, room)
    room -= share
    return { segment, share }
  })
}
const held = () => segments ? shares().reduce((sum, { share }) => sum + share, 0) : max > 0 ? clamp(value, max) : 0
const percent = (amount: number) => max > 0 ? amount / max * 100 : 0
const text = () => formatValue ? formatValue(held(), max) : segments ? `${shares().map(({ segment, share }) => `${share} ${segment.label}`).join(', ')} of ${max}` : `${held()} / ${max}`
const tone = () => thresholdTone(thresholds, held())
---
snippet bar()
  // The accent is the fill's own class, not the recipe's, so `fillClass` and the caller's `class={{ fill }}` both replace it.
  div(part="root" {...rest} role="meter" aria-valuenow={held()} aria-valuemin={0} aria-valuemax={max} aria-valuetext={formatValue || segments ? text() : undefined} aria-label={label} data-size={size})
    if segments
      for item of shares() key={item.segment.label}
        div(part="fill" class={[fillOf(item.segment.tone), item.segment.class]} data-tone={item.segment.tone} style={`width: ${percent(item.share)}%`})
    else
      div(part="fill" class={[fillOf(tone()), fillClass]} data-tone={tone()} style={`width: ${percent(held())}%`})

if reading || showValue
  div(part="field")
    {bar()}
    span(part="reading" aria-hidden="true")
      if reading
        | {reading(text(), held(), max)}
      else
        | {text()}
else
  {bar()}
