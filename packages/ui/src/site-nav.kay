---
import type { JSX } from 'kay'
import { recipe, uid } from 'kay'
import type { NavLink } from './defaults'
import Icon from './icon.kay'
import { wording } from 'kay/words'

const TRAILING_SLASHES = /\/+$/

const look = recipe({ parts: { root: 'kui-site-nav', toggle: 'kui-site-nav-toggle', menuIcon: 'kui-site-nav-toggle-menu', closeIcon: 'kui-site-nav-toggle-close', list: 'kui-site-nav-list', link: 'kui-site-nav-link', icon: 'kui-site-nav-icon' } })

const { id, links, current, label, menuLabel = wording('ui.siteNav.menuLabel', 'Menu'), ...rest } = props<Omit<JSX.IntrinsicElements['nav'], 'id' | 'class' | 'children'> & {
  // The list's id, unique on the page; one is drawn when none is given.
  id?: string | undefined
  // `icon` is drawn before the label, for the reader who sees it; the label still names the link.
  links: readonly NavLink[]
  // The path of the page on screen, or its URL, `ctx.url`: its link is marked as the page, and a link to a section holding it as current.
  current: string | URL
  // Names the navigation for screen readers.
  label: string
  // Names the button opening the links on a narrow screen.
  menuLabel?: string | undefined
}>()

const listId = id ?? uid()
const anchor = `--kui-site-nav-${listId}`

// A path with a trailing slash is the same page as without one.
const trimmed = (path: string) => path.length > 1 ? path.replace(TRAILING_SLASHES, '') : path

// The home page holds every path, so only an exact match marks it.
function marked(href: string) {
  const own = trimmed(href)
  const here = trimmed(typeof current === 'string' ? current : current.pathname)

  if (own === here)
    return 'page'

  return own !== '/' && here.startsWith(`${own}/`) ? 'true' : undefined
}
---
// The list is a popover its toggle opens, so the browser owns showing it, closing it on a press outside or Escape, and giving the focus back; the page swap closes one left open.
// The toggle is an IconButton's markup with both icons drawn, so CSS shows the close one while the list is open.
nav(part="root" {...rest} aria-label={label})
  button.kui-icon-btn(part="toggle" type="button" aria-label={menuLabel} data-tooltip={menuLabel} data-size="md" data-variant="ghost" data-tone="neutral" popovertarget={listId} style={`anchor-name: ${anchor}`})
    Icon(icon="menu" part="menuIcon")
    Icon(icon="close" part="closeIcon")
  ul(part="list" id={listId} popover style={`position-anchor: ${anchor}`})
    for link of links key={link.href}
      li
        a(part="link" href={link.href} aria-current={marked(link.href)})
          if link.icon
            Icon(icon={link.icon} part="icon")
          | {link.label}
