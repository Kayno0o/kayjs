---
// kay-island
import { blocked } from '../routes/tools.kay'
import Chat from '@kaynooo/kayjs-ai/chat.kay'
---
Chat(action={blocked} label="Assistant")
  @call(call)
    div.order(data-status={call.status}) {call.name} gave {call.result ?? 'nothing yet'}
  @source(source, n)
    span.pill {n}={source.title}
