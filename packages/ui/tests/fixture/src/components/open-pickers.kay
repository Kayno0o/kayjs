---
// kay-island
import { signal } from 'kay'
import AppSwitcher from '@kaynooo/kayjs-ui/app-switcher.kay'

import Combobox from '@kaynooo/kayjs-ui/combobox.kay'
import ConfirmDelete from '@kaynooo/kayjs-ui/confirm-delete.kay'
import DateInput from '@kaynooo/kayjs-ui/date-input.kay'
import DateRangeInput from '@kaynooo/kayjs-ui/date-range-input.kay'
import HoverCard from '@kaynooo/kayjs-ui/hover-card.kay'
import Menu from '@kaynooo/kayjs-ui/menu.kay'
import MultiSelect from '@kaynooo/kayjs-ui/multi-select.kay'
import Toaster from '@kaynooo/kayjs-ui/toaster.kay'

// Each control writes what its `onOpenChange` heard to `calls`; the page drives the ones with `open` from a signal.
const { calls } = props<{ calls: string[] }>()

const planets = [{ value: 'mars', label: 'Mars' }, { value: 'earth', label: 'Earth' }]
const apps = [{ id: 'atlas', href: '/atlas', label: 'Atlas' }]
const multi = signal(false)
const date = signal(false)
const combo = signal(false)
const range = signal<'from' | 'to' | false>(false)
const switcher = signal(false)

const anchor = signal<Element | null>(null)
---
button#open-multi(onClick={() => multi = true}) Open multi
button#open-date(onClick={() => date = true}) Open date
button#open-range-to(onClick={() => range = 'to'}) Open range to
button#open-combo(onClick={() => combo = true}) Open combo
button#open-switcher(onClick={() => switcher = true}) Open switcher

button#anchor(onClick={event => anchor = event.currentTarget}) Anchor
button#clear(onClick={() => anchor = null}) Clear
MultiSelect(id="multi" label="Planets" options={planets} open={multi()} onOpenChange={shown => { calls.push(`multi ${shown}`); multi = shown }})
DateInput(id="date" aria-label="Day" open={date()} onOpenChange={shown => { calls.push(`date ${shown}`); date = shown }})
DateRangeInput(label="Stay" onOpenChange={(shown, box) => calls.push(`range ${box} ${shown}`)})
DateRangeInput(label="Held" open={range()} onOpenChange={(shown, box) => { calls.push(`held ${box} ${shown}`); if (!shown) range = false }})
Combobox(label="Planet" options={planets} open={combo()} onOpenChange={shown => { calls.push(`combo ${shown}`); combo = shown }})
AppSwitcher(id="switcher" apps={apps} open={switcher()} onOpenChange={shown => { calls.push(`switcher ${shown}`); switcher = shown }} data-testid="switch" aria-describedby="hint" style="color: red")

HoverCard#card(anchor={anchor()} onOpenChange={shown => calls.push(`card ${shown}`)}) Detail
Menu(id="menu" label="Actions" icon="plus" items={[{ label: 'One' }]} data-testid="menu" style="color: blue")
ConfirmDelete(message="Sure?" failureLabel="No" onConfirm={() => undefined} data-testid="confirm")
Toaster(data-testid="toaster")
