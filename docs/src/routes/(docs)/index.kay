--- server
import { highlightCode } from 'kay/content'
import { shareCard } from 'kay/image'
import { components } from '../../content.config'
import { highlight } from '../../highlight'
import { navigation } from '../../pages'

export const page = { prerender: true }

// Installation's own steps, which tests/docs.test.ts holds them to.
const REGISTRY = `[install.scopes]
"@kaynooo" = "https://git.kaynooo.fr/api/packages/kaynooo/npm/"`

const CREATE = `bunx -p @kaynooo/kayjs kay new my-app
cd my-app
bun install
bun run dev`

const SAMPLE = `--- server
import { s } from 'kay'
import { addTodo, listTodos } from '../todos'

export const add = action(
  s.Object({ title: s.String({ minLength: 1 }) }),
  ({ title }) => addTodo(title),
)

const todos = await listTodos()
---
h1 Todos
ul
  for todo of todos
    li {todo.title}
form(action={add})
  input(name="title")
  button Add`

const AUTH = `--- server
import { s } from 'kay'

const Credentials = s.Object({
  identifier: s.String({ maxLength: 254 }),
  password: s.String({ maxLength: 128 }),
})

export const signIn = action(Credentials, async (input, ctx) => {
  const result = await ctx.locals.auth.signInWithPassword(input)

  if (!result.ok)
    return ctx.fail(400, { error: result.error })

  return ctx.redirect(result.redirect)
})
---
form(action={signIn})
  input(name="identifier" autocomplete="username")
  input(name="password" type="password")
  button Sign in`

const MAIL = `---
import Button from '@kaynooo/kayjs-mail/button.kay'
import Layout from '@kaynooo/kayjs-mail/layout.kay'
import Paragraph from '@kaynooo/kayjs-mail/paragraph.kay'

const { name, url } = props<{ name: string, url: string }>()
---
Layout(preheader="Your account is ready")
  Paragraph Welcome, {name}. Confirm your address to start.
  Button(href={url}) Confirm my address`

const registry = await highlightCode(REGISTRY, 'toml', { highlight })
const create = await highlightCode(CREATE, 'bash', { highlight })
const sample = await highlightCode(SAMPLE, 'kay', { highlight })
const auth = await highlightCode(AUTH, 'kay', { highlight })
const mail = await highlightCode(MAIL, 'kay', { highlight })
const componentCount = (await components.all()).length
const { groups } = await navigation()
const features = [
  { title: 'One file per component', text: 'TypeScript fences, then an indented template. No JSX, no closing tags.', href: '/essentials/templates' },
  { title: 'HTML first', text: 'Pages render to plain HTML on the server. Only interactive components ship JavaScript.', href: '/essentials/islands' },
  { title: 'Typed forms', text: 'Actions take a schema, work without JavaScript and are called like functions from islands.', href: '/essentials/forms-and-actions' },
  { title: 'Checked templates', text: 'kay check types every template, checks each link against your routes and reports errors at the .kay line.', href: '/reference/checks' },
]
--- script
import Accessible from '~icons/tabler/accessible'
import Activity from '~icons/tabler/activity'
import Api from '~icons/tabler/api'
import Bolt from '~icons/tabler/bolt'
import ClockPlay from '~icons/tabler/clock-play'
import CloudUpload from '~icons/tabler/cloud-upload'
import Code from '~icons/tabler/code'
import Files from '~icons/tabler/files'
import HandClick from '~icons/tabler/hand-click'
import Icons from '~icons/tabler/icons'
import Language from '~icons/tabler/language'
import Photo from '~icons/tabler/photo'
import Rocket from '~icons/tabler/rocket'
import Route from '~icons/tabler/route'
import ServerBolt from '~icons/tabler/server-bolt'
import Seo from '~icons/tabler/seo'
import ShieldLock from '~icons/tabler/shield-lock'
import Terminal2 from '~icons/tabler/terminal-2'
import TestPipe from '~icons/tabler/test-pipe'
import WifiOff from '~icons/tabler/wifi-off'
import Button from '@kaynooo/kayjs-ui/button.kay'
import Card from '@kaynooo/kayjs-ui/card.kay'
import ModuleCard from '../../components/module-card.kay'
import Pager from '../../components/pager.kay'
import UiShowcase from '../../components/ui-showcase.kay'
import { FORGE } from '../../pages'
---
head
  title(raw) kay, a Bun web framework
  meta(property="og:image" content={shareCard({ title: 'kay, a Bun web framework' })})
  meta(property="og:image:alt" content="kay, a Bun web framework")
  link(rel="alternate" type="text/plain" href="/llms.txt" title="kay's documentation for agents")
.page.home
  header.page-head.hero
    h1 kay
    p.lede A Bun web framework. One #[code .kay] file per component, pages rendered to plain HTML on the server, interactive islands in the browser, and types down to the template line.
    .hero-actions
      Button(class="px-4 py-2 text-sm" variant="accent" href="/getting-started/introduction" label="Get started")
      Button(class="px-4 py-2 text-sm" href="/guides/tutorial" label="Follow the tutorial")
      Button(class="px-4 py-2 text-sm" href="/getting-started/choosing-kay" label="Choosing kay")
    ol.install
      li
        p Once, point Bun at kay's registry in #[code ~/.bunfig.toml]:
        div(innerHTML={registry})
      li
        p Then scaffold a project and start it:
        div(innerHTML={create})
  .home-body
    .hero-code(innerHTML={sample})
    ul.features
      for feature of features key={feature.href}
        li
          Card.link-card(bare)
            a(href={feature.href})
              strong {feature.title}
              span {feature.text}
    section.home-section(aria-labelledby="built-in")
      h2#built-in Built in
      p.section-lede Translations, accessibility checks, SEO, images, content, uploads, sessions, API routes, page swaps, server islands, caching, jobs, offline pages and icons come with kay, no plugin to add.
      ul.modules
        ModuleCard(title="i18n" use="kay/i18n" href="/guides/i18n")
          @icon
            Language
          | A prefix per locale, typed messages with plurals, dates, numbers, relative times and lists, and right-to-left pages.
        ModuleCard(title="Accessibility" use="kay check" href="/reference/checks#errors-and-warnings")
          @icon
            Accessible
          | Missing alt text, misspelt ARIA, unknown roles, nested controls and duplicate ids, reported at the .kay line.
        ModuleCard(title="SEO" use="kay/seo" href="/essentials/head-and-seo")
          @icon
            Seo
          | Titles a page overrides, canonical and Open Graph tags, share cards, a sitemap, robots.txt and JSON-LD.
        ModuleCard(title="Images" use="kay/image" href="/essentials/styling-and-assets#imported-images")
          @icon
            Photo
          | Imported images get WebP and AVIF variants in a srcset, their width and height, and crops to a shape.
        ModuleCard(title="Content" use="kay/content" href="/guides/content")
          @icon
            Files
          | Markdown, JSON and YAML collections checked against a schema, with components in Markdown, feeds and CMS sources.
        ModuleCard(title="File storage" use="kay/server" href="/guides/file-storage")
          @icon
            CloudUpload
          | Uploads kept on disk or in S3 under a key, resized for pages, private ones behind signed links, with upload progress in islands.
        ModuleCard(title="Sessions and guards" use="kay/server" href="/guides/sessions-and-guards")
          @icon
            ShieldLock
          | Typed locals from your Elysia plugins, sessions sealed in a cookie or kept in a store, and guards on any route.
        ModuleCard(title="API routes" use="kay/server" href="/guides/api-routes")
          @icon
            Api
          | Elysia modules in src/api, mounted at their path, with server-sent events and websockets.
        ModuleCard(title="Navigation" use="kay" href="/essentials/islands#page-navigation")
          @icon
            Route
          | A page with an island or a form swaps the next one in without a reload, keeping what stays, and a persist island plays on.
        ModuleCard(title="Server islands" use="server" href="/essentials/routing#server-islands")
          @icon
            ServerBolt
          | One component rendered per request inside a prerendered page, sent with it or fetched as it nears the screen.
        ModuleCard(title="Caching and streaming" use="kay/cache" href="/guides/caching-and-streaming")
          @icon
            Bolt
          | Cache a load or a whole page, and stream the slow parts of a page as they resolve.
        ModuleCard(title="Background jobs" use="kay/server" href="/guides/background-jobs")
          @icon
            ClockPlay
          | Cron schedules, workers running with the server, and queues whose jobs survive a restart and retry when they fail.
        ModuleCard(title="Offline" use="offline" href="/essentials/head-and-seo#offline")
          @icon
            WifiOff
          | A service worker keeping the build and the pages you pick, so an installed site opens and hydrates with no connection.
        ModuleCard(title="Icons" use="~icons" href="/essentials/styling-and-assets#icons")
          @icon
            Icons
          | Any Iconify set, imported one icon at a time as a tag that sizes to the text and takes its colour.
    section.home-section(aria-labelledby="tooling")
      h2#tooling Tooling
      p.section-lede A language server, a scaffolder, an inspector, test helpers, one-command builds and request logs, each made for .kay files.
      ul.modules
        ModuleCard(title="Editor" use="kay lsp" href="/getting-started/installation#editor")
          @icon
            Code
          | A language server for VS Code or any LSP editor: errors, completion with auto-import, rename and formatting in .kay files.
        ModuleCard(title="New projects" use="kay new" href="/reference/cli#kay-new")
          @icon
            Terminal2
          | A static site, a server or an app with sign-in over Postgres, with Tailwind, ESLint, tests, CI and Docker to pick from.
        ModuleCard(title="Dev inspector" use="kay dev" href="/reference/cli#inspector")
          @icon
            HandClick
          | Alt+click any element to open the .kay line that wrote it, and watch each island's signals as they change.
        ModuleCard(title="Testing" use="kay/test" href="/guides/testing")
          @icon
            TestPipe
          | Visit pages, post forms and sign users in from bun test with no server, or open a page in a headless Chrome.
        ModuleCard(title="Deployment" use="kay build" href="/guides/deployment")
          @icon
            Rocket
          | The server, its pages and the client build as one executable, a static export, or a Docker image with a health check.
        ModuleCard(title="Logs and tracing" use="tracer" href="/guides/deployment#logs-and-tracing")
          @icon
            Activity
          | One line per request carrying its id, JSON logs for a collector, and OpenTelemetry spans for each load and render.
    section.home-section(aria-labelledby="libraries")
      h2#libraries Libraries
      p.section-lede UI components, sign-in, mail and a CMS, each a package of its own for the sites that need it.
      .libraries
        Card.library(bare)
          .library-body
            header.library-head
              h3
                a(href="/libraries/kayjs-ui") kayjs-ui
              p {componentCount} components your app compiles as its own: dialogs, tables, forms, charts, a command palette and more, restyled from one stylesheet. Try them:
            UiShowcase
        Card.library(bare)
          .library-body
            header.library-head
              h3
                a(href="/libraries/kayjs-auth") kayjs-auth
              p Passwords, OAuth, magic links, TOTP two-factor and bearer tokens on kay's sessions. It ships no UI: your pages call it.
            div(innerHTML={auth})
        Card.library(bare)
          .library-body
            header.library-head
              h3
                a(href="/libraries/kayjs-mail") kayjs-mail
              p Mails written as .kay components, rendered to HTML and text, sent over SMTP or queued with retries. Tests read an outbox.
            div(innerHTML={mail})
        Card.library(bare)
          .library-body
            header.library-head
              h3
                a(href="/libraries/kayjs-cms") kayjs-cms
              p Content edited on the page it renders, and screens listing, adding and publishing each collection's entries, saved as Forgejo commits.
    section.home-section(aria-labelledby="docs")
      h2#docs The documentation
      p.section-lede Pages written for people, by section. Agents read #[a(href="/llms.txt") llms.txt], the index of the full reference.
      ul.doc-map
        for group of groups key={group.title}
          li
            h3 {group.title}
            ul
              for link of group.links key={link.href}
                li
                  a(href={link.href}) {link.title}
  Pager(next={{ href: '/getting-started/introduction', title: 'Introduction' }} source={`${FORGE}/docs/src/routes/(docs)/index.kay`})
