--- <Value extends string | number>
import type { JSX, Snippet } from 'kay'
import type { IconProps } from 'kay/icons'
import type { IconSlot } from './defaults'
import { effect, postedValues, recipe, signal, uid, untrack } from 'kay'
import { changeAccepted } from './change'
import { GROUP_INVALID, LABEL_TEXT } from './field-look'
import { onFormReset, resetWhenIdle, startRef } from './form-reset'
import { linkChoice } from './choice-link'
import Icon from './icon.kay'
import { loadOptions } from './options-source'
import type { OptionsSource } from './options-source'
import { wording } from 'kay/words'

const NONE: readonly never[] = []

// 'kui-chip' stays as the name of a chip for an app's CSS and the skins; the label reads the input before it.
const look = recipe({
  parts: {
    root: `kui-chip-group group/chips flex flex-wrap gap-2 ${GROUP_INVALID}`,
    chip: 'kui-chip relative cursor-pointer has-[input:disabled]:opacity-50 group-aria-busy/chips:cursor-progress group-not-aria-busy/chips:has-[input:disabled]:cursor-not-allowed',
    input: 'peer/chip absolute size-0 opacity-0',
    label: 'inline-flex items-center gap-1 rounded-md border-solid border-[length:var(--border-width)] bg-surface px-2.5 py-1 text-xs text-muted transition-colors [border-color:var(--_control-line,var(--color-border))] hover:text-foreground peer-checked/chip:border-accent peer-checked/chip:bg-accent peer-checked/chip:text-accent-foreground peer-checked/chip:hover:text-accent-foreground peer-focus-visible/chip:outline-2 peer-focus-visible/chip:outline-offset-2 peer-focus-visible/chip:outline-accent',
    icon: 'size-3.5 shrink-0',
    field: 'flex flex-col gap-1',
    heading: LABEL_TEXT,
    retry: 'cursor-pointer self-center text-xs text-accent underline',
    status: 'self-center text-xs text-muted',
  },
})

const { options, value = NONE, label, showLabel = false, name, invalid, required, requiredLabel = wording('ui.chipGroup.required', 'Pick at least one'), disabled = false, loadingLabel = wording('ui.chipGroup.loading', 'Loading…'), retryLabel = wording('ui.chipGroup.retry', 'Try again'), failureLabel = wording('ui.chipGroup.failure', 'Could not load the options'), onLoad, onError, onChange, option: drawRow, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'children' | 'role' | 'onChange' | 'onLoad' | 'onError'> & {
  // `icon` sits before the label; `disabled` keeps that chip as it is.
  // A list, a promise of one, or a function answering it, such as an action: asked in the browser, the group busy under `loadingLabel` until the answer lands, or under `failureLabel` once it rejected.
  options: OptionsSource<{ value: Value, label: string, icon?: IconSlot | IconProps | undefined, disabled?: boolean | undefined }>
  loadingLabel?: string | undefined
  retryLabel?: string | undefined
  failureLabel?: string | undefined
  // Called with each answer of a function or promise `options`, and with what it rejected with.
  onLoad?: ((options: readonly { value: Value, label: string, icon?: IconSlot | IconProps | undefined, disabled?: boolean | undefined }[], query: string) => unknown) | undefined
  onError?: ((failure: { error: unknown, query: string }) => unknown) | undefined
  // The options picked to start with, in any order, none when left out; a group whose parent passes others follows them.
  value?: readonly Value[] | undefined
  // Names the group for screen readers.
  label: string
  // Writes `label` above the chips, in a Slider's label type, and names the group by it.
  showLabel?: boolean | undefined
  // Disables every chip; an option's own `disabled` still applies when this is false.
  disabled?: boolean | undefined
  // Marks the group as refused, its chips' keylines in the danger colour, with `aria-invalid` on the group. A FormField showing a message marks the boxes on its own.
  invalid?: boolean | undefined
  // Requires at least one chip picked: `aria-required` on each box, and the first enabled box refuses the form's submit, with `requiredLabel`, while none is picked, as the browser cannot ask for one of several checkboxes itself.
  required?: boolean | undefined
  requiredLabel?: string | undefined
  // The checkboxes' name, which the group submits under inside a form, once per picked option; one unique on the page is drawn when none is given.
  name?: string | undefined
  // Gets every picked option, in the order of `options`.
  // A promise holds the group busy until it settles, and puts the previous pick back when it resolves to false, rejects or throws (logged): a refused change never shows as made.
  // Typed `unknown`, so a callback answering something else, such as `list.push`, still fits.
  // Gets the picked options as a second argument, in the same order.
  onChange?: ((value: Value[], options: { value: Value, label: string, icon?: IconSlot | IconProps | undefined, disabled?: boolean | undefined }[]) => unknown) | undefined
  // Draws each option in place of its label (and icon): `@option(option)`. The input stays named by the option's `label`, and keeps its checked and disabled state.
  option?: Snippet<[option: { value: Value, label: string, icon?: IconSlot | IconProps | undefined, disabled?: boolean | undefined }]> | undefined
}>()

const source = loadOptions<{ value: Value, label: string, icon?: IconSlot | IconProps | undefined, disabled?: boolean | undefined }>(() => options, { onLoad, onError, label: 'ChipGroup' })
const list = source.options
const group = name ?? uid()
// The heading's id while `showLabel` writes it, which then names the group in place of `aria-label`.
const heading = showLabel ? uid() : undefined
// Held as string or number: a signal cannot take a type parameter that might be a function.
// A group with no callback is plain: a refused post of its form, which the server renders it for, gives its choices back in place of its own.
const sent = onChange ? undefined : postedValues(name, value)
const picked = signal<readonly (string | number)[]>(sent === undefined ? value : list().map(one => one.value).filter(one => sent.includes(String(one))))
const busy = signal(false)
let root: HTMLElement | undefined
// How often the parent's `value` reached the group, so a change under way knows whether the parent answered it.
let synced = 0

// The first run leaves a start the server refilled alone, which the browser reads from its markup.
let refilled = sent !== undefined

effect(() => {
  const next = value

  if (refilled) {
    refilled = false

    return
  }

  picked = next
  synced++
})

const boxes = () => [...root?.querySelectorAll<HTMLInputElement>('[data-part=input]') ?? []]

// Ticks the boxes of `wanted` again, in this group only: the binding may never have seen the box that took the click.
// A box holds its value as text, so a number option is found by its text.
function check(wanted: readonly (string | number)[]) {
  const texts = new Set(wanted.map(String))

  for (const box of boxes())
    box.checked = texts.has(box.value)
}

async function pick(next: Value[]) {
  const before = picked()
  const syncedBefore = synced

  picked = next

  // Put back unless the parent set `value` meanwhile, which has the last word.
  if (!(await changeAccepted('ChipGroup', () => onChange?.(next, list().filter(one => next.includes(one.value))), busy.set)) && synced === syncedBefore) {
    picked = before
    check(before)
  }

  resetting.idle()
}

function toggle(input: HTMLInputElement, option: Value) {
  void pick(list().map(one => one.value).filter(one => one === option ? input.checked : picked().includes(one)))
}

const ref = startRef<HTMLElement>((element) => {
  root = element
  linkChoice(element)
}, rest.ref)

// A reset puts the boxes back on their defaults, which the app's `onChange` then hears of; one meeting a change under way waits for it.
const resetting = resetWhenIdle(busy, () => {
  const ticked = new Set(boxes().filter(box => box.defaultChecked).map(box => box.value))
  const next = list().map(one => one.value).filter(one => ticked.has(String(one)))

  check(next)

  if (next.length !== picked().length || next.some(one => !picked().includes(one)))
    void pick(next)
})

onFormReset(() => root, resetting.reset)

// No native attribute asks for one of several checkboxes, so the first enabled box holds the form back while none is picked.
effect(() => {
  list()

  const message = required && picked().length === 0 ? requiredLabel : ''

  const holder = boxes().find(box => !box.disabled)

  for (const box of boxes())
    box.setCustomValidity(box === holder ? message : '')
})
---
// Real checkboxes drawn as chips, so the group submits like any other field and Space toggles the focused chip. A click while a change is under way ticks nothing.
snippet chips()
  div(part="root" {...rest} ref={ref} role="group" data-kui-choice="" aria-label={heading ? undefined : label} aria-labelledby={heading ?? rest['aria-labelledby']} aria-invalid={invalid ? 'true' : rest['aria-invalid']} aria-busy={busy() || source.loading() ? 'true' : undefined})
    for option of list() key={option.value}
      label(part="chip")
        input(part="input" ref={element => element.defaultChecked = untrack(() => picked().includes(option.value))} type="checkbox" name={group} value={option.value} checked={picked().includes(option.value)} disabled={disabled || option.disabled} aria-label={drawRow ? option.label : undefined} aria-required={required ? 'true' : undefined} onClick={event => { if (busy()) event.preventDefault() }} onChange={event => toggle(event.currentTarget, option.value)})
        span(part="label")
          if drawRow
            | {drawRow(option)}
          else
            if option.icon
              Icon(icon={option.icon} part="icon")
            | {option.label}
    if source.loading()
      p(part="status" role="status") {loadingLabel}
    if source.failed()
      p(part="status" role="alert") {failureLabel}
      if source.retryable()
        button(part="retry" type="button" onClick={source.retry}) {retryLabel}
if showLabel
  div(part="field")
    span(part="heading" id={heading}) {label}
    {chips()}
else
  {chips()}
