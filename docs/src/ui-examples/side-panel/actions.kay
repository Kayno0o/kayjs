---
import Button from '@kaynooo/kayjs-ui/button.kay'
import IconButton from '@kaynooo/kayjs-ui/icon-button.kay'
import SidePanel from '@kaynooo/kayjs-ui/side-panel.kay'

const open = signal(false)
---
Button(label="Open panel" onClick={() => open.set(true)})
SidePanel(open={open()} title="Moons" onClose={() => open.set(false)})
  @actions
    IconButton(icon="back" label="Previous" variant="ghost")
  p Io, Europa, Ganymede and Callisto.
