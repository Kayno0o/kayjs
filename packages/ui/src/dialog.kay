---
import type { JSX, Snippet } from 'kay'
import { effect, recipe, signal } from 'kay'
import { wording } from 'kay/words'
import IconButton from './icon-button.kay'
import { closeWatcher, followsHref, leave, renderedOpen, syncOpen } from './overlay'

// 'kui-dialog' stays as the component's name for an app's CSS and the always-hidden guard.
const look = recipe({
  parts: {
    root: 'kui-dialog m-auto flex max-h-[calc(100dvh-2rem)] w-full max-w-[min(42rem,calc(100vw-2rem))] flex-col overflow-hidden rounded-lg border-solid border-[length:var(--border-width)] border-border-strong bg-surface p-0 [&[open]:not(:modal)]:fixed [&[open]:not(:modal)]:inset-0 [&[open]:not(:modal)]:z-30 [&[open]:not(:modal)]:h-fit [&[open]:not(:modal):not([data-modal=false])]:shadow-[0_0_0_100vmax_rgb(0_0_0/0.5)]',
    head: 'flex shrink-0 items-center gap-2 border-b border-border px-5 py-3',
    title: 'min-w-0 flex-1 text-lg [font-weight:var(--font-weight-semibold)] tracking-label text-foreground [font-family:var(--font-label,inherit)] [text-transform:var(--label-case)]',
    // The body of a `bare` dialog writes data-bare too, as a child cannot read the attribute of its parent in a utility.
    body: 'min-h-0 flex-1 overflow-y-auto px-5 py-4 data-bare:overflow-hidden data-bare:p-0',
    footer: 'flex shrink-0 flex-wrap justify-end gap-2 border-t border-border px-5 py-4',
  },
  variants: {
    // The width, the one vocabulary of every overlay: `sm`, `md` (the default), `lg`, or `full`, which takes the whole viewport width and height less the margin, for content such as a canvas that fills the dialog.
    size: {
      sm: { root: 'max-w-[min(28rem,calc(100vw-2rem))]' },
      md: '',
      lg: { root: 'max-w-[min(72rem,calc(100vw-2rem))]' },
      full: { root: 'h-[calc(100dvh-2rem)] max-w-[calc(100vw-2rem)]' },
    },
  },
  defaults: { size: 'md' },
})

const { open, title, heading, level = 2, size = 'md', bare = false, dirty = false, modal = true, closeHref, actions, header, close, closeLabel = wording('ui.dialog.close', 'Close'), onOpenChange, footer, ...rest } = props<Omit<JSX.IntrinsicElements['dialog'], 'open' | 'class' | 'title' | 'onClose' | 'onInput' | 'closedby' | 'closedBy'> & {
  // Shows the dialog, as a modal unless `modal` is false; the parent sets it back to false in `onOpenChange`.
  open: boolean
  // Names the dialog for screen readers, and is the heading unless a `@heading` block draws it.
  title: string
  // Markup in the heading in place of the title's text, such as an icon, a status badge or an emphasised name: the dialog is still named by `title`.
  heading?: Snippet
  // The title's heading level: a modal opens over the page's own `h1`.
  level?: 2 | 3 | 4 | 5 | 6 | undefined
  // No inset or scroll on the body, for content that runs to the dialog's edge; the title and footer keep theirs.
  bare?: boolean | undefined
  // Work the dialog must not drop, such as a request in flight: a click outside or Escape leaves it open. Typing inside the dialog counts on its own, though Escape still closes one with no footer.
  dirty?: boolean | undefined
  // `false` shows the dialog over the page without blocking it: the page stays interactive, a click outside leaves it open and only Escape or the close control closes it. It renders open on the server, so a page driven by the URL shows it with no JavaScript.
  modal?: boolean | undefined
  // Controls in the head line, before its close button, such as previous and next.
  actions?: Snippet
  // The whole head line in place of the title, `actions` and the close button.
  header?: Snippet
  // The close button in place of the library's own: it closes by `onOpenChange(false)`, or by going to `closeHref`.
  close?: Snippet
  closeLabel?: string | undefined
  footer?: Snippet
} & (
  // Makes the close control a link to this URL, for a dialog open on the server whose close needs no JavaScript; the link navigates and `onOpenChange(false)` is called as well, so its handler need not navigate. Without an `onOpenChange`, Escape follows it too, so a server page renders the dialog with no island of its own.
  | { closeHref: string, onOpenChange?: undefined }
  // Called with `false` however the dialog closes, a click outside and Escape included. Closed by Escape or a click outside, its content is still there to read; closed by the parent setting `open` to false, it is already gone.
  | { closeHref?: string | undefined, onOpenChange: (open: boolean) => unknown }
)>()

// Set by any typing inside, and cleared however the dialog closes, since every way ends in its `close` event.
const edited = signal(false)
let dialog: HTMLDialogElement | undefined

// Read once: the open attribute is what the server renders, and the client opens and closes the dialog by its methods.
// kay-allow once-read-prop
const serverOpen = renderedOpen(open, modal, closeHref)

effect(() => {
  const shown = open

  if (dialog)
    syncOpen(dialog, shown, modal)
})

function closed() {
  edited = false
  leave(closeHref, onOpenChange)
}
---
// Named by its title for screen readers, which announce the dialog as it opens.
dialog(aria-label={title} {...rest} open={serverOpen} data-modal={modal ? undefined : 'false'} data-size={size === 'md' ? undefined : size} data-bare={bare ? '' : undefined} ref={element => dialog = element} closedby={closeWatcher({ modal, dirty, edited: edited(), footer: footer !== undefined })} onInput={() => edited = true} onClose={closed})
  if open
    header(part="head")
      if header
        | {header}
      else
        if level === 2
          h2(part="title") {heading ?? title}
        else if level === 3
          h3(part="title") {heading ?? title}
        else if level === 4
          h4(part="title") {heading ?? title}
        else if level === 5
          h5(part="title") {heading ?? title}
        else
          h6(part="title") {heading ?? title}
        | {actions}
        if close
          | {close}
        else
          IconButton(icon="close" label={closeLabel} variant="ghost" href={closeHref} disabled={dirty} onClick={() => followsHref(closeHref, onOpenChange) || dialog?.close()})
    div(part="body" data-bare={bare ? '' : undefined})
      slot
    if footer
      div(part="footer")
        | {footer}
