--- server
import Button from '@kaynooo/kayjs-ui/button.kay'
import EmptyState from '@kaynooo/kayjs-ui/empty-state.kay'
import PageSection from '@kaynooo/kayjs-ui/page-section.kay'
import Pagination from '@kaynooo/kayjs-ui/pagination.kay'
import { s } from 'kay'
import { wording } from 'kay/words'
import EntryTable from '../../../components/entry-table.kay'
import { collectionTitle, newEntryPath } from '../../../listing'
import { listScreen } from '../../../screens'

export const page = { query: s.Object({ q: s.Optional(s.String()), page: s.Optional(s.Integer()) }) }

const search = ctx.query.q ?? ''
const { prefix, collection, ...listed } = await listScreen({ collection: ctx.params.collection, q: search, page: ctx.query.page }) ?? ctx.notFound()
const url = ctx.url
const title = collectionTitle(collection)
---
head
  title {title}
PageSection(title={title} level={1})
  @actions
    if collection.problem === undefined
      Button(href={newEntryPath(prefix, collection.name)} label={wording('cms.admin.newEntry', 'New entry')} icon="plus" tone="accent")
  if collection.problem as problem
    EmptyState(title={wording('cms.admin.collectionUnreadable', 'This collection cannot be read')} description={problem})
  else
    form.kcms-search(method="get" role="search")
      input.kui-field-input(type="search" name="q" value={search} placeholder={wording('cms.admin.search', 'Search')} aria-label={wording('cms.admin.searchLabel', 'Search entries')})
    EntryTable(prefix={prefix} collection={collection} rows={listed.rows} searched={search !== ''})
    Pagination(page={listed.page} pages={listed.pages} url={url})
