---
import type { PaletteEntry } from '@kaynooo/kayjs-ui'
import type { Navigation } from '../pages'
import CommandPalette from '@kaynooo/kayjs-ui/command-palette.kay'
import { onCleanup, onMount, signal } from 'kay'
import SearchIcon from '~icons/tabler/search'

const { nav } = props<{ nav: Navigation }>()

// Every page by its title, so an empty query lists the docs as the sidebar does, and the site search finds the sections inside them.
const entries: PaletteEntry[] = [
  ...nav.groups.flatMap(group => group.links.map(link => ({ label: link.title, group: group.title, href: link.href }))),
  ...nav.components.map(link => ({ label: link.title, group: 'UI components', href: link.href })),
]

const open = signal(false)
const shortcut = signal('Ctrl K')

const typing = (target: EventTarget | null) => target instanceof HTMLElement && (target.isContentEditable || ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName))

// The palette opens on Ctrl or Cmd K itself; / opens it too, as on most docs sites.
function onSlash(event: KeyboardEvent) {
  if (event.key === '/' && !typing(event.target)) {
    event.preventDefault()
    open.set(true)
  }
}

onMount(() => {
  if (navigator.platform.startsWith('Mac'))
    shortcut.set('Cmd K')
  window.addEventListener('keydown', onSlash)
})

onCleanup(() => window.removeEventListener('keydown', onSlash))
---
button.search-trigger(type="button" aria-haspopup="dialog" onClick={() => open.set(true)})
  SearchIcon
  span Search
  kbd {shortcut()}
CommandPalette(entries={entries} open={open()} onOpenChange={open.set} siteSearch={{ limit: 40 }} label="Search the documentation" placeholder="Search the docs")
