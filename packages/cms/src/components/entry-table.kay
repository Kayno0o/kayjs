---
import type { Column, SortState } from '@kaynooo/kayjs-ui'
import type { ScreenCollection } from '../kay/contract'
import type { EntryRow } from '../listing'
import Badge from '@kaynooo/kayjs-ui/badge.kay'
import Button from '@kaynooo/kayjs-ui/button.kay'
import ConfirmDelete from '@kaynooo/kayjs-ui/confirm-delete.kay'
import EmptyState from '@kaynooo/kayjs-ui/empty-state.kay'
import Table from '@kaynooo/kayjs-ui/table.kay'
import { navigate, refresh, signal } from 'kay'
import { wording } from 'kay/words'
import { duplicateSaved } from '../editor/bulk'
import { readReferrers } from '../editor/referrers'
import { deleteSaved, moveSaved, publishSaved, unpublishSaved } from '../editor/save'
import EntryBulk from './entry-bulk.kay'
import EntryStatus from './entry-status.kay'
import EntryWatch from './entry-watch.kay'
import { shipWords } from '../editor/words'
import { fieldsOf } from '../fields'
import { listColumns, rowActions } from '../layout'
import { deleteMessage, entryPath, newEntryPath, onPagePath, problemId, statusOf } from '../listing'
import { WATCHED_ROWS } from '../room'

// `sort` is the column the rows come sorted by, the server having sorted them across the pages: a click on a header goes to the same list sorted by that column.
const { prefix, collection, rows, searched, sort } = props<{ prefix: string, collection: ScreenCollection, rows: EntryRow[], searched: boolean, sort?: SortState | undefined }>()

// Looks up what a save says once the page has loaded, so the page sends it.
shipWords()

// The columns and row actions the collection's layout names, all actions by default.
const shown = listColumns(fieldsOf(collection.schema), collection.layout?.list)
const actions = rowActions(collection.layout?.list)

// What names the row whose delete confirmation was opened last, read then so it is never older than the click.
const referrers = signal<Record<string, string[]>>({})

async function askReferrers(row: EntryRow): Promise<void> {
  referrers.set({})
  referrers.set(await readReferrers(collection.name, [row.slug]))
}

// A field's column is keyed apart from the built-in ones, so a field named `title` or `actions` clashes with none.
const cellKey = (key: string | number) => `cell:${key}`

// Numbers sort by value, not by their text.
const sortKey = (kind: string, text = ''): string | number => kind === 'number' || kind === 'integer' ? Number(text) || 0 : text

const columns: Column<EntryRow>[] = [
  { key: 'title', header: wording('cms.table.title', 'Title'), sortValue: true, defaultDirection: 'asc', cell: true },
  ...shown.map(field => ({ key: cellKey(field.key), header: field.label, sortValue: (row: EntryRow) => sortKey(field.kind, row.cells?.[field.key]), cell: true }) satisfies Column<EntryRow>),
  ...(collection.localized ? [{ key: 'locale', header: wording('cms.table.locale', 'Locale'), sortValue: true, cell: true } satisfies Column<EntryRow>] : []),
  ...(collection.draftField === undefined && collection.publishField === undefined && collection.unpublishField === undefined ? [] : [{ key: 'draft', header: wording('cms.table.status', 'Status'), sortValue: (row: EntryRow) => ['draft', 'scheduled', 'published'].indexOf(statusOf(row)), cell: true } satisfies Column<EntryRow>]),
  ...(actions.size === 0 ? [] : [{ key: 'actions', header: wording('cms.table.actions', 'Actions'), align: 'end', cell: true } satisfies Column<EntryRow>]),
]

const ref = (row: EntryRow) => ({ collection: collection.name, slug: row.slug, locale: row.locale })
const keyOf = (row: EntryRow) => row.locale === undefined ? row.slug : `${row.slug}@${row.locale}`
// Only the first rows of a page watch their entry.
const watched = (row: EntryRow) => rows.slice(0, WATCHED_ROWS).some(first => keyOf(first) === keyOf(row))

async function publish(row: EntryRow): Promise<void> {
  if (await publishSaved(ref(row)))
    await refresh()
}

async function unpublish(row: EntryRow): Promise<void> {
  if (await unpublishSaved(ref(row)))
    await refresh()
}

async function move(row: EntryRow, direction: 'up' | 'down'): Promise<void> {
  if (await moveSaved(ref(row), direction))
    await refresh()
}

async function copy(row: EntryRow): Promise<void> {
  const slug = await duplicateSaved(ref(row))

  if (slug !== undefined)
    await navigate(entryPath(prefix, { ...ref(row), slug }))
}

// Goes to the same list sorted the way the header asks, from its first page.
async function sortBy(next: SortState): Promise<void> {
  await navigate({ query: { sort: next.key, dir: next.direction, page: null } })
}

// The bulk actions the layout keeps; the table lets rows be ticked only when it has one.
const bulkable = ['publish', 'unpublish', 'delete'].some(action => actions.has(action as never) && (action === 'delete' || collection.draftField !== undefined))

async function remove(row: EntryRow): Promise<void> {
  if (await deleteSaved(ref(row), row.version))
    await refresh()
}
---
Table.kcms-entries(columns={columns} rows={rows} rowKey={keyOf} sort={sort} serverSort onSort={sortBy} selectable={bulkable})
  @bulk(keys, clear)
    EntryBulk(collection={collection} rows={rows.filter(row => keys.includes(keyOf(row)))} actions={actions} clear={clear})
  @cell(row, column)
    if column.key === 'title'
      // Why an entry is broken shows on the link too, so a keyboard reaches it and a screen reader reads it with the title.
      a(href={entryPath(prefix, ref(row))} data-tooltip={row.problem} aria-describedby={row.problem === undefined ? undefined : problemId(collection.name, keyOf(row))}) {row.title}
      if row.problem as problem
        Badge(tone="danger" label={wording('cms.table.broken', 'Broken')})
        span.kcms-sr-only(id={problemId(collection.name, keyOf(row))}) {problem}
      if watched(row)
        EntryWatch(collection={collection.name} entry={ref(row)})
    else if column.key.startsWith('cell:')
      span {row.cells?.[column.key.slice(5)] ?? ''}
    else if column.key === 'locale'
      span {row.locale}
      if row.missing as lacks
        Badge(tone="warning" label={wording('cms.table.missingLocales', 'No {locales}', { locales: lacks.join(', ') })})
    else if column.key === 'draft'
      if row.draft
        Badge(tone="warning" label={wording('cms.entry.draft', 'Draft')})
      else
        EntryStatus(at={row.scheduledAt} end={row.endsAt})
    else
      .kcms-row-actions
        if actions.has('move')
          if row.move as place
            Button(label={wording('cms.table.moveUp', 'Up')} aria-label={wording('cms.table.moveUpLabel', 'Move {title} up', { title: row.title })} disabled={!place.up} onClick={() => move(row, 'up')})
            Button(label={wording('cms.table.moveDown', 'Down')} aria-label={wording('cms.table.moveDownLabel', 'Move {title} down', { title: row.title })} disabled={!place.down} onClick={() => move(row, 'down')})
        if actions.has('publish') && row.draft && collection.draftField !== undefined
          Button(label={wording('cms.entry.publish', 'Publish')} aria-label={wording('cms.table.publishLabel', 'Publish {title}', { title: row.title })} onClick={() => publish(row)})
        if actions.has('unpublish') && !row.draft && row.problem === undefined && collection.draftField !== undefined
          ConfirmDelete(tone="neutral" trigger="button" label={wording('cms.entry.unpublish', 'Unpublish')} message={wording('cms.entry.unpublishMessage', 'Unpublish {title}? Visitors stop seeing it until you publish it again.', { title: row.title })} failure={wording('cms.entry.unpublishFailure', 'Could not unpublish')} onConfirm={() => unpublish(row)})
        if actions.has('duplicate') && !collection.single && row.problem === undefined
          Button(label={wording('cms.table.duplicate', 'Duplicate')} aria-label={wording('cms.table.duplicateLabel', 'Duplicate {title}', { title: row.title })} onClick={() => copy(row)})
        if actions.has('editOnPage')
          if row.url as url
            Button(href={onPagePath(prefix, url)} label={wording('cms.entry.editOnPage', 'Edit on page')} aria-label={wording('cms.table.editOnPageLabel', 'Edit on page: {title}', { title: row.title })})
        if actions.has('delete')
          ConfirmDelete(message={deleteMessage(row.title, row.url, 'table', referrers()[row.slug])} onOpen={() => askReferrers(row)} label={wording('cms.table.deleteLabel', 'Delete {title}', { title: row.title })} failure={wording('cms.save.deleteFailure', 'Could not delete')} size="sm" variant="ghost" onConfirm={() => remove(row)})
  @empty
    if searched
      EmptyState(title={wording('cms.table.noMatch', 'No match')} description={wording('cms.table.noMatchHint', 'No entry matches the search and the filter.')})
    else
      EmptyState(title={wording('cms.table.empty', 'No entries yet')})
        @actions
          Button(href={newEntryPath(prefix, collection.name)} label={wording('cms.admin.newEntry', 'New entry')} icon="plus" tone="accent")
