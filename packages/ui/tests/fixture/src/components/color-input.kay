---
import { signal } from 'kay'
import ColorInput from '@kaynooo/kayjs-ui/color-input.kay'

// A ColorInput the page keeps in a signal, inside a form with a second field to prove the name posts, and a button moving the colour from outside.
const { onChange } = props<{ onChange?: (value: string) => unknown }>()

const light = signal('#ff8800')
---
form#form
  h2#tint-heading Tint heading
  ColorInput#light(label="Light" name="light" value={light()} onChange={(value: string) => onChange ? onChange(value) : light.set(value)})
  ColorInput#named(label="Accent" name="named" aria-label="Accent colour of the theme" value="#445566")
  ColorInput#labelled(label="Tint" name="labelled" aria-labelledby="tint-heading" value="#778899")
  ColorInput#locked(label="Locked" name="locked" value="#112233" disabled)
  button#set(type="button" onClick={() => light.set('#00ff00')}) Set
  button#upper(type="button" onClick={() => light.set('#ABCDEF')}) Upper
  button#invalid(type="button" onClick={() => light.set('red')}) Invalid
  button#reset(type="reset") Reset
  p#state {light()}
