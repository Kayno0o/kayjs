---
import { signal } from 'kay'
import Meter from '@kaynooo/kayjs-ui/meter.kay'

const usage = signal(40)
---
.flex.max-w-sm.flex-col.gap-3
  Meter(value={usage()} label="Disk" showValue thresholds={[{ upTo: 70, tone: 'success' }, { upTo: 90, tone: 'warning' }, { upTo: Infinity, tone: 'danger' }]})
  input(
    type="range"
    min="0"
    max="100"
    value={usage()}
    onInput={event => usage = Number(event.currentTarget.value)}
    aria-label="Usage"
  )
