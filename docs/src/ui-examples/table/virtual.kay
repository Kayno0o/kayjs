---
import type { Column } from '@kaynooo/kayjs-ui'
import Table from '@kaynooo/kayjs-ui/table.kay'

interface Order {
  id: number
  customer: string
  total: number
}

const orders: Order[] = Array.from({ length: 2_000 }, (_, index) => ({ id: index + 1, customer: `Customer ${index % 97}`, total: (index * 37) % 500 }))

const columns: Column<Order>[] = [
  { key: 'id', header: 'Order', sortValue: true },
  { key: 'customer', header: 'Customer', sortValue: true },
  { key: 'total', header: 'Total', numeric: true },
]
---
Table(columns={columns} rows={orders} rowKey="id" filter={['customer']} virtual)
