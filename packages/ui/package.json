{
  "name": "@kaynooo/kayjs-ui",
  "type": "module",
  "version": "1.46.0",
  "description": "Components for kay apps: dialogs, tables, toasts, forms and more, as .kay sources the app compiles as its own",
  "author": "Kaynooo <https://github.com/Kayno0o>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kayno0o/kayjs",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/Kayno0o/kayjs/issues"
  },
  "publishConfig": {
    "registry": "https://git.kaynooo.fr/api/packages/kaynooo/npm/"
  },
  "sideEffects": false,
  "kay": {
    "settings": "./src/settings.ts"
  },
  "exports": {
    "./*.kay": "./src/*.kay",
    "./theme.css": "./src/theme.css",
    "./dnd": "./src/dnd.ts",
    ".": "./src/index.ts"
  },
  "files": [
    "LICENSE",
    "README.md",
    "llms.txt",
    "src"
  ],
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "prepare": "$npm_execpath ../../scripts/link-fixture.ts",
    "check": "$npm_execpath check",
    "prelint": "bun run --cwd ../.. build:eslint",
    "lint": "keslint --cache",
    "prelint:fix": "bun run --cwd ../.. build:eslint",
    "lint:fix": "keslint --fix --cache",
    "test": "bun test && bun run test:dom",
    "test:dom": "bun --config=tests-dom/bunfig.toml test"
  },
  "peerDependencies": {
    "@iconify-json/tabler": "^1.2.41",
    "chartist": "^1.5.0",
    "hls.js": "^1.7.0",
    "kay": "~1.46.0",
    "tailwindcss": "^4.3.3"
  },
  "peerDependenciesMeta": {
    "chartist": {
      "optional": true
    },
    "hls.js": {
      "optional": true
    }
  },
  "dependencies": {
    "@kaynooo/utils": "^2.30.1"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@iconify-json/tabler": "^1.2.41",
    "@kaynooo/eslint": "^7.0.4",
    "@types/bun": "^1.4.2",
    "chartist": "^1.5.0",
    "elysia": "^1.4.30",
    "hls.js": "^1.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
