--- server
import { shareCard } from 'kay/image'
import { components, reference } from '../../../content.config'
import { libraryRoot, neighbours } from '../../../pages'

export const page = { prerender: components }

const component = await components.get(ctx.params.component) ?? ctx.notFound()
const { Content } = component
const { title, description, props, parts } = component.data
const version = (await reference.get('kayjs-ui'))?.data.version
const sections = [
  ...component.headings.filter(heading => heading.depth === 2 || heading.depth === 3),
  { id: 'api', text: 'API', depth: 2 },
]
const { previous, next } = neighbours(await components.all(), component.slug, slug => `/ui/${slug}`)
--- script
import Pager from '../../../components/pager.kay'
import Toc from '../../../components/toc.kay'
---
head
  title {title} · kayjs-ui
  meta(name="description" content={description})
  meta(property="og:image" content={shareCard({ title })})
  meta(property="og:image:alt" content={title})
.page
  header.page-head
    p.eyebrow kayjs-ui · {version}
    h1 {title}
    p.lede {description}
    p.import: code import {title} from '@kaynooo/kayjs-ui/{component.slug}.kay'
  Toc(sections={sections})
  article.prose
    Content
    h2#api: a(href="#api") API
    if props.length > 0
      details.props
        summary Props ({props.length})
        table
          thead
            tr
              th Prop
              th Type
              th Default
          tbody
            for prop of props key={prop.name}
              tr
                td
                  code {prop.name}
                  if !prop.optional && prop.default === undefined
                    span.required required
                td
                  code {prop.type}
                  if prop.comment as comment
                    p.prop-comment
                      for part, i of comment.split('`') key={i}
                        if i % 2 === 1
                          code {part}
                        else
                          | {part}
                td
                  if prop.default as value
                    code {value}
      p.spread Attributes it does not declare go onto its root element.
    else
      p It takes no props.
    if parts.some(part => part.name !== 'root')
      details.props
        summary Parts ({parts.length})
        table
          thead
            tr
              th Part
              th On
          tbody
            for part of parts key={part.name}
              tr
                td: code {part.name}
                td
                  for target, i of part.on key={target.name}
                    if i > 0
                      | ,{' '}
                    code {target.name}
                    if target.component
                      |  (a component)
                  for call, i of part.handedTo key={call}
                    if i > 0 || part.on.length > 0
                      | ;{' '}
                    | handed to{' '}
                    code {call}
      p.spread #[code class] takes a string for the root, or an object of these parts. See #[a(href="/essentials/styling-and-assets/#style-a-part-of-a-component") Style a part of a component].
    else
      p.spread It has no part other than its root: #[code class] takes a string. See #[a(href="/essentials/styling-and-assets/#style-a-part-of-a-component") Style a part of a component] for components that have parts.
  Pager(previous={previous} next={next} source={`${libraryRoot('kayjs-ui')}/src/${component.slug}.kay`})
