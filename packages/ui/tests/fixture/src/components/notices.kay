---
import type { Source } from 'kay'
import { signal } from 'kay'
import Notice from '@kayjs/ui/notice.kay'

const { onDismiss, sourced } = props<{ onDismiss: () => void, sourced: Pick<Source, 'error' | 'pending' | 'retry'> }>()

const shown = signal(true)
---
#plain
  Notice(tone="warning" label="Plain")
#toned
  Notice(tone="danger" label="Toned" icon={true})
#custom
  Notice(label="Custom" icon="success")
Notice#forced-hidden(label="Forced" hidden)
#acting
  Notice(label="Retry?")
    @actions
      button#retry(type="button") Retry
#closable
  Notice(label="Closable" dismissible onDismiss={onDismiss})
#controlled
  Notice(label="Controlled" open={shown()} onDismiss={() => shown = false})
#reopen
  button#show(type="button" onClick={() => shown = true}) Show
#hidden
  Notice(label="Hidden" open={false})
#sourced
  Notice(source={sourced})
