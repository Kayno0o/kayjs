---
import Button from '@kaynooo/kayjs-ui/button.kay'
import ConfirmDelete from '@kaynooo/kayjs-ui/confirm-delete.kay'
import { wording } from 'kay/words'
import type { Denials } from '../access'
import { deleteMessage } from '../listing'
import Refused from './refused.kay'

// Publish or Unpublish, then Delete, of a saved entry, as the entry's screen and the page editor both draw them. Publish and Unpublish are left out for a collection with no draft flag (`draftField` undefined), Delete unless `deletable`.
// A role that may not do one sees it disabled with the reason from `denied`; Publish and Delete wait while `saving`, an open Delete confirmation staying open with its confirm button disabled, and Unpublish asks first unless `dirty`, where the refusal over unsaved edits needs no dialog.
const { draftField, draft, dirty, saving, denied = {}, title, url, referrers, deletable, onPublish, onUnpublish, onRemove, onAskReferrers } = props<{
  draftField: string | undefined
  draft: boolean
  dirty: boolean
  saving: boolean
  denied?: Denials | undefined
  title: string
  url: string | undefined
  referrers: string[]
  deletable: boolean
  onPublish: () => unknown
  onUnpublish: () => unknown
  onRemove: () => unknown
  onAskReferrers: () => unknown
}>()
---
if draft
  if denied.publish !== undefined
    Refused(label={wording('cms.entry.publish', 'Publish')} reason={denied.publish})
  else
    Button(label={wording('cms.entry.publish', 'Publish')} disabled={saving} onClick={onPublish})
else if draftField !== undefined
  if denied.publish !== undefined
    Refused(label={wording('cms.entry.unpublish', 'Unpublish')} reason={denied.publish})
  else if dirty
    Button(label={wording('cms.entry.unpublish', 'Unpublish')} disabled={saving} onClick={onUnpublish})
  else
    ConfirmDelete(tone="neutral" trigger="button" label={wording('cms.entry.unpublish', 'Unpublish')} message={wording('cms.entry.unpublishMessage', 'Unpublish {title}? Visitors stop seeing it until you publish it again.', { title })} failure={wording('cms.entry.unpublishFailure', 'Could not unpublish')} onConfirm={onUnpublish})
if deletable
  if denied.delete !== undefined
    Refused(label={wording('cms.bulk.delete', 'Delete')} reason={denied.delete} tone="danger")
  else
    ConfirmDelete(message={deleteMessage(title, url, 'entry', referrers)} onOpen={onAskReferrers} disabled={saving} failure={wording('cms.save.deleteFailure', 'Could not delete')} trigger="button" onConfirm={onRemove})
