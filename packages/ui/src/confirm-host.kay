---
import type { JSX } from 'kay'
import { effect, onCleanup, onMount, signal, untrack } from 'kay'
import { claim, claimed } from './claim'
import Button from './button.kay'
import Dialog from './dialog.kay'
import { answer, confirmWords, questions } from './confirm'
import type { Asked } from './confirm'

const { fallback = false, ...rest } = props<Omit<JSX.IntrinsicElements['dialog'], 'open' | 'class' | 'title' | 'onClose' | 'onInput' | 'closedby' | 'closedBy' | 'children' | 'role'> & {
  // For an extension's own host only (the one `ui()` mounts): it gives way to every other ConfirmHost, whichever hydrates first, so an app setting it on its own loses it.
  fallback?: boolean | undefined
}>()

// An app's own ConfirmHost outranks the extension's, so one question shows once.
const owns = claim('confirms', fallback)
// The question on screen: the next one waits until this one has closed, so its dialog opens afresh and takes the focus again.
const current = signal<Asked>()
const idle = signal(true)

effect(() => {
  const head = questions()[0]

  // Its dialog goes with the ownership, and a close event that may never come must not keep the host shut.
  if (!owns())
    idle = true

  if (owns() && idle() && current() === undefined && head !== undefined)
    current = head
})

// A button closes the dialog, whose close event then frees the next question: opening it sooner would let that event cancel the next one.
function pick(question: Asked, answered: boolean) {
  if (current() !== question)
    return

  current = undefined
  idle = false
  answer(question, answered)
}

// The dialog closed by itself (Escape, a click outside) or after `pick`.
function closed() {
  if (!idle()) {
    idle = true

    return
  }

  const question = current()

  if (question !== undefined) {
    current = undefined
    answer(question, false)
  }
}

// Escape answers at the keypress: waiting for the close event leaves a moment in which the question is still pending though its dialog is gone, and an Escape in that moment would be lost.
function pressed(event: KeyboardEvent) {
  const question = current()

  if (event.key !== 'Escape' || question === undefined)
    return

  event.preventDefault()
  pick(question, false)
}

// A host that goes leaves nobody to answer the open question and those queued, unless another host takes over.
onMount(() => onCleanup(() => {
  const question = current()

  if (question !== undefined)
    answer(question, false)

  queueMicrotask(() => {
    if (!claimed('confirms')) {
      for (const queued of untrack(questions))
        answer(queued, false)
    }
  })
}))

const words = () => confirmWords(current()?.tone ?? 'neutral', { title: current()?.title, confirmLabel: current()?.confirmLabel, cancelLabel: current()?.cancelLabel })
---
if owns()
  Dialog({...rest} open={current() !== undefined} title={words().title} size="sm" role="alertdialog" aria-describedby="kui-confirm-message" part="root" onKeyDown={event => { rest.onKeyDown?.(event); pressed(event) }} onOpenChange={closed})
    @footer
      // The safe button takes the focus, so a stray Enter cancels.
      Button(label={words().cancel} autofocus onClick={() => current() && pick(current()!, false)})
      Button(label={words().confirm} tone={words().look} onClick={() => current() && pick(current()!, true)})
    p#kui-confirm-message(part="message") {current()?.message}
