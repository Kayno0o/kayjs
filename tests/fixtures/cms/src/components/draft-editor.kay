---
import type { EditorProps } from 'kay/edit'
import { signal } from 'kay'
import { showDraft } from 'kay/edit'
import './draft-editor.css'

// The editor the test extension gives, which every page renders in edit mode.
const { entries } = props<EditorProps>()

const clicks = signal(0)
const issues = signal('')
const draft = async (data: unknown, body?: string) => issues.set(JSON.stringify((await showDraft([{ collection: 'news', slug: 'launch', data, body }])).issues ?? []))
---
button.count(onClick={() => clicks.set(n => n + 1)}) Clicked {clicks()}
button.draft(onClick={async () => draft({ title: 'Draft title', published: true, tags: ['draft'] }, '## Drafted')}) Draft
button.refused(onClick={async () => draft({ title: 3, published: true, tags: [] })}) Refused
button.slow(onClick={async () => draft({ title: 'Slow draft', published: true, tags: [] })}) Slow
p.issues {issues()}
ul.edited
  for entry of entries
    li {entry.collection}:{entry.slug}{entry.locale === undefined ? '' : `@${entry.locale}`}
