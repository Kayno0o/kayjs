---
import type { Snippet } from 'kay'
import { recipe, signal, uid } from 'kay'
import { wording } from 'kay/words'

const look = recipe({ parts: { root: 'kai-launcher', panel: 'kai-launcher-panel', head: 'kai-launcher-head', title: 'kai-launcher-title', actions: 'kai-launcher-actions', action: 'kui-icon-btn', expand: 'kui-icon-btn kai-launcher-expand', body: 'kai-launcher-body', button: 'kui-icon-btn kai-launcher-button', glyph: 'kai-launcher-glyph' } })

const { label = wording('ai.chat.label', 'Chat'), openLabel = wording('ai.chat.open', 'Open the chat'), closeLabel = wording('ai.chat.close', 'Close the chat'), icon, closeIcon, newIcon, expandIcon, collapseIcon, newLabel = wording('ai.chat.new', 'New conversation'), expandLabel = wording('ai.chat.expand', 'Enlarge the chat'), collapseLabel = wording('ai.chat.collapse', 'Shrink the chat') } = props<{
  // Names the panel for screen readers and heads it.
  label?: string | undefined
  // Name and tooltip of the button while the panel is closed, and while it is open.
  openLabel?: string | undefined
  closeLabel?: string | undefined
  // What the button and the panel's close button draw.
  icon: Snippet
  closeIcon: Snippet
  // The header's buttons: one clears the conversation, one switches the panel between its two sizes.
  newIcon: Snippet
  expandIcon: Snippet
  collapseIcon: Snippet
  newLabel?: string | undefined
  expandLabel?: string | undefined
  collapseLabel?: string | undefined
}>()

const open = signal(false)
const large = signal(false)
const panelId = uid()
let button: HTMLButtonElement | undefined
let panel: HTMLElement | undefined

function show() {
  open.set(true)
  queueMicrotask(() => (panel?.querySelector<HTMLElement>('textarea') ?? panel)?.focus())
}

function hide() {
  open.set(false)
  button?.focus()
}

// The chat inside is told to start over; it hears the event once hydrated, which the first opening does.
function startOver() {
  panel?.querySelector('.kai-chat')?.dispatchEvent(new CustomEvent('kai-chat-new'))
  queueMicrotask(() => panel?.querySelector('textarea')?.focus())
}

function keyDown(event: KeyboardEvent) {
  // A reply under way stops on Escape first, which the chat marks by preventing the event's default.
  if (event.key === 'Escape' && open() && !event.defaultPrevented && !event.isComposing) {
    event.preventDefault()
    hide()
  }
}
---
div(part="root" onKeyDown={keyDown})
  section(part="panel" id={panelId} role="dialog" aria-labelledby={`${panelId}-title`} tabindex="-1" hidden={!open()} data-large={large()} ref={element => { panel = element }})
    header(part="head")
      h2(part="title" id={`${panelId}-title`}) {label}
      div(part="actions")
        button(part="action" type="button" aria-label={newLabel} data-tooltip={newLabel} data-size="md" data-variant="ghost" data-tooltip-placement="bottom span-left" data-tone="neutral" onClick={startOver})
          | {newIcon}
        button(part="expand" type="button" aria-label={large() ? collapseLabel : expandLabel} data-tooltip={large() ? collapseLabel : expandLabel} data-size="md" data-variant="ghost" data-tooltip-placement="bottom span-left" data-tone="neutral" onClick={() => large.set(!large())})
          | {large() ? collapseIcon : expandIcon}
        button(part="action" type="button" aria-label={closeLabel} data-tooltip={closeLabel} data-size="md" data-variant="ghost" data-tooltip-placement="bottom span-left" data-tone="neutral" onClick={hide})
          | {closeIcon}
    div(part="body")
      slot
  button(part="button" type="button" ref={element => { button = element }} aria-label={openLabel} aria-expanded={open()} aria-controls={panelId} data-tooltip={open() ? closeLabel : openLabel} data-tooltip-placement="left" data-size="lg" data-variant="solid" data-tone="accent" onClick={() => open() ? hide() : show()})
    span(part="glyph" hidden={open()})
      | {icon}
    span(part="glyph" hidden={!open()})
      | {closeIcon}
