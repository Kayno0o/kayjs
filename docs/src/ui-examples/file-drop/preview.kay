---
import FileDrop from '@kaynooo/kayjs-ui/file-drop.kay'

const previews = signal<{ name: string, url: string }[]>([])
const toPreview = (file: File) => ({
  name: file.name,
  url: URL.createObjectURL(file),
})
---
FileDrop(
  accept="image/*"
  multiple
  onFiles={files => previews.set(files.map(toPreview))}
)
  @content(zone)
    .rounded-lg.border.border-dashed.border-kui-overlay1(
      class="bg-kui-surface0 p-6 text-center"
    )
      if zone.dragging()
        p Drop to preview
      else
        p
          button(type="button" onClick={zone.open}) Choose images
          |  or drop them here
      if previews().length > 0
        .mt-4.flex.flex-wrap.justify-center.gap-2
          for preview of previews() key={preview.url}
            // kay-allow unsized-image
            img.size-20.rounded.object-cover(
              src={preview.url}
              alt={preview.name}
            )
