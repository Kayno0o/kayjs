--- server
import { action } from 'kay'
import { hear, mail } from '../mail'
import Counted from '../mails/counted-confirm.kay'

export const subscribe = action(...mail.list().form())
export const subscribeStrict = action(...mail.list('strict', { protection: { rateLimit: { max: 2, window: '10m' } } }).form())
export const subscribeFlood = action(...mail.list('flood', { protection: { rateLimit: { max: 1000, window: '10m' } } }).form())
export const subscribeHooked = action(...mail.list('hooked', { afterSubscribe: hear('subscribe'), afterConfirm: hear('confirm'), afterUnsubscribe: hear('unsubscribe'), afterBroadcast: hear('broadcast') }).form())
export const subscribeCounted = action(...mail.list('counted', { view: Counted }).form())
---
form(action={subscribe} novalidate)
  label
    | Email
    input(field="email" type="email" autocomplete="email")
  input(type="hidden" name="wording" value="stock")
  button(type="submit") Subscribe
