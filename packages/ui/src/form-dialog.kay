--- <Output>
import type { Action, Answer, FailureData, JSX, Snippet, Success } from 'kay'
import { carrySchema, effect, recipe, signal, uid } from 'kay'
import Button from './button.kay'
import Dialog from './dialog.kay'
import type { FormValidation } from './forms'

import { callAction, checkSchema, checkSent, formIssues, leftField, showIssues } from './forms'
import type { OverlaySize } from './overlay'
import { wording } from 'kay/words'


const look = recipe({ parts: { root: '', footer: 'flex w-full flex-wrap items-center gap-2', actions: 'ml-auto flex flex-wrap justify-end gap-2', form: 'kui-form-grid' } })

const { open, trigger, title, label, heading, action, submitLabel, savingLabel = wording('ui.formDialog.saving', 'Saving…'), cancelLabel = wording('ui.formDialog.cancel', 'Cancel'), failureLabel, validate = false, onFocusOut, refused, onSave, onError, onOpenChange, extra, id, size, level, actions, header, close, closeHref, modal, closeLabel, autosave, ...rest } = props<Omit<JSX.IntrinsicElements['dialog'], 'open' | 'class' | 'title' | 'id' | 'onClose' | 'onInput' | 'onError' | 'closedby' | 'closedBy' | 'children'> & {
  // Shows the dialog when the app sets it, and learns of a close through `onOpenChange` to set it back to false; left out, the component keeps it itself, opened by `trigger`.
  open?: boolean | undefined
  // Renders what opens the dialog when `open` is left to the component: `@trigger(attributes)`, then `button({...attributes})`.
  trigger?: Snippet<[attributes: { 'onClick': () => void, 'aria-haspopup': 'dialog' }]> | undefined
  // The heading, a string or a `@title` block, as a Dialog's.
  title: string | Snippet
  // The dialog's name for screen readers when it differs from the visible title, as a Dialog's.
  label?: string | undefined
  // @deprecated Use a `@title` block, with `label` for the string that named the dialog; `deprecated-ui-props` rewrites it. Removed in 2.0.0.
  heading?: Snippet
  // The page's action the form calls with its fields, imported from the page: the server reads them as a plain form post, coercing numbers, booleans and lists.
  action: Action<never, Output>
  submitLabel: string
  // What the submit button says while the action runs, and the cancel button.
  savingLabel?: string | undefined
  cancelLabel?: string | undefined
  // Toasted when the call fails other than on a field; a refused field shows its message on its FormField.
  failureLabel?: string | undefined

  // Checks the fields against the action's schema in the browser, as the server would, with the same messages shown on their FormField: `'submit'` when the form is sent, with nothing called while a field is refused, `'blur'` also each field as it loses focus; `false` (the default) leaves it to the server.
  validate?: FormValidation
  // What a refusal of the action's handler says, from the data it passed to `ctx.fail`: a message per field, each shown on its FormField, or one message, toasted. Without it, or when it answers undefined or an empty message, `failureLabel` is toasted.
  refused?: ((data: FailureData<Output>) => Record<string, string> | string | undefined) | undefined
  // What the action returned, for the page to patch into what it shows. The dialog closes once it has run.
  onSave?: ((result: Answer<Success<Output>>) => unknown) | undefined

  // Called with `{ error }` before the toast: the `ActionError` of a refusal (its `errors` by field, its `data`), or whatever the call threw. The dialog stays open.
  onError?: ((failure: { error: unknown }) => unknown) | undefined
  // The left end of the footer, for a delete button.
  extra?: Snippet
  // Pairs the footer's submit button with the form; one unique on the page is drawn when none is given.
  id?: string | undefined
  // What the Dialog under it takes by the same names: the width, the title's heading level, controls in the head line and the close button's name.
  size?: OverlaySize | undefined
  level?: 2 | 3 | 4 | 5 | 6 | undefined
  actions?: Snippet
  // The head line and the close button in place of the Dialog's own, as its `@header` and `@close`.
  header?: Snippet
  close?: Snippet
  // The close button as a link, and the dialog beside the page instead of over it, as the Dialog takes them.
  closeHref?: string | undefined
  modal?: boolean | undefined
  // Typing does not lock the close, as a Dialog's `autosave`; the dialog is still locked while the action runs.
  autosave?: boolean | undefined
  closeLabel?: string | undefined
  // Called with `true` when `trigger` opens it and with `false` however the dialog closes, saved or not.
  onOpenChange?: ((open: boolean) => unknown) | undefined
}>()

const formId = id ?? uid()
const issues = signal<Record<string, string>>({})
const checking = signal(false)
let form: HTMLFormElement | undefined
// The state of a dialog the app leaves to the component: `open` wins when given.
const inner = signal(false)
const isOpen = () => open ?? inner()

function setOpen(next: boolean) {
  if (isOpen() === next)
    return

  if (open === undefined)
    inner = next

  onOpenChange?.(next)
}

const opener = { 'onClick': () => setOpen(true), 'aria-haspopup': 'dialog' } as const

formIssues.provide(issues)

// The page carries the action's schema for the check, which a form of the dialog's own would otherwise bring.
if (validate !== false)
  carrySchema(action)

// However the dialog closed, its messages are cleared, so the next open starts afresh.
effect(() => {
  if (!isOpen()) {
    issues = {}

    // The dialog drops the content of its own on closing, but the fields a static page gave it stay from one opening to the next, so the messages are taken off them now.
    if (form)
      void showIssues(form, {})
  }
})

async function submit(event: SubmitEvent) {
  event.preventDefault()

  if (action.pending() || checking() || !form)
    return

  const failureText = failureLabel ?? wording('ui.formDialog.failure', 'Could not save.')

  if (validate !== false && !(await checkSent(form, action, issues, failureText, checking)))
    return

  const done = await callAction(form, action, issues, failureText, refused, onError)

  if (!done)
    return

  // Outside the call's `try`, so a page failing to patch the saved result in surfaces as the bug it is rather than as a refused save.
  // The dialog closes whatever the hooks do: the save went through.
  try {
    onSave?.(done.result)
  }
  finally {
    setOpen(false)
  }
}

async function leave(event: FocusEvent) {
  onFocusOut?.(event as never)

  const field = leftField(event)

  if (validate === 'blur' && form && field !== undefined)
    await checkSchema(form, action, issues, '', field)
}

// Enter in a single-line field submits on its own; a textarea keeps Enter for new lines and takes Ctrl+Enter. The method is called through the prototype, as a control named `requestSubmit` takes its place on the form.
function submitOnCtrlEnter(event: KeyboardEvent) {
  if (event.key !== 'Enter' || !event.ctrlKey || !form)
    return

  event.preventDefault()
  HTMLFormElement.prototype.requestSubmit.call(form)
}
---
// Only a click outside or Escape closes the dialog while `open` is still true; every other way has already closed it.
if trigger
  | {trigger(opener)}
Dialog({...rest} open={isOpen()} title={title} label={label} heading={heading} size={size} level={level} actions={actions} header={header} close={close} closeHref={closeHref} modal={modal} autosave={autosave} closeLabel={closeLabel} dirty={action.pending()} part="root" onOpenChange={shown => !shown && setOpen(false)})
  @footer
    div(part="footer")
      | {extra}
      div(part="actions")
        Button(label={cancelLabel} disabled={action.pending()} onClick={() => setOpen(false)})
        Button(label={action.pending() ? savingLabel : submitLabel} type="submit" form={formId} tone="accent" busy={action.pending()} disabled={action.pending()})
  form(part="form" id={formId} ref={element => form = element} onSubmit={submit} onFocusOut={validate === 'blur' || onFocusOut ? leave : undefined} onKeyDown={submitOnCtrlEnter})
    slot
