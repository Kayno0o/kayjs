---
import Button from '@kayjs/ui/button.kay'
import IconButton from '@kayjs/ui/icon-button.kay'
import Popover from '@kayjs/ui/popover.kay'
import { toast } from '@kayjs/ui'
---
Popover(label="More actions" placement="bottom-start")
  @trigger(attributes)
    IconButton({...attributes} icon="plus" label="More")
  .flex.flex-col.gap-1.p-2
    Button(label="Duplicate" onClick={() => toast.info('Duplicated')})
    Button(label="Archive" onClick={() => toast.info('Archived')})
