---
import type { ScatterPoint } from '@kayjs/ui'
import BarChart from '@kayjs/ui/bar-chart.kay'
import ContributionGraph from '@kayjs/ui/contribution-graph.kay'
import LineChart from '@kayjs/ui/line-chart.kay'
import ScatterChart from '@kayjs/ui/scatter-chart.kay'
import { signal } from 'kay'

// What the test reads back: the dot pressed, the span dragged.
const { onSelect, onRange } = props<{ onSelect: (point: ScatterPoint) => void, onRange: (from: number, to: number) => void }>()

const DAYS = ['Mon', 'Tue', 'Wed']
const VISITS = [null, 3, 5]
const SALES = [1, 2, 1]
// The points shown, which a picked span zooms in on as an app would.
const shown = signal<[number, number]>([0, DAYS.length])

function zoom(from: number, to: number) {
  const [start] = shown()

  onRange(from, to)
  shown = [start + from, start + to + 1]
}
---
LineChart#line(label="Visits" labels={DAYS.slice(...shown())} series={[{ name: 'Visits', values: VISITS.slice(...shown()) }, { name: 'Sales', values: SALES.slice(...shown()), color: 'red' }]} formatValue={value => `${value} v`} onRange={({ from, to }) => zoom(from, to)})
ScatterChart#scatter(label="Games" points={[{ key: 1, label: 'Hades', x: 10, y: 90 }, { key: 2, label: 'Celeste', x: 30, y: 70 }]} onSelect={({ item }) => onSelect(item)})
BarChart#bars(label="Runs" labels={DAYS} series={[{ name: 'Minutes', values: [4, 0, 8], colors: [undefined, 'red', undefined] }]})
ScatterChart#dots(label="Plain games" points={[{ key: 1, label: 'Hades', x: 10, y: 90 }, { key: 2, label: 'Celeste', x: 30, y: 70 }, { key: 3, label: 'Tunic', x: 50, y: 50 }]})
ContributionGraph#graph(label="Commits" color="green" today="2026-09-09" days={Array.from({ length: 14 }, (_, at) => ({ day: `2026-09-${String(at + 1).padStart(2, '0')}`, intensity: at / 14 }))})
BarChart#goaled(label="Mock exams" labels={['One', 'Two']} max={40} goals={[{ value: 29, title: 'Pass mark' }, { value: 50, title: 'Out of reach' }]} series={[{ name: 'Score', values: [18, 33] }]})
BarChart#reaching(label="Mock exams" labels={['One']} goals={[{ value: 29, title: 'Pass mark' }]} series={[{ name: 'Score', values: [18] }]})
LineChart#goaledLine(label="Scores" labels={DAYS} goals={[{ value: 29, title: 'Pass mark', color: 'green' }]} series={[{ name: 'Score', values: [18, 20, 25] }]})
ScatterChart#widened(label="Games" goals={[{ value: 150, title: 'Ceiling' }]} points={[{ key: 1, label: 'Hades', x: 10, y: 90 }, { key: 2, label: 'Celeste', x: 30, y: 30 }]})
ScatterChart#goaledDots(label="Games" y={{ domain: [0, 100] }} goals={[{ value: 70, title: 'Target' }, { value: 400, title: 'Off the chart' }]} points={[{ key: 1, label: 'Hades', x: 10, y: 90 }]})
