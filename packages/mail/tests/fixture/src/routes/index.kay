--- server
import { action, s } from 'kay'
import Welcome from '../mails/welcome.kay'

// The mailer of the site answering the request, as `ctx.locals.mail`.
export const signUp = action(s.Object({ name: s.String({ minLength: 1, maxLength: 100 }), email: s.String({ format: 'email', maxLength: 254 }) }), async ({ name, email }, { locals }) => {
  await locals.mail.enqueue({ to: email, subject: `Welcome, ${name}`, view: Welcome, props: { name, url: 'https://fixture.test/confirm?token=abc' } })
})
---
form(action={signUp})
  label
    | Name
    input(name="name")
  label
    | Email
    input(name="email" type="email" autocomplete="email")
  button Sign up
