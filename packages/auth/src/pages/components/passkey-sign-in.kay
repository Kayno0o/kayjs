---
import { onMount, signal } from 'kay'
import Button from '@kaynooo/kayjs-ui/button.kay'
import { askPasskey, canAskPasskey, passkeyFailure, rememberChecked } from '../../browser'
import { passkey, passkeyOptions } from '../routes/sign-in.kay'

const { redirect, label, failed } = props<{ redirect: string, label: string, failed: string }>()

const supported = signal(false)
const error = signal('')

// Shown once the browser proves it can, since a passkey needs script.
onMount(() => supported.set(canAskPasskey()))

async function signIn() {
  error.set('')

  try {
    const options = await passkeyOptions({}, { refresh: false })
    const response = await askPasskey(options)

    if (response)
      await passkey({ response, redirect, remember: rememberChecked() })
  }
  catch (caught) {
    error.set(passkeyFailure(caught, {}, failed))
  }
}
---
if supported()
  Button(label={label} onClick={signIn} busy={passkey.pending()})
  if error()
    p.kayjs-auth-error.text-kui-error(role="alert") {error()}
