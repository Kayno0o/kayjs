---
import type { FormScope } from '../form'
import FieldInput from '../editor/field-input.kay'
import type { Field } from '../fields'
import { wording } from 'kay/words'
import { fieldsOf, pairedFields } from '../fields'
import { markdownOptions } from '../editor/markdown-options'
import { resolve } from '../layout'
import { gapOf, translatable } from '../translations'

// One field of an entry's form by its key in the schema, a group or a list with the fields inside it, or by its dotted path to a field inside a group, `address.street`. Unknown names throw, naming the schema's.
// `field` is the form layout's own copy of it, a group without the fields the layout placed elsewhere.
const { form, name, field: given } = props<{ form: FormScope, name: string, field?: Field | undefined }>()

markdownOptions.provide({ toolbar: form.collection.layout?.form?.toolbar, previewClass: form.collection.layout?.form?.previewClass })

const field = memo(() => {
  if (given)
    return given

  const fields = fieldsOf(form.collection.schema)
  const found = resolve(fields, name)

  const paired = pairedFields(fields).get(name)

  if (!found && paired)
    throw new Error(`kayjs-cms: ${form.collection.name}'s ${JSON.stringify(name)} is the ${paired.role} of its image ${JSON.stringify(paired.image)}, which shows it: render ${JSON.stringify(paired.image)}`)

  if (!found)
    throw new Error(`kayjs-cms: ${form.collection.name} has no field ${JSON.stringify(name)} to render; its fields are ${fields.map(candidate => candidate.key).join(', ')}`)

  return found
})

// In a locale other than the default's, a text still reading as the default locale's, or empty beside it, is said under the field.
const translated = form.source === undefined ? new Set<string>() : new Set(translatable(form.collection).map(candidate => String(candidate.key)))

const note = () => {
  if (form.source === undefined || !translated.has(name))
    return undefined

  const gap = gapOf(form.drafts.value(form.entry, name), form.source.data?.[name])

  if (gap === undefined)
    return undefined

  return gap === 'same' ? wording('cms.locales.same', 'Same as {locale}: not translated yet.', { locale: form.source.locale }) : wording('cms.locales.empty', 'Empty: {locale} has a text.', { locale: form.source.locale })
}

// An issue on a field nothing renders is shown with the entry's own.
effect(() => {
  onCleanup(form.shown.add(name))
})

// The draft flag and the publish and end dates are the role's to change when it may publish: the others see them, locked with the reason.
const { draftField, publishField, unpublishField } = form.collection
const locked = () => [draftField, publishField, unpublishField].includes(name) ? form.denied?.publish : undefined
---
if locked()
  fieldset.kcms-locked(disabled data-tooltip={locked()} tabindex="0")
    FieldInput(drafts={form.drafts} entry={form.entry} field={field()} path={name} note={note()})
else
  FieldInput(drafts={form.drafts} entry={form.entry} field={field()} path={name} note={note()})
