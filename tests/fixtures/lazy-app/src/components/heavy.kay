---
// Big enough to be worth a chunk of its own, as the build keeps a component under two thousand bytes of source in the page that draws it.
// 
import { signal } from 'kay'
// The island that draws it lazily, imported back: its chunk then imports the island's, which must not wait on this chunk to load.
import Opened from './opened.kay'

const { label } = props<{ label: string }>()

if (typeof Opened !== 'function')
  throw new TypeError('the island drawing Heavy did not load')
const count = signal(0)
---
button.heavy(onClick={() => count = count() + 1}) {label} {count()}
