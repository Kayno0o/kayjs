--- server
import { t } from 'elysia'
import { action } from 'kay'

export const edit = action(t.Object({
  title: t.String({ minLength: 3, maxLength: 40, error: 'Too short' }),
}), (_input, ctx) => ctx.fail(409, 'Taken'))

const first = { title: 'First' }
const second = { title: 'Second' }
const rows = [{ title: 'A' }, { title: 'B' }, { title: 'C' }]
---
form.one(action={edit} values={first})
  input(field="title")
form.two(action={edit} values={second})
  input(field="title")
for row of rows
  form.row(action={edit} values={row})
    input(field="title")
