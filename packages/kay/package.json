{
  "name": "@kayjs/kay",
  "version": "2.0.0-beta.3",
  "description": "Bun-native TSX web framework with zero-directive automatic islands, fine-grained signals, and single-binary deploys",
  "license": "MIT",
  "homepage": "https://kayjs.kaynooo.fr",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "kay": "./src/cli/index.ts"
  },
  "files": [
    "src",
    "templates",
    "llms.txt"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server/public.ts",
    "./config": "./src/plugins/public.ts",
    "./test": "./src/test/index.ts",
    "./build": "./src/build/index.ts",
    "./jsx-runtime": "./src/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/jsx-runtime.ts",
    "./internal/dom": "./src/dom/index.ts",
    "./internal/dom-extras": "./src/dom/extras.ts",
    "./internal/dom-loop": "./src/dom/loop.ts",
    "./internal/action": "./src/dom/action.ts",
    "./internal/island": "./src/dom/island.ts",
    "./internal/ssr": "./src/ssr/index.ts",
    "./internal/server": "./src/server/index.ts"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kayno0o/kayjs",
    "directory": "packages/kay"
  },
  "dependencies": {
    "@kaynooo/cli-kit": "^0.52.0",
    "oxc-parser": "^0.155.0"
  },
  "peerDependencies": {
    "playwright-core": "^1.64.0"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  }
}
