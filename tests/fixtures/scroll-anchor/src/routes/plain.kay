--- server
import { t } from 'elysia'
import { action } from 'kay'

const rows = Array.from({ length: 40 }, (_, at) => at + 1)

// A row posted is dropped from the list.
export const sort = action(t.Object({ id: t.String() }), ({ id }) => {
  rows.splice(rows.indexOf(Number(id)), 1)
})
---
head
  title Plain rows
h1 Plain rows
ul#list
  for id of rows
    li(key={id})
      form(data-row={id} action={sort} style="display: block; height: 56px; margin: 0")
        input(type="hidden" name="id" value={id})
        input(type="text" name="note" aria-label={`Note ${id}`})
