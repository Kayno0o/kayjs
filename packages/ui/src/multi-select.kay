--- <Value extends string>
import type { FieldSize } from './field-look'
import { fieldSize } from './field-look'
import type { JSX, Snippet } from 'kay'
import type { ComboboxQuery } from './combobox'
import type { MultiSelectOption } from './multi-select'
import type { PopoverPlacement } from './popover'
import { effect, onCleanup, postedValues, recipe, signal, untrack } from 'kay'
import { stepIndex } from './cycle'
import { defaultKept, onFormReset, startRef } from './form-reset'
import Icon from './icon.kay'
import { pickedLabels, pickedShown, selectionSummary, toggledValue } from './multi-select'
import Popover from './popover.kay'
import { wording } from 'kay/words'
import { labelText } from './label-text'

// The checkbox's own ring is too small to find, so the row the keyboard stands on takes the menu's tint and accent bar; forced colours paint the transparent outline instead.
const look = recipe({
  parts: {
    root: 'kui-multi-select inline-flex min-w-0',
    panel: 'flex max-h-80 w-64 flex-col [min-inline-size:anchor-size(width)]',
    trigger: 'flex w-full min-w-0 cursor-pointer items-center gap-2 text-left disabled:cursor-default data-empty:text-[var(--color-muted)]',
    summary: 'min-w-0 flex-1 truncate',
    chevron: 'size-4 shrink-0 text-muted',
    search: 'm-2 mb-0',
    bar: 'flex gap-3 border-b border-border px-3 py-1.5',
    action: 'cursor-pointer text-2xs tracking-label text-muted [font-family:var(--font-label,inherit)] [text-transform:var(--label-case)] hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:cursor-default disabled:opacity-40',
    options: 'min-h-0 flex-1 overflow-y-auto p-1',
    option: 'flex cursor-pointer items-center gap-2 px-2 py-1.5 text-sm text-foreground hover:bg-hover has-[[data-part=checkbox]:focus-visible]:bg-hover has-[[data-part=checkbox]:focus-visible]:outline-2 has-[[data-part=checkbox]:focus-visible]:-outline-offset-2 has-[[data-part=checkbox]:focus-visible]:outline-transparent has-[[data-part=checkbox]:focus-visible]:[box-shadow:inset_2px_0_0_var(--color-accent)] has-[[data-part=checkbox]:disabled]:cursor-not-allowed has-[[data-part=checkbox]:disabled]:bg-transparent has-[[data-part=checkbox]:disabled]:opacity-50',
    icon: 'size-3.5 shrink-0',
    checkbox: 'size-3.5 shrink-0 accent-accent',
    label: 'min-w-0 truncate',
    empty: 'px-2 py-3 text-center text-xs text-muted empty:p-0',
  },
})

// A remote search waits for a pause in typing.
const DEBOUNCE_MS = 200

// Past this many options the panel opens on a search box.
const SEARCH_FROM = 8

// The keys that move focus through the options once one has it.
const MOVES: Partial<Record<string, (index: number, count: number) => number>> = {
  ArrowDown: (index, count) => stepIndex(index, 1, count),
  ArrowUp: (index, count) => stepIndex(index, -1, count),
  Home: () => 0,
  End: (_, count) => count - 1,
}

const { size = 'md', invalid, id, options, value = [], label, placeholder = wording('ui.multiSelect.placeholder', 'Any'), searchLabel = wording('ui.multiSelect.search', 'Search'), allLabel = wording('ui.multiSelect.all', 'All'), noneLabel = wording('ui.multiSelect.none', 'None'), emptyLabel = wording('ui.multiSelect.empty', 'No match'), empty, loadingLabel = wording('ui.multiSelect.loading', 'Loading…'), failureLabel = wording('ui.multiSelect.failure', 'Could not load the options'), minLength = 0, valueLabels, onLoad, onError, option: drawRow, selectedLabel, name, search, disabled = false, placement = 'bottom-start', open, onOpenChange, onChange, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'id' | 'class' | 'children' | 'onChange' | 'onLoad' | 'onError'> & {
  // The trigger's size: `md` by default, `sm` and `lg` change its padding and type.
  size?: FieldSize | undefined
  // Marks the control as refused, in the danger colour with `data-refused` on its trigger, a button taking no `aria-invalid`.
  invalid?: boolean | undefined
  // The panel's id, unique on the page; one is drawn when none is given.
  id?: string | undefined
  // A list, filtered by the search box, or a function answering the options for the text typed, such as an action or a wrapped API call: it is asked when the panel opens and after each pause in typing, and only the latest answer lands.
  options: readonly MultiSelectOption<Value>[] | ((input: ComboboxQuery) => PromiseLike<readonly MultiSelectOption<Value>[]>)
  // The values picked to start with; a control whose parent passes others follows them.
  value?: readonly Value[] | undefined
  // Names the control for screen readers.
  label: string
  // What the trigger reads while nothing is picked.
  placeholder?: string | undefined
  // The search box's placeholder, and with `label` after it, its name for screen readers.
  searchLabel?: string | undefined
  // The buttons picking every option shown and none of them, and what a search matching none says.
  allLabel?: string | undefined
  noneLabel?: string | undefined
  emptyLabel?: string | undefined
  // Replaces the empty text with the app's own markup, such as a link to add the missing one: an `@empty` block.
  empty?: Snippet | undefined
  // What the status line says while a function `options` is answering, and once it rejected.
  loadingLabel?: string | undefined
  failureLabel?: string | undefined
  // The fewest characters a function `options` is asked for; shorter text shows no options.
  minLength?: number | undefined
  // The labels of values picked before any answer lists them, for a function `options`; a value no answer or label names reads as itself.
  valueLabels?: Readonly<Record<string, string>> | undefined
  // Called with each answer of a function `options` and the text it was asked for, and with what it rejected with.
  onLoad?: ((options: readonly MultiSelectOption<Value>[], query: string) => unknown) | undefined
  onError?: ((failure: { error: unknown, query: string }) => unknown) | undefined
  // What the trigger reads once several are picked, `3 selected` by default.
  selectedLabel?: string | ((count: number) => string) | undefined
  // Submits each picked value under this name, for a control inside a form.
  name?: string | undefined
  // Draws each option in place of its label (and icon): `@option(option)`. The input stays named by the option's `label`, and keeps its checked and disabled state.
  option?: Snippet<[option: MultiSelectOption<Value>]> | undefined
  // Opens on a search box; on by default past eight options.
  search?: boolean | undefined
  disabled?: boolean | undefined
  placement?: PopoverPlacement | undefined
  // Shows the panel when the page sets it; the trigger, a click outside and Escape open and close it on their own, and `onOpenChange` reports each change so a page driving `open` can set it back.
  open?: boolean | undefined
  onOpenChange?: ((open: boolean) => unknown) | undefined
  // Gets the picked options as a second argument, among the ones loaded so far.
  onChange?: ((value: Value[], options: MultiSelectOption<Value>[]) => unknown) | undefined
}>()

// A control with no callback is plain: a refused post of its form, which the server renders it for, gives its choices back in place of its own; a function of options leaves them as the text they were posted as.
const sent = onChange ? undefined : postedValues(name, value)
const picked = signal<readonly Value[]>(sent === undefined ? value : typeof options === 'function' ? sent as Value[] : options.filter(one => sent.includes(String(one.value))).map(one => one.value))
const query = signal('')
let root: HTMLElement | undefined

// The first run leaves a start the server refilled alone, which the browser reads from its markup.
let refilled = sent !== undefined

effect(() => {
  const next = value

  if (refilled)
    refilled = false
  else
    picked = next
})

// kay-allow once-read-prop: a list or a loader is chosen when the component is created
const remote = typeof options === 'function'
const found = signal<readonly MultiSelectOption<Value>[]>([])
// The text the answer held in `found` is for, and whether the last ask was rejected.
const answered = signal<string | undefined>(undefined)
const failed = signal(false)
// Every option an answer listed, so a value picked from one answer keeps its label once a later search no longer lists it.
const seen = signal<readonly MultiSelectOption<Value>[]>([])
let request = 0

const listed = (): readonly MultiSelectOption<Value>[] => typeof options === 'function' ? found() : options

// The options the labels and the order of the picked values come from.
const pool = (): readonly MultiSelectOption<Value>[] => {
  if (!remote)
    return listed()

  const named = Object.entries(valueLabels ?? {}).map(([entry, text]) => ({ value: entry as Value, label: text }))
  const byValue = new Map([...named, ...seen(), ...found()].map(option => [option.value, option]))

  return [...byValue.values()]
}

const waiting = () => remote && query().trim().length >= minLength && answered() !== query()
const searchable = () => remote || (search ?? listed().length > SEARCH_FROM)
const summary = () => selectionSummary(pool(), picked(), placeholder, count => selectedLabel === undefined ? wording('ui.multiSelect.selected', '{count} selected', { count }) : labelText(selectedLabel, { count }, count))

const shown = () => {
  const needle = query().trim().toLowerCase()

  // A function answers for the text itself.
  return needle && !remote ? listed().filter(option => option.label.toLowerCase().includes(needle)) : listed()
}

const status = () => {
  if (remote && query().trim().length < minLength)
    return ''

  if (waiting())
    return loadingLabel

  if (failed())
    return failureLabel

  return shown().length === 0 ? emptyLabel : ''
}

// An app's callback that throws is logged, not taken for a failed load.
function notify(call: () => unknown) {
  try {
    call()
  }
  catch (error) {
    console.error('kayjs-ui: a MultiSelect callback threw', error)
  }
}

// Only the latest question lands: an answer arriving after a newer key press is dropped.
async function load(text: string) {
  const mine = ++request

  if (typeof options !== 'function' || text.trim().length < minLength) {
    found = []
    answered = text

    return
  }

  try {
    const answer = await options({ q: text })

    if (mine !== request)
      return

    found = answer
    seen = [...seen().filter(option => !answer.some(entry => entry.value === option.value)), ...answer]
    answered = text
    failed = false
    notify(() => onLoad?.(answer, text))
  }
  catch (error) {
    if (mine === request) {
      console.error('kayjs-ui: a MultiSelect could not load its options', error)
      found = []
      answered = text
      failed = true
      notify(() => onError?.({ error, query: text }))
    }
  }
}

const opened = signal(false)

// The search waits for a pause in typing; the first ask is at once, when the panel opens.
effect(() => {
  const text = query()

  if (!remote || !opened())
    return

  const timer = setTimeout(() => void load(text), untrack(() => answered() === undefined) ? 0 : DEBOUNCE_MS)

  onCleanup(() => clearTimeout(timer))
})

function set(next: Value[]) {
  picked = next
  onChange?.(next, pool().filter(option => next.includes(option.value)))
}

// What a reset goes back to: the values it started with, or the ones last saved by a SaveForm.
const initial = defaultKept<readonly Value[]>(() => root, picked, value)

// A reset puts the boxes back on their defaults, which are not the picked values; the control goes back to `initial` with an empty search and tells the app.
onFormReset(() => root, () => {
  const start = initial()
  const same = start.length === picked().length && start.every(one => picked().includes(one))

  query = ''

  if (!same)
    set([...start])

  for (const [index, box] of [...root?.querySelectorAll<HTMLInputElement>('[data-part=checkbox]') ?? []].entries()) {
    const option = shown()[index]

    box.checked = option !== undefined && picked().includes(option.value)
  }
})

const ref = startRef<HTMLElement>(element => root = element, rest.ref)

// The panel only shows once the browser has opened the popover, so focus moves on its toggle rather than on the click; closing clears the search.
function toggled(isOpen: boolean) {
  opened = isOpen

  if (isOpen) {
    root?.querySelector<HTMLInputElement>('[data-part=search], [data-part=checkbox]:not(:disabled)')?.focus()
  }
  else {
    query = ''
    request++
    answered = undefined
  }

  onOpenChange?.(isOpen)
}

// From the search box or the bar, ArrowDown reaches the first option; there the arrows, Home and End move between enabled options, which Tab would walk one by one.
function keyDown(event: KeyboardEvent) {
  const boxes = [...root?.querySelectorAll<HTMLInputElement>('[data-part=checkbox]:not(:disabled)') ?? []]
  const index = boxes.indexOf(event.target as HTMLInputElement)
  let move = MOVES[event.key]

  if (index === -1)
    move = event.key === 'ArrowDown' ? () => 0 : undefined

  if (!move || boxes.length === 0)
    return

  event.preventDefault()
  boxes[move(index, boxes.length)]?.focus()
}

// Tab past the last control closes the panel rather than leaving it open over the page; focus going nowhere, as on a click on the panel's padding, keeps it.
function focusLeft(event: FocusEvent) {
  const panel = event.currentTarget as HTMLElement
  const next = event.relatedTarget as Node | null

  if (next && !panel.contains(next) && panel.matches(':popover-open'))
    panel.hidePopover()
}
---
div(part="root" {...rest} ref={ref} data-posted={sent === undefined ? undefined : name})
  Popover(id={id} placement={placement} open={open} part="panel" role="group" aria-label={label} onOpenChange={toggled} onKeyDown={keyDown} onFocusOut={focusLeft})
    @trigger(attributes)
      // Named by its label and what is picked, which a name of the label alone would hide; a count is described by the labels it stands for.
      button.kui-field-input({...attributes} data-size={fieldSize(size)} data-refused={invalid ? 'true' : undefined} part="trigger" type="button" aria-label={`${label}: ${summary()}`} aria-description={picked().length > 1 ? pickedLabels(pool(), picked()).join(', ') : undefined} disabled={disabled} data-empty={picked().length === 0 || undefined})
        span(part="summary") {summary()}
        Icon(icon="chevron" part="chevron")
    if searchable()
      input.kui-field-input(part="search" type="search" data-kui-search placeholder={searchLabel} aria-label={`${searchLabel} ${label}`} value={query()} onInput={event => query = event.currentTarget.value})
    div(part="bar")
      // Under a search, All and None pick and drop only the options it shows.
      button(part="action" type="button" disabled={shown().every(option => option.disabled || picked().includes(option.value))} onClick={() => set(pickedShown(pool(), picked(), shown(), true))}) {allLabel}
      button(part="action" type="button" disabled={!shown().some(option => !option.disabled && picked().includes(option.value))} onClick={() => set(pickedShown(pool(), picked(), shown(), false))}) {noneLabel}
    div(part="options")
      for option of shown() key={option.value}
        label(part="option")
          input(part="checkbox" type="checkbox" checked={picked().includes(option.value)} disabled={option.disabled} aria-label={drawRow ? option.label : undefined} onChange={() => set(toggledValue(pool(), picked(), option.value))})
          if drawRow
            span(part="label")
              | {drawRow(option)}
          else
            if option.icon
              Icon(icon={option.icon} part="icon")
            span(part="label") {option.label}
    // Read out as a search empties the list, which otherwise changes in silence.
    p(part="empty" role={failed() && !waiting() ? 'alert' : 'status'})
      if empty && status() === emptyLabel
        | {empty}
      else
        | {status()}
  if name
    for entry of picked() key={entry}
      input(type="hidden" name={name} value={entry} disabled={disabled})
