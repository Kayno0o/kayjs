---
import type { ActionStream } from 'kay'
import { listen, onMount, signal } from 'kay'
import { quiet } from '../routes/index.kay'

// Where the stream starts: from its setup (`setup`), a click on its button (`click`), a `listen` callback on the window (`window`), or a click handler calling it after an `await`, which runs under no owner (`await`).
const { mode } = props<{ mode: 'setup' | 'click' | 'window' | 'await' }>()
const answer = signal<ActionStream<number> | undefined>(undefined)

async function start() {
  answer.set(await quiet())
}

onMount(() => {
  if (mode === 'setup')
    void start()
})

listen(window, 'keydown', () => {
  if (mode === 'window')
    void start()
})
---
button.begin(type="button" onClick={async () => {
  if (mode === 'await') {
    await Promise.resolve()
    void start()
  }
  else if (mode === 'click') {
    void start()
  }
}}) Begin
p.status {answer()?.status() ?? 'none'}
