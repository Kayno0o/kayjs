---
import DateInput from '@kayjs/ui/date-input.kay'
import DateRangeInput from '@kayjs/ui/date-range-input.kay'
import FormField from '@kayjs/ui/form-field.kay'
import DateTimeInput from '@kayjs/ui/date-time-input.kay'
import TimeInput from '@kayjs/ui/time-input.kay'
import type { DateRange } from '@kayjs/ui'

// What the test reads back: each change as it happened.
const { onDate, onRange, onTime, onMoment, min, max, firstDay, momentMin, momentMax, momentDisabled, momentValue } = props<{ onDate: (value: string) => void, onRange: (value: DateRange) => void, onTime: (value: string) => void, onMoment: (value: string) => void, momentMin?: string | Date | undefined, momentMax?: string | Date | undefined, momentDisabled?: boolean | undefined, momentValue?: string | undefined, min?: string | undefined, max?: string | undefined, firstDay?: 0 | 1 | 2 | 3 | 4 | 5 | 6 | undefined }>()
---
form
  DateInput(inputProps={{ id: "date" }} aria-label="Day" name="day" value="2026-10-21" min={min} max={max} firstDay={firstDay} onChange={({ value }) => onDate(value)})
  DateInput(inputProps={{ id: "plain" }} aria-label="Plain" name="plain")
  DateRangeInput#range(label="Stay" fromName="from" toName="to" firstDay={firstDay} onChange={({ value }) => onRange(value)})
  DateTimeInput#moment(aria-label="Moment" name="moment" value={momentValue ?? '2026-10-21T07:30:00Z'} disabled={momentDisabled} min={momentMin} max={momentMax} onChange={({ value }) => onMoment(value)})
  TimeInput#time(aria-label="Start" name="start" value="09:30" onChange={({ value }) => onTime(value)})
  TimeInput#required-time(aria-label="Wake" name="wake" value="07:00" required onChange={({ value }) => onTime(value)})
  FormField(label="Held")
    DateInput(inputProps={{ id: "held" }} name="held" value="2026-10-21")
  FormField#held-range(label="Held range")
    DateRangeInput#held-stay(label="Held range" fromName="held-from" toName="held-to")
  FormField#held-moment(label="Held moment")
    DateTimeInput#held-time(name="held-moment")
  DateInput(inputProps={{ id: "locked" }} aria-label="Locked" value="2026-10-21" readonly)
  button#reset(type="reset") Reset
