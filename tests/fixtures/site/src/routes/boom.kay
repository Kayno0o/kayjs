--- server
import { t } from 'elysia'
import { action, defer } from 'kay'

export const explode = action(t.Object({}), () => {
  throw new Error('Kaboom in an action')
})

if (ctx.url.searchParams.has('fail'))
  throw new Error('Kaboom')

// A stack starting with the error's name alone, as Bun 1.4 sometimes writes one.
if (ctx.url.searchParams.has('bare')) {
  const error = new Error('Kaboom bare')

  error.stack = error.stack!.replace('Error: Kaboom bare', 'Error')
  throw error
}

const later = defer(ctx.url.searchParams.has('later') ? Promise.reject(new Error('Kaboom later')) : Promise.resolve('Fine'))

export const send = action(t.Object({ message: t.String({ maxLength: 1000 }) }), () => {
  throw new Error('Mail server down')
}, { messages: { serverError: 'Not sent; write to hello@example.com instead' } })
---
form(action={send})
  textarea(name="message" aria-label="Message")
  button Send
if send.error()
  p.error {send.error()}
form(action={explode})
  button Explode
if explode.error()
  p.error {explode.error()}
// kay-allow uncaught-await
await later then value
  p {value}
