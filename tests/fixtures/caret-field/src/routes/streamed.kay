--- server
import { defer, s } from 'kay'

export const page = { query: s.Object({ q: s.Optional(s.String()) }) }

const q = ctx.query.q ?? ''
const later = defer(Bun.sleep(300).then(() => q))
--- script
import BoundField from '../components/bound-field.kay'
import NavButtons from '../components/nav-buttons.kay'
---
head
  title Caret streamed
h1 Caret
p.searched {q}
NavButtons
await later then shown
  BoundField(value={shown} hydrate="visible")
