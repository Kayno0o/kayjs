--- island
import TreeView from '@kaynooo/kayjs-ui/tree-view.kay'
import { signal } from 'kay'

const { calls } = props<{ calls: string[] }>()
const expanded = signal<string[]>([])
const waiting: (() => void)[] = []
let healed = false

const nodes = [
  { key: 'remote', label: 'Remote', children: async () => new Promise<{ key: string, label: string }[]>((resolve) => { waiting.push(() => resolve([{ key: 'file', label: 'File' }])) }) },
  { key: 'flaky', label: 'Flaky', children: async () => {
    calls.push('flaky call')

    if (!healed)
      throw new Error('down')

    return [{ key: 'ok', label: 'Ok' }]
  } },
  { key: 'plain', label: 'Plain', children: [{ key: 'leaf', label: 'Leaf' }] },
]
---
button#release(type="button" onClick={() => waiting.shift()?.()}) Release
button#heal(type="button" onClick={() => healed = true}) Heal
button#expand(type="button" onClick={() => expanded = ['plain']}) Expand
TreeView#tree(nodes={nodes} label="Files" expanded={expanded()} onOpenChange={(id, open) => calls.push(`${id} ${open}`)})
