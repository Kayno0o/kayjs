---
import type { FieldSize } from './field-look'
import type { JSX } from 'kay'
import { FIELD_BOX, FIELD_LOOK, fieldInvalid, fieldSize, keepInvalid } from './field-look'
import { postedValue, recipe, untrack } from 'kay'
import { controlledValue } from './controlled-value'
import { fieldRef } from './form-reset'

const look = recipe({
  parts: { root: `${FIELD_LOOK} ${FIELD_BOX}` },
})

const { size = 'md', invalid, value, onInput, onChange, onBlur, writeFocused = false, ...rest } = props<Omit<JSX.IntrinsicElements['textarea'], 'value' | 'class' | 'children' | 'onInput' | 'onChange'> & {
  // The box's size: `md` by default, `sm` and `lg` change its padding and type.
  size?: FieldSize | undefined
  // Marks the control as refused, in the danger colour with `aria-invalid`. A FormField marks its control on its own while it shows a message.
  invalid?: boolean | undefined
  // Without it, the box starts empty and keeps what is typed, for a form posting it by its `name`.
  value?: string | undefined
  onInput?: ((value: string) => unknown) | undefined
  // Called once the value is committed, on blur, after `onInput`.
  onChange?: ((value: string) => unknown) | undefined
  // Lets any write of the parent land while the box is focused, the caret going to the end, such as a chat clearing its draft or putting a refused message back.
  writeFocused?: boolean | undefined
}>()

// A field with no callback is plain: a refused post of its form, which the server renders it for, gives its text back in place of its own.
const sent = onInput || onChange ? undefined : postedValue(rest.name, value)

let box: HTMLTextAreaElement | undefined

// The parent may write back its own reading of the text, such as without the blank line just typed: the box takes it once left, never while focused, which would throw the caret to the end.
const { heard, sync } = controlledValue({
  box: () => box,
  value: () => value,
  writable: element => writeFocused || document.activeElement !== element,
  report: (element) => {
    heard(element.value)
    ;(onInput ?? onChange)?.(element.value)
  },
})

// The box starts once: its default is what it was first drawn with.
const ref = fieldRef<HTMLTextAreaElement>((element) => {
  const start = untrack(() => sent ?? value)

  box = element
  keepInvalid(element, () => invalid)

  if (start !== undefined)
    element.defaultValue = start
}, rest.ref)

---
textarea({...rest} data-size={fieldSize(size)} aria-invalid={fieldInvalid(() => invalid) ?? rest['aria-invalid']} ref={ref} value={sent ?? untrack(() => value)} onInput={event => { heard(event.currentTarget.value); onInput?.(event.currentTarget.value) }} onChange={event => { heard(event.currentTarget.value); onChange?.(event.currentTarget.value) }} onBlur={event => { sync(true); onBlur?.(event) }})
