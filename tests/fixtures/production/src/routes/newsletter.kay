--- server
import { t } from 'elysia'
import { action } from 'kay'

export const page = { prerender: true }

export const join = action(t.Object({ email: t.String({ maxLength: 200, format: 'email', error: 'Not an email' }) }), ({ email }) => email.split('@')[0])

const failure = join.failed()
const joined = join.succeeded()
---
form(action={join})
  input(name="email" aria-label="Email" value={failure?.values.email})
  button Join
if failure
  p.error {failure.errors.email}
if joined
  p.joined Welcome {joined.data}
