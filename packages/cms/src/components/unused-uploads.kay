---
import type { Column } from '@kaynooo/kayjs-ui'
import type { UnusedUpload } from '../orphans'
import ConfirmDelete from '@kaynooo/kayjs-ui/confirm-delete.kay'
import EmptyState from '@kaynooo/kayjs-ui/empty-state.kay'
import Table from '@kaynooo/kayjs-ui/table.kay'
import { refresh } from 'kay'
import { deleteUnusedUploadsInChunks } from '../editor/save'

const { uploads } = props<{ uploads: UnusedUpload[] }>()

const columns: Column<UnusedUpload>[] = [
  { key: 'key', header: 'Upload', cell: true },
  { key: 'variants', header: 'Variants', cell: true },
  { key: 'actions', header: 'Actions', align: 'end', cell: true },
]

async function remove(keys: string[]): Promise<boolean> {
  const done = await deleteUnusedUploadsInChunks(keys)

  // Rows already deleted leave the table's selection with `uploads`.
  await refresh()

  return done
}
---
Table.kcms-uploads(columns={columns} rows={uploads} rowKey={upload => upload.key} selectable)
  @bulk(keys, clear)
    ConfirmDelete(message={`Delete ${keys.length} upload${keys.length === 1 ? '' : 's'} and their variants? Check that no page, unsaved form or older revision uses them: this cannot be undone.`} label={`Delete ${keys.length} selected`} failure="Could not delete" size="sm" variant="ghost" onConfirm={async () => { if (await remove(keys.map(String))) clear() }})
  @cell(row, column)
    if column.key === 'key'
      a(href={row.url} target="_blank" rel="noopener") {row.key}
    else if column.key === 'variants'
      span(data-tooltip={row.variants.join(", ")} tabindex="0") {row.variants.length === 0 ? 'None' : `${row.variants.length} variant${row.variants.length === 1 ? '' : 's'}`}
    else
      ConfirmDelete(message={`Delete ${row.key}${row.variants.length === 0 ? '' : ` and its ${row.variants.length} variant${row.variants.length === 1 ? '' : 's'}`}? Check that no page, unsaved form or older revision uses it: this cannot be undone.`} label={`Delete ${row.key}`} failure="Could not delete" size="sm" variant="ghost" onConfirm={async () => { await remove([row.key]) }})
  @empty
    EmptyState(title="No unused uploads" description="Every upload is mentioned in an entry.")
