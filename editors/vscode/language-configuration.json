{
  "comments": { "lineComment": "//" },
  "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "`", "close": "`", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["(", ")"], ["'", "'"], ["\"", "\""], ["`", "`"]],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*[\\w.#-].*$|^\\s*(if|else|for)\\b.*$",
    "decreaseIndentPattern": "^\\s*---\\s*$"
  },
  "onEnterRules": [],
  "folding": { "offSide": true }
}
