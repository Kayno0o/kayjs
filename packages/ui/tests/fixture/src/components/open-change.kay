---
import { signal } from 'kay'
import Dialog from '@kaynooo/kayjs-ui/dialog.kay'
import Popover from '@kaynooo/kayjs-ui/popover.kay'
import SidePanel from '@kaynooo/kayjs-ui/side-panel.kay'

// Each disclosure writes what its `onOpenChange` heard to `calls`.
const { calls } = props<{ calls: string[] }>()

const dialog = signal(true)
const panel = signal(true)
const popover = signal(false)
---
button#shut-dialog(onClick={() => dialog = false}) Shut dialog
button#shut-panel(onClick={() => panel = false}) Shut panel
button#show-popover(onClick={() => popover = true}) Show popover
button#hide-popover(onClick={() => popover = false}) Hide popover
Dialog#dialog(open={dialog()} title="Dialog" onOpenChange={shown => { calls.push(`dialog onOpenChange ${shown}`); dialog = shown }})
  p Dialog body
SidePanel#panel(open={panel()} title="Panel" onOpenChange={shown => { calls.push(`panel onOpenChange ${shown}`); panel = shown }})
  p Panel body
Popover(id="popover" open={popover()} onOpenChange={shown => { calls.push(`popover onOpenChange ${shown}`); popover = shown }})
  @trigger(attributes)
    button#popover-trigger({...attributes}) Trigger
  p Popover body
