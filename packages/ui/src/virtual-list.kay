--- <Item>
import type { JSX, Snippet } from 'kay'
import { memo, onCleanup, onMount, recipe } from 'kay'
import { wording } from 'kay/words'
import type { InfiniteList } from './infinite-list'
import Button from './button.kay'
import LoadMore from './load-more.kay'
import { asyncRows } from './source'
import type { RowsSource } from './source'
import { virtualRows } from './virtual'

const look = recipe({
  parts: {
    root: 'kui-virtual-list',
    empty: 'text-xs text-muted',
    // An item that is a link or a button: the anchor or the button is stretched over it, the links and buttons the item draws sitting above.
    item: 'data-linked:relative data-linked:isolate data-linked:[&_:where(a,button,input,select,textarea,label,summary,[tabindex],[role=button]):not([data-part=itemLink],[data-part=itemButton])]:relative data-linked:[&_:where(a,button,input,select,textarea,label,summary,[tabindex],[role=button]):not([data-part=itemLink],[data-part=itemButton])]:z-1',
    itemLink: 'absolute inset-0 z-0 m-0 block h-full w-full cursor-pointer border-0 bg-transparent p-0 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-accent',
    itemButton: 'absolute inset-0 z-0 m-0 block h-full w-full cursor-pointer border-0 bg-transparent p-0 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-accent',
    notices: '',
    skeleton: 'px-3 py-2.5',
    skeletonBar: 'block h-[1em] w-full animate-pulse bg-surface-strong motion-reduce:animate-none',
    status: 'sr-only',
    failure: 'flex flex-wrap items-center justify-center gap-3 px-3 py-4 text-sm',
    message: 'm-0',
  },
})

const { items: given, list: source, item, itemKey, estimate = 48, overscan = 4, label, busy = false, skeletonItems = 5, emptyLabel = wording('ui.virtualList.empty', 'No items.'), empty, loadingLabel = wording('ui.virtualList.loading', 'Loading…'), failureLabel = wording('ui.virtualList.failure', 'Could not load the items.'), retryLabel = wording('ui.virtualList.retry', 'Try again'), onLoad, onError, itemHref, onItemClick, itemLabel, ...rest } = props<Omit<JSX.IntrinsicElements['div'], 'class' | 'children' | 'role' | 'tabindex' | 'onLoad' | 'onError'> & {
  // The items to draw: an array, a function returning them, or a promise of them. An array is drawn by the server; a function is called in the browser only (it may touch `window`, and the server draws the skeleton), and so is a promise's answer, skeleton items standing in meanwhile; a refresh keeps the items shown, then a failure with a retry (a function is called again) if it rejects. Left out when `list` holds them: one of the two is required.
  items?: RowsSource<Item> | undefined
  // Items loaded page by page, from `infiniteList`: `LoadMore` follows the rows inside the box, loading the next page as the reader nears the end and showing a failed page's alert with its retry.
  list?: InfiniteList<Item> | undefined
  // Draws a row, from the `@item(item, index)` block.
  item: Snippet<[Item, number]>
  // Tells a row from another, so the height measured for it follows it when the list shifts; the row's index without one.
  itemKey?: ((item: Item, index: number) => unknown) | undefined
  // The height assumed for a row until it is measured, in pixels: the closer to the rows' own, the less the scroll bar moves as they are.
  estimate?: number | undefined
  // The rows drawn beyond the visible ones on each side.
  overscan?: number | undefined
  // Names the list, which is read out when it takes the focus: a focusable list with no name is a stop a screen reader cannot place.
  label: string
  // Marks the items as on their way: with none to show, `skeletonItems` skeleton items are drawn. A source still loading and a `list` still on its first page set it themselves.
  busy?: boolean | undefined
  // How many skeleton items a busy list draws.
  skeletonItems?: number | undefined
  // Read out while the items load.
  loadingLabel?: string | undefined
  // Shown with the retry button when the items could not be loaded.
  failureLabel?: string | undefined
  retryLabel?: string | undefined
  // Called with the items each time an `items` function or promise answers.
  onLoad?: ((items: Item[]) => unknown) | undefined
  // Called with the error when an `items` function or promise rejects.
  onError?: ((error: unknown) => unknown) | undefined
  // Makes each item a link: its address, or undefined for one that leads nowhere. An anchor named `itemLabel` is stretched over the item, the links and buttons the item draws staying clickable above it.
  itemHref?: ((item: Item, index: number) => string | undefined) | undefined
  // Makes each item a button, or hears the click of a link item (call `event.preventDefault()` to follow the link yourself).
  onItemClick?: ((item: Item, index: number, event: MouseEvent) => unknown) | undefined
  // Names an item's link or button; `Open item <position>` without one.
  itemLabel?: ((item: Item, index: number) => string) | undefined
  // What the list reads with no item; `empty` replaces it with the app's own markup, such as a link to add the first one: an `@empty` block.
  emptyLabel?: string | undefined
  empty?: Snippet | undefined
} & ({ items: RowsSource<Item>, list?: undefined } | { items?: undefined, list: InfiniteList<Item> })>()

const loaded = asyncRows<Item>(() => given, { onLoad: answer => onLoad?.(answer), onError: error => onError?.(error) })
const items = () => source ? source.rows() : loaded.rows()
const waiting = () => busy || (source ? source.pending() && !source.failed() : loaded.loading())
const skeleton = () => waiting() && items().length === 0
const none = () => items().length === 0 && !waiting() && !loaded.failed() && (source === undefined || (source.ended() && !source.failed() && !source.pending()))
// LoadMore announces a list's pending page itself.
const announced = () => source !== undefined && source.pending()
const skeletonIndexes = () => Array.from({ length: Math.max(1, Math.floor(skeletonItems)) }, (_, index) => index)
const openLabel = (row: Item, index: number) => itemLabel ? itemLabel(row, index) : wording('ui.virtualList.openItem', 'Open item {position}', { position: index + 1 })
const linked = () => itemHref !== undefined || onItemClick !== undefined

const keyOf = (row: Item, index: number) => itemKey === undefined ? index : itemKey(row, index)
const list = virtualRows({ items, keyOf, estimate: () => estimate, overscan: () => overscan })
const entries = memo(() => list.rows().map((row, position) => ({ row, index: list.start() + position })))
let box: HTMLElement | undefined
let content: HTMLElement | undefined

onMount(() => {
  onCleanup(list.attach(box!, content!))
})
---
// Only the rows in view are drawn, between two stretches of room standing for the others. The box takes the focus to scroll by keyboard; find-in-page sees the drawn rows alone, and a focused row that scrolls out of the window is gone with its focus.
div(part="root" {...rest} ref={element => box = element} role="list" tabindex="0" aria-label={label} aria-busy={waiting() ? 'true' : undefined})
  // One listitem holds the notices, so the list keeps valid children and the status stays mounted for its text to be announced; the items state their own position and size.
  div(part="notices" role="listitem")
    p(part="status" role="status") {skeleton() && !announced() ? loadingLabel : ''}
    if loaded.failed()
      div(part="failure" role="alert")
        p(part="message") {failureLabel}
        if loaded.retryable()
          Button(label={retryLabel} variant="ghost" size="sm" onClick={loaded.retry})
    if none() && (empty || emptyLabel !== '')
      div(part="empty")
        if empty
          | {empty}
        else
          | {emptyLabel}
    if skeleton()
      div(part="skeletons" aria-hidden="true")
        for index of skeletonIndexes() key={index}
          div(part="skeleton")
            span(part="skeletonBar")
  div(part="content" ref={element => content = element} role="presentation" style={`padding-block: ${list.before()}px ${list.after()}px`})
    for entry of entries() key={keyOf(entry.row, entry.index)}
      div(part="item" role="listitem" data-linked={linked() ? '' : undefined} data-virtual-index={entry.index} aria-posinset={entry.index + 1} aria-setsize={list.count()})
        | {item(entry.row, entry.index)}
        if linked()
          if itemHref?.(entry.row, entry.index) as href
            a(part="itemLink" href={href} aria-label={openLabel(entry.row, entry.index)} onClick={event => onItemClick?.(entry.row, entry.index, event)})
          else if onItemClick
            button(part="itemButton" type="button" aria-label={openLabel(entry.row, entry.index)} onClick={event => onItemClick?.(entry.row, entry.index, event)})
  if source
    LoadMore(list={source})
