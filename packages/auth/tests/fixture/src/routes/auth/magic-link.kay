--- server
// The app's own page at one of kayjs-auth's paths replaces that page alone.
import { t } from 'elysia'
import { action } from 'kay'

export const page = { query: t.Object({ token: t.Optional(t.String()) }), guards: false }

// The link only shows this button: a mail scanner opening it spends nothing.
export const spend = action(t.Object({ token: t.String() }), async ({ token }, ctx) => {
  const result = await ctx.locals.auth.signInWithMagicLink(token)

  return !result.ok ? ctx.fail(400, { error: result.error }) : ctx.redirect(result.redirect)
})

const token = ctx.query.token ?? ''
const failure = ctx.failed(spend)
---
form#spend(action={spend})
  input(type="hidden" name="token" value={token})
  button Sign in
if failure?.data as data
  p#error {data.error}
