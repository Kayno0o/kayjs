---
import { signal } from 'kay'
import Checkbox from '@kaynooo/kayjs-ui/checkbox.kay'
import ChipGroup from '@kaynooo/kayjs-ui/chip-group.kay'

// `onDecks` stands for an action behind the chips, answering once the test settles it; `mixed` is the parent's indeterminate state.
const { onAgree, onDecks } = props<{ onAgree: (checked: boolean) => unknown, onDecks?: (value: string[]) => unknown }>()

const mixed = signal(true)
const decks = [{ value: 'films', label: 'Films' }, { value: 'games', label: 'Games', icon: 'star' }, { value: 'books', label: 'Books' }, { value: 'music', label: 'Music', disabled: true }] as const
---
form#form
  Checkbox(name="terms" label="I agree" hint="v2" onChange={onAgree})
  Checkbox#all(label="Select all" indeterminate={mixed()} onChange={() => mixed.set(false)})
  ChipGroup(label="Decks" name="decks" options={decks} value={['games', 'films']} onChange={onDecks})
