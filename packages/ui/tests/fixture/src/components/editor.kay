---
import { signal } from 'kay'
import FormField from '@kayjs/ui/form-field.kay'
import MarkdownEditor from '@kayjs/ui/markdown-editor.kay'
import Toaster from '@kayjs/ui/toaster.kay'

// What the test reads back: the text after each change.
const { value, onInput, onChange, onImage, toolbar, preview, previewTrusted, previewClass, view, onViewChange, labelled = false, plain = false, late = false } = props<{ value: string, onInput: (value: string) => void, onChange?: (value: string) => void, onImage?: (file: File) => Promise<string>, toolbar?: boolean | readonly ('bold' | 'italic' | 'heading' | 'bulletList' | 'numberedList' | 'link' | 'image')[], preview?: (markdown: string) => Promise<string>, previewTrusted?: boolean, previewClass?: string, view?: 'edit' | 'split' | 'preview', onViewChange?: (view: string) => void, labelled?: boolean, plain?: boolean, late?: boolean }>()

// With `late`, the toolbar is off until the test's button turns it on, as a parent changing the prop after mount.
const enabled = signal(false)
---
if labelled
  FormField(label="Body")
    MarkdownEditor#editor(value={value} onInput={({ value }) => onInput(value)} onChange={({ value }) => onChange?.(value)} onImage={onImage ? ({ file }) => onImage!(file) : undefined} toolbar={toolbar} preview={preview} previewTrusted={previewTrusted} previewClass={previewClass} view={view} onViewChange={({ view }) => onViewChange?.(view)})
else if plain
  label
    span.kui-label-text Outer
    MarkdownEditor#editor(value={value} onInput={({ value }) => onInput(value)} onChange={({ value }) => onChange?.(value)})
else if late
  MarkdownEditor#editor(value={value} onInput={({ value }) => onInput(value)} onChange={({ value }) => onChange?.(value)} toolbar={enabled()})
else
  MarkdownEditor#editor(value={value} onInput={({ value }) => onInput(value)} onChange={({ value }) => onChange?.(value)} onImage={onImage ? ({ file }) => onImage!(file) : undefined} toolbar={toolbar} preview={preview} previewTrusted={previewTrusted} previewClass={previewClass} view={view} onViewChange={({ view }) => onViewChange?.(view)})
input#title(aria-label="Title")
Toaster
if late
  button#enable-toolbar(type="button" onClick={() => enabled = true}) Enable
